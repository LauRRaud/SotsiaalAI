# text files normalized
* text=auto

# code + config in LF
*.{js,jsx,ts,tsx,mjs,cjs,json,css,scss,md,html,yml,yaml} text eol=lf

# Deterministic RAG-QM expected-output fixtures
tests/fixtures/expected/*.json text eol=lf
tests/fixtures/expected/*.md text eol=lf

# Source corpora and archives retain original bytes for recorded source hashes.
Andmebaasi/** -text -whitespace
Arhiiv/** -text -whitespace
# Vendored MediaPipe build: original bytes, hashes in its README.md.
public/vendor/mediapipe/** -text -whitespace
*.pdf binary
*.fbx binary
*.docx binary
*.zip binary

# Windows scripts
*.{ps1,bat,cmd} text eol=crlf

# Evaluation data packages (hash-checked archives)
*.tar.gz binary
