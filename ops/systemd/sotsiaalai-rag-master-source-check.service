[Unit]
Description=SotsiaalAI master-source recheck (review candidates only)
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
WorkingDirectory=/opt/sotsiaalai
EnvironmentFile=/etc/sotsiaalai/rag-master-source-check.env
ExecStart=/usr/bin/npm run rag:master:check -- --recheck --fetch --limit 50
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/opt/sotsiaalai/Andmebaasi/Admebaasi-materjali-lisa

# This unit only reads public source URLs and writes a review queue/runtime state.
# It never calls /ingest/* and never mutates the source registry.
