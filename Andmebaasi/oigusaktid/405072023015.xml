  <aktinimi id="877406dd-0193-4e0f-9ca4-24d2e6ede84d">
    <nimi id="14850abb-116d-48f7-9ad5-84488eb14d84">
      <pealkiri id="27edeba2-3fc5-4ec1-95f0-2e8f98ee3682">Väljaspool kodu osutatava ööpäevaringse üldhooldusteenuse hoolduskulude tasumise piirmäära kehtestamine</pealkiri>
    </nimi>
  </aktinimi>
  <sisu id="71bb8ba8-03ed-4f0e-972f-9f0cd59adf44">
    <preambul id="40e9f59c-4f8f-4c99-bacc-3971d252d5a5">
      <tavatekst id="69966e3f-abb7-4d41-812f-b13ca3fd6782">Määrus kehtestatakse sotsiaalhoolekande seaduse § 22<sup>1</sup> lg 3 ja Raasiku Vallavolikogu 08.09.2020 määruse nr 15 „Sotsiaalhoolekandelise abi andmise kord Raasiku vallas“ § 17 lg 3 alusel.</tavatekst>
    </preambul>
    <paragrahv id="para1">
      <paragrahvNr id="27adb19e-c923-4be3-a54c-9b39e04c83ef">1</paragrahvNr>
      <kuvatavNr id="28b51c35-2df1-4355-9fa3-da4ab9e44726"><![CDATA[§ 1. ]]></kuvatavNr>
      <paragrahvPealkiri id="38e26f69-5578-46eb-9c02-b69945c90e47">Väljaspool kodu osutatava ööpäevaringse üldhooldusteenuse hoolduskulude tasumise piirmäär</paragrahvPealkiri>
      <loige id="para1lg1">
        <loigeNr id="b10cd419-be15-4b66-bd6b-07d43644a119"/>
        <kuvatavNr id="f00da2bc-53c1-4abe-accb-15dfe401bca8"/>
        <sisuTekst id="452c48bf-04a0-4fee-9e47-5b5d4b213e9d">
          <tavatekst id="fca5826f-d325-4b61-90f6-d5f2d0d0379c">Kehtestada väljaspool kodu osutatava ööpäevaringse üldhooldusteenuse raames vahetult teenust osutavate hooldustöötajate ja abihooldustöötajate kulude (sh tööjõukulud, tööriietuse ja isikukaitsevahendite kulud, tervisekontrolli ja vaktsineerimise kulud, koolituse ja supervisiooni kulud) kulude tasumise piirmääraks 650 eurot ühe teenuse saaja kohta kalendrikuus. </tavatekst>
        </sisuTekst>
      </loige>
    </paragrahv>
    <paragrahv id="para2">
      <paragrahvNr id="077ec332-8bd1-4241-82ad-5e7a636330df">2</paragrahvNr>
      <kuvatavNr id="59ff5c2e-b127-4b89-8092-c964767ed221"><![CDATA[§ 2. ]]></kuvatavNr>
      <paragrahvPealkiri id="3f163124-cf83-44f0-ad85-dbb172ae7e9c">Määruse jõustumine</paragrahvPealkiri>
      <loige id="para2lg1">
        <loigeNr id="cc5a0f15-31c2-43ae-8cb0-ac5a0975fa9b"/>
        <kuvatavNr id="2ce29c91-ac93-4e3d-808f-169e2d8f1e60"/>
        <sisuTekst id="b0939d19-d7ae-44f7-85de-e357998ceb8d">
          <tavatekst id="7ca859c3-7753-4eb7-b5eb-2fb61108c106">Määrus jõustub kolmandal päeval pärast Riigi Teatajas avaldamist. Määrust rakendatakse tagasiulatuvalt alates 01.07.2023. a.</tavatekst>
        </sisuTekst>
      </loige>
    </paragrahv>
  </sisu>
