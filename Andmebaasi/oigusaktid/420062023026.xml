			<tavatekst id="6b221da5-3fb3-4370-9e49-40b47d9792e9">Määrus kehtestatakse sotsiaalhoolekande seaduse § 22<sup>1</sup> lõige 3 ja Viimsi Vallavolikogu 21.03.2023 määruse nr 10 „Viimsi valla sotsiaalteenuste osutamise tingimused ja kord“ § 8 lõike 2 alusel.</tavatekst>
		</preambul>
		<paragrahv id="para1">
			<paragrahvNr id="e56207e6-76b2-44bf-a7cf-21befdf82a91">1</paragrahvNr>
			<kuvatavNr id="80d0e9a8-a0df-448b-ae78-83b91679558b"><![CDATA[§ 1. ]]></kuvatavNr>
			<paragrahvPealkiri id="c4c0685e-de31-43f7-b97a-bd4d3ce6c7ed">Väljaspool kodu osutatava ööpäevaringse üldhooldusteenuse hoolduskulude tasumise piirmäär</paragrahvPealkiri>
			<loige id="para1lg1">
				<loigeNr id="603420df-9af4-48b3-8f26-f6a8f3b99e6f"/>
				<kuvatavNr id="9a43ca8f-ee79-47c1-9d65-00c3f04221e5"/>
				<sisuTekst id="37a7acc9-630e-41ba-8e2a-664b986d8d7e">
					<tavatekst id="0185e91d-a9cf-47be-9b19-0b6765d5d32f">Kehtestada väljaspool kodu osutatava ööpäevaringse üldhooldusteenuse osutamisel vahetult teenust osutavate hooldustöötajate ja abihooldustöötajate kulude tasumise piirmääraks 650 eurot ühe teenusesaaja kohta kalendrikuus.</tavatekst>
				</sisuTekst>
			</loige>
		</paragrahv>
