   <sisuTekst id="b6a8cbd5-fd1e-46ad-bac6-3df143048639">
    <tavatekst id="03ebee93-ff3b-43d2-a0b3-e975d1fc4949">eluruumi taotleja on teadvalt andmeid varjanud või esitanud valeandmeid;</tavatekst>
   </sisuTekst>
  </alampunkt><alampunkt id="para34lg1p7">
   <alampunktNr id="3cba5cbc-e147-4cda-b746-c2e2013043c8">7</alampunktNr>
