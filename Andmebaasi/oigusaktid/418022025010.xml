			<paragrahvPealkiri id="c5f3ccbe-f979-4627-89c2-0dc3a366a180">Väljaspool kodu osutatava ööpäevaringse üldhooldusteenuse hoolduskulude tasumise piirmäär</paragrahvPealkiri>
			<loige id="para1lg1">
				<loigeNr id="19e7fc18-fe72-41ca-a5d1-812ed4f3e5d3"/>
