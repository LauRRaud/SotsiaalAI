   <sisuTekst id="071dbf0f-5395-4a7c-8d6e-3cfa7e97ef1b">
    <tavatekst id="7b9f0875-13ec-4c0a-aa0e-bd78600daa0d">Järelevalvet eluruumi sihipärase kasutamise ja lepingu täitmise üle teostab sotsiaalosakonna teenistuja. </tavatekst>
   </sisuTekst>
  </loige></paragrahv><paragrahv id="para12">
