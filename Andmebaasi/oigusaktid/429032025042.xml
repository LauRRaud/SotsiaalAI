   <pealkiri id="774b4e19-513f-479b-aba8-a5d464902d1d">Vaimse tervise teenuse osutamise kord</pealkiri>
  </nimi>
 </aktinimi>
 <sisu id="4c97c1d3-1eb3-4537-936f-084be2eab19e"><preambul id="50e58694-4db8-4e3b-85a7-4f1e7d2d9066"><tavatekst id="d5ee56f6-ea21-45ca-8605-83a1919dc389">Määrus kehtestatakse kohaliku omavalitsuse korralduse seaduse § 22 lõike 1 punkti 5, lõike 2, sotsiaalseadustiku üldosa seaduse § 14 lõike 2, § 15 punkti 2 ja sotsiaalhoolekande seaduse § 156 lõike 3<sup>9</sup> ja 3<sup>10</sup> alusel.</tavatekst></preambul><paragrahv id="para1"><paragrahvNr id="0a9a06af-8ffc-418b-b80b-12d0edf4f15a">1</paragrahvNr><kuvatavNr id="8b9eed03-ceea-4db9-8681-ef2bf967155b"><![CDATA[§ 1. ]]></kuvatavNr><paragrahvPealkiri id="f2939abb-5377-4f16-b663-1c4f91948be0">Reguleerimisala</paragrahvPealkiri><loige id="para1lg1"><loigeNr id="db435c68-d603-4feb-9ef5-004a014a4e7c"/><kuvatavNr id="aed6468a-da7b-45b4-9d61-0f5a4646b5bc"/><sisuTekst id="a8b86c1a-ee97-4427-94c5-42b2580a055b"><tavatekst id="93d88628-4d7c-475f-a632-b12c13e7bcbb">Käesolev kord sätestab sotsiaalhoolekandelise abina osutatava psühhosotsiaalse ja psühholoogilise teenuse (edaspidi vaimse tervise teenus) osutamise tingimused ja korra.</tavatekst></sisuTekst></loige></paragrahv><paragrahv id="para2"><paragrahvNr id="8539be3f-6563-4f5a-b97d-ad391a176a13">2</paragrahvNr><kuvatavNr id="b7e47699-9a9e-481e-96a3-ffd482b96ce5"><![CDATA[§ 2. ]]></kuvatavNr><paragrahvPealkiri id="6a86b83c-2fcd-4e28-b760-6087c516239c">Ülesannete delegeerimine</paragrahvPealkiri><loige id="para2lg1"><loigeNr id="63b2fb6a-11f1-48c4-a450-ecfab22523df"/><kuvatavNr id="9f688234-1df4-4677-91a7-e597926fe77b"/><sisuTekst id="32e5bbd9-5a1d-407c-9e57-3d00faa0e259"><tavatekst id="9e3de235-53d8-4cc3-a708-ea1606d1838a">Sotsiaalhoolekande seaduses sätestatud kohaliku omavalitsuse üksuse vaimse tervise teenuse toetusfondi vahendite kasutamise otsustab Viljandi Linnavalitsus (edaspidi linnavalitsus).</tavatekst></sisuTekst></loige></paragrahv><paragrahv id="para3"><paragrahvNr id="a464411f-536b-41ce-9083-d31cee7e6b77">3</paragrahvNr><kuvatavNr id="17d2ace5-20c7-490d-b999-39064081e923"><![CDATA[§ 3. ]]></kuvatavNr><paragrahvPealkiri id="1270c2ca-4d25-40d2-a8ee-f040e6501f61">Teenuse eesmärk, sihtgrupp ja teenuse kirjeldus</paragrahvPealkiri><loige id="para3lg1"><loigeNr id="9b644e87-88cf-490d-a081-51a8246b64d9">1</loigeNr><kuvatavNr id="16a728a1-7d20-4357-81df-752205e52322"><![CDATA[(1)]]></kuvatavNr><sisuTekst id="1f94fd19-1e59-4def-9465-f49ec2042fa4"><tavatekst id="e2775a55-c3be-4196-8bc4-a4d859597d17">Eesmärk on parandada vaimse tervise teenuse kättesaadavust kohalikul tasandil ning elanike vaimse tervise probleemide tekke ja süvenemise ennetamine ning psühholoogilise heaolu toetamine.</tavatekst></sisuTekst></loige><loige id="para3lg2"><loigeNr id="665c96c5-e6d4-49df-9196-38555ef33448">2</loigeNr><kuvatavNr id="94a0b5a4-80c3-499e-a0c3-35a895669a8a"><![CDATA[(2)]]></kuvatavNr><sisuTekst id="eb8e2ee8-3ce7-4db3-bc0b-f9ad20522394"><tavatekst id="2a7f5b6b-d821-4d4f-9cf4-454e6fb9bef2">Teenust sihtgrupiks on Eesti Rahvastikuregistri andmetel Viljandi linnas elav isik, kes vajab vaimse tervise teenust.</tavatekst></sisuTekst></loige><loige id="para3lg3"><loigeNr id="be935c8c-1b42-4a72-b222-b07d18b75f4c">3</loigeNr><kuvatavNr id="6179531a-c722-466a-a91b-9067e344311f"><![CDATA[(3)]]></kuvatavNr><sisuTekst id="713890c8-6d4a-4740-bf17-05c9caee51ab"><tavatekst id="bd67abf0-9847-436b-929a-846e968c08d0">Olenevalt teenuse saaja vajadustest osutatakse järgmisi vaimse tervise teenuseid:</tavatekst></sisuTekst><alampunkt id="para3lg3p1"><alampunktNr id="199d2d25-746e-4cb6-a0ea-289a8c1b3adc">1</alampunktNr><kuvatavNr id="825cc2f8-f89d-440a-b401-296c891137f0"><![CDATA[1) ]]></kuvatavNr><sisuTekst id="f6298c82-d751-4536-b80f-e695b69d8d7a"><tavatekst id="bc60572a-ecef-42c8-9267-ca49e6e81ddb">leinanõustamine;</tavatekst></sisuTekst></alampunkt><alampunkt id="para3lg3p2"><alampunktNr id="e465238a-1b4d-4fc6-9be2-1fb21ca64f81">2</alampunktNr><kuvatavNr id="30a7c23e-4429-46cc-bb78-404dcb8f7676"><![CDATA[2) ]]></kuvatavNr><sisuTekst id="0a0d1afb-4206-461e-9dd4-0a6363a2d4e9"><tavatekst id="9a1566cb-cc05-4532-891c-3b98444cd472">psühhosotsiaalne nõustamine;</tavatekst></sisuTekst></alampunkt><alampunkt id="para3lg3p3"><alampunktNr id="46451d75-5768-4437-8ab4-5eaec362af67">3</alampunktNr><kuvatavNr id="60bb3fe7-c33c-45e5-8dd0-36aea3cb7d2f"><![CDATA[3) ]]></kuvatavNr><sisuTekst id="9391c814-2f81-49bf-8df8-98e857199e6e"><tavatekst id="2811ae82-3ba0-4e22-a237-753f56563f69">kriisinõustamine;</tavatekst></sisuTekst></alampunkt><alampunkt id="para3lg3p4"><alampunktNr id="023bbc05-39b9-4156-8e81-85b26995c75a">4</alampunktNr><kuvatavNr id="d3d33d6a-7443-4646-a46f-158b68020c0b"><![CDATA[4) ]]></kuvatavNr><sisuTekst id="a8d87d32-b5ac-4ac9-82bc-fa74291fb92c"><tavatekst id="efdd5b27-09f0-4a0f-a5b0-dc151ce2723c">sõltuvusnõustamine;</tavatekst></sisuTekst></alampunkt><alampunkt id="para3lg3p5"><alampunktNr id="eba258f2-74ef-447a-b71e-9b2f15ffde4a">5</alampunktNr><kuvatavNr id="4687f3bd-bd0b-428a-91b2-5f141359691b"><![CDATA[5) ]]></kuvatavNr><sisuTekst id="b6c3f7d5-87aa-4b15-8070-b981b9eea1c5"><tavatekst id="4d8997b2-5751-4d43-b82a-da0adae0adc0">teraapiad (s.h. mänguteraapia, pereteraapia);</tavatekst></sisuTekst></alampunkt><alampunkt id="para3lg3p6"><alampunktNr id="1b3300e8-1486-45bb-bbed-96358d34bf88">6</alampunktNr><kuvatavNr id="0da2a447-9ec8-4b18-b867-4ea9881b5cdc"><![CDATA[6) ]]></kuvatavNr><sisuTekst id="d9f34e8c-5bdd-498e-a41f-0bb7e158203e"><tavatekst id="0e01d793-cc6c-425d-b40e-420c86f7ed0f">vajadusel muu nõustamine.</tavatekst></sisuTekst></alampunkt></loige></paragrahv><paragrahv id="para4"><paragrahvNr id="bdb5bc5f-7adf-424c-9ba5-c205eee5bb16">4</paragrahvNr><kuvatavNr id="e1d7af77-e5bf-4024-be33-f44ccdea98bc"><![CDATA[§ 4. ]]></kuvatavNr><paragrahvPealkiri id="64bd6b4e-a894-431d-9f55-5124a971fd7b">Teenuse taotlemine ja rahastamine</paragrahvPealkiri><loige id="para4lg1"><loigeNr id="cc92a142-0712-4ba7-a7ac-cde34a69da5b">1</loigeNr><kuvatavNr id="107c7859-5892-44d7-bd6c-37ef031d9ffe"><![CDATA[(1)]]></kuvatavNr><sisuTekst id="4bd18e62-6ac1-49a4-8be0-237171b9c40e"><tavatekst id="3ce5ec48-7612-4c8b-b41a-555c2b560f8c">Teenuse taotlus esitatakse suuliselt või kirjalikult Viljandi Laste ja Perede Tugikeskusele, kes teenust korraldab.</tavatekst></sisuTekst></loige><loige id="para4lg2"><loigeNr id="53e68f93-c106-4e15-ba46-6c9c851508d2">2</loigeNr><kuvatavNr id="d48d3851-6d23-4112-bd4e-b446417114b8"><![CDATA[(2)]]></kuvatavNr><sisuTekst id="ac4b7878-bbfa-443c-a528-f8d63408f4bd"><tavatekst id="e4a9e507-e6c8-4999-9530-d3069eb085d5">Abi taotluse võib esitada isik enda kohta ise või muu isik, kes märkab abivajadust.</tavatekst></sisuTekst></loige><loige id="para4lg3"><loigeNr id="be6b94f8-941f-4a9f-b130-b5d68e8b2e7a">3</loigeNr><kuvatavNr id="6d79296e-343f-4d1a-97e1-6d7fc94b26a7"><![CDATA[(3)]]></kuvatavNr><sisuTekst id="80f35138-0f0e-4f37-9bc8-211a38d55bd4"><tavatekst id="32aa1da2-976c-4542-82e6-f234784cab6e">Abi taotlemisel tuleb kirjeldada abivajadust ja esitada vajalikud andmed, dokumendid või tõendid abivajaduse hindamiseks.</tavatekst></sisuTekst></loige><loige id="para4lg4"><loigeNr id="ae9efa01-4d12-45d0-8174-f31de792f88f">4</loigeNr><kuvatavNr id="6f622be8-119e-4406-bb97-66d23eac50f4"><![CDATA[(4)]]></kuvatavNr><sisuTekst id="21c74bac-33bb-4910-9429-f89b1be0d615"><tavatekst id="9a10ba9b-6ddf-465e-ada4-bf9ba0b7657e">Psühhosotsiaalse nõustamise korral määratakse isikule kuni 5 nõustamiskorda jooksva aasta kohta.</tavatekst></sisuTekst></loige><loige id="para4lg5"><loigeNr id="12a0f91a-9f40-4eef-9078-a094c177e338">5</loigeNr><kuvatavNr id="29f90b77-2245-400c-bede-3fc7a8786bcd"><![CDATA[(5)]]></kuvatavNr><sisuTekst id="886a175c-eb4e-4cb8-ad8b-1312756dfd83"><tavatekst id="ead18c32-9321-4202-9505-55e6392b2cc6">Vaimse tervise teenus on tegevuskavast tulenevas mahus või määratud nõustamiskordade ulatuses tasuta.</tavatekst></sisuTekst></loige></paragrahv><paragrahv id="para5"><paragrahvNr id="9a300245-958a-49ee-8117-099b1c86ec15">5</paragrahvNr><kuvatavNr id="88847ff1-f034-4590-96a6-d3ae0bc98ceb"><![CDATA[§ 5. ]]></kuvatavNr><paragrahvPealkiri id="2d1bfb97-bb77-44e1-8655-9c0257ee28f9">Teenuse osutaja ja teenuse vahetu osutaja</paragrahvPealkiri><loige id="para5lg1"><loigeNr id="dc853015-8b3e-4917-b024-6b76a5cc9eb5">1</loigeNr><kuvatavNr id="945297dd-6d6e-4f9f-a229-ca59c303b819"><![CDATA[(1)]]></kuvatavNr><sisuTekst id="2c42c973-843e-47aa-ae8e-194918af055b"><tavatekst id="aa658247-c9cc-4a01-91ac-1b4f2122f8d8">Teenust osutab linnavalitsuse hallatav asutus Viljandi Laste ja Perede Tugikeskus.</tavatekst></sisuTekst></loige><loige id="para5lg2"><loigeNr id="01718cf2-021a-4c58-b761-c2489c1cd633">2</loigeNr><kuvatavNr id="5dc16142-aa4f-4de8-97cc-a2ee92ba944b"><![CDATA[(2)]]></kuvatavNr><sisuTekst id="c3849f51-4adb-4a1b-b817-d4f67e805ae1"><tavatekst id="96e22a86-5695-482f-9cc5-31c988b00c52">Teenuse vahetu osutaja on füüsiline või juriidiline isik, kes osutab teenust käesoleva paragrahvi lõikes 1 nimetatud teenuse osutaja kaudu.</tavatekst></sisuTekst></loige><loige id="para5lg3"><loigeNr id="27b75856-2350-4a66-bf2c-158c3c31cf94">3</loigeNr><kuvatavNr id="c5efd0b3-059d-440e-8ad9-f5d841d43e25"><![CDATA[(3)]]></kuvatavNr><sisuTekst id="f0123b22-81dd-462e-93e7-e50c653ee99b"><tavatekst id="3193f9b4-045b-45b4-9801-5ecfbc08cd50">Teenuse vahetu osutamine võib olla korraldatud ka mõne koostööpartneri või projekti kaudu.</tavatekst></sisuTekst></loige></paragrahv><paragrahv id="para6"><paragrahvNr id="2fef692c-c313-4643-a45c-3ac8593b227e">6</paragrahvNr><kuvatavNr id="2f7e0b4c-95bd-491f-8c10-922ec11f0d21"><![CDATA[§ 6. ]]></kuvatavNr><paragrahvPealkiri id="63e6de0d-007a-4518-9e57-ab9153dc24c8">Teenuse osutaja kohustused ja vastutus</paragrahvPealkiri><loige id="para6lg1"><loigeNr id="2eab9e93-9f66-4446-8cb1-18c299c187ec">1</loigeNr><kuvatavNr id="1cd66004-2a1d-446d-937b-3d6e159ee473"><![CDATA[(1)]]></kuvatavNr><sisuTekst id="cd3f0735-3eb5-47c0-a9da-368be5491769"><tavatekst id="9cc9f4e7-927f-4119-94a3-f9db83a883e2">Teenuse osutaja tagab, et teenuse vahetu osutaja vastab sotsiaalhoolekande seaduse § 156 lõikes 3<sup>9</sup> sätestatud tingimustele ning vastab konkreetse teenuse pakkumiseks sobivale, asjakohasele ettevalmistusele nii sisu kui teenuse tüübi mõttes.</tavatekst></sisuTekst></loige><loige id="para6lg2"><loigeNr id="25a083de-431f-44d2-8362-5d7324c2197f">2</loigeNr><kuvatavNr id="fb9c5367-93d4-4f24-afae-a29c3e12180f"><![CDATA[(2)]]></kuvatavNr><sisuTekst id="0de08d5f-4b28-4d76-ba51-14113a69ea4d"><tavatekst id="9333a171-bfb3-45a9-b399-87f35e1bb70b">Teenuse osutaja kasutab teenuse saajat ja tema pereliikmeid puudutavaid andmeid ning muud teenuse osutamisega seotud informatsiooni ainult teenuse eesmärkidest lähtuvalt ja osapoolte huvides.</tavatekst></sisuTekst></loige><loige id="para6lg3"><loigeNr id="13e24b13-0dce-4dcd-9df1-0f6f5828fe1e">3</loigeNr><kuvatavNr id="b6e69bcc-70fb-4819-9453-c2e0faefc18b"><![CDATA[(3)]]></kuvatavNr><sisuTekst id="a5504f55-759a-4ca2-a420-4689ace1a532"><tavatekst id="1ffbcb7c-d612-47f7-8044-707a8dee72f8">Teenuse osutaja esitab aruanded toetusfondist rahastatud vaimse tervise teenuste kohta ettenähtud tingimustel ja korras.</tavatekst></sisuTekst></loige><loige id="para6lg4"><loigeNr id="3e300549-d7a2-4ca8-b6ea-59df5a10e652">4</loigeNr><kuvatavNr id="362e385c-5d67-4a77-b685-8fa8c63d8051"><![CDATA[(4)]]></kuvatavNr><sisuTekst id="50d2175c-6403-4221-b365-649688446baf"><tavatekst id="5aad2396-371a-4c82-a7f3-5e56ed825ae0">Teenuse osutaja teavitab teenuse osutamise alustamisel kohaliku omavalitsuse elanikke teenusest ja selle osutamise korraldusest.</tavatekst></sisuTekst></loige></paragrahv><paragrahv id="para7"><paragrahvNr id="495a3f1d-ccc8-4131-a940-8c47dac91103">7</paragrahvNr><kuvatavNr id="333acb6a-03c4-4eee-99c5-82a8ffc6b731"><![CDATA[§ 7. ]]></kuvatavNr><paragrahvPealkiri id="e91cf924-e0d0-4c68-84ab-554bfcefbc05">Määruse jõustumine</paragrahvPealkiri><loige id="para7lg1"><loigeNr id="4f8e1352-2828-47f8-ad80-eff4fd2e3a13"/><kuvatavNr id="52d83796-7c56-4b1f-86e6-f9301e18bf0c"/><sisuTekst id="f5fc423b-6232-4a9f-90fa-b6d7dfa136f4"><tavatekst id="04b56df9-a685-4fd2-b8ff-f93b068e6c40">Määrus jõustub kolmandal päeval pärast avaldamist Riigi Teatajas.</tavatekst></sisuTekst></loige></paragrahv></sisu>
<allkiri id="5ab9a859-1a2d-4000-9b2c-4f40729f336f"><allkiriKoht id="645f152c-4a8f-4328-b0c7-b7f63c7b5f55"/><allkirjastaja id="27f06341-d21c-4141-82a0-3145dbf7de0b"><ametinimetus id="7face97b-741a-4dd2-82b7-6d0e33ddad8a">linnavolikogu esimees</ametinimetus><eesnimi id="504d953f-e87b-4f53-8885-5326e336d2f3">Helmen</eesnimi><perekonnanimi id="3751f172-40f4-48ff-9c12-9579bd7f2ef8">Kütt</perekonnanimi></allkirjastaja></allkiri></oigusakt>