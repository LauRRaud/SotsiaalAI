					<aktiNr id="4bc90367-7c94-482b-8264-4ba2a7b69868">31</aktiNr>
				</muutmismarge>
			</loige>
			<loige id="para4lg2b1">
				<loigeNr id="b48c20b8-1e8b-4684-9c55-25cad635743f" ylaIndeks="1">2</loigeNr>
				<kuvatavNr id="f6295a19-017a-4098-8426-0de45d54f424"><![CDATA[(2<sup>1</sup>)]]></kuvatavNr>
				<sisuTekst id="e0732863-0025-49b1-812f-89d81b1e0ae1">
					<tavatekst id="6b15fcba-7418-4aa2-9c3b-02ef56503bcf">Koduse lapse toetuse taotlus esitatakse osakonnale hiljemalt jooksva kalendrikuu 15. kuupäevaks. Taotlused, mis esitatakse peale nimetatud kuupäeva, arvestatakse toetuse määramiseks järgmisest kalendrikuust.</tavatekst>
				</sisuTekst>
				<muutmismarge id="44e77f29-ae60-4a0c-b054-c646c6fd089e">
