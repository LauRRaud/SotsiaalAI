					<aktiNr id="aa629313-e1dc-46f7-9ec4-057016aa0314">35</aktiNr>
				</muutmismarge>
			</loige>
			<loige id="para4lg2">
				<loigeNr id="4f47873c-760e-4475-b02d-0e4d2db6f80e">2</loigeNr>
				<kuvatavNr id="61779715-7e7e-48e1-ba6c-1825f93c6692"><![CDATA[(2)]]></kuvatavNr>
				<sisuTekst id="f5ebf011-43f8-417a-a7f5-50352e25b684">
					<tavatekst id="4731b8e6-4630-4442-87d1-6f2a1f21eccc">Osakonnal on vajadusel õigus nõuda taotlejalt täiendavaid andmeid või dokumente, millest taotlejat informeeritakse taotluse vastuvõtmisel või kirjalikult viie tööpäeva jooksul pärast taotluse vastuvõtmist.</tavatekst>
				</sisuTekst>
				<muutmismarge id="1f73b608-aeea-4207-a639-cf15e8ddf8fa">
					<aktikuupaev id="0e9a0ee3-8f0d-4696-91b3-5df06097c56e">2020-08-25</aktikuupaev>
					<avaldamismarge id="98b5111c-ce47-45d8-86fb-33e2b4eb41a8">
