						<avaldamineKuupaev id="f7991d6e-5a3a-4de0-a14a-cb55eccad034">2020-09-01</avaldamineKuupaev>
						<RTartikkel id="14fad89e-7308-4a63-b6c9-c384888555ee">6</RTartikkel>
