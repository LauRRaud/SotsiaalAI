				</muutmismarge>
			</loige>
			<loige id="para4lg3">
				<loigeNr id="0c22635e-4ca7-4ffa-83ec-a9bad2158898">3</loigeNr>
				<kuvatavNr id="a906eadd-d93e-442a-97a6-7855a7e08219"><![CDATA[(3)]]></kuvatavNr>
				<sisuTekst id="9e15fad7-509d-43fb-8812-911ba8ed4484">
					<tavatekst id="b376f9fd-f393-40b0-8424-977f62f77f41">Taotlus jäetakse rahuldamata, kui kümne tööpäeva jooksul taotluse esitamisest või kirjaliku teate saatmisest ei ole esitatud täiendavalt nõutud andmeid või dokumente.</tavatekst>
				</sisuTekst>
				<muutmismarge id="2731e24a-45da-4a0f-be65-8bac27a41e15">
					<aktikuupaev id="625503a8-1e03-4a82-94a1-f2a7ea726e28">2020-08-25</aktikuupaev>
