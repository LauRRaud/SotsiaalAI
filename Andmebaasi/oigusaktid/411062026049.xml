			<kuvatavNr id="c719da2d-80ab-4e12-b25d-910ac4cc98df"><![CDATA[§ 4. ]]></kuvatavNr>
			<paragrahvPealkiri id="9a9e5017-cf2f-4b97-8279-67a99a8c9728">Toetuse taotlemine</paragrahvPealkiri>
			<loige id="para4lg1">
				<loigeNr id="5902f46f-838d-4293-ae51-de0006e21a89">1</loigeNr>
				<kuvatavNr id="fa40e506-e8f7-488d-901c-a20ac1e04bb6"><![CDATA[(1)]]></kuvatavNr>
				<sisuTekst id="22898e87-dab0-4f42-95cf-1d5c06b15221">
					<tavatekst id="82e01e6c-a8f0-46a4-ac68-199e1151e1c4">Toetuse taotleja esitab vallavalitsusele kirjaliku vormikohase taotluse.</tavatekst>
				</sisuTekst>
				<muutmismarge id="a48e609a-013b-499c-8c12-32e0ab88192a">
					<aktikuupaev id="13f3638f-be7d-4dc3-9407-06ea9f38c04d">2020-10-20</aktikuupaev>
