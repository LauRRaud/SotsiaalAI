						<aktViide id="35cf9b1f-f39e-484c-b4ac-0414d9a85288">429102020003</aktViide>
					</avaldamismarge>
					<joustumine id="5f02c4dd-ad4e-47a8-843f-08224412ba0b">2021-01-01</joustumine>
					<aktiNr id="2396b431-4d6e-40ef-ae50-b6fcc06acd72">35</aktiNr>
				</muutmismarge>
			</loige>
			<loige id="para5lg3">
				<loigeNr id="3276498d-dbd0-4f48-a35b-48b73b954b7b">3</loigeNr>
				<kuvatavNr id="78b72c8c-565c-47e5-a378-00b33beb0e43"><![CDATA[(3)]]></kuvatavNr>
				<sisuTekst id="04926470-5cfb-46d5-922a-b0a364d6acf4">
					<tavatekst id="de3a90b3-f8a6-427d-98d7-3e495635add5">Toetus kantakse üle taotluses märgitud arvelduskontole kord kuus hiljemalt 25. kuupäevaks. </tavatekst>
				</sisuTekst>
				<muutmismarge id="23adb8fa-e057-44ed-8417-800b0bddbf51">
					<avaldamismarge id="f0a42373-e226-4fa1-a456-e3421bbc4f9f">
						<RTosa id="df183633-387a-4525-8840-5419539b9e73">RT IV</RTosa>
						<avaldamineKuupaev id="09bf1083-945e-41a6-b1f8-80ca0731efdd">2020-09-01</avaldamineKuupaev>
						<RTartikkel id="6de49af1-6c55-4195-9aa9-3f92975869d2">6</RTartikkel>
