						<avaldamineKuupaev id="2974a9ea-62ce-4756-b8ba-4ef6c26f3b67">2020-09-01</avaldamineKuupaev>
						<RTartikkel id="8b77cdf0-4abc-4437-8504-06a71c3b3776">6</RTartikkel>
						<aktViide id="a62ceb81-b1ae-4357-a3e8-3222559392e9">401092020006</aktViide>
					</avaldamismarge>
					<joustumine id="41ec4868-1c27-4559-94d7-effe2addad9f">2020-09-04</joustumine>
					<aktiNr id="775d9923-beb6-4ca9-8ec6-c94f3e06a15c">31</aktiNr>
				</muutmismarge>
			</loige>
		</paragrahv>
		<paragrahv id="para5">
			<paragrahvNr id="8e1d1316-1dfd-457c-af0b-42cc81f3e825">5</paragrahvNr>
			<kuvatavNr id="23905445-f788-455b-bca8-a8c95d600719"><![CDATA[§ 5. ]]></kuvatavNr>
			<paragrahvPealkiri id="06456693-529a-4747-896d-115464c016b8">Toetuse määramine ja maksmine</paragrahvPealkiri>
			<loige id="para5lg1">
				<loigeNr id="8c8938cf-6a71-4b88-ba5c-851e4a5ac83d">1</loigeNr>
				<kuvatavNr id="4333edbb-8712-4c11-85f3-35e96036ab47"><![CDATA[(1)]]></kuvatavNr>
				<sisuTekst id="a7a39829-21e7-41ca-90d9-b0acdbf9befa">
					<tavatekst id="6343a1ed-b8af-4b39-ba01-3837477bd1a4">Otsuse toetuse andmise või sellest keeldumise kohta teeb osakond 15 tööpäeva jooksul, arvates toetuse taotlemiseks viimase vajaliku dokumendi saamise päevast. </tavatekst>
				</sisuTekst>
				<muutmismarge id="4201306f-802b-4325-886b-a3fb81ec25d0">
					<avaldamismarge id="4372dd82-90d9-40a5-ab50-5e627f022846">
						<RTosa id="239b413e-b713-491f-a46f-053e065c0c51">RT IV</RTosa>
						<avaldamineKuupaev id="91657b22-e47d-4726-97c0-c39ed9dec65d">2020-09-01</avaldamineKuupaev>
						<RTartikkel id="a15d7148-4ee1-4341-aa76-f0404e7dc5bf">6</RTartikkel>
						<aktViide id="f7d17f92-f0f2-454c-9980-4369d8dc1946">401092020006</aktViide>
					</avaldamismarge>
					<joustumine id="0fc537c7-5e74-4173-99be-fc248fddeafd">2020-09-04</joustumine>
					<aktiNr id="c94ae218-fc57-4822-a8af-11081fdf5b0d">31</aktiNr>
				</muutmismarge>
			</loige>
			<loige id="para5lg2">
				<loigeNr id="e340cf6a-d5c8-48ae-a8c9-06b8374be333">2</loigeNr>
				<kuvatavNr id="cd23ce5a-5675-4289-92e8-46b43da6313f"><![CDATA[(2)]]></kuvatavNr>
				<sisuTekst id="45e51aef-2195-40dc-afe3-9d6b0a7c6287">
					<tavatekst id="b0519bfc-539f-425c-8fbe-5966e164f0ec">Kui taotlust ei rahuldata, saadab osakond taotlejale motiveeritud otsuse viie tööpäeva jooksul otsuse tegemisest.</tavatekst>
				</sisuTekst>
				<muutmismarge id="05df1340-7b75-452c-aa0c-a62a05d52386">
					<avaldamismarge id="17e27224-c2b5-4ca3-8314-4097b5928372">
						<RTosa id="1f0ee48e-36c3-488b-8745-187f48e15e3f">RT IV</RTosa>
