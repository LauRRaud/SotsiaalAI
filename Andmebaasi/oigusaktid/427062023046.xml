   <pealkiri id="ac103f3b-ce93-4832-b3a2-53a3ee2df4c5">Üldhooldusteenuse hoolduskulude piirmäär</pealkiri>
  </nimi>
 </aktinimi>
 <sisu id="106388b7-cc56-4a4d-8a01-d04c732367c4"><preambul id="876c54c5-1921-4d46-97d7-d8f2dd6449b3">
   <tavatekst id="1b0c1e28-35b4-431d-bc77-9fbc0a824521">Tartu Vallavolikogu 24.05.2018 määruse nr 14 „Üldhooldusteenuse osutamise kord Tartu vallas“ § 5 lg 3 sätestab, et sotsiaalhoolekande seaduse §-s 22<sup>1</sup> lg 2 sätestatud kulude tasumise piirmäära kehtestab vallavalitsus määrusega. <reavahetus/>Kohaliku omavalitsuse korralduse seaduse § 30 lg 1 p 2 ja Tartu Vallavolikogu 24.05.2018 määruse nr 14 „Üldhooldusteenuse osutamise kord Tartu vallas“ § 5 lg 3 (redaktsiooni kehtivuse algus 01.07.2023) alusel Tartu Vallavalitsus määrab:</tavatekst>
  </preambul><paragrahv id="para1">
   <paragrahvNr id="627bebdf-35be-4168-9447-d5ee44ca4596">1</paragrahvNr>
   <kuvatavNr id="18b5848b-364c-4be7-9698-88b3bed37ed8"><![CDATA[§ 1. ]]></kuvatavNr>
      <sisuTekst id="2252bbff-73b0-4a4e-8481-5cc6326346e1">
    <tavatekst id="a8b78561-0e3b-41bc-a305-31eb49e38707">Sotsiaalhoolekande seaduse § 22<sup>1</sup> lõikes 2 nimetatud väljaspool kodu osutatavat ööpäevaringset üldhooldusteenust vahetult osutavate hooldustöötajate ja abihooldustöötajate kulude Tartu valla poolt tasumise piirmäär on kuni 700 eurot teenusesaaja kohta kalendrikuus.</tavatekst>
   </sisuTekst>
  </paragrahv><paragrahv id="para2">
   <paragrahvNr id="e9f16399-87e0-4377-8e32-c6087e030c5a">2</paragrahvNr>
   <kuvatavNr id="61ab552b-8cce-4762-ac13-626f057b1a2a"><![CDATA[§ 2. ]]></kuvatavNr>
      <sisuTekst id="21c4d930-90b2-4748-a14e-caf7148d5898">
    <tavatekst id="a804b740-b968-4e1e-b996-0121f74c77ca">Määrus jõustub 1. juulil 2023.</tavatekst>
   </sisuTekst>
  </paragrahv></sisu>
