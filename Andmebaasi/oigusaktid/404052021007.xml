			<loige id="para1lg4">
				<loigeNr id="bbf53871-317a-4a11-a8f0-178304d01299">4</loigeNr>
				<kuvatavNr id="4d78637f-5422-46f7-b65d-582845623fc6"><![CDATA[(4)]]></kuvatavNr>
				<sisuTekst id="7b5b6cad-ca7e-42d3-a5d8-01a40158ee6f">
					<tavatekst id="27d0557b-ee50-4e37-b8f2-920cc0a5b8ad">Hooldatava elukohana peab olema rahvastikuregistrisse kantud Maardu linn. Hooldajatoetust saab taotleda isik, kelle enda elukohana on rahvastikuregistrisse kantud Maardu linn, puudega isiku eest, kelle elukohana on rahvastikuregistrisse kantud Maardu linn.</tavatekst>
				</sisuTekst>
			</loige>
