			<paragrahvPealkiri id="b9a97b65-2c6e-4d24-9e7c-df95dddee1ba">Hoolduse seadmise taotlemine</paragrahvPealkiri>
			<loige id="para3lg1">
				<loigeNr id="9f5bcaba-4897-4392-9e19-47d5bc237541">1</loigeNr>
				<kuvatavNr id="4365d660-2103-4de0-a646-f05d39434ff5"><![CDATA[(1)]]></kuvatavNr>
				<sisuTekst id="28912d48-ea14-4613-92ea-25e428afbebb">
					<tavatekst id="5dfbb5fc-a4a7-4aca-8035-7fc4ea3c739a">Hoolduse seadmiseks esitab abivajav isik või tema seaduslik esindaja Maardu Linnavalitsusele (edaspidi: <i>ametiasutus</i>) kirjaliku taotluse, milles märgitakse:</tavatekst>
				</sisuTekst>
				<alampunkt id="para3lg1p1">
					<alampunktNr id="4a4ae3f9-db83-4e74-b636-6b990c210d7f">1</alampunktNr>
					<kuvatavNr id="10d5111e-46d9-4bb0-87ed-84e89cb026b0"><![CDATA[1) ]]></kuvatavNr>
					<sisuTekst id="2cd7280c-f3f3-4cfa-a149-597cd4b300ad">
						<tavatekst id="9d4bbf8b-f7db-4457-ae69-21f7ad361779"> hooldust vajava isiku nimi, isikukood, elukoht, kontaktandmed;</tavatekst>
					</sisuTekst>
				</alampunkt>
				<alampunkt id="para3lg1p2">
					<alampunktNr id="882b46cc-cc55-46f2-afb1-947e437eca74">2</alampunktNr>
					<kuvatavNr id="7777cef9-1502-4ebc-8ab9-78af53089ffa"><![CDATA[2) ]]></kuvatavNr>
					<sisuTekst id="e20e6771-43d9-4dac-846e-86c343c39b35">
						<tavatekst id="3be0158d-c880-43c2-b242-74afc14ee820">nõusolek isikuandmete töötlemiseks;</tavatekst>
					</sisuTekst>
				</alampunkt>
				<alampunkt id="para3lg1p3">
					<alampunktNr id="6587aa55-c558-492e-94e4-a09b309c41a0">3</alampunktNr>
					<kuvatavNr id="df959b43-a270-4905-8731-2075bc218d54"><![CDATA[3) ]]></kuvatavNr>
					<sisuTekst id="c4d64229-603e-4ea0-864f-97bf8acb92ea">
						<tavatekst id="770a41a6-0eed-49a1-865c-26040750680e">soovitud hooldaja olemasolul tema nimi ja andmed (isikukood, elukoht, kontaktandmed);</tavatekst>
					</sisuTekst>
					<muutmismarge id="f4a1a19e-82aa-44d5-9f9b-16e98d5e0892">
						<avaldamismarge id="8fe36ec9-c69f-4308-abd5-edf040d22ea5">
