			<RTosa id="0adcb922-0bbf-4f2e-a817-e13cc14e43f5">RT IV</RTosa>
			<avaldamineKuupaev id="0fe0750b-4857-4902-9f4a-337d4de391d0">2024-12-31</avaldamineKuupaev>
			<RTartikkel id="94982852-d4bd-44c4-9360-49a0925d9c6f">2</RTartikkel>
