							<aktViide id="9324ddd6-d92c-49c5-bd37-b6b82dd4b720">408102022016</aktViide>
						</avaldamismarge>
						<joustumine id="86b736be-9bc0-4310-92f1-a549ca2e50f5">2022-10-11</joustumine>
					</muutmismarge>
				</alampunkt>
				<alampunkt id="para1lg1p9">
					<alampunktNr id="f5ea4be3-3101-49dd-bbcf-7b0b820fc7ad">9</alampunktNr>
					<kuvatavNr id="63e4feb2-38c9-4649-815c-32832657c99e"><![CDATA[9) ]]></kuvatavNr>
					<sisuTekst id="eaa0f0d3-5e9a-47fb-a1b4-fe1118aaa9b4">
						<tavatekst id="46d4a300-d6ed-4b85-8174-7ba905bf60f0">majapidamisgaasi maksumus – kulu piirmäär üksi elava isiku või perekonna esimese liikme kohta 70,00 eurot kuus ja iga täiendava perekonna liikme kohta 30,00 eurot kuus;</tavatekst>
					</sisuTekst>
					<muutmismarge id="e5597d18-1b61-4874-86b4-80ddd4b0455f">
