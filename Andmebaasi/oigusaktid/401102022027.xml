				<sisuTekst id="298ae5dd-556d-4a7e-99f2-7998e84168a3">
					<tavatekst id="8178f55a-dd94-4576-9a96-89f28ab414e6"> [Käesolevast tekstist välja jäetud]</tavatekst>
				</sisuTekst>
