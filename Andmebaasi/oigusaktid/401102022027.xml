				<kuvatavNr id="7dcfb94d-e819-4d67-8c27-b15ac86a01b3"><![CDATA[(2)]]></kuvatavNr>
				<sisuTekst id="03fff000-32c8-493d-b3f5-1c682aa1c1c7">
					<tavatekst id="be6c56ca-b3e2-4535-b873-799ba934fc02">Määrus jõustub kolmandal päeval peale Riigi Teatajas avaldamist.</tavatekst>
