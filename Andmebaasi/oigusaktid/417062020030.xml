		<nimi id="0e3636b5-7952-4737-9733-83091cd85d60">
			<pealkiri id="dc11431f-fc51-4b10-a5a5-12db1dffa374">Asendus- ja järelhooldusteenuse osutamise tingimused ja kord</pealkiri>
		</nimi>
	</aktinimi>
	<muutmismarge id="c9c84356-7428-4eab-88a0-b5de611031e8">
		<aktikuupaev id="1b116c9c-cbe6-4454-ba49-d6155c04c303">2020-06-10</aktikuupaev>
		<avaldamismarge id="cf0fcb71-dfd8-4030-96e8-d9e23bfc55f1">
			<RTosa id="fbbd8147-0be5-4bf1-b1ba-2dc761a7a8dd">RT IV</RTosa>
			<avaldamineKuupaev id="cadb8f1e-b01e-4a4a-84f6-bcca1fc7df9b">2020-06-17</avaldamineKuupaev>
			<RTartikkel id="c2e0afc1-b5aa-4d8b-8586-1ef413e7eb32">19</RTartikkel>
			<aktViide id="c38da24f-19a4-45ca-a389-19d4c9671aac">417062020019</aktViide>
		</avaldamismarge>
		<joustumine id="14d392a7-a4a6-4dcc-b28c-649565d60b0c">2020-07-01</joustumine>
