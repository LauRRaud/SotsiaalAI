			<pealkiri id="e804ac17-4983-4147-a44d-a03ef3be2f11">Eluasemekulude piirmäärade kehtestamine toimetulekutoetuse määramisel</pealkiri>
		</nimi>
	</aktinimi>
	<muutmismarge id="c2b560dd-c971-4d36-b544-019d4026b48c">
		<aktikuupaev id="bd0ed91b-76b1-470f-ac90-2e2fdaf6dd46">2024-12-19</aktikuupaev>
