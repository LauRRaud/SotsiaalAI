			<RTartikkel id="9494c0de-d685-453d-b1f9-9d994ea3a9e8">13</RTartikkel>
			<aktViide id="ce3da92c-2ab3-4f68-826c-f3fbed7aee1d">431122024013</aktViide>
		</avaldamismarge>
		<joustumine id="b093d430-62cc-4813-a034-adadaa615ddd">2025-01-03</joustumine>
