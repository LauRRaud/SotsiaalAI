				<aktikuupaev id="fef30f4c-f840-4ede-9d4e-fd07547b9463">2016-02-18</aktikuupaev>
				<avaldamismarge id="329df0e9-3703-461d-8dec-8f0f4846ac7a">
					<RTosa id="7ecbb1f1-8b26-46e8-aaaa-32f93708c538">RT IV</RTosa>
					<avaldamineKuupaev id="26e6058f-9c55-4dff-9351-e497d2216ef6">2016-03-01</avaldamineKuupaev>
					<RTartikkel id="23a2831b-a80d-4055-914f-5e831bced229">6</RTartikkel>
