				</avaldamismarge>
				<joustumine id="9ee03d84-79aa-4f4b-b065-527b2140d7a1">2016-03-04</joustumine>
				<aktiNr id="d59b65f4-bb21-4d8b-8d1a-86adbcaeb2da">4</aktiNr>
			</muutmismarge>
		</preambul>
		<paragrahv id="para1">
			<paragrahvNr id="49cd00d7-42c6-4bf1-b1c0-0e9a78264497">1</paragrahvNr>
			<kuvatavNr id="675f4da0-000d-4596-a063-e607a9f95679"><![CDATA[§ 1. ]]></kuvatavNr>
			<paragrahvPealkiri id="12279a36-ad8b-42b4-92a6-d2efbfa0ea90">Reguleerimisala</paragrahvPealkiri>
			<loige id="para1lg1">
				<loigeNr id="74cd1bcf-a872-4a23-995c-63e5749ec761"/>
				<kuvatavNr id="925c8680-6304-4e49-8f0d-8b29f73b514f"/>
				<sisuTekst id="e76ef059-4bf5-4d16-b224-051384a51edf">
					<tavatekst id="edce923c-a3a2-4ba5-addc-d08d0ee90822">Määrus kehtestab toimetulekutoetuse arvestamise ja määramise aluseks olevad eluruumi alaliste kulude piirmäärad Kiili vallas.</tavatekst>
				</sisuTekst>
			</loige>
		</paragrahv>
		<paragrahv id="para2">
			<paragrahvNr id="a55e4f43-21de-4648-948b-8e8d1f9cfb7d">2</paragrahvNr>
			<kuvatavNr id="204a1f36-cb8e-499e-8c78-a8af01c25316"><![CDATA[§ 2. ]]></kuvatavNr>
			<paragrahvPealkiri id="e5790779-9410-48e0-abf9-b6a17b845b42">Eluruumi alaliste kulude piirmäärade määramise alus</paragrahvPealkiri>
			<loige id="para2lg1">
				<loigeNr id="169cc349-54e3-4c30-8287-aef318fa3869">1</loigeNr>
				<kuvatavNr id="34e1b197-42e5-49dc-8f55-0cea04ddb5a3"><![CDATA[(1)]]></kuvatavNr>
				<sisuTekst id="c91baed2-ceec-4405-a426-9c9436063101">
					<tavatekst id="9c652173-75cb-42d9-a408-5d0f2e4fa1bf">Eluruumi alalisteks kuludeks loetakse sotsiaalhoolekande seaduse § 133 lg 5 loetletud kulud.</tavatekst>
				</sisuTekst>
				<muutmismarge id="73489d76-2b4c-4adc-b9eb-aef4662654cc">
					<aktikuupaev id="b0b1f708-657f-460a-8e72-4294c6658502">2016-02-18</aktikuupaev>
					<avaldamismarge id="074846d3-2be5-485e-bef8-39067558d344">
						<RTosa id="121664b6-5ddc-46a3-b27e-581aa893c656">RT IV</RTosa>
						<avaldamineKuupaev id="e71cf88d-244f-43b9-b727-c360e67a0bba">2016-03-01</avaldamineKuupaev>
						<RTartikkel id="f7f135fa-ed50-4326-9ee1-12fbbfa90b51">6</RTartikkel>
						<aktViide id="327c4ee6-299a-425b-891a-932fa1133a38">401032016006</aktViide>
					</avaldamismarge>
					<joustumine id="0751cf02-e5a0-4634-aedc-4579b75c9f63">2016-03-04</joustumine>
					<aktiNr id="0e78389b-071d-4a33-9f90-4cbf0c58cb36">4</aktiNr>
				</muutmismarge>
			</loige>
			<loige id="para2lg2">
				<loigeNr id="e6ede9b5-9e82-477e-97b3-9275ef3543fb">2</loigeNr>
				<kuvatavNr id="de03be03-4eff-48e7-b629-657fc1a65ce0"><![CDATA[(2)]]></kuvatavNr>
				<sisuTekst id="577d067b-0e3c-40c9-9dee-641de69ee1ef">
					<tavatekst id="f2d1029a-4d26-49f9-afbe-4479fb4a0923">Eluruumi normpinnaks loetakse 18 m<sup>2</sup> üldpinda ühe pereliikme kohta ja täiendavalt 15 m<sup>2</sup> perekonna kohta.</tavatekst>
				</sisuTekst>
			</loige>
			<loige id="para2lg3">
				<loigeNr id="4c5f6ffe-3552-484f-96cd-a188a924ef9a">3</loigeNr>
				<kuvatavNr id="afe6a944-17f6-4fae-82ca-e0031286f275"><![CDATA[(3)]]></kuvatavNr>
				<sisuTekst id="66850ec7-d452-4985-8087-a3ba9b70fe65">
					<tavatekst id="da8ae002-2dd2-484f-bf13-8bb66d159bea">Üksinda elavate pensionäride ning osalise või puuduva töövõimega inimeste eluruumi normpinnaks arvestatakse kuni 51 m<sup>2</sup>.</tavatekst>
				</sisuTekst>
				<muutmismarge id="49f0242c-e772-479e-ad97-0371a57aeb81">
					<aktikuupaev id="06430e46-8b90-40db-ad4a-04ba07d02421">2020-09-17</aktikuupaev>
					<avaldamismarge id="806aa665-830d-4e9b-ba7d-a43fde5499aa">
						<RTosa id="c40593d7-ee9e-4273-892c-199b8bc46071">RT IV</RTosa>
						<avaldamineKuupaev id="cead5ebc-69b2-41fa-9ec8-1ca76b17a321">2020-09-29</avaldamineKuupaev>
						<RTartikkel id="689b7260-3ccf-4220-9848-4ca8f4f46888">18</RTartikkel>
						<aktViide id="67d3ad60-91ba-45d0-8992-7e9d35a31001">429092020018</aktViide>
					</avaldamismarge>
					<joustumine id="a53aed4d-d75a-4a9a-8cd8-1a6504c5b94d">2020-10-02</joustumine>
					<aktiNr id="15fddee7-381d-464a-8836-3317371c6480">13</aktiNr>
				</muutmismarge>
			</loige>
		</paragrahv>
		<paragrahv id="para3">
			<paragrahvNr id="dd5b8445-c785-4528-b12c-9034207d8c88">3</paragrahvNr>
			<kuvatavNr id="3c79f495-7428-4aad-84d9-4aa905c90f79"><![CDATA[§ 3. ]]></kuvatavNr>
			<paragrahvPealkiri id="c189de94-50e7-4c07-abab-bc0757b55446">Eluruumi alaliste kulude piirmäärad</paragrahvPealkiri>
			<loige id="para3lg1">
				<loigeNr id="8799077f-97d6-4080-84ea-5705c523a339"/>
				<kuvatavNr id="b4e63139-c4fa-41cc-b16b-dfe4c68a06d4"/>
				<sisuTekst id="1d631c86-f959-4911-8ebf-81b795d2adbe">
					<tavatekst id="e5492b7f-00d1-4c15-af84-64be726aed22">Toimetuleku arvestamisel arvesse võetavate jooksval kuul tasumisele kuuluvate eluruumi alaliste kulude piirmäärad on järgmised:</tavatekst>
				</sisuTekst>
				<alampunkt id="para3lg1p1">
					<alampunktNr id="463255c5-afc9-44e8-b625-5dd97144340c">1</alampunktNr>
					<kuvatavNr id="5044cc3e-f6ee-4794-9ed0-8e9511369689"><![CDATA[1) ]]></kuvatavNr>
					<sisuTekst id="f63bcdbc-0c0a-43dd-9416-de4d5f64b3f6">
						<tavatekst id="ad86ee15-3e6b-445f-9dd6-2e1f044aa155">üür või eluaseme soetamiseks võetud laenu tagasimakse (sh laenu intressid ja kohustusliku eluasemekindlustuse makse) – kuni 35 m2 üldpinnaga eluruumi korral kuni 12 eurot 1 m2 kohta kuus ning üle 35 m2 üldpinnaga eluruumi korral kuni 10 eurot 1 m2 kohta kuus, kuid mitte rohkem kui 500 eurot kuus;</tavatekst>
					</sisuTekst>
					<muutmismarge id="dc20dc15-ede6-464b-a729-1734ee5a26e0">
						<avaldamismarge id="afa97502-87fb-4788-9ee9-0b2dc252f38d">
							<RTosa id="67979bc2-6109-4301-a9b4-e12af1da2e24">RT IV</RTosa>
							<avaldamineKuupaev id="48528217-6185-4a87-9e3b-30e320036818">2022-08-27</avaldamineKuupaev>
							<RTartikkel id="8021820e-57f9-4e22-9e9f-0504043ccd13">14</RTartikkel>
							<aktViide id="b506b949-8fe1-408c-a509-a01b58114443">427082022014</aktViide>
						</avaldamismarge>
						<joustumine id="be80d8c7-e934-4766-af04-d90b12422a75">2022-08-30</joustumine>
					</muutmismarge>
				</alampunkt>
				<alampunkt id="para3lg1p2">
					<alampunktNr id="5e3cbd7c-8511-4e63-b4ff-c8ed3be2c4f7">2</alampunktNr>
					<kuvatavNr id="da78e2d1-cf88-4091-aacd-e02dd472e27a"><![CDATA[2) ]]></kuvatavNr>
					<sisuTekst id="23609d43-80a1-4bc3-bf31-7f5e5e645946">
						<tavatekst id="cf9ab268-e6e7-435b-b5c5-1be4087b79a9">korterelamu haldamise sh remondiga seotud kulu - kuni 2 eurot 1 m<sup>2</sup> kuus;</tavatekst>
					</sisuTekst>
				</alampunkt>
