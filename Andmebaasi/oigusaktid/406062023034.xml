		<paragrahv id="para1">
			<paragrahvNr id="f41b37ad-a58d-44cc-994f-0ef809e28674">1</paragrahvNr>
			<kuvatavNr id="822c7ea1-83d5-4f1b-b360-28b6da41d7a0"><![CDATA[§ 1. ]]></kuvatavNr>
			<paragrahvPealkiri id="b806f70f-01da-44a9-acfc-8602e11a35da">Toetuste määrad</paragrahvPealkiri>
			<loige id="para1lg1">
				<loigeNr id="0dce25e7-5f88-492b-b235-a1ca577c5f04"/>
				<kuvatavNr id="1c59acf0-cefc-4f18-b3e0-c27636bb6f31"/>
				<sisuTekst id="e50aeddb-deec-40bc-98f8-9825732c27d2">
					<tavatekst id="8c6936ea-c23b-4f93-b489-213f86c2cb98">Saue valla eelarvest makstavate sotsiaaltoetuste ja toetuste piirmäärad ja muude toetuste suurused on järgmised:</tavatekst>
				</sisuTekst>
				<alampunkt id="para1lg1p1">
					<alampunktNr id="ea94c3a2-84d7-4751-b723-9fad7d8384d3">1</alampunktNr>
