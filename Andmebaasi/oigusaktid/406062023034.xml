					<sisuTekst id="d77eb4e6-f6e2-483f-b1e4-a863383ef88b">
						<tavatekst id="63f32258-b190-4f7b-ae55-938b9d259017">sünnitoetuse täismäär 320 eurot;</tavatekst>
					</sisuTekst>
				</alampunkt>
				<alampunkt id="para1lg1p2">
					<alampunktNr id="2cbab713-56f1-43b4-b7e9-ea2af0faa05a">2</alampunktNr>
					<kuvatavNr id="fef49fed-844f-418a-a0b3-f1717bcbee44"><![CDATA[2) ]]></kuvatavNr>
					<sisuTekst id="3fcd6361-63a1-434b-b0d1-a90b2d2b140b">
						<tavatekst id="69e5bc54-1926-44e7-be6d-2d0940b0709a">matusetoetus 250 eurot;</tavatekst>
