ed8-40e9-854a-fc24f11116b1">5</alampunktNr><kuvatavNr id="badf4751-e9bc-4f56-8681-37b8be22d701"><![CDATA[5) ]]></kuvatavNr><sisuTekst id="62036c11-899b-454b-972f-cb638a47c091"><tavatekst id="9e5d3318-322b-407f-8dbb-cd5b0b2e3356">teenuse vajaduse põhjendus.</tavatekst></sisuTekst></alampunkt></loige><loige id="para5lg3"><loigeNr id="55baa9ba-4e2d-4178-8189-473f71b06ffa">3</loigeNr><kuvatavNr id="2f841ea3-4480-425b-b188-39f3edb67d30"><![CDATA[(3)]]></kuvatavNr><sisuTekst id="471297f3-d6a0-4e69-8bfe-3a1f5bfeb002"><tavatekst id="99a7c946-f2ea-4801-8d6b-762a5372d225"> Teenuse osutamise otsustamiseks selgitab vallavalitsuse sotsiaalosakonna ametnik välja teenuse vajaduse, teenuse osutamise sageduse ja mahu.</tavatekst></sisuTekst></loige></paragrahv><paragrahv id="para6"><paragrahvNr id="7904b361-c186-474d-8cc8-bdab79b5dbaf">6</paragrahvNr><kuvatavNr id="c6ad8e2a-1281-463a-9b47-806839ecedf3"><![CDATA[§ 6. ]]></kuvatavNr><paragrahvPealkiri id="3c8630e3-963b-47a6-9af5-ce9a6ef6a3ce">Teenuse määramine</paragrahvPealkiri><loige id="para6lg1"><loigeNr id="57dc017a-230a-43e2-983e-2350c71db0ae">1</loigeNr><kuvatavNr id="c1834051-12bb-47e5-9c0a-0b00cc42d1dc"><![CDATA[(1)]]></kuvatavNr><sisuTekst id="aedccf12-c43b-46f1-b75f-d0e6eeeccaf2"><tavatekst id="5e0c50dd-9651-44a5-838a-72a8101b3d33"> Otsuse teenuse määramise või sellest keeldumise kohta teeb sotsiaalabikomisjoni ettepanekul sotsiaalosakonna juhataja või teda asendav ametnik kümne tööpäeva jooksul nõuetekohase taotluse esitamisest.</tavatekst></sisuTekst></loige><loige id="para6lg2"><loigeNr id="3f2f270b-e55e-4674-8941-b9de1de18809">2</loigeNr><kuvatavNr id="87f05cbc-7b39-474e-9d59-f80186dd162c"><![CDATA[(2)]]></kuvatavNr><sisuTekst id="f05bd6e0-bddc-49f9-8104-2423837f24e9"><tavatekst id="8b7c8a15-4be5-4a1b-9428-406fa1525bcd"> Teenuse määramisest võib keelduda juhul, kui esineb vähemalt üks järgmistest asjaoludest:</tavatekst></sisuTekst><alampunkt id="para6lg2p1"><alampunktNr id="3ae1eb0c-2ed9-412f-8a50-1213e8d3c423">1</alampunktNr><kuvatavNr id="0d3b378c-f2c7-4a48-9b30-d6459205c762"><![CDATA[1) ]]></kuvatavNr><sisuTekst id="c856edb7-9d4c-46cb-9277-a13682e830f6"><tavatekst id="a8bd4bfa-2afd-4221-8786-678f04dc3986">vallavalitsusele ei ole esitatud kõiki teadaolevaid tõeseid ja täielikke andmeid, dokumente ja muid tõendeid, mis on vajalikud teenuse määramise otsustamisel;</tavatekst></sisuTekst></alampunkt><alampunkt id="para6lg2p2"><alampunktNr id="915229d3-31a7-45a0-99a0-c508291324e0">2</alampunktNr><kuvatavNr id="6b4d8a61-163e-4d54-bc3a-cf53d418d6dd"><![CDATA[2) ]]></kuvatavNr><sisuTekst id="06f90410-5140-4962-b8bd-69c393576eb0"><tavatekst id="1d87a3e6-7536-492b-96f8-019cdd5038a4">taotleja ei võimalda teenuse vajadust kontrollida;</tavatekst></sisuTekst></alampunkt><alampunkt id="para6lg2p3"><alampunktNr id="ea08a486-d489-4c61-8574-c3ae04cd2cb2">3</alampunktNr><kuvatavNr id="89f8caed-8ea5-45ae-aada-25e456aabe88"><![CDATA[3) ]]></kuvatavNr><sisuTekst id="be583eb4-9385-434c-8300-48dfb4a4ec3d"><tavatekst id="d8edf3ff-7716-49d4-aaa2-cd2dec217c56">teenust saama õigustatud isik ei osale aktiivselt talle teenuse määramisel;</tavatekst></sisuTekst></alampunkt><alampunkt id="para6lg2p4"><alampunktNr id="192960d8-0a37-4cb5-b337-51a999b74d4d">4</alampunktNr><kuvatavNr id="475d23b7-5c34-4679-a902-dbe1701597ab"><![CDATA[4) ]]></kuvatavNr><sisuTekst id="95e64091-9101-4cfd-97ca-4721d5cb1fd7"><tavatekst id="aca6a47e-f782-4bf3-a11a-48fbb832cd62">taotleja ei ole teavitanud vallavalitsust viivitamata teenuse saamise õigust ja teenuse määramist mõjutavatest asjaoludest ja asjaolude muutumisest;</tavatekst></sisuTekst></alampunkt><alampunkt id="para6lg2p5"><alampunktNr id="5ca1979f-23aa-49e5-bded-76c5dd17232a">5</alampunktNr><kuvatavNr id="487b13b1-0f2e-4f4e-b8c5-7aee0ad413cb"><![CDATA[5) ]]></kuvatavNr><sisuTekst id="10e74e6b-f272-4052-8860-0a42fcd846d5"><tavatekst id="4f848c9f-cd29-40ce-aead-2111eabd17d6">teenuse vajadust on võimalik või otstarbekas katta muude teenuste või muu abiga;</tavatekst></sisuTekst></alampunkt><alampunkt id="para6lg2p6"><alampunktNr id="9489657b-5435-45f4-a532-bfe3e13832f7">6</alampunktNr><kuvatavNr id="4e86eb34-ea19-4e93-aec3-a708f56353ff"><![CDATA[6) ]]></kuvatavNr><sisuTekst id="2e0721d4-6360-48e5-9506-1dfc8e051f41"><tavatekst id="823fd596-19a6-4fbb-ba45-3564d384d80c">teenuse saaja käitumine (agressiivsus, ebaviisakas käitumine, alkoholi või narkootiliste ainete kuritarvitamine vms) või teenuse saaja isikust tulenev muu objektiivne põhjus muudab teenuse osutamise võimatuks.</tavatekst></sisuTekst></alampunkt></loige></paragrahv><paragrahv id="para7"><paragrahvNr id="967a5166-b68e-4769-bd0d-1d2997a534a1">7</paragrahvNr><kuvatavNr id="5362f701-f230-4e37-9989-d18b8c0b722c"><![CDATA[§ 7. ]]></kuvatavNr><paragrahvPealkiri id="0e06dcd5-dc69-420c-a37c-1df62b3d95d5">Teenuse osutamine</paragrahvPealkiri><loige id="para7lg1"><loigeNr id="925d59f2-722b-4ead-9629-7a74954d2ffe"/><kuvatavNr id="6891cf10-7585-42ff-a39f-aef95bbfb87b"/><sisuTekst id="79df7db1-e0b4-443a-9bbf-a934cd6e8925"><tavatekst id="d0d50370-6b7d-4087-9396-b8ba20e7290f">Vallavalitsus võib sõlmida halduslepingu teenuse osutamiseks eraõigusliku juriidilise või füüsilisele isikuga.</tavatekst></sisuTekst></loige></paragrahv><paragrahv id="para8"><paragrahvNr id="b15e7a6b-55ac-4cf9-ac2d-9f902d936d04">8</paragrahvNr><kuvatavNr id="a817fcc3-dd4b-4b21-a9e1-75752cfba73c"><![CDATA[§ 8. ]]></kuvatavNr><paragrahvPealkiri id="f095717e-9bb6-42d4-9c47-1ae772a62b18">Teenuse eest tasumine</paragrahvPealkiri><loige id="para8lg1"><loigeNr id="1822bf55-88c0-4bdc-b38d-a553c0c197f1">1</loigeNr><kuvatavNr id="6a926359-c933-4426-a080-62335c74b105"><![CDATA[(1)]]></kuvatavNr><sisuTekst id="41201e66-1d23-4b4a-83e3-dbc477aba9a2"><tavatekst id="79f06a8a-05c0-45b6-afa5-48efd17662a4"> Teenuse saajale on osutatav teenus tasuta.</tavatekst></sisuTekst></loige><loige id="para8lg2"><loigeNr id="c85b6a4f-665e-475a-9bd6-776bec61c810">2</loigeNr><kuvatavNr id="f4c31a91-f6fa-4e77-bcc2-27f2ef964f31"><![CDATA[(2)]]></kuv