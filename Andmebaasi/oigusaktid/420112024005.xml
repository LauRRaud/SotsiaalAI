		<preambul id="37396135-d291-48ce-a88f-928ca498bf4e">
			<tavatekst id="ba0ef9aa-2921-4419-8473-5c012a9acc72">Määrus kehtestatakse "Sotsiaalhoolekande seadus" § 133 lg 5 ja 6 alusel.</tavatekst>
		</preambul>
		<paragrahv id="para1">
			<paragrahvNr id="8c5bc359-d945-4001-9d97-1a1c729240bf">1</paragrahvNr>
			<kuvatavNr id="0ac1339b-d286-4e49-a5e0-dea6a9424471"><![CDATA[§ 1. ]]></kuvatavNr>
			<paragrahvPealkiri id="79a52388-b864-47fe-98d0-a0c70b43259f">Reguleerimisala</paragrahvPealkiri>
			<loige id="para1lg1">
				<loigeNr id="58177047-7e0b-4830-b19d-873d91575d70"/>
				<kuvatavNr id="6e43bedb-81cd-461d-8a11-df43210ad359"/>
				<sisuTekst id="7351695b-8976-4521-aa48-3913428101ca">
					<tavatekst id="aac06246-6d9f-479d-b686-7e4f176c6c36">Määrusega kehtestatakse eluasemekulude piirmäärad toimetulekutoetuse määramisel Võru linnas.</tavatekst>
				</sisuTekst>
			</loige>
		</paragrahv>
		<paragrahv id="para2">
			<paragrahvNr id="818dee82-bf70-4e75-bd85-cfd15f34feeb">2</paragrahvNr>
			<kuvatavNr id="5ae9db83-5bb9-407e-95d3-b43ff82e7b2f"><![CDATA[§ 2. ]]></kuvatavNr>
			<paragrahvPealkiri id="f142fd86-5df1-47d8-8b74-aa7c53b8e9ea">Eluasemekulude arvestamise alused</paragrahvPealkiri>
			<loige id="para2lg1">
				<loigeNr id="36f8e53a-6363-4f81-859a-8a15bfa6689b"/>
				<kuvatavNr id="381bb732-e274-488d-9292-f49e7e9d8e31"/>
				<sisuTekst id="78a225dc-71e0-4468-b872-363d606e5fb0">
					<tavatekst id="48ddc324-5cd0-4080-a370-c96d9fd03f31">Toimetulekutoetuse arvestamisel võetakse arvesse eluruumi sotsiaalselt põhjendatud norm või perekonnaliikmete arv ning jooksval kuul tasumisele kuuluv eluruumi tegelik kulu käesoleva määruse paragrahvis 3 sätestatud piirmäärade ulatuses.</tavatekst>
				</sisuTekst>
			</loige>
		</paragrahv>
		<paragrahv id="para3">
			<paragrahvNr id="21dd312c-2cbc-4e08-bcc5-ffe602552aad">3</paragrahvNr>
			<kuvatavNr id="61e2220b-f216-46d2-880d-04b8d8d5d6ed"><![CDATA[§ 3. ]]></kuvatavNr>
			<paragrahvPealkiri id="36f969c5-71ef-4153-bba2-248f199170c2">Piirmäärad</paragrahvPealkiri>
			<loige id="para3lg1">
				<loigeNr id="bb7665ab-308e-4600-b33f-848faff39792">1</loigeNr>
				<kuvatavNr id="930fee66-4fac-4edc-888d-a3665d79df7c"><![CDATA[(1)]]></kuvatavNr>
				<sisuTekst id="8c666aaf-e346-437b-b298-382f729628e0">
					<tavatekst id="bd08894d-e825-4d7e-a222-8bff92dc5f89">Üüri piirmäär kuni 7,00 eurot ühe m² kohta kuus.</tavatekst>
				</sisuTekst>
				<muutmismarge id="c5dc7848-06de-43d8-b611-cf8e0d280bb6">
					<avaldamismarge id="83c1fc35-7d55-442c-b7f9-cab4c41149b3">
						<RTosa id="6d794f61-ea46-4b5f-8690-b3711c4705ff">RT IV</RTosa>
						<avaldamineKuupaev id="1e4c28a0-e6f1-4aa9-b43d-9d684b752f06">2021-12-18</avaldamineKuupaev>
						<RTartikkel id="c91cc50e-0bb4-4382-b81d-72efe4493c5c">31</RTartikkel>
						<aktViide id="1baeae4c-0321-4c09-b2c1-16372427598b">418122021031</aktViide>
					</avaldamismarge>
					<joustumine id="fab56172-6ea1-41a4-9356-460c215d4114">2022-01-01</joustumine>
				</muutmismarge>
			</loige>
			<loige id="para3lg2">
				<loigeNr id="128df591-6d20-4948-a988-e97eb180b064">2</loigeNr>
				<kuvatavNr id="cf85fa2e-edce-441d-8699-26135ff227ee"><![CDATA[(2)]]></kuvatavNr>
				<sisuTekst id="1827d904-f0e8-469b-9b9a-6aa826377621">
					<tavatekst id="dd6e67e7-a2ba-450c-986f-a7dbf3cb5941">Korterelamu haldamise kulu, sh remondiga seotud kulu kuni 3,00 eurot ühe m<sup>2</sup> kohta kuus.</tavatekst>
				</sisuTekst>
			</loige>
			<loige id="para3lg3">
				<loigeNr id="de5e7ae5-8852-4c2e-a33f-3b0629bce961">3</loigeNr>
				<kuvatavNr id="d88616f8-240f-4bc0-a3fc-de2cd1fe603a"><![CDATA[(3)]]></kuvatavNr>
				<sisuTekst id="db8c29b3-9ffc-4f84-a246-14ca3d560424">
					<tavatekst id="9da10665-cb2b-4273-8f31-a44f496da4df">Korterelamu renoveerimiseks võetud laenu tagasimakse kuni 4,00 eurot ühe m<sup>2 </sup>kohta kuus.</tavatekst>
				</sisuTekst>
			<muutmismarge id="801d657f-ba20-4234-80f5-84d88efade70"><avaldamismarge id="d347cf07-7d02-4ea9-8709-d358e935a638"><RTosa id="997c9541-7647-42b6-babb-d9677904a172">RT IV</RTosa><avaldamineKuupaev id="3583b102-3dce-49ee-83c4-dee9b0b2e6f7">2024-11-20</avaldamineKuupaev><RTartikkel id="5e50f09a-a40c-4ef2-965d-72d7f1ca962b">3</RTartikkel><aktViide id="76763087-ae09-4b99-8431-2829cb64039f">420112024003</aktViide></avaldamismarge><joustumine id="60cdf8a1-f8a9-4dc7-9279-7a6859ae6f67">2025-01-01</joustumine></muutmismarge></loige>
			<loige id="para3lg4">
				<loigeNr id="6cfbd359-9095-47c7-8118-ef38fe339540">4</loigeNr>
				<kuvatavNr id="16da2ae0-6ed6-460f-b04c-860a474052c3"><![CDATA[(4)]]></kuvatavNr>
				<sisuTekst id="13694d19-e9c9-4aff-b9fb-a592ee3e83f4">
					<tavatekst id="d63cb56f-024b-4baf-b247-1cf9e963a30a">Kütteks või soojaveevarustuseks tarbitud soojusenergia või kütuse maksumuse piirmäärad:</tavatekst>
				</sisuTekst>
				<alampunkt id="para3lg4p1">
					<alampunktNr id="9262f054-e49b-4718-98e5-1df603766363">1</alampunktNr>
					<kuvatavNr id="379379ce-3932-4c66-9f2b-061369fd831b"><![CDATA[1) ]]></kuvatavNr>
					<sisuTekst id="dd98734a-b8ab-466d-b5cb-898525cdb64f">
						<tavatekst id="9807070c-7d84-44cb-b237-f183bf482cef">kaugküttega, soojaveevarustusega eluruum kuni 10,00 eurot ühe m<sup>2</sup> kohta kuus;</tavatekst>
					</sisuTekst>
				</alampunkt>
				<alampunkt id="para3lg4p2">
					<alampunktNr id="14b7b5a3-2365-4b53-b104-41536bdf1453">2</alampunktNr>
					<kuvatavNr id="9a6018ef-7852-45d9-ba57-a16af16f7465"><![CDATA[2) ]]></kuvatavNr>
					<sisuTekst id="c46a1f82-da5f-4120-a22e-7d2972091a2f">
						<tavatekst id="43c7ff10-8a2b-4740-8495-90a657bec342">kaugkütteta (ahi- või gaasiküttega eluruumi) kuni 5,00 eurot ühe m² kohta kuus;</tavatekst>
					</sisuTekst>
					<muutmismarge id="dfa364ef-fc6e-4356-bc4d-796f3e65c4e2">
						<avaldamismarge id="ebeef0ec-9020-4259-86f3-64d271721373">
							<RTosa id="ee9ebc7d-8a7e-449f-9ee5-594f1e3553ee">RT IV</RTosa>
							<avaldamineKuupaev id="7497a0f0-35ac-4bd2-88a7-fafa8ceebc8b">2021-12-18</avaldamineKuupaev>
							<RTartikkel id="ae4a6eda-033d-430d-98e5-5dd0e9ccdbfe">31</RTartikkel>
							<aktViide id="298cebfa-9e48-420a-a341-9907cfed7744">418122021031</aktViide>
						</avaldamismarge>
						<joustumine id="4274f57b-9f11-4be3-b52d-82ebd1d98d1b">2022-01-01</joustumine>
					</muutmismarge>
				</alampunkt>
				<alampunkt id="para3lg4p3">
					<alampunktNr id="e23b082a-a67d-4ed9-8ae3-11381eb1d163">3</alampunktNr>
					<kuvatavNr id="d687124e-d345-41a7-89f9-98e9ed9dcb9a"><![CDATA[3) ]]></kuvatavNr>
					<sisuTekst id="2c1e8517-ef08-47d9-9a22-ffa867fdb6ae">
						<tavatekst id="66687ff7-b285-43dc-b5f0-288f5f56571b">elektriküttega eluruum kuni 3,00 eurot ühe m<sup>2</sup> kohta kuus.</tavatekst>
					</sisuTekst>
				</alampunkt>
				<alampunkt id="para3lg4p4">
					<alampunktNr id="80797273-a53d-4495-a815-80138da36339">4</alampunktNr>
					<kuvatavNr id="9aef8011-6662-493d-90c5-678e2b9cca55"><![CDATA[4) ]]></kuvatavNr>
					<sisuTekst id="b9efb3b3-9fca-4537-b64b-4cf76a91d926">
						<tavatekst id="2409041a-9032-4311-a06d-14e7aeab80c6">juhul kui kuludokumendil kajastub taotlusele järgneva perioodi küttekulu, kompenseeritakse see kuludokumendi esitamisele järgnevatel kuudel kehtestatud piirmäärade ulatuses, kui järgnevatel kuudel toimetulekutoetuse taotlejal on õigustoimetulekutoetust taotleda, vastavalt kehtestatud piirmäärale kuludokumendil näidatud summa kompenseerimiseni või kuni uue kuludokumendi esitamiseni.</tavatekst>
					</sisuTekst>
				</alampunkt>
			</loige>
			<loige id="para3lg5">
				<loigeNr id="2c803c31-fda4-4f1e-b3d0-decc241a40af">5</loigeNr>
				<kuvatavNr id="f16396de-d56d-4211-8050-1af06934defd"><![CDATA[(5)]]></kuvatavNr>
				<sisuTekst id="c13bd2b7-6a72-448a-95d3-6e4fa51dc4b3">
					<tavatekst id="1b4fee34-b172-45f4-814d-9e7e59c295c4">Veevarustuse ja reovee ärajuhtimise teenuste maksumus:</tavatekst>
				</sisuTekst>
				<alampunkt id="para3lg5p1">
					<alampunktNr id="69ac4364-a889-422c-b95f-0b08a33dc051">1</alampunktNr>
					<kuvatavNr id="e2d4a783-ee44-4e8c-84ab-2c81ca14e061"><![CDATA[1) ]]></kuvatavNr>
					<sisuTekst id="ab2301cb-59bb-4be8-91b0-228cb4cda149">
						<tavatekst id="0d121ecf-e53b-473f-9287-738e562400e7">kuni 4 m<sup>3</sup> perekonna esimese liikme kohta kuus;</tavatekst>
					</sisuTekst>
				</alampunkt>
				<alampunkt id="para3lg5p2">
					<alampunktNr id="68230e94-6f85-4d4e-a8b4-2c05ef214d21">2</alampunktNr>
					<kuvatavNr id="ad97c0e1-98d8-4c96-b78e-a9b328702335"><![CDATA[2) ]]></kuvatavNr>
					<sisuTekst id="84883bd9-8366-4327-9e92-1171cc5af455">
						<tavatekst id="ada9a556-949d-4b6f-81fc-9804b507532c">kuni 3 m<sup>3</sup> perekonna iga järgneva liikme kohta kuus.</tavatekst>
					</sisuTekst>
				</alampunkt>
			</loige>
			<loige id="para3lg6">
				<loigeNr id="66522f09-80fe-4c8c-9114-f812b9fea484">6</loigeNr>
				<kuvatavNr id="f80e9c67-9615-49df-a249-7646498114f1"><![CDATA[(6)]]></kuvatavNr>
				<sisuTekst id="e7062e9a-45a3-4f71-9da4-6149df76461c">
					<tavatekst id="865e01b7-24d3-4fd1-87b5-eec2c8edd21a">Elektrienergia tarbimisega seotud kulu:</tavatekst>
				</sisuTekst>
				<alampunkt id="para3lg6p1">
					<alampunktNr id="b6f5ec86-c569-4cbb-bae2-72bff27ec240">1</alampunktNr>
					<kuvatavNr id="a7ca319b-1e02-485b-a20e-0e195f2e8648"><![CDATA[1) ]]></kuvatavNr>
					<sisuTekst id="a1aff671-b425-4ab4-839b-78bd03965f8b">
						<tavatekst id="b431d453-9e0e-467f-baee-321560581be5">kuni 100,00 eurot üheliikmelise pere kohta kuus;</tavatekst>
					</sisuTekst>
				</alampunkt>
				<alampunkt id="para3lg6p2">
					<alampunktNr id="7b704769-0c9b-4d60-a9e4-bdd327ba3062">2</alampunktNr>
					<kuvatavNr id="be290df1-68b1-48e8-b5dc-5077410aefdb"><![CDATA[2) ]]></kuvatavNr>
					<sisuTekst id="fc66a412-51e8-49ff-a9a8-91d74816bcab">
						<tavatekst id="04cf1d81-9e5c-42e1-9f1c-d17993b0b57a">kuni 40,00 eurot iga järgneva pereliikme kohta kuus.</tavatekst>
					</sisuTekst>
					<muutmismarge id="2ab8163e-516f-4d54-90b7-c9680c229ddb">
						<avaldamismarge id="52a15099-9e20-4853-a8e9-f48854221cfa">
							<RTosa id="5f975367-3224-456c-8b94-9b04c7c0ba11">RT IV</RTosa>
