  <loige id="para2lg1">
   <loigeNr id="5fb6fc7c-03f8-48df-a60c-0b33623f22ef"/>
   <kuvatavNr id="0726c524-9265-4191-ba4d-4fdc7de64d90"/>
   <sisuTekst id="6cfc93a0-8d92-4657-a9a5-93e99f0bb833">
    <tavatekst id="ecad080d-cc19-423a-a379-8f2f29b5dddd">Määrus jõustub 1. juulil 2023.</tavatekst>
