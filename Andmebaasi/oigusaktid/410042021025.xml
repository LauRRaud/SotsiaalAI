					<avaldamismarge id="67f364ec-60bc-4a92-a8e3-bfd83628fa13">
						<RTosa id="d881fb5c-51d6-4a00-b72b-31dcb48ee016">RT IV</RTosa>
						<avaldamineKuupaev id="a44d79d6-8950-4e5c-ac8f-c5cc45404d48">2021-04-10</avaldamineKuupaev>
						<RTartikkel id="601861a3-7192-45ad-8369-6b60a1bbcfd9">13</RTartikkel>
						<aktViide id="1bbde494-22ef-44eb-9ed4-8acb68bf0e82">410042021013</aktViide>
					</avaldamismarge>
