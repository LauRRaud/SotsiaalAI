				<sisuTekst id="296fbc37-0f56-4f3c-8f8b-e0319bfbcc78">
					<tavatekst id="f9628ea4-f8f3-46ad-b772-60784ed27b17"> [Käesolevast tekstist välja jäetud.]</tavatekst>
				</sisuTekst>
			</loige>
			<loige id="para6lg4">
				<loigeNr id="36d3100b-0535-4fb2-8d41-bae724303ae6">4</loigeNr>
				<kuvatavNr id="9b57679e-f9cc-46fb-8bc6-135f284b4adb"><![CDATA[(4)]]></kuvatavNr>
				<sisuTekst id="307d6d6d-3be1-41f4-b969-02e30c4c3a14">
					<tavatekst id="053a0ba6-9a39-4252-8284-4c44bd48c42d"> Määrus jõustub kolmandal päeval pärast Riigi Teatajas avaldamist.</tavatekst>
				</sisuTekst>
			</loige>
