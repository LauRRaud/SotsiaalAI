   <pealkiri id="8ad9a482-45a0-400f-bc1c-5d661fc6b47b">Koduteenuse osutamise kord </pealkiri>
  </nimi>
 </aktinimi>
 <sisu id="7a8187ce-02be-4a3f-909b-d36a8b7c74f1"><preambul id="d7941249-4f17-45c7-a7b8-9b690f8ca857"><tavatekst id="b467dd01-e95c-43e5-9b30-0decd66a85ef">Määrus kehtestatakse kohaliku omavalitsuse korralduse seaduse § 6 lõike 1, § 22 lõike 1 punkti 5 ning sotsiaalhoolekande seaduse § 17 lõike 1 alusel.</tavatekst></preambul><paragrahv id="para1"><paragrahvNr id="90ed9c6b-e868-4c70-afd4-d32df1b6ee1d">1</paragrahvNr><kuvatavNr id="05cec135-2004-4902-859a-e58e3392c863"><![CDATA[§ 1. ]]></kuvatavNr><paragrahvPealkiri id="af300e45-c87f-4878-9678-48d752b0da06">Määruse reguleerimisala</paragrahvPealkiri><loige id="para1lg1"><loigeNr id="76f6e02a-45b1-4d43-ab6a-3cd7b8ea551a"/><kuvatavNr id="485fab23-462b-49e3-9f54-432b36551439"/><sisuTekst id="0008b9ed-0e92-420a-b899-a5c25e201237"><tavatekst id="58cb907a-bea5-48e3-a0d5-063a716b2e1a">Kord sätestab koduteenuste tingimused, majanduslikud ning õiguslikud alused, koduteenuste loetelu, samuti reguleerib teenustest tekkivaid lepingulisi suhteid lähtuvalt sotsiaalhoolekande seadusest, sotsiaalseadustiku üldosa seadusest ja perekonnaseadusest.</tavatekst></sisuTekst></loige></paragrahv><paragrahv id="para2"><paragrahvNr id="1d534637-bd69-4481-be6d-dec9874a2d9f">2</paragrahvNr><kuvatavNr id="ae0db9fd-d514-49b4-8464-798c0dc79283"><![CDATA[§ 2. ]]></kuvatavNr><paragrahvPealkiri id="ce2f62fb-474f-443f-a1b7-2b8f87508a82">Koduteenuse eesmärk ja sisu</paragrahvPealkiri><loige id="para2lg1"><loigeNr id="43fbcb2f-8c49-471d-ba6b-b9814628fd18">1</loigeNr><kuvatavNr id="895ccab9-afb3-4773-bb0f-0b4f7cfe6107"><![CDATA[(1)]]></kuvatavNr><sisuTekst id="72ffb38c-70b8-48f9-980a-9e4688ad77b4"><tavatekst id="bbb8d25b-740c-4137-a0b7-f9460622c691"> Koduteenuse eesmärk on täisealise isiku iseseisva ja turvalise toimetuleku tagamine kodustes tingimustes, säilitades ja parandades tema elukvaliteeti.</tavatekst></sisuTekst></loige><loige id="para2lg2"><loigeNr id="cafa440b-1b08-4e90-9881-8f7acea4080a">2</loigeNr><kuvatavNr id="4539a68e-a05d-4945-9eed-552c2962b8bf"><![CDATA[(2)]]></kuvatavNr><sisuTekst id="6133d1e7-7862-485d-879e-3fc986ec24f2"><tavatekst id="8d0b8dc6-a6d5-4bd5-9e70-2c14856c2c26"> Koduteenuse osutamisel abistatakse isikut toimingutes, mida isik terviseseisundist, tegevusvõimest või elukeskkonnast tulenevatel põhjustel ei suuda sooritada kõrvalabita, kuid mis on vajalikud kodustes tingimustes elamiseks, nagu kütmine, toiduvalmistamine, eluruumi ja riiete korrastamine ning väljaspool eluruumi toiduainete ja majapidamistarvete ostmine ja muu asjaajamine.</tavatekst></sisuTekst></loige></paragrahv><paragrahv id="para3"><paragrahvNr id="a1831eb3-414f-4026-99d2-d20969973ef1">3</paragrahvNr><kuvatavNr id="ac71154b-5fe5-4c07-a497-6e5ff50b563f"><![CDATA[§ 3. ]]></kuvatavNr><paragrahvPealkiri id="a37e528e-9fa7-453f-bcab-a0879ccc6427">Mõisted</paragrahvPealkiri><loige id="para3lg1"><loigeNr id="0064669a-c107-4b49-980e-387947eeb47c"/><kuvatavNr id="7a7e50aa-f3fc-4a4b-8819-726f1d94d75c"/><sisuTekst id="8f2255ab-4b3c-4741-baf7-692b37b9a481"><tavatekst id="23e4bd17-4323-4f41-ab10-c14ab48d1641">Korras kasutatakse mõisteid järgmises tähenduses:</tavatekst></sisuTekst><alampunkt id="para3lg1p1"><alampunktNr id="232b54bc-34a5-495b-83cc-f34d77fa9fe9">1</alampunktNr><kuvatavNr id="267288bb-c476-47de-b48d-db3167e19774"><![CDATA[1) ]]></kuvatavNr><sisuTekst id="27c5b603-6e5a-4d7a-b6e6-59f48570a0ff"><tavatekst id="fd9261d5-e1c0-4a1f-86e3-3755a856555b">koduteenused – teenused, mille raames abistatakse isikut tema eluruumis igapäevaeluks vajalike tegevuste elluviimisel ning asjaajamisel väljaspool eluruumi, et tagada isiku võimalikult iseseisev toimetulek kodustes tingimustes (edaspidi <i>teenus</i>). Teenused jagunevad põhi- ja tugiteenusteks:<reavahetus/>1.1) põhiteenus – on koduteenus, mis aitab harjumuspärases keskkonnas toime tulla ning võimaldab isikul jätkata elamist kodus,<reavahetus/>1.2) tugiteenus – lisaks põhiteenusele osutatav koduteenus, mis soodustab isiku toimetulekut isiku kodus ja vajadusel väljaspool kodu;</tavatekst></sisuTekst></alampunkt><alampunkt id="para3lg1p2"><alampunktNr id="11a8f593-7623-4fba-8041-0d20a8140662">2</alampunktNr><kuvatavNr id="be9f07dc-fbfd-4577-9442-a3555247736e"><![CDATA[2) ]]></kuvatavNr><sisuTekst id="5a704fcc-3030-4ac0-8704-70853954db8e"><tavatekst id="5f82f8b3-f768-40c9-84d5-b61f5ab737cd">hooldustöötaja – koduteenuseid osutav isik, kes hooldab teenust vajavat isikut lepingu alusel;</tavatekst></sisuTekst></alampunkt><alampunkt id="para3lg1p3"><alampunktNr id="9c168818-d2f3-4919-b484-67097076fd1d">3</alampunktNr><kuvatavNr id="b0c773e6-6f60-4551-8fc6-45cd454814b5"><![CDATA[3) ]]></kuvatavNr><sisuTekst id="abf7771d-8f9b-4200-b9d1-a1dd6993ae7a"><tavatekst id="d906d9dd-8bdc-49f1-970b-d55067ae2f5d">teenust vajav isik – isik, kes oma east, tervislikust seisundist, vaimsest või füüsilisest puudest tingitult ei tule toime oma igapäevaelu toimingutega;</tavatekst></sisuTekst></alampunkt><alampunkt id="para3lg1p4"><alampunktNr id="6cc875bd-3a79-4515-92af-c260d5ee8f9f">4</alampunktNr><kuvatavNr id="6a2e622e-f5b1-4048-bd98-d7ba324c8816"><![CDATA[4) ]]></kuvatavNr><sisuTekst id="85ead2b3-aebe-411b-9d7d-2674f41e4dae"><tavatekst id="4f248ef1-3cc0-4ddf-b51b-d3ade8a16b57">ülalpidamiskohustusega isik (edaspidi <i>seadusjärgne ülalpidaja</i>) – on perekonnaseaduse mõistes abikaasa, täisealised lapsed, täisealised lapselapsed, vanemad ja vanavanemad ning pärimisseaduse mõistes pärimislepingu järgne pärija;</tavatekst></sisuTekst></alampunkt><alampunkt id="para3lg1p5"><alampunktNr id="fad03a55-4cc3-4fc4-b4cb-738a196a928b">5</alampunktNr><kuvatavNr id="766d4e21-7a6e-474c-aded-c4bb5fee18b0"><![CDATA[5) ]]></kuvatavNr><sisuTekst id="037cb89d-0197-4a3c-8c49-9639a3cc047a"><tavatekst id="73db5c4d-c447-4686-9e24-68b3c626768b">hoolduskava – on teenuse vajaduse hindamise juures kohustuslik lisadokument, milles kajastatakse osutatavate teenuste loetelu, maht, teenuse osutamise aeg ja koht ning millele kirjutavad alla teenust vajav isik või tema seadusjärgne ülalpidaja.</tavatekst></sisuTekst></alampunkt></loige></paragrahv><paragrahv id="para4"><paragrahvNr id="75c6086a-fe10-4d75-a289-00393c11d046">4</paragrahvNr><kuvatavNr id="e7936e41-9920-48b7-a30c-6f011ff13d2f"><![CDATA[§ 4. ]]></kuvatavNr><paragrahvPealkiri id="9819cd5d-2862-4c93-b47e-0f9894d8a7c3">Teenuse sihtgrupp</paragrahvPealkiri><loige id="para4lg1"><loigeNr id="2c0494be-9722-4b12-9aa3-eafd2f404367">1</loigeNr><kuvatavNr id="15791189-1939-4ab0-9eea-9222222bd8d4"><![CDATA[(1)]]></kuvatavNr><sisuTekst id="d15b06d3-1354-4e65-bfff-37a8b2eaa283"><tavatekst id="4b0fec7e-dd4d-49f7-b957-4803497c436f"> Teenust saab taotleda Eesti Rahvastikuregistri andmetel (edaspidi <i>registrijärgne</i>) Viljandi vallas elav täisealine isik, kes ka faktiliselt elab Viljandi vallas ning kes vajab kõrvalist abi kodus igapäevase eluga toimetulekul.</tavatekst></sisuTekst></loige><loige id="para4lg2"><loigeNr id="b77a0300-f745-44d3-8393-28dfa0b34496">2</loigeNr><kuvatavNr id="0a208ce0-3a0e-46fe-b3fc-0367482e70d2"><![CDATA[(2)]]></kuvatavNr><sisuTekst id="b6116e82-ab27-4150-b52a-de193419cb49"><tavatekst id="24fb3dfc-d4d9-4c54-88e9-fa21ddf59a6f"> Teenust võib taotleda ka Viljandi vallas elav, kuid registrijärgselt teise kohaliku omavalitsuse üksusesse registreeritud isik, kuid sellisel juhul toimub teenuse osutamine kooskõlastatult isiku registrijärgse kohaliku omavalitsuse üksusega.</tavatekst></sisuTekst></loige><loige id="para4lg3"><loigeNr id="865e6fcb-add6-4517-81dd-c9398aa23b2f">3</loigeNr><kuvatavNr id="36d70235-af54-4121-8740-c87834d868dd"><![CDATA[(3)]]></kuvatavNr><sisuTekst id="0eecd739-c1dd-4b14-8f8a-429129cff2f1"><tavatekst id="8ee980a2-df19-4fe8-8114-72b346660dd1"> Teenust osutatakse isikutele:</tavatekst></sisuTekst><alampunkt id="para4lg3p1"><alampunktNr id="4e8390b0-4861-4a2c-bbf9-85ef854d9fa3">1</alampunktNr><kuvatavNr id="2bff792f-313b-4134-af96-c4452a3d3855"><![CDATA[1) ]]></kuvatavNr><sisuTekst id="8ae0aa9d-1aea-4711-afc8-fd5ce54a61bf"><tavatekst id="7063cf71-cbff-47eb-9580-43b4a95be22e">kellel puuduvad seadusjärgsed ülalpidajad;</tavatekst></sisuTekst></alampunkt><alampunkt id="para4lg3p2"><alampunktNr id="f8361873-b00f-44d6-b234-d2ea7ed54bd6">2</alampunktNr><kuvatavNr id="f6d7e7b8-4d09-4449-9b24-b847e087b503"><![CDATA[2) ]]></kuvatavNr><sisuTekst id="b0be381f-47b3-4085-9738-1bb2f5334fe5"><tavatekst id="f2b259ce-df6e-4723-93ca-89b2c9778fdd">kellel on seadusjärgsed ülalpidajad, kuid kelle enda ja seadusjärgsete ülalpidajate materiaalsed võimalused ei ole piisavad isiku iseseisvaks toimetulekuks ja vajaliku hoolduse kindlustamiseks või kelle seadusjärgne ülalpidaja elab kaugemal, kui oleks mõistlik teenust vajava isiku abistamisel eeldada;</tavatekst></sisuTekst></alampunkt><alampunkt id="para4lg3p3"><alampunktNr id="2b540e62-0db1-4cd4-8889-58f54d7b3efc">3</alampunktNr><kuvatavNr id="223ce328-b235-44ce-8cf9-33798c664e1d"><![CDATA[3) ]]></kuvatavNr><sisuTekst id="df9278c9-20ee-4531-9033-cbb3dc45daf8"><tavatekst id="0d2151b1-194f-4de4-879b-b8c031661e20">kelle seadusjärgsete ülalpidajatega pole võimalik kontakti saada.</tavatekst></sisuTekst></alampunkt></loige><loige id="para4lg4"><loigeNr id="c275b96f-2ae9-4bac-86bd-89ed690c010e">4</loigeNr><kuvatavNr id="db4b9c23-0304-45ff-9510-2d911cb85f8a"><![CDATA[(4)]]></kuvatavNr><sisuTekst id="fa205e32-8387-4f32-bbe7-f695add9ebd5"><tavatekst id="ce923ad5-4c29-410a-9fb9-a9d4206e2147"> Teenust ei osutata isikutele, kelle igapäevane elu harjumuspärases keskkonnas on rahuldavalt korraldatud ja täiendavat tugiteenust ei vaja.</tavatekst></sisuTekst></loige></paragrahv><paragrahv id="para5"><paragrahvNr id="4504677b-0014-4943-81ce-6cdb1c872003">5</paragrahvNr><kuvatavNr id="ddc7835b-a7ac-4d2b-8084-df8109fcb345"><![CDATA[§ 5. ]]></kuvatavNr><paragrahvPealkiri id="2e4991ef-db71-466a-947e-a5e0da7412c2">Koduteenuste loetelu</paragrahvPealkiri><loige id="para5lg1"><loigeNr id="62969d23-63cb-48ec-b2e1-daa2e9e1f94f">1</loigeNr><kuvatavNr id="e25e2977-f58f-4d6e-aeb5-4ae3531c910c"><![CDATA[(1)]]></kuvatavNr><sisuTekst id="7059d796-6605-47ff-9bd6-ccc1c27fdd1e"><tavatekst id="e93a9dfe-4732-46a0-bbcc-f73ce38de891"> Põhiteenused, millega tagatakse isiku toimetulek kodus:</tavatekst></sisuTekst><alampunkt id="para5lg1p1"><alampunktNr id="b36455a5-f0c8-44d6-ba40-a26c5f5bb927">1</alampunktNr><kuvatavNr id="47fff1f6-0af5-4a7a-b02a-005ffb3cfdd0"><![CDATA[1) ]]></kuvatavNr><sisuTekst id="b5d711d4-ed99-440f-b7e7-927823c2574a"><tavatekst id="e13aa946-1880-42e7-94b7-3cb0078937d8">toiduainete ja esmatarbekaupadega varustamine:<reavahetus/>1.1) tellimuste vastuvõtmine, kaupade ostmine lähimast toidupoest ja koju toomine,<reavahetus/>1.2) toiduainete tuppa toomine hoidlast (juurviljad, moosid jne);</tavatekst></sisuTekst></alampunkt><alampunkt id="para5lg1p2"><alampunktNr id="fc87a911-ebe4-431c-8b26-c3e0df26697e">2</alampunktNr><kuvatavNr id="628b4283-5a0e-444e-a8bb-bcc18e32d0f9"><![CDATA[2) ]]></kuvatavNr><sisuTekst id="47319110-fa22-4c72-87f5-5ae214a6da60"><tavatekst id="04a7e868-67ea-45ae-9064-62a8778ab0d8">esmane eluaseme korrastamine: maksimaalne koristatav/köetav eluruumi pind ühe isiku kohta 51 m<sup>2</sup> või 2-toaline korter, kasutatakse teenust vajava isiku kodus olevaid töövahendeid;</tavatekst></sisuTekst></alampunkt><alampunkt id="para5lg1p3"><alampunktNr id="66fc31d4-1aad-4611-8d15-33c81f6e2c3e">3</alampunktNr><kuvatavNr id="66eabd5a-071e-4424-a5d7-ff3deba2bc8d"><![CDATA[3) ]]></kuvatavNr><sisuTekst id="3bab5b70-ed81-4912-bbcf-22892a12ca1f"><tavatekst id="63d369ee-a4e7-47a6-bf38-d61e8617fadb">küttematerjali eluruumi toomine ja tuha väljaviimine (kaugkütte puudumisel);</tavatekst></sisuTekst></alampunkt><alampunkt id="para5lg1p4"><alampunktNr id="29b09b5e-e90d-4a4f-a674-0879872e4a73">4</alampunktNr><kuvatavNr id="f9c523d4-8927-470c-b66b-60608361089f"><![CDATA[4) ]]></kuvatavNr><sisuTekst id="29155256-463a-4e00-91f2-6f5787cc7103"><tavatekst id="3fa40fd1-1b5d-4b28-9843-2f6b588c8b1a">vee tuppa toomine ja heitvee väljaviimine (veevärgi puudumisel);</tavatekst></sisuTekst></alampunkt><alampunkt id="para5lg1p5"><alampunktNr id="1add8283-12ce-4501-8201-d7acd259baee">5</alampunktNr><kuvatavNr id="4c4c468b-b6c1-4826-a12b-1cf01c3b9c9b"><![CDATA[5) ]]></kuvatavNr><sisuTekst id="5eca737c-e362-4af0-8abd-6f371776159e"><tavatekst id="8b6f540b-5242-4094-85ad-0677a52b995f">olmejäätmete väljaviimine;</tavatekst></sisuTekst></alampunkt><alampunkt id="para5lg1p6"><alampunktNr id="e3ea67bb-fd46-4121-8e4a-de63068af566">6</alampunktNr><kuvatavNr id="05233623-4179-4259-993d-962ab5837687"><![CDATA[6) ]]></kuvatavNr><sisuTekst id="cc82721d-7257-4ec5-a231-4da1f3cef18a"><tavatekst id="fd9929a6-1341-4de0-9435-7b18f12b79ed">teenust vajava isiku abistamine pesemisel, riietumisel, söömisel, liikumisel, tualetis käimisel, mähkmete vahetamisel, voodi korrastamisel jms;</tavatekst></sisuTekst></alampunkt><alampunkt id="para5lg1p7"><alampunktNr id="2454de74-c8ab-435d-909c-f0cf09038e1d">7</alampunktNr><kuvatavNr id="7c55d0b6-4b92-45d4-a803-29a7cd7394ab"><![CDATA[7) ]]></kuvatavNr><sisuTekst id="3ccb56fb-84a1-4b54-8808-927985b2c7a4"><tavatekst id="1d6f7853-fa6f-4624-bdf1-c04d68a0a037">pesemisvõimaluste korraldamine;</tavatekst></sisuTekst></alampunkt><alampunkt id="para5lg1p8"><alampunktNr id="368b8702-81c4-4d68-9889-a5d4348308f1">8</alampunktNr><kuvatavNr id="a1b54dd7-83a6-4f7d-8872-70d7fd718d2c"><![CDATA[8) ]]></kuvatavNr><sisuTekst id="c2132fff-ef21-4896-a149-ef2f01d03f23"><tavatekst id="e25cfaf9-6c4c-448d-81e7-6027aa7001db">pesupesemise korraldamine;</tavatekst></sisuTekst></alampunkt><alampunkt id="para5lg1p9"><alampunktNr id="6acb6058-8d32-42c7-983d-42340ee8725b">9</alampunktNr><kuvatavNr id="efa4152d-e48b-4634-878d-843a885efed3"><![CDATA[9) ]]></kuvatavNr><sisuTekst id="e8d6c22a-ab91-4dc2-b86d-98529a79ed26"><tavatekst id="51ab2f68-1f4e-45de-9aba-3c97f42527d9">vestlus ja teabe edastamine:<reavahetus/>9.1) hoolealuse ärakuulamine,<reavahetus/>9.2) teabe edastamine kohalikku elu puudutavates küsimustes ning välismaailmaga kontakti säilitamine ja loomine,<reavahetus/>9.3) informatsiooni jagamine teenust vajava isiku jaoks olulistest muudatustest ning täiendustest õigusaktides.</tavatekst></sisuTekst></alampunkt></loige><loige id="para5lg2"><loigeNr id="fe1acbaa-254b-412c-a2db-60bf6254bb15">2</loigeNr><kuvatavNr id="ba365b96-3976-470a-99ac-eaaf8299b630"><![CDATA[(2)]]></kuvatavNr><sisuTekst id="019b1def-9b3e-4bf8-b633-4dd44da9f10d"><tavatekst id="2d620d97-de76-4ef9-9b94-2e7a8663d34d"> Tugiteenused:</tavatekst></sisuTekst><alampunkt id="para5lg2p1"><alampunktNr id="41f49020-144f-40ac-8540-0b90aa2776fc">1</alampunktNr><kuvatavNr id="56b7ba8d-8c9d-4b9c-9f07-c36d83fcdd56"><![CDATA[1) ]]></kuvatavNr><sisuTekst id="64eb8634-7fe4-4c1e-b6a0-ced5b9cdab21"><tavatekst id="a564fab9-3d98-44b5-a4dd-8db6fadc3c01">elektri- ja veenäitude teatamine;</tavatekst></sisuTekst></alampunkt><alampunkt id="para5lg2p2"><alampunktNr id="598931b5-cd79-4952-bbbe-b4aba6c56156">2</alampunktNr><kuvatavNr id="4c1f0c29-ad4a-4306-b715-610b1f8ee6f1"><![CDATA[2) ]]></kuvatavNr><sisuTekst id="72f8e063-61f9-4907-a826-fc99bade3264"><tavatekst id="7bde379b-8862-479e-9f64-3fb9cc989d1c">kommunaal- ja muude maksete tasumine, vajadusel toetuste taotlemine;</tavatekst></sisuTekst></alampunkt><alampunkt id="para5lg2p3"><alampunktNr id="9e650332-1045-48ed-966a-5996878befba">3</alampunktNr><kuvatavNr id="f8ecaeac-14db-48dd-85a5-567757963863"><![CDATA[3) ]]></kuvatavNr><sisuTekst id="3c32c68b-02de-4bbc-b84a-623b5eb67660"><tavatekst id="5b5271be-eddc-4cce-90e5-a6b50d9ab210">asjaajamine ametiasutustes;</tavatekst></sisuTekst></alampunkt><alampunkt id="para5lg2p4"><alampunktNr id="b50d865f-09dd-46df-81ef-03cace365a4e">4</alampunktNr><kuvatavNr id="3d376044-8a45-4417-ae94-0fc5cba587b1"><![CDATA[4) ]]></kuvatavNr><sisuTekst id="34164abb-98e8-4cd4-b230-b08ae4024684"><tavatekst id="33e273a1-b253-46d9-97b3-25a5b35730ea">abistamine asjaajamisel:<reavahetus/>4.1) ajalehtede ja ajakirjade tellimine,<reavahetus/>4.2) ajakirjanduse ja raamatutega varustamine raamatukogu baasil,<reavahetus/>4.3) abistamine hooldekodusse, sotsiaalkorterisse suunamisel/suundumisel,<reavahetus/>4.4) tähtpäevade tähistamine,<reavahetus/>4.5) sotsiaaltranspordi/transpordi korraldamine vastavalt teenust vajav isik soovile ja vajadusele;</tavatekst></sisuTekst></alampunkt><alampunkt id="para5lg2p5"><alampunktNr id="76384b06-0ced-40db-b420-27c1bdbfff29">5</alampunktNr><kuvatavNr id="bc6d7283-21b9-4163-b244-076627426b55"><![CDATA[5) ]]></kuvatavNr><sisuTekst id="92573c5b-3b84-41bf-a8e5-e8624b45af44"><tavatekst id="ddd6a6ca-8aad-4d65-997c-85edf4d011aa">abistamine arstiabi korraldamisel:<reavahetus/>5.1) põetamise korraldamine lühiajalise haiguse korral,<reavahetus/>5.2) arsti või õe koju kutsumine (vajadusel arsti visiidi äraootamine) või meedikutega konsulteerimine,<reavahetus/>5.3) abistamine tervishoiuasutuse külastamisel kuni kaks korda kuus,<reavahetus/>5.4) ravimite väljaostmine ja kliendile toimetamine,<reavahetus/>5.5) abivahendite soovitamine ja muretsemine (koostöös perearstiga);</tavatekst></sisuTekst></alampunkt><alampunkt id="para5lg2p6"><alampunktNr id="ef6ae64c-f826-46dc-b9dd-a2afd3b56e6e">6</alampunktNr><kuvatavNr id="51fe85aa-38a9-4b8b-8fb8-6aba786d8399"><![CDATA[6) ]]></kuvatavNr><sisuTekst id="9e7070dd-9649-44dc-a327-15cacfd8e9cd"><tavatekst id="b35dada3-0b2f-4731-8d9b-3a07e7225c16">saatjateenus;</tavatekst></sisuTekst></alampunkt><alampunkt id="para5lg2p7"><alampunktNr id="4ef0bb2d-7107-4af1-bcd4-dd0153cd944a">7</alampunktNr><kuvatavNr id="ff81fb46-f761-4b50-95a4-c5125e55a8cb"><![CDATA[7) ]]></kuvatavNr><sisuTekst id="d2792142-acbf-4940-91a7-967edbc0dec9"><tavatekst id="a0b1012e-cd39-4648-b987-cb72c0b61b9d">valmistoidu kojuviimine;</tavatekst></sisuTekst></alampunkt><alampunkt id="para5lg2p8"><alampunktNr id="af8ee316-83da-4cdd-aaac-666dad352b0c">8</alampunktNr><kuvatavNr id="9b005afc-8bd1-422d-a600-fdbd96959c53"><![CDATA[8) ]]></kuvatavNr><sisuTekst id="b5c87c54-4556-460e-ba7d-33a31d2d589a"><tavatekst id="f4b5f0c6-24b1-4a94-a32b-4693b6c7907e">küttepuude töötlemise korraldamine;</tavatekst></sisuTekst></alampunkt><alampunkt id="para5lg2p9"><alampunktNr id="5f744de0-2c99-4905-92ca-2f11a9c8bae1">9</alampunktNr><kuvatavNr id="32d8a0ec-8f4a-4638-ae7f-74d026774951"><![CDATA[9) ]]></kuvatavNr><sisuTekst id="e86fa95e-76e6-43ab-baca-1e7f6465cff3"><tavatekst id="8b2fd534-c815-4522-a663-4078598f7022">võimalusel muud toetavad teenused.</tavatekst></sisuTekst></alampunkt></loige></paragrahv><paragrahv id="para6"><paragrahvNr id="05c2393c-63eb-4f95-a077-c7d76e0e2785">6</paragrahvNr><kuvatavNr id="4ae87ac4-e987-4550-a4ef-1eb5aa2b739a"><![CDATA[§ 6. ]]></kuvatavNr><paragrahvPealkiri id="3c730c99-58d7-444c-8a6f-f81af25c7fc4">Teenuse osutamise maht ja koht</paragrahvPealkiri><loige id="para6lg1"><loigeNr id="d71bc5dc-0292-4e1e-aeae-e508cb8f87ac">1</loigeNr><kuvatavNr id="a345798f-77fe-4a7a-b94a-d8d165e75250"><![CDATA[(1)]]></kuvatavNr><sisuTekst id="627dfd80-36e1-4c02-bfff-06e347380af1"><tavatekst id="d8211705-45ca-4c1e-9dae-1668509d9a1f"> Teenuse osutamise sagedus ja kestus sõltuvad isiku teenuse vajaduse hindamise tulemustest.</tavatekst></sisuTekst></loige><loige id="para6lg2"><loigeNr id="f2da846e-d7db-405a-97ca-9667c0f8581d">2</loigeNr><kuvatavNr id="a6daa6ad-3a27-42f3-962d-7d783a7191c6"><![CDATA[(2)]]></kuvatavNr><sisuTekst id="45f52acc-d02f-42b9-a2c6-7b5e88a2adec"><tavatekst id="21dcc8e8-868d-4b5f-8458-d7f7558a6136"> Teenust osutatakse teenust vajava isiku kodus.</tavatekst></sisuTekst></loige></paragrahv><paragrahv id="para7"><paragrahvNr id="86ff3f0a-ed52-49f5-ba57-f09faf250481">7</paragrahvNr><kuvatavNr id="19777dd3-afc1-4537-834c-432bffd96342"><![CDATA[§ 7. ]]></kuvatavNr><paragrahvPealkiri id="9d725704-613f-4063-950f-e383621c8d69">Teenuse taotlemine ja osutamine</paragrahvPealkiri><loige id="para7lg1"><loigeNr id="bb94a7de-4974-469c-b269-6df4b35c2a1a">1</loigeNr><kuvatavNr id="de1b8273-882e-48cc-8df0-609928d0551b"><![CDATA[(1)]]></kuvatavNr><sisuTekst id="e62c2100-0397-4296-887f-8b75d00aec83"><tavatekst id="88485677-76df-4132-aac9-f2e2956c11a9"> Koduteenuste taotlemise, korraldamise ja teenuse saajate üle arvestuse pidamise eest vastutab koduteenuse valdkonnaga tegelev sotsiaaltöö spetsialist (edaspidi <i>sotsiaaltöö spetsialist</i>).</tavatekst></sisuTekst></loige><loige id="para7lg2"><loigeNr id="bab2da22-e3e6-4f7e-847f-5f04249d5f3f">2</loigeNr><kuvatavNr id="e13c87cc-2795-4fef-aa1d-541992cf3bd8"><![CDATA[(2)]]></kuvatavNr><sisuTekst id="66ff668d-ed31-4440-840e-424a2c8e2288"><tavatekst id="68e4b786-5213-4f23-b0c2-81dbe8164e04"> Teenuse saamiseks esitab teenust vajav isik või tema seadusjärgne ülalpidaja vormikohase avalduse, milles kirjeldatakse ja põhjendatakse kõrvalabi vajadust. Koduteenust vajavast isikust võivad teatada Viljandi Vallavalitsusele (edaspidi <i>vallavalitsus</i>) ka naabrid, arst, hooldustöötaja või muud isikud.</tavatekst></sisuTekst></loige><loige id="para7lg3"><loigeNr id="d12fea50-47b5-4808-9676-488dbbd36ec5">3</loigeNr><kuvatavNr id="2d5eb9f9-11e1-460a-84bd-3fc045547355"><![CDATA[(3)]]></kuvatavNr><sisuTekst id="7e8b6e64-23b2-4cc1-8579-749c3d147480"><tavatekst id="38580c5b-7a5d-404a-894a-db7ab424beff"> Peale avalduse laekumist või teenust vajavast isikust teate saamist teeb sotsiaaltöö spetsialist teenust vajava isiku kodukülastuse, täidab kliendikaardi, hindab hindamisvormi abil teenuse vajadust ning koostab hoolduskava.</tavatekst></sisuTekst></loige><loige id="para7lg4"><loigeNr id="3a15fdec-057d-4fe4-959a-ef48fb4952a4">4</loigeNr><kuvatavNr id="be2b98b7-3483-4c86-bbc4-396dfcb5fc00"><![CDATA[(4)]]></kuvatavNr><sisuTekst id="c4c14667-7c75-4b18-8948-23a2d9df1907"><tavatekst id="55203199-5414-456d-8608-2a810255e15e"> Hoolduskava vaadatakse üle vastavalt vajadusele, kuid mitte harvem kui kord kahe aasta jooksul. Ettepaneku hoolduskava muutmiseks võib esitada teenust vajav isik, tema seadusjärgne ülalpidaja, hooldustöötaja või sotsiaaltöö spetsialist. Hoolduskava muutmise korral tuleb teenuse maht ja teenuse vajadus uuesti hinnata.</tavatekst></sisuTekst></loige><loige id="para7lg5"><loigeNr id="b6231a20-8ca7-4533-87ef-59cfa4074b29">5</loigeNr><kuvatavNr id="21c1769d-9659-415b-9db3-6da7a87ec758"><![CDATA[(5)]]></kuvatavNr><sisuTekst id="dd15ae72-1eba-4e75-9243-0619eb318e40"><tavatekst id="aa169864-eb8b-4b21-a26d-532d52b368f8"> Sotsiaaltöö spetsialistil on õigus kaasata teenust vajava isiku olukorra väljaselgitamiseks tema seadusjärgseid ülalpidajaid ja teisi spetsialiste (nt perearsti) ning nõuda teenust vajava isiku või tema seadusjärgsete ülalpidajate maksevõimekuse väljaselgitamiseks täiendavaid andmeid, sh väljavõtteid pangakontodest ja muid otsustamiseks vajalikke lisaandmeid ja dokumente.</tavatekst></sisuTekst></loige><loige id="para7lg6"><loigeNr id="157d89f1-c817-4a08-8fe5-83d9b7ab1f4e">6</loigeNr><kuvatavNr id="1b46b362-c31d-42ff-b2b3-c2febe061eb2"><![CDATA[(6)]]></kuvatavNr><sisuTekst id="3eed0fc8-f279-4392-993f-6ec94b55f4cd"><tavatekst id="c4b8c065-1380-47b3-bb7e-2cfba4242ee9"> Viljandi Vallavalitsuse alatine sotsiaalkomisjon (edaspidi <i>sotsiaalkomisjon</i>) hindab kaalutlusõiguse alusel taotluse põhjendatust ja taotlusele lisatud dokumente ning otsustab haldusaktiga teenuse osutamise või osutamata jätmise (sh koduteenuse osutamise lepingu sõlmimise) 10 tööpäeva jooksul pärast kõigi nõutud dokumentide esitamist. Põhjendatud otsus tehakse teenust vajavale isikule kirjalikult teatavaks.</tavatekst></sisuTekst></loige><loige id="para7lg7"><loigeNr id="2f183960-5806-4f3d-aa87-5ca6a7c9c1df">7</loigeNr><kuvatavNr id="f44630a9-381c-48bb-bf9b-17d0bf981e12"><![CDATA[(7)]]></kuvatavNr><sisuTekst id="be994366-3a8d-4371-98ea-13b2efd79b9a"><tavatekst id="5793059c-d6d5-49a7-bfe5-5d2796daf244"> Juhul, kui teenuse osutamata jätmine põhjustab teenust vajava isiku elule või tervisele ohtliku olukorra, osutatakse talle teenuseid koheselt ning käesoleva paragrahvi lõikes 3 nimetatud dokumendid täidetakse hiljem.</tavatekst></sisuTekst></loige><loige id="para7lg8"><loigeNr id="3e29e1f8-5373-4a87-b9c3-aeabea1a2658">8</loigeNr><kuvatavNr id="98ab006e-bf7d-4f8d-b219-84d814d635f0"><![CDATA[(8)]]></kuvatavNr><sisuTekst id="1c2cf290-c012-4bc8-9aac-270a71a0cef0"><tavatekst id="b1905178-2cb0-4258-9097-27744bd278a2"> Koduteenuseid osutatakse vaid nende teenuste osas, millega abivajaja pole võimeline ise toime tulema.</tavatekst></sisuTekst></loige></paragrahv><paragrahv id="para8"><paragrahvNr id="736063f3-648f-4157-ad65-d7da64e1cff6">8</paragrahvNr><kuvatavNr id="e6faf247-cd38-479b-8615-9a784e6a101c"><![CDATA[§ 8. ]]></kuvatavNr><paragrahvPealkiri id="55d5aa98-8ce3-4ae2-b297-b9bbbe9688b1">Lepingu sõlmimine</paragrahvPealkiri><loige id="para8lg1"><loigeNr id="1ac21833-8dd5-4896-87a7-cb25620df6cb">1</loigeNr><kuvatavNr id="8caff708-8164-440c-9fd1-54abc23e4b45"><![CDATA[(1)]]></kuvatavNr><sisuTekst id="ae80861e-13ee-49e2-bba1-9f672da97ab0"><tavatekst id="2b0e78e5-c4a4-4feb-8b86-7edb7cfff19f"> Teenuse osutamise aluseks on teenust vajava isiku/seadusjärgse ülalpidaja ja vallavalitsuse vahel sõlmitud kahe- või kolmepoolne koduteenuse osutamise leping (edaspidi <i>leping</i>).</tavatekst></sisuTekst></loige><loige id="para8lg2"><loigeNr id="01e2862f-1d76-477e-85bf-2d0afb4f199c">2</loigeNr><kuvatavNr id="a7826e57-d31a-4e2d-a268-91cecc26c5bb"><![CDATA[(2)]]></kuvatavNr><sisuTekst id="1ca0e79e-c94f-45d3-9eea-28bf5e61f9ee"><tavatekst id="96aa999c-c5d0-4a85-b09f-559462fa28a5"> Lepingu sõlmib või lõpetab vallavalitsuse sotsiaalnõunik või tema asendaja, lepingu võtab teadmiseks ja täitmiseks hooldustöötaja. Lepingus määratakse ära teenuste loetelu, kestvus ja tingimused ning poolte õigused ja kohustused kooskõlas Eesti Vabariigi seadusandluse ja käesolevas määruses toodud lepingu sõlmimise korraga.</tavatekst></sisuTekst></loige><loige id="para8lg3"><loigeNr id="e58c7bde-f0f1-40f1-9d60-c0c15aed8ade">3</loigeNr><kuvatavNr id="ac152dd7-7e4d-488b-a7a2-59fa076cb53c"><![CDATA[(3)]]></kuvatavNr><sisuTekst id="14f84a0e-227c-4372-b024-4e33bd48666b"><tavatekst id="28830630-9102-40bb-b468-5f7b59cc9c93"> Enne lepingu sõlmimist tutvustab sotsiaaltöö spetsialist teenust vajavale isikule ja tema seadusjärgsele ülalpidajale teenuste hindu ja nende eest tasumise korda.</tavatekst></sisuTekst></loige><loige id="para8lg4"><loigeNr id="b2553615-b090-4457-acba-7f0670ae627a">4</loigeNr><kuvatavNr id="88f99679-20b3-4602-a42f-d7a90017e322"><![CDATA[(4)]]></kuvatavNr><sisuTekst id="03aa9979-4b0f-4380-a2e3-6f89af2cf15d"><tavatekst id="7593f12f-0d90-45f5-ae13-4fe66671863f"> Leping sõlmitakse maksimaalselt kaheks aastaks ja kuulub läbivaatamisele lähtuvalt kliendi vajadustest, kuid mitte harvemini kui kord kahe aasta jooksul.</tavatekst></sisuTekst></loige><loige id="para8lg5"><loigeNr id="0fdc58d5-fa9f-4278-80da-3e5fd2533009">5</loigeNr><kuvatavNr id="4f433a3c-f95a-468b-9999-03400429aa9e"><![CDATA[(5)]]></kuvatavNr><sisuTekst id="71223767-b143-44b7-b334-33ec6d49f3f5"><tavatekst id="5f2cba6a-5935-42a5-b58e-e2c6b59ee95e"> Leping lõpeb:</tavatekst></sisuTekst><alampunkt id="para8lg5p1"><alampunktNr id="065cebb1-e893-4baf-991f-0c489e328ed4">1</alampunktNr><kuvatavNr id="0d1db8b8-7073-4b40-a9ec-082a41a9a995"><![CDATA[1) ]]></kuvatavNr><sisuTekst id="be7668dc-7380-4e1a-a8a6-73d34a50c267"><tavatekst id="72fcb503-fa96-4edf-a5e9-39fcf1a3cb2e">tähtaja möödumisel;</tavatekst></sisuTekst></alampunkt><alampunkt id="para8lg5p2"><alampunktNr id="b492cec3-ff99-4df3-8ddf-839b2431bccc">2</alampunktNr><kuvatavNr id="8838f61a-200f-4084-8b9d-175a8e114e7f"><![CDATA[2) ]]></kuvatavNr><sisuTekst id="2a2db6ee-b280-4d89-a86c-6a66f8a632e9"><tavatekst id="da62c0d6-bf70-429c-83b1-7c031ff3aa99">teenust vajanud isiku surma korral.</tavatekst></sisuTekst></alampunkt></loige><loige id="para8lg6"><loigeNr id="db6a2ac2-ce18-4793-b793-be45192e467c">6</loigeNr><kuvatavNr id="9a5262d4-176f-4a41-bfe2-9a31320cb39e"><![CDATA[(6)]]></kuvatavNr><sisuTekst id="88a7c074-4d9a-443d-a637-4f8cf3d67d73"><tavatekst id="2d5295f1-e8a8-4142-a684-15f2b5d508f2"> Teenuse osutamise leping lõpetatakse:</tavatekst></sisuTekst><alampunkt id="para8lg6p1"><alampunktNr id="4104127c-7778-4185-ba53-f4bb0254b2a2">1</alampunktNr><kuvatavNr id="088c1cb5-abe2-4137-8404-b37eea62336b"><![CDATA[1) ]]></kuvatavNr><sisuTekst id="d60e2151-9e9c-4697-93ff-dfc48d1dbfea"><tavatekst id="cd17ea3d-f7d6-4740-a1ce-98ee26507c0d">teenuse vajaduse lõppemisel;</tavatekst></sisuTekst></alampunkt><alampunkt id="para8lg6p2"><alampunktNr id="1d2a4760-9994-4c8c-8165-25115f85f26c">2</alampunktNr><kuvatavNr id="8d3dc230-1d63-411b-8425-efd1d4aecb20"><![CDATA[2) ]]></kuvatavNr><sisuTekst id="5a4f383f-12c5-4e2f-a65c-ee1764a60447"><tavatekst id="a2f73222-3bd8-4121-af4a-5c15c85eb213">teenust vajava isiku või tema seadusjärgsete ülalpidajate soovil;</tavatekst></sisuTekst></alampunkt><alampunkt id="para8lg6p3"><alampunktNr id="c771713d-63a4-4e10-aa11-b38a251c6d4d">3</alampunktNr><kuvatavNr id="1351600d-e7f9-484a-9fba-4b53df6e96f2"><![CDATA[3) ]]></kuvatavNr><sisuTekst id="7cf6676e-3f50-428a-903e-5770aece2d09"><tavatekst id="c549f475-f397-482f-aa46-7b0a84789883">teenust vajanud isiku suundumisel teisele teenusele või väljaspool kodu osutatavale hooldusteenusele;</tavatekst></sisuTekst></alampunkt><alampunkt id="para8lg6p4"><alampunktNr id="6a5133fa-f770-4a6b-a5d5-7109cb6186f6">4</alampunktNr><kuvatavNr id="9abc0368-1943-4f89-b981-017c38d93dc0"><![CDATA[4) ]]></kuvatavNr><sisuTekst id="7eb8b87d-ac27-4474-a7d1-405e1f78f3fd"><tavatekst id="2c1be20a-3df1-4a3d-a7a1-4468f39d0f1b">teenust vajanud isik asub elama teise omavalitsuse üksuse haldusterritooriumile;</tavatekst></sisuTekst></alampunkt><alampunkt id="para8lg6p5"><alampunktNr id="856fd6a6-faa3-49d1-ab07-5d869ac6e439">5</alampunktNr><kuvatavNr id="20e89d71-adef-4375-ba1e-6497d6cc520d"><![CDATA[5) ]]></kuvatavNr><sisuTekst id="f93ed158-43ec-4be6-9f25-6458e8e51685"><tavatekst id="3ce256eb-7358-4b40-9108-a8856a67e193">teenust vajava isiku käitumine teeb võimatuks koduteenuse osutamise (agressiivsus, ebaviisakas käitumine, alkoholi või narkootiliste ainete kuritarvitamine vms);</tavatekst></sisuTekst></alampunkt><alampunkt id="para8lg6p6"><alampunktNr id="fd4f2c6c-4d0a-4085-9665-8cd2952174ca">6</alampunktNr><kuvatavNr id="213409c6-e23f-4f3e-b61f-0ffd568b7ff6"><![CDATA[6) ]]></kuvatavNr><sisuTekst id="4999fe76-9cb1-4594-9bc9-0a89a96e2e7e"><tavatekst id="13196faf-cc7b-4eda-bf42-66d463fcd0dc">teenust vajav isik või seadusjärgse ülalpidamiskohustusega isik ei ole tähtajaliselt tasunud tasuliste koduteenuste eest;</tavatekst></sisuTekst></alampunkt><alampunkt id="para8lg6p7"><alampunktNr id="740f40db-3094-4301-876a-5b2c1475257e">7</alampunktNr><kuvatavNr id="9fc0d288-831a-4ebc-8b18-36c09ed2c9f3"><![CDATA[7) ]]></kuvatavNr><sisuTekst id="0e9f8d66-061c-4370-b264-1823c07569cf"><tavatekst id="ce9e7265-eacf-415b-82dc-0d8f6503acbe">muudel põhjustel, mis takistavad teenuse osutamist.</tavatekst></sisuTekst></alampunkt></loige><loige id="para8lg7"><loigeNr id="7cd62733-95dc-4ffb-89b6-06bbbbf0c288">7</loigeNr><kuvatavNr id="4927ca0f-e701-4bf7-a052-646373c57a9a"><![CDATA[(7)]]></kuvatavNr><sisuTekst id="08e1a3f7-809c-4b78-a895-cba9bdfaad41"><tavatekst id="5e9fdea8-20ed-4a0f-81a7-19de3799aac0"> Kui leping lõpeb teenust vajanud isiku surmaga, siis sotsiaalkomisjoni esimees teavitab kirjaliku esildisega vallavalitsuse finantsnõunikku isiku surmast.</tavatekst></sisuTekst></loige></paragrahv><paragrahv id="para9"><paragrahvNr id="00755b6e-28ff-40a0-b03b-31dd0c9a40df">9</paragrahvNr><kuvatavNr id="c39fa862-6c03-44c9-869c-7d231df5eeab"><![CDATA[§ 9. ]]></kuvatavNr><paragrahvPealkiri id="b3aadb01-7430-4684-92d5-cc84bf07898d">Teenuse finantseerimine</paragrahvPealkiri><loige id="para9lg1"><loigeNr id="bfac38d9-629b-4a18-adeb-001f7da2900f">1</loigeNr><kuvatavNr id="eed1ff42-475d-4bc4-be0b-6cb9386617c6"><![CDATA[(1)]]></kuvatavNr><sisuTekst id="c9c588f1-700b-4ade-9185-d9d76c780930"><tavatekst id="0778a9d3-9e56-4396-80d2-29fa29b44e63"> Teenust vajav isik või tema seadusjärgne ülalpidaja tasub teenuste eest vastavalt vallavalitsuse poolt kehtestatud hinnakirjale ja sõlmitud lepingule kas ülekandega või sularahas vallavalitsuse kassasse.</tavatekst></sisuTekst></loige><loige id="para9lg2"><loigeNr id="4b0b3b24-3588-4d04-afcb-2ecc8b12afc1">2</loigeNr><kuvatavNr id="c99f59e6-948f-4379-bd7c-8a7dabd04a3f"><![CDATA[(2)]]></kuvatavNr><sisuTekst id="ccf985f2-633a-4057-9b07-aae3ddc9af04"><tavatekst id="e59468fa-1488-47bf-bdaa-e8cd252a9eab"> Kui teenust vajava isiku ja tema seadusjärgse(te) ülalpidaja(te) majanduslik olukord ei võimalda teenust vajaval isikul teenust kasutada, siis tuleb esitada vastavasisuline avaldus vallavalitsusele. Sotsiaalkomisjon hindab taotleja ja tema seaduslike ülalpidajate maksevõimekust ning otsustab, kas ja millises suuruses toetuse taotleja koduteenuse eest tasumisest vabastatakse.<reavahetus/></tavatekst></sisuTekst></loige></paragrahv><paragrahv id="para10"><paragrahvNr id="71978e2c-a526-43eb-a4f8-7f37d4d79f68">10</paragrahvNr><kuvatavNr id="eceddbe9-8434-4cc4-8329-2770cbc2e225"><![CDATA[§ 10. ]]></kuvatavNr><paragrahvPealkiri id="4e33d8df-acb9-4386-8dd6-9c7bc2e07eff">Hooldustöötaja tegevuse alused</paragrahvPealkiri><loige id="para10lg1"><loigeNr id="0e4b2694-dd56-47f4-bcfa-8657f586d696">1</loigeNr><kuvatavNr id="a727d52b-54ac-417f-832d-7744e24a236d"><![CDATA[(1)]]></kuvatavNr><sisuTekst id="2ce9849c-f673-486b-93fb-25a2d8db4273"><tavatekst id="7be9a4bc-b1aa-46a4-b59f-0dda65c4d7f6"> Hooldustöötaja lähtub koduteenuse osutamisel töölepingust, hooldustöötaja ametijuhendist, teenust vajavale isikule koostatud hoolduskavast ning koduteenuste osutamise lepingutest.</tavatekst></sisuTekst></loige><loige id="para10lg2"><loigeNr id="bacb1aca-0d6e-4fb5-9fba-9493f9e724ec">2</loigeNr><kuvatavNr id="e354bda7-5008-428f-bbd1-b8ff43f3453c"><![CDATA[(2)]]></kuvatavNr><sisuTekst id="e4cbedef-b305-4054-a31c-827d359409a2"><tavatekst id="f04d1940-0080-4f7b-8f62-261f9538afc3"> Hooldustöötaja allub oma töös koduteenuse osutamise korraldamisega tegelevale sotsiaaltöö spetsialistile või tema asendajale.</tavatekst></sisuTekst></loige><loige id="para10lg3"><loigeNr id="26791af2-ed33-4dec-a249-f0870620257c">3</loigeNr><kuvatavNr id="cb158da6-a5f3-4dcc-b7db-93102fb60542"><![CDATA[(3)]]></kuvatavNr><sisuTekst id="9ede8686-cc35-435a-8d23-0b1d10965b31"><tavatekst id="2a6efd08-72da-4c41-b3fa-5dff11da2366"> Hooldustöötajal võib sõltuvalt teenust vajavate isikute vanusest, vaimsest ja füüsilisest seisundist ning abi osutamise ulatusest olla hooldada 10-13 isikut.</tavatekst></sisuTekst></loige><loige id="para10lg4"><loigeNr id="e9264092-6387-4ac6-a9cd-683f4d86ddf6">4</loigeNr><kuvatavNr id="114a62af-eb6f-47a3-88fc-32941d490948"><![CDATA[(4)]]></kuvatavNr><sisuTekst id="42e2ed2e-c07a-4801-aace-09b6a8c9ed5e"><tavatekst id="a90411de-864b-44a7-ac69-fbbafbe443a4"> Hooldustöötaja täidab vajadusel hooldatava külastamise kohta päevikut, kuhu märgib kodukülastuse aja, tehtud tegevused ja koduteenuse saaja tervisliku seisundi lühikokkuvõtte ning võtab päevikusse teenust saanud isiku allkirja.</tavatekst></sisuTekst></loige></paragrahv><paragrahv id="para11"><paragrahvNr id="0479cda2-1861-4c2e-9e25-48faae24d26c">11</paragrahvNr><kuvatavNr id="a4db0d24-c1dd-4ab1-8dd2-d9b5d0b579ea"><![CDATA[§ 11. ]]></kuvatavNr><paragrahvPealkiri id="bf5a2961-e398-48ce-b851-d5c6fb79abc4">Rakendussätted</paragrahvPealkiri><loige id="para11lg1"><loigeNr id="1cd99cad-c92e-44e7-8e7d-7638bc81c80e">1</loigeNr><kuvatavNr id="015809e6-a5e5-45bc-8e09-e8b302022db1"><![CDATA[(1)]]></kuvatavNr><sisuTekst id="add0fb43-86fa-4515-a5d3-355cc7941855"><tavatekst id="c05fe68b-337e-425a-ac38-43fcfab0af28"> Teenuse hinnakirja kehtestab vallavalitsus.</tavatekst></sisuTekst></loige><loige id="para11lg2"><loigeNr id="f7b02119-d823-4d04-a5e8-49c521da928a">2</loigeNr><kuvatavNr id="d392771b-b9db-4e73-961e-1a2f11bca4a2"><![CDATA[(2)]]></kuvatavNr><sisuTekst id="5d052951-8787-45af-804b-a6db9d470c53"><tavatekst id="a7709799-308b-4f48-a7a7-18921ff6aecf"> Teenuse osutamisega seonduvate dokumentide vormid kinnitab vallavalitsus.</tavatekst></sisuTekst></loige></paragrahv><paragrahv id="para12"><paragrahvNr id="12e8a0d3-4f5b-4e58-bcd1-a903ad5d8387">12</paragrahvNr><kuvatavNr id="0c65dda5-58d2-4e48-bf1d-3fcf14c7aa87"><![CDATA[§ 12. ]]></kuvatavNr><paragrahvPealkiri id="ea0f1199-a296-46a4-bf2c-389c28e5b6f5">Määruste kehtetuks tunnistamine</paragrahvPealkiri><loige id="para12lg1"><loigeNr id="cf7a0a79-486e-44d8-bc53-737c96a43f1f"/><kuvatavNr id="5dd2e158-a354-41c1-8c96-2d87b553267f"/><sisuTekst id="17dd133c-eb67-4388-b5b8-a7fd87492c36"><tavatekst id="7595ea01-1101-4268-8508-083d33e10426">Tunnistatakse kehtetuks:</tavatekst></sisuTekst><alampunkt id="para12lg1p1"><alampunktNr id="cba5f9b5-07b9-4f5a-9422-8fd72785bae4">1</alampunktNr><kuvatavNr id="e7f51c1c-38dd-4369-9bc5-7e81171085b9"><![CDATA[1) ]]></kuvatavNr><sisuTekst id="49de0432-a0c2-486a-8591-9fee31da0438"><tavatekst id="1df88f27-5452-45a7-ada7-39d06c3c8a28">Viljandi Vallavolikogu 23.04.2014 määrus nr 25 „Koduteenuste osutamise tingimused ja kord“;</tavatekst></sisuTekst></alampunkt><alampunkt id="para12lg1p2"><alampunktNr id="bfc35b50-f5ca-4e2b-af3e-8750ce23c621">2</alampunktNr><kuvatavNr id="d04837c0-e267-4c9f-8dee-15c1aac5aeae"><![CDATA[2) ]]></kuvatavNr><sisuTekst id="522d671e-c9d8-434c-98fa-c91530d93222"><tavatekst id="6fddbdee-ad2b-44a5-8ace-9795c6a96d0f">Tarvastu Vallavolikogu 25.02.2016 määrus nr 5 „Koduteenuse osutamise kord“;</tavatekst></sisuTekst></alampunkt><alampunkt id="para12lg1p3"><alampunktNr id="4b0fa197-7823-4a76-81ae-fcfe6c141776">3</alampunktNr><kuvatavNr id="039fe34d-478d-4465-be0e-501f5ca4ecc7"><![CDATA[3) ]]></kuvatavNr><sisuTekst id="c34759f6-4eec-4598-9ec3-a8be9a90b275"><tavatekst id="0feebd01-18bf-40f0-924d-9dabdfe09bf6">Kolga-Jaani Vallavolikogu 26.01.2017 määruses nr 1 „Sotsiaalhoolekandelise abi andmise tingimused ja kord“:<reavahetus/>3.1) paragrahv 22 punkt 1,<reavahetus/>3.2) paragrahvid 24-31.</tavatekst></sisuTekst></alampunkt></loige></paragrahv><paragrahv id="para13"><paragrahvNr id="328cc6b4-23f1-4445-95e4-57a80b2253c8">13</paragrahvNr><kuvatavNr id="0c27d125-279e-4a68-829a-