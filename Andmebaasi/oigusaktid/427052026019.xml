 <sisu id="6114db59-1901-419f-907b-16c849f91990"><preambul id="be65f0cc-9a13-4928-8beb-2600185c6fad"><tavatekst id="8da42900-9ea2-47cb-b7a8-2a256168e4c3">Määrus kehtestatakse kohaliku omavalitsuse korralduse seaduse § 22 lõike 1 punkti 37 ja sotsiaalhoolekandeseaduse § 133 lõike 6 alusel.</tavatekst></preambul><paragrahv id="para1"><paragrahvNr id="9955ea93-cd16-49a5-879a-c4ce95d7565b">1</paragrahvNr><kuvatavNr id="ff8eb605-a417-4cac-b706-a4874400ca8c"><![CDATA[§ 1. ]]></kuvatavNr><paragrahvPealkiri id="52044f20-36bd-4945-982f-4485a69bb69c">Reguleerimisala</paragrahvPealkiri><loige id="para1lg1"><loigeNr id="0f608ad9-1d44-4ecb-a650-f2137a2925ce"/><kuvatavNr id="bd1f6b76-c54b-40ac-afbd-9508dfcc6c80"/><sisuTekst id="c9701ef8-4c2d-4adb-a020-31cbdecac02c"><tavatekst id="9891acbe-f949-4f25-93ea-c47c55d2e2e6">Määrusega kehtestatakse eluasemekulude piirmäärad toimetulekutoetuse arvestamisel Kanepi vallas.</tavatekst></sisuTekst></loige></paragrahv><paragrahv id="para2"><paragrahvNr id="fd7abe5f-c6f0-4a76-aabc-d9cf6b9dcfe8">2</paragrahvNr><kuvatavNr id="716f9fa6-f470-4196-be96-18be58d16600"><![CDATA[§ 2. ]]></kuvatavNr><paragrahvPealkiri id="6443ca90-73b0-449a-9414-75cca9967770">Eluasemekulude piirmäärad</paragrahvPealkiri><loige id="para2lg1"><loigeNr id="12aff673-f4c3-4a51-b2c8-3837a9c8114d"/><kuvatavNr id="44b28aa7-2004-4355-b37a-9fa78ea853dc"/><sisuTekst id="3e7df918-c487-428e-9e25-e3c7f49fa0d9"><tavatekst id="b3da56e7-a97a-4d36-afd1-8e34cc2d025e">Toimetuleku määramisel võetakse elamuseaduse § 7 lõike 1 punkti 2 alusel kehtestatud eluruumi sotsiaalselt põhjendatud norm ja tasumisele kuuluvad eluasemekulud järgmiste piirmäärade ulatuses:</tavatekst></sisuTekst><alampunkt id="para2lg1p1"><alampunktNr id="14170402-af0f-42b1-b46c-f688262cf4d3">1</alampunktNr><kuvatavNr id="ebbb3926-2cec-4b27-90b7-20339d6abbaa"><![CDATA[1) ]]></kuvatavNr><sisuTekst id="5c92e828-ad7c-4de2-9ed7-86573c7968b0"><tavatekst id="0b81367a-177a-4fc3-a894-34a416d70fd7">korteri üür kuni 5 eurot 1m² kohta kuus;</tavatekst></sisuTekst></alampunkt><alampunkt id="para2lg1p2"><alampunktNr id="3c7cb89a-248a-4abf-8f03-1e3388f8bd34">2</alampunktNr><kuvatavNr id="90952311-c37c-42b9-b95a-232fcf9aba61"><![CDATA[2) ]]></kuvatavNr><sisuTekst id="039efead-6db8-42b6-8160-b5799aa03bcd"><tavatekst id="9bb0cca0-d7dd-493b-b93c-305d13b8352d">eluaseme soetamiseks võetud laenu tagasimakse, mis sisaldab ka laenu intressi ja kohustusliku eluasemekindlustuse makset kuni 3 eurot 1m² kohta kuus;</tavatekst></sisuTekst></alampunkt><alampunkt id="para2lg1p3"><alampunktNr id="c22e75a4-c1db-4fcd-b725-729129a6a52a">3</alampunktNr><kuvatavNr id="6a63184e-31ef-4949-8ea8-d8bb85bb845d"><![CDATA[3) ]]></kuvatavNr><sisuTekst id="977b32fb-e90d-447c-9642-8b275e3e354c"><tavatekst id="6e5fd8ca-f051-49ae-870a-66bf7044cfb5">korterelamu haldamise kulu, sh. remondiga seotud kulu kuni 4 eurot 1m² kohta kuus;</tavatekst></sisuTekst></alampunkt><alampunkt id="para2lg1p4"><alampunktNr id="302e9069-9936-40e0-b0e3-b8ad50187518">4</alampunktNr><kuvatavNr id="0d80be09-ebf1-43dd-9dbe-c7700a0a0ae1"><![CDATA[4) ]]></kuvatavNr><sisuTekst id="bc519fd1-03ec-4d8d-a6ec-c89ebde277c8"><tavatekst id="e6de68ab-969b-4fc3-8cad-94f7a75cef20">korterelamu renoveerimiseks võetud laenu tagasimakse kuni 4 eurot 1m² kohta kuus;</tavatekst></sisuTekst></alampunkt><alampunkt id="para2lg1p5"><alampunktNr id="486c8679-1e5e-4c08-a32f-b0b37001554b">5</alampunktNr><kuvatavNr id="8e710cf5-2139-4448-8991-1da73d93de12"><![CDATA[5) ]]></kuvatavNr><sisuTekst id="a0b081cd-1220-400e-82a5-06b6444b5890"><tavatekst id="7bfb17cb-68ac-40d1-b6d9-3e848fd3a2b0">majapidamisgaasi maksumus kuni 25 eurot üheliikmelise pere kohta kuus ning 20 eurot iga järgneva pereliikme kohta kuus;</tavatekst></sisuTekst></alampunkt><alampunkt id="para2lg1p6"><alampunktNr id="6887c964-e9f4-4196-923c-5611667f84f1">6</alampunktNr><kuvatavNr id="62ef17e5-cb0a-429e-9f5a-7002f06694d2"><![CDATA[6) ]]></kuvatavNr><sisuTekst id="d5091c00-ef7e-4be6-8ced-815d79d88768"><tavatekst id="bb780741-6699-4160-9f0e-17817e741517">veevarustuse ja reovee ärajuhtimise teenuse maksumus kuni 20 eurot iga pereliikme kohta kuus;</tavatekst></sisuTekst></alampunkt><alampunkt id="para2lg1p7"><alampunktNr id="59ac7ab3-6500-4bd9-91a5-0cd3b01a9ff8">7</alampunktNr><kuvatavNr id="226a5b54-ced3-4f02-a3f4-7fc28b62761d"><![CDATA[7) ]]></kuvatavNr><sisuTekst id="e6cd5f89-8eee-4035-9883-d91952206787"><tavatekst id="e105f256-8a17-4117-898d-111dba553e0e">tarbitud elektrienergia maksumus kuni 120 eurot üheliikmelise pere kohta kuus ning 40 eurot iga järgneva pereliikme kohta kuus;</tavatekst></sisuTekst></alampunkt><alampunkt id="para2lg1p8"><alampunktNr id="a530c5a4-7570-424b-868c-9f52e52bfe97">8</alampunktNr><kuvatavNr id="6b244d51-195f-4c2a-96f3-707816480644"><![CDATA[8) ]]></kuvatavNr><sisuTekst id="82c38201-4f2a-493e-b1d2-430ee99baca2"><tavatekst id="95c5c3ec-91c1-490b-9ceb-e0c252153eeb">soojaveevarustuseks tarbitud soojusenergia või kütuse maksumus kuni 40 eurot iga pereliikme kohta kuus;</tavatekst></sisuTekst></alampunkt><alampunkt id="para2lg1p9"><alampunktNr id="47b430b3-87af-4be2-9539-f77d99af1ffc">9</alampunktNr><kuvatavNr id="338fe205-f837-4f68-804e-11ecf985d1d0"><![CDATA[9) ]]></kuvatavNr><sisuTekst id="cbb8bd86-ea8b-4161-84bf-0bb01965fc4c"><tavatekst id="2f014e50-efe3-4948-b481-dfc0c86c6cb9">kütteks tarbitud soojusenergia või kütuse maksumus kuni 20 eurot 1m² kohta kuus;</tavatekst></sisuTekst></alampunkt><alampunkt id="para2lg1p10"><alampunktNr id="9b8d41ef-54a6-4008-8f22-ed1dbedd1d9b">10</alampunktNr><kuvatavNr id="b88a23e4-8985-4e20-814d-ff94b6813ad7"><![CDATA[10) ]]></kuvatavNr><sisuTekst id="f0ecc81b-2804-4066-b983-b8dbbeca1b80"><tavatekst id="4e5484a3-c844-40d3-8b62-790d80e9b474">olmejäätmete veo tasu kuni 10 eurot iga pereliikme kohta kuus;</tavatekst></sisuTekst></alampunkt><alampunkt id="para2lg1p11"><alampunktNr id="f28efb2c-b117-497d-8ef7-5eec29793c94">11</alampunktNr><kuvatavNr id="fc09c739-1722-4029-a589-276dde49fda1"><![CDATA[11) ]]></kuvatavNr><sisuTekst id="1c19c8e0-a940-406e-a811-2c5e2698a54d"><tavatekst id="a2f50084-d0e1-41c0-a590-bc13a18499cf">hoonekindlustuse kulu, mis on arvestatud kasutatavale eluruumile kuni 0,20 eurot m<sup>2 </sup>kohta kuus;</tavatekst></sisuTekst></alampunkt><alampunkt id="para2lg1p12"><alampunktNr id="0b669cad-8e77-48f8-b1d8-a4f72980b10b">12</alampunktNr><kuvatavNr id="1e4577d3-f10a-4f70-b3b6-9afd926941a6"><![CDATA[12) ]]></kuvatavNr><sisuTekst id="b919d91b-a615-4b1e-8d4a-eb1f43e9c3ff"><tavatekst id="81567333-2dd5-4b90-adbd-d7d9a5c83578">maamaksukulu, mille arvestamise aluseks on kolmekordne elamualune pind - 0,15 eurot 1m² kohta;</tavatekst></sisuTekst></alampunkt><alampunkt id="para2lg1p13"><alampunktNr id="2a8ba4d4-b5c7-4987-b889-ebf9c80cfe61">13</alampunktNr><kuvatavNr id="f11e1f24-3d41-431d-93b1-8f0ee9ce29f0"><![CDATA[13) ]]></kuvatavNr><sisuTekst id="e0ff2caf-5aff-460f-9d87-293a6914861f"><tavatekst id="437aba6c-b66c-40d6-941c-acc807d12cb1">muu ühekordne eluasemekulu, mille tegemise vajadus on vältimatu ja tuleneb õigusaktist või on tingitud ohust inimeste tervisele või elule, kuni ühe toimetulekupiiri ulatuses kalendriaasta jooksul.</tavatekst></sisuTekst></alampunkt></loige></paragrahv><paragrahv id="para3"><paragrahvNr id="f29b0ffa-c8f0-4b2d-ace0-d54bf175d137">3</paragrahvNr><kuvatavNr id="11b6ed2f-e77d-48e7-b569-ca4c5be1c222"><![CDATA[§ 3. ]]></kuvatavNr><paragrahvPealkiri id="83b42215-02de-4551-91a7-79c71aab9229">Rakendussätted</paragrahvPealkiri><loige id="para3lg1"><loigeNr id="34cb350e-5709-4152-98dd-e18b338834d5">1</loigeNr><kuvatavNr id="6bd327bd-acbd-4640-bd0f-9186babc25dc"><![CDATA[(1)]]></kuvatavNr><sisuTekst id="4acccb11-69b5-494f-b41a-3724952b8e6f"><tavatekst id="04c630c4-dbb5-4a7b-b8a4-329fd99c1709">Tunnistada kehtetuks Kanepi Vallavolikogu 21.04.2022 määrus nr 7 „Eluasemekulude piirmäärad toimetulekutoetuse määramisel“.</tavatekst></sisuTekst></loige><loige id="para3lg2"><loigeNr id="b33345ac-877d-4dd1-b5de-3a2b7c5edbe4">2</loigeNr><kuvatavNr id="a9683d37-e5c3-