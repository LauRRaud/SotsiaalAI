				<sisuTekst id="264a9f23-f913-4251-b3fb-f90c8eeb5b14">
					<tavatekst id="d56ba3f0-993e-4623-8002-872b4782571b">Sügava puudega isiku hooldajale toetus on 40 eurot kuus.</tavatekst>
				</sisuTekst>
			</loige>
			<loige id="para1lg9">
				<loigeNr id="f03752e7-678f-420e-a1fb-f16338316669">9</loigeNr>
