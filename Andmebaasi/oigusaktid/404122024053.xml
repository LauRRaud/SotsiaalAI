		<preambul id="9449d697-73fd-4d38-8d41-3738b643e891">
			<tavatekst id="b667f161-7b21-4e50-b973-b69f033debd5">Määrus kehtestatakse kohaliku omavalitsuse korralduse seaduse § 6 lõike 1, § 22 lõike 1 punkti 5 ja sotsiaalhoolekande seaduse § 14 lõike 2 alusel.</tavatekst>
		</preambul>
		<paragrahv id="para1">
			<paragrahvNr id="50a0afdd-6834-4009-80b3-8b89362d828b">1</paragrahvNr>
			<kuvatavNr id="aa268233-b12d-418f-8ef2-95bb05c02946"><![CDATA[§ 1. ]]></kuvatavNr>
			<paragrahvPealkiri id="c88ffc39-8e87-49f0-bc9b-16c2a7ccf41f">Sotsiaaltoetuste määrad</paragrahvPealkiri>
			<loige id="para1lg1">
				<loigeNr id="ad0f42a0-3484-41c9-a2ee-dc16e0d00221">1</loigeNr>
				<kuvatavNr id="27a6ecca-0ab2-4feb-960f-4487cd45b09c"><![CDATA[(1)]]></kuvatavNr>
				<sisuTekst id="60e6293d-3bd9-4d26-b966-1bdb6d03cf12">
					<tavatekst id="0c67aea2-cef5-4855-94cb-c2138e50c2d4">Sünnitoetuse esimese osa suuruseks on 500 eurot. Sünnitoetuse teise osa suuruseks on 500 eurot.</tavatekst>
				</sisuTekst>
				<muutmismarge id="15bc643b-a21f-4c17-a953-d619be349f8e">
					<avaldamismarge id="a6b279ca-2db9-4b41-a3de-d92d244312f0">
