					<tavatekst id="c528a381-3090-4583-b86d-b5053990fa9f">Puudega isiku hooldajale toetus on 25 eurot kuus.</tavatekst>
				</sisuTekst>
			</loige>
			<loige id="para1lg8">
				<loigeNr id="5706bfdc-bb6e-4dc9-92c6-169bf9504d08">8</loigeNr>
