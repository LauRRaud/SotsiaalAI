						<RTartikkel id="c296a105-94d5-4461-b81e-16485a963235">15</RTartikkel>
						<aktViide id="596da372-64ce-4293-8036-1913f58cd376">423122020015</aktViide>
					</avaldamismarge>
					<joustumine id="e4a2c2fd-2b05-4d15-b2a1-ec475d507d64">2021-01-01</joustumine>
					<aktiNr id="67e72044-0794-4722-b9e7-3d527a71e28f">18</aktiNr>
				</muutmismarge>
			</loige>
			<loige id="para1lg2">
				<loigeNr id="62759571-690b-49d2-8a62-c225b817553d">2</loigeNr>
				<kuvatavNr id="e3e1f7d0-b30e-4f4e-91e5-580e4e2386a3"><![CDATA[(2)]]></kuvatavNr>
				<sisuTekst id="8fdfff07-2af3-4eb6-9af1-68b57b10e49e">
					<tavatekst id="750f93ea-a415-4b07-9176-5bc0680b5125">Matusetoetuse suuruseks on 250 eurot. Täiendava matusetoetuse suuruseks on kuni 100 eurot.</tavatekst>
				</sisuTekst>
			</loige>
			<loige id="para1lg3">
				<loigeNr id="c27e1983-8e26-4870-8952-52d718af4403">3</loigeNr>
				<kuvatavNr id="a98861d1-d21e-4354-998b-d8ed600ec2e8"><![CDATA[(3)]]></kuvatavNr>
