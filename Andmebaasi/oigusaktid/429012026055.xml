				<kuvatavNr id="e74c57e1-3b42-46d9-bf9b-be4db294a9a6"><![CDATA[(2)]]></kuvatavNr>
				<sisuTekst id="8d913c42-2b03-4fe8-9a0a-a70a352433c8">
					<tavatekst id="8b5414a0-8082-4ea6-976d-6bc46cc36ab9">Määrust jõustub 1. jaanuaril 2023.</tavatekst>
