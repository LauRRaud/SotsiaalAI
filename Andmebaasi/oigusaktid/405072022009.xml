 <sisu id="95e7621f-e8c6-4a6d-984a-7eae64bdfd0f"><preambul id="c0fd3a56-d1dc-4c76-8361-634cbee9e187"><tavatekst id="56504360-4d4f-4c4b-be01-e21ddb3bae67">Määrus kehtestatakse sotsiaalhoolekande seaduse § 133 lõike 6 alusel.</tavatekst></preambul><paragrahv id="para1"><paragrahvNr id="ae7ea583-8e6c-4206-83f9-d571a339af0d">1</paragrahvNr><kuvatavNr id="468c090c-7b58-4cdc-b91e-8d4966f360b3"><![CDATA[§ 1. ]]></kuvatavNr><paragrahvPealkiri id="17898d47-fea5-495e-b66b-fa7fd8cd6ed7">Reguleerimisala</paragrahvPealkiri><loige id="para1lg1"><loigeNr id="61edd344-86fb-46e0-ae3e-e8c3cb859212"/><kuvatavNr id="ad5369d9-75c9-49a7-92a7-2088ec82c02a"/><sisuTekst id="c8d90fab-774d-4830-842c-e91352292cc1"><tavatekst id="02d26771-538a-4537-b96c-aef38d96aeac">Määrusega kehtestatakse eluruumi alaliste kulude piirmäärad toimetulekutoetuse määramiseks.</tavatekst></sisuTekst></loige></paragrahv><paragrahv id="para2"><paragrahvNr id="2b0ef3dd-ac4b-49e3-b464-df919b9af1dd">2</paragrahvNr><kuvatavNr id="e7778789-3c66-4c28-8fcf-e7b897e9a55c"><![CDATA[§ 2. ]]></kuvatavNr><paragrahvPealkiri id="7e1c59ba-6c9b-4de0-a214-81834886b8f8">Eluruumi alaliste kulude piirmäärad</paragrahvPealkiri><loige id="para2lg1"><loigeNr id="40781e22-045f-4de5-8956-77641f4b2d81"/><kuvatavNr id="cdd1bc2a-f623-436d-ab72-8246e28ec0d3"/><sisuTekst id="af7c8f2c-db2a-4aa8-b951-7ee48c1b5693"><tavatekst id="1597d6de-7232-4190-ba7c-a4e076746eb1">Toimetulekutoetuse arvestamisel arvesse võetavate jooksval kuul tasumisele kuuluvate eluruumi alaliste kulude piirmäärad on järgmised:</tavatekst></sisuTekst><alampunkt id="para2lg1p1"><alampunktNr id="cb69cbd8-fd8e-4fcd-962d-a5dfac8c0f8d">1</alampunktNr><kuvatavNr id="dabcc7ba-b494-4ea9-a20c-5dc6e9bd07e7"><![CDATA[1) ]]></kuvatavNr><sisuTekst id="7a1353a4-5a20-4934-b466-75c845606fc1"><tavatekst id="f023d628-e05a-40bb-8acf-486a4167aedf">üür - kuni 6 eurot m<sup>2</sup> kohta kuus;</tavatekst></sisuTekst></alampunkt><alampunkt id="para2lg1p2"><alampunktNr id="e07ddefb-80db-41cf-b5b2-d82c28e62bc8">2</alampunktNr><kuvatavNr id="bd9bb604-d5b0-411b-9187-6542cf7303f9"><![CDATA[2) ]]></kuvatavNr><sisuTekst id="b98d0f61-c988-4db1-883a-48968fde0339"><tavatekst id="1515ecdb-6c9d-48fb-9cbe-fd1209b288f9">eluaseme soetamiseks võetud laenu tagasimakse <b> - </b> kuni 6 eurot m<sup>2</sup> kohta kuus;</tavatekst></sisuTekst></alampunkt><alampunkt id="para2lg1p3"><alampunktNr id="9f7f8e7e-a69c-40d4-8c9d-63f12309fd57">3</alampunktNr><kuvatavNr id="ba0963bb-cf6d-4c57-8749-8067f6138253"><![CDATA[3) ]]></kuvatavNr><sisuTekst id="f257e74a-429b-45b4-bd17-ce5c076dd0bd"><tavatekst id="010e1574-93ad-48b7-8cf3-11b2aaf345a0">korterelamu haldamise kulu, sealhulgas remondiga seotud kulu - kuni 2 eurot m<sup>2</sup> kohta kuus;</tavatekst></sisuTekst></alampunkt><alampunkt id="para2lg1p4"><alampunktNr id="5e426925-37c4-42b2-9351-578af4026433">4</alampunktNr><kuvatavNr id="68428d2d-7eaf-43b0-9e76-1df6afce13d6"><![CDATA[4) ]]></kuvatavNr><sisuTekst id="77bd84e8-a9b7-4d04-b8e5-7531c1467bb0"><tavatekst id="82073fff-1cd9-4d1b-81ce-1581a68fdb4e">korterelamu renoveerimiseks võetud laenu tagasimakse - kuni 2 eurot m<sup>2</sup> kohta kuus;</tavatekst></sisuTekst></alampunkt><alampunkt id="para2lg1p5"><alampunktNr id="5095989a-a18d-44cb-a0f0-788c27cf55f4">5</alampunktNr><kuvatavNr id="88bc374d-86e6-4b0e-8793-e562c7ac731d"><![CDATA[5) ]]></kuvatavNr><sisuTekst id="071ed955-47ef-4bb6-addc-0a397161618d"><tavatekst id="8d6340d0-25f9-402d-9031-47f0a0877ee9">veevarustuse ja reovee ärajuhtimise teenuste maksumus - kuni 4 m<sup>3</sup> iga pereliikme kohta kuus;</tavatekst></sisuTekst></alampunkt><alampunkt id="para2lg1p6"><alampunktNr id="eb5dee9c-b7c6-4c11-a5e1-97b75f77d358">6</alampunktNr><kuvatavNr id="ca9a2a95-8365-45a4-a5db-a2f2694cd081"><![CDATA[6) ]]></kuvatavNr><sisuTekst id="e988b747-ab12-40ad-8069-f3eb32036588"><tavatekst id="88460302-74b5-4ba0-9cef-1da6952e61de">soojaveevarustuseks tarbitud soojusenergia või kütuse maksumus – kuni 15 eurot esimese pereliikme kohta kuus ja kuni 10 eurot iga järgneva pereliikme kohta kuus;</tavatekst></sisuTekst></alampunkt><alampunkt id="para2lg1p7"><alampunktNr id="7bcfac0e-2f4d-4321-a22a-a830fc1f0fc5">7</alampunktNr><kuvatavNr id="99e6dd33-8e8c-495e-bb19-533ee39d9be1"><![CDATA[7) ]]></kuvatavNr><sisuTekst id="100d6fab-88e7-473d-9574-184e43f546e6"><tavatekst id="e486f44d-1b17-4f21-add8-ca89c41d5afa">kütteks tarbitud soojusenergia või kütuse maksumus – kaugküttega ja kaugkütteta eluruumis kuni 4 eurot m<sup>2</sup> kohta kuus. Juhul, kui kuludokumendil kajastub taotlusele järgneva perioodi küttekulu, kompenseeritakse see kuludokumendi esitamisele järgnevatel kuudel kuludokumendil näidatud summa kompenseerimiseni või kuni uue kuludokumendi esitamiseni;</tavatekst></sisuTekst></alampunkt><alampunkt id="para2lg1p8"><alampunktNr id="220146b6-fcb3-4d28-ab5c-2586ea82ff87">8</alampunktNr><kuvatavNr id="3d9e302b-ee18-4ea4-a8fe-a9c9ad10142d"><![CDATA[8) ]]></kuvatavNr><sisuTekst id="e4ee088c-7074-46d2-a602-1786f5ba59ab"><tavatekst id="65ec3278-9e77-4e7f-af3e-f22e96229c6a">elektrienergia tarbimisega seotud kulu - kuni 30 eurot esimese pereliikme kohta kuus ja kuni 20 eurot iga järgneva pereliikme kohta kuus;</tavatekst></sisuTekst></alampunkt><alampunkt id="para2lg1p9"><alampunktNr id="8196b0b2-61a7-4cd3-b488-ca89972b9864">9</alampunktNr><kuvatavNr id="ec3fc34f-3c6f-4af7-bcd0-c0beca5939be"><![CDATA[9) ]]></kuvatavNr><sisuTekst id="eddefe34-b3db-45ec-b5e6-323af17d1378"><tavatekst id="83dad5fd-69ff-45ee-ac4d-5d3f648034ed">majapidamisgaasi maksumus - kuni 8 eurot esimese pereliikme kohta kuus ja kuni 6 eurot iga järgneva pereliikme kohta kuus. Balloonigaasi kasutamisel kompenseeritakse kulu vajadusel ka kuludokumendi esitamisele järgnevatel kuudel kuludokumendil näidatud summa kompenseerimiseni või kuni uue kuludokumendi esitamiseni;</tavatekst></sisuTekst></alampunkt><alampunkt id="para2lg1p10"><alampunktNr id="a77ad5c3-e498-4400-b7c3-38e1095ae78a">10</alampunktNr><kuvatavNr id="26784fc6-8e73-4564-8713-9df83630f211"><![CDATA[10) ]]></kuvatavNr><sisuTekst id="05907a35-2caa-42dd-a217-8fae482db675"><tavatekst id="36c9f2cf-7591-4df3-9244-5fafc4af8216">maamaksukulu, mille arvestamise aluseks on kolmekordne elamualune pind - kuni 0,19 eurot m<sup>2</sup> kohta kuus;</tavatekst></sisuTekst></alampunkt><alampunkt id="para2lg1p11"><alampunktNr id="26320475-b928-42e6-a887-b61062210783">11</alampunktNr><kuvatavNr id="16014d12-b59e-4e0e-9239-11562d1ffc9f"><![CDATA[11) ]]></kuvatavNr><sisuTekst id="14465928-2336-4686-bbe9-7707202ece2f"><tavatekst id="3136cec7-c504-498d-ae00-c3c3aa34ba22">hoonekindlustuse kulu - kuni 0,3 eurot m<sup>2</sup> kohta kuus;</tavatekst></sisuTekst></alampunkt><alampunkt id="para2lg1p12"><alampunktNr id="afb780e7-03d7-41b7-952e-cd3263cdcd00">12</alampunktNr><kuvatavNr id="98cc6d6c-1b87-4ecd-99b6-c908b5b0323d"><![CDATA[12) ]]></kuvatavNr><sisuTekst id="b31d8415-b1b0-48c9-93c6-6b925c1ce71f"><tavatekst id="3898e73d-759b-4f38-8ad9-9b4e773e2473">olmejäätmete veotasu - kuni 6 eurot esimese pereliikme kohta kuus ja kuni 4 eurot iga järgneva pereliikme kohta kuus;</tavatekst></sisuTekst></alampunkt></loige></paragrahv><paragrahv id="para3"><paragrahvNr id="ceed73fd-bcc0-40ce-bc22-406419a7602c">3</paragrahvNr><kuvatavNr id="a356952a-4120-4278-8bfa-2d6dcadd6178"><![CDATA[§ 3. ]]></kuvatavNr><paragrahvPealkiri id="bfd09885-a6ea-4e7f-8387-7ff49a165690">Määruse kehtetuks tunnistamine</paragrahvPealkiri><loige id="para3lg1"><loigeNr id="54654a44-1af3-48ca-85dd-b9f195a84cb2"/><kuvatavNr id="ddc9bf50-ba7e-43a7-84ae-5101980131e6"/><sisuTekst id="6ddc82f7-0d3a-445b-951a-82ae2673a5cb"><tavatekst id="ce641a2c-bf47-4bb5-9e06-6fe0a72a9604">Otepää Vallavolikogu 19. aprilli 2018. a määrus nr 6 „Eluruumi alaliste kulude piirmäärad toimetulekutoetuse määramiseks“ tunnistatakse kehtetuks.</tavatekst></sisuTekst></loige></paragrahv><paragrahv id="para4"><paragrahvNr id="ec474aa8-83d8-4cd5-a1a1-f776d02c6233">4</paragrahvNr><kuvatavNr id="5f9162ca-68ab-487c-adf6-aaa1a3b7a3c9"><![CDATA[§ 4. ]]></kuvatavNr><paragrahvPealkiri id="2913c69c-a225-4e71-8475-eae84505b581">Määruse rakendamine</paragrahvPealkiri><loige id="para4lg1"><loigeNr id="3c65d0c1-069e-451c-93a4-bc766da10d31"/><kuvatavNr id="da182b2e-cc43-4035-afc6-f0c2d40bb495"/><sisuTekst id="4113f389-dd96-4e2d-9654-3af057b4d197"><tavatekst id="5c035cef-848f-46d2-a42d-672a251c6f3a">Määrust rakendatakse alates 1. juulist 2022. a.</tavatekst></sisuTekst></loige></paragrahv></sisu>
