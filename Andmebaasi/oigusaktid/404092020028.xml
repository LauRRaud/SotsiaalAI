   </sisuTekst>
  </alampunkt><alampunkt id="para10lg2p3">
   <alampunktNr id="0d26ac46-9ec2-4439-9f9d-595c6c5cc9dc">3</alampunktNr>
   <kuvatavNr id="adc28f20-f60a-486e-8db2-eed1c381f16c"><![CDATA[3) ]]></kuvatavNr>
   <sisuTekst id="61595df5-6f5c-4b1a-a9ab-3e68618d3e58">
