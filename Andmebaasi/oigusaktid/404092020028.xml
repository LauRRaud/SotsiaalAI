   <paragrahvPealkiri id="e81f47bd-0317-43eb-abca-e9812ef2ba63">Määruse jõustumine</paragrahvPealkiri>
  <loige id="para11lg1">
   <loigeNr id="15be3cd3-e1ee-40a7-828d-554eca030d14">1</loigeNr>
   <kuvatavNr id="87284f78-652f-4d40-bbf0-3a3676a26949"><![CDATA[(1)]]></kuvatavNr>
   <sisuTekst id="0335f1de-7cda-4960-9d25-403b31a1027c">
    <tavatekst id="b9418cfb-5fe7-47c1-af12-75e0f971fd28">Määrust rakendatakse tagasiulatuvalt alates <b>01. jaanuarist 2018.a.</b></tavatekst>
