   <sisuTekst id="bf1267b1-3091-4935-bbb2-3ad7cd71397b">
    <tavatekst id="ec03c65a-7981-44dc-bca2-774bb95e3a4a">lepingupoolte vastastikusel kokkuleppel;</tavatekst>
   </sisuTekst>
  </alampunkt><alampunkt id="para10lg1p5">
   <alampunktNr id="feefa742-3ef2-479c-ab75-52cb80b8b9a0">5</alampunktNr>
