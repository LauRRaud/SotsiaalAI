    <tavatekst id="58157389-c241-4b24-820d-4a82e7c582e4"> lepingus sätestatud kohustuste mittenõuetekohase täitmise korral;</tavatekst>
   </sisuTekst>
  </alampunkt><alampunkt id="para10lg1p4">
