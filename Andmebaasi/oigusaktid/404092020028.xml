   </sisuTekst>
  </alampunkt><alampunkt id="para10lg2p2">
   <alampunktNr id="652de170-61d6-47db-b23e-baa93113932c">2</alampunktNr>
   <kuvatavNr id="950f1ad6-532b-43e0-96f8-6860732e5bad"><![CDATA[2) ]]></kuvatavNr>
   <sisuTekst id="596c1e7a-4f6d-4822-9f19-1a84b1583e5f">
