			<ametinimetus id="3229304a-e9f1-4545-a587-d966e59bf57d">Volikogu esimees</ametinimetus>
			<eesnimi id="98738e49-b062-46bc-a108-625ed0da34ba">Mati</eesnimi>
			<perekonnanimi id="d0fabc8e-a961-4dca-95a6-ce83a4f322eb">Möller</perekonnanimi>
		</allkirjastaja>
