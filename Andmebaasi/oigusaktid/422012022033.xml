      <ametinimetus id="c3126663-2834-4547-9fba-6f30ed59e3e9">volikogu esimees</ametinimetus>
      <eesnimi id="accbbe58-dde6-4a19-ab8f-417bd6b60697">Eiko</eesnimi>
      <perekonnanimi id="ed8d480e-6888-4762-8c49-460c13dcbca6">Tammist</perekonnanimi>
    </allkirjastaja>
