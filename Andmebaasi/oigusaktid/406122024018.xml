        <kuvatavNr id="a7865385-6a1d-4c9b-bfed-c85e542b4962"/>
        <sisuTekst id="1c049036-774c-4086-b28c-7591fa44e1cf">
          <tavatekst id="3047b61c-d7fa-471e-a790-5279cb29b1e1">Tunnistada kehtetuks Väike-Maarja Vallavolikogu 16.06.2022 määrus nr 7 „Eluruumi alaliste kulude piirmäärade kehtestamine Väike-Maarja vallas“.</tavatekst>
        </sisuTekst>
      </loige>
    </paragrahv>
    <paragrahv id="para4">
