			<pealkiri id="9919de05-7a51-4127-88ce-91b022b79aa5">Sotsiaaltoetuste määrade kehtestamine</pealkiri>
		</nimi>
	</aktinimi>
	<sisu id="c08732cb-a22c-4a3b-a82d-207a376b5c30">
		<preambul id="af0bbba2-8447-400d-88c7-f6a6b2875f05">
			<tavatekst id="6f12138a-41a4-46de-a49f-b27afcca0200">Määrus kehtestatakse Väike-Maarja Vallavolikogu 25.03.2026 määruse nr 1 „Väike-Maarja valla 2026. aasta eelarve vastuvõtmine“ ja Väike-Maarja Vallavolikogu 28.11.2024 määruse nr 44 „Sotsiaalhoolekandelise abi andmise kord” § 7 lõike 2 alusel.<reavahetus/></tavatekst>
		</preambul>
		<paragrahv id="para1">
			<paragrahvNr id="136e519f-1b7c-4427-8fb7-b52c0ae9daa9">1</paragrahvNr>
			<kuvatavNr id="50e1866c-d4f3-4933-8e7b-1d422610099c"><![CDATA[§ 1. ]]></kuvatavNr>
			<paragrahvPealkiri id="6ff6a2ea-d55b-460d-87a7-eb57de6deaf7">Sotsiaaltoetuste määrade kehtestamine</paragrahvPealkiri>
			<loige id="para1lg1">
				<sisuTekst id="b228500e-b86c-4e19-b53d-0772d3f0841f">
					<tavatekst id="92e3bacf-a8dd-4f86-bb54-5d30fb6ca16f">Kehtestada sotsiaaltoetuste määrad:</tavatekst>
				</sisuTekst>
				<alampunkt id="para1lg1p1">
					<alampunktNr>1</alampunktNr>
					<kuvatavNr><![CDATA[1) ]]></kuvatavNr>
					<sisuTekst>
						<tavatekst>esmakordselt esimesse klassi mineva lapse toetus 100 eurot;</tavatekst>
					</sisuTekst>
				</alampunkt>
				<alampunkt id="para1lg1p2">
					<alampunktNr>2</alampunktNr>
					<kuvatavNr><![CDATA[2) ]]></kuvatavNr>
					<sisuTekst>
						<tavatekst>küttetoetus 200 eurot aastas;</tavatekst>
					</sisuTekst>
				</alampunkt>
				<alampunkt id="para1lg1p3">
					<alampunktNr>3</alampunktNr>
					<kuvatavNr><![CDATA[3) ]]></kuvatavNr>
					<sisuTekst>
						<tavatekst>sünnitoetus 600 eurot;</tavatekst>
					</sisuTekst>
				</alampunkt>
				<alampunkt id="para1lg1p4">
					<alampunktNr>4</alampunktNr>
					<kuvatavNr><![CDATA[4) ]]></kuvatavNr>
					<sisuTekst>
						<tavatekst>juubelitoetus 50 eurot;</tavatekst>
					</sisuTekst>
				</alampunkt>
				<alampunkt id="para1lg1p5">
					<alampunktNr>5</alampunktNr>
					<kuvatavNr><![CDATA[5) ]]></kuvatavNr>
					<sisuTekst>
						<tavatekst>matusetoetuse 375 eurot;</tavatekst>
					</sisuTekst>
				</alampunkt>
				<alampunkt id="para1lg1p6">
					<alampunktNr>6</alampunktNr>
					<kuvatavNr><![CDATA[6) ]]></kuvatavNr>
					<sisuTekst>
						<tavatekst>hooldajatoetus puudega lapse hooldajale 50 eurot kuus;</tavatekst>
					</sisuTekst>
				</alampunkt>
				<alampunkt id="para1lg1p7">
					<alampunktNr>7</alampunktNr>
					<kuvatavNr><![CDATA[7) ]]></kuvatavNr>
					<sisuTekst>
						<tavatekst>hooldajatoetus puudega täisealise isiku hooldajale 50 eurot kuus;</tavatekst>
					</sisuTekst>
				</alampunkt>
				<alampunkt id="para1lg1p8">
					<alampunktNr>8</alampunktNr>
					<kuvatavNr><![CDATA[8) ]]></kuvatavNr>
					<sisuTekst>
						<tavatekst>sotsiaaltoetuse ülemmäär, mida on sotsiaalosakonna juhatajal õigus otsustada ilma toetuste määramise komisjoni ja vallavalitsust otsustusprotsessi kaasamata, 25 eurot.</tavatekst>
					</sisuTekst>
				</alampunkt>
			</loige>
		</paragrahv>
		<paragrahv id="para2">
			<paragrahvNr id="fd4c85c1-2298-44f0-84d2-9194a5e3cfe7">2</paragrahvNr>
			<kuvatavNr id="ea503c62-2adf-4249-9f8b-55a7d8ced4c2"><![CDATA[§ 2. ]]></kuvatavNr>
			<paragrahvPealkiri id="b460c34a-1417-4fbf-acbb-ba95d374ba59">Määruse kehtetuks tunnistamine</paragrahvPealkiri>
			
			<loige id="para2lg1">
				<loigeNr id="9d598162-975e-4c8b-8cd6-1a172f4b8d30"/>
				<kuvatavNr id="415c1e33-73a5-46cd-a349-c6e51e89d70a"/>
				<sisuTekst id="aebc0846-e4ec-40c9-9c86-214f92c503ba">
					<tavatekst id="635ecf05-9ece-4a91-a4c2-626b96a4a44b">Tunnistada kehtetuks Väike-Maarja Vallavalitsuse 23.02.2022 määrus nr 2 „Sotsiaaltoetuste määrade kehtestamine“.</tavatekst>
				</sisuTekst>
			</loige>
		</paragrahv>
		<paragrahv id="para3">
			<paragrahvNr id="b3498ac4-de4d-4d87-87e4-ea4abc88bfdf">3</paragrahvNr>
			<kuvatavNr id="23ad4ce9-bfcc-4186-9489-5a612fd44e8d"><![CDATA[§ 3. ]]></kuvatavNr>
			<paragrahvPealkiri id="ed6c1821-d1f8-4b1e-a140-3deed05fc4d0">Määruse jõustumine</paragrahvPealkiri>
			<loige id="para3lg1">
			<loigeNr/>
			<kuvatavNr/>
			<sisuTekst id="fa8d5fbd-32e4-4f4f-9ba0-cc7529da51db">
				<tavatekst id="b863e611-7804-496c-b4ef-dd4efcb41685">Määrus jõustub kolmandal päeval pärast Riigi Teatajas avaldamist.</tavatekst>
			</sisuTekst>
			</loige>
		</paragrahv>
	</sisu>
