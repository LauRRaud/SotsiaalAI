 <aktinimi id="426adc3d-7f22-46e3-9323-165a4a1f75a7">
  <nimi id="a83e5886-f441-4310-b631-46c89a55225c">
   <pealkiri id="be7e6cbb-c354-4678-9f1b-0899990ed470">Suure hooldus- ja abivajadusega lastele sotsiaalteenuste osutamise tingimused ja kord</pealkiri>
  </nimi>
 </aktinimi>
 <sisu id="2dd9e4a8-cf28-4fe9-a935-58460738f05d"><preambul id="d6177d0e-37f8-4a09-9652-6c918d7b51ac">
   <tavatekst id="ec0c1408-cc83-49f2-8907-5851e6de2b22">Määrus kehtestatakse kohaliku omavalitsuse korralduse seaduse § 22 lõike 1 punkti 37 ja sotsiaalhoolekande seaduse § 14 ja § 156 lõigete 3<sup>1</sup>-3<sup>3</sup> alusel.</tavatekst>
  </preambul><paragrahv id="para1">
   <paragrahvNr id="e9c13c9e-82e3-4859-a801-66ecb8f2b3ad">1</paragrahvNr>
   <kuvatavNr id="0f457fae-dc39-4e11-9bf3-37ff811d3f34"><![CDATA[§ 1. ]]></kuvatavNr>
   <paragrahvPealkiri id="49320a02-5c58-4e48-91c7-e39389f480f5">Üldsätted</paragrahvPealkiri>
  <loige id="para1lg1">
   <loigeNr id="a1517381-6bb8-42f4-8f66-4493a8ce0213">1</loigeNr>
   <kuvatavNr id="cf724cb1-b4f5-4d22-8966-8bc3b923aa59"><![CDATA[(1)]]></kuvatavNr>
   <sisuTekst id="d2bf01ed-ffe4-4205-9cda-b4b33479b3f2">
    <tavatekst id="34014aee-f63d-42b6-bba8-b890dd9d447b">Määrusega kehtestatakse Narva linna suure hooldus- ja abivajadusega lastele (edaspidi lapsed), kelle elukohaks on Eesti rahvastikuregistri andmetel Narva linn, sotsiaalteenuste (edaspidi teenused) taotlemise tingimused ja kord.</tavatekst>
   </sisuTekst>
  </loige><loige id="para1lg2">
   <loigeNr id="409c247c-63e5-4690-b57a-e8c0effc6bb6">2</loigeNr>
   <kuvatavNr id="b841e64b-bf1c-43ff-b2b7-fc87c8a704cd"><![CDATA[(2)]]></kuvatavNr>
   <sisuTekst id="3ada39e8-bea2-4aa9-9c1b-3c19fed77907">
    <tavatekst id="836d96ee-ca56-46c4-8743-a84035adf2a2">Vahendite kasutamist korraldab ja kasutamise üle peab arvestust Narva linna Sotsiaalabiamet (edaspidi Sotsiaalabiamet).</tavatekst>
   </sisuTekst>
  </loige><loige id="para1lg3">
   <loigeNr id="348c06da-1225-4eac-ab47-aaec5c4b48dd">3</loigeNr>
   <kuvatavNr id="9b02551d-b632-4a77-bb2b-09f2af89e2e4"><![CDATA[(3)]]></kuvatavNr>
   <sisuTekst id="15668521-eac3-4c71-8721-ee9b1c0313cb">
    <tavatekst id="c7a4b386-7ab9-4f42-99d7-434113e3de56">Teenuseid rahastatakse Euroopa Sotsiaalfondi vahenditest, linnaeelarvelistest vahenditest, riigi poolt eraldatavatest toetus- ja tasandusfondi vahenditest, lapsevanema, füüsilisest isikust eestkostja või lepingu alusel hoolduspere vanema vahenditest (omaosalus). Teenuseid rahastatakse vastavate rahaliste vahendite olemasolul.</tavatekst>
   </sisuTekst>
  </loige></paragrahv><paragrahv id="para2">
   <paragrahvNr id="5eb0ca7a-045f-402f-be90-16229c094e0f">2</paragrahvNr>
   <kuvatavNr id="1885cd54-d6c9-4f33-8d00-469093caf0f5"><![CDATA[§ 2. ]]></kuvatavNr>
   <paragrahvPealkiri id="dc8bc9c2-9f08-4a03-ae28-8518f01827df">Rahaliste vahendite kasutamine</paragrahvPealkiri>
  <loige id="para2lg1">
   <loigeNr id="37ddf5c9-ff22-4cab-ab5f-e6f6efad37b1">1</loigeNr>
   <kuvatavNr id="eb6a05ff-478a-45c1-a208-36a678f6f041"><![CDATA[(1)]]></kuvatavNr>
   <sisuTekst id="1953469f-b3e0-4884-8376-3edd5127fdf3">
    <tavatekst id="9005b289-617f-4f24-afca-e40cdb7a59c5">Vahendeid võib kasutada järgmiste laste ja nende peredega seotud teenuste saamiseks:</tavatekst>
   </sisuTekst>
  <alampunkt id="para2lg1p1">
   <alampunktNr id="dc25c0e4-d622-4214-aa0f-283accfdec92">1</alampunktNr>
   <kuvatavNr id="710c7dab-b7fc-446c-bfed-5891ba3032df"><![CDATA[1) ]]></kuvatavNr>
   <sisuTekst id="b3fba47e-b417-475d-96bc-4e39c9c65a5a">
    <tavatekst id="6450989e-716c-4bcc-a6eb-1c2ee806dbdd">lapsehoiuteenus</tavatekst>
   </sisuTekst>
  </alampunkt><alampunkt id="para2lg1p2">
   <alampunktNr id="9cbb15b3-ff39-49d2-8e72-37194462519c">2</alampunktNr>
   <kuvatavNr id="a901a339-667f-4350-b43f-23eec8723add"><![CDATA[2) ]]></kuvatavNr>
   <sisuTekst id="74b748b7-b132-4859-b73c-b4ee9ecbabe9">
    <tavatekst id="b141a05e-f8a7-4f56-a406-3605ee2cbf26">tugiisikuteenus lapsele</tavatekst>
   </sisuTekst>
  </alampunkt><alampunkt id="para2lg1p3">
   <alampunktNr id="c2a0946c-a23d-485f-8bac-31f655f87b33">3</alampunktNr>
   <kuvatavNr id="ba750d44-2cb1-4d9e-b0fd-a85dccdea01e"><![CDATA[3) ]]></kuvatavNr>
   <sisuTekst id="71a3987f-b0ca-4095-beba-2996fb8bf085">
    <tavatekst id="f2af30bf-22f7-4c0f-8b25-5abe216965a6">sotsiaaltransporditeenus</tavatekst>
   </sisuTekst>
  </alampunkt><alampunkt id="para2lg1p4">
   <alampunktNr id="a382a5a8-fd4f-49e3-8898-758a2fb1916c">4</alampunktNr>
   <kuvatavNr id="85ebb1ef-8893-4935-95ba-db9fc039fed9"><![CDATA[4) ]]></kuvatavNr>
   <sisuTekst id="7c572964-9588-4332-8c35-b8bf9c6c566a">
    <tavatekst id="0d5c5aaf-ac09-4c92-8276-67357cee1aa6">eluruumi kohandamine</tavatekst>
   </sisuTekst>
  </alampunkt></loige><loige id="para2lg2">
   <loigeNr id="964083e7-92d0-44fd-b34a-22ae8fffba77">2</loigeNr>
   <kuvatavNr id="a86f1600-28c0-4f1a-a48f-b1bbc9aeb3ba"><![CDATA[(2)]]></kuvatavNr>
   <sisuTekst id="ccd972f2-5cea-4732-9467-23f5504f6a8b">
    <tavatekst id="6490b6e8-2784-44fa-9fd7-5bb090aa0b88">Käesolevas määruses kasutatakse teenuste definitsioone järgmises tähenduses:</tavatekst>
   </sisuTekst>
  <alampunkt id="para2lg2p1">
   <alampunktNr id="3d7e1032-329c-48c1-adf4-d6dc9e16afbd">1</alampunktNr>
   <kuvatavNr id="19dbc60a-b84f-4882-90f5-d9468c3a652c"><![CDATA[1) ]]></kuvatavNr>
   <sisuTekst id="5bb47203-37f2-47ae-b6eb-dead23024ce0">
    <tavatekst id="b89a00a6-7a5e-4451-8d38-225ed6b97b2c">lapsehoiuteenuse eesmärk on toetada last kasvatava isiku toimetulekut või töötamist või vähendada lapse erivajadusest tulenevat hoolduskoormust;</tavatekst>
   </sisuTekst>
  </alampunkt><alampunkt id="para2lg2p2">
   <alampunktNr id="d9e845f6-3735-42f7-b943-9ec26d79e4bd">2</alampunktNr>
   <kuvatavNr id="eee0d7f6-0a38-4ed7-ae34-2865971f6a91"><![CDATA[2) ]]></kuvatavNr>
   <sisuTekst id="a3980c7a-4a21-4e4d-849a-aede100e9805">
    <tavatekst id="331da0ec-9be7-4b02-be41-d3008518bda5">tugiisikuteenus lapsele on ühe lapse juhendamine, abistamine ja jõustamine last arendavates tegevustes, kohustuste täitmisel, õiguste teostamisel ja/või keerulise olukorraga toimetulekul. Tugiisik abistab last arendavate tegevuste läbiviimisel, õpetab ja julgustab igapäevaelus toime tulema. Tugiisik võib vajadusel olla ka lapsele saatjaks. Tugiisik abistab ja motiveerib last õppimisel ning aitab suhelda nii perekonnaliikmetega kui ka isikutega väljaspool kodu;</tavatekst>
   </sisuTekst>
  </alampunkt><alampunkt id="para2lg2p3">
   <alampunktNr id="acfc40f6-39f1-443b-a8ed-8decefd6303f">3</alampunktNr>
   <kuvatavNr id="05ab3a06-d3d6-4fb3-b5de-5b06054978af"><![CDATA[3) ]]></kuvatavNr>
   <sisuTekst id="73680b10-4d45-4092-9a01-501fdb4f9f9f">
    <tavatekst id="d877db73-8beb-477a-8bfb-20f657afd524">sotsiaaltransporditeenus on sotsiaalteenus, mille eesmärk on võimaldada puuetega inimeste sotsiaaltoetuste seaduse § 2 lõike 1 tähenduses puudega isikul, kellel puue takistab isikliku või ühissõiduki kasutamist, kasutada tema vajadustele vastavat transpordivahendit õppeasutusse sõitmiseks või avalike teenuste kasutamiseks;</tavatekst>
   </sisuTekst>
  </alampunkt><alampunkt id="para2lg2p4">
   <alampunktNr id="b974937b-21b2-48ca-a980-cbef2ccbf276">4</alampunktNr>
   <kuvatavNr id="fc07b4a8-9973-48db-8115-859c48e04d72"><![CDATA[4) ]]></kuvatavNr>
   <sisuTekst id="d71ba40c-e0a3-4f2a-bdb9-aa48263e2e84">
    <tavatekst id="068930be-e92c-447f-acae-f0469a621c9e">eluruumi kohandamine on teenus, mille eesmärk on tagada lapsele, kellel on raskusi eluruumis liikumise, suhtlemise või endaga toimetulekuga võimalikult iseseisev või võimalikult vähest kõrvalabi vajav turvaline toimetulek eluruumi piires ning sellesse sisenemisel ja väljumisel.</tavatekst>
   </sisuTekst>
  </alampunkt></loige><loige id="para2lg3">
   <loigeNr id="1a8ffdc2-8b57-4463-af9a-efe77f7bd5e8">3</loigeNr>
   <kuvatavNr id="99102b51-16bf-40c4-84c8-9a7a98a7ed9c"><![CDATA[(3)]]></kuvatavNr>
   <sisuTekst id="b0004856-4bdc-45cd-9764-38ef92911bf7">
    <tavatekst id="795d0a1b-2ab4-4eae-9faf-f0f1c3972c13">Käesoleva paragrahvi lõikes 1 loetletud teenuste maksumuse piirmäära kinnitab Narva Linnavalitsus.</tavatekst>
   </sisuTekst>
  </loige></paragrahv><paragrahv id="para3">
   <paragrahvNr id="286bbcd6-55e5-4a30-918f-b39db18ab0c3">3</paragrahvNr>
   <kuvatavNr id="47813c4f-2c87-4182-8112-5705b7d6b5b1"><![CDATA[§ 3. ]]></kuvatavNr>
   <paragrahvPealkiri id="8c05a983-cd09-49e7-9ab5-925ed1d5726e">Vahendite taotlemine ja eraldamine</paragrahvPealkiri>
  <loige id="para3lg1">
   <loigeNr id="82a81d8f-ee86-41a7-a03b-84b2167df796">1</loigeNr>
   <kuvatavNr id="e4687cc7-ebce-4f36-aa1f-ada564264314"><![CDATA[(1)]]></kuvatavNr>
   <sisuTekst id="916a5d1e-4e22-40a9-bf64-9352ec650911">
    <tavatekst id="f48615a8-1b1e-49f1-90a9-f69db45a8727">Taotlus esitatakse igas taasesitatavas kirjalikus vormis (e-kiri jms) või kirjalikus vabas vormis.</tavatekst>
   </sisuTekst>
  </loige><loige id="para3lg2">
   <loigeNr id="e8bd6ddb-d26b-4e1f-9a79-7efb9db5f617">2</loigeNr>
   <kuvatavNr id="725ccd46-7534-4c42-a5e9-c29519ff4156"><![CDATA[(2)]]></kuvatavNr>
   <sisuTekst id="d8c27601-103b-4c62-8cf4-7e857d2acfb7">
    <tavatekst id="62c1886e-3875-4e81-9378-05e7b79e3778">Sotsiaalabiametil on õigus nõuda taotlejalt muid täiendavaid andmeid, dokumente või selgitusi taotluses esitatud andmete õigsuse tõendamiseks. Sotsiaalabiametil on põhjendatud vajaduse korral õigus teha päringuid andmete saamiseks läbi lastega tegelevate asutuste, STAR infosüsteemi ja muude infosüsteemide.</tavatekst>
   </sisuTekst>
  </loige><loige id="para3lg3">
   <loigeNr id="1fe51a21-b086-4279-8a98-921b57921bb5">3</loigeNr>
   <kuvatavNr id="b2f8462c-98ea-4069-982d-cb56459ab26e"><![CDATA[(3)]]></kuvatavNr>
   <sisuTekst id="1fcddcce-a384-459b-90a1-102311560665">
    <tavatekst id="e053d4f4-4350-4203-a079-302d2bd7411e">Sotsiaalteenuse vajadus hinnatakse lapsepõhiselt Sotsiaalabiameti poolt.</tavatekst>
   </sisuTekst>
  </loige><loige id="para3lg4">
   <loigeNr id="6f119e61-eeb8-40b4-804a-97193eb148ab">4</loigeNr>
   <kuvatavNr id="ab15f117-07ee-489e-a95d-3022b2d0b5a8"><![CDATA[(4)]]></kuvatavNr>
   <sisuTekst id="25682910-ac36-4a16-8839-39e97cf8d02d">
    <tavatekst id="496b376e-08c7-487f-bf46-36941089e97f">Sotsiaalabimeti direktor või tema poolt volitatud isik võtab vastu otsuse taotluse rahuldamise või rahuldamata jätmise kohta seaduses sätestatud korras.</tavatekst>
   </sisuTekst>
  </loige><loige id="para3lg5">
   <loigeNr id="d21a8dab-6788-4f12-a7e9-862fe0eec794">5</loigeNr>
   <kuvatavNr id="710c3506-c92f-4be3-abd2-d90d3018c5a4"><![CDATA[(5)]]></kuvatavNr>
   <sisuTekst id="a934decb-2d47-4854-a104-a5775e7e1ac3">
    <tavatekst id="f2ce8f4d-c86a-493c-a2a0-598b42e6b52d">Vahendeid eraldatakse teenuse osutaja arveldusarvele teenuse osutaja esitanud arve või teenuse osutajaga sõlmitud lepingu alusel.</tavatekst>
   </sisuTekst>
  </loige><loige id="para3lg6">
   <loigeNr id="e21c5d64-11c8-4bd7-a2ad-f8106a931ea9">6</loigeNr>
   <kuvatavNr id="900cc5c2-54b7-453f-b4ca-08fd35e8aafc"><![CDATA[(6)]]></kuvatavNr>
   <sisuTekst id="ef73cc5e-a2b5-490b-84bf-6e90cdd8c229">
    <tavatekst id="708b7123-0f32-48f5-8550-9d55731b5736">Teenuse osutaja on käesoleva määruse mõttes füüsilisest isikust ettevõtja või juriidiline isik, kelle tegevusala on otseselt seotud osutatava teenusega.</tavatekst>
   </sisuTekst>
  </loige><loige id="para3lg7">
   <loigeNr id="35c1998d-664a-4641-9155-3761de32f988">7</loigeNr>
   <kuvatavNr id="cea9b957-45d6-476c-9c0e-846227870753"><![CDATA[(7)]]></kuvatavNr>
   <sisuTekst id="5c428dae-02cc-4d11-9250-29899c4e8eed">
    <tavatekst id="9503378a-c727-4266-a541-792e9b15656f">Sotsiaalabiametil on õigus Narva Linnavalitsuse sotsiaalkomisjoni ettepanekul erandkorras määrata määruses nimetamata teenust.</tavatekst>
   </sisuTekst>
  </loige></paragrahv><paragrahv id="para4">
   <paragrahvNr id="1da0faf9-6832-41e8-9f00-f974c5d251e9">4</paragrahvNr>
   <kuvatavNr id="8dc870ff-86af-43c2-a9a8-ddb9549dce56"><![CDATA[§ 4. ]]></kuvatavNr>
   <paragrahvPealkiri id="c544fad8-90bf-452e-babf-d4556e0770fb">Rakendussätted</paragrahvPealkiri>
  <loige id="para4lg1">
   <loigeNr id="435155b1-2e68-4d09-8698-fe18d4c5b3ea">1</loigeNr>
   <kuvatavNr id="e6912684-8aef-4127-b1b3-16b7ffbcd356"><![CDATA[(1)]]></kuvatavNr>
   <sisuTekst id="d749691b-682d-4fb0-bb2f-ba49f8077a72">
    <tavatekst id="92a8a09a-4caf-4387-8d77-adb097de5003">Tunnistada kehtetuks Narva Linnavolikogu 18.05.2017 määrus nr 8 „Raske ja sügava puudega lastele sotsiaalteenuste rahastamiseks eraldatud vahendite kasutamise kord“.</tavatekst>
   </sisuTekst>
  </loige><loige id="para4lg2">
   <loigeNr id="73d2442a-db4a-48cf-868e-681ce7aa5ed3">2</loigeNr>
   <kuvatavNr id="86ed9828-8cf6-47ca-84b4-4b4eff040c20"><![CDATA[(2)]]></kuvatavNr>
   <sisuTekst id="9c9349d0-b7be-43cd-90f6-71a25a111f81">
    <tavatekst id="7909b94a-6080-446f-ba1e-84f03488d995">Määrus jõustub seadusega sätestatud korras.</tavatekst>
