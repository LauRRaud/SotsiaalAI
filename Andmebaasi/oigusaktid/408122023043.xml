					<sisuTekst id="bdf986d1-55c9-4357-b14c-e18d0bd697d6">
						<tavatekst id="799675c2-e1d2-477e-907b-0e1ea9f6675a">lepingupoole või teenuse saaja surma korral.</tavatekst>
					</sisuTekst>
				</alampunkt>
			</loige>
