				<sisuTekst id="a6d5ea26-ec97-428e-b007-bba70cd41e2e">
					<tavatekst id="0075b4ac-1372-44f5-b02b-64edd435923f">Leping lõpeb:</tavatekst>
				</sisuTekst>
				<alampunkt id="para10lg2p1">
					<alampunktNr id="c4aa835a-b507-45bb-9e92-6c73e81c171a">1</alampunktNr>
