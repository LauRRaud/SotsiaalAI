						<tavatekst id="c23806c6-d08c-4b33-a6f9-5259c26bd3cc">teenuse vajaduse äralangemisel;</tavatekst>
					</sisuTekst>
				</alampunkt>
				<alampunkt id="para10lg1p2">
					<alampunktNr id="bdee67fb-85ad-4483-b75c-6159ca12fca5">2</alampunktNr>
