			<pealkiri id="0afe9147-2b54-4e92-9d1d-80a60471b439"> Asendus- ja järelhooldusteenuse osutamise tingimused ja kord</pealkiri>
		</nimi>
	</aktinimi>
	<muutmismarge id="9d2f8c7e-cede-424d-ab45-9a34851375c0">
		<aktikuupaev id="7b5afe78-150c-4c3d-85f6-aef218362c43">2023-11-30</aktikuupaev>
		<avaldamismarge id="9b46daf3-ef1c-4eb3-82a0-f2dfd76da39a">
			<RTosa id="23aad15c-5dc3-456f-b3ed-5a6559404f59">RT IV</RTosa>
