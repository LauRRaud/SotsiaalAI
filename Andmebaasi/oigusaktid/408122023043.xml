		<paragrahv id="para11">
			<paragrahvNr id="6ca2aa8c-ad72-4c7d-b8bb-482ff82a293e">11</paragrahvNr>
			<kuvatavNr id="ed1e5e24-32bd-4f0a-a6ce-bc7b3efe66ff"><![CDATA[§ 11. ]]></kuvatavNr>
			<paragrahvPealkiri id="4031f815-f5e3-49c3-86e4-8e923978d3a0">Määruse rakendamine ja jõustumine</paragrahvPealkiri>
			<loige id="para11lg1">
				<loigeNr id="f2069b4c-8eb7-456c-91c3-e1822080cf34">1</loigeNr>
				<kuvatavNr id="6634337c-f34a-40ce-8420-b6ade19de3a4"><![CDATA[(1)]]></kuvatavNr>
				<sisuTekst id="4f0a1f46-aff6-4265-a2b7-1d22d20a6829">
					<tavatekst id="f2fd359a-dd66-4b32-af65-c3e92d630aa9">Enne 2018. aasta 1. jaanuari sõlmitud asenduskoduteenuse osutamise lepingud kehtivad edasi, need loetakse sõlmituks vallavalitsuse ja asendushooldusteenuse osutaja vahel ning nende sisu tuleb viia vastavusse sotsiaalhoolekande seaduse ja määruse nõuetega 2018. aasta 31. detsembriks.</tavatekst>
				</sisuTekst>
			</loige>
			<loige id="para11lg2">
				<loigeNr id="32120237-5612-427e-bc6c-9886e3bbfd60">2</loigeNr>
				<kuvatavNr id="950eb6ed-860b-488c-96b9-eaae5cda7976"><![CDATA[(2)]]></kuvatavNr>
				<sisuTekst id="6029d26c-6f4d-447a-9ac9-fb6951125b9e">
					<tavatekst id="1652bc94-cf39-4a9e-8ad4-e9b7522e5480">Määrust rakendatakse 1. jaanuarist 2018.</tavatekst>
				</sisuTekst>
			</loige>
			<loige id="para11lg3">
				<loigeNr id="dbc81c98-9a6a-4267-ade3-1b7c85344ba0">3</loigeNr>
				<kuvatavNr id="08cf592a-f4ac-4702-b4cd-cb60ebfe629e"><![CDATA[(3)]]></kuvatavNr>
				<sisuTekst id="eb9e6044-c230-484b-92b9-217c2d064adf">
					<tavatekst id="2c0dc65a-fbc9-4b18-acac-a917142daba0">Määrus jõustub kolmandal päeval pärast Riigi Teatajas avaldamist.</tavatekst>
				</sisuTekst>
			</loige>
		</paragrahv>
	</sisu>
