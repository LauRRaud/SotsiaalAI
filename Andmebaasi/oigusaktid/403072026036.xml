						<tavatekst id="df17bfbd-1ecd-4916-a0df-600564f28da7"> lapsehoiu- ja /või tugiisikuteenusele ja tagasi;</tavatekst>
					</sisuTekst>
				</alampunkt>
				<alampunkt id="para7lg4p2">
					<alampunktNr id="f002cf64-9d8b-4573-8d4c-64d31dec1e51">2</alampunktNr>
