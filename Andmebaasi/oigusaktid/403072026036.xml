					<sisuTekst id="8a6e4927-9759-4c00-b8a3-979fa5517e14">
						<tavatekst id="f0bf511e-c4fd-4360-8fcd-3d00070e7599"> avalikele teenuste kasutamiseks (sh rehabilitatsiooniteenus, sotsiaalteenused, koolivälised sündmused, huvitegevus jms); </tavatekst>
					</sisuTekst>
				</alampunkt>
