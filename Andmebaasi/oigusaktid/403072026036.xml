		<preambul id="572147b6-9eac-4f37-b67e-e69900c0bd1e">
			<tavatekst id="6c215cc8-1336-46e7-bb5b-f5fb68bf246d">Määrus kehtestatakse „Kohaliku omavalitsuse korralduse seaduse“ § 22 lõike 1 punkti 37 ja „Sotsiaalhoolekande seaduse“ § 14 lõike 1 alusel.</tavatekst>
		</preambul>
		<paragrahv id="para1">
			<paragrahvNr id="f5faa17e-00db-4f55-a503-570c2569dc52">1</paragrahvNr>
			<kuvatavNr id="4a0d35e2-3e5d-42b1-bc2a-41e4ea63be3a"><![CDATA[§ 1. ]]></kuvatavNr>
			<paragrahvPealkiri id="e8b5d696-c9bb-4c50-bfa7-d2f101b856b0">Üldsätted</paragrahvPealkiri>
			<loige id="para1lg1">
				<loigeNr id="5ab6c515-c9c9-4b40-b6e0-840a36880b37"/>
				<kuvatavNr id="30ca4b44-076f-4735-b2ca-bbdb7541450c"/>
				<sisuTekst id="3729b7dc-26eb-4488-ba8a-78c6e1f8a267">
					<tavatekst id="28ff5aa1-b9a5-4238-89ef-b8a25ba1d6b6"> Määrus reguleerib Sillamäe linna suure hooldus- ja abivajadusega lastele sotsiaalteenuste (edaspidi <i>sotsiaalteenused</i>) taotlemise tingimusi, korda ning rahastamist.</tavatekst>
				</sisuTekst>
				<muutmismarge id="faf6da79-4be2-435f-937f-301a990c1b7b">
