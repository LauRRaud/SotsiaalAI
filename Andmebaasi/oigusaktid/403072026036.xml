						<aktViide id="6ae353b9-8066-48f3-b70c-90c993433c4e">412092023012</aktViide>
					</avaldamismarge>
					<joustumine id="6a556283-f63d-42d4-a5fc-dc91081d091d">2023-09-15</joustumine>
				</muutmismarge>
			</loige>
		</paragrahv>
		<paragrahv id="para2">
			<paragrahvNr id="76a88b93-abc8-4ebe-95f6-ea2c0facc8e7">2</paragrahvNr>
			<kuvatavNr id="800063f2-c793-4834-ad0b-3a6887ad3a12"><![CDATA[§ 2. ]]></kuvatavNr>
			<paragrahvPealkiri id="a76f4102-1d9e-4a3a-86e6-21a6fe64ece6">Õigustatud isikud</paragrahvPealkiri>
			<loige id="para2lg1">
				<loigeNr id="26e158f3-fed8-43c0-bd69-cb5d9f7b5938"/>
				<kuvatavNr id="517e5b56-e507-4efe-9cfe-ab62f600d9f1"/>
				<sisuTekst id="9f940628-1c91-43fc-b609-298551df88cd">
					<tavatekst id="1fd710ed-5c48-41be-acef-853cecb23f15">Sotsiaalteenuste sihtgrupp on suure hooldus- ja abivajadusega lapsed vanuses 0-18 (k.a.), kui käesolevast määrusest ei tulene teisiti, kes vajavad käesoleva määruse §-s 3 nimetatud sotsiaalteenuseid ja kelle rahvastikuregistri järgne elukoht on Sillamäe linn.</tavatekst>
				</sisuTekst>
				<muutmismarge id="6f2d01f3-8431-4a67-bbcd-8418e405a70b">
					<avaldamismarge id="f8f30d27-eb8a-4d8b-b4e2-98b7e8d24e8d">
						<RTosa id="2b31fe68-8cdb-4bee-8872-da15df66252b">RT IV</RTosa>
