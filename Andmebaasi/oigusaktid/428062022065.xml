			<pealkiri id="82a85866-a0db-4d1e-8cbd-3836d49e40ed">Toimetulekutoetuse määramisel arvesse võetavate eluasemekulude piirmäärad</pealkiri>
		</nimi>
	</aktinimi>
	<muutmismarge id="e4b65ce3-8249-4449-b455-8d9b2080ff82">
		<aktikuupaev id="433b74cb-e6d2-44e5-9692-3da605d815c4">2022-06-16</aktikuupaev>
		<avaldamismarge id="71e54ea7-369f-4e56-885d-bcfffa3986dc">
			<RTosa id="97c61d99-3559-4495-8316-9aff57abfbe8">RT IV</RTosa>
			<avaldamineKuupaev id="589a328d-8bed-4f12-b83f-895c5b0a30b6">2022-06-28</avaldamineKuupaev>
