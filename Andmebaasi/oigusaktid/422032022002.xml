   </sisuTekst>
  </loige><loige id="para1lg7">
   <loigeNr id="aba4838e-478b-4ac4-bab6-58a4e7002675">7</loigeNr>
   <kuvatavNr id="14fd1070-0527-4f56-a69a-dd71fc5085a4"><![CDATA[(7)]]></kuvatavNr>
   <sisuTekst id="9da60e2d-6349-4cb0-9b9c-30a9bbd0bcab">
    <tavatekst id="d0e6b7f7-9ed8-4954-a578-7f76a6e367fb">kooli lõpetamise toetus 64 eurot;</tavatekst>
   </sisuTekst>
  </loige><loige id="para1lg8">
   <loigeNr id="405cb4d9-8e3d-4b2c-acd5-76e9efff3eca">8</loigeNr>
   <kuvatavNr id="726112e6-d894-4225-81b8-607ccfaa1b6d"><![CDATA[(8)]]></kuvatavNr>
   <sisuTekst id="3f6d8e8b-af20-40b0-82ff-6f8c118ad397">
