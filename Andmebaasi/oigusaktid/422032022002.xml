   <pealkiri id="3d14426b-17c3-46ca-8d6b-9d71815052ad">Sotsiaaltoetuste määra kinnitamine </pealkiri>
  </nimi>
 </aktinimi>
 <sisu id="344999b8-5bbc-4eed-8ea8-d15346bf3d1d"><preambul id="be5f9b18-f8fe-42b5-806e-f07a88d7da8e">
   <tavatekst id="4edc3649-89df-47ee-84ba-d22d82d5505b">Määrus kehtestatakse Sotsiaalhoolekandeseaduse § 14 lg 2, kohaliku omavalitsuse korralduse seaduse § 30 lg 1 p 2 ja Ruhnu Vallavolikogu määrusega nr 2 15.02. 2018 a. kinnitatud „Sotsiaalhoolekandelise abi andmise tingimused ja kord Ruhnu vallas“ § 12 lg 7, § 13 lg 2 p 1, § 14 lg 5, § 15 lg 1 alusel.</tavatekst>
  </preambul><paragrahv id="para1">
   <paragrahvNr id="064fbbdd-f0af-42a0-9ad9-11b016bf6dd7">1</paragrahvNr>
   <kuvatavNr id="93d48d30-a792-443e-8e28-10903a544670"><![CDATA[§ 1. ]]></kuvatavNr>
      <sisuTekst id="c6c457b5-4027-445e-95c9-2b40038b59f4">
    <tavatekst id="47f494c9-08c1-4a60-99a3-f4f8ad5f1151">Kinnitada sotsiaaltoetuste määrad alljärgnevalt :</tavatekst>
   </sisuTekst>
  <loige id="para1lg1">
   <loigeNr id="49f155b5-8821-4bd8-91ea-1235029aeabb">1</loigeNr>
   <kuvatavNr id="55d96a6a-0bec-4507-a782-f35c54ccc5bb"><![CDATA[(1)]]></kuvatavNr>
   <sisuTekst id="570ddb35-c0c2-41fa-9580-5fdec47a2cbf">
    <tavatekst id="2232dff7-32fb-484e-988d-a667c8b1e17c">sünnitoetus 500 eurot, mis makstakse kahes osas. 50% sünnitoetusest makstakse peale lapse sünni registreerimist ja 50% lapse ühe aastaseks saamisel, kui lapse elukoht rahvastikuregistri andmetel on Ruhnu vald;</tavatekst>
   </sisuTekst>
  </loige><loige id="para1lg2">
   <loigeNr id="2b1c47be-f0a9-4193-bb3d-18bb60ce11c8">2</loigeNr>
