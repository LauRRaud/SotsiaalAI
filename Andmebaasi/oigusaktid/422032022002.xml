   <sisuTekst id="b9d05017-c4a7-4646-808b-17c99a9a81f3">
    <tavatekst id="0e28c903-68c9-45cb-9e48-7e0deb486556">koolitoetus gümnaasiumi õpilasele 100 eurot;</tavatekst>
   </sisuTekst>
  </loige><loige id="para1lg4">
   <loigeNr id="c796bc66-26e4-4c84-9382-8649a2fe59b8">4</loigeNr>
