   <sisuTekst id="4cd8c708-50b0-48a2-893b-760221798e10">
    <tavatekst id="4d0ae59e-e617-422f-9f62-338a0c5c1a9f">koolitoetus üliõpilasele 50 eurot;</tavatekst>
   </sisuTekst>
  </loige><loige id="para1lg5">
   <loigeNr id="c42c8f5e-fd24-48f6-898c-c872b296813d">5</loigeNr>
