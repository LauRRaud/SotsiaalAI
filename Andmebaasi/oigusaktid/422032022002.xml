   </sisuTekst>
  </loige><loige id="para1lg6">
   <loigeNr id="95224e0b-0f35-4903-859c-8ed6be35f811">6</loigeNr>
   <kuvatavNr id="24f9e342-c1c0-44bd-bbb3-3fe1324d0cdc"><![CDATA[(6)]]></kuvatavNr>
   <sisuTekst id="c0325dcb-7edd-435f-8b25-e8915331271e">
