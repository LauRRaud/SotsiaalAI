   <pealkiri id="8d444ed1-34f9-48cb-827b-3845093b4839">Koduteenuste osutamise kord</pealkiri>
  </nimi>
 </aktinimi>
 <sisu id="75766c90-b1dd-461c-a71c-6b2408668ac1"><preambul id="3eda041f-cc8f-4ae6-94ae-480f0c1a7f03"><tavatekst id="b54ccf22-7e66-4092-b875-1c5a61535e7c">Määrus kehtestatakse kohaliku omavalitsuse korralduse seaduse § 6 lõike 1, § 22 lõike 1 punkti 5 ja sotsiaalhoolekande seaduse § 14 lõike 1 ning § 17 alusel.</tavatekst></preambul><paragrahv id="para1"><paragrahvNr id="9a824ac3-6617-48b7-ad34-8ab5f5cf6b76">1</paragrahvNr><kuvatavNr id="e49d12a2-b68c-453e-bd3c-96782dc50b70"><![CDATA[§ 1. ]]></kuvatavNr><paragrahvPealkiri id="f489e821-5238-4fa7-b64b-f668756db792">Üldsätted</paragrahvPealkiri><loige id="para1lg1"><loigeNr id="65d0b1d5-f159-4c18-a25f-2af339219232">1</loigeNr><kuvatavNr id="ac220b1e-e388-4b75-bf39-f918d54bc487"><![CDATA[(1)]]></kuvatavNr><sisuTekst id="20d18e97-08fc-4b38-b05a-5cafd50a51b2"><tavatekst id="fc9080a2-dd42-4058-9d4c-aba495939e1c">Määrusega sätestatakse täisealistele isikutele koduteenuse osutamise tingimused ja kord ning teenuste loetelu.</tavatekst></sisuTekst></loige><loige id="para1lg2"><loigeNr id="deeb41bf-1f92-4f2e-aad7-392e2ffc95c0">2</loigeNr><kuvatavNr id="b62046db-9206-4e0e-a27a-50b2525e1e9a"><![CDATA[(2)]]></kuvatavNr><sisuTekst id="712eedef-9ab6-491f-b030-b16cc09420bd"><tavatekst id="d76b8130-23e3-46e2-8cc6-fd30e9bac675">Koduteenus (edaspidi teenus) on täisealise isiku iseseisva ja turvalise toimetuleku tagamine kodustes harjumuspärastes tingimustes, säilitades ja parandades tema elukvaliteeti, mis seisneb isikule abi osutamises igapäevaeluks vajalike tegevuste läbiviimisel, eneseteenindusel ning asjaajamisel väljaspool tema eluruumi.</tavatekst></sisuTekst></loige><loige id="para1lg3"><loigeNr id="5178582f-3f1e-4188-acba-6d510e95690a">3</loigeNr><kuvatavNr id="4c5f90be-2636-44ca-93ab-b12e98c46f4c"><![CDATA[(3)]]></kuvatavNr><sisuTekst id="768fb48b-97b1-4d86-b5de-5c2b89d054a2"><tavatekst id="f9a695c4-e3b5-4454-8bb6-b0720ecd4836">Teenuse taotlemise avalduse, täisealise isiku hooldus- ja sotsiaalteenuste vajaduse hindamisvahendi (edaspidi hindamisvahend) ja lepingu vormid kinnitab Kastre Vallavalitsus (edaspidi vallavalitsus).</tavatekst></sisuTekst></loige></paragrahv><paragrahv id="para2"><paragrahvNr id="1dbe0a25-23df-49ce-a3eb-cb1b4b5ecd63">2</paragrahvNr><kuvatavNr id="b2098955-bdbd-4160-ac16-720cd61e8e53"><![CDATA[§ 2. ]]></kuvatavNr><paragrahvPealkiri id="80ec957a-3185-42e7-b990-3f64d4c6a4d1">Teenuse saajad</paragrahvPealkiri><loige id="para2lg1"><loigeNr id="3fe9bd0f-51b4-4645-a9d4-65fc18c70c97">1</loigeNr><kuvatavNr id="43c50917-a864-45d0-b5d9-808a713f02df"><![CDATA[(1)]]></kuvatavNr><sisuTekst id="33db04cb-4b96-4d79-9d82-181aa56ed03e"><tavatekst id="d5f02745-2ec8-4161-b747-bfe2cc75d2ff">Teenust saavad taotleda kõrvalabi vajavad täisealised isikud, kelle elukoht rahvastikuregistri andmetel on Kastre vald ja kelle tegelik elukoht on Kastre vald ning:</tavatekst></sisuTekst><alampunkt id="para2lg1p1"><alampunktNr id="45b89214-616a-4532-a360-b8d7d813b498">1</alampunktNr><kuvatavNr id="85f15992-a43f-48fa-af47-4783b81ca33c"><![CDATA[1) ]]></kuvatavNr><sisuTekst id="f6e6eeda-2394-45bf-9067-0404329e0bf2"><tavatekst id="4905c4ef-cce9-45a7-a4bd-4f84f763117f">kellel puuduvad seadusjärgsed ülalpidajad;</tavatekst></sisuTekst></alampunkt><alampunkt id="para2lg1p2"><alampunktNr id="de740254-264e-4267-9600-57f18b7f0b95">2</alampunktNr><kuvatavNr id="97a389d6-5193-46c7-b2e5-ec95d833960a"><![CDATA[2) ]]></kuvatavNr><sisuTekst id="a667a9e7-8255-4688-8f89-7365f1c472d0"><tavatekst id="03d4f10f-400a-4ae1-bf29-c638861b01ab">kellel on seadusjärgsed ülalpidajad, kuid ülalpidajad ei ole suutelised isikule hooldust tagama.</tavatekst></sisuTekst></alampunkt></loige><loige id="para2lg2"><loigeNr id="b7642abf-0357-4844-a171-784a6c06787e">2</loigeNr><kuvatavNr id="71d4610e-64ef-41e4-85d7-da9ec38541cd"><![CDATA[(2)]]></kuvatavNr><sisuTekst id="a9644b77-ea0f-4b3d-9003-9276f4f2e146"><tavatekst id="87cf6c2c-51de-4fe2-a1f2-36e5ef7cd567">Vallavalitsusel on õigus rahaliste vahendite olemasolu korral põhjendatud juhtudel ja kaalutlusotsuse alusel teha erandeid määrusega kehtestatud koduteenuste määramise tingimustes. Erandi tegemise otsustab vallavalitsus korraldusega.</tavatekst></sisuTekst></loige></paragrahv><paragrahv id="para3"><paragrahvNr id="1d908b6f-536b-44e0-bfb0-98964ffd4b65">3</paragrahvNr><kuvatavNr id="501a9eba-41c8-456d-b0dc-a9bacefeb0de"><![CDATA[§ 3. ]]></kuvatavNr><paragrahvPealkiri id="260242bd-7dcf-465e-b695-5dee573b1d94">Teenuse osutaja</paragrahvPealkiri><loige id="para3lg1"><loigeNr id="bdc9042f-43be-40dc-8f95-e02efc85056f">1</loigeNr><kuvatavNr id="dcbee1e1-ecca-40e2-b3d0-74b4d448081a"><![CDATA[(1)]]></kuvatavNr><sisuTekst id="3d594012-f345-4490-837a-08cab3d0a40d"><tavatekst id="66614bc8-06f9-40dc-a147-65a6a54bc300">Teenust osutab koduhooldustöötaja, kellel on vallavalitsusega sõlmitud tööleping.</tavatekst></sisuTekst></loige><loige id="para3lg2"><loigeNr id="4c1d394a-e3e8-4a61-b784-e7a994e5b1d4">2</loigeNr><kuvatavNr id="d5b5ee42-bbb0-4e28-9c07-7a86f7361d08"><![CDATA[(2)]]></kuvatavNr><sisuTekst id="16182b0c-a40f-4443-8291-035992d1d352"><tavatekst id="820b22f5-cadf-4e68-bf0c-1024e572789c">Koduhooldustöötaja lähtub teenuste osutamisel käesolevast korrast, oma töölepingust ja ametijuhendist, hindamisvahendist ja kliendiga sõlmitud lepingust.</tavatekst></sisuTekst></loige></paragrahv><paragrahv id="para4"><paragrahvNr id="f299f15f-1ce5-4d84-82b4-e3690923012c">4</paragrahvNr><kuvatavNr id="23e0d2e4-ee4f-4664-9806-d3d457de27bc"><![CDATA[§ 4. ]]></kuvatavNr><paragrahvPealkiri id="8625224b-91f5-4bb6-ac0b-d531eca08347">Teenuste loetelu ja sagedus</paragrahvPealkiri><loige id="para4lg1"><loigeNr id="4e80c405-f7ae-4004-92ff-9384584c7428">1</loigeNr><kuvatavNr id="89aa0902-e1d0-4a72-af03-884173025405"><![CDATA[(1)]]></kuvatavNr><sisuTekst id="2e68ddff-c7f5-4523-b07d-bfd20b44a310"><tavatekst id="4a1f52be-9bd0-45ef-9aca-cfdaff05d749">Koduteenuse osutamist korraldab vallavalitsus.</tavatekst></sisuTekst></loige><loige id="para4lg2"><loigeNr id="732c18ec-f416-4375-b9e9-59e8f0a9c076">2</loigeNr><kuvatavNr id="f05c1802-0039-4713-9cc9-1808183e62e4"><![CDATA[(2)]]></kuvatavNr><sisuTekst id="20b428f2-5c3a-4f73-b28d-01b5ee74947e"><tavatekst id="cb17e795-18e5-417c-a8d7-8bb7576a8101">Kastre vallas pakutavad koduteenused on:</tavatekst></sisuTekst><alampunkt id="para4lg2p1"><alampunktNr id="5b4e2937-c353-493e-bd01-e64fc40b3ff1">1</alampunktNr><kuvatavNr id="5b66be17-635e-43d0-98b8-8c7d0a63d1fe"><![CDATA[1) ]]></kuvatavNr><sisuTekst id="251a3b65-e7b8-4a35-b26d-cafa9fa92333"><tavatekst id="074d06d3-56b9-46ba-97a4-9e9f2c7a58ec">toiduainete, esmatarbekaupade, ravimitega varustamine lähimast müügikohast;</tavatekst></sisuTekst></alampunkt><alampunkt id="para4lg2p2"><alampunktNr id="1724b819-2ec1-4dfc-a7d8-bedf74c67034">2</alampunktNr><kuvatavNr id="ce66c11e-56b2-4be7-83bf-e6f96c8dec55"><![CDATA[2) ]]></kuvatavNr><sisuTekst id="97cf8edb-85e8-455e-b2ec-d1d32d3ad1ee"><tavatekst id="1dab9052-50aa-4001-ab73-b41d8a3fa6d6">abistamine toidu valmistamisel või valmistoiduga varustamine;</tavatekst></sisuTekst></alampunkt><alampunkt id="para4lg2p3"><alampunktNr id="0fa07a4c-3a0a-4361-b43f-4eb3327bae63">3</alampunktNr><kuvatavNr id="486b650f-bf35-4a85-a38d-d70302cc119a"><![CDATA[3) ]]></kuvatavNr><sisuTekst id="af096ee9-ad4c-4386-9855-89e6b9e8eac8"><tavatekst id="4a52b863-2bf8-47a6-a642-2c901caf99f0">abistamine esmavajalike eluruumide koristamisel abistatavale isikule kuuluvate vahenditega;</tavatekst></sisuTekst></alampunkt><alampunkt id="para4lg2p4"><alampunktNr id="4917c55e-cf42-4b5e-a3c1-08e8835ac0d9">4</alampunktNr><kuvatavNr id="7d4ac968-5b26-45f5-a0a9-9c61fd5a920d"><![CDATA[4) ]]></kuvatavNr><sisuTekst id="cad1fed1-7e4a-49dc-92ea-c728aae30c7b"><tavatekst id="1492ee58-2d2d-4cb4-9a3f-8a26c17fd025">kliendi pesemisvõimaluste korraldamine;</tavatekst></sisuTekst></alampunkt><alampunkt id="para4lg2p5"><alampunktNr id="b2d6b535-5bc4-4be5-b32e-141ac6b6fb68">5</alampunktNr><kuvatavNr id="3a46a3a5-7c6b-4299-b2a9-bfccdeb0ee87"><![CDATA[5) ]]></kuvatavNr><sisuTekst id="ac2f05fb-5837-4262-b261-31c8524de74e"><tavatekst id="aa0c4553-712a-4db9-87b4-6cc96b693ae2">pesu pesemise korraldamine;</tavatekst></sisuTekst></alampunkt><alampunkt id="para4lg2p6"><alampunktNr id="69c492be-3a2f-4b61-b068-47d8117298fb">6</alampunktNr><kuvatavNr id="d0198e61-f789-4f6c-90a9-857086561562"><![CDATA[6) ]]></kuvatavNr><sisuTekst id="311bd3ba-6d62-4ab5-8a09-dceb85a3c668"><tavatekst id="26add585-68de-4f59-bdd6-89cb61ab84d5">küttematerjaliga varustamise korraldamine;</tavatekst></sisuTekst></alampunkt><alampunkt id="para4lg2p7"><alampunktNr id="c9be0c3f-05fd-4c6e-95c9-d09f48af6d03">7</alampunktNr><kuvatavNr id="1c5807f0-5cfe-44ca-9a02-e88c57990a00"><![CDATA[7) ]]></kuvatavNr><sisuTekst id="35f9aad8-4de4-478f-8c0a-3d71553974e8"><tavatekst id="e33f1b82-198c-4d65-a4a7-c1f788c77172">küttematerjali eluruumi toomine ja tuha välja viimine;</tavatekst></sisuTekst></alampunkt><alampunkt id="para4lg2p8"><alampunktNr id="e22498a8-c9b9-4c5f-abac-b2289e6a72a1">8</alampunktNr><kuvatavNr id="69faec4c-92e2-45dd-a902-07bfc3a22b22"><![CDATA[8) ]]></kuvatavNr><sisuTekst id="babd176d-c701-4182-9732-ef812ab4e0b2"><tavatekst id="29f35694-1387-47e4-905b-26ff64be1112">vee tuppa toomine ja heitvee väljaviimine;</tavatekst></sisuTekst></alampunkt><alampunkt id="para4lg2p9"><alampunktNr id="b3a0cde4-2a40-4cbe-968e-7eb47dbc1e84">9</alampunktNr><kuvatavNr id="95af8f55-e8de-45a4-980b-23cb446ad4d9"><![CDATA[9) ]]></kuvatavNr><sisuTekst id="cbef4f19-2fea-4ceb-93f2-cd9729541c0c"><tavatekst id="47baee28-4bc7-46be-a756-6d619c146ee6">kommunaal- ja muude maksete tasumise korraldamine;</tavatekst></sisuTekst></alampunkt><alampunkt id="para4lg2p10"><alampunktNr id="ef6dd9f7-d41e-431b-b71a-18a95ebcc0ad">10</alampunktNr><kuvatavNr id="25b9d203-f75a-4a19-8393-cbe370c88844"><![CDATA[10) ]]></kuvatavNr><sisuTekst id="8bf85164-3a49-4e31-a4c5-4eb9746ad76f"><tavatekst id="a835855c-4dda-4723-983f-56439d5daa86">hooldus- ja abivahenditega varustamise korraldamine;</tavatekst></sisuTekst></alampunkt><alampunkt id="para4lg2p11"><alampunktNr id="a78494ee-4137-4c66-b02f-3d88d0bc299e">11</alampunktNr><kuvatavNr id="640b1544-4068-4344-9f13-0914841d02d7"><![CDATA[11) ]]></kuvatavNr><sisuTekst id="75f4d28d-523b-44c6-acea-84cd09308680"><tavatekst id="c6bd8847-5540-4e45-8fbc-75c841363f2d">abistamine arstiabi korraldamisel;</tavatekst></sisuTekst></alampunkt><alampunkt id="para4lg2p12"><alampunktNr id="42b2b6e5-20c7-43bb-828a-118a9be229bd">12</alampunktNr><kuvatavNr id="3830e5c7-aa85-48dd-96fa-460b7934953d"><![CDATA[12) ]]></kuvatavNr><sisuTekst id="fa650743-af1f-4d5a-ad15-9cb9d700a20b"><tavatekst id="f4d1211b-c847-4206-bfca-cb6a714933e7">transporditeenuse osutamine või korraldamine, vajadusel isiku saatmine meditsiini- ja avalikel teenustel;</tavatekst></sisuTekst></alampunkt><alampunkt id="para4lg2p13"><alampunktNr id="3930a4ba-9c0b-4667-bc6d-f3c4ac3cc316">13</alampunktNr><kuvatavNr id="4ea001dc-7bd6-4d58-898f-f4d2a23c7a00"><![CDATA[13) ]]></kuvatavNr><sisuTekst id="d319421b-d514-465f-8426-bfee17b6e248"><tavatekst id="0c60e725-966a-4b92-ba41-106f3322d609">muude sotsiaalteenuste korraldamine.</tavatekst></sisuTekst></alampunkt></loige><loige id="para4lg3"><loigeNr id="ba30dec3-0885-4881-9274-7e8d3683d9d5">3</loigeNr><kuvatavNr id="dd0debd7-10f6-4d2f-9a56-dc2ad3d86a19"><![CDATA[(3)]]></kuvatavNr><sisuTekst id="72b6bc3b-4447-484d-bd1a-8d7701eb5a81"><tavatekst id="01d75186-fb96-4490-8782-01f04a9a57ab">Eelpool nimetamata koduteenust osutatakse juhul, kui need on isiku toimetulekuks hädavajalikud.</tavatekst></sisuTekst></loige><loige id="para4lg4"><loigeNr id="ccff97ae-ffa9-4ab6-8c52-20d9a994e660">4</loigeNr><kuvatavNr id="40c3a589-80e6-4458-82bc-e68796909e2a"><![CDATA[(4)]]></kuvatavNr><sisuTekst id="0656db98-9015-4cbb-aa4f-6dbc7872de6d"><tavatekst id="1a10a146-49ba-465e-aa7b-b106e29a1f6b">Koduteenus ei sisalda abistamist remondi-, haljastus- ja aiatöödel, korrusmajade trepikodade koristamist, koduloomade eest hoolitsemist.</tavatekst></sisuTekst></loige><loige id="para4lg5"><loigeNr id="e49fcdb0-ac2c-495c-9678-6bbcf3fac9a0">5</loigeNr><kuvatavNr id="160a7ba1-7cdc-41b2-bbeb-b9c860b916ab"><![CDATA[(5)]]></kuvatavNr><sisuTekst id="dd8a0b20-6115-4a30-a43f-86859df86e97"><tavatekst id="8cf25452-c1db-41f5-92fd-c05d3875de02">Koduteenust osutatakse üldjuhul tööpäeviti.</tavatekst></sisuTekst></loige><loige id="para4lg6"><loigeNr id="bfed4098-070d-434c-b677-22570c4aee76">6</loigeNr><kuvatavNr id="0c40c72f-82ed-44ca-8efc-b2faddd5bc13"><![CDATA[(6)]]></kuvatavNr><sisuTekst id="5682ed40-6104-4d0e-b535-4118f86eb7e2"><tavatekst id="dc6f8e89-f43a-4761-86ab-c5ebe9f07b8b">Teenust osutatakse vastavalt lepingule. Üks kord nädalas kestusega kokku kuni 2 tundi, kaks korda nädalas kokku kuni 4 tundi, kolm korda nädalas kokku kuni 6 tundi, neli korda nädalas kokku kuni 8 tundi, viis korda nädalas kokku kuni 10 tundi.</tavatekst></sisuTekst></loige></paragrahv><paragrahv id="para5"><paragrahvNr id="1cbe7289-5a86-4bb6-b6ce-a71848a343c7">5</paragrahvNr><kuvatavNr id="aa7f0f61-51fe-4073-b8fc-f19a5c3c3270"><![CDATA[§ 5. ]]></kuvatavNr><paragrahvPealkiri id="213ec92b-c62f-4623-97d3-0402934b146f">Teenuse taotlemine</paragrahvPealkiri><loige id="para5lg1"><loigeNr id="feafd65e-b082-49ca-b55f-75e8826aeb78">1</loigeNr><kuvatavNr id="a667cc95-74a5-4655-95f5-bf6011a5f699"><![CDATA[(1)]]></kuvatavNr><sisuTekst id="5ba8eb43-802a-4744-ac2c-9775ac511def"><tavatekst id="a92b2015-41bd-41f9-9f0f-956f9c6c7729">Teenuse taotlemiseks esitab teenuse taotleja (edaspidi taotleja), tema lähedane või muu asjast huvitatud isik vallavalitsusele vormikohase avalduse, kus märgitakse järgnevad andmed:</tavatekst></sisuTekst><alampunkt id="para5lg1p1"><alampunktNr id="49334a79-286e-40ad-a3e1-238b7d5a3181">1</alampunktNr><kuvatavNr id="ca5bfc7e-7c0a-497d-ba5e-49a205aaa66f"><![CDATA[1) ]]></kuvatavNr><sisuTekst id="678ab20c-c155-4419-8800-a4c3704e5446"><tavatekst id="3c543322-df39-41bd-9319-c82cf210e22e">taotleja isikuandmed (nimi, isikukood, elukoht, kontaktandmed) ja sissetulekud;</tavatekst></sisuTekst></alampunkt><alampunkt id="para5lg1p2"><alampunktNr id="fa615141-d071-4199-8faf-3931034cbaa1">2</alampunktNr><kuvatavNr id="3397ffbc-2870-480c-9acd-38a1737a5874"><![CDATA[2) ]]></kuvatavNr><sisuTekst id="68b87416-d275-4103-adb6-bb9a77664af1"><tavatekst id="831500bc-0444-43a9-9438-7dc9ac4835db">taotleja kinnitus ülalpidamiskohustusega isikute olemasolu (lisatakse kontaktandmed) või puudumise kohta;</tavatekst></sisuTekst></alampunkt><alampunkt id="para5lg1p3"><alampunktNr id="dfb7d2d4-f41b-4e13-bbcd-89dce08a3f5c">3</alampunktNr><kuvatavNr id="dc13b8f2-ea9e-4996-bc5c-31ab2bac6761"><![CDATA[3) ]]></kuvatavNr><sisuTekst id="5bd88889-29d2-4fe5-bd25-4c8d7bab1d1b"><tavatekst id="8ac30cd4-f27d-460c-8fae-1420dd49265e">teenuste vajaduse põhjendus.<reavahetus/>Avaldusele lisatakse isikut tõendavad dokumendid, puude määramise otsus ja rehabilitatsiooniplaan (olemasolul).</tavatekst></sisuTekst></alampunkt></loige><loige id="para5lg2"><loigeNr id="9918806d-075a-4985-a3eb-b5f8e69baea9">2</loigeNr><kuvatavNr id="15ee5bea-1716-4f22-a9f4-33d710a90877"><![CDATA[(2)]]></kuvatavNr><sisuTekst id="4ac0de6f-da19-4d1f-bd1b-3fa849c83579"><tavatekst id="febaf4d0-f438-4ce6-85a9-4ed14565b095">Teenuse määramise vajaduse, sageduse ja mahu selgitamiseks teeb vallavalitsuse sotsiaaltööspetsialist koostöös koduhooldustöötajaga pärast kirjaliku avalduse laekumist 10 (kümne) tööpäeva jooksul kodukülastuse, hinnates hindamisvahendi alusel taotleja toimetulekuvõimet, kuulates ära taotleja ja tema lähedaste arvamuse.</tavatekst></sisuTekst></loige><loige id="para5lg3"><loigeNr id="a7ff10e4-56c7-4ae8-a6a4-2747e9ef709c">3</loigeNr><kuvatavNr id="cb4bed8d-4130-420e-bacd-76527b26ca1c"><![CDATA[(3)]]></kuvatavNr><sisuTekst id="450b1854-c1f9-46fc-9c2a-1071e4a94910"><tavatekst id="c0372ca1-0de4-41b9-a310-6883053b1608">Vallavalitsuse sotsiaalosakonna ametnikul on õigustaotlejalt vajadusel nõuda täiendavaid dokumente, kaasata kliendi olukorra selgitamiseks spetsialiste, teha koostööd kliendi perearstiga.</tavatekst></sisuTekst></loige></paragrahv><paragrahv id="para6"><paragrahvNr id="6520f227-7c1d-4d26-8dbf-b33a12429dc6">6</paragrahvNr><kuvatavNr id="0dcb723d-e9e5-473e-aee5-eaec63fce705"><![CDATA[§ 6. ]]></kuvatavNr><paragrahvPealkiri id="e477c525-85ed-44f3-8bee-4b82154a8fac">Teenuse määramine</paragrahvPealkiri><loige id="para6lg1"><loigeNr id="c11e1d31-f36b-4e83-a662-df7dca2fa89c">1</loigeNr><kuvatavNr id="20bd10bf-8b89-4b91-86d3-3cc0fb6bb8f2"><![CDATA[(1)]]></kuvatavNr><sisuTekst id="6ec073d1-67ee-4470-af4d-ca0b541e2f7b"><tavatekst id="2844568a-480f-4f78-8bc1-ca382e2a80b7">Teenuse osutamise või sellest keeldumise otsustab vallavalitsus ning teeb selle teenust taotlevale isikule teatavaks hiljemalt 10 (kümne) tööpäeva jooksul avalduse ja nõuetekohaste dokumentide esitamisest.</tavatekst></sisuTekst></loige><loige id="para6lg2"><loigeNr id="e8eb42dd-7e9e-45c4-a594-e96fa47479bf">2</loigeNr><kuvatavNr id="11cd8531-4c5f-4f1b-9b1b-dec04eeacde1"><![CDATA[(2)]]></kuvatavNr><sisuTekst id="10e4fa1a-b5e7-492b-8d23-61445a34f6a0"><tavatekst id="7da45f76-42b0-4555-852a-cb1be07732ee">Juhul kui teenuse osutamata jätmine põhjustab taotleja elule või tervisele ohtliku olukorra, osutatakse teenust koheselt ja dokumendid täidetakse hiljemalt 10 (kümne) tööpäeva jooksul.</tavatekst></sisuTekst></loige></paragrahv><paragrahv id="para7"><paragrahvNr id="fb5757de-e167-49bf-917d-4ff14d5758ca">7</paragrahvNr><kuvatavNr id="6c42922d-ec61-4b91-bce6-235999928740"><![CDATA[§ 7. ]]></kuvatavNr><paragrahvPealkiri id="535dc33c-0a89-4925-a41c-8d52cbe9453f">Lepingu sõlmimine</paragrahvPealkiri><loige id="para7lg1"><loigeNr id="2619224f-d24e-4c4a-8f85-6656ab2c9b19">1</loigeNr><kuvatavNr id="5489e58e-1993-421a-b33e-1cb2bb7c6594"><![CDATA[(1)]]></kuvatavNr><sisuTekst id="20e31d98-7ccf-4ee3-9307-87325be9f3f0"><tavatekst id="3ec9fcd9-6514-4730-8e96-7e3164a3a34b">Koduteenuse osutamiseks sõlmitakse vallavalitsuse ja koduteenust vajava isiku või tema seadusejärgse ülalpidamiskohustusega isiku vahel kirjalik koduteenuse osutamise leping (edaspidi leping). Lepingus sätestatakse isikule osutatavate teenuste sisu, maht ja tasu suurus ning poolte õigused ja kohustused.</tavatekst></sisuTekst></loige><loige id="para7lg2"><loigeNr id="625a23de-7d48-4256-a30b-f9b83b196d4e">2</loigeNr><kuvatavNr id="f8661afc-4bec-4846-b027-ed16b6baa42b"><![CDATA[(2)]]></kuvatavNr><sisuTekst id="12b20ec8-7f72-48d9-b870-280ecd1f6483"><tavatekst id="aa8b5103-f7d3-471e-928f-a2d79691aab9">Leping sõlmitakse tähtajaliselt kestusega kuni 1 aasta. Tähtaja saabumisel pikeneb leping automaatselt aasta võrra, kui lepingu osapool ei ole hiljemalt 10 (kümme) tööpäeva enne lepingu tähtaja saabumist teatanud kirjalikult soovist leping lõpetada.</tavatekst></sisuTekst></loige><loige id="para7lg3"><loigeNr id="c594f32d-b035-4691-bf6f-7c3913b67b65">3</loigeNr><kuvatavNr id="9717c4cd-2a07-4d2d-a077-c195e1359626"><![CDATA[(3)]]></kuvatavNr><sisuTekst id="ab8dd5e1-90ad-4855-862c-ba7adb002a8b"><tavatekst id="50623a99-d4de-40b0-97c7-2ba31d3e8319">Lepingu juurde kuuluvad taotleja avaldus, hindamisvahend, lepingu lisad ja muud asjakohased dokumendid.</tavatekst></sisuTekst></loige></paragrahv><paragrahv id="para8"><paragrahvNr id="294792a2-9c21-4b65-95c1-b753eefb0839">8</paragrahvNr><kuvatavNr id="188bb9ee-5bb7-4b2b-b825-1dcc0ea50d03"><![CDATA[§ 8. ]]></kuvatavNr><paragrahvPealkiri id="2de7574d-42f9-4d9c-9eae-13ef599762ca">Lepingu muutmine ja lõpetamine</paragrahvPealkiri><loige id="para8lg1"><loigeNr id="ffe61a12-9a73-4a97-94f4-2f7ad8547f3f">1</loigeNr><kuvatavNr id="8b80c4fc-3afb-4db2-af9d-bbdd1726bb27"><![CDATA[(1)]]></kuvatavNr><sisuTekst id="0ecedda0-cf95-4be4-ad80-106bc4770929"><tavatekst id="bdb0d793-14cd-42c7-8cee-5cdfe45a8c8f">Lepingut võib muuta ja lõpetada lepingupoolte kokkuleppel igal ajal, kui selleks tekib põhjendatud vajadus, teavitades sellest teisi lepingu osapooli vähemalt 5 tööpäeva ette. Täiendused ja muudatused fikseeritakse kirjalikult lepingu lisana ja kinnitatakse lepingupoolte allkirjadega.</tavatekst></sisuTekst></loige><loige id="para8lg2"><loigeNr id="7e9ada3f-92ae-47bd-94b7-f2a97959438c">2</loigeNr><kuvatavNr id="0aaa6858-e6d5-4a1d-aa2d-1394510bd140"><![CDATA[(2)]]></kuvatavNr><sisuTekst id="44082452-9fff-4196-ac68-b901b78eb278"><tavatekst id="76780f45-a520-4a16-b0f5-eb3cef29acf0">Leping vaadatakse üle lähtuvalt isiku vajaduste muutumisest.</tavatekst></sisuTekst></loige><loige id="para8lg3"><loigeNr id="a964b337-42df-43bf-8713-869b547b3e15">3</loigeNr><kuvatavNr id="6bade79e-9da3-4bf2-b1d4-f7fe6317a3e9"><![CDATA[(3)]]></kuvatavNr><sisuTekst id="018d5f36-2e7a-47f7-bf4f-a65b7d6ce06e"><tavatekst id="2fbf3bbe-9e46-40c0-a644-fcfec2391648">Leping lõpetatakse koduteenust vajava isiku soovi korral või kui on ära langenud teenuse osutamise vajadus.</tavatekst></sisuTekst></loige><loige id="para8lg4"><loigeNr id="983f6587-6939-4715-a81f-c0c92a32e36c">4</loigeNr><kuvatavNr id="843f184b-5ffb-4d04-b647-cb761d3949f9"><![CDATA[(4)]]></kuvatavNr><sisuTekst id="5fce1017-d023-44fa-be44-6193327227bd"><tavatekst id="94c1f89a-9829-4d4f-9f3a-153a16f5db50">Vallavalitsusel on õigus leping lõpetada:</tavatekst></sisuTekst><alampunkt id="para8lg4p1"><alampunktNr id="70d796dc-48f5-4799-b45e-5f425367690f">1</alampunktNr><kuvatavNr id="8c936e4a-c2ea-418b-a483-d1765d5e8bc3"><![CDATA[1) ]]></kuvatavNr><sisuTekst id="36304288-5ddc-4a08-9410-f48bbc798936"><tavatekst id="eba0daa8-4225-42ee-9a85-4f6d53622881">koduteenuse saaja asub elama teise kohaliku omavalitsuse haldusterritooriumile;</tavatekst></sisuTekst></alampunkt><alampunkt id="para8lg4p2"><alampunktNr id="fbd170b2-b622-4867-91c7-f0e0b3ef68ec">2</alampunktNr><kuvatavNr id="fedde8d7-fe65-4623-bbfa-a8f83f086908"><![CDATA[2) ]]></kuvatavNr><sisuTekst id="189162aa-d433-4034-a462-e1a57cda1a55"><tavatekst id="79a1f458-e66d-4fca-8dcc-d6666e247e06">koduteenuse saaja asub elama hoolekandeasutusse või on suunatud teisele sotsiaalteenusele;</tavatekst></sisuTekst></alampunkt><alampunkt id="para8lg4p3"><alampunktNr id="fe97b4c1-637c-4245-b04f-7189c4264525">3</alampunktNr><kuvatavNr id="b35c0998-5cb8-4d24-9712-9927ea856933"><![CDATA[3) ]]></kuvatavNr><sisuTekst id="f83b81d6-fa84-4e68-b114-03cecec313d7"><tavatekst id="23846d17-4972-4cb0-94b2-fcf8c25ef966">kui kliendi käitumine teeb võimatuks teenuse osutamise (agressiivsus, ebaviisakas käitumine, alkoholi või narkootiliste ainete kuritarvitamine vms).</tavatekst></sisuTekst></alampunkt></loige><loige id="para8lg5"><loigeNr id="f682a446-0afa-46cc-9915-3ebb640e0922">5</loigeNr><kuvatavNr id="107da029-9c4b-427f-8a38-47e7168032cf"><![CDATA[(5)]]></kuvatavNr><sisuTekst id="e1cf6e58-8eca-4095-a50d-ce6c2269df00"><tavatekst id="1bb7752d-ae35-44b1-a27a-18ccbd6a1eaa">Leping lõpetatakse vallavalitsuse korraldusega.</tavatekst></sisuTekst></loige></paragrahv><paragrahv id="para9"><paragrahvNr id="9b424687-e947-4a26-bc1e-121fb8c010a3">9</paragrahvNr><kuvatavNr id="dc7b5a20-49a3-4806-818d-82e610329a80"><![CDATA[§ 9. ]]></kuvatavNr><paragrahvPealkiri id="dbbb1b90-58d3-41c5-9ca3-314e78ef2f3b">Teenuse eest tasumine</paragrahvPealkiri><loige id="para9lg1"><loigeNr id="d2306685-3cc1-40b4-8634-0d250c20f075">1</loigeNr><kuvatavNr id="12bbcc37-e482-4f5f-b4ce-39f6a717f4bf"><![CDATA[(1)]]></kuvatavNr><sisuTekst id="aefe6f32-3957-472c-92b3-2fcd2ebf113c"><tavatekst id="d71abf06-5404-459b-b69a-bcbb03bd6dc6">Teenus on teenuse saajale tasuline.</tavatekst></sisuTekst></loige><loige id="para9lg2"><loigeNr id="15ca142b-b41e-44a5-a56a-e92c1d22b9c3">2</loigeNr><kuvatavNr id="5099b868-d4f6-414f-b238-cba9beb3f620"><![CDATA[(2)]]></kuvatavNr><sisuTekst id="798eb0e2-51dc-4590-8c6e-d871820a20ae"><tavatekst id="8c037f3b-5b85-4761-a733-2ca5bdcd4988">Vallavalitsusel on õigus põhjendatud otsusega vabastada isik teenuse eest tasumisest, arvestades teenust saava isiku sissetulekuid, seadusjärgsete ülalpidajate olemasolu ja nende sissetulekuid, teenuse kasutamise põhjust ning muid juhtumiga seotud asjaolusid.</tavatekst></sisuTekst></loige><loige id="para9lg3"><loigeNr id="082c8ab1-121b-476a-a77d-ad91f2fb5888">3</loigeNr><kuvatavNr id="6caaff78-5e7b-4985-8800-1c584667c961"><![CDATA[(3)]]></kuvatavNr><sisuTekst id="53abc0cb-56f0-47f4-9c01-2940827e43d1"><tavatekst id="cebbe332-7f59-4a37-bc44-0afb150fef96">Teenuse tasust vabastamiseks tuleb vallavalitsusele lisaks avaldusele täiendavalt esitada taotleja ja seadusjärgsete ülalpidajate olemasolul seadusjärgsete ülalpidajate sissetulekuid ning väljaminekuid tõendavad dokumendid.</tavatekst></sisuTekst></loige><loige id="para9lg4"><loigeNr id="8ef26acc-c381-4c90-95f1-9fc059f3f523">4</loigeNr><kuvatavNr id="c19f906d-a852-41ed-a529-abe40c3ce163"><![CDATA[(4)]]></kuvatavNr><sisuTekst id="eaadfc4f-94c8-49ab-8d3e-a9d873a3824a"><tavatekst id="0471ce0f-5d0c-459f-9ca9-597be850f380">Teenuse tasu ei rakendata isikutel, kelle igakuine keskmine netosissetulek on:</tavatekst></sisuTekst><alampunkt id="para9lg4p1"><alampunktNr id="ae007cd0-127e-4d87-9ef6-19b357981605">1</alampunktNr><kuvatavNr id="7042c4b2-1381-4a90-b78b-bf7349daaa78"><![CDATA[1) ]]></kuvatavNr><sisuTekst id="5cb35940-98af-4535-8cf0-3e2d23f2e5e5"><tavatekst id="38b3a2f7-6693-4dc2-925c-07c573b91db0">üksi elavatel isikutel ja esimesel pereliikmel alla riiklikult kehtestatud toimetulekupiiri 3-kordset määra ning igal järgneval pereliikmel alla riiklikult kehtestatud toimetulekupiiri 2-kordset määra ja</tavatekst></sisuTekst></alampunkt><alampunkt id="para9lg4p2"><alampunktNr id="6ba70329-c37a-46bc-8dc8-ccc9df75367b">2</alampunktNr><kuvatavNr id="416e8b3c-cbc4-4578-af71-eecf2038c6d8"><![CDATA[2) ]]></kuvatavNr><sisuTekst id="71c8b8f2-56b4-4782-96c4-bd61c7b2efd1"><tavatekst id="3faacff9-d7fc-4675-8c7a-7593d26fa75f">kellel puuduvad seadusjärgsed ülalpidamiskohustusega isikud.</tavatekst></sisuTekst></alampunkt></loige><loige id="para9lg5"><loigeNr id="085af549-afd2-4c21-8eca-5f440e17b24b">5</loigeNr><kuvatavNr id="26701130-d2fe-41b1-8b8d-1093e472d93c"><![CDATA[(5)]]></kuvatavNr><sisuTekst id="5237cd47-f9ea-4233-a928-24472b25b104"><tavatekst id="1f3eba43-77a4-4461-b611-442c01a37dad">Koduteenuse hinna kehtestab vallavalitsus.</tavatekst></sisuTekst></loige></paragrahv><paragrahv id="para10"><paragrahvNr id="cd03aab4-1bda-48ed-ad27-34bd25ae4e81">10</paragrahvNr><kuvatavNr id="8d4493e5-b381-4b76-a865-e054be942e5c"><![CDATA[§ 10. ]]></kuvatavNr><paragrahvPealkiri id="9c6d69a2-ab07-4277-a89b-3407cc9332e0">Järelevalve ja vastutus</paragrahvPealkiri><loige id="para10lg1"><loigeNr id="d3ef1297-99d5-4b09-8e1b-543bc13180c3">1</loigeNr><kuvatavNr id="2a30b248-219e-4997-ba9a-5b9a66a15b2f"><![CDATA[(1)]]></kuvatavNr><sisuTekst id="4f97d42b-df51-424c-bbe0-d9f5058403a7"><tavatekst id="f366ad06-1e99-45c0-8172-0b4374ca0460">Koduteenuse korraldamise eest vastutab sotsiaalosakonna juhataja.</tavatekst></sisuTekst></loige><loige id="para10lg2"><loigeNr id="96903dc4-8847-4594-9d17-e73395d27f36">2</loigeNr><kuvatavNr id="d923b45c-1312-41d2-898f-aaebaf71131f"><![CDATA[(2)]]></kuvatavNr><sisuTekst id="619d7cea-3008-4990-9e2c-d5eb5768cc32"><tavatekst id="21fbfdfd-6cfe-457d-8d22-93ff247819df">Järelevalvet teenuste nõuetekohase osutamise üle teostab sotsiaaltöö peaspetsialist.</tavatekst></sisuTekst></loige></paragrahv><paragrahv id="para11"><paragrahvNr id="3372e4e8-ca23-43b4-bfc7-5f7274d790cb">11</paragrahvNr><kuvatavNr id="025bbafa-75c2-42aa-9f44-ca417c1e0fb9"><![CDATA[§ 11. ]]></kuvatavNr><paragrahvPealkiri id="3e75d137-6fd0-4abc-89bd-80ec0921d379">Rakendussätted</paragrahvPealkiri><loige id="para11lg1"><loigeNr id="bf5cec30-f20b-4015-b5e4-574b7c4e4453">1</loigeNr><kuvatavNr id="ae572c0e-f40d-41ba-bd89-4e18ab2f8689"><![CDATA[(1)]]></kuvatavNr><sisuTekst id="d03f44af-a81f-4cd1-9abc-efed60e0d25f"><tavatekst id="7160bae6-abb0-415e-a42c-d44677ce16e1">Enne käesoleva määruse jõustumist tehtud koduteenuse osutamise otsused vaadatakse üle hiljemalt kahe kuu jooksul.</tavatekst></sisuTekst></loige><loige id="para11lg2"><loigeNr id="674f8a7a-88fb-4e67-93d2-6994463947d0">2</loigeNr><kuvatavNr id="5a75c75c-2d1a-41ef-8657-3f8cdd6c07c9"><![CDATA[(2)]]></kuvatavNr><sisuTekst id="8d68bd1e-1b3c-4897-a63f-9892e8719d9d"><tavatekst id="d6298160-7af3-4d39-a542-e863f74644f2">Tunnistada kehtetuks:</tavatekst></sisuTekst><alampunkt id="para11lg2p1"><alampunktNr id="8b1a8a97-6e3b-4adb-bb83-5c3bb557bcb2">1</alampunktNr><kuvatavNr id="e8249a19-0999-418b-beed-5f56a4ecb9e7"><![CDATA[1) ]]></kuvatavNr><sisuTekst id="133505f1-1112-4fc1-80e3-ddf861eb2b63"><tavatekst id="779d9206-f086-4d09-889e-16bca44ead0a"> Haaslava Vallavolikogu 22.12.2016 määrus nr 50 „Koduteenuste loetelu ning nende osutamise tingimused ja kord“;</tavatekst></sisuTekst></alampunkt><alampunkt id="para11lg2p2"><alampunktNr id="590a3b6a-0b67-4029-8aca-3c9db33aeda0">2</alampunktNr><kuvatavNr id="fa6c5ca1-2b79-43fb-92de-3d773876a683"><![CDATA[2) ]]></kuvatavNr><sisuTekst id="ceae6706-99d4-4517-ab5d-106498864b42"><tavatekst id="78b44fb8-04aa-48fa-9b77-ac43c7aa6055"> Mäksa Vallavolikogu 28.03.2016 määrus nr 14 „Koduteenuse osutamise tingimused ja kord“;</tavatekst></sisuTekst></alampunkt><alampunkt id="para11lg2p3"><alampunktNr id="b968d62e-4b3d-407f-a099-6f3fbbd546b3">3</alampunktNr><kuvatavNr id="b886fc54-8ac9-4b6f-aef3-f24c16e9e432"><![CDATA[3) ]]></kuvatavNr><sisuTekst id="f02cb3cc-3993-4b03-8ac8-ff5c163263b0"><tavatekst id="e09c493c-527c-4252-a569-85177e39060a"> Võnnu Vallavolikogu 24.03.2016 määrus nr 7 „Koduteenuse osutamise kord Võnnu vallas“.</tavatekst></sisuTekst></alampunkt></loige><loige id="para11lg3"><loigeNr id="f0332275-3fea-46a3-b879-9e623a4ed03c">3</loigeNr><kuvatavNr id="cc860701-8d93-4861-b7e8-e3c7ae8af3fc"><![CDATA[(3)]]></kuvatavNr><sisuTekst id="a4210c99-1057-4e9f-86d6-3488a305a405"><tavatekst id="220a67b1-c6ce-49a6-ae59-f424a74865db">Määrus jõustub kolmandal päeval pärast avaldamist Riigi Teatajas.</tavatekst></sisuTekst></loige></paragrahv></sisu>
