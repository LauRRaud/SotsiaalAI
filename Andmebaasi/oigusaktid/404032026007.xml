	<sisu id="027af31f-2700-40c6-a671-4f5218876ec8">
		<preambul id="cdf429ea-5c37-4b42-936c-13dc7c5154b3">
			<tavatekst id="bf00930c-fac8-47cb-a87d-31ef0f9ba991">Määrus kehtestatakse kohaliku omavalitsuse korralduse seaduse § 30 lõike 1 punkti 2, sotsiaalhoolekande seaduse § 14 lõike 2 ja § 133 lõike 6 ning Anija Vallavolikogu 22.01.2026. a määruse nr 5 „Sotsiaalhoolekandelise abi andmise kord“ § 11 lõike 3, § 55 lõike 5 ja § 77 lõike 3 alusel.</tavatekst>
		</preambul>
		<paragrahv id="para1">
			<paragrahvNr id="d8cbf263-003d-43b0-812b-26f01d73fa1c">1</paragrahvNr>
			<kuvatavNr id="92f0894c-c308-4a70-a7d9-e88f8f10adcf"><![CDATA[§ 1. ]]></kuvatavNr>
			<paragrahvPealkiri id="e4fb861c-ac10-41a1-83c4-63c5c6b5c8f6">Sissetulekust mittesõltuvate sotsiaaltoetuste määrad</paragrahvPealkiri>
			<loige id="para1lg1">
				<loigeNr id="ac5aea8f-c376-4145-ae55-a7ee3416a78f">1</loigeNr>
				<kuvatavNr id="9836efe3-21b7-4693-be62-6bae21538f3c"><![CDATA[(1)]]></kuvatavNr>
				<sisuTekst id="3c78b129-f7f1-499a-b981-bb16cccfbdd2">
					<tavatekst id="317f2fd3-4c75-467c-9441-2f63c028426e">Sissetulekust mittesõltuvate toetuste määrad on järgmised:</tavatekst>
				</sisuTekst>
				<alampunkt id="para1lg1p1">
					<alampunktNr id="56017fb6-b8de-4232-819a-6cfd179e0af6">1</alampunktNr>
					<kuvatavNr id="6cc5809f-712e-4851-8a2e-6ce3a358547d"><![CDATA[1) ]]></kuvatavNr>
					<sisuTekst id="bb553fb3-abff-4c2a-bd59-325468126def">
						<tavatekst id="5cfc8965-cf0f-49a0-bde5-e578fd98df5e">lapse sünnitoetuse suurus on kuni 1200 eurot ühe lapse eest;</tavatekst>
					</sisuTekst>
				</alampunkt>
				<alampunkt id="para1lg1p2">
					<alampunktNr id="21d52bd2-282a-4b0f-a011-e5d23d8908b5">2</alampunktNr>
					<kuvatavNr id="07dc487e-ea9d-493c-842e-d8ef84383d7f"><![CDATA[2) ]]></kuvatavNr>
					<sisuTekst id="5f3e070c-3074-40fa-922d-903566275cec">
						<tavatekst id="b83db567-96a5-4bc0-a4e7-fb3911b84918">ranitsatoetuse suurus on 150 eurot;</tavatekst>
					</sisuTekst>
				</alampunkt>
				<alampunkt id="para1lg1p3">
					<alampunktNr id="26d6eec4-8c4d-4d81-a5da-e9b08eb3be57">3</alampunktNr>
					<kuvatavNr id="8edb40bd-59d3-4641-9bfd-04ce43d56a9c"><![CDATA[3) ]]></kuvatavNr>
					<sisuTekst id="fecb1c96-5adc-4a05-90a0-7ed8c992d46e">
						<tavatekst id="40b4737e-1957-460b-be48-d2ec9483861f">matusetoetuse suurus on 250 eurot;</tavatekst>
					</sisuTekst>
				</alampunkt>
				<alampunkt id="para1lg1p4">
					<alampunktNr id="735058a9-2673-49dd-a209-2848ac2ace8d">4</alampunktNr>
					<kuvatavNr id="b051134b-100f-41dc-a094-2e46d70a7e5b"><![CDATA[4) ]]></kuvatavNr>
					<sisuTekst id="01b62edd-d05d-46e1-8c7d-de51a547fd09">
						<tavatekst id="a2557bc3-0cab-46e4-b1c6-8cb96abd06c9">eakate sünnipäevatoetus on 80., 85., 90., 95. sünnipäeva puhul 50 eurot ja alates 100. sünnipäevast iga juubeli puhul 100 eurot;</tavatekst>
					</sisuTekst>
				</alampunkt>
				<alampunkt id="para1lg1p5">
					<alampunktNr id="5703b9e6-e751-4dfc-954f-89abd64bf692">5</alampunktNr>
					<kuvatavNr id="31d960f2-5e29-44e9-b49b-f85002a16ce5"><![CDATA[5) ]]></kuvatavNr>
					<sisuTekst id="1fac0e47-d2e8-47df-8b2f-1e4980645d3e">
						<tavatekst id="b1633a68-38a4-4161-901c-edabf0ab8a3d">hooldajatoetus madalama hooldusvajadusega puudega lapse või täisealise isiku hooldajale on 40 eurot ühes kalendrikuus;</tavatekst>
					</sisuTekst>
				</alampunkt>
				<alampunkt id="para1lg1p6">
					<alampunktNr id="76814575-863d-4389-8310-4518b9636ed1">6</alampunktNr>
					<kuvatavNr id="0d3d440d-c2c7-423f-a501-9e4f332d0e9f"><![CDATA[6) ]]></kuvatavNr>
					<sisuTekst id="5b6ead20-9c12-4a16-889a-8c6b8e04eb71">
						<tavatekst id="e88ecc8a-b762-41fc-8370-ee038cae2bbd">hooldajatoetus kõrgema hooldusvajadusega puudega lapse või täisealise isiku hooldajale on 60 eurot ühes kalendrikuus;</tavatekst>
					</sisuTekst>
				</alampunkt>
				<alampunkt id="para1lg1p7">
					<alampunktNr id="1e765d5d-b26f-4889-9f25-5bb4f744a290">7</alampunktNr>
					<kuvatavNr id="21662fa3-dd97-4f9a-99f1-5ca41684838e"><![CDATA[7) ]]></kuvatavNr>
					<sisuTekst id="8c2660c2-c00f-4677-a627-71b3c4b037ae">
						<tavatekst id="15917e47-d0e1-4be3-9e75-a8b2e30fb937">Anija valla eestkostel või järelhooldusteenusel oleva lapse sünnipäevatoetus on 30 eurot;</tavatekst>
					</sisuTekst>
				</alampunkt>
				<alampunkt id="para1lg1p8">
					<alampunktNr id="a8cf1000-a8ea-49ee-921c-2260594e812f">8</alampunktNr>
					<kuvatavNr id="58c63d78-74b0-4036-a044-c2a69db46d83"><![CDATA[8) ]]></kuvatavNr>
					<sisuTekst id="4d4bea80-7491-48eb-8476-0a59ea072a8c">
						<tavatekst id="8b63a5bd-2f76-4421-a2d0-cdd88cdc48c9">õpilase sõidutoetuse piirmäär ühistranspordi kasutamisel on 35 eurot kalendrikuus;</tavatekst>
					</sisuTekst>
				</alampunkt>
				<alampunkt id="para1lg1p9">
					<alampunktNr id="34717f54-07fa-467a-91d8-11854032ac12">9</alampunktNr>
					<kuvatavNr id="5fcf1277-15af-4d8b-aef1-c7dd1ff5c527"><![CDATA[9) ]]></kuvatavNr>
					<sisuTekst id="d87de614-632e-4a06-b156-d1029fb68aa5">
						<tavatekst id="9aa69c34-615c-4221-aa64-78deec905f01">õpilase sõidutoetuse piirmäär pere sõiduautot kasutades on 0,15 eurot kilomeetri kohta.</tavatekst>
					</sisuTekst>
				</alampunkt>
			</loige>
			<loige id="para1lg2">
				<loigeNr id="f7091046-61e9-4bbb-8a1c-a66391345c6b">2</loigeNr>
				<kuvatavNr id="be3a4bc6-e9e5-4814-b114-a78b631b044d"><![CDATA[(2)]]></kuvatavNr>
				<sisuTekst id="ad9f2158-9142-48d0-8ce4-84bb6c882641">
					<tavatekst id="a7449900-25d5-4f8b-a253-4382f5b14028"> Lapse sünnitoetust makstakse alates 01.01.2026 sündinud lapse eest kuni kolmes osas:</tavatekst>
				</sisuTekst>
				<alampunkt id="para1lg2p1">
					<alampunktNr id="b70863a6-4327-4ec4-a4ec-e524d3f33d66">1</alampunktNr>
					<kuvatavNr id="cf78a5ea-7050-4860-99ee-89572f1442db"><![CDATA[1) ]]></kuvatavNr>
					<sisuTekst id="a6cb078c-bbc0-4204-a27f-602374570e14">
						<tavatekst id="99013fcc-b1e1-41f6-b8a3-4d54994ad196">400 eurot pärast lapse sünni registreerimist, kui mõlema vanema või üksikvanema elukoht rahvastikuregistris on lapse sündimisel ja sünni registreerimisel Anija vald;</tavatekst>
					</sisuTekst>
				</alampunkt>
				<alampunkt id="para1lg2p2">
					<alampunktNr id="32a4c2e6-71d7-4882-80c3-48fd2068c1a3">2</alampunktNr>
					<kuvatavNr id="3161c029-795f-41bc-8d2f-09bc0caf37bb"><![CDATA[2) ]]></kuvatavNr>
					<sisuTekst id="330429ba-6b1e-47a4-908a-dbc975bb5d8e">
						<tavatekst id="d8ab1ea2-3688-4511-b377-3928815c90d8">200 eurot pärast lapse sünni registreerimist, kui ainult ühe vanema elukoht rahvastikuregistris on lapse sündimisel ja sünni registreerimisel Anija vald;</tavatekst>
					</sisuTekst>
				</alampunkt>
				<alampunkt id="para1lg2p3">
					<alampunktNr id="f15e5905-ba41-4fad-b674-385aba5a301a">3</alampunktNr>
					<kuvatavNr id="085cb4f0-bf7a-4cb9-bfe2-87da0d647f80"><![CDATA[3) ]]></kuvatavNr>
					<sisuTekst id="3d5663dc-c4db-4111-9450-decf904c2d0f">
						<tavatekst id="f0390d49-778a-4c6a-a580-6a2d923ea3c0">400 eurot pärast lapse üheaastaseks saamist tingimusel, et laps ja tema vanemad või üksikvanem on rahvastikuregistri andmetel Anija valla elanikud lapse üheaastaseks saamisel;</tavatekst>
					</sisuTekst>
				</alampunkt>
				<alampunkt id="para1lg2p4">
					<alampunktNr id="84f5c961-be9d-4edc-87a8-934afe05bf81">4</alampunktNr>
					<kuvatavNr id="68bc8769-af7c-4d96-818e-2bc4b1d0d054"><![CDATA[4) ]]></kuvatavNr>
					<sisuTekst id="749e0308-7b91-4712-8eda-575f93c5a1ac">
						<tavatekst id="ba560438-d609-4ba1-93f5-5aa2b9a182a8">200 eurot pärast lapse üheaastaseks saamist tingimusel, et laps ja tema üks vanem on rahvastikuregistri andmetel Anija valla elanikud lapse üheaastaseks saamisel;</tavatekst>
					</sisuTekst>
				</alampunkt>
				<alampunkt id="para1lg2p5">
					<alampunktNr id="ba559762-c824-40be-8f1b-ac0ee7358ba5">5</alampunktNr>
					<kuvatavNr id="dea02327-9f10-4066-82c5-af07b81d53eb"><![CDATA[5) ]]></kuvatavNr>
					<sisuTekst id="a490d307-15a9-434f-bfae-95d4187f684b">
						<tavatekst id="20bd006d-a409-478b-a3e0-fb711eb423b6">400 eurot pärast lapse kaheaastaseks saamist tingimusel, et laps ja tema vanemad või üksikvanem on rahvastikuregistri andmetel Anija valla elanikud lapse kaheaastaseks saamisel;</tavatekst>
					</sisuTekst>
				</alampunkt>
				<alampunkt id="para1lg2p6">
					<alampunktNr id="d9dcfb17-6b1a-4a6b-947f-2c3574ccf935">6</alampunktNr>
					<kuvatavNr id="1330338e-9869-4b86-8f36-0556b5801774"><![CDATA[6) ]]></kuvatavNr>
					<sisuTekst id="180c3764-989d-42e8-a9b2-f1bb92510958">
						<tavatekst id="51cd2c4f-6f17-4cce-a7bf-9dade3a26c45">200 eurot pärast lapse kaheaastaseks saamist tingimusel, et laps ja tema üks vanem on rahvastikuregistri andmetel Anija valla elanikud lapse kaheaastaseks saamisel.</tavatekst>
					</sisuTekst>
					<muutmismarge id="f963f544-e6ea-4472-bf4c-e7340d5d01b3">
					<avaldamismarge id="7b5a8a5c-6eee-4652-a964-96fdd70ddd5b">
						<RTosa id="8c26b509-16fc-4549-b12b-63b57545502a">RT IV</RTosa>
						<avaldamineKuupaev id="c6cdb2a0-32fd-44c9-bfa3-7d0beecfa9dd">2026-03-04</avaldamineKuupaev>
						<RTartikkel id="db323a4c-9fc5-4ee2-b17a-8473495953dd">6</RTartikkel>
						<aktViide id="37354e48-12a0-4619-be9d-35b2c58f28d7">404032026006</aktViide>
					</avaldamismarge>
					<joustumine id="a2fc1b90-c023-42b7-8316-c050655cc920">2026-03-07</joustumine>
					<aktiNr id="7fc95a8b-692a-4657-ae1a-ab182fe49660">4</aktiNr>
					<tavatekst id="7fc5d68c-038c-479c-9cb6-1add14a2b495">, rakendatakse 01.01.2026</tavatekst>
				</muutmismarge>
				</alampunkt>
			</loige>
		</paragrahv>
		<paragrahv id="para2">
			<paragrahvNr id="f6909681-7776-41f9-944f-d2e6e20ccff0">2</paragrahvNr>
			<kuvatavNr id="76c36742-54f5-4ed0-a222-aff3afa6ee74"><![CDATA[§ 2. ]]></kuvatavNr>
			<paragrahvPealkiri id="acd89ea3-fa18-44aa-990e-ec707d1e3ff8">Sissetulekust sõltuvate sotsiaaltoetuste määrad</paragrahvPealkiri>
			<loige id="para2lg1">
				<loigeNr id="d5223a2a-d333-494e-9200-6a2ae96dbe35"/>
				<kuvatavNr id="40ddbf20-ff62-420e-9407-79b807e03259"/>
				<sisuTekst id="a616770a-4c29-4911-8bc3-3cfe5547e07b">
					<tavatekst id="ab5313e0-3cff-4e68-92b1-9a335055fcc6">Sissetulekust sõltuvate toetuste määrad on järgmised:</tavatekst>
				</sisuTekst>
				<alampunkt id="para2lg1p1">
					<alampunktNr id="3ad48a8f-76ec-43d4-82ba-4aab16755ad9">1</alampunktNr>
					<kuvatavNr id="3b5215b0-429b-477b-99b5-a11a7d6c83fe"><![CDATA[1) ]]></kuvatavNr>
					<sisuTekst id="da49a10d-4640-467e-a74a-908c258920dd">
						<tavatekst id="2865d348-c6a2-479a-81a2-dd9bcf7b8224">koolitoetuse suurus on 35 eurot ühe koolis käiva lapse kohta;</tavatekst>
					</sisuTekst>
				</alampunkt>
				<alampunkt id="para2lg1p2">
					<alampunktNr id="29c30c32-a9b4-4107-8d79-4d2f0ee6b798">2</alampunktNr>
					<kuvatavNr id="27d60d93-dc83-4dc0-b846-47b34fb799a3"><![CDATA[2) ]]></kuvatavNr>
					<sisuTekst id="e639eecf-1b38-41e5-8b8c-987242b06d29">
						<tavatekst id="ce72a1f5-3a06-4ed5-b362-8f07c2ca54f9">küttetoetuse suurus on kuni 65 eurot;</tavatekst>
					</sisuTekst>
				</alampunkt>
				<alampunkt id="para2lg1p3">
					<alampunktNr id="eb36d077-1487-4039-b6aa-e571dbeabbed">3</alampunktNr>
					<kuvatavNr id="6be77a60-b5c4-4842-a9f2-033065effadc"><![CDATA[3) ]]></kuvatavNr>
					<sisuTekst id="d7f66497-47e0-403e-a252-9eea7711b41c">
						<tavatekst id="265c84be-a3da-4257-9062-8134b9f9f20a">tervisetoetuse suurus on kuni 35 eurot;</tavatekst>
					</sisuTekst>
				</alampunkt>
				<alampunkt id="para2lg1p4">
					<alampunktNr id="9550bc54-4b00-41f7-8e15-701888a8a031">4</alampunktNr>
					<kuvatavNr id="e1ec8eaf-dba3-4ecf-b77d-88d556ff453e"><![CDATA[4) ]]></kuvatavNr>
					<sisuTekst id="4a207575-16b5-412f-8daa-e6d7a5b2745d">
						<tavatekst id="f65755c9-035e-4072-b99c-4852fac5d47d">igapäevase toimetuleku soodustamise toetuse suurus on kuni 65 eurot;</tavatekst>
					</sisuTekst>
				</alampunkt>
				<alampunkt id="para2lg1p5">
					<alampunktNr id="4e8d884c-dd32-4a80-8c86-b9820aeb0d51">5</alampunktNr>
					<kuvatavNr id="e9dc2a14-d98c-46b8-8fc4-05c59b8fde3a"><![CDATA[5) ]]></kuvatavNr>
					<sisuTekst id="d005c867-4544-4837-adcc-cd358089626a">
						<tavatekst id="a049ddb2-2d9a-4813-8ecc-ce9e2fca1189">erakorralise toetuse suurus on kuni 800 eurot;</tavatekst>
					</sisuTekst>
				</alampunkt>
				<alampunkt id="para2lg1p6">
					<alampunktNr id="14680a10-9b68-44da-8863-583196adff2e">6</alampunktNr>
					<kuvatavNr id="e7acd3d6-88c9-4e94-ab86-4f67f33eb670"><![CDATA[6) ]]></kuvatavNr>
					<sisuTekst id="83ae48b7-4f17-4543-9f76-36a43abca6aa">
						<tavatekst id="9e2e9448-64e2-4768-877e-31270d9b1bbb">laagritoetuse suurus on kuni 35 eurot ühe lapse kohta;</tavatekst>
					</sisuTekst>
				</alampunkt>
				<alampunkt id="para2lg1p7">
					<alampunktNr id="e4375437-ab15-47dc-a5f5-419e0aa856ce">7</alampunktNr>
					<kuvatavNr id="88476a55-6ae5-41d7-a093-34ba2b21f382"><![CDATA[7) ]]></kuvatavNr>
					<sisuTekst id="6b2f1448-a4c3-4685-a27e-40075ac0a249">
						<tavatekst id="d6eec465-fc67-4f36-a90e-0d1c68d24d9d">transpordi toetuse suurus on kuni 35 eurot;</tavatekst>
					</sisuTekst>
				</alampunkt>
				<alampunkt id="para2lg1p8">
					<alampunktNr id="26165166-946a-4611-ab06-bbc07396dec2">8</alampunktNr>
					<kuvatavNr id="36560c55-b165-4148-97f5-4b7f08bf7d7f"><![CDATA[8) ]]></kuvatavNr>
					<sisuTekst id="7e267f01-ee12-4cf4-badc-238af646c03c">
						<tavatekst id="81e6fa3d-e3f0-4c58-9145-f3445e8d506d">toimetulekutoetust arvestatakse sotsiaalhoolekande seaduse §-des 131 – 135 kehtestatud ulatuses, tingimustel ja korras ning toetust makstakse selleks riigieelarvest eraldatud vahenditest.</tavatekst>
					</sisuTekst>
				</alampunkt>
			</loige>
		</paragrahv>
		<paragrahv id="para3">
			<paragrahvNr id="ca72d051-9329-48a7-bcc0-799805b32599">3</paragrahvNr>
			<kuvatavNr id="682c44f1-fd10-4815-91b4-662ae69d7c68"><![CDATA[§ 3. ]]></kuvatavNr>
			<paragrahvPealkiri id="9f6ba033-dcf3-43ea-a936-dc645bb77d2c">Toimetulekutoetuse määramisel arvesse võetavad eluruumi alaliste kulude normpinnad</paragrahvPealkiri>
			<loige id="para3lg1">
				<loigeNr id="614ab5d2-0da3-4203-9a68-efbba15c01c7">1</loigeNr>
				<kuvatavNr id="afc2a93b-7c2f-494f-94a6-8c299c388e98"><![CDATA[(1)]]></kuvatavNr>
				<sisuTekst id="85b4d2f2-cdb9-43e2-bbdc-cf3d8e3ee674">
					<tavatekst id="dda97648-aa94-476e-9ab1-0f2bcf550e62">Eluruumi alaliste kuludena normpinna ulatuses võetakse toimetulekutoetuse määramisel arvesse ainult need kulud, mille kohta esitatakse dokumendid.</tavatekst>
				</sisuTekst>
			</loige>
			<loige id="para3lg2">
				<loigeNr id="fcc0db61-085f-4c90-935a-0f17d95ecb96">2</loigeNr>
				<kuvatavNr id="d2447a81-73ba-4c44-b87e-64be6ca257f8"><![CDATA[(2)]]></kuvatavNr>
				<sisuTekst id="6459a6ef-4d42-4525-8b02-0065bc85b866">
					<tavatekst id="9d514606-075b-4f07-b146-4a49740cda23">Eluruumi alalised kulud võetakse toetuse määramisel arvesse normpinna ulatuses.</tavatekst>
				</sisuTekst>
			</loige>
			<loige id="para3lg3">
				<loigeNr id="ded58ce5-5570-4a09-aaf9-ab9cb26e2380">3</loigeNr>
				<kuvatavNr id="85fb6386-9779-49f7-93c0-a46d8a2b932f"><![CDATA[(3)]]></kuvatavNr>
				<sisuTekst id="a4150721-0328-439d-8eb5-e3adc8c02933">
					<tavatekst id="c28485c1-b6a7-4711-a927-6f086c159a36">Eluruumi normpinnaks loetakse 18 m<sup>2</sup> üldpinda iga perekonnaliikme kohta ja täiendavalt 15 m<sup>2</sup> perekonna kohta.</tavatekst>
				</sisuTekst>
			</loige>
			<loige id="para3lg4">
				<loigeNr id="a444d392-3962-4f91-aa6b-89d6e45a06fe">4</loigeNr>
				<kuvatavNr id="3b62a3a8-29e7-46c1-96b4-6c8b3dc0520b"><![CDATA[(4)]]></kuvatavNr>
				<sisuTekst id="7f45e037-ab6c-455c-8e80-b07c29fc6bfa">
					<tavatekst id="2bc3f695-aea6-49ba-bc85-7513cfd941ab">Kui eluruumi tubade arv võrdub seal elavate elanike arvuga, kuid eluruumi üldpind on normpinnast suurem, võetakse aluseks tegelik pindala.</tavatekst>
				</sisuTekst>
			</loige>
			<loige id="para3lg5">
				<loigeNr id="ddef5da7-a52f-43be-91a2-173b546e70b9">5</loigeNr>
				<kuvatavNr id="ab40f607-d962-4f4f-88c6-0573123f854b"><![CDATA[(5)]]></kuvatavNr>
				<sisuTekst id="f2011594-4e21-4f6e-a06c-14b198b0930d">
					<tavatekst id="b14a41f5-7aa8-4048-a393-1a5e16e6d5dc">Kui eluruumi üldpind on normpinnast väiksem, võetakse aluseks eluruumi tegelik pindala.</tavatekst>
				</sisuTekst>
			</loige>
			<loige id="para3lg6">
				<loigeNr id="1992dfb8-41ad-4d69-9367-67690a029575">6</loigeNr>
				<kuvatavNr id="4dedb25c-cf6f-41a3-abce-22eab710a1a2"><![CDATA[(6)]]></kuvatavNr>
				<sisuTekst id="eabfade4-e7bc-4527-8d1d-e032b970280a">
					<tavatekst id="7ece3f4c-244c-4843-b008-73d59afd7a2f">Üksi elava pensionäri või puuduva või osalise töövõimega isiku eluruumi normpinnaks loetakse kuni 51 m<sup>2</sup>.</tavatekst>
				</sisuTekst>
			</loige>
		</paragrahv>
		<paragrahv id="para4">
			<paragrahvNr id="f501f9e2-8f00-4d32-80d2-11d37776f6c7">4</paragrahvNr>
			<kuvatavNr id="7153b92c-26c3-45ef-9e1f-ce1c84f3e475"><![CDATA[§ 4. ]]></kuvatavNr>
			<paragrahvPealkiri id="29c5a5e5-b28a-4d69-9f64-195ee0a6ef06">Toimetulekutoetuse arvestamisel arvesse võetavad eluruumi alaliste kulude piirmäärad</paragrahvPealkiri>
			<loige id="para4lg1">
				<loigeNr id="ec4ba1ec-84ce-4086-b33b-da03445e0748">1</loigeNr>
				<kuvatavNr id="fb3e901f-8377-422f-a65e-a1a6c715013f"><![CDATA[(1)]]></kuvatavNr>
				<sisuTekst id="a314971b-74b1-4bb7-9c96-14a5888ba932">
					<tavatekst id="b922e82a-b395-4750-8bf9-03a2412d49c9">Toimetulekutoetuse arvestamisel arvesse võetavad jooksval kuul tasumisele kuuluvad eluruumi alaliste kulude piirmäärad on järgmised:</tavatekst>
				</sisuTekst>
				<alampunkt id="para4lg1p1">
					<alampunktNr id="dadc9eb3-2734-4491-87d3-dc51360aa837">1</alampunktNr>
					<kuvatavNr id="cb2401ed-832c-43ec-a64b-0a1d74ea84b6"><![CDATA[1) ]]></kuvatavNr>
					<sisuTekst id="d2403d07-1004-4e16-80d7-f61bff647ad5">
						<tavatekst id="89695fdf-a63b-4ca3-b122-f27679f2dbb8">korteriüür kuni 12 eurot 1 m<sup>2</sup> kohta kuus;</tavatekst>
					</sisuTekst>
				</alampunkt>
				<alampunkt id="para4lg1p2">
					<alampunktNr id="8fbf16ce-e51f-4b0f-923f-0694cdd47368">2</alampunktNr>
					<kuvatavNr id="058e6478-bb45-469e-9bc3-acf89ba60fb8"><![CDATA[2) ]]></kuvatavNr>
					<sisuTekst id="05602747-6af6-4299-b2e3-2b174d7d2df2">
						<tavatekst id="48ecf28e-63fe-4a09-b979-71a5b067c302">korterelamu haldamise kulu, sealhulgas remondiga seotud kulu (haldus- või hooldusteenus, teenustööd, territooriumi korrashoid, remondifond, üldelekter jms) kuni 5 eurot 1 m<sup>2</sup> eluruumi normpinna kohta kuus;</tavatekst>
					</sisuTekst>
				</alampunkt>
				<alampunkt id="para4lg1p3">
					<alampunktNr id="18c01900-20c7-4840-9667-81dce88bcef1">3</alampunktNr>
					<kuvatavNr id="36a511e3-4737-42bd-9e90-45fe5b833bb1"><![CDATA[3) ]]></kuvatavNr>
					<sisuTekst id="698c7037-2e34-4d3a-985f-65bda05b35ac">
						<tavatekst id="5d6b3386-77f1-44f2-a9f2-faa9e61aeec0">korterelamu renoveerimiseks võetud laenu tagasimakse kuni 3 eurot 1 m<sup>2</sup> eluruumi normpinna kohta kuus;</tavatekst>
					</sisuTekst>
				</alampunkt>
				<alampunkt id="para4lg1p4">
					<alampunktNr id="3186edd7-8fee-4c55-87ff-9d74abc44ff4">4</alampunktNr>
					<kuvatavNr id="e025e6f4-b737-4940-900f-311d1a8327ab"><![CDATA[4) ]]></kuvatavNr>
					<sisuTekst id="585c7f9f-630e-4bfa-8693-b0708ed3d73a">
						<tavatekst id="c4b54b2f-c92b-46e4-8091-2141e57c9f7c">kütteks tarbitud soojusenergia või kütuse maksumus vastavalt:<reavahetus/>a) kaugküttega eluruumis kuni 4 eurot 1 m<sup>2</sup> eluruumi normpinna kohta kuus;<reavahetus/>b) kaugkütteta (ahi-, gaasi- ja elektriküttega) eluruumis kuni 4 eurot 1 m<sup>2</sup> eluruumi normpinna kohta kuus;<reavahetus/>c) juhul, kui kuludokumendil kajastub taotlusele järgneva perioodi küttekulu, kompenseeritakse see kuludokumendi esitamisele järgnevatel kuudel vastavalt kehtestatud piirmäärale; kuludokumendil näidatud summa kompenseerimiseni või kuni uue kuludokumendi esitamiseni;</tavatekst>
					</sisuTekst>
				</alampunkt>
				<alampunkt id="para4lg1p5">
					<alampunktNr id="6b415403-55c9-4691-9cb2-7646a9956983">5</alampunktNr>
					<kuvatavNr id="e23a15ae-f115-458d-b49f-b3eab417ace7"><![CDATA[5) ]]></kuvatavNr>
					<sisuTekst id="08fbbce8-3db3-4b48-a47c-97426e6f53b6">
						<tavatekst id="5089bb60-0efb-4c87-9637-b68f04e6500f">tarbitud vee- ja kanalisatsiooniteenuste maksumus kuni 30 eurot iga pereliikme kohta kuus;</tavatekst>
					</sisuTekst>
				</alampunkt>
				<alampunkt id="para4lg1p6">
					<alampunktNr id="680a111f-9024-479a-85a7-fc60a44fa470">6</alampunktNr>
					<kuvatavNr id="9b5b275d-7af1-41e5-8ec8-344e2dee9e78"><![CDATA[6) ]]></kuvatavNr>
					<sisuTekst id="ccf57394-4b27-4546-aaf7-b99aec4432c8">
						<tavatekst id="da5fbc74-b030-41ac-ae43-461894670870">vee soojendamiseks tarbitud soojusenergia või kütuse maksumus 15 eurot iga pereliikme kohta kuus;</tavatekst>
					</sisuTekst>
				</alampunkt>
				<alampunkt id="para4lg1p7">
					<alampunktNr id="55d6825d-4f11-4fa2-83e3-262d97d5d95c">7</alampunktNr>
					<kuvatavNr id="c0557def-cf97-4d64-9b1d-9680ff404023"><![CDATA[7) ]]></kuvatavNr>
					<sisuTekst id="e6a4e9d9-f5ad-4a68-97e5-0f6572ffad3d">
						<tavatekst id="a1d90a1b-556f-4ba3-ab62-6d6c63b76494">tarbitud elektrienergia maksumus kuni 45 eurot iga pereliikme kohta kuus;</tavatekst>
					</sisuTekst>
				</alampunkt>
				<alampunkt id="para4lg1p8">
					<alampunktNr id="9c237d73-2392-4d00-bf56-ed60455b6626">8</alampunktNr>
					<kuvatavNr id="df290d9c-4135-4ad4-869c-91a469dfb532"><![CDATA[8) ]]></kuvatavNr>
					<sisuTekst id="204fa557-635e-434a-9c0b-9847de585bcd">
						<tavatekst id="f547027e-9877-4c5a-a0d2-cfc85b0efe46">tarbitud majapidamisgaasi maksumus kuni 14 eurot iga pereliikme kohta kuus;</tavatekst>
					</sisuTekst>
				</alampunkt>
				<alampunkt id="para4lg1p9">
					<alampunktNr id="2bcb9289-1a4e-4ebc-9356-546ac43035f0">9</alampunktNr>
					<kuvatavNr id="812893b5-80f5-47a6-81f6-f4670087a1a2"><![CDATA[9) ]]></kuvatavNr>
					<sisuTekst id="816251f0-a253-426f-9f00-7acc9acdfbb6">
						<tavatekst id="55612ae7-7f59-4360-9b60-37d39da8a352">maamaksukulu kuni 1 euro 1 m<sup>2</sup> kohta kuus, kuid mitte üle kolmekordse eluruumi normpinna;</tavatekst>
					</sisuTekst>
				</alampunkt>
				<alampunkt id="para4lg1p10">
					<alampunktNr id="8edf1c00-e0b6-4c1f-9930-d0f1f5ab902a">10</alampunktNr>
					<kuvatavNr id="13644e39-8bb4-4f49-a182-97281ab6f760"><![CDATA[10) ]]></kuvatavNr>
					<sisuTekst id="0bbc502f-b439-441d-a31f-fa2c0dfbbc01">
						<tavatekst id="158ea442-c742-4000-88db-c9a50f20361a">kasutatava eluruumi hoonekindlustuse kulud kuni 1 euro 1 m<sup>2</sup> kohta kuus;</tavatekst>
					</sisuTekst>
				</alampunkt>
				<alampunkt id="para4lg1p11">
					<alampunktNr id="3cc26918-2a3c-420b-b2b2-05ce83dbe1e2">11</alampunktNr>
					<kuvatavNr id="ddf15d31-4d4b-4ae7-a692-591217375f85"><![CDATA[11) ]]></kuvatavNr>
					<sisuTekst id="89229f66-89d7-4050-b812-782cbc668bbe">
						<tavatekst id="718a44a2-e354-4f98-81e3-29e46d82bc85">tegelik olmejäätmete veotasu kuni 30 eurot iga pereliikme kohta kuus;</tavatekst>
					</sisuTekst>
				</alampunkt>
				<alampunkt id="para4lg1p12">
					<alampunktNr id="31f8f60e-b25f-4284-937a-74a3b1d2afd6">12</alampunktNr>
					<kuvatavNr id="e225904b-20c6-435a-aa35-1a031a1a71b1"><![CDATA[12) ]]></kuvatavNr>
					<sisuTekst id="7370dcd5-d61e-4828-8553-e103968dac41">
						<tavatekst id="9c573619-16ee-4d32-9880-075509a09093">eluaseme soetamiseks võetud laenu tagasimakse kulud kuni 12 eurot 1 m<sup>2</sup> kohta kuus.</tavatekst>
					</sisuTekst>
				</alampunkt>
			</loige>
			<loige id="para4lg2">
				<loigeNr id="5e4e1294-85bc-4468-a004-573ed7247fd2">2</loigeNr>
				<kuvatavNr id="6d015ebc-db09-43ca-b7d2-c860887fc6f5"><![CDATA[(2)]]></kuvatavNr>
				<sisuTekst id="7fe17067-c22d-4b17-b269-1be72abe6799">
					<tavatekst id="e6555bd7-54a9-432e-98c1-da0191f2e145">Toimetulekutoetuse määramisel arvesse võetavate eluasemekulude aluseks on majavaldajate, majahaldajate, majaomanike või teenusepakkujate poolt taotlejale esitatud nõuetekohased arved või maksekviitungid tehtud kulutuste kohta.</tavatekst>
				</sisuTekst>
			</loige>
			<loige id="para4lg3">
				<loigeNr id="1cec7a92-035e-45d5-aec6-77e814e6b1cb">3</loigeNr>
				<kuvatavNr id="92d049fd-683f-45df-8fc1-57ce435b9c88"><![CDATA[(3)]]></kuvatavNr>
				<sisuTekst id="bde3086f-d044-4c8a-b360-4c64d7b40ae6">
					<tavatekst id="5905a74e-eab2-467c-9a03-857328a26ca7">Eluruumi alaliste kulude tasumisel varem tekkinud võlgnevust ei arvata toimetulekutoetuse määramisel jooksval kuul tasumisele kuuluvate alalise eluruumi alatiste kulude hulka ja see ei kuulu katmisele toimetulekutoetuse vahendite arvelt.</tavatekst>
				</sisuTekst>
			</loige>
			<loige id="para4lg4">
				<loigeNr id="9b9f7d17-37f9-44b4-9056-c81759d42bba">4</loigeNr>
				<kuvatavNr id="757286c1-6f55-4afa-9c44-be123c385088"><![CDATA[(4)]]></kuvatavNr>
				<sisuTekst id="1afe6515-d183-487c-8bc2-6b971b256358">
					<tavatekst id="39f84ed6-af2c-40a4-8c22-6fe7a9640d46">Toimetulekutoetuse arvestamisel võib üksi elavale isikule või perekonnale, kellele on toimetulekutoetuse arvestamisele vahetult eelnenud kuuel kuul määratud toimetulekutoetus, võtta arvesse muid ühekordseid eluasemekulusid, mille tegemise vajadus on vältimatu ja tuleneb õigusaktist või on tingitud ohust inimese tervisele või elule, kuni ühe toimetulekupiiri ulatuses kalendriaasta jooksul.</tavatekst>
				</sisuTekst>
			</loige>
		</paragrahv>
		<paragrahv id="para5">
			<paragrahvNr id="e017bfa7-3e64-4d01-97a6-2ead87a09702">5</paragrahvNr>
			<kuvatavNr id="051984bd-8b9e-4356-9419-f0f7c1e7cc9c"><![CDATA[§ 5. ]]></kuvatavNr>
			<paragrahvPealkiri id="1ffad625-85db-46f7-89af-59b481d07e52">Sotsiaalteenuste hindade kehtestamine</paragrahvPealkiri>
			<loige id="para5lg1">
				<loigeNr id="231382e3-0e0e-427c-aaf3-d717fc9bab4b">1</loigeNr>
				<kuvatavNr id="a0bc653f-05f9-46f2-8d34-70031dc11181"><![CDATA[(1)]]></kuvatavNr>
				<sisuTekst id="473b1e33-9349-4c65-ac4a-ae9430a51bd0">
					<tavatekst id="b1a41d35-910c-4c2a-9c23-797363dabc6d">Sotsiaalteenuste hinnad on järgmised:</tavatekst>
				</sisuTekst>
				<alampunkt id="para5lg1p1">
					<alampunktNr id="2bd4f19e-4d0b-4ce7-860b-cd8321bf7d31">1</alampunktNr>
					<kuvatavNr id="ca71d5b7-bda3-4e31-ac11-10019a6c3181"><![CDATA[1) ]]></kuvatavNr>
					<sisuTekst id="303b8be8-1046-4848-ab31-1f24b9997a14">
						<tavatekst id="5f76d9b0-15d2-47f4-a1d2-3df19e1e0469">koduteenuse hind on 4 eurot tunnis;</tavatekst>
					</sisuTekst>
				</alampunkt>
				<alampunkt id="para5lg1p2">
					<alampunktNr id="89d1a719-c801-4077-b1bb-f29bc937bcba">2</alampunktNr>
					<kuvatavNr id="07d7a168-9820-44d8-a0c9-ef0acf91b427"><![CDATA[2) ]]></kuvatavNr>
					<sisuTekst id="add5f424-c0f9-4612-962e-0ef88d3b9cf0">
						<tavatekst id="cd580a2b-7a50-4689-9711-776264f9ad87">isikliku abistaja teenuse hind on 4 eurot tunnis;</tavatekst>
					</sisuTekst>
				</alampunkt>
				<alampunkt id="para5lg1p3">
					<alampunktNr id="75665acc-904c-42c9-94ca-8a07d63efd55">3</alampunktNr>
					<kuvatavNr id="2f5e8279-5b33-440b-9eba-e8366302d71b"><![CDATA[3) ]]></kuvatavNr>
					<sisuTekst id="97060c57-59af-40de-b6cc-72a6f9ae073c">
						<tavatekst id="91c58d7b-c4f3-49f1-b4b0-8c7ab08f5951">varjupaigateenus on rahvastikuregistri andmetel Anija valla elanikule tasuta, teistele isikutele 15 eurot päevas;</tavatekst>
					</sisuTekst>
				</alampunkt>
				<alampunkt id="para5lg1p4">
					<alampunktNr id="ad4bded6-60b6-428a-b977-55c04679cb58">4</alampunktNr>
					<kuvatavNr id="f9f546e9-93b0-4d36-a5d2-ec8679b59b0d"><![CDATA[4) ]]></kuvatavNr>
					<sisuTekst id="ba748de2-147b-4296-bc05-8b8d68e408f3">
						<tavatekst id="c1e9995a-9031-4ab2-bea3-64d3ef69f6e6">sotsiaaltransporditeenuse hind on 0,25 eurot sõidukilomeetri kohta;</tavatekst>
					</sisuTekst>
				</alampunkt>
				<alampunkt id="para5lg1p5">
					<alampunktNr id="d7491d13-97ef-4fa0-be9f-70748a229bfb">5</alampunktNr>
					<kuvatavNr id="80e8dcdd-87db-4643-863b-b3fac1064f02"><![CDATA[5) ]]></kuvatavNr>
					<sisuTekst id="4138c08b-b3e0-42d5-94b4-50ad652cd9c8">
						<tavatekst id="67b33e48-1644-4b3f-a1d1-117913c50f7a">pesumasina kasutamise hind (üks masinatäis) on 2 eurot;</tavatekst>
					</sisuTekst>
				</alampunkt>
				<alampunkt id="para5lg1p6">
					<alampunktNr id="f78b9581-924d-4320-9b45-f247933f394f">6</alampunktNr>
					<kuvatavNr id="f7435c84-7641-4573-ae57-4483cb7afcd5"><![CDATA[6) ]]></kuvatavNr>
					<sisuTekst id="0f0123d8-92b2-4e40-b6a4-17482c9f80d6">
						<tavatekst id="49987564-ed09-4c38-bec1-b72782cb2396">pesukuivati kasutamise hind (üks masinatäis) on 2 eurot;</tavatekst>
					</sisuTekst>
				</alampunkt>
				<alampunkt id="para5lg1p7">
					<alampunktNr id="d1b9cc58-0632-4e21-a2bd-04eddb800dd0">7</alampunktNr>
					<kuvatavNr id="24469245-d158-492a-85c3-e3613ffa7c62"><![CDATA[7) ]]></kuvatavNr>
					<sisuTekst id="33d5f00f-e87d-4903-8ab7-a8a9c896f71f">
						<tavatekst id="4b8118a6-0cd6-4208-bba2-87f4f6468143">duši kasutamise hind (üks kord inimese kohta) on 2 eurot.</tavatekst>
					</sisuTekst>
				</alampunkt>
			</loige>
			<loige id="para5lg2">
				<loigeNr id="02c65149-211b-4471-adbd-38e9d5a6cf6e">2</loigeNr>
				<kuvatavNr id="fc65f534-e72c-41df-815e-4fb2bb1770be"><![CDATA[(2)]]></kuvatavNr>
				<sisuTekst id="ff884f06-169d-408f-b85d-cc585a9fbad5">
					<tavatekst id="9dfdec4a-31d7-4b4d-974a-8a02cb04d2c7">Koduteenuse ja isikliku abistaja teenuse osutamise aja sisse arvestatakse kogu teenuse osutamiseks kulunud aeg, sh aeg, mis kulub teenuseosutajal objektile liikumiseks.</tavatekst>
				</sisuTekst>
			</loige>
			<loige id="para5lg3">
				<loigeNr id="fe7a47c7-ce0c-4d8d-8be3-c8dbc223086b">3</loigeNr>
				<kuvatavNr id="5cc5bd86-e92e-4938-9b72-a59fff7de992"><![CDATA[(3)]]></kuvatavNr>
				<sisuTekst id="c23d0da7-b69c-4564-95e6-15e9ae927168">
					<tavatekst id="547c21bd-ef24-4d0b-afbd-0f7c5792a49c">Transporditeenuse kilometraaži arvestuse algus- ja lõpp-punktiks on transpordivahendi garažeerimiskoht.</tavatekst>
				</sisuTekst>
			</loige>
			<loige id="para5lg4">
				<loigeNr id="0c5886dc-2e34-46e5-91a8-64627b96acbe">4</loigeNr>
				<kuvatavNr id="e9843f8b-e675-4e22-99f5-7d68a62c9893"><![CDATA[(4)]]></kuvatavNr>
				<sisuTekst id="0318c0c0-2080-49f7-aecb-11efb1737143">
					<tavatekst id="5664cb88-8c5a-418c-a7a2-b76c53380e8b">Kui transporditeenust osutatakse mitmele isikule üheaegselt, jagatakse teenuse hind teenuse tarbijate vahel võrdselt.</tavatekst>
				</sisuTekst>
			</loige>
			<loige id="para5lg5">
				<loigeNr id="425906d2-dffc-4b7f-a6eb-0824a43e9dd3">5</loigeNr>
				<kuvatavNr id="8c04cdce-0afb-4763-884e-3f5ebc3eb144"><![CDATA[(5)]]></kuvatavNr>
				<sisuTekst id="cb0a5494-5d92-4080-9911-52962c61b1c6">
					<tavatekst id="a56d4430-954a-415f-b9b8-d71f71ab32ad">Täiendavate vajaduspõhiste sotsiaalteenuste maksumuse otsustab vallavalitsus teenuse määramise korraldusega.</tavatekst>
				</sisuTekst>
			</loige>
		</paragrahv>
		<paragrahv id="para6">
			<paragrahvNr id="c9edbe2e-ef8c-4e40-801b-bc59c417223b">6</paragrahvNr>
			<kuvatavNr id="a666c21c-8a73-4011-bf2a-a163add9f483"><![CDATA[§ 6. ]]></kuvatavNr>
			<paragrahvPealkiri id="0196dac2-ae22-4c9c-9a21-5ce64b13e296">Rakendussätted</paragrahvPealkiri>
			<loige id="para6lg1">
				<loigeNr id="5fe7f3ae-8545-4db9-ae3f-6707d113edce">1</loigeNr>
				<kuvatavNr id="1bb8aeb8-032a-47f5-ad70-1952ebb1ec86"><![CDATA[(1)]]></kuvatavNr>
				<sisuTekst id="957c6374-ff4f-423e-8cc6-e4c786c7a59d">
					<tavatekst id="dc14024e-87dc-44a6-849b-ad183a20de6d">[Käesolevast tekstist välja jäetud.]</tavatekst>
				</sisuTekst>
			</loige>
			<loige id="para6lg2">
				<loigeNr id="10e83afe-d32b-4ec5-a9b2-dd46a09fb4a0">2</loigeNr>
				<kuvatavNr id="857a72ae-1642-4758-8cad-ff4a8f573065"><![CDATA[(2)]]></kuvatavNr>
				<sisuTekst id="6d25b933-d4d5-4749-9ad3-f56f1bbc2906">
					<tavatekst id="c43fbf5c-70a3-43f0-8f61-60a2ac109315">Määrus jõustub 02.02.2026.</tavatekst>
				</sisuTekst>
			</loige>
			<loige id="para6lg3">
				<loigeNr id="0886ffa2-cfdd-4613-9ec0-8dd739f6cf60">3</loigeNr>
				<kuvatavNr id="b9bf01b8-f622-44a7-93b3-4417e806bcbd"><![CDATA[(3)]]></kuvatavNr>
				<sisuTekst id="983dbb58-8f88-4720-b11d-10b421f2e5b6">
					<tavatekst id="308bc6cb-9208-4fa6-bff5-a89d7dbef518">Määruse § 1 lõike 1 punkte 1, 4 ja 7 rakendatakse tagasiulatuvalt 2026. aasta 1. jaanuarist.</tavatekst>
				</sisuTekst>
			</loige>
			<loige id="para6lg4">
				<loigeNr id="3af8d6b9-4d4b-4f56-9350-bababdaa159e">4</loigeNr>
				<kuvatavNr id="7b69decc-28ea-4fda-8203-4e7587a681df"><![CDATA[(4)]]></kuvatavNr>
				<sisuTekst id="a6d02ef6-da72-4973-807b-dabbf80c3b32">
					<tavatekst id="a0c52c07-0a7b-4370-83aa-ccc64903d59a">Lapse sünnitoetuse suurs lapse eest, kes on sündinud enne 01.01.2026 on kuni 800 eurot ja seda makstakse kahes osas:</tavatekst>
				</sisuTekst>
				
				<alampunkt id="para6lg4p1">
					<alampunktNr id="2ff44ff4-a41f-4d0d-a835-76251997e169">1</alampunktNr>
					<kuvatavNr id="7fc9b96b-df3f-4cd6-9a14-ecff44263268"><![CDATA[1) ]]></kuvatavNr>
					<sisuTekst id="a3e6a308-94d5-441e-a777-a63fff486fd3">
						<tavatekst id="c27e4f4e-4066-4eb6-8a4c-381fae21f15a">400 eurot pärast lapse sünni registreerimist, kui mõlema vanema või üksikvanema elukoht rahvastikuregistris on lapse sündimisel ja sünni registreerimisel Anija vald;</tavatekst>
					</sisuTekst>
				</alampunkt>
				<alampunkt id="para6lg4p2">
					<alampunktNr id="2f58bd91-b1cc-42a6-9f19-ca6c42d9e3d3">2</alampunktNr>
					<kuvatavNr id="fce1ba6c-28fd-4e83-b595-661c9823fc3c"><![CDATA[2) ]]></kuvatavNr>
					<sisuTekst id="d1a3c483-3c5d-40fb-835a-bdcba3b6e510">
						<tavatekst id="9d2f088b-0152-4f62-bee3-43f10912fd72">200 eurot pärast lapse sünni registreerimist, kui ainult ühe vanema elukoht rahvastikuregistris on lapse sündimisel ja sünni registreerimisel Anija vald;</tavatekst>
					</sisuTekst>
				</alampunkt>
				<alampunkt id="para6lg4p3">
					<alampunktNr id="697ae79b-6753-479d-a4a1-5a0a715e6264">3</alampunktNr>
					<kuvatavNr id="793a7771-0ecb-40d1-a30e-e6e1d54da2bb"><![CDATA[3) ]]></kuvatavNr>
					<sisuTekst id="c5bb47d1-07d8-41d4-89b9-99736e4e5682">
						<tavatekst id="704d1361-1619-4c1f-9d85-61f671933549">400 eurot pärast lapse üheaastaseks saamist tingimusel, et laps ja tema vanemad või üksikvanem on rahvastikuregistri andmetel Anija valla elanikud lapse üheaastaseks saamisel;</tavatekst>
					</sisuTekst>
				</alampunkt>
				<alampunkt id="para6lg4p4">
					<alampunktNr id="6c0867a3-5512-4339-a6d4-666fac40cebe">4</alampunktNr>
					<kuvatavNr id="50eccd02-2a31-48a1-82c3-3e9584e0b837"><![CDATA[4) ]]></kuvatavNr>
					<sisuTekst id="3a7d5db9-9211-49e0-bdf3-0b84efc06894">
						<tavatekst id="0d2568d2-0386-4014-a23d-9ed4667abdce">200 eurot pärast lapse üheaastaseks saamist tingimusel, et laps ja tema üks vanem on rahvastikuregistri andmetel Anija valla elanikud lapse üheaastaseks saamisel.</tavatekst>
					</sisuTekst>
					<muutmismarge id="2fc4177e-9eaa-4fc3-b2d7-6b596e975503">
					<avaldamismarge id="be383a5d-490a-4e08-9574-d64b86a189e8">
						<RTosa id="d4e26a95-c531-40ec-8b6a-7656eeecc601">RT IV</RTosa>
						<avaldamineKuupaev id="ffb3375f-7475-4a4a-86fa-9f1c36e8fcf9">2026-03-04</avaldamineKuupaev>
						<RTartikkel id="d5915784-f742-49c1-907e-bdd5af90ad3a">6</RTartikkel>
						<aktViide id="223f3bf2-d385-4ae6-92c0-84e1538ee973">404032026006</aktViide>
					</avaldamismarge>
					<joustumine id="54987b9e-5bc0-4839-98ca-c09791777860">2026-03-07</joustumine>
					<aktiNr id="17781506-e5b5-4eb0-9d3b-a912bbfaffab">4</aktiNr>
					<tavatekst id="21b03504-4b2d-4b27-98ef-5103c3a8fd22">, rakendatakse 01.01.2026</tavatekst>
				</muutmismarge>
				</alampunkt>
			</loige>
		</paragrahv>
