					<kuvatavNr id="b780a130-d189-41a6-be4b-ab9fe1ffabb2"><![CDATA[6) ]]></kuvatavNr>
					<sisuTekst id="4235ab4f-b68d-4dda-a289-90b50c9ecfba">
						<tavatekst id="0f212847-570b-4af0-8732-927fb1d94542">kütteks tarbitud soojusenergia või elektrienergia või kütuse maksumus kuni 15 eurot ruutmeetri kohta kuus. Kütuse ostmisel arvestatakse toimetuleku arvestuse sisse kuludokumendi esitamise kuul ja järgnevatel kuudel piirmäära alusel kuni kuludokumendis näidatud summani, kuid mitte rohkem kui 1500 eurot aastas;</tavatekst>
					</sisuTekst>
					
				<muutmismarge id="5569b4d3-83fd-4722-94da-c6c1c4cb3335"><avaldamismarge id="e3dc1223-b917-4aff-85bc-5e9f611ec47b"><RTosa id="1c05044e-96ae-4d9a-839e-9ad28f6429ca">RT IV</RTosa><avaldamineKuupaev id="6e1829c7-6b40-4bcc-9662-1d2ff9f5b81d">2024-09-28</avaldamineKuupaev><RTartikkel id="532cf846-5aba-440c-8abe-692ebdfca011">43</RTartikkel><aktViide id="65580d22-233e-4840-b8de-d4ff3f8948c6">428092024043</aktViide></avaldamismarge><joustumine id="f1d24218-1284-488b-8fac-4d7f1ac390b5">2024-10-01</joustumine></muutmismarge></alampunkt>
