			<pealkiri id="fa7e890c-eb94-4b0b-b45b-023fe6c1a4b7">Eluruumi alaliste kulude piirmäärad toimetulekutoetuse arvestamisel</pealkiri>
		</nimi>
	</aktinimi>
	<muutmismarge id="6b26f9b0-17f1-4535-98da-1a5d2205027f">
		<aktikuupaev id="32d8e38f-a1ec-4d08-8830-10103be7c58d">2022-10-18</aktikuupaev>
		<avaldamismarge id="1eecb718-8306-4388-9f3c-30790b7148fd">
			<RTosa id="419bba4b-02f1-4758-a1d2-5c8f52b29677">RT IV</RTosa>
			<avaldamineKuupaev id="2e08ad2c-13ae-4d51-8f6c-e9e98428f5e8">2022-10-29</avaldamineKuupaev>
			<RTartikkel id="4f92425a-0d76-40a8-8797-7454929b7e04">23</RTartikkel>
