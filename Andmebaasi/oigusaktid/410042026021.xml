	<sisu id="4943e71f-9893-4348-88f5-04f9c9c78f3d">
		<preambul id="ec5a559e-e0da-4f44-935b-5b9eb76c7342">
			<tavatekst id="e1c30d28-513c-4a55-8004-1593f16fdb0d">Määrus kehtestatakse kohaliku omavalitsuse korralduse seaduse § 6 lõike 1, § 22 lõike 1 punkt 37 ja sotsiaalhoolekande seaduse § 133 lõigete 5 ja 6 alusel.</tavatekst>
		</preambul>
		<paragrahv id="para1">
			<paragrahvNr id="531a906b-dbe1-476d-ba02-155c3145ad6d">1</paragrahvNr>
			<kuvatavNr id="69393c23-24c0-471f-956c-aec0c86ed80c"><![CDATA[§ 1. ]]></kuvatavNr>
			<paragrahvPealkiri id="d972670f-c7ef-4cc2-80a0-5643619de922">Reguleerimisala</paragrahvPealkiri>
			<loige id="para1lg1">
				<loigeNr id="3fab5e63-c0ee-4bed-a00c-a683f1d7fb9e">1</loigeNr>
				<kuvatavNr id="4d1d3157-bd5b-4a4e-8b1e-f2695c49efcd"><![CDATA[(1)]]></kuvatavNr>
				<sisuTekst id="d1ad80e5-cab1-4144-b039-c90662a547be">
					<tavatekst id="fc9951fa-dcd8-4021-94de-8d2e46d20356">Käesoleva määrusega kehtestatakse riikliku toimetulekutoetuse määramise aluseks olevad eluruumi alaliste kulude piirmäärad Märjamaa vallas.</tavatekst>
				</sisuTekst>
			</loige>
			<loige id="para1lg2">
				<loigeNr id="0b2c864a-e876-4413-a2a8-28fe546f9b5d">2</loigeNr>
				<kuvatavNr id="f65771a3-4d45-4d3b-a0cf-0340464e1886"><![CDATA[(2)]]></kuvatavNr>
				<sisuTekst id="dbae3cc5-eda5-41de-82f8-915fe6b82f12">
					<tavatekst id="b2b1cb00-4a04-4c68-a21e-defcb4379f62">Toimetulekutoetuse määramisel võetakse aluseks eluruumi tegelikud kulud, kuid mitte üle käesolevas määruses kehtestatud piirmäärade.</tavatekst>
				</sisuTekst>
			</loige>
		</paragrahv>
		<paragrahv id="para2">
			<paragrahvNr id="b2b0ecb1-8fa4-4d1a-8ac0-be2af4d74219">2</paragrahvNr>
			<kuvatavNr id="8f36fb84-8b6d-4933-b968-d87abde083ea"><![CDATA[§ 2. ]]></kuvatavNr>
			<paragrahvPealkiri id="b66df922-9271-44b6-82da-7a548edaad9f">Eluruumi alaliste kulude piirmäärad</paragrahvPealkiri>
			<loige id="para2lg1">
				<loigeNr id="392abd50-7895-4d68-8267-c8567505b049">1</loigeNr>
				<kuvatavNr id="4bd9f063-1e3b-4476-94b5-9a750b83bd7b"><![CDATA[(1)]]></kuvatavNr>
				<sisuTekst id="6d467756-827b-4fe9-beb8-48e2ecb65cf0">
					<tavatekst id="8d3f4799-132e-497a-ac7a-0278f6f28cbd">Toimetuleku arvestamisel arvesse võetavate jooksval kuul tasumisele kuuluvate eluruumi alaliste kulude piirmäärad on järgmised:</tavatekst>
				</sisuTekst>
				<alampunkt id="para2lg1p1">
					<alampunktNr id="838acba9-4b47-4a84-ba57-0eeea95774f9">1</alampunktNr>
					<kuvatavNr id="e783016b-d2e8-4801-bd41-041126658197"><![CDATA[1) ]]></kuvatavNr>
					<sisuTekst id="c5be0258-f36d-423f-9e71-310d6ea87821">
						<tavatekst id="2488e74b-c2bb-47a9-a9f2-b5b007b518ea">üür kuni <b>6 (kuus) eurot/m<sup>2</sup></b>;</tavatekst>
					</sisuTekst>
					<muutmismarge id="f6160bfe-cc2f-4cd1-95f1-2acec09f8b6e">
						<avaldamismarge id="9f05dacf-4b64-44c0-9a87-d6c4b61ccf28">
							<RTosa id="f68a2538-01ce-488c-90df-fae15a543ea5">RT IV</RTosa>
							<avaldamineKuupaev id="04270868-0e33-4d70-a823-cc7ded1adbdf">2026-04-10</avaldamineKuupaev>
							<RTartikkel id="e26e083f-26eb-4eb9-a991-18c838fd81b4">20</RTartikkel>
							<aktViide id="3a53e73f-4e61-44db-bf3d-e51125ce80aa">410042026020</aktViide>
						</avaldamismarge>
						<joustumine id="e2c1283f-a1bb-4e8c-9c04-98d2dc467a57">2026-04-13</joustumine>
					</muutmismarge>
				</alampunkt>
				<alampunkt id="para2lg1p1b1">
					<alampunktNr id="f5b7a18f-315d-4c97-9d07-6bcdeb0b9394" ylaIndeks="1">1</alampunktNr>
					<kuvatavNr id="4f89b3e8-42cb-452f-a28e-7fdfd4261c2d"><![CDATA[1<sup>1</sup>) ]]></kuvatavNr>
					<sisuTekst id="53cbfe29-382b-4ba5-bf90-6ff99a3fb60d">
						<tavatekst id="06780777-0077-459c-adf7-70bd10cd434c">eluaseme soetamiseks võetud laenu tagasimakse, mis sisaldab ka laenu intressi ja kohustusliku eluasemekindlustuse makset kuni <b>6 (kuus) eurot/m<sup>2</sup></b>;</tavatekst>
					</sisuTekst>
					<muutmismarge id="a32d6b6b-1976-46e9-bbad-083bd8ad89b0">
						<avaldamismarge id="c806034d-81a2-4024-818e-410904ce081c">
							<RTosa id="0f07ece6-3827-453b-9d6e-3dcf9e1ff660">RT IV</RTosa>
							<avaldamineKuupaev id="c4b458bb-0d40-4314-8b95-b2443cddd5dc">2022-06-28</avaldamineKuupaev>
							<RTartikkel id="dae95847-ba96-42d6-b7a4-435f611fe32d">92</RTartikkel>
							<aktViide id="bc0cfd73-7cb7-45aa-a2f5-6054e54d2e8a">428062022092</aktViide>
						</avaldamismarge>
						<joustumine id="80f6201b-0c58-4686-8272-7b2002098600">2022-07-01</joustumine>
						<aktiNr id="05a1cb62-4dc0-40a9-b1d6-b9a67820117e">24</aktiNr>
					</muutmismarge>
				</alampunkt>
				<alampunkt id="para2lg1p2">
					<alampunktNr id="96717680-8446-41b2-b507-913420232b65">2</alampunktNr>
					<kuvatavNr id="e0de9d48-831e-4e6a-8211-48ae9a28b53d"><![CDATA[2) ]]></kuvatavNr>
					<sisuTekst id="45a393eb-5f9c-41bf-8ebe-5c7d8ec32ca5">
						<tavatekst id="868102ce-7f61-42a6-898a-3e6116a65e43">korterelamu haldamise kulu, sh remondiga seotud kulu kuni <b>4 (neli) eurot/m<sup>2</sup></b>;</tavatekst>
					</sisuTekst>
				</alampunkt>
				<alampunkt id="para2lg1p3">
					<alampunktNr id="2f64ca30-194e-4507-89be-f43da3246939">3</alampunktNr>
					<kuvatavNr id="0e60ef86-f0b5-456c-92f6-87cc596c3721"><![CDATA[3) ]]></kuvatavNr>
					<sisuTekst id="f45196e9-23eb-46c3-8fde-393de1389ffa">
						<tavatekst id="c2d52370-82e5-4b6a-bf0c-b25f213112b9">korterelamu renoveerimiseks võetud laenu tagasimakse kuni <b>3 (kolm) eurot/m<sup>2</sup></b>;</tavatekst>
					</sisuTekst>
				</alampunkt>
				<alampunkt id="para2lg1p4">
					<alampunktNr id="7b124a15-3bc6-46bc-a2d3-6ccf5e2c31ce">4</alampunktNr>
					<kuvatavNr id="86ab0913-ca34-40c6-889c-dc419947b8dd"><![CDATA[4) ]]></kuvatavNr>
					<sisuTekst id="720e39fa-2db9-4c87-9a7c-e028e650d706">
						<tavatekst id="6bb56192-36aa-4648-a30b-56a5588d4517">veevarustuse ja reovee ärajuhtimise teenuse maksumus kuni <b>29 (kakskümmend üheksa) eurot</b> inimese kohta<b>; </b></tavatekst>
					</sisuTekst>
					<muutmismarge id="110fb67f-b731-44ad-9a83-2d2e74553bcd">
						<avaldamismarge id="10f56fdc-5e83-4a25-b410-b2c7aa7531a7">
							<RTosa id="f0c5a2c1-63cb-47b6-bbbb-95e4496cc870">RT IV</RTosa>
							<avaldamineKuupaev id="5b586903-4105-43ae-8798-4f1c9c7b22f4">2023-03-25</avaldamineKuupaev>
							<RTartikkel id="f49286b1-3ba1-4c7e-b935-8e242b489318">9</RTartikkel>
							<aktViide id="ce77b9bf-37e3-4dd5-9e57-7758ad0ecc47">425032023009</aktViide>
						</avaldamismarge>
						<joustumine id="fa3d9199-dc2d-4d63-a248-c519f450cc95">2023-03-28</joustumine>
					</muutmismarge>
				</alampunkt>
				<alampunkt id="para2lg1p5">
					<alampunktNr id="b9fde58a-1809-44c0-810d-ea22d00abc5d">5</alampunktNr>
					<kuvatavNr id="f4400e5e-a410-4261-88e9-62819e283d4d"><![CDATA[5) ]]></kuvatavNr>
					<sisuTekst id="5a3b903d-fa78-48e7-a345-5a88883c0386">
						<tavatekst id="7082c84a-05a6-41a4-8055-2cadca738d1d">soojaveevarustuseks tarbitud soojusenergia või kütuse maksumus <b>25 (kakskümmend viis) eurot</b> ühe inimesekohta kuus;</tavatekst>
					</sisuTekst>
				</alampunkt>
				<alampunkt id="para2lg1p6">
					<alampunktNr id="31b719e0-1c22-4283-8994-c67e7c93d73f">6</alampunktNr>
					<kuvatavNr id="9a6bd94a-de8f-4da4-969e-744c98360bb2"><![CDATA[6) ]]></kuvatavNr>
					<sisuTekst id="280d1525-fb4e-4625-a0b7-4a0c1f05d384">
						<tavatekst id="0c730aaa-3f3b-455a-85a6-809a8c5683ee">kaugküttega eluruumides kütteks tarbitud soojusenergia vastavalt tegelikule kulule;</tavatekst>
					</sisuTekst>
				</alampunkt>
				<alampunkt id="para2lg1p7">
					<alampunktNr id="5a22dd8c-73ee-4603-a965-bef0a21c5f1e">7</alampunktNr>
					<kuvatavNr id="a5f3df6f-6065-41a7-ba90-bba34deed1ec"><![CDATA[7) ]]></kuvatavNr>
					<sisuTekst id="f21b395a-b7c0-4a29-ba4b-273d29837a6f">
						<tavatekst id="f2cdbd03-57db-4311-b31e-56f5afaabfb5">kaugkütteta eluruumides olenemata tarbitavast kütuseliigist (turbabrikett, vedelkütus, puit, gaas või elektrienergia) kuni <b>5 (neli) eurot /m</b><b>
								<sup>2</sup>
							</b>;</tavatekst>
					</sisuTekst>
					<muutmismarge id="27c6644b-318e-432a-975d-0371e39f478e">
