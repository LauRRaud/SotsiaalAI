				<sisuTekst id="48f4984f-4ff1-4175-91c3-5926ea142577">
					<tavatekst id="e4e1dc4c-1e5f-40af-b0ac-dd56df1c779b">Elektrienergia kulu eluruumi elektriküttele võetakse arvesse juhul kui ainus eluruumi kütmiseks kasutatav kütteviis on statsionaarne elektriküte.</tavatekst>
				</sisuTekst>
			</loige>
