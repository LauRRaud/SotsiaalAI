		<preambul id="e32d52c3-d028-4a3a-94ec-a2fd2028669f">
			<tavatekst id="30facea5-28e5-4860-be3a-c4fc9cae7ca0">Määrus kehtestatakse sotsiaalhoolekande seaduse § 22<sup>1</sup> lõike 3 ja Saaremaa Vallavolikogu 25. mai 2023. a määruse nr 1-2/13 „Pädevuse delegeerimine“ § 1 alusel.</tavatekst>
		</preambul>
		<paragrahv id="para1">
			<paragrahvNr id="17b7d073-e225-4cce-babf-b21de8b01589">1</paragrahvNr>
			<kuvatavNr id="3fce172c-65fe-4b92-8b02-e2687cb003fb"><![CDATA[§ 1. ]]></kuvatavNr>
			<sisuTekst id="752aa549-5b21-4665-a748-e19d8aa39226">
				<tavatekst id="f0c06eb1-5a84-4cfb-b730-bc8ae6ea8c7b">Sotsiaalhoolekande seaduse § 22<sup>1</sup> lõikes 2 nimetatud väljaspool kodu osutatavat ööpäevaringset üldhooldusteenust vahetult osutavate hooldustöötajate ja abihooldustöötajate kulude Saaremaa valla poolt tasumise piirmääraks kehtestatakse 560 eurot.</tavatekst>
			</sisuTekst>
			
		<muutmismarge id="1bab00d3-35bf-4c24-85ae-62cd4136be0a"><avaldamismarge id="fdf53cf9-263d-4234-bddb-d36830597154"><RTosa id="e2143954-09bd-4f4c-a284-0b4505cf29d9">RT IV</RTosa><avaldamineKuupaev id="c2e33811-5196-48f2-b5f2-6283f29390b6">2024-10-11</avaldamineKuupaev><RTartikkel id="77b3206b-aaac-440f-be38-c6833cebe713">12</RTartikkel><aktViide id="83a230a6-05d1-4636-aafe-2ea917cd1279">411102024012</aktViide></avaldamismarge><joustumine id="00f41b56-81ff-4464-a695-4c4bf5baed64">2025-01-01</joustumine></muutmismarge></paragrahv>
