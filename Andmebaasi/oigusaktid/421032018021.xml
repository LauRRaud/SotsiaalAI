  <nimi id="b7eef09c-069b-481e-9d18-4cea8e13e2d9">
   <pealkiri id="ef359d35-0f7f-427e-a08a-b440ce1319f7">Asendus- ja järelhooldusteenuse osutamise kord</pealkiri>
  </nimi>
 </aktinimi>
 <sisu id="1a537337-d02e-40f3-989a-6bd4bfcdfdbf"><preambul id="cd82353d-8fa7-405a-8083-b208dc7636b6">
   <tavatekst id="72aa903e-f056-417c-b027-a69851155274">Määrus kehtestatakse kohaliku omavalitsuse korralduse seaduse § 6 lõike 1, § 22 lõike 1 punkti 5, sotsiaalhoolekande seaduse § 14, § 45<sup>5</sup> lõike 1 ja § 45<sup>15</sup> lõike 1 alusel.</tavatekst>
  </preambul><peatykk id="b37b1082-f535-4e34-a5f9-e642efc7268c">
   <peatykkNr id="c5a8639e-c5d2-4b76-abc0-5ee7c05b041d">1</peatykkNr>
   <kuvatavNr id="ca75154d-d876-4734-b676-b0185809b7ea"><![CDATA[1. peatükk]]></kuvatavNr>
   <peatykkPealkiri id="25190923-1c05-4d0b-a05d-0e9198cfa792">ÜLDSÄTTED</peatykkPealkiri>
  <paragrahv id="para1">
   <paragrahvNr id="7b1eafb7-cee1-4d1d-997a-5f71a7ecc4d2">1</paragrahvNr>
   <kuvatavNr id="48efc70d-29d8-433b-a4d3-3688f4d79a5c"><![CDATA[§ 1. ]]></kuvatavNr>
   <paragrahvPealkiri id="9dc00299-52bd-4219-bd99-ba7a45e6fc53">Määruse reguleerimisala</paragrahvPealkiri>
  <loige id="para1lg1">
   <loigeNr id="0a3199a2-b91b-44d9-a5fa-b901248c9ef4"/>
   <kuvatavNr id="c7be79cd-eb08-44a6-8beb-f503250e0106"/>
   <sisuTekst id="4fa09629-865f-46f8-8acb-b748b626f59b">
    <tavatekst id="56c2baee-666c-4ed7-8e95-a5d628dd7aa7">Määrusega kehtestatakse asendus- ja järelhooldusteenuse korraldamise ja rahastamise tingimused ja kord.</tavatekst>
   </sisuTekst>
  </loige></paragrahv><paragrahv id="para2">
   <paragrahvNr id="6cdcdb60-851a-4468-b5d0-b38413d29b60">2</paragrahvNr>
   <kuvatavNr id="2f46d018-1dc6-42b7-b044-cb3b9f73574a"><![CDATA[§ 2. ]]></kuvatavNr>
   <paragrahvPealkiri id="7f76dafb-92a0-4e25-8388-24e4c64b30be">Asendushooldusteenuse eesmärk</paragrahvPealkiri>
  <loige id="para2lg1">
   <loigeNr id="8389b235-c121-4557-ac68-3173a63dd043"/>
   <kuvatavNr id="d90ac5e9-ce7b-483b-900b-f4a0e7e93fc8"/>
   <sisuTekst id="55039124-57d4-41bf-8d5b-a78bd049d5d8">
    <tavatekst id="ce06b636-843b-4a29-b5ee-b1078801d6bc">Asendushooldusteenuse eesmärk on pika- või lühiajaliselt lapse heaolu ja õiguste tagamine, lapsele tema põhivajaduste rahuldamiseks peresarnaste elutingimuste võimaldamine, lapsele turvalise ja arenguks soodsa elukeskkonna loomine ning lapse ettevalmistamine võimetekohaseks toimetulekuks täisealisena.</tavatekst>
   </sisuTekst>
  </loige></paragrahv><paragrahv id="para3">
   <paragrahvNr id="a3dc2fc7-b41c-4849-833a-73ff07235e1d">3</paragrahvNr>
   <kuvatavNr id="a610e4ed-9bad-4ad5-9134-5c1656fb1116"><![CDATA[§ 3. ]]></kuvatavNr>
   <paragrahvPealkiri id="809b9737-49d6-4cc9-95a0-30fef4d4435a">Järelhooldusteenuse eesmärk</paragrahvPealkiri>
  <loige id="para3lg1">
   <loigeNr id="62b582e0-667a-472f-94e3-e17fd76e9f4f"/>
   <kuvatavNr id="8fa5948c-1469-4ff7-8980-27495adc238e"/>
   <sisuTekst id="c6d84bc3-31da-45e8-b0b8-1fecc811f232">
    <tavatekst id="8d2db070-6106-40f8-80b0-d64e2e9113e3">Järelhooldusteenuse eesmärk on asendushoolduselt ja eestkostelt lahkuva isiku iseseisva toimetuleku ja õpingute jätkamise toetamine. Järelhooldusteenust osutatakse lähtuvalt juhtumiplaanist, mille alusel kohaliku omavalitsuse üksus tagab isikule eluaseme ning vajaduspõhised tugiteenused ja toetused.</tavatekst>
   </sisuTekst>
  </loige></paragrahv></peatykk><peatykk id="9b48f769-63da-43e0-8c28-0ae277a10e5d">
   <peatykkNr id="cc7bba6e-55b7-45c8-8340-5e8e3982177e">2</peatykkNr>
   <kuvatavNr id="b7002142-9a5a-4329-b822-1afa15fed347"><![CDATA[2. peatükk]]></kuvatavNr>
   <peatykkPealkiri id="11af8947-e5ff-4f18-9cfa-3b47ecaffecf">TEENUSE KIRJELDUS</peatykkPealkiri>
  <paragrahv id="para4">
   <paragrahvNr id="a21a4436-7d0c-46b2-8eac-57371bdcedf6">4</paragrahvNr>
   <kuvatavNr id="063135c2-1f43-48eb-9af6-816869210a80"><![CDATA[§ 4. ]]></kuvatavNr>
   <paragrahvPealkiri id="6e334798-a719-4bb4-af3e-8fc5b4cf3af5">Teenuse osutaja</paragrahvPealkiri>
  <loige id="para4lg1">
   <loigeNr id="320f85ac-74f7-4022-a57f-b3193412281d">1</loigeNr>
   <kuvatavNr id="e6a21c9c-6b79-46df-bc33-ae46b5f0c4e7"><![CDATA[(1)]]></kuvatavNr>
   <sisuTekst id="900490ae-3d31-4cd2-a5df-a09d71db3f6b">
    <tavatekst id="85c41d1c-0e96-40de-8b35-7aab22673038"> Asendushooldusteenust osutavad hoolduspere, perekodu ja asenduskodu (edaspidi teenuseosutaja).</tavatekst>
   </sisuTekst>
  </loige><loige id="para4lg2">
   <loigeNr id="d511ea91-b923-45fd-a527-ad1ad93dbdbb">2</loigeNr>
   <kuvatavNr id="cf6e5e80-d7a3-4451-8d11-9e75ab78b3b0"><![CDATA[(2)]]></kuvatavNr>
   <sisuTekst id="effdc619-ce8a-4cc6-b7c8-93ec0642c277">
    <tavatekst id="b6defbe8-10d5-446e-83e1-d4d1e4f85575"> Asendushooldusteenust osutatakse pikaajalise ööpäevaringse teenusena või lühiajaliselt.</tavatekst>
   </sisuTekst>
  </loige><loige id="para4lg3">
   <loigeNr id="b914b254-b2d5-44c5-ac76-aeb71ff5f3c5">3</loigeNr>
   <kuvatavNr id="727302a6-91b2-4edf-a81c-fe01a71b9852"><![CDATA[(3)]]></kuvatavNr>
   <sisuTekst id="0b8e002a-23a3-4e8e-a230-e91d37a71a0a">
    <tavatekst id="26a27406-8522-4dec-a379-36c6157f072f"> Järelhooldusteenust osutab vallavalitsus või korraldab teenuse osutamise teiste teenuseosutajate kaudu.</tavatekst>
   </sisuTekst>
  </loige></paragrahv><paragrahv id="para5">
   <paragrahvNr id="9eaffd69-1a76-40a5-85c9-351774976e9b">5</paragrahvNr>
   <kuvatavNr id="f9bb7bea-1f86-406c-978d-ee9fdad9ffdb"><![CDATA[§ 5. ]]></kuvatavNr>
   <paragrahvPealkiri id="b3e98e0d-ad12-4482-b5db-93a377672fa5">Teenuse saaja</paragrahvPealkiri>
  <loige id="para5lg1">
   <loigeNr id="aae1277f-e91e-459a-9b27-bd51151fe925">1</loigeNr>
   <kuvatavNr id="7d973467-0f28-4e17-af11-77af6c297284"><![CDATA[(1)]]></kuvatavNr>
   <sisuTekst id="4784bbd7-8492-434f-8c8f-dda95d573bd9">
    <tavatekst id="9cc0231f-4552-4e86-89fb-5fc2b688b59e">Asendushooldusteenus tagatakse vallavalitsuse otsusega sotsiaalhoolekande seaduse § 45<sup>9</sup> lõigetes 1 ja 2 nimetatud lastele, kelle elukoht on registreeritud Saku vallas.</tavatekst>
   </sisuTekst>
  </loige><loige id="para5lg2">
   <loigeNr id="7aa45748-381d-4716-9468-e186497aa0de">2</loigeNr>
   <kuvatavNr id="161563df-006c-4a02-a6eb-4d486f6a05f4"><![CDATA[(2)]]></kuvatavNr>
   <sisuTekst id="21f7fa9e-89ff-4e43-a0af-5c055aa5227d">
    <tavatekst id="d0ebaa66-70ed-4510-9ed4-7283c148e6cc">Asendushooldusteenuse võib tagada vallavalitsuse otsusega sotsiaalhoolekande seaduse sotsiaalhoolekande seaduse § 45<sup>9 </sup> lõikes 3 nimetatud lastele, kelle elukoht on registreeritud Saku vallas, heaolu tagamiseks.</tavatekst>
   </sisuTekst>
  </loige><loige id="para5lg3">
   <loigeNr id="725bc267-c3ca-40e9-8641-df5cfa4e2148">3</loigeNr>
   <kuvatavNr id="ca22d88d-ef2e-4cb4-a327-e3d5d400fab7"><![CDATA[(3)]]></kuvatavNr>
   <sisuTekst id="f540f02f-80cb-4d92-9ff6-b00ce491e301">
    <tavatekst id="fa85756e-8090-47d1-9a64-020867ba7eae">Järelhooldusteenus tagatakse vallavalitsuse otsusega sotsiaalhoolekande seaduse § 45<sup>16</sup> lõikes 1 nimetatud täisealisele isikule, kelle elukoht on registreeritud Saku vallas.</tavatekst>
   </sisuTekst>
  </loige><loige id="para5lg4">
   <loigeNr id="2a6a3618-98d9-40f3-ab4c-4b9b2245705a">4</loigeNr>
   <kuvatavNr id="d6012535-a240-4f5b-b858-745e3d8dac71"><![CDATA[(4)]]></kuvatavNr>
   <sisuTekst id="c6fb9111-c5fd-43b6-b00e-cde26b216d1e">
    <tavatekst id="dd61a923-4f73-46de-b0ca-8cc6bdb65001">Järelhooldusteenuse võib tagada vallavalitsuse otsusega sotsiaalhoolekande seaduse § 45<sup>16</sup> lõikes 2 nimetatud täisealisele isikule, kelle elukoht on registreeritud Saku vallas, toimetuleku tagamiseks.</tavatekst>
   </sisuTekst>
  </loige></paragrahv></peatykk><peatykk id="e0248650-0274-4c6d-8c4a-c9900f38f34e">
   <peatykkNr id="229e5a3c-7b9a-4996-94cf-2c8fb8f37b5e">3</peatykkNr>
   <kuvatavNr id="6e277aaa-8a5c-42d0-934d-e4618b9a9dff"><![CDATA[3. peatükk]]></kuvatavNr>
   <peatykkPealkiri id="6fd89052-0a22-44fe-8050-bd48231bcba3">TEENUSE OSUTAMINE</peatykkPealkiri>
  <paragrahv id="para6">
   <paragrahvNr id="87544306-7ffa-408b-8ab4-1257ed61065b">6</paragrahvNr>
   <kuvatavNr id="fb4448b0-c29d-4f02-ada2-53210284dbfd"><![CDATA[§ 6. ]]></kuvatavNr>
   <paragrahvPealkiri id="2fafc7f1-bd07-443a-ac94-cad31a0c552c">Teenuse vajaduse hindamine ja teenusele suunamine</paragrahvPealkiri>
  <loige id="para6lg1">
   <loigeNr id="ccbc4f90-3303-470a-8bcf-b956632758d5">1</loigeNr>
   <kuvatavNr id="1e0823c5-0f9a-42b3-8a49-b7c3ea3ae781"><![CDATA[(1)]]></kuvatavNr>
   <sisuTekst id="9bad8d8a-3e41-42ac-8ae2-bd87dd4e75b3">
    <tavatekst id="ff1ed569-b30e-49e9-9aa7-c910b17898bf">Sotsiaalhoolekande seaduse § 45<sup>9</sup> lõigetes 1 ja 2 nimetatud lapse asendushooldusteenusele suunamisel vallavalitsus lapse heaolust lähtuvalt hindab teenuse osutamise vajadust, valib teenuse osutaja (hoolduspere, perekodu või asenduskodu) ja põhjendab tehtud valikut.</tavatekst>
   </sisuTekst>
  </loige><loige id="para6lg2">
   <loigeNr id="3cc268e5-ea52-4167-9e42-c4deec25e843">2</loigeNr>
   <kuvatavNr id="f36d055e-3a67-4034-8aa8-4a71dd80bd9c"><![CDATA[(2)]]></kuvatavNr>
   <sisuTekst id="4dc16307-69ef-4c8a-9a05-783b9df1fd5b">
    <tavatekst id="00b04c5c-18e3-4b8e-813e-4de338ee100e">Sotsiaalhoolekande seaduse § 45<sup>9</sup> lõikes 3 nimetatud lapse asendushooldusteenusele suunamisel vallavalitsus lapse abivajadusest ja heaolust lähtuvalt hindab teenuse osutamise vajadust ja valib teenuse osutaja (hoolduspere, perekodu või asenduskodu) ning suunab lapse teenusele hooldusõigusliku vanema või füüsilisest isikust eestkostja nõusolekul.</tavatekst>
   </sisuTekst>
  </loige><loige id="para6lg3">
   <loigeNr id="c45bc8b5-4732-4ab5-8991-243221f33711">3</loigeNr>
   <kuvatavNr id="3ed597de-30d5-4922-92d9-6d091b54fb37"><![CDATA[(3)]]></kuvatavNr>
   <sisuTekst id="13d9c072-36a2-47b0-a9bb-fbbf99ef8cbb">
    <tavatekst id="d901e512-46dc-4ac9-a964-f343ce89acca">Sotsiaalhoolekande seaduse § 45<sup>16</sup> lõigetes 1 ja 2 nimetatud täisealise isiku järelhooldusteenusele suunamisel hindab vallavalitsus isiku abivajadust ja sellest lähtudes otsustab osutatava teenuse sisu üle.</tavatekst>
   </sisuTekst>
  </loige><loige id="para6lg4">
   <loigeNr id="1b2c6041-d6ce-4ab9-97c7-eaf772289704">4</loigeNr>
   <kuvatavNr id="ba7afd9b-15df-4536-b9d0-7efa820225e4"><![CDATA[(4)]]></kuvatavNr>
   <sisuTekst id="e87045bd-731e-45a7-aa83-efbb0d6f439f">
    <tavatekst id="a2eb99e1-9e45-4a1e-b3eb-23882723749e">Käesoleva paragrahvi lõigetes 1-3 nimetatud isikute puhul teeb vallavalitsus otsuse teenusele suunamise kohta ning kannab isikule teenuse osutamise andmed sotsiaalteenuste ja -toetuste andmeregistrisse sotsiaalhoolekande seaduse § 144 lõike 1 punkt 5 alusel.</tavatekst>
   </sisuTekst>
  </loige><loige id="para6lg5">
   <loigeNr id="ba7176b7-ca37-463f-9b5a-3df3bcc8c555">5</loigeNr>
   <kuvatavNr id="1c6a3f9b-5635-4942-aa35-8b4b06d9b50c"><![CDATA[(5)]]></kuvatavNr>
   <sisuTekst id="73c8a6ff-8740-49d4-8cc4-77c8926a5f0a">
    <tavatekst id="4fa39ff4-992e-48d0-b9ff-9bfc6d492847">Teenuse saaja ja võimalusel tema vanem või füüsilisest isikust eestkostja peab olema kaasatud teenuse vajaduse hindamise ja teenusele suunamise protsessi.</tavatekst>
   </sisuTekst>
  </loige></paragrahv><paragrahv id="para7">
   <paragrahvNr id="aede5a4c-7d8d-494f-a7ee-b0e14c6082a4">7</paragrahvNr>
   <kuvatavNr id="c7554906-4454-44c4-b791-abdd8ebb572c"><![CDATA[§ 7. ]]></kuvatavNr>
   <paragrahvPealkiri id="62866bb7-56dc-4534-a03f-74c9da1414ab">Teenuse rahastamine</paragrahvPealkiri>
  <loige id="para7lg1">
   <loigeNr id="13c11f0e-3afa-4224-8667-fc6d0ee5af0f">1</loigeNr>
   <kuvatavNr id="70c483cd-2627-432d-ada2-e6930c83c7bd"><![CDATA[(1)]]></kuvatavNr>
   <sisuTekst id="05f4e8d5-ba06-4e8c-99b7-6cfd2b9291a0">
    <tavatekst id="fbd234db-862c-4e40-acfc-4b4eace85c9e">Asendushooldusteenust sotsiaalhoolekandeseaduse § 45<sup>9</sup> lõigetes 1 ja 2 nimetatud lapsele rahastatakse vallavalitsuse eelarvest ning asendushooldusteenusel oleva lapse sissetulekutest.</tavatekst>
   </sisuTekst>
  </loige><loige id="para7lg2">
   <loigeNr id="15b2083a-af27-4781-b1e8-9d1a5d4e0546">2</loigeNr>
   <kuvatavNr id="451191f9-d6d6-4037-b5ad-558a459efc54"><![CDATA[(2)]]></kuvatavNr>
   <sisuTekst id="23683197-c974-4ee3-b358-b82ce83c3627">
    <tavatekst id="1aeb5320-20fb-4a07-914b-355d2a61be3e">Asendushooldusteenust sotsiaalhoolekandeseaduse § 45<sup>9</sup> lõikes 3 nimetatud lapsele võib rahastada vallavalitsuse eelarvest ja lapse ülalpidamiskohustusliku isiku vahenditest.</tavatekst>
   </sisuTekst>
  </loige><loige id="para7lg3">
   <loigeNr id="cb7d2815-c9ab-403a-8ae4-654f17a463e3">3</loigeNr>
   <kuvatavNr id="0458da43-f6c1-4a2e-a2a0-4f66dd90d2dc"><![CDATA[(3)]]></kuvatavNr>
   <sisuTekst id="4e12fc02-de82-448e-b0b6-13077f6f0999">
    <tavatekst id="701b45e4-dfe5-47b8-8b42-a88c2e43d23a">Järelhooldusteenust rahastatakse vallavalitsuse eelarvest ning teenusel oleva täisealise isiku sissetulekutest.</tavatekst>
   </sisuTekst>
  </loige><loige id="para7lg4">
   <loigeNr id="14e2f71b-2520-40cb-a745-8f7fda252160">4</loigeNr>
   <kuvatavNr id="c12136b9-39c0-46b4-a7a5-a92b170310d6"><![CDATA[(4)]]></kuvatavNr>
   <sisuTekst id="26660232-1ab5-4bc3-a2ac-74fea4c138be">
    <tavatekst id="704bf251-d33a-4edf-8e5a-2c4a3676893c">Teenuse saaja isiklike kulude katteks peab vallavalitsus eelarvest iga kuu tegema kulutusi vähemalt sotsiaalhoolekande seaduse § 45<sup>11</sup> lõikes 3 sätestatud määras.</tavatekst>
   </sisuTekst>
  </loige><loige id="para7lg5">
   <loigeNr id="7243fa67-d499-438a-a908-2fa9ca88ff95">5</loigeNr>
   <kuvatavNr id="db60ac26-63ac-437f-a124-1e5a701fac23"><![CDATA[(5)]]></kuvatavNr>
   <sisuTekst id="a955e0da-893b-41de-8387-6e25339d5586">
    <tavatekst id="87f1d153-03a7-4580-a52d-0bb2ac602bc2">Käesoleva paragrahvi punktis 4 nimetatud summa fikseeritakse teenuse osutamise lepingus ning kantakse teenuse osutaja arvelduskontole, erandina võib järelhooldusel viibiva isiku puhul kokku leppida summa kandmise teenuse saaja arvelduskontole.</tavatekst>
   </sisuTekst>
  </loige><loige id="para7lg6">
   <loigeNr id="828eb772-5758-4f3e-99af-3086e452960a">6</loigeNr>
   <kuvatavNr id="da8ad4cc-6e07-45d5-a247-95984e4e7109"><![CDATA[(6)]]></kuvatavNr>
   <sisuTekst id="2f91c94b-62f7-445e-aeae-82c7c353937a">
    <tavatekst id="8dd34494-1339-4eb2-9d50-e78c2a82fd38">Vallavalitsus toetab hoolduspere vanemat, kelle andmed on kantud sotsiaalteenuste ja -toetuste andmeregistrisse, iga hooldatava lapse eest vähemalt ühe neljandiku ulatuses Vabariigi Valitsuse poolt kehtestatud töötasu alammäärast.</tavatekst>
   </sisuTekst>
  </loige><loige id="para7lg7">
   <loigeNr id="abbd6d1c-83d6-43db-8fc9-ea63cc7d6a45">7</loigeNr>
   <kuvatavNr id="9f5354c3-001a-4506-85b7-c98c5edf2c52"><![CDATA[(7)]]></kuvatavNr>
   <sisuTekst id="59175b46-f2a5-4e8b-96d3-30ca729747a6">
    <tavatekst id="8fa0fb92-d95f-4821-b886-5ea5d924295b">Vallavalitsus võib sotsiaalteenuste ja -toetuste andmeregistrisse kantud hoolduspere vanemale maksta tasu iga hooldatava lapse eest vähemalt ühe neljandiku ulatuses Vabariigi Valitsuse poolt kehtestatud töötasu alammäärast. Tasu maksmise korral ei maksta hoolduspere vanemale käesoleva paragrahvi lõikes 6 nimetatud toetust.</tavatekst>
   </sisuTekst>
  </loige><loige id="para7lg8">
   <loigeNr id="e8d7cd3d-7810-4bbf-9a6a-2329958732a6">8</loigeNr>
   <kuvatavNr id="b1620131-92cd-42ad-8703-93692cb2f72b"><![CDATA[(8)]]></kuvatavNr>
   <sisuTekst id="f5cdb749-088d-48a8-8c10-5322ecf474b6">
    <tavatekst id="8095c33e-3a7a-4d27-8d65-0e4ff7c17080">Lapse ülalpidamisest ja erivajadustest tulenevaid lisavajadusi rahastab vallavalitsus lapsele riigieelarvest igakuiseks ülalpidamiseks ja puudest tingitud lisakulude osaliseks hüvitamiseks ette nähtud sissetulekutest.</tavatekst>
   </sisuTekst>
  </loige><loige id="para7lg9">
   <loigeNr id="25c0bca9-3e42-466e-a495-ddd4a1bec4cb">9</loigeNr>
   <kuvatavNr id="142b1ab2-2f89-43cf-8c4f-7b4fbe7d37a2"><![CDATA[(9)]]></kuvatavNr>
   <sisuTekst id="5f094926-69e4-483e-8161-d427e87717b0">
    <tavatekst id="2e7312be-5e08-4308-81e8-3d6ff13e46ad">Teenuse osutaja muud kulutused teenuse osutamiseks lepitakse kokku vallavalitsuse ja teenuse osutaja vahel ning fikseeritakse teenuse osutamise lepingus.</tavatekst>
   </sisuTekst>
  </loige><loige id="para7lg10">
   <loigeNr id="d88578e0-10c4-4d1b-aa6d-ddeabc3dadb9">10</loigeNr>
   <kuvatavNr id="9fa4538f-e112-4c8c-b470-869d2c71b070"><![CDATA[(10)]]></kuvatavNr>
   <sisuTekst id="c8f632d7-5fb1-4632-8278-0e8079a99d68">
    <tavatekst id="855e4f2a-c392-464e-99c1-72be4673bac2">Teenuse osutaja muude kulude kokkuleppimisel tuleb arvestada teenuse saaja teenusel viibimise kestvust, õppimist väljaspool teenuse osutamise asukohta ja ülalpidamist riigi või kohaliku omavalitsuse eelarvest.</tavatekst>
   </sisuTekst>
  </loige></paragrahv><paragrahv id="para8">
   <paragrahvNr id="4b896951-27d3-43b9-a536-4b9c30707345">8</paragrahvNr>
   <kuvatavNr id="574b252e-5746-4bb7-b480-fea79d0150ce"><![CDATA[§ 8. ]]></kuvatavNr>
   <paragrahvPealkiri id="89d3f70d-cb76-444a-bcfc-f297949ae3db">Lepingu sõlmimine</paragrahvPealkiri>
  <loige id="para8lg1">
   <loigeNr id="12871ac5-68f8-4450-ae23-27485fdc5f74">1</loigeNr>
   <kuvatavNr id="4a002335-19c3-4baa-b4eb-2ce02e1bd8c9"><![CDATA[(1)]]></kuvatavNr>
   <sisuTekst id="1d4956a8-9a00-441d-a48a-87ae8defe759">
    <tavatekst id="7bdf99e7-b488-413a-8742-bdb70d815654">Vallavalitsus sõlmib teenuseosutajaga lepingu enne teenuse saajale teenuse osutamise alustamist.</tavatekst>
   </sisuTekst>
  </loige><loige id="para8lg2">
   <loigeNr id="ceced278-927e-43b1-bc3b-1042ce252bd8">2</loigeNr>
   <kuvatavNr id="813235c4-ad30-4f3c-9aa7-33726096ebb9"><![CDATA[(2)]]></kuvatavNr>
   <sisuTekst id="f96b34c1-06ba-41e1-b5c5-c2763adb5567">
    <tavatekst id="3d07eea3-ecaa-4a3b-96f1-882709fb16a0">Järelhooldusteenuse lepingu sõlmimisel on teenuse saaja üheks lepingupooleks.</tavatekst>
   </sisuTekst>
  </loige><loige id="para8lg3">
   <loigeNr id="76d741b6-780d-453e-b8ce-9afffdc1c191">3</loigeNr>
   <kuvatavNr id="804d81b4-9034-4073-9423-e58146ee60a0"><![CDATA[(3)]]></kuvatavNr>
   <sisuTekst id="16dbcaaf-4f23-476f-ab40-0463ebb05e5b">
    <tavatekst id="d1548820-3338-4d1b-a05d-43c74d397012">Lepinguga sätestatakse vähemalt teenuse saajale osutatava teenuse sisu, maht, kestvus, rahastamine ning osapoolte õigused ja kohustused.</tavatekst>
   </sisuTekst>
  </loige><loige id="para8lg4">
   <loigeNr id="50821cdd-4bf7-4e1e-920d-97237937fd18">4</loigeNr>
   <kuvatavNr id="dc58cae7-8452-43f2-bc2d-94d822cdb85c"><![CDATA[(4)]]></kuvatavNr>
   <sisuTekst id="14f62a1c-ad35-4c6a-ba45-efd107bda52c">
    <tavatekst id="3880dc20-a8ef-44f3-82a3-970e22e7ffc1">Asendushooldusele suunatud lapsele koostatud juhtumiplaan on asendushooldusteenuse osutamise lepingu lisa.</tavatekst>
   </sisuTekst>
  </loige></paragrahv><paragrahv id="para9">
   <paragrahvNr id="36f670e8-a562-4e9b-afe7-ad9659e3af7e">9</paragrahvNr>
   <kuvatavNr id="8da8f8e0-292b-4e48-9014-07aa11c4804b"><![CDATA[§ 9. ]]></kuvatavNr>
