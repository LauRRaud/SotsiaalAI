	<sisu id="ab50e748-5b52-418f-957e-22f98775c25c">
		<preambul id="53528b33-13dd-4cef-a1d6-e0d537b1fa07">
			<tavatekst id="720d1dea-b2a8-42e2-ad99-2e70fc82a1b4">Määrus kehtestatakse kohaliku omavalitsuse korralduse seaduse § 22 lõike 1 punkt 5 ja sotsiaalhoolekandeseaduse § 133 lõike 6 alusel.</tavatekst>
		</preambul>
		<paragrahv id="para1">
			<paragrahvNr id="026a8708-fab4-4f19-b134-f184037f93c1">1</paragrahvNr>
			<kuvatavNr id="1cb9d460-4688-4ec4-a4bd-55904a1aa60d"><![CDATA[§ 1. ]]></kuvatavNr>
			<paragrahvPealkiri id="45805e8b-0238-4216-89fa-335d2cc93f04">Reguleerimisala</paragrahvPealkiri>
			<loige id="para1lg1">
				<loigeNr id="c592a156-c7d8-4377-bb4a-e00462073294">1</loigeNr>
				<kuvatavNr id="aefc934a-e0b7-4957-bf18-ef393e0fee51"><![CDATA[(1)]]></kuvatavNr>
				<sisuTekst id="2f1ebd44-c954-44b6-81bb-76ac699cecfc">
					<tavatekst id="cb1905e2-967e-4d2e-9734-37afcfaef203"> Määrusega kehtestatakse toimetulekutoetuse määramisel jooksval kuul tasumisele kuuluvate eluasemekulude piirmäärad Häädemeeste vallas.</tavatekst>
				</sisuTekst>
			</loige>
			<loige id="para1lg2">
				<loigeNr id="4a317af5-dc82-403d-87d2-cad7a26dd4d7">2</loigeNr>
				<kuvatavNr id="9c82323b-d083-467a-b7de-107e54804972"><![CDATA[(2)]]></kuvatavNr>
				<sisuTekst id="f7109cd1-ce74-4556-995d-8c13e3bf5a3b">
					<tavatekst id="473f80b8-1137-4a96-b853-9fbdd0253207"> Toimetulekutoetuse määramisel võetakse arvesse jooksval kuul tasumisele kuuluvad eluasemekulud eluruumi sotsiaalselt põhjendatud normi ulatuses, kuid mitte üle käesolevas määruses kehtestatud piirmäärade.</tavatekst>
				</sisuTekst>
			</loige>
			<loige id="para1lg3">
				<loigeNr id="056eb227-daef-455a-8885-6fa7c607bd3a">3</loigeNr>
				<kuvatavNr id="a4eeb597-8e78-4794-bbef-152041969fe0"><![CDATA[(3)]]></kuvatavNr>
				<sisuTekst id="2ad85bc4-171a-4cdf-925f-c3e47c972981">
					<tavatekst id="1a82de1f-5fed-4f8b-a8d8-4aaa2ec46ace"> Vabariigi Valitsuse kinnitatud eluruumi sotsiaalselt põhjendatud norm on 18 m² eluruumi üldpinda perekonna iga liikme kohta ja lisaks 15 m² perekonna kohta. Kui alalise eluaseme üldpind on suurem kui normpind, siis võetakse toimetulekutoetuse määramisel alalised kulud arvesse normpinna ulatuses.</tavatekst>
				</sisuTekst>
			</loige>
			<loige id="para1lg4">
				<loigeNr id="6813ed02-002c-4941-9015-f90ba127e79a">4</loigeNr>
				<kuvatavNr id="901fa4b0-46df-43ab-8c65-2216fbcb0d52"><![CDATA[(4)]]></kuvatavNr>
				<sisuTekst id="c711d3e3-0ba8-44fd-b356-39a0314b21d7">
					<tavatekst id="a6505691-ea23-4c3a-9514-2d71819f1bca"> Eluruumis üksi elavale pensionärile ning osalise või puuduva töövõimega isikule, loetakse eluruumi sotsiaalselt põhjendatud normiks eluruumi tegelik suurus, kuid mitte rohkem kui 51m².</tavatekst>
				</sisuTekst>
			</loige>
		</paragrahv>
		<paragrahv id="para2">
			<paragrahvNr id="75419e2c-2421-4c63-8f09-78c4b65d321e">2</paragrahvNr>
			<kuvatavNr id="13d9da82-ee03-467e-93e4-560fbfa8e410"><![CDATA[§ 2. ]]></kuvatavNr>
			<paragrahvPealkiri id="d021cad0-cf61-4c99-9d8d-4e7b76988932">Eluasemekulude piirmäärad</paragrahvPealkiri>
			<loige id="para2lg1">
				<loigeNr id="0adef995-ffcb-4da0-b532-e790b3900d7e"/>
				<kuvatavNr id="d1fc85b0-17a4-4701-8dbe-3f80202d2c02"/>
				<sisuTekst id="8956b8b0-9d2d-4640-a1d4-6c5d48be738b">
					<tavatekst id="d4f5c9ba-fd8e-43e1-99e5-7bb5e21cbe65">Toimetulekutoetuse määramisel võetakse arvesse jooksval kuul tasumisele kuuluvad eluruumi alalised kulud järgmiselt:</tavatekst>
				</sisuTekst>
				<alampunkt id="para2lg1p1">
					<alampunktNr id="a2c89d5f-bb29-43c7-ab37-d233cb4a106c">1</alampunktNr>
					<kuvatavNr id="099e49a8-ecfd-438a-80d7-583bb9b42b0e"><![CDATA[1) ]]></kuvatavNr>
					<sisuTekst id="d9c917ca-b6fd-4844-bcbd-586e328e7eb1">
						<tavatekst id="36059ca3-61ec-473d-983f-a84bb6e8ac4e">korteriüür ja eluaseme soetamiseks võetud laenu tagasimakse, mis sisaldab laenu intressi ning kohustusliku eluasemekindlustuse makset, kuni 7,00 eurot eluruumi ühe ruutmeetri kohta kuus;</tavatekst>
					</sisuTekst>
					<muutmismarge id="84fa1b45-6eb1-42b3-82d8-dc367172ae5b">
						<avaldamismarge id="a417e958-39ad-4804-970f-95db37dbb345">
							<RTosa id="797fac7e-8494-45dc-88f2-2ed20c896fcb">RT IV</RTosa>
							<avaldamineKuupaev id="91c5ff0c-79f1-400b-888c-2a5b89a2470a">2022-08-27</avaldamineKuupaev>
							<RTartikkel id="97ea463a-edd5-4505-9517-54a39d25eec3">18</RTartikkel>
							<aktViide id="a8c1c652-01d2-4efd-9c57-68d3925399e5">427082022018</aktViide>
						</avaldamismarge>
						<joustumine id="3d9421e2-6471-4bf1-ab0b-833986506aee">2022-08-30</joustumine>
						<tavatekst id="3635dc93-6a72-49b1-b459-4e25161cfb24">, rakendatakse tagasiulatuvalt 01.07.2022.</tavatekst>
					</muutmismarge>
				</alampunkt>
				<alampunkt id="para2lg1p2">
					<alampunktNr id="ed7469cb-9de7-4682-8dc0-6e244b3a4801">2</alampunktNr>
					<kuvatavNr id="fb6924e5-f40f-401c-a291-da6b36616cf9"><![CDATA[2) ]]></kuvatavNr>
					<sisuTekst id="6ca7fcd5-bda9-4b5e-8197-ac377c77fa01">
						<tavatekst id="24ddf40b-e594-46e0-9724-0b33876b7157">korterelamu haldamise kulu, sealhulgas remondiga seotud kulu kuni 10,00 eurot eluruumi ühe ruutmeetri kohta kuus;</tavatekst>
					</sisuTekst>
				</alampunkt>
				<alampunkt id="para2lg1p3">
					<alampunktNr id="03eaed95-dcfc-4f3c-9f85-b7c27c7dec83">3</alampunktNr>
					<kuvatavNr id="d8e361d3-8b25-45ba-b211-eac5083441c5"><![CDATA[3) ]]></kuvatavNr>
					<sisuTekst id="5d02ab6e-11ab-4c07-b38e-1e0edf141cc0">
						<tavatekst id="5c32b466-65c7-423e-a6f1-0062f13954de">korterelamu renoveerimiseks võetud laenu tagasimakse kuni 5,00 eurot eluruumi ühe ruutmeetri kohta kuus;</tavatekst>
					</sisuTekst>
				</alampunkt>
				<alampunkt id="para2lg1p4">
					<alampunktNr id="8d8a0fef-1b6f-419e-82cc-0b8c4ed4fd0f">4</alampunktNr>
					<kuvatavNr id="32efc2a3-43eb-4117-988c-6ad1611422b4"><![CDATA[4) ]]></kuvatavNr>
					<sisuTekst id="0ebcdacb-d7e0-42b6-bd93-c214d417632d">
						<tavatekst id="13924f25-0c55-451a-b13f-1b75d75899e4">kaugküttega eluruumis tegelike kulude alusel normpinna kohta kuus. Kaugkütteta eluruumides kütuse (puit, brikett, kivisüsi, gaas, elekter, jms) eest kuni 15 eurot ühe ruutmeetri kohta kuus, kuid mitte rohkem kui 1000 eurot kalendriaastas. Kütuse ostmisel arvestatakse toimetulekuarvestuse sisse kuludokumendid, mis on ostetud taotluse esitamise eelsel või taotluse esitamise kalendrikuul;</tavatekst>
					</sisuTekst>
					<muutmismarge id="6f05f136-c085-48e6-b79e-8bfae8934f76">
						<avaldamismarge id="d1b2d52c-87af-409b-9119-2c41fa264707">
							<RTosa id="ebf2a2df-a088-49d6-b5a6-fc55929e71dd">RT IV</RTosa>
							<avaldamineKuupaev id="6ec3f5a2-3b5a-49f2-9d08-a9643acfdb14">2022-12-29</avaldamineKuupaev>
							<RTartikkel id="d1496a66-1e2d-402f-961b-1ab8e1c8e7f5">81</RTartikkel>
							<aktViide id="d92e49b2-ed95-40b7-ad5a-e76120b72cb1">429122022081</aktViide>
						</avaldamismarge>
						<joustumine id="34c33c7e-1755-4528-9b56-56aeab6e6457">2023-01-01</joustumine>
					</muutmismarge>
				</alampunkt>
				<alampunkt id="para2lg1p5">
					<alampunktNr id="0967da94-6a17-407e-af74-8629f3742377">5</alampunktNr>
					<kuvatavNr id="7dd20bac-aa07-46ec-a0b6-19f79e72b101"><![CDATA[5) ]]></kuvatavNr>
					<sisuTekst id="b4a9587f-caea-41a5-a08d-3dca25920e61">
						<tavatekst id="cccb342c-b7d3-42f8-b95a-135e1cdc1827">veevarustuse ja reovee ärajuhtimise teenuste maksumus kuni 4 kuupmeetrit iga pereliikme kohta kuus;</tavatekst>
					</sisuTekst>
				</alampunkt>
				<alampunkt id="para2lg1p6">
					<alampunktNr id="c757d3da-229e-4c1b-b546-73df6cfef17b">6</alampunktNr>
					<kuvatavNr id="a1689106-732c-48a3-b20f-410c3df89ef7"><![CDATA[6) ]]></kuvatavNr>
					<sisuTekst id="2c989bab-c2cd-424b-b481-23197534772b">
						<tavatekst id="7dfa890f-f33c-4ce3-9656-7be9d8be6590">soojaveevarustuseks tarbitud soojusenergia või kütuse maksumus kuni 25,00 eurot pereliikme kohta kuus;</tavatekst>
					</sisuTekst>
				</alampunkt>
				<alampunkt id="para2lg1p7">
					<alampunktNr id="6215e595-5208-4b32-a3bc-193d589ea262">7</alampunktNr>
					<kuvatavNr id="9da348e7-1d0f-463b-a78f-b77c01f224b7"><![CDATA[7) ]]></kuvatavNr>
					<sisuTekst id="1bdea058-fee0-469c-93e3-d9f1a8b883a9">
						<tavatekst id="e9689310-bc1e-4731-8fc7-18607fa0bbcb">elektrienergia tarbimisega seotud kulud kuni 60,00 eurot iga pereliikme kohta kuus;</tavatekst>
					</sisuTekst>
				</alampunkt>
				<alampunkt id="para2lg1p8">
					<alampunktNr id="dcf5ab29-c0c7-465a-90fa-e90d9fc3fd1d">8</alampunktNr>
					<kuvatavNr id="66415a89-6a7d-446e-aa98-635cd4680583"><![CDATA[8) ]]></kuvatavNr>
					<sisuTekst id="7d849c35-5a3e-45e9-8715-62459dd8d51e">
						<tavatekst id="db20e910-5a55-4b21-8b62-2cc7c27e76d8">majapidamisgaasi maksumus kuni 40,00 eurot pereliikme kohta kuus;</tavatekst>
					</sisuTekst>
				</alampunkt>
				<alampunkt id="para2lg1p9">
					<alampunktNr id="eb1ab572-494b-47a8-bec8-c82fcd5538cb">9</alampunktNr>
					<kuvatavNr id="ace940ab-0d82-446c-9bcf-65d3e5b2d4a3"><![CDATA[9) ]]></kuvatavNr>
					<sisuTekst id="74d6f122-9539-477c-81be-242fdbf9a8c5">
						<tavatekst id="44ccf8fd-53e9-4eea-acc3-54c1e621d7eb">tegelik olmejäätmete veotasu kuus;</tavatekst>
					</sisuTekst>
				</alampunkt>
				<alampunkt id="para2lg1p10">
					<alampunktNr id="0b860617-60f6-44ba-9de5-83b4316a37de">10</alampunktNr>
					<kuvatavNr id="187703fd-a295-4aed-8efe-0509729a53d5"><![CDATA[10) ]]></kuvatavNr>
					<sisuTekst id="657d7997-a3b2-450d-80c9-2ef7798be457">
						<tavatekst id="f84de83f-0434-4184-aeee-a9b6cfa12884">maamaksukulud, mille arvestamise aluseks on kolmekordne elamualune pind kuni 0,20 eurot ruutmeetri kohta;</tavatekst>
					</sisuTekst>
				</alampunkt>
				<alampunkt id="para2lg1p11">
					<alampunktNr id="e818a26d-99c2-4182-a60f-460f70bd22b5">11</alampunktNr>
					<kuvatavNr id="9967cc96-72d4-4801-a26d-1b4c40955a55"><![CDATA[11) ]]></kuvatavNr>
					<sisuTekst id="1c7e39fe-eea2-4d31-81b1-e81aeecdf96d">
						<tavatekst id="f45c7943-5f18-4153-af96-0c23b010db3a">hoonekindlustuse kulud, mis arvestatud kasutatavale eluruumile kuni 0,50 eurot normpinna ruutmeetri kohta.</tavatekst>
					</sisuTekst>
				</alampunkt>
			</loige>
		</paragrahv>
		<paragrahv id="para3">
			<paragrahvNr id="17faccf3-c9ea-47ac-b9e2-ab01b2724de9">3</paragrahvNr>
			<kuvatavNr id="cd22383b-1aee-443e-b4cf-0baadd3842ed"><![CDATA[§ 3. ]]></kuvatavNr>
			<paragrahvPealkiri id="7ca74e9e-b735-40f4-9818-f2e263bc917b">Rakendussätted</paragrahvPealkiri>
