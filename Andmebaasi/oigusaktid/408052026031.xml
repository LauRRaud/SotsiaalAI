							<aktViide id="513c74bd-1de0-4c66-822f-9a9c80a3630c">408052026010</aktViide>
						</avaldamismarge>
						<joustumine id="df917300-e757-409d-beb6-bbf6713d9c16">2026-05-11</joustumine>
					</muutmismarge>
				</alampunkt>
				<alampunkt id="para1lg1p5">
					<alampunktNr id="6077055e-67c4-4f07-b928-a89c3385d29e">5</alampunktNr>
					<kuvatavNr id="1fa0e90a-50c7-4c71-9ac1-f50460671875"><![CDATA[5) ]]></kuvatavNr>
					<sisuTekst id="0caab2c4-6056-4c95-afcb-6483016d19f1">
						<tavatekst id="c8453fe3-63d5-4210-ae93-bd81a833965e">Tsernobõli katastroofi likvideerimisel osalenu toetus 40 eurot;</tavatekst>
					</sisuTekst>
				</alampunkt>
				<alampunkt id="para1lg1p6">
					<alampunktNr id="c822d63f-0fcc-4e12-9bc6-19183723a5c7">6</alampunktNr>
					<kuvatavNr id="205991f2-ef9a-432d-892b-a3850d94411a"><![CDATA[6) ]]></kuvatavNr>
					<sisuTekst id="e1a2db36-5515-4160-ab38-fa587324fa92">
						<tavatekst id="e3510cad-fe4b-463c-b4de-ffb3e70035c2">ühekordne sotsiaaltoetus toimetuleku tagamiseks kuni 200 eurot;</tavatekst>
					</sisuTekst>
				</alampunkt>
				<alampunkt id="para1lg1p7">
					<alampunktNr id="56ad13b9-f8f0-49c3-942a-2781cef493a8">7</alampunktNr>
					<kuvatavNr id="abe178af-384e-40f5-a4ea-8ac7aa2e4745"><![CDATA[7) ]]></kuvatavNr>
					<sisuTekst id="72d1d3f4-ac42-4961-9fd2-ea987336fbac">
						<tavatekst id="c3e06bff-9c1f-4944-b143-eb40732f0b72">täiskasvanud raske puudega isiku hooldaja toetus 30 eurot;</tavatekst>
					</sisuTekst>
				</alampunkt>
				<alampunkt id="para1lg1p8">
					<alampunktNr id="794561dc-bf47-40c7-bd42-4e9e58a46607">8</alampunktNr>
					<kuvatavNr id="3354fc32-9be0-4a93-a10a-1a7da2aa93df"><![CDATA[8) ]]></kuvatavNr>
					<sisuTekst id="c416f4aa-aea8-4adc-9853-c15505b1b48c">
						<tavatekst id="8fb21a84-9beb-4c1d-ac9f-b44345988ae9">täiskasvanud sügava puudega isiku hooldaja toetus 40 eurot;</tavatekst>
					</sisuTekst>
				</alampunkt>
				<alampunkt id="para1lg1p9">
					<alampunktNr id="50ff7fe8-d260-4795-bc18-bcf06f773a77">9</alampunktNr>
					<kuvatavNr id="1b7df210-0733-4358-94ca-26b5eac6b5af"><![CDATA[9) ]]></kuvatavNr>
					<sisuTekst id="bd1419e3-3393-4794-81a7-ce1f34ebf0de">
						<tavatekst id="cc64f512-37bb-4455-9c5c-9ea74cc7b798">raske puudega lapse hooldajatoetus 50 eurot;</tavatekst>
					</sisuTekst>
				</alampunkt>
				<alampunkt id="para1lg1p10">
					<alampunktNr id="ff6d1f4f-611d-41c4-8b65-d876cf089d98">10</alampunktNr>
					<kuvatavNr id="a5159ddb-e040-4a1a-89d4-dbdc6389ffc4"><![CDATA[10) ]]></kuvatavNr>
					<sisuTekst id="ea1b503c-8539-4529-87c4-a4b3f24bebdb">
						<tavatekst id="3d10173e-21cd-42f9-9d40-31bc856b37b0">sügava puudega lapse hooldajatoetus 70 eurot.</tavatekst>
					</sisuTekst>
				</alampunkt>
			</loige>
		</paragrahv>
