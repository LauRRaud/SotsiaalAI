	<sisu id="19604a19-6932-4288-8979-006655c1efe6">
		<preambul id="752b0550-8f0f-4593-9aec-af6764255860">
			<tavatekst id="9ef31935-5c30-4f23-beb5-a8496700fed0">Määrus kehtestatakse kohaliku omavalitsuse korralduse seaduse § 22 lõike 1 punkti 5, sotsiaalhoolekande seaduse § 14 lõike 2 ning Viru-Nigula Vallavolikogu 27.01.2022 määruse nr 5 „Sotsiaalhoolekandelise abi andmise tingimused ja kord“ § 4 lõike 2 alusel.</tavatekst>
		</preambul>
		<paragrahv id="para1">
			<paragrahvNr id="b06d6e5f-1751-4fc1-a346-1f457a3d4650">1</paragrahvNr>
			<kuvatavNr id="17bfafff-98ed-4305-9da0-a96aa268aa4a"><![CDATA[§ 1. ]]></kuvatavNr>
			<sisuTekst id="1239e1c8-27bd-44e0-9934-60373e56418e">
				<tavatekst id="76ca845c-baba-406b-853e-133d833063ba">Kinnitada volikogu määrusest tulenevad sotsiaalhoolekandelise abi korras makstavate toetuste määrad ja piirsummad järgmiselt:</tavatekst>
			</sisuTekst>
			<loige id="para1lg1">
				<loigeNr id="973051e0-8b9c-4766-aaf3-ed5f58ad8ebc"/>
				<kuvatavNr id="1ef50c15-bf24-4540-8c40-4db4e41a2c76"/>
				<sisuTekst id="d0748bee-1736-49a5-9544-880dcf407e5e">
					<tavatekst id="ce2065c0-26ab-41c1-b6f6-6fba0c2db675"/>
				</sisuTekst>
				<alampunkt id="para1lg1p1">
					<alampunktNr id="09057d76-9e39-4b5c-8818-d5b7cfc0af6c">1</alampunktNr>
					<kuvatavNr id="7a8514f9-dade-45f2-8e01-f18851b95f93"><![CDATA[1) ]]></kuvatavNr>
					<sisuTekst id="a7f03ec0-35a7-493f-a3d0-cb2de1b31616">
						<tavatekst id="6f1c6ff9-d36a-491f-b7df-17f2f2c2f9ec">sünnitoetus 500 eurot;</tavatekst>
					</sisuTekst>
				</alampunkt>
				<alampunkt id="para1lg1p2">
					<alampunktNr id="0d18dca8-4ec4-44e9-93c6-b233f9a8c13c">2</alampunktNr>
					<kuvatavNr id="7c12c7f6-dc7f-4222-b33b-ba8b9e19cbad"><![CDATA[2) ]]></kuvatavNr>
					<sisuTekst id="0d76f5dd-6af7-4ca5-b18f-8f5ddf9e4c97">
						<tavatekst id="b2154523-691c-4e15-8a88-3b3e0306b7d8">matusetoetus 200 eurot;</tavatekst>
					</sisuTekst>
				</alampunkt>
				<alampunkt id="para1lg1p3">
					<alampunktNr id="011e18af-716b-4016-9ac5-019edd222401">3</alampunktNr>
					<kuvatavNr id="fbb850d1-16a9-4663-9ce7-e3e3bf557a39"><![CDATA[3) ]]></kuvatavNr>
					<sisuTekst id="77a8e07e-76db-4ecf-bcde-b21db5a57e6c">
						<tavatekst id="63e06ddb-0cc2-4557-a6ef-cf349c3652b9">eaka sünnipäevatoetuse kinkekaardi väärtus 15 eurot;</tavatekst>
					</sisuTekst>
				</alampunkt>
				<alampunkt id="para1lg1p4">
					<alampunktNr id="516621d2-fb87-4d9a-8ef8-d323e87ebc3a">4</alampunktNr>
					<kuvatavNr id="1b6a22a0-6ab7-4b16-bc93-da7c2542fc40"><![CDATA[4) ]]></kuvatavNr>
					<sisuTekst id="8faa39ca-8e4b-49f1-875b-e437144d7cda">
						<tavatekst id="a1102a44-b87e-4db7-ad51-1591a7b30fbf">ranitsatoetus 200 eurot;</tavatekst>
					</sisuTekst>
					<muutmismarge id="a666e8f2-647f-4162-8157-fac3d835c454">
						<avaldamismarge id="dfefddaf-a250-4dc7-80ef-f6e7efbb3339">
							<RTosa id="36901599-8aa3-496c-a9b5-01b9345e2b30">RT IV</RTosa>
							<avaldamineKuupaev id="fb5d4869-a284-490a-8573-a497f0634d59">2026-05-08</avaldamineKuupaev>
