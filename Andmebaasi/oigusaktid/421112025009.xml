			<pealkiri id="618f1fc1-893a-40f7-b88a-24bda5258b8e">Varjupaigateenuse osutamise kord</pealkiri>
		</nimi>
	</aktinimi>
	<muutmismarge id="483bc926-928a-416f-9fde-41931bbcfaf3">
		<aktikuupaev id="55e6a7d1-8604-492d-81d3-82c34ec285ca">2025-11-12</aktikuupaev>
		<avaldamismarge id="86f17f7b-359a-4b15-897a-a3825f057882">
			<RTosa id="0f2a9cc8-08c3-4b8f-9444-ff36e567227c">RT IV</RTosa>
			<avaldamineKuupaev id="629e8b0c-6da7-4b3c-89ff-4c2fcb883ded">2025-11-21</avaldamineKuupaev>
			<RTartikkel id="39dc2bc7-da3e-4802-b632-d5ca93608a0f">1</RTartikkel>
