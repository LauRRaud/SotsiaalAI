   <sisuTekst id="0e78b9a7-6836-431e-a183-a132f20a8789">
    <tavatekst id="6b135fe2-a0b2-43d5-b790-07aa96855e1d">Teenuse osutamise lõpetamise või pikendamise otsustab toimetulekutoetuse määramise eest vastutav spetsialist.</tavatekst>
   </sisuTekst>
  </loige></paragrahv><paragrahv id="para6">
