						<avaldamineKuupaev id="958325c4-3dff-4de6-8a6e-1d91a3186f01">2024-05-24</avaldamineKuupaev>
						<RTartikkel id="aa8c7c54-e1a0-442a-a340-994d34045ffd">13</RTartikkel>
						<aktViide id="20ca5864-c5c2-425e-af05-bcbece742dc7">424052024013</aktViide>
					</avaldamismarge>
					<joustumine id="0c75428c-8c29-430f-8c12-5977501a2312">2024-05-27</joustumine>
