		<paragrahv id="para7">
			<paragrahvNr id="98975b25-b161-4972-9e26-8459c5ee3d9e">7</paragrahvNr>
			<kuvatavNr id="e48e5a2b-d05d-4a25-bdb3-0f430028ba4b"><![CDATA[§ 7. ]]></kuvatavNr>
			<paragrahvPealkiri id="6d14a56e-f48b-45a9-881d-7cd48121f018">Eluruumi kohandamise kulu hüvitamise määramine</paragrahvPealkiri>
			<loige id="para7lg1">
				<loigeNr id="39c44d0b-83bb-456b-ae89-7966bf4b14d0">1</loigeNr>
				<kuvatavNr id="65afafa9-e353-4804-8b27-d699a9734ec4"><![CDATA[(1)]]></kuvatavNr>
				<sisuTekst id="94acd6d2-8eb5-4753-a2be-953b90be6554">
					<tavatekst id="114fef0e-8a84-42e3-ad66-0fa9b9f42a8a">Otsuse eluruumi kohandamise kulude hüvitamise kohta teeb vallavalitsus 10 tööpäeva jooksul.</tavatekst>
				</sisuTekst>
				<muutmismarge id="00e6a4e7-a36a-45ca-8fce-e2ffe228704f">
					<avaldamismarge id="9dd46f2f-ff16-415c-83a8-a85824c3943e">
						<RTosa id="cc7138b6-7c77-47ba-ab2a-7de42f32a7bd">RT IV</RTosa>
						<avaldamineKuupaev id="95d79845-0b72-4327-9a9e-7cdcf4df3b70">2024-05-24</avaldamineKuupaev>
						<RTartikkel id="d73f47ab-c5ae-4137-85b1-1fa8a24005e6">13</RTartikkel>
						<aktViide id="f1da2273-a7b9-4a0d-9ecb-15a145d89a42">424052024013</aktViide>
					</avaldamismarge>
					<joustumine id="378648f1-5329-440b-81a4-e604ad927924">2024-05-27</joustumine>
				</muutmismarge>
			</loige>
			<loige id="para7lg2">
				<loigeNr id="a7d1bf1f-8713-4786-997e-2c574b213823">2</loigeNr>
				<kuvatavNr id="db9c7810-a34d-4d69-a485-36275c27e306"><![CDATA[(2)]]></kuvatavNr>
				<sisuTekst id="646eeba8-06c9-4c84-96e1-265448ad062a">
					<tavatekst id="21267089-2ac0-4050-9d7f-dfcba7b59277"> Taotluse võib osaliselt rahuldada, kui eluruumi kohanduse tulemused on saavutatavad ka taotletust väiksema toetuse summaga.</tavatekst>
				</sisuTekst>
			</loige>
			<loige id="para7lg3">
				<loigeNr id="fbdd64fd-1335-4718-94a4-6dce9500c2a7">3</loigeNr>
				<kuvatavNr id="56d3d632-55f0-47d1-b290-0c9a99d5c124"><![CDATA[(3)]]></kuvatavNr>
				
				<muutmismarge id="ff639d20-7d9c-4188-80f3-1d3756b264c0">
					<tavatekst id="1c0f25dd-3082-46c6-8faa-f9d653d79f5c">Kehtetu - </tavatekst>
					<avaldamismarge id="8f6e5d2b-65e0-47af-91ea-1ae6533966d2">
						<RTosa id="3e3be026-28f8-4888-b3a3-7bb2c679c9b0">RT IV</RTosa>
						<avaldamineKuupaev id="0b8b78d6-0343-4c21-a0ce-63a17ad0335d">2024-05-24</avaldamineKuupaev>
						<RTartikkel id="a05c29e5-68b5-4d13-8fc8-af2ca411cfc2">13</RTartikkel>
						<aktViide id="560cdc35-710f-4aba-b160-22e3c749bcb6">424052024013</aktViide>
					</avaldamismarge>
					<joustumine id="a189a425-7a01-4cf0-bf32-6e540a21337c">2024-05-27</joustumine>
				</muutmismarge>
			</loige>
			<loige id="para7lg4">
				<loigeNr id="71bb3294-fd55-4d78-a755-da04852b7837">4</loigeNr>
				<kuvatavNr id="6acd8246-4d0b-43db-b28f-67228d9afeef"><![CDATA[(4)]]></kuvatavNr>
				<sisuTekst id="05943f1f-2c49-4c05-9da2-d054f3181b46">
					<tavatekst id="84cfebca-37ef-413a-8741-b799600eb77b"> Ühe kohanduse saaja jaoks antakse meetme tegevusest toetust üks kord.</tavatekst>
				</sisuTekst>
			</loige>
		</paragrahv>
		<paragrahv id="para8">
			<paragrahvNr id="979d8f5e-830f-432e-a131-be50b778cc09">8</paragrahvNr>
			<kuvatavNr id="f1a97ce9-7fbf-4323-833a-6684ea0c7c26"><![CDATA[§ 8. ]]></kuvatavNr>
			<paragrahvPealkiri id="74b7433d-07e0-4de8-a057-ca88e779abfe">Lepingu sõlmimine ja kohanduse elluviimine</paragrahvPealkiri>
			<loige id="para8lg1">
				<loigeNr id="4a52a820-1f63-4c4e-ab0f-9bfd92c9a69a">1</loigeNr>
				<kuvatavNr id="06df6eb7-cfe2-40eb-a8c0-a673d0f58127"><![CDATA[(1)]]></kuvatavNr>
				<sisuTekst id="8e1ea5f7-66f7-46f6-bdc5-aea13b3adabd">
					<tavatekst id="23fcdfc9-e657-44da-ab50-e420054c3065">Eluruumi kohanduste tegemiseks sõlmitakse vajalikud ehitustööde kokkulepped ja kahe- või kolmepoolsed lepingud ehitustööde teostamiseks.</tavatekst>
				</sisuTekst>
			</loige>
			<loige id="para8lg2">
				<loigeNr id="c2a3275b-001d-4255-8a40-a039bae815bf">2</loigeNr>
				<kuvatavNr id="85f76700-98a5-4f5a-ab99-cc45ca08a7f3"><![CDATA[(2)]]></kuvatavNr>
				<sisuTekst id="5d896750-4d12-46b8-a05e-4a1316648871">
					<tavatekst id="1c5ef7ab-a804-4bb9-ac68-29e067d98f38"> Lepingu sõlmimisel ja kulude hüvitamisel arvestatakse ka ehitusteatise olemasolu juhul, kui see on tööde teostamiseks nõutav.</tavatekst>
				</sisuTekst>
			</loige>
			<loige id="para8lg3">
				<loigeNr id="ff0717eb-9cce-45d5-926c-01e65b564433">3</loigeNr>
				<kuvatavNr id="48b68cc6-a976-4afd-aacb-7edeaf5fb7c8"><![CDATA[(3)]]></kuvatavNr>
				<sisuTekst id="7c4ace41-7fc0-414b-8eee-e537d8b55e0e">
					<tavatekst id="8fc7b2d0-3c0e-4491-bb30-e9fab2f609b3">Lepingus sätestatakse vähemalt: </tavatekst>
				</sisuTekst>
				<alampunkt id="para8lg3p1">
					<alampunktNr id="7e9c11c9-c13d-4e69-89f3-36fd15a940db">1</alampunktNr>
					<kuvatavNr id="5c8ba4af-aacc-4b33-bbbe-53ca625f856c"><![CDATA[1) ]]></kuvatavNr>
					<sisuTekst id="f5f616d3-2a2a-4f15-807e-77afed5d85e4">
						<tavatekst id="e9079e0f-3545-48bd-a118-f963a2e75499"> teostatavad kohandustööd;</tavatekst>
					</sisuTekst>
				</alampunkt>
				<alampunkt id="para8lg3p2">
					<alampunktNr id="c3199acb-01be-4725-a7d4-b2625534de14">2</alampunktNr>
					<kuvatavNr id="fd690757-0ab6-4718-9b6b-3ace0e2c647e"><![CDATA[2) ]]></kuvatavNr>
					<sisuTekst id="28c15258-4967-4d42-a07a-748aeed927bb">
						<tavatekst id="5326422f-0c1d-413c-b93a-73696e09d2f2">osapoolte rahalised kohustused, samuti vahe- ja/või lõpparuande esitamine, tööde ja väljamaksete tähtajad jm); </tavatekst>
					</sisuTekst>
				</alampunkt>
				<alampunkt id="para8lg3p3">
					<alampunktNr id="45296ac3-fc30-4e9b-b339-1d7ac7ba31c4">3</alampunktNr>
					<kuvatavNr id="cf5bb05e-9804-447a-a11b-1ef30db16650"><![CDATA[3) ]]></kuvatavNr>
					<sisuTekst id="df3ba7ff-e1eb-4d97-aeba-85e550273b5b">
						<tavatekst id="6037f101-9e21-483b-b827-63bffff9087f">kohandamise teostamise aeg; </tavatekst>
					</sisuTekst>
				</alampunkt>
				<alampunkt id="para8lg3p4">
					<alampunktNr id="5c759e64-dc92-433d-9ec6-617f66459e5c">4</alampunktNr>
					<kuvatavNr id="4b401f15-325a-4302-bae3-221ac02b10c2"><![CDATA[4) ]]></kuvatavNr>
					<sisuTekst id="aef06a31-a858-4a48-9872-9f3d320950f0">
						<tavatekst id="11487e0d-222b-466d-8d46-d127f894e35b"> vallavalitsuse õigused toetuse sihipärase kasutamise kontrollimisel;</tavatekst>
					</sisuTekst>
				</alampunkt>
				<alampunkt id="para8lg3p5">
					<alampunktNr id="41c72c5c-5680-4bb2-baa6-098585fddea6">5</alampunktNr>
					<kuvatavNr id="6006228f-eb12-4b71-9fc8-ccd56c82d6aa"><![CDATA[5) ]]></kuvatavNr>
					<sisuTekst id="93a6e403-46ad-4d5e-9239-631a36bfb6f2">
						<tavatekst id="d65086b7-70b4-4378-9a19-190f66cd8d73"> sanktsioonid lepingu rikkumise korral;</tavatekst>
					</sisuTekst>
				</alampunkt>
				<alampunkt id="para8lg3p6">
					<alampunktNr id="fabc9b0a-503f-42d7-ada0-8b7808b3266a">6</alampunktNr>
					<kuvatavNr id="7798887e-70b1-4ab9-b8f5-7c04494c3c7d"><![CDATA[6) ]]></kuvatavNr>
					<sisuTekst id="d6d93c5c-5661-42cf-8f14-e9df12a42dcd">
						<tavatekst id="9d39e4b9-1c50-42a2-a1a7-9c18779deadb">muud olulised tingimused. </tavatekst>
					</sisuTekst>
				</alampunkt>
			</loige>
			<loige id="para8lg4">
				<loigeNr id="97bbeac4-c6bf-4d4d-bc09-b4c250034e51">4</loigeNr>
				<kuvatavNr id="3f9c0bc2-dc42-4b46-a82f-e90c9ceca408"><![CDATA[(4)]]></kuvatavNr>
				<sisuTekst id="b5bde468-da63-40c5-bf85-a995d7df7d84">
					<tavatekst id="9072679c-ab87-4bcb-bc75-443060888d78"> Eluruumi kohandamiseks on aega kuni 12 kuud taotluse rahuldamise otsusest. Mõjuval põhjusel võidakse lepingus leppida kokku pikemas tähtajas.</tavatekst>
				</sisuTekst>
			</loige>
		</paragrahv>
		<paragrahv id="para9">
			<paragrahvNr id="2f104406-9af3-40e1-8c5f-c4c18f1fc8fb">9</paragrahvNr>
			<kuvatavNr id="c65b4e5e-f02b-4868-be33-58a4cc697c47"><![CDATA[§ 9. ]]></kuvatavNr>
			<paragrahvPealkiri id="5991aeda-b1ca-4846-8321-fca9176dab20">Eluruumi kohandustööde eest tasumine</paragrahvPealkiri>
			<loige id="para9lg1">
				<loigeNr id="18a8c7e8-1931-4cb7-babb-579e7cd0b6f9">1</loigeNr>
				<kuvatavNr id="9ec71952-3765-423a-b5f8-1498b19a6ba1"><![CDATA[(1)]]></kuvatavNr>
				<sisuTekst id="569e5bd6-cfdc-4b01-a381-7077b73dba6d">
					<tavatekst id="ccdd4e50-4829-4812-bbf8-603270271732">Hüvitise väljamaksmiseks esitab kohanduse saaja või ehitustööde teostaja vallavalitsuse vastutavale ametnikule kulu tõendavad dokumendid, mis peavad olema kooskõlas taotlusega koos esitatud hinnapakkumustega ja ehitustööde kokkuleppe/lepinguga.</tavatekst>
				</sisuTekst>
			</loige>
			<loige id="para9lg2">
				<loigeNr id="1ce7f55f-4d11-497e-b596-06302748d47a">2</loigeNr>
				<kuvatavNr id="ca6ef5db-8d84-4cc7-a341-caa206f8fe60"><![CDATA[(2)]]></kuvatavNr>
				<sisuTekst id="b360a361-6cdd-4c83-a1bf-2977f979cfb5">
					<tavatekst id="d33ccd4d-1cb6-4097-81d2-610ef49fe501">Pärast kuludokumentide saamist kontrollib sotsiaalhoolekande osakond koostöös majandusosakonnaga eluruumi kohandamiseks tehtud tööd ja kuludokumentide vastavust sellele ning koostab kontrollakti, milles märgitakse muuhulgas eluruumi kohandamiseks tehtud tööd, hinnang tehtud tööde ja kuludokumentide vastavusele ning hüvitamisele kuuluv lõplik summa. </tavatekst>
				</sisuTekst>
			</loige>
			<loige id="para9lg3">
				<loigeNr id="776acf4e-ab8e-449e-8d0f-ecfe2d584b1e">3</loigeNr>
				<kuvatavNr id="01473ff9-3dba-416a-9b35-ef4961e498f5"><![CDATA[(3)]]></kuvatavNr>
				<sisuTekst id="06ab39d2-1937-4e27-8434-90dec4c451ed">
					<tavatekst id="f38acb1a-7a9a-4b34-b888-9606b9387ab7">Hüvitis makstakse üldjuhul pärast kohanduste teostamist ja kontrollakti koostamist lepingus näidatud arvelduskontole 30 kalendripäeva jooksul. </tavatekst>
				</sisuTekst>
			</loige>
			<loige id="para9lg4">
				<loigeNr id="f4c55037-41dd-4c0f-97b4-af19e4067914">4</loigeNr>
				<kuvatavNr id="4f33764b-55ce-47be-a4a4-4da6931e8d61"><![CDATA[(4)]]></kuvatavNr>
				<sisuTekst id="c0f25ce6-990c-47ed-b1a5-492d03adf0aa">
					<tavatekst id="ce516271-804d-4b4c-9ef0-36ffa428bd4c">Lepingu või ehitustööde kokkuleppe kohaselt tehtud tööde eest tasub vallavalitsus. </tavatekst>
				</sisuTekst>
			</loige>
			<loige id="para9lg5">
				<loigeNr id="ede8000f-6e31-4bee-80d4-007b432d8bce">5</loigeNr>
				<kuvatavNr id="78e69231-0076-4175-b61b-9cb66f13a6d9"><![CDATA[(5)]]></kuvatavNr>
				<sisuTekst id="c8f96376-9199-4c3f-9df5-ca721901b32a">
					<tavatekst id="3d5ff1c6-0f71-4f7e-bcaf-f9ed8e1e3c4f">Kohanduse saaja tasub tööde eest osas, mis ületab vallavalitsuse poolt määratud toetuse. </tavatekst>
				</sisuTekst>
				<muutmismarge id="1f6e184e-0426-4ff1-89a7-fc78323d2fed">
					<avaldamismarge id="f17b6299-c4bb-42be-9791-ca897b018721">
						<RTosa id="2af21f6d-6301-4440-a9de-aae15b61d342">RT IV</RTosa>
						<avaldamineKuupaev id="8854f80a-8694-458c-a701-da6e5522a92e">2024-05-24</avaldamineKuupaev>
						<RTartikkel id="3fa69135-5ee7-41ec-93fa-2687cfadea91">13</RTartikkel>
						<aktViide id="3f27636c-513d-4d84-96d5-78cdb7049c2f">424052024013</aktViide>
					</avaldamismarge>
					<joustumine id="ab1a6301-ab0b-493c-97d3-32b5eca74bbb">2024-05-27</joustumine>
				</muutmismarge>
			</loige>
		</paragrahv>
		<paragrahv id="para10">
			<paragrahvNr id="b7d56b6e-4cde-4a62-8905-71abaae521d1">10</paragrahvNr>
			<kuvatavNr id="7ff1b022-66a7-48f2-96c5-1a1a83ad4114"><![CDATA[§ 10. ]]></kuvatavNr>
			<paragrahvPealkiri id="304214f3-6872-43c8-9ca7-cd955685036f">Dokumentide säilitamine </paragrahvPealkiri>
			<loige id="para10lg1">
				<loigeNr id="e8d8263b-1f9b-48e6-ac2d-559b62bd86ef"/>
				<kuvatavNr id="f916e0b5-eedc-4035-b6a0-566fb159060a"/>
				<sisuTekst id="f05af64a-e861-4eb5-9233-1db64240e0a2">
					<tavatekst id="6b713f6b-b895-47de-94d5-77a3bb025f79"> Vallavalitsus säilitab kohandamisega seotud dokumente vastavalt vallavalitsuse kehtestatud asjaajamise korrale.</tavatekst>
				</sisuTekst>
				<muutmismarge id="8b05d8b8-f7db-4864-81b9-d653e1fc088e">
					<avaldamismarge id="a3fa136e-5e3d-4f36-80de-e29212979236">
						<RTosa id="61cc933b-61b3-41d2-b7c1-962a62c01396">RT IV</RTosa>
						<avaldamineKuupaev id="dab95209-842b-4713-aa92-494a1116b571">2024-05-24</avaldamineKuupaev>
						<RTartikkel id="dc5eeb47-e4cf-40dc-94e1-de0d6f707d67">13</RTartikkel>
						<aktViide id="8cd42d72-e209-4ccf-8f2d-edebd1c97f9a">424052024013</aktViide>
					</avaldamismarge>
