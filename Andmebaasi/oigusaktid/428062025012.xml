   </sisuTekst>
  </alampunkt><alampunkt id="para3lg8p2">
   <alampunktNr id="282e45e2-a2bd-4153-93f6-5451e91b2802">2</alampunktNr>
   <kuvatavNr id="92090ab5-cdd1-438b-8aa7-89939dae34f5"><![CDATA[2) ]]></kuvatavNr>
