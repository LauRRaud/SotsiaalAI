  </alampunkt></loige><loige id="para3lg9">
   <loigeNr id="27631295-78c2-4767-ba11-464a70eb48fe">9</loigeNr>
   <kuvatavNr id="ac84eb07-fd4b-42f7-a23e-bbd84aea6e5f"><![CDATA[(9)]]></kuvatavNr>
   <sisuTekst id="5670f6ef-b10a-4ac9-acf4-49483074173b">
    <tavatekst id="46c625c8-ddf7-491c-9d2d-4844c9f42ca7">Taotlus jäetakse rahuldamata, kui taotleja või taotlus ei vasta määruses sätestatud tingimustele.</tavatekst>
   </sisuTekst>
  </loige><loige id="para3lg10">
   <loigeNr id="c5e0c264-20cd-43eb-badf-984c5552c401">10</loigeNr>
   <kuvatavNr id="ce20d353-738a-42c5-9f7c-dd00df3c1507"><![CDATA[(10)]]></kuvatavNr>
   <sisuTekst id="c9b90e6f-8a44-4a83-bf8a-5460473c7dfb">
    <tavatekst id="78e4149f-c6c6-4a4c-bdcf-05f0e161d24c">Kui taotleja ei ilmu mõjuva põhjuseta vaimse tervise teenuse vahetu osutaja vastuvõtule määratud ajal või on esitanud teenuse saamiseks valeandmeid, siis on teenuse korraldajal õigus nõuda taotlejalt teenuse vahetu osutaja tasu hüvitamist.</tavatekst>
   </sisuTekst>
  </loige></paragrahv><paragrahv id="para4">
   <paragrahvNr id="ed92ab85-4246-4019-82d1-454de23a2847">4</paragrahvNr>
   <kuvatavNr id="fcf0ff23-eb0f-47db-b3b9-7ccf6e143d63"><![CDATA[§ 4. ]]></kuvatavNr>
   <paragrahvPealkiri id="702249bb-6f5a-4657-b24a-86c1cfc90623">Teenuse rahastamine</paragrahvPealkiri>
  <loige id="para4lg1">
   <loigeNr id="e6578c84-4805-4965-93aa-cd74d7a86332"/>
   <kuvatavNr id="eab6ce72-f9e5-4e90-b9e9-ca4b4c08f95f"/>
   <sisuTekst id="3786cc21-1722-4c1d-9b1d-aeeafbeab362">
    <tavatekst id="a7dae3d1-138f-4713-baaa-1b661e80bcb9">Teenust rahastatakse valla eelarvest, sealhulgas SHS § 156 lõike 3<sup>9</sup> kohaselt riigieelarvest vallale määratud toetusest.</tavatekst>
   </sisuTekst>
  </loige></paragrahv><paragrahv id="para5">
   <paragrahvNr id="c7b11e65-42f6-4875-92c4-3ca0ac9acff1">5</paragrahvNr>
   <kuvatavNr id="182718cc-4fa4-4fff-97da-550259534774"><![CDATA[§ 5. ]]></kuvatavNr>
   <paragrahvPealkiri id="f26a0659-9681-48d8-8df8-deadee837e2b">Teenuse korraldaja kohustused </paragrahvPealkiri>
  <loige id="para5lg1">
   <loigeNr id="92c1b8d8-ef83-488a-be74-e843f1289a45">1</loigeNr>
   <kuvatavNr id="82d42b17-f9d9-45b6-917c-bfd862703a5d"><![CDATA[(1)]]></kuvatavNr>
   <sisuTekst id="6fe8e16d-d6e2-4456-a177-9c574ea2c3c3">
    <tavatekst id="98f668e0-445e-4f9c-9a86-4db6af613aa9">Teenuse korraldaja tagab, et teenuse vahetul osutajal on tema teenuse osutamiseks SHS § 156 lõikes 3<sup>9</sup> sätestatud asjakohane ettevalmistus.</tavatekst>
   </sisuTekst>
  </loige><loige id="para5lg2">
   <loigeNr id="b6edb341-947b-40e5-834d-7b06a1876fb9">2</loigeNr>
   <kuvatavNr id="03964fe7-ebf2-4276-9473-698cd8392199"><![CDATA[(2)]]></kuvatavNr>
   <sisuTekst id="4a9709b5-c9f2-4304-b61e-53b9e23540c3">
    <tavatekst id="becdf0bd-0431-4633-a973-41c3ab3b61eb">Teenuse korraldaja tagab, et teenuse vahetul osutajal on tema teenuse osutamiseks SHS § 156 lõikes 39 sätestatud asjakohane ettevalmistus.</tavatekst>
   </sisuTekst>
  </loige><loige id="para5lg3">
   <loigeNr id="86effeed-1d0c-46b3-be42-73007216f170">3</loigeNr>
   <kuvatavNr id="aaa6925a-57e3-4660-817b-c06d7bedc171"><![CDATA[(3)]]></kuvatavNr>
   <sisuTekst id="a337077a-9939-4142-bb57-72c1026834cf">
    <tavatekst id="cb6dca0c-027b-4615-bf3d-2fd3e0ceb2f4">Teenuse korraldaja esitab hiljemalt iga aasta 10. jaanuaril Saaremaa Vallavalitsuse sotsiaalvaldkonna eest vastutava struktuuriüksuse juhile digitaalselt allkirjastatud aruande § 4 nimetatud raha kasutamise kohta eelneval kalendriaastal aasta lõpu seisuga.</tavatekst>
   </sisuTekst>
  </loige><loige id="para5lg4">
   <loigeNr id="c20c8874-4391-41d7-8d45-a9ee9c81429f">4</loigeNr>
   <kuvatavNr id="2d8be669-cdcd-421c-b1ce-05808e6706c9"><![CDATA[(4)]]></kuvatavNr>
   <sisuTekst id="6ef5663d-c372-4fff-a01e-49d0a302f467">
    <tavatekst id="0b88a5ab-2a44-40f8-8dac-ebcc893e23fb">Teenuse korraldaja teavitab teenuse osutamise alustamisel valla elanikke teenusest ja selle osutamise korraldusest.</tavatekst>
   </sisuTekst>
  </loige></paragrahv><paragrahv id="para6">
   <paragrahvNr id="3b1b63d4-b67f-4af8-a64a-b067a36bf88c">6</paragrahvNr>
   <kuvatavNr id="6c35bb88-a4b8-407d-a0e2-816eae5b5309"><![CDATA[§ 6. ]]></kuvatavNr>
   <paragrahvPealkiri id="3c839b88-e678-4e28-8c92-ba02411918ca">Määruse jõustumine</paragrahvPealkiri>
  <loige id="para6lg1">
   <loigeNr id="c9375a6b-f5ba-4cfe-a74e-5d3539f55c1c"/>
   <kuvatavNr id="1fc6dc84-ac87-42eb-9877-049de16048e3"/>
   <sisuTekst id="2d8b5442-9186-4e99-9a0d-346332754c7e">
    <tavatekst id="8bad853d-a643-443f-9268-98660950d71c">Määrus jõustub 1. juulil 2025. a.</tavatekst>
   </sisuTekst>
  </loige></paragrahv></sisu>
<allkiri id="232f4195-eb49-451e-a098-a08d08db8a6d"><allkiriKoht id="77eb979d-d7a4-4d8c-9b18-bdccd34f9d2d"/><allkirjastaja id="2c691702-a786-410a-9c08-78d90aad1132"><ametinimetus id="589561e7-dcc6-4521-9bfa-bb0e03639876">volikogu esimees</ametinimetus><eesnimi id="bf168334-a0fe-4c0b-b37e-123817ee5ed9">Jaanus</eesnimi><perekonnanimi id="77634f9f-0b44-4df8-b8ae-4e8d87ce0b5e">Tamkivi</perekonnanimi></allkirjastaja></allkiri></oigusakt>