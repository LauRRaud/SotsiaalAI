   </sisuTekst>
  </alampunkt><alampunkt id="para2lg3p5">
   <alampunktNr id="65e760c2-549e-417e-8a66-8324b35563b4">5</alampunktNr>
   <kuvatavNr id="8dba61a5-b80b-41dc-9c2e-1998f7faee9c"><![CDATA[5) ]]></kuvatavNr>
   <sisuTekst id="012aea3a-4872-4f1e-8979-49a10750adaa">
    <tavatekst id="a2f8caf6-9d51-4b9d-8d45-52d568b18084">kriisinõustamise teenus;</tavatekst>
   </sisuTekst>
  </alampunkt><alampunkt id="para2lg3p6">
   <alampunktNr id="f436108f-cc21-42c6-95e4-9855e5bf4ca7">6</alampunktNr>
   <kuvatavNr id="30510487-921c-49bc-ae2b-1fca2705f878"><![CDATA[6) ]]></kuvatavNr>
   <sisuTekst id="8159fe23-c364-4925-a4d7-195ff0e21e49">
    <tavatekst id="dcb12ee4-f323-4f45-945d-b6714ec013c2">leinanõustamise teenus;</tavatekst>
   </sisuTekst>
  </alampunkt><alampunkt id="para2lg3p7">
   <alampunktNr id="bea0011c-f763-449a-a325-702ce7734d5c">7</alampunktNr>
   <kuvatavNr id="286e1fd8-cd63-445b-aeb6-0f46eba6f7d0"><![CDATA[7) ]]></kuvatavNr>
   <sisuTekst id="912b98fb-f3ac-457c-9ad5-f7791e4fced6">
    <tavatekst id="d4754fad-2842-4290-b2d2-ba5c3f53b9ba">vajaduse korral muu nõustamisteenus.</tavatekst>
   </sisuTekst>
  </alampunkt></loige></paragrahv><paragrahv id="para3">
   <paragrahvNr id="31618edb-fa8d-4f69-bcf6-d99e7f9000a2">3</paragrahvNr>
   <kuvatavNr id="7d02e581-427c-455a-800b-53a5f0baf63d"><![CDATA[§ 3. ]]></kuvatavNr>
   <paragrahvPealkiri id="de10cacb-d530-40ba-894f-ae95d71bdcb8">Teenuse korraldus</paragrahvPealkiri>
  <loige id="para3lg1">
   <loigeNr id="78ce1bd6-18c6-4acd-a67f-15d97c274bd6">1</loigeNr>
   <kuvatavNr id="65d1cceb-d0c2-4a91-b91d-0d0f3a45a0dd"><![CDATA[(1)]]></kuvatavNr>
   <sisuTekst id="d715bba8-8e38-461c-a0cb-f0e1d3504118">
    <tavatekst id="267f28a3-24e3-4baa-954a-d1b016697d5c">Teenust korraldab Saaremaa Vallavalitsuse hallatav asutus Saaremaa Toetava Hariduse Keskus (edaspidi <i>teenuse korraldaja)</i>.</tavatekst>
   </sisuTekst>
  </loige><loige id="para3lg2">
   <loigeNr id="a3d23f56-f519-420c-a78d-42c329b61589">2</loigeNr>
   <kuvatavNr id="939e739a-a5b0-4bd1-bda1-ec52b3762143"><![CDATA[(2)]]></kuvatavNr>
   <sisuTekst id="50cf7547-2263-46f7-bbe3-3672caaa2c2f">
    <tavatekst id="c76f0c3f-5cfd-41fe-8255-b2152edf46e2">Teenuse vahetu osutaja on füüsiline või juriidiline isik, kes osutab teenust teenuse korraldaja töötajana või teenuse korraldajaga sõlmitud lepingu alusel.</tavatekst>
   </sisuTekst>
  </loige><loige id="para3lg3">
   <loigeNr id="efcb3a23-be4d-4fcf-b910-34b292ab2440">3</loigeNr>
   <kuvatavNr id="092c9039-4bd7-4974-8dce-da6ac79495da"><![CDATA[(3)]]></kuvatavNr>
   <sisuTekst id="98fac627-bad8-4b73-b5b8-ab7e135d59ad">
    <tavatekst id="266a7c31-fbce-4636-be5a-75ff71cb6321">Teenusele saamise taotlus esitatakse suuliselt või kirjalikult teenuse korraldajale. </tavatekst>
   </sisuTekst>
  </loige><loige id="para3lg4">
   <loigeNr id="f50fb748-f3c1-4c79-abe4-bd13ab873e38">4</loigeNr>
   <kuvatavNr id="2a3ebb9c-dc7e-43b2-9988-ef173b21fc85"><![CDATA[(4)]]></kuvatavNr>
   <sisuTekst id="adc5c2b1-d859-4938-b0cf-b7e0bd07e4cf">
    <tavatekst id="1ed287ca-08d4-477e-bbb0-f94b59b8b326">Taotluse võib esitada isik enda kohta ise või selle võib esitada temaga seotud isik, sealhulgas pereliige, eestkostja või volitatud isik.</tavatekst>
   </sisuTekst>
  </loige><loige id="para3lg5">
   <loigeNr id="a2c22e1c-5070-4d0c-b245-008d3683881b">5</loigeNr>
   <kuvatavNr id="07e6aeea-024f-42e3-b1f5-72263f83202d"><![CDATA[(5)]]></kuvatavNr>
   <sisuTekst id="fb999ed7-2809-453f-b3f5-2817f8d2686c">
    <tavatekst id="8ca0ccaf-2ecc-4e0e-a80a-db779dea238f">Paragrahvi 2 lõikes 3 nimetatud vaimse tervise teenused on valla elanikele tasuta määras, mille on kehtestanud Saaremaa Vallavalitsus korraldusega.</tavatekst>
   </sisuTekst>
  </loige><loige id="para3lg6">
   <loigeNr id="485590f3-7e28-4d8e-9d57-cb8719c7ee74">6</loigeNr>
   <kuvatavNr id="aef5b646-a0f3-45ab-b85a-9854b7041eb2"><![CDATA[(6)]]></kuvatavNr>
   <sisuTekst id="e7a176cb-7f3d-4eb2-a419-8063d8601b36">
    <tavatekst id="6f23a41a-5b06-4255-915d-4dc6c542dc4a">Teenuse osutamise otsustab teenuse korraldaja.</tavatekst>
   </sisuTekst>
  </loige><loige id="para3lg7">
   <loigeNr id="9fdef15f-dcf2-48d1-9dcb-849d3b9102dc">7</loigeNr>
   <kuvatavNr id="0d6bda1b-3f08-4625-ae24-95f61f247b1d"><![CDATA[(7)]]></kuvatavNr>
   <sisuTekst id="5e874b64-1ef7-48a8-8f37-28f471006070">
    <tavatekst id="8a1bf73b-038f-48fc-b5ed-3bdf0c0a73db">Otsuse tasuta teenuse mahu suurendamise, sellest keeldumise või § 2 lõike 3 punktis 7 nimetatud muu nõustamisteenuse määramise kohta teeb Saaremaa Vallavalitsuse sotsiaalkomisjon kirjaliku taotluse alusel kümne tööpäeva jooksul alates nõuetekohase taotluse esitamisest ja abivajaduse hindamisest. Otsust ette valmistaval Saaremaa Vallavalitsuse ametnikul on õigus nõuda taotlejalt asja otsustamiseks vajalike dokumentide või teabe esitamist.</tavatekst>
   </sisuTekst>
  </loige><loige id="para3lg8">
   <loigeNr id="99bd66e0-55e3-4926-8aa1-209c1b8b4a9f">8</loigeNr>
   <kuvatavNr id="54484bf4-ad06-49c7-90ed-72606fee7aa1"><![CDATA[(8)]]></kuvatavNr>
   <sisuTekst id="a63cbb77-ed8e-458f-9794-c344de535008">
    <tavatekst id="8c23e9e2-c518-43d1-a5bc-3ebba1205093">Lõikes 7 nimetatud taotluses märgitakse järgmised abi vajava isiku andmed:</tavatekst>
   </sisuTekst>
  <alampunkt id="para3lg8p1">
   <alampunktNr id="1c7f365f-bab5-4eca-8686-c57ac3a59b3c">1</alampunktNr>
   <kuvatavNr id="39d872f2-1302-4c04-abd9-3e57f9676b2a"><![CDATA[1) ]]></kuvatavNr>
   <sisuTekst id="ae161362-b57f-49f0-b86a-46429fed5281">
