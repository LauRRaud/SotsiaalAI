		<allkirjastaja id="66eee24e-9555-4e8b-8f75-ff4ebfeaa770">
			<ametinimetus id="d532266e-c25c-4c2e-80cb-f98015679cff">Volikogu esimees</ametinimetus>
			<eesnimi id="f497ff38-eaa5-48c5-8103-d76fa74a2667">Tanel</eesnimi>
			<perekonnanimi id="11d1604e-6522-4941-91c6-029841a43294">Mõistus</perekonnanimi>
		</allkirjastaja>
