   <pealkiri id="31f7a903-7a0b-484d-a67a-7c6466d33b1a">Eluruumi alaliste kulude piirmäärad toimetulekutoetuse määramisel</pealkiri>
  </nimi>
 </aktinimi>
 <sisu id="8714871f-4178-4af7-b12a-df88d178197d"><preambul id="add1147d-1ae4-4d81-9105-8ecc1edff43b"><tavatekst id="d05f0731-d45e-45ea-ad10-4eeca8d3dd52">Määrus kehtestatakse kohaliku omavalitsuse korralduse seaduse § 6 lõike 1, § 22 lõike 2, sotsiaalhoolekande seaduse § 133 lõigete 5 ja 6 alusel.</tavatekst></preambul><paragrahv id="para1"><paragrahvNr id="e6ac016c-642b-45e4-ac04-93e6f608c853">1</paragrahvNr><kuvatavNr id="aa005a58-aacb-49b5-ae76-e2d2467093a5"><![CDATA[§ 1. ]]></kuvatavNr><paragrahvPealkiri id="bd4319d5-935b-4ec5-ac64-d1a4d36641bd">Üldsätted</paragrahvPealkiri><loige id="para1lg1"><loigeNr id="ae3e3cc4-a216-4f9f-ab9c-f95dfb845e35">1</loigeNr><kuvatavNr id="2d6a32e3-8022-4888-b0ad-e0fe4816609a"><![CDATA[(1)]]></kuvatavNr><sisuTekst id="38c7453b-5b51-46f5-a9fe-12075c5a6267"><tavatekst id="4cbf44f5-69d0-4554-8ba9-b64133c21499">Toimetulekutoetuse arvestamisel võetakse eluasemekuluna arvesse sotsiaalhoolekande seaduse § 133 lõikes 5 loetletud kulud.</tavatekst></sisuTekst></loige><loige id="para1lg2"><loigeNr id="4b44f796-737e-4736-993c-c2f14237d537">2</loigeNr><kuvatavNr id="efd84e00-69df-43f9-8138-ddcf4923dd8a"><![CDATA[(2)]]></kuvatavNr><sisuTekst id="c97789a2-bccd-4deb-acc4-c85353cbd0c1"><tavatekst id="8fc2b71b-6327-4d17-8063-e62b2338c054">Toimetulekutoetuse määramisel võetakse arvesse:</tavatekst></sisuTekst><alampunkt id="para1lg2p1"><alampunktNr id="009fd108-4403-4414-b949-67bc84d80baf">1</alampunktNr><kuvatavNr id="acbe7079-87cd-4150-bade-d40d0583b344"><![CDATA[1) ]]></kuvatavNr><sisuTekst id="ddbc0ebc-e59b-4396-89f6-4ea99b810551"><tavatekst id="c9eebe8b-dc55-4bd2-9f0a-bab077db4998">Vabariigi Valitsuse poolt kinnitatud eluruumi sotsiaalselt põhjendatud norm, mis on 18 m² eluruumide üldpinda perekonna iga liikme kohta ja täiendavalt 15 m² perekonna kohta või</tavatekst></sisuTekst></alampunkt><alampunkt id="para1lg2p2"><alampunktNr id="219f5c1a-fbf7-4027-b91d-bacc9e734aff">2</alampunktNr><kuvatavNr id="408e9f6d-a38a-4900-9b2f-27b74aa76aec"><![CDATA[2) ]]></kuvatavNr><sisuTekst id="338c868d-d1dc-43fe-b07a-37ece904fd3c"><tavatekst id="f70b481b-faee-4903-baea-b3a9bd290df3">normpinnana eluruumi üldpind, kui eluruumi tubade arv on võrdne selles eluruumis alaliselt elavate inimeste arvuga ja eluruumi üldpind on sotsiaalselt põhjendatud normist suurem;</tavatekst></sisuTekst></alampunkt><alampunkt id="para1lg2p3"><alampunktNr id="913b279e-1fc9-4e15-b99c-4b4947623248">3</alampunktNr><kuvatavNr id="4624814d-c922-4016-96f5-b4baa0ebcdcd"><![CDATA[3) ]]></kuvatavNr><sisuTekst id="79847265-385d-442d-8e90-83de9f1f8e6f"><tavatekst id="d6149087-b533-420a-a667-523c9d01beb4">eluruumis üksi elavatele pensionäridele võib toimetulekutoetuse määramisel arvestada normpinnaks kuni 51 m².</tavatekst></sisuTekst></alampunkt></loige><loige id="para1lg3"><loigeNr id="4a7045f9-c3ce-4e63-8385-8c075c9587c6">3</loigeNr><kuvatavNr id="cc20bfde-e079-422f-bfa1-669c91d168b3"><![CDATA[(3)]]></kuvatavNr><sisuTekst id="dbb83d26-ee24-4f89-8802-bd2cdea4c6b6"><tavatekst id="5a17c4ee-98a3-48c1-b1f5-7e308eac3222">Toimetulekutoetuse määramisel võetakse aluseks eluruumi tegelikud kulud, kuid mitte üle vallavolikogu poolt käesolevas määruses kehtestatud piirmäärade.</tavatekst></sisuTekst></loige></paragrahv><paragrahv id="para2"><paragrahvNr id="315cb85a-99e6-4418-8d42-b16f8b0a5312">2</paragrahvNr><kuvatavNr id="a3e49985-6db9-4530-aa3f-619a3ec63394"><![CDATA[§ 2. ]]></kuvatavNr><paragrahvPealkiri id="a0a67915-d64e-4f6d-aa27-799642dcccb0">Eluruumi alaliste kulude piirmäärad toimetuleku arvestamisel</paragrahvPealkiri><loige id="para2lg1"><loigeNr id="1650d65e-0c4b-40f6-9084-27583b7d4aba">1</loigeNr><kuvatavNr id="3a0f4bbe-64fb-413a-aa5b-193712cb796b"><![CDATA[(1)]]></kuvatavNr><sisuTekst id="d7f08b9a-820a-4be2-bcda-38211de09454"><tavatekst id="be8f8c1f-0419-434b-a2dc-00f04f1f8009">Toimetuleku arvestamisel arvesse võetavate jooksval kuul tasumisele kuuluvate eluruumi alaliste kulude piirmäärad on järgmised:</tavatekst></sisuTekst><alampunkt id="para2lg1p1"><alampunktNr id="ca72ee69-83c2-462f-890f-99d938f6e876">1</alampunktNr><kuvatavNr id="ae6de71e-331b-4c31-8bd4-185f4b30dab7"><![CDATA[1) ]]></kuvatavNr><sisuTekst id="d9be564d-1ce4-4bc7-809c-858a021ed40b"><tavatekst id="4277ace4-e221-45dc-9055-140443e15c14">korteriüür - kuni 7 eurot ühe ruutmeetri kohta;</tavatekst></sisuTekst></alampunkt><alampunkt id="para2lg1p2"><alampunktNr id="0db1c052-cce5-494a-b512-df3e9922987d">2</alampunktNr><kuvatavNr id="af8e029c-358d-4757-a6fb-b3eb42a6a3df"><![CDATA[2) ]]></kuvatavNr><sisuTekst id="fcc72191-49d9-4c35-881c-c9e2ca546c4b"><tavatekst id="6356ed53-90b9-4d14-a4c5-93fc26da754c">korterelamu haldamise kulu, sealhulgas remondiga seotud kulu - kuni 6 eurot ühe ruutmeetri kohta;</tavatekst></sisuTekst></alampunkt><alampunkt id="para2lg1p3"><alampunktNr id="e419e844-839f-45a8-9b64-5f65e6f37735">3</alampunktNr><kuvatavNr id="72210783-d147-4345-8e5f-42ecbe76569d"><![CDATA[3) ]]></kuvatavNr><sisuTekst id="fb0caa20-f95c-4eec-80d3-4868b2b409e0"><tavatekst id="684a41ec-ca73-449f-97af-d99acca1f5c9">korterelamu renoveerimiseks võetud laenu tagasimakse - kuni 6 eurot ühe ruutmeetri kohta;</tavatekst></sisuTekst></alampunkt><alampunkt id="para2lg1p4"><alampunktNr id="0f784a67-4220-4899-b3ba-a83ffd30cb33">4</alampunktNr><kuvatavNr id="a0f999c3-8a53-487b-8f2a-2d5f568ab8fd"><![CDATA[4) ]]></kuvatavNr><sisuTekst id="55e1f270-8aa8-4e55-8aa1-b074961c619d"><tavatekst id="fdd218cd-d063-44a5-82e8-8669e72a91f2">vee- ja kanalisatsiooniteenuse maksumus 5 kuupmeetrit inimese kohta kuus, summas kuni 35 eurot;</tavatekst></sisuTekst></alampunkt><alampunkt id="para2lg1p5"><alampunktNr id="68bb8b82-d50a-4c83-9d0f-48f0ea67a4b1">5</alampunktNr><kuvatavNr id="29681c08-3b3f-4bff-a573-e7753f732a2d"><![CDATA[5) ]]></kuvatavNr><sisuTekst id="53942eab-17e1-41a2-bae0-4378e2083d3e"><tavatekst id="ade533f0-eb22-4fa0-aba1-790ea2657456">soojaveevarustuseks tarbitud soojusenergia või kütte maksumus inimese kohta kuus summas kuni 25 eurot;</tavatekst></sisuTekst></alampunkt><alampunkt id="para2lg1p6"><alampunktNr id="1cfb466a-f733-44e6-bc5d-45d116a59ab3">6</alampunktNr><kuvatavNr id="30246b59-0a40-48b2-8d9b-72064ac17d3e"><![CDATA[6) ]]></kuvatavNr><sisuTekst id="c34530f3-28a6-41da-8752-44cb00a89f6c"><tavatekst id="78f441ed-dc4a-493b-a457-1a6c481b16ba">kütte maksumus kaugküttega eluruumi puhul - kuni 5,50 eurot ühe ruutmeetri kohta kuus;</tavatekst></sisuTekst></alampunkt><alampunkt id="para2lg1p7"><alampunktNr id="0f2af606-c916-4f17-b7e0-fb17ae153603">7</alampunktNr><kuvatavNr id="2a10634d-4636-447b-9dc4-80c32cc0decd"><![CDATA[7) ]]></kuvatavNr><sisuTekst id="891fa8e7-0afd-4612-8b60-42b60a3e42cf"><tavatekst id="1a6d9d00-ae05-4b59-93d6-1c803b91e7f0">kaugkütteta eluruumi puhul (ahi-, gaasi, elektri- või kombineeritult koos elektriküttega) - kuni 10 eurot normpinna ühe ruutmeetri kohta;</tavatekst></sisuTekst></alampunkt><alampunkt id="para2lg1p8"><alampunktNr id="e200e7ac-b107-429a-9e0c-45dcbe3f278c">8</alampunktNr><kuvatavNr id="06c114f8-650b-408a-a00a-367345dcb0a7"><![CDATA[8) ]]></kuvatavNr><sisuTekst id="c38504c2-e8f6-47af-8127-8bdac97dc90d"><tavatekst id="b553c773-7476-402c-a0b2-dbfa2ee663c5">elektrienergia maksumus - kuni 80 eurot üheliikmelise pere kohta kuus ning kuni 60 eurot iga järgneva pereliikme kohta kuus;</tavatekst></sisuTekst></alampunkt><alampunkt id="para2lg1p9"><alampunktNr id="84698d17-9a7d-4608-b44f-176c5eedd218">9</alampunktNr><kuvatavNr id="5ecdbeba-b542-44e4-a242-d7a12991f3d0"><![CDATA[9) ]]></kuvatavNr><sisuTekst id="b3487bc7-4ef5-43f1-9f9a-0094c95535aa"><tavatekst id="ff24a32c-69eb-4ff7-a12f-7b1f38fb99e6">majapidamisgaas - maksumusega kuni 60 eurot, kuid mitte rohkem kui neli gaasiballooni aastas;</tavatekst></sisuTekst></alampunkt><alampunkt id="para2lg1p10"><alampunktNr id="fd1c58f5-62f0-4da7-88b1-dde5b53974de">10</alampunktNr><kuvatavNr id="05351ef6-3d5e-415c-be90-98fd5d33478a"><![CDATA[10) ]]></kuvatavNr><sisuTekst id="b248f44a-875e-424d-ba95-904dbf77a73b"><tavatekst id="6cae4d21-e617-402b-8354-95b403cb7883">maamaksukulud, mille arvestamise aluseks on kolmekordne elamualune pind kuni 0,30 eurot ühe ruutmeetri kohta kuus;</tavatekst></sisuTekst></alampunkt><alampunkt id="para2lg1p11"><alampunktNr id="5724a742-7b59-4502-9920-de01dc2681f2">11</alampunktNr><kuvatavNr id="bc1f2a84-7152-46bd-ac21-299a94ef4cb1"><![CDATA[11) ]]></kuvatavNr><sisuTekst id="81285b4d-d992-4aae-8061-a09692fc3c73"><tavatekst id="2efcef95-eae0-48d8-b8bd-fcc8b1f5ead1">hoonekindlustuse kulud - kuni 3 eurot ühe ruutmeetri kohta;</tavatekst></sisuTekst></alampunkt><alampunkt id="para2lg1p12"><alampunktNr id="41af931e-dbfd-4e64-afa4-cf9f2a4ab39e">12</alampunktNr><kuvatavNr id="fa6f5b65-6dff-4b4b-b5b6-ad395d02f1b9"><![CDATA[12) ]]></kuvatavNr><sisuTekst id="757d1c65-c213-46c5-a0ee-90c5581ace59"><tavatekst id="84b2feab-2f9d-4fd9-ae6b-10b9455cb1a0">tegelik olmejäätmete veotasu - kuni 12 eurot üheliikmelise pere kohta kuus ning kuni 9 eurot iga järgneva pereliikme kohta kuus;</tavatekst></sisuTekst></alampunkt><alampunkt id="para2lg1p13"><alampunktNr id="501ec17c-e337-46d4-b43e-faf4fdc26c7b">13</alampunktNr><kuvatavNr id="be55944b-06fc-49f4-a84a-6e8995d267f2"><![CDATA[13) ]]></kuvatavNr><sisuTekst id="228a60ba-eb75-406c-b71d-6705bd8338cc"><tavatekst id="c4be6cb9-06ec-402b-9293-4cc253074587">eluaseme soetamiseks võetud laenu tagasimakse, mis sisaldab ka laenu intressi ja kohustusliku eluasemekindlustuse makset - kuni 7 eurot ühe ruutmeetri kohta.</tavatekst></sisuTekst></alampunkt></loige><loige id="para2lg2"><loigeNr id="c0820d67-a8b5-442b-9ffe-7e3c136a7ef7">2</loigeNr><kuvatavNr id="f1a627bc-214e-47e8-9173-f9c202a2f7e8"><![CDATA[(2)]]></kuvatavNr><sisuTekst id="f06c5b15-f9db-4454-a697-5c0b3451e3f9"><tavatekst id="345944dc-f10a-4c54-ac0c-07772d940008">Kui kuludokumendil kajastub järgneva perioodi küttekulu, kompenseeritakse kulu järgnevatel kuudel vastavalt kehtestatud piirmäärale kuludokumendil näidatud summa kompenseerimiseni või kuni uue kuludokumendi esitamiseni.</tavatekst></sisuTekst></loige></paragrahv><paragrahv id="para3"><paragrahvNr id="be1e86e0-2aeb-4c76-9e8d-893baf5e40cd">3</paragrahvNr><kuvatavNr id="f16267f3-c7b8-427a-b58b-e93497188466"><![CDATA[§ 3. ]]></kuvatavNr><paragrahvPealkiri id="2c4a48ee-bbcc-478e-b590-870df64c7ab3">Rakendussätted</paragrahvPealkiri><loige id="para3lg1"><loigeNr id="7612e3af-a033-4c0f-9c83-85b29eef1dbd">1</loigeNr><kuvatavNr id="cd4acd71-7b6c-411a-a069-66a6e8b8801c"><![CDATA[(1)]]></kuvatavNr><sisuTekst id="8cf3b05a-0676-4400-9388-dac9267e4f5e"><tavatekst id="7cfa456c-e8a9-4265-a08c-accc36a06a56">Tunnistatakse kehtetuks Kadrina Vallavolikogu 29.06.2022 määrus nr 4 "Eluruumi alaliste kulude piirmäärad toimetulekutoetuse määramisel".</tavatekst></sisuTekst></loige><loige id="para3lg2"><loigeNr id="17d86e63-7893-4931-bebe-6664e21050c6">2</loigeNr><kuvatavNr id="eaf81661-0a12-401a-8820-174fd18e952e"><![CDATA[(2)]]></kuvatavNr><sisuTekst id="f25cb923-1146-420f-a1d4-b8e99c130075"><tavatekst id="69c5c4f9-4520-42ca-877e-c467089ac8d6">Määrust rakendatakse alates 1. juulist 2025.</tavatekst></sisuTekst></loige></paragrahv><paragrahv id="para4"><paragrahvNr id="9e42ca72-d6a8-42ce-a98f-a619f15cdafe">4</paragrahvNr><kuvatavNr id="2679c6d8-1c21-4ee2-8015-239fcde74781"><![CDATA[§ 4. ]]></kuvatavNr><paragrahvPealkiri id="a8359808-f6c4-47b8-98ae-2413faca4cb2">Määruse jõustumine</paragrahvPealkiri><loige id="para4lg1"><loigeNr id="242f007d-e326-46d2-9918-7b4c787df14a"/><kuvatavNr id="e3c42bec-6bd8-45a5-8329-a25c7284f16f"/><sisuTekst id="abc58c01-db64-41ec-b3a1-13db15fe8263"><tavatekst id="69ef3d61-71c2-4138-b47c-cce723cf48b2">Määrus jõustub kolmandal päeval pärast Riigi Teatajas avaldamist.</tavatekst></sisuTekst></loige></paragrahv></sisu>
<allkiri id="eea14c42-6a5e-4bdd-9e03-18bcf914fb9e"><allkiriKoht id="9ddf7f57-2a34-446a-92b3-a4eabda55a17"/><allkirjastaja id="dcb0488a-5173-4426-8c8d-dfd1701c6add"><ametinimetus id="76d5f4ce-cc9d-447a-b39a-cadd9a373994">Vallavolikogu esimees</ametinimetus><eesnimi id="9d5c898e-2137-4e90-b998-ce9c5a8ae203">Madis</eesnimi><perekonnanimi id="a0f46fb6-9a9a-4b76-8dfa-5a6faa3c85b9">Viise</perekonnanimi></allkirjastaja></allkiri></oigusakt>