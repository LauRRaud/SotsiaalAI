						<tavatekst id="062444a7-76e7-4e7b-9e31-e20072cac7b1">hoonekindlustuse kulu – ainult konkreetsele kasutatavale alalisele eluruumile kuni 1 eurot 1 m² kohta kuus;</tavatekst>
					</sisuTekst>
				</alampunkt>
				<alampunkt id="para3lg1p11">
					<alampunktNr id="9cc50faf-17e3-4ea6-9067-debc81493a14">11</alampunktNr>
					<kuvatavNr id="71b989ec-28fe-4298-a113-586bcaeb0031"><![CDATA[11) ]]></kuvatavNr>
					<sisuTekst id="56f46fdb-5c13-4f62-84b0-8cbc81c69072">
						<tavatekst id="02b5dfbc-fa3e-4e08-bb31-76a2935afd36">olmejäätmete veotasu – kuni 8 eurot pereliikme kohta kuus;</tavatekst>
					</sisuTekst>
				</alampunkt>
