							<RTartikkel id="4120282b-a1a4-4c49-b664-2f12e92678d0">6</RTartikkel>
							<aktViide id="c8fba4eb-2492-401c-8649-168eb6eab95a">413022026006</aktViide>
						</avaldamismarge>
