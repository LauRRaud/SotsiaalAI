							<aktViide id="326a6d7c-6bcd-4bcd-b04a-a34f70934433">430122023002</aktViide>
						</avaldamismarge>
						<joustumine id="2613ccf8-8bf7-403f-ac54-f055a2838fe8">2024-01-02</joustumine>
					</muutmismarge>
				</alampunkt>
				<alampunkt id="para2lg1p2">
					<alampunktNr id="cf3705c6-eab0-4500-a28f-ef1b267b093e">2</alampunktNr>
					<kuvatavNr id="8707374a-476f-47a6-8e72-e335ed8d354f"><![CDATA[2) ]]></kuvatavNr>
					<sisuTekst id="57fb62f0-29c9-4a0a-87c3-df1e13b0be13">
						<tavatekst id="e28c2273-e226-4534-95f7-48730565be06">korterelamu haldamise kulu, sealhulgas remondiga seotud kulu - kuni 5 eurot 1 m<sup>2</sup> kohta kuus;</tavatekst>
					</sisuTekst>
				</alampunkt>
				<alampunkt id="para2lg1p3">
					<alampunktNr id="7df83905-dfaa-4023-89b6-d5f743b6c2f9">3</alampunktNr>
					<kuvatavNr id="10515d83-f9ff-4425-afbf-6fb8a0f769a3"><![CDATA[3) ]]></kuvatavNr>
					<sisuTekst id="e596ac9e-8bad-4771-afa7-7b72d6369281">
						<tavatekst id="a372a977-ee35-4357-86b0-767920770340">korterelamu renoveerimiseks võetud laenu tagasimakse kulu – kuni 5 eurot 1 m<sup>2</sup> kohta kuus;</tavatekst>
					</sisuTekst>
				</alampunkt>
				<alampunkt id="para2lg1p4">
					<alampunktNr id="52752412-eb80-4b27-a45e-88e9bbf44523">4</alampunktNr>
					<kuvatavNr id="57e04bf0-08f7-4484-b7af-5364a735115e"><![CDATA[4) ]]></kuvatavNr>
					<sisuTekst id="5934455b-4059-4784-94ee-b0ba8e2cda58">
						<tavatekst id="2a9eac27-84ac-4cb0-aa4e-933e7cbbd5d0">veevarustuse ja reovee ärajuhtimise teenuse maksumus kuni 20 eurot üheliikmelise pere kohta kuus ja 16 eurot iga järgneva pereliikme kohta kuus;</tavatekst>
					</sisuTekst>
					<muutmismarge id="a069ffc7-fd3a-428b-bc7b-44b5319f4f4c">
