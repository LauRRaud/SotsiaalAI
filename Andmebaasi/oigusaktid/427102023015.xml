   <pealkiri id="24cbe2d8-7f92-4316-b63e-71531d76b775">Eluasemekulude piirmäärade kehtestamine toimetulekutoetuse määramisel</pealkiri>
  </nimi>
 </aktinimi>
 <sisu id="ba108084-eee8-4abf-8505-14be7938a0f2"><preambul id="42fff990-c165-4940-850a-45290d289e63"><tavatekst id="4c81d541-a65d-4db4-a183-c3905161d10d">Määrus kehtestatakse sotsiaalhoolekande seaduse § 133 lõike 6 ja Põltsamaa Vallavolikogu 20.04.2023 otsuse nr 1-3/2023/27 „Sotsiaalhoolekande seadusest tulenevate ülesannete delegeerimine“ alusel.</tavatekst></preambul><paragrahv id="para1"><paragrahvNr id="fe83499b-e8cf-4e1c-aec3-26e54b1dae25">1</paragrahvNr><kuvatavNr id="326b334c-468c-40c5-ac21-535649379feb"><![CDATA[§ 1. ]]></kuvatavNr><paragrahvPealkiri id="5d33669b-e100-422e-a815-8a023d3ce799">Reguleerimisala</paragrahvPealkiri><loige id="para1lg1"><loigeNr id="7d8b90e4-0e9c-4173-90c0-6951f1b59f70"/><kuvatavNr id="b94f6d14-6969-4b4e-8b46-8644597c5603"/><sisuTekst id="180ec171-a37f-4c53-87b5-8f636f43a7cc"><tavatekst id="652966fa-8e48-4392-930b-c3161b3bd391">Määrusega kehtestatakse toimetulekutoetuse määramisel eluasemekulude piirmäärad Põltsamaa vallas.</tavatekst></sisuTekst></loige></paragrahv><paragrahv id="para2"><paragrahvNr id="d5d98bd6-1dfd-4caf-bfa8-ed026f5bb1ee">2</paragrahvNr><kuvatavNr id="fe7509c0-cac8-4549-b1f3-b2d31df43232"><![CDATA[§ 2. ]]></kuvatavNr><paragrahvPealkiri id="f7db951a-fca1-4d62-ac32-aa5faa63a5a8">Toimetulekutoetuse arvestamise alused</paragrahvPealkiri><loige id="para2lg1"><loigeNr id="425a5ecd-987a-4ca9-847a-2ecb80a7e8af">1</loigeNr><kuvatavNr id="5bc74f32-a43d-437b-999a-fe7bc49e27b4"><![CDATA[(1)]]></kuvatavNr><sisuTekst id="29e176fc-2189-4301-96b5-6c90a7107790"><tavatekst id="12f4681c-a96b-4679-a31f-ffb499c07dd6">Eluasemekuludeks loetakse sotsiaalhoolekande seaduse § 133 lõikes 5 loetletud kulud.</tavatekst></sisuTekst></loige><loige id="para2lg2"><loigeNr id="40219402-34ab-4ba0-97ab-2d222f86024a">2</loigeNr><kuvatavNr id="5ae2c32e-c682-4cd3-ad40-403b8f498245"><![CDATA[(2)]]></kuvatavNr><sisuTekst id="33d6616e-0e02-49f3-b8dc-8f5f6de26135"><tavatekst id="ca3ec469-57b5-450a-bfa7-55fb0bb9362f">Toimetulekutoetuse määramisel võetakse arvesse Vabariigi Valitsuse 26.01.1999 määrusega nr 38 „Eluruumi sotsiaalselt põhjendatud norm ja selle rakendamise erisused“ kinnitatud eluruumi sotsiaalselt põhjendatud norm.</tavatekst></sisuTekst></loige><loige id="para2lg3"><loigeNr id="ede2e7fc-5923-43e4-ac6d-b553a83ff310">3</loigeNr><kuvatavNr id="559b3e71-7355-43cb-94a1-33e46969ce58"><![CDATA[(3)]]></kuvatavNr><sisuTekst id="19fa7a38-e7df-41fb-bcfa-cd1a4b9ec141"><tavatekst id="dc6a7a07-68f0-425f-93fd-625053cdbc04">Toimetulekutoetuse määramisel võetakse aluseks jooksval kuul tasumisele kuuluvad ja eluruumi dokumentaalselt tõestatud tegelikud kulud, mis ei ületa käesoleva määrusega kehtestatud piirmäärasid.</tavatekst></sisuTekst></loige></paragrahv><paragrahv id="para3"><paragrahvNr id="8760e80e-2ffd-4fb2-bccb-6b0ed641060e">3</paragrahvNr><kuvatavNr id="721260d1-d320-4502-ade9-b48a9be885f9"><![CDATA[§ 3. ]]></kuvatavNr><paragrahvPealkiri id="56184605-ae84-456f-98cb-176ce5fbdba3">Piirmäärad</paragrahvPealkiri><loige id="para3lg1"><loigeNr id="968b21e7-f134-4efd-b515-725d5520c473"/><kuvatavNr id="3510abd7-fe39-45fd-abbe-19f6929cda80"/><sisuTekst id="4a043818-5088-48f5-8032-7ce49770717c"><tavatekst id="bd2f2016-532a-4be5-bd49-28b66eb65a98">Toimetulekutoetuse määramisel arvesse võetavate eluasemekulude piirmäärad on järgmised:</tavatekst></sisuTekst><alampunkt id="para3lg1p1"><alampunktNr id="4d393f70-1463-440c-bc2b-19cecb16c362">1</alampunktNr><kuvatavNr id="a4666ee4-2a14-4174-95ab-6a7bdec0a240"><![CDATA[1) ]]></kuvatavNr><sisuTekst id="7b927d9d-3c70-4de4-afc5-ef8debdc08b5"><tavatekst id="bfb8c926-02a3-4710-bf29-2fd7dd0453ef">üür – kuni 8 eurot eluruumi normpinna ühe ruutmeetri kohta kuus;</tavatekst></sisuTekst></alampunkt><alampunkt id="para3lg1p2"><alampunktNr id="7d1c4777-249d-4044-82de-067ce359ba16">2</alampunktNr><kuvatavNr id="190a3d9a-f642-4206-97ea-fefe5a040ba2"><![CDATA[2) ]]></kuvatavNr><sisuTekst id="cbdbd629-b946-48e8-abd5-08b0e608e1ec"><tavatekst id="cf661af1-36c6-4692-8e77-e9af4f14ab52">eluaseme soetamiseks võetud laenu tagasimakse, mis sisaldab ka laenu intressi ja kohustuslikku eluasemekindlustuse makset, kuni 8 eurot ühe normpinna m² kohta;</tavatekst></sisuTekst></alampunkt><alampunkt id="para3lg1p3"><alampunktNr id="2cacc60b-5264-4a84-8251-b50e132f687f">3</alampunktNr><kuvatavNr id="35407fef-dd66-42fa-8b8e-be07444fb737"><![CDATA[3) ]]></kuvatavNr><sisuTekst id="6ff6a469-70ad-4754-8ab2-ba5d71e33d6e"><tavatekst id="ff416b91-8dca-447f-861b-b2b60b422bdd">korterelamu haldamise kulu, sealhulgas remondiga seotud kulu – kuni 5 eurot eluruumi normpinna ühe ruutmeetri kohta kuus;</tavatekst></sisuTekst></alampunkt><alampunkt id="para3lg1p4"><alampunktNr id="0699dbc2-7001-4e74-a5ca-8f8555fc6386">4</alampunktNr><kuvatavNr id="a7e8fe04-6526-41bb-8fd3-f9f92ab33520"><![CDATA[4) ]]></kuvatavNr><sisuTekst id="4d15f897-a459-4139-8791-8b0326610c8d"><tavatekst id="4f429c12-afbc-4540-adb6-fef73dc5ec9e">korterelamu renoveerimiseks võetud laenu tagasimakse – kuni 5 eurot eluruumi normpinna ühe ruutmeetri kohta kuus;</tavatekst></sisuTekst></alampunkt><alampunkt id="para3lg1p5"><alampunktNr id="fe9f8934-0818-470c-8b0e-da6415a1042e">5</alampunktNr><kuvatavNr id="770b6824-19cc-4d2b-abe7-98f2e1350fb0"><![CDATA[5) ]]></kuvatavNr><sisuTekst id="3941d3e0-3ba2-4ea0-8c21-5ba60c0d890a"><tavatekst id="9be3d56c-2787-4e8e-a4c9-6dca6fd3a798">veevarustuse ja reovee ärajuhtimise teenuste maksumus - kuni 20 eurot ühe pereliikme kohta kuus;</tavatekst></sisuTekst></alampunkt><alampunkt id="para3lg1p6"><alampunktNr id="e75b1d64-d22d-46e2-a23b-575619f79325">6</alampunktNr><kuvatavNr id="44969cfd-c386-444e-a398-095f0d8d447d"><![CDATA[6) ]]></kuvatavNr><sisuTekst id="4b4e8e0a-8bb7-4826-814a-c3ffb6b3bfd8"><tavatekst id="53d0c95e-9c5d-400c-97a9-89d9fec26d44">ühisveevärgi ja -kanalisatsiooniga mitteliitunutele kompenseeritakse septiku tühjendamist kuni 2 korda aastas, kuni 60 eurot kord ja kogumismahuti tühjendamist kuni 4 korda aastas, kuni 60 eurot kord;</tavatekst></sisuTekst></alampunkt><alampunkt id="para3lg1p7"><alampunktNr id="723ef5ee-43fa-488c-a3d2-52a80843c17d">7</alampunktNr><kuvatavNr id="9355d7e8-97a2-4f93-bf8a-9dc003db426e"><![CDATA[7) ]]></kuvatavNr><sisuTekst id="0278cc28-b76d-45c2-b4b4-27e3f0894c31"><tavatekst id="7d579b82-3e94-4e60-a456-a5a40e334af6">soojaveevarustuseks tarbitud soojusenergia või kütuse maksumus – kuni 10 eurot eluruumi normpinna ühe ruutmeetri kohta kuus;</tavatekst></sisuTekst></alampunkt><alampunkt id="para3lg1p8"><alampunktNr id="3bb7d6cf-84a5-4536-b39d-e50799e17ee4">8</alampunktNr><kuvatavNr id="65190b84-04d5-4e29-a978-5af5a30bd3ca"><![CDATA[8) ]]></kuvatavNr><sisuTekst id="ad129688-d3fe-46fe-af36-f97b96af6bec"><tavatekst id="5056f860-02e2-45db-ae86-f651e13b696f">kütteks tarbitud soojaenergia või kütuse maksumus – kuni 14 eurot eluruumi normpinna ühe ruutmeetri kohta kuus ning lokaalse kütte korral kuni 1400 eurot aastas. Juhul, kui kuludokument sisaldab ka järgneva perioodi kulu, hüvitatakse see järgnevatel kuudel piirmäära ulatuses kuludokumendil näidatud summa hüvitamiseni või uue kuludokumendi esitamiseni;</tavatekst></sisuTekst></alampunkt><alampunkt id="para3lg1p9"><alampunktNr id="5756d7b3-5cb4-472e-9796-4694f22af48c">9</alampunktNr><kuvatavNr id="7dd5ba7f-e1c2-431c-9317-b2f2ff8a86da"><![CDATA[9) ]]></kuvatavNr><sisuTekst id="123afcdb-0009-40b3-afc7-069b31b3c66d"><tavatekst id="aabd5179-099c-4bbf-b1c8-baa25a74187e">elektrienergia tarbimisega seotud kulu – kuni 65 eurot üheliikmelise pere kohta kuus ning kuni 50 eurot iga järgneva pereliikme kohta kuus;</tavatekst></sisuTekst></alampunkt><alampunkt id="para3lg1p10"><alampunktNr id="b1891215-3c2d-4516-8861-4eb74056c0e5">10</alampunktNr><kuvatavNr id="7b11f65a-f370-4cc2-9a53-2c1885ce12d6"><![CDATA[10) ]]></kuvatavNr><sisuTekst id="11d1e58b-67ec-424f-9dea-3fe6e9cb4d5f"><tavatekst id="f4b8e391-fd8d-4feb-8073-ab2e16a86363">majapidamisgaasi maksumus – kuni 50 eurot pere kohta kolme kuu jooksul;</tavatekst></sisuTekst></alampunkt><alampunkt id="para3lg1p11"><alampunktNr id="1a79e983-68fd-4d3f-bc4b-baa74fdbfa3e">11</alampunktNr><kuvatavNr id="e25319fc-3dcc-4308-8ba7-d5bce55cca63"><![CDATA[11) ]]></kuvatavNr><sisuTekst id="4adaa67b-060c-4d68-800a-e1f08e2d8753"><tavatekst id="dbc74d4e-cb01-4ff5-8a3d-66b3ae86cb1f">maamaksukulu, mille arvestamise aluseks on kolmekordne elamualune pind – kuni 0,25 eurot ühe ruutmeetri kohta kuus;</tavatekst></sisuTekst></alampunkt><alampunkt id="para3lg1p12"><alampunktNr id="206d9854-353f-4265-926e-da7d1c8268a0">12</alampunktNr><kuvatavNr id="9a617fa7-2ae1-42b2-a888-0955bae7b068"><![CDATA[12) ]]></kuvatavNr><sisuTekst id="dd3348e1-0a43-478d-9747-7ee94cfb0270"><tavatekst id="1a725b92-d476-49f6-a633-9c2dbf46da8f">hoonekindlustuse kulud – kuni 1 euro eluruumi normpinna ruutmeetri kohta kuus;</tavatekst></sisuTekst></alampunkt><alampunkt id="para3lg1p13"><alampunktNr id="3acbad34-ee9a-413e-a60c-f26f788c8b7c">13</alampunktNr><kuvatavNr id="5bf4bf63-7d00-4cdd-b2b8-750e086241d4"><![CDATA[13) ]]></kuvatavNr><sisuTekst id="cd543299-c726-4865-b267-ba24486ad669"><tavatekst id="f2c50666-8a0f-4b37-b408-fe00e0f9c896">olmejäätmete veotasu – kuni 8 eurot ühe pereliikme kohta kuus.</tavatekst></sisuTekst></alampunkt></loige></paragrahv><paragrahv id="para4"><paragrahvNr id="2e030b93-e001-4bf4-854c-762bb3f00ea9">4</paragrahvNr><kuvatavNr id="b392da37-7935-4493-bd0a-316124659029"><![CDATA[§ 4. ]]></kuvatavNr><paragrahvPealkiri id="01ad7753-7303-4f95-a781-823b13967cb7">Määruse jõustumine</paragrahvPealkiri><loige id="para4lg1"><loigeNr id="d759550c-4ec5-4bbd-a605-768696dfcd48"/><kuvatavNr id="dd58977b-f302-4815-8747-9a1c9ed4f38a"/><sisuTekst id="72f400d6-fdbd-49e9-9262-6f6e28aa4a74"><tavatekst id="d3b3c433-7e4a-4c84-8d1e-c470accdf08c">Määrus jõustub 1. novembril 2023.</tavatekst></sisuTekst></loige></paragrahv></sisu>
