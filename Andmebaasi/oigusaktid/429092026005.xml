5eba4ebeffc1">perenõustamine;</tavatekst></sisuTekst></alampunkt><alampunkt id="para2lg4p7"><alampunktNr id="c0bfe0bd-2fd7-4d31-acbc-f4fd9663b136">7</alampunktNr><kuvatavNr id="7188ac5d-e63a-4a10-b293-66b834855482"><![CDATA[7) ]]></kuvatavNr><sisuTekst id="12e66e39-dd05-423b-ad9d-51ed3bd683c1"><tavatekst id="7ba96b9d-c9a7-4f86-8b31-0f3109f91b00">pereteraapia;</tavatekst></sisuTekst></alampunkt><alampunkt id="para2lg4p8"><alampunktNr id="a6875fa3-7caa-41b8-8a7e-de312364da8d">8</alampunktNr><kuvatavNr id="c225da57-b578-4166-b2c2-09eb2f484000"><![CDATA[8) ]]></kuvatavNr><sisuTekst id="bc4adc06-3512-4532-b353-791bbaef7283"><tavatekst id="2b5ba51d-aa59-4a3d-8f62-6b634e33391b">muu alaealisele, täiskasvanule või perekonnale suunatud teenus.</tavatekst></sisuTekst></alampunkt></loige></paragrahv><paragrahv id="para3"><paragrahvNr id="4f760e15-4d55-4d51-a88f-5c2301c27b1b">3</paragrahvNr><kuvatavNr id="793e387a-70ef-4991-ab71-dae4fb9597dc"><![CDATA[§ 3. ]]></kuvatavNr><paragrahvPealkiri id="c0e66c26-58d8-432d-95b7-ec4fdbe640c4">Teenuse saajad</paragrahvPealkiri><loige id="para3lg1"><loigeNr id="1d16a2c4-7da0-4ad9-ad73-5c6759a37ac6">1</loigeNr><kuvatavNr id="b0ee5602-c346-407a-b8e0-0a2aeda60ed8"><![CDATA[(1)]]></kuvatavNr><sisuTekst id="ca8806b1-abb3-4ded-81d7-7b558f4014e1"><tavatekst id="7288a435-783c-41ef-a131-d48ffb236ab5">Teenust on õigust saada isikul, kelle tegelik ja rahvastikuregistrijärgne elukoht on Põlva vallas ja</tavatekst></sisuTekst><alampunkt id="para3lg1p1"><alampunktNr id="ce8cc8dc-3eeb-44a4-b146-46883b213dfc">1</alampunktNr><kuvatavNr id="f117230b-ec21-4c99-a4da-71ea04efac6e"><![CDATA[1) ]]></kuvatavNr><sisuTekst id="33507274-bb29-42c8-96e9-075f201388f2"><tavatekst id="d2b5f7bd-1b10-4e89-8173-2eb547b333fb">kes on lapsed või noorukid, kellel ei ole võimalik teenust saada koolieelse lasteasutuse, üldhariduskooli või kutseõppeasutuse tugispetsialisti poolt või;</tavatekst></sisuTekst></alampunkt><alampunkt id="para3lg1p2"><alampunktNr id="70d922ab-a00c-41f5-af24-98c2ce8c97a6">2</alampunktNr><kuvatavNr id="b00273fd-e9b3-4d9c-842b-b20169cd5384"><![CDATA[2) ]]></kuvatavNr><sisuTekst id="f8984ffd-cd7a-4dae-ac73-334a0ce69b12"><tavatekst id="e7131b58-86d9-4cf7-8f41-0fcb4ca6106b">kelle düstressi on võimalik leevendada ja heaolu suurendada psühhosotsiaalse või psühholoogilise abiga või;</tavatekst></sisuTekst></alampunkt><alampunkt id="para3lg1p3"><alampunktNr id="decad778-aa0c-47f0-9b5c-24b4fe46b020">3</alampunktNr><kuvatavNr id="2cd100ef-922a-40e6-8db0-6d07a1b740e3"><![CDATA[3) ]]></kuvatavNr><sisuTekst id="d27300b3-314b-4815-84bb-b8c8b9988941"><tavatekst id="e50c8183-5f70-47a3-97e7-8b1d04f3abc0">kes vajab abi peresiseste suhete parandamiseks ja toetust kriiside või süsteemsete probleemide lahendamiseks.</tavatekst></sisuTekst></alampunkt></loige><loige id="para3lg2"><loigeNr id="a853d419-3799-4b95-acb9-9772fa29ea45">2</loigeNr><kuvatavNr id="0757b02f-4e26-44a8-b126-feb100647899"><![CDATA[(2)]]></kuvatavNr><sisuTekst id="ce3dcfa5-6a9f-4924-a47c-599fa197f926"><tavatekst id="1a5a6a8f-329d-40d7-b5da-0d05f4a89363">Isikule, kelle elukoht rahvastikuregistri andmetel ei ole Põlva vallas, võib põhjendatud juhtudel korraldada teenuse osutamise, kooskõlastades eelnevalt teenuse osutamise korraldamise rahvastikuregistri järgse kohaliku omavalitsusega.</tavatekst></sisuTekst></loige></paragrahv><paragrahv id="para4"><paragrahvNr id="134158ad-ddce-4911-9143-e71ca315b552">4</paragrahvNr><kuvatavNr id="752bdf85-4d8e-4a08-8cfb-88f57d061882"><![CDATA[§ 4. ]]></kuvatavNr><paragrahvPealkiri id="12befd55-73e9-4d8b-a5f1-73ab712d0c01">Nõuded teenust osutavale isikule</paragrahvPealkiri><loige id="para4lg1"><loigeNr id="d4258239-5563-496d-8b5e-397354329c79"/><kuvatavNr id="b24bb946-3714-465c-b678-fd52f1a8ab62"/><sisuTekst id="0eb2ca44-3512-472f-92a9-e65e6927bd73"><tavatekst id="09904b53-4c95-4ec9-a0c2-2def5a79ba1c">Teenust vahetult osutav isik peab vastama ühele järgmistest ettevalmistusnõuetest:</tavatekst></sisuTekst><alampunkt id="para4lg1p1"><alampunktNr id="374d6cbd-f919-441c-bac0-3bfaac44195f">1</alampunktNr><kuvatavNr id="2f375390-30f0-4e64-b31d-28154324aa98"><![CDATA[1) ]]></kuvatavNr><sisuTekst id="8eb7e60a-d573-4d2a-b356-df8153f2b513"><tavatekst id="6614c791-4de6-4607-a5b9-74b3cf633d04">psühholoogilise abi andja on vastava väljaõppega (psühholoogia bakalaureuse või magistrikraad, kutsetunnistus);</tavatekst></sisuTekst></alampunkt><alampunkt id="para4lg1p2"><alampunktNr id="d7332ea8-6313-4377-b349-d78044eb1cf8">2</alampunktNr><kuvatavNr id="025258b2-5e73-431c-9c0c-7a1b7a17b1f1"><![CDATA[2) ]]></kuvatavNr><sisuTekst id="2b32925b-ecf7-407c-bb71-e9afac6f0e66"><tavatekst id="f6eb35e0-eef5-4f7a-bed8-c24e8ef3a87f">psühhosotsiaalset abi vahetult andev isik on saanud tasemehariduse, täienduskoolituse, omab töökogemust, mida saab eeldada vastava teenuse osutamiseks.</tavatekst></sisuTekst></alampunkt></loige></paragrahv><paragrahv id="para5"><paragrahvNr id="537207a9-f9a4-4af8-817e-8da900c0a800">5</paragrahvNr><kuvatavNr id="2a0e75dd-9579-4e81-9972-a09b46000e7d"><![CDATA[§ 5. ]]></kuvatavNr><paragrahvPealkiri id="e1fcb397-22be-4aad-8df4-3b61b7c6a473">Teenuse taotlemine ja taotluse menetlemine</paragrahvPealkiri><loige id="para5lg1"><loigeNr id="85c8051c-7733-44bf-9ece-a96e1a8630f6">1</loigeNr><kuvatavNr id="6c892d57-efab-44ff-8f26-44278526ea99"><![CDATA[(1)]]></kuvatavNr><sisuTekst id="982352e7-85a8-4143-b589-239033b561ee"><tavatekst id="dec033c9-b3e5-406a-9ca9-56af020e6d20">Teenuse määramiseks esitab teenuse taotleja või tema seaduslik esindaja vallavalitsusele taotluse.</tavatekst></sisuTekst></loige><loige id="para5lg2"><loigeNr id="813925bc-2464-4739-8201-7e0c58ed5d43">2</loigeNr><kuvatavNr id="80bfb243-09a5-49d6-bbf7-1edc7d0e8cb8"><![CDATA[(2)]]></kuvatavNr><sisuTekst id="aa471de3-c1e6-4c27-a619-2c425c0e8b49"><tavatekst id="3e9c7232-f20d-4718-84c8-60766a2b1961">Taotluses märgitakse järgmised andmed:</tavatekst></sisuTekst><alampunkt id="para5lg2p1"><alampunktNr id="50d0a14b-00ae-49d1-87a0-69ac1d3281a3">1</alampunktNr><kuvatavNr id="e375988d-3913-41bd-bf6c-88e6379ad772"><![CDATA[1) ]]></kuvatavNr><sisuTekst id="e9195a2b-d153-4285-a870-ac256cc073d1"><tavatekst id="1a55882a-db24-4f13-a2d7-a189dad2f67b">abivajaja ees- ja perekonnanimi;</tavatekst></sisuTekst></alampunkt><alampunkt id="para5lg2p2"><alampunktNr id="1502bdef-53fa-426f-8c1b-08b7f8a6c34a">2</alampunktNr><kuvatavNr id="745d0b40-e2f6-476e-9ffc-42e927393093"><![CDATA[2) ]]></kuvatavNr><sisuTekst id="78d873f5-f58e-4662-9ec1-c24f447239a4"><tavatekst id="b18c12d0-c6fd-49f8-b1c7-c394c428d313">abivajaja isikukood;</tavatekst></sisuTekst></alampunkt><alampunkt id="para5lg2p3"><alampunktNr id="e3af44b2-2240-4d8b-b100-eb14153c01d8">3</alampunktNr><kuvatavNr id="c5aa0e85-084a-4234-849a-a12aed82a68c"><![CDATA[3) ]]></kuvatavNr><sisuTekst id="a3ac9dcd-c6b8-49ff-b8ec-c46135b0d364"><tavatekst id="850fefc8-c262-4622-b27b-d60bcf389ac2">abivajaja elukoht;</tavatekst></sisuTekst></alampunkt><alampunkt id="para5lg2p4"><alampunktNr id="41b7743b-53f6-4a95-936b-5e29a83f45a4">4</alampunktNr><kuvatavNr id="54bfd6b3-9e42-46cc-a876-c4d5fb930277"><![CDATA[4) ]]></kuvatavNr><sisuTekst id="f506dd43-b6e4-444d-82c4-ab83acd7ac93"><tavatekst id="0b61e9ee-0d75-47db-9ebd-a6968de6df46">teenuse taotleja ja tema esindaja(te) kontaktandmed;</tavatekst></sisuTekst></alampunkt><alampunkt id="para5lg2p5"><alampunktNr id="2f0f89e7-996e-4ff2-b5b7-8789382a0bed">5</alampunktNr><kuvatavNr id="b1486b5f-6564-456b-8c84-f46e9573e938"><![CDATA[5) ]]></kuvatavNr><sisuTekst id="dd82df34-7d02-42ae-b3af-b9d9616d4bef"><tavatekst id="5e6d8c55-e61d-432f-a837-921607e5043b">teenuse vajaduse põhjendus.</tavatekst></sisuTekst></alampunkt></loige><loige id="para5lg3"><loigeNr id="b9a73ddc-0025-4617-b0a3-266d161e6686">3</loigeNr><kuvatavNr id="8e9ccdee-427b-4148-961b-df5d06b0e9f4"><![CDATA[(3)]]></kuvatavNr><sisuTekst id="8ec8500a-2d22-4e56-90e8-f572a843bb33"><tavatekst id="6f8905ba-bd3e-482c-9090-e8dc58f1b145">Teenuse osutamise otsustamiseks selgitab vallavalitsuse sotsiaal- ja haridusosakonna ametnik välja teenuse vajaduse, sobiva teenuse liigi, teenuse osutamise mahu ja perioodi.</tavatekst></sisuTekst><muutmismarge id="a4acb54e-9caa-4cad-9c02-7ad938284a7b"><avaldamismarge id="5f29f92c-bcd2-4c82-b230-928a8fd336fc"><RTosa id="ad895120-ab4b-4f62-a975-2509b1148d92">RT IV</RTosa><avaldamineKuupaev id="212ed666-1d9e-4a1e-8e44-3eef961cedc3">2026-09-29</avaldamineKuupaev><RTartikkel id="ee09df56-0aea-44ed-aa44-99ade233be52">1</RTartikkel><aktViide id="bc21efab-ecaf-47ee-9e7e-60800f236cff">429092026001</aktViide></avaldamismarge><joustumine id="d9861227-8372-4972-a932-d675b709f2f2">2026-10-02</joustumine><tavatekst id="d5cc4fb2-062b-4ead-b67c-77e41071fe95">, rakendatakse alates 01.08.2026</tavatekst></muutmismarge></loige></paragrahv><paragrahv id="para6"><paragrahvNr id="aaae93e3-6c79-4349-a591-98d353b74d73">6</paragrahvNr><kuvatavNr id="8da9c1dd-a96d-43d2-b74f-a77ef0d2686c"><![CDATA[§ 6. ]]></kuvatavNr><paragrahvPealkiri id="bddd319d-6a1d-4c13-a201-d01909583183">Teenuse määramine</paragrahvPealkiri><loige id="para6lg1"><loigeNr id="6fe802b8-5a79-4520-ad69-b7480aa87014">1</loigeNr><kuvatavNr id="30dd982d-b3ef-40d7-9933-86bb9b271573"><![CDATA[(1)]]></kuvatavNr><sisuTekst id="cdec4465-928e-4278-ae01-c861d3e75927"><tavatekst id="a0432ef0-4c40-4851-8433-27ab6c86839f">Otsuse teenuse määramise või sellest keeldumise kohta teeb sotsiaalabikomisjoni ettepanekul sotsiaal- ja haridusosakonna juhataja või teda asendav ametnik kümne tööpäeva jooksul nõuetekohase taotluse esitamisest.</tavatekst></sisuTekst><muutmismarge id="14427eb0-763b-43d7-9e43-96bbc3a69ce6"><avaldamismarge id="df2d090c-24d2-4b69-9ed0-6b20064f941d"><RTosa id="751b3f42-1797-42c0-9c67-523df704e752">RT IV</RTosa><avaldamineKuupaev id="eb34821a-7bf2-48db-872f-47146e060dd0">2026-09-29</avaldamineKuupaev><RTartikkel id="5819d90b-2757-4c49-9df4-5762c7b2c64b">1</RTartikkel><aktViide id="8d39f602-9c84-4497-a4c4-e03226fe536e">429092026001</aktViide></avaldamismarge><joustumine id="fd45edf3-fb0a-4b03-b8ca-053fc3abd532">2026-10-02</joustumine><tavatekst id="4fb3f581-015f-44df-a005-f6e9255c5b53">, rakendatakse alates 01.08.2026</tavatekst></muutmismarge></loige><loige id="para6lg2"><loigeNr id="91cdfd3e-34d6-48ed-84f3-045a9992fde1">2</loigeNr><kuvatavNr id="66d17651-3753-4257-b0b9-6d85b1cf7317"><![CDATA[(2)]]></kuvatavNr><sisuTekst id="c348739c-f06a-48ec-b98a-9e5911a6d628"><tavatekst id="67e8369a-571e-4154-ae26-994969cc52bd">Teenuse määramisest võib keelduda juhul, kui esineb vähemalt üks järgmistest asjaoludest:</tavatekst></sisuTekst><alampunkt id="para6lg2p1"><alampunktNr id="a1e0a6e6-c5f8-4a24-8cff-4a7dfdd8527c">1</alampunktNr><kuvatavNr id="5d633c63-d7ea-4f6c-8699-5b07e499dbd8"><![CDATA[1) ]]></kuvatavNr><sisuTekst id="85ca3f66-89d9-423e-8a12-2bcb60fe32cc"><tavatekst id="598a081b-0fb3-4c6c-a9f3-9024b11277d2">vallavalitsusele ei ole esitatud kõiki teadaolevaid tõeseid ja täielikke andmeid, dokumente ja muid tõendeid, mis on vajalikud teenuse määramise otsustamisel;</tavatekst></sisuTekst></alampunkt><alampunkt id="para6lg2p2"><alampunktNr id="1963ee7c-6936-425e-baa6-4c7071fb6497">2</alampunktNr><kuvatavNr id="b86432e5-467f-40e4-979f-77ddadf5c317"><![CDATA[2) ]]></kuvatavNr><sisuTekst id="d722f4e8-1cb5-405c-9025-23eae0e73056"><tavatekst id="10b4e008-76cb-495c-bdde-86d48db2d304">taotleja ei võimalda teenuse vajadust kontrollida;</tavatekst></sisuTekst></alampunkt><alampunkt id="para6lg2p3"><alampunktNr id="81fbc259-8f8e-4412-a939-7e950a7c5c0e">3</alampunktNr><kuvatavNr id="38bfd031-c881-4ef5-a036-b48305876658"><![CDATA[3) ]]></kuvatavNr><sisuTekst id="974ab25b-a610-431d-adf7-fff2d56fd074"><tavatekst id="53d76b63-c8dd-4b55-93c1-a08f2f4947be">teenust saama õigustatud isik ei osale aktiivselt talle teenuse määramisel;</tavatekst></sisuTekst></alampunkt><alampunkt id="para6lg2p4"><alampunktNr id="f465f3b5-ce35-4eee-b82a-d6a7b84d5e91">4</alampunktNr><kuvatavNr id="71800b0f-62e0-465d-a60e-dfab947bdaac"><![CDATA[4) ]]></kuvatavNr><sisuTekst id="59bcd89d-4904-482a-8ab1-3741138d407e"><tavatekst id="d4ec86fe-f93b-439a-9281-0e9e43077cca">taotleja ei ole teavitanud vallavalitsust viivitamata teenuse saamise õigust ja teenuse määramist mõjutavatest asjaoludest ja asjaolude muutumisest;</tavatekst></sisuTekst></alampunkt><alampunkt id="para6lg2p5"><alampunktNr id="699eb730-ad28-4758-b542-66e11ee39e2c">5</alampunktNr><kuvatavNr id="667b6a08-d236-4136-aaf7-f77397c19561"><![CDATA[5) ]]></kuvatavNr><sisuTekst id="20012429-ab3e-4c18-ad23-dcbc33e6b760"><tavatekst id="d37c3652-cf28-4cca-8c0f-62a8eb2bb0ec">teenuse vajadust on võimalik või otstarbekas katta muude teenuste või muu abiga.</tavatekst></sisuTekst></alampunkt></loige></paragrahv><paragrahv id="para7"><paragrahvNr id="d20309d1-9a69-4b09-9199-bdc5950623b6">7</paragrahvNr><kuvatavNr id="0b0f1fcf-2b51-4d8b-9fe2-130f593fad7e"><![CDATA[§ 7. ]]></kuvatavNr><paragrahvPealkiri id="113e20df-8fa6-48ae-9cb1-65f60db4db73">Teenuse osutamine</paragrahvPealkiri><loige id="para7lg1"><loigeNr id="3987e217-8566-4d8f-861e-de209d8cb668"/><kuvatavNr id="b8ea647d-b299-4e6f-bb4c-f1c318fa89cc"/><sisuTekst id="e646b2d7-9146-44ab-aa74-6e8eae60b1e0"><tavatekst id="cbae207b-b91a-48b9-9033-a18f3c3ea4b6">Teenuse osutamise korraldamiseks võib vallavalitsus sõlmida teenuse osutajaga koostöökokkuleppe.</tavatekst></sisuTekst></loige></paragrahv><paragrahv id="para8"><paragrahvNr id="e90c3e8b-33ae-455c-a223-c134191cb7aa">8</paragrahvNr><kuvatavNr id="46c5de1a-6cb7-4193-9edd-2caf398921fc"><![CDATA[§ 8. ]]></kuvatavNr><paragrahvPealkiri id="473ffd78-8040-4b8c-8e92-73118dba76ca">Teenuse eest tasumine</paragrahvPealkiri><loige id="para8lg1"><loigeNr id="4e2eb63f-3d9d-43ba-82c2-aba2c53ef33c"/><kuvatavNr id="5e13654b-d939-491b-84d2-dd9e91925201"/><sisuTekst id="7f64593d-8393-436b-9a54-32ea0f37ce79"><tavatekst id="bef17f24-a132-43fa-a25b-a7e3ef8c3715">Teenuse osutamise kulud kaetakse Põlva valla eelarvest, ettenähtud vahendite ulatuses.</tavatekst></sisuTekst></loige></paragrahv><paragrahv id="para9"><paragrahvNr id="d59ae4b9-7aaf-4538-add6-336c428d2a07">9</paragrahvNr><kuvatavNr id="9b0ad468-975d-4898-907d-9e7908f8c946"><![CDATA[§ 9. ]]></kuvatavNr><paragrahvPealkiri id="cf4d2259-118e-4d6e-a54e-343bd06c0c87">Vaidluse lahendamine</paragrahvPealkiri><loige id="para9lg1"><loigeNr id="aa9ad3db-7610-4568-a532-da3c45dc8a7b">1</loigeNr><kuvatavNr id="4f636d29-04aa-41c0-a193-efacc60341d5"><![CDATA[(1)]]></kuvatavNr><sisuTekst id="d1dc3f7e-86cd-4cdd-83f3-0b713de7bc67"><tavatekst id="d36a4f29-6266-4633-8325-e0c305eba8f8">Isik, kelle õigusi on taotluse menetlemisel rikutud, võib esitada vaide vallavalitsusele. Vaie haldusakti või toimingu peale tuleb esitada 30 päeva jooksul arvates päevast, millal isik vaidlustatavast haldusaktist või toimingust teada sai või oleks pidanud teada saama.</tavatekst></sisuTekst></loige><loige id="para9lg2"><loigeNr id="3f9e0b40-e220-450f-8a0f-87829c28f095">2</loigeNr><kuvatavNr id="1d988d69-b406-4818-aebc-0eb26bce7333"><![CDATA[(2)]]></kuvatavNr><sisuTekst id="796b2d27-c67b-4630-9886-a100359d85e6"><tavatekst id="7073903a-2e65-4f69-9b93-29be1f869d4f">Vaie lahendatakse haldusmenetluse seaduses sätestatud korras 30 päeva jooksul arvates vaide esitamisest vallavalitsusele, kui seadus ei sätesta pikemat tähtaega. Vaide läbivaatamise tähtaega võib pikendada haldusmenetluse seaduses sätestatud korras.</tavatekst></sisuTekst></loige><loige id="para9lg3"><loigeNr id="2b5fcbf0-1fc8-492a-8597-db703dd04c28">3</loigeNr><kuvatavNr id="df425b07-cfc3-4a54-9920-646d60dbcd4d"><![CDATA[(3)]]></kuvatavNr><sisuTekst id="1386dd32-26e9-4e37-97db-7deb04f22d93"><tavatekst id="0f2e2834-0431-40b6-aa92-b3af0d07b0f7">Isikul, kelle vaie jääb vaidemenetluses rahuldamata või kelle õigusi on vaidemenetluses rikutud, on õigus pöörduda halduskohtumenetluse seadustikus sätestatud tingimustel ja korras kaebusega halduskohtusse. Isikul on võimalik halduskohtusse pöörduda ka vaide esitamise asemel, ilma eelnevalt vaidemenetlust läbimata.</tavatekst></sisuTekst></loige></paragrahv><paragrahv id="para10"><paragrahvNr id="202cd49e-d5f9-44fd-a726-177d6e6d5476">10</paragrahvNr><kuvatavNr id="8f3e35ab-bfda-4cc3-9d42-f12fbae8a6c0"><![CDATA[§ 10. ]]></kuvatavNr><paragrahvPealkiri id="9d5a0e5f-bfcd-40b4-a63b-e82f289ac35b">Järelevalve ja arvestuse pidamine</paragrahvPealkiri><loige id="para10lg1"><loigeNr id="af9567c2-6a2e-43f2-8091-22ab64ae3d7f">1</loigeNr><kuvatavNr id="0c634b27-864d-40d8-a6ce-46fc256bd328"><![CDATA[(1)]]></kuvatavNr><sisuTekst id="cdc65155-70c0-4fd5-ab6b-93112d78aee5"><tavatekst id="916b286e-f074-4d07-8494-f097ab1b3de6">Vallavalitsuse ja Vallavalitsuse ametiisikute poolt määrusega sätestatud nõuete täitmist, haldusaktide õiguspärasust ning tegevuse otstarbekust kontrollib kohaliku omavalitsuse korralduse seaduse alusel teenistusliku järelevalve korras täitevorgan.</tavatekst></sisuTekst></loige><loige id="para10lg2"><loigeNr id="d99c44d6-ec86-4064-bf3a-7a4b3ad6e140">2</loigeNr><kuvatavNr id="9e0cd577-ecf0-489a-8558-45bacda0f9cb"><![CDATA[(2)]]></kuvatavNr><sisuTekst id="b2f0f904-ba7a-46ef-a4e6-ae97253da997"><tavatekst id="aaf56337-516f-4cb4-999d-9cb5e1359d87">Haldusjärelevalvet sotsiaalhoolekande seaduse alusel antud kohaliku omavalitsuse üksuse haldusaktide õiguspärasuse ning sotsiaalteenuste ja muu abi kvaliteedi, samuti riigi poolt sotsiaalhoolekandeks eraldatud sihtotstarbeliste vahendite kasutamise üle teostab Sotsiaalkindlustusamet.</tavatekst></sisuTekst></loige><loige id="para10lg3"><loigeNr id="4ba41673-f939-4503-ad93-2453d5a4b0bc">3</loigeNr><kuvatavNr id="edfc0601-0001-448e-8b57-51af11aabcd0"><![CDATA[(3)]]></kuvatavNr><sisuTekst id="3d04e610-d5e5-4361-a022-a7008e85f0b5"><tavatekst id="bea93e4f-cc18-4a88-814d-b7e5368ac914">Teenuse korraldamise ja teenuse osutamise üle arvestuse pidamise eest vastutab vallavalitsuse sotsiaal- ja haridusosakond.</tavatekst></sisuTekst><muutmismarge id="bed83c2d-87d3-4405-b1c4-e96f46d019ab"><avaldamismarge id="98d69878-c968-4ed3-ada5-8533437e6f77"><RTosa id="a1ec2adb-28d0-4f8f-a8d0-2d99efb58fca">RT IV</RTosa><avaldamineKuupaev id="4ce7fe5f-7998-4906-85bd-09e6da7b4f89">2026-09-29</avaldamineKuupaev><RTartikkel id="2d4a6cba-2792-47cc-a155-d80bc2854d75">1</RTartikkel><aktViide id="baa8c230-ab7e-4fce-bb93-ba1765a8e41a">429092026001</aktViide></avaldamismarge><joustumine id="40f3868a-ef47-4916-bc29-52114e0bbfbd">2026-10-02</joustumine><tavatekst id="72ee30f1-a3f0-43e0-bef5-5dc0d8d4cf90">, rakendatakse alates 01.08.2026</tavatekst></muutmismarge></loige></paragrahv><paragrahv id="para11"><paragrahvNr id="f15c645c-3887-41a2-ba1a-0d52b4aec20f">11</paragrahvNr><kuvatavNr id="379c1edc-fd9d-4bb7-9ae0-15f4360d2e74"><![CDATA[§ 11. ]]></kuvatavNr><paragrahvPealkiri id="d3e42bb7-d77d-4df2-b6b8-b5751e11e9d8">Dokumendivormide kinnitamine</paragrahvPealkiri><loige id="para11lg1"><loigeNr id="346af323-738c-4776-b024-29ed4b93031b"/><kuvatavNr id="25ac878c-3bf3-4ae3-b1ab-b89fe6f89749"/><sisuTekst id="295e7dc9-3bd6-46a0-81ad-748757bb7e10"><tavatekst id="bdd888a8-b4c6-4c07-ac28-ad5a33e6567c">Vallavalitsus võib kinnitada määruse rakendamiseks vajalike dokumentide vormid.</tavatekst></sisuTekst></loige></paragrahv><paragrahv id="para12"><paragrahvNr id="6b9d0417-0cca-411b-8d47-c8aae67ef6ae">12</paragrahvNr><kuvatavNr id="b644ed81-905f-4f9d-a069-5379e435c6d9"><![CDATA[§ 12. ]]></kuvatavNr><paragrahvPealkiri id="4139172b-cfd1-4a89-b2f2-a09b2874372c">Määruse jõustumine</paragrahvPealkiri><loige id="para12lg1"><loigeNr id="7c5a51df-5363-483a-9140-f4c1acf58e7b"/><kuvatavNr id="7ba552dd-7b64-4fc7-8ee0-78b81d5602df"/><sisuTekst id="59ca28f3-f460-48a8-abad-6e953b18092a"><tavatekst id="cc9bd408-f654-4df5-b8c9-c54c505095de">Määrus jõustub kolmandal päeval pärast avaldamist Riigi Teatajas.</tavatekst></sisuTekst></loige></paragrahv></sisu>
