						<tavatekst id="88a322f6-31b4-4a41-86f3-034b37771078">tööde tegemise tähtaeg;</tavatekst>
					</sisuTekst>
				</alampunkt>
				<alampunkt id="para7lg1p4">
					<alampunktNr id="cdb5fa98-a02c-451d-8923-b52266693e98">4</alampunktNr>
					<kuvatavNr id="02d5f29e-af66-4b8b-b0c9-b2d402bc17e2"><![CDATA[4) ]]></kuvatavNr>
					<sisuTekst id="b92c887b-b661-4013-9caf-d7f072a04680">
						<tavatekst id="6013d7bd-fd98-4126-80fc-136129d0c575">tööde maksumus vastavalt soodsamale hinnapakkumusele;</tavatekst>
					</sisuTekst>
				</alampunkt>
				<alampunkt id="para7lg1p5">
					<alampunktNr id="5ba0f979-ce70-4fcc-a0c3-9cff43599f4a">5</alampunktNr>
					<kuvatavNr id="05f50c41-73a4-448d-87b9-b5cc384c3b35"><![CDATA[5) ]]></kuvatavNr>
					<sisuTekst id="bd8ee9a9-05ad-4b43-ad07-2d5b18bdcc79">
						<tavatekst id="ee521f9a-1262-4608-a3df-7581e5da9fab">poolte rahalised kohustused;</tavatekst>
					</sisuTekst>
				</alampunkt>
