					<alampunktNr id="4a836a7f-789f-48ff-8faf-008a159f22e3">8</alampunktNr>
					<kuvatavNr id="336b9151-eb96-4b20-a25e-0ab693a32601"><![CDATA[8) ]]></kuvatavNr>
					<sisuTekst id="910f4ec8-0820-49b7-bf27-47a7d70819b5">
						<tavatekst id="10fddf8d-e097-4d0d-9837-076bc2113306">muud olulised tingimused.</tavatekst>
					</sisuTekst>
				</alampunkt>
