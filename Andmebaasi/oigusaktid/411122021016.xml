					<sisuTekst id="0911f6a0-e98d-40af-bbca-728fe15db1fe">
						<tavatekst id="f8aab685-679f-4caf-aed3-21da6c5df19a">tööde eest tasumise kord ja tähtajad;</tavatekst>
					</sisuTekst>
				</alampunkt>
				<alampunkt id="para7lg1p7">
					<alampunktNr id="48915d8b-1831-4fc7-a608-57ab28b71ac6">7</alampunktNr>
					<kuvatavNr id="b0586d16-d0d9-4fea-a845-b2e1e728e54c"><![CDATA[7) ]]></kuvatavNr>
					<sisuTekst id="a61204cb-b703-4f65-bc3f-a310ff00fa78">
						<tavatekst id="250c98dd-e1e8-4ebe-bc29-7d3bd8948b5e">osapoolte õigused ja kohustused;</tavatekst>
					</sisuTekst>
				</alampunkt>
