 <sisu id="a2ad76cf-bef3-484e-bed5-889575dbfe71"><preambul id="d42ef716-d927-4819-87b1-ce41fce16712"><tavatekst id="4914116e-a352-41ef-9cd8-d6a2ea48cab6">Määrus kehtestatakse Põhja-Pärnumaa Vallavolikogu 22.08.2018. a määruse nr 35 „Vändra Alevi Hoolekandekeskuse põhimäärus“ § 4 lõike 3 ja Põhja-Pärnumaa Vallavolikogu 22.08.2018. a määruse nr 34 „Tootsi Hooldekodu põhimäärus“ § 4 lõike 3 alusel.</tavatekst></preambul><paragrahv id="para1"><paragrahvNr id="a221f4c7-1f64-479b-ab13-6cd3b24e5c87">1</paragrahvNr><kuvatavNr id="fedeb201-e05f-4714-9bc5-952fc56c254e"><![CDATA[§ 1. ]]></kuvatavNr><paragrahvPealkiri id="ea33a967-3f51-4f25-92ce-cd89b46f4dc6">Reguleerimisala</paragrahvPealkiri><loige id="para1lg1"><loigeNr id="90738003-306f-42c5-a3f7-c2d133173793"/><kuvatavNr id="438f06d5-c99b-4a30-93d4-d32db4ec63a6"/><sisuTekst id="67aa658d-3fc1-45a4-ac65-d0b6836507c8"><tavatekst id="bc065410-8cb7-4522-b148-7a40bf3e2e14">Käesolev määrus reguleerib Vändra Alevi Hoolekandekeskusesse ja Tootsi Hooldekodusse (edaspidi <i>hoolekandeasutus</i>) vastuvõtmist, sealt lahkumise ja väljaarvamise korda.</tavatekst></sisuTekst></loige></paragrahv><paragrahv id="para2"><paragrahvNr id="a63dc703-1230-4007-a9e5-33c75ab0b4b5">2</paragrahvNr><kuvatavNr id="17e8e7cf-75e4-4228-a639-07c76e62e3b9"><![CDATA[§ 2. ]]></kuvatavNr><paragrahvPealkiri id="71442893-6b12-4f10-b75e-96ed03f88b59">Hoolekandeasutusse vastuvõtmine</paragrahvPealkiri><loige id="para2lg1"><loigeNr id="a47f8d00-4abd-4b85-8848-dcb3d01a93c0">1</loigeNr><kuvatavNr id="709d578a-4ef5-4974-a2e9-9b8e9a84d44b"><![CDATA[(1)]]></kuvatavNr><sisuTekst id="485b8cd5-55db-4b41-8692-1e403f291fd4"><tavatekst id="56ebeccd-cd21-43ca-a1e9-c007d2ca6647">Hoolekandeasutusse vastuvõtmiseks esitab teenust vajav isik või tema huvides tegutsev isik vormikohase taotluse hoolekandeasutusele.</tavatekst></sisuTekst></loige><loige id="para2lg2"><loigeNr id="71e81d86-5983-427a-94b0-cd98945a919c">2</loigeNr><kuvatavNr id="dd7f5e66-7196-44f0-9e43-dd3237cd75ad"><![CDATA[(2)]]></kuvatavNr><sisuTekst id="a2b569f6-f024-4203-8bb5-1f0d6da0075f"><tavatekst id="8b61e1ba-d327-4d30-a80a-bfc2e0e65a8e">Taotlusele lisatakse:</tavatekst></sisuTekst><alampunkt id="para2lg2p1"><alampunktNr id="bb6d9f1e-b605-49be-af9a-d064c4a686b7">1</alampunktNr><kuvatavNr id="3c7a4f2d-b8d5-4529-86f2-dbbf9f00fc1b"><![CDATA[1) ]]></kuvatavNr><sisuTekst id="0f10fce2-e29b-43c7-9088-3b16495859ea"><tavatekst id="eb801772-1de2-4d65-b482-0c1ec04722a0">teenust vajava isiku isikut tõendava dokumendi koopia;</tavatekst></sisuTekst></alampunkt><alampunkt id="para2lg2p2"><alampunktNr id="86cbbfde-d10e-4d55-9ead-e78dfc4f3237">2</alampunktNr><kuvatavNr id="20a32f0d-d320-4145-b3af-df78e8a8d488"><![CDATA[2) ]]></kuvatavNr><sisuTekst id="e840a017-b826-4af3-8931-2cc58ba08ed4"><tavatekst id="8a27c9ad-98c6-4bb0-a2c8-39ea29dece2b">arstitõend kinnitamaks, et teenust vajav isik ei põe nakkushaigusi ja sõltuvushäiret;</tavatekst></sisuTekst></alampunkt><alampunkt id="para2lg2p3"><alampunktNr id="d7e76b35-ca96-455e-bdcb-7453d8616573">3</alampunktNr><kuvatavNr id="181f48e1-fd92-4d3e-92b8-617077028b46"><![CDATA[3) ]]></kuvatavNr><sisuTekst id="c515824b-55d9-4ce8-9c8a-226227175c13"><tavatekst id="6ca4dce8-17c8-4c2b-ba11-dd8811188f7c">arstitõend Vändra Alevi Hoolekandekeskusele, et teenust vajav isik ei põe psüühikahäiret, sh dementsust;</tavatekst></sisuTekst></alampunkt><alampunkt id="para2lg2p4"><alampunktNr id="aa5313af-72da-4b3f-befb-90a0ce106047">4</alampunktNr><kuvatavNr id="ee2c955e-7db4-47db-af0e-6aefb3d4d54b"><![CDATA[4) ]]></kuvatavNr><sisuTekst id="ca64c0e5-9527-48f5-8c84-9aa3ed2a4085"><tavatekst id="4b1d9634-1d38-4def-a11e-b9890a9d5227">arsti hinnang teenust vajava isiku tervishoiuteenuse vajadusele ja ravimiskeemile;</tavatekst></sisuTekst></alampunkt><alampunkt id="para2lg2p5"><alampunktNr id="24ed23ae-597c-4108-ae78-419fc1dc2ce3">5</alampunktNr><kuvatavNr id="7701584a-ba8c-4865-9fc6-5d0f62456056"><![CDATA[5) ]]></kuvatavNr><sisuTekst id="7391aa28-424b-4138-b3b7-f64c00bdc4da"><tavatekst id="ce2d0215-23f6-4325-b303-eb5084c377e0">koopia Sotsiaalkindlustusameti otsusest puude raskusastme kohta (puude olemasolul);</tavatekst></sisuTekst></alampunkt><alampunkt id="para2lg2p6"><alampunktNr id="336477f2-8c2c-4446-88a5-e931037aacbe">6</alampunktNr><kuvatavNr id="888f2eb1-0b17-454f-ab40-d8559b5a2edd"><![CDATA[6) ]]></kuvatavNr><sisuTekst id="30ea794c-2553-4c48-8ce8-ae05f74a03d3"><tavatekst id="dd59e63c-ce08-464d-bed1-7e2149e5d766">teise kohaliku omavalitsuse haldusakt teenuse eest tasumise kohta (selle olemasolul).</tavatekst></sisuTekst></alampunkt></loige><loige id="para2lg3"><loigeNr id="cf10d086-7a4d-4d99-8027-9c985d817ad1">3</loigeNr><kuvatavNr id="374f2a28-71fb-4731-a9a9-5109414a53af"><![CDATA[(3)]]></kuvatavNr><sisuTekst id="1734d981-c6ac-42ff-b3ff-04f7a998e6ca"><tavatekst id="ed11dfc7-3971-4465-84fe-50c9a911c13a">Põhja-Pärnumaa Vallavalitsuse sotsiaalametniku poolt määratud teenuse osutamiseks esitatakse hoolekandeasutusele teenuse osutamise otsus. Hoolekandeasutus koostab koostöös teenuse saaja ja/või rahastajaga hooldusplaani.</tavatekst></sisuTekst></loige><loige id="para2lg4"><loigeNr id="4abd04b6-3969-496c-b3ff-b7e32771390a">4</loigeNr><kuvatavNr id="1e6e6a20-6675-44eb-bda4-68f7356ed6f1"><![CDATA[(4)]]></kuvatavNr><sisuTekst id="7408e2de-66e4-4582-9ab2-d06c6f596bb6"><tavatekst id="18546c23-2d4b-41a9-9ac6-0da8c3a37b7c">Hoolekandeasutusse ei võeta vastu isikuid, kes põevad nakkushaiguseid, sõltuvushäiret või vajavad tervishoiuteenust.</tavatekst></sisuTekst></loige><loige id="para2lg5"><loigeNr id="c238c880-ac96-4b45-855d-9f2f314200d6">5</loigeNr><kuvatavNr id="fd2d741e-7bf7-41c6-9ed9-dd9a7e99ef95"><![CDATA[(5)]]></kuvatavNr><sisuTekst id="6180762a-bb02-4c4a-8327-5f6e600a42e2"><tavatekst id="b9837282-2716-4eee-8daa-a2ebdbdb3c28">Vändra Alevi Hoolekandekeskusesse ei võeta vastu isikuid, kes põevad psüühikahäiret, sh dementsust.</tavatekst></sisuTekst></loige><loige id="para2lg6"><loigeNr id="014dc9f4-cf4f-45df-9d31-7ad9b161e617">6</loigeNr><kuvatavNr id="60d76e93-52ea-4759-bda7-da9fa542edb1"><![CDATA[(6)]]></kuvatavNr><sisuTekst id="cf8980b8-9c1a-4e57-bcf3-ee24dcf51b6e"><tavatekst id="775fab45-f61a-4369-a802-14471b09c967">Hoolekandeasutusse vastuvõtmise otsustab hoolekandeasutuse juhataja 15 päeva jooksul arvates taotluse esitamisest.</tavatekst></sisuTekst></loige></paragrahv><paragrahv id="para3"><paragrahvNr id="88310c72-86ff-4da6-98db-ab2e3ed18b48">3</paragrahvNr><kuvatavNr id="74acbd0b-ba77-4caa-b6d7-b7b564f4b5b3"><![CDATA[§ 3. ]]></kuvatavNr><paragrahvPealkiri id="3a0955a7-0afb-4cd1-9419-37439812b422">Lepingu sõlmimine</paragrahvPealkiri><loige id="para3lg1"><loigeNr id="db5fa1ad-2ab1-421a-9890-c3100f66a68d">1</loigeNr><kuvatavNr id="5a5f4238-3dc9-46c1-b274-07a764e04ba4"><![CDATA[(1)]]></kuvatavNr><sisuTekst id="48cc263a-eb94-42be-8df1-6d3173599850"><tavatekst id="6ef1a075-0110-4186-85a0-de4c36ebe1a5">Teenuse osutamine toimub teenuse osutamise lepingu (edaspidi <i>leping</i>) alusel. Lepingu sisuks on lepingu osaliste andmed, lepingu ese, arvelduste kord, lepingu tähtaeg, lepinguosaliste õigused ja kohustused, lepingu lõpetamise ja lepinguosaliste vaheline teadete saatmise kord.</tavatekst></sisuTekst></loige><loige id="para3lg2"><loigeNr id="c0aa1aee-330b-432b-8db6-6c0f26828d98">2</loigeNr><kuvatavNr id="1e6d6c2d-1f5a-4dd7-a507-1b9c6ed1b5b9"><![CDATA[(2)]]></kuvatavNr><sisuTekst id="82811c31-f3c4-49ae-85a6-0d46db6d1e39"><tavatekst id="b5f345b4-90b2-4811-bf36-f6fceb1001aa">Lepingu sõlmib hoolekandeasutuse juhataja 15 päeva jooksul paragrahvi 2 lõikes 6 sätestatud hoolekandeasutusse vastuvõtmise otsuse tegemisest.</tavatekst></sisuTekst></loige></paragrahv><paragrahv id="para4"><paragrahvNr id="d028fec4-af1a-4715-b63f-d51fc5462bc4">4</paragrahvNr><kuvatavNr id="cbd94713-c23b-48bb-9574-1860daf1ded9"><![CDATA[§ 4. ]]></kuvatavNr><paragrahvPealkiri id="590215d0-f0f1-4a3e-9cc7-8f30b1b2c488">Lepingu muutmine ja lõpetamine</paragrahvPealkiri><loige id="para4lg1"><loigeNr id="b06d7e34-f2ef-4827