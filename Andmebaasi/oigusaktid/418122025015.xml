	<sisu id="bafdad81-1d2c-4d81-9e48-3173a6348665">
		<preambul id="1accbaa5-e969-4c64-878e-b2221f843a31">
			<tavatekst id="2ac839dc-bbf3-4031-80fa-c286e2b680d1">Määrus kehtestatakse „Sotsiaalhoolekande seaduse“ § 22<sup>1 </sup>lõike 5 ning Sillamäe Linnavolikogu 26. aprilli 2018. a määruse nr 13 „Sotsiaalteenuste osutamise kord“ § 8 lõike 8 alusel. </tavatekst>
		</preambul>
		<paragrahv id="para1">
			<paragrahvNr id="704c98dd-0254-40fa-a86f-bc5086d990f0">1</paragrahvNr>
			<kuvatavNr id="6a35dddf-852f-4316-8f38-a9bd168401ac"><![CDATA[§ 1. ]]></kuvatavNr>
			<paragrahvPealkiri id="183ec71e-6659-40fb-908d-d6aa3803982f">Üldhooldusteenuse hoolduskulude piirmäär </paragrahvPealkiri>
			<loige id="para1lg1">
				<loigeNr id="d46d0a35-63bd-426c-87e8-98ed553b9d6a"/>
				<kuvatavNr id="c4712986-6a57-46fa-bc31-d017a551add3"/>
				<sisuTekst id="0cef65f6-ecdf-43b2-bbdc-e75f0bf6572f">
					<tavatekst id="5f0ae596-4e16-4d3a-a3c4-0d9562a8b75e">Kehtestada väljaspool isiku kodu ööpäevaringse üldhooldusteenuse osutamisel vahetult teenust osutavate hooldustöötajate ja abihooldustöötajate kulude tasumise piirmääraks 700 eurot ühe teenuse saaja kohta kuus.</tavatekst>
				</sisuTekst>
				<muutmismarge id="6597b0ba-1500-436c-b6b2-9f5ceded5777">
					<avaldamismarge id="35dfca91-050e-4de1-9602-512d5d15683f">
						<RTosa id="632345b0-892b-4542-b5d3-3a11be7d94e3">RT IV</RTosa>
