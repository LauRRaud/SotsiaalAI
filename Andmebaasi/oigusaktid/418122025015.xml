					</avaldamismarge>
					<joustumine id="4894392e-49a8-4b7c-af85-1cf097e65c39">2025-12-21</joustumine>
					<tavatekst id="f7d29ab2-3205-4933-b669-63a71e1650e1">, rakendatakse 01. jaanuarist 2026. a.</tavatekst>
				</muutmismarge>
			</loige>
		</paragrahv>
