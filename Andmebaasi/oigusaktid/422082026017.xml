				<kuvatavNr id="a78c93a0-e388-4f60-809d-136ab8a71872"><![CDATA[(1)]]></kuvatavNr>
				<sisuTekst id="7410595c-2835-454d-b543-300c97521fbd">
					<tavatekst id="9702c851-461f-4a1f-9bc2-e7d7a9593696">Määrus jõustub 1. detsembril 2021.</tavatekst>
				</sisuTekst>
