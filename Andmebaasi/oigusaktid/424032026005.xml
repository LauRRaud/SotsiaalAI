	<sisu id="86636fa1-02aa-47e8-b3d9-c40980564b78">
		<preambul id="536ca37a-9802-4833-a4a5-4c5df5e1720a">
			<tavatekst id="f0a3a0e3-e2b2-44e4-9302-9114349b0967">Määrus kehtestatakse kohaliku omavalitsuse korralduse seaduse § 22 lg 1 p 5 ja Tartu Vallavolikogu 26.09.2019 määruse nr 22 „Sotsiaalhoolekandelise abi andmise kord” alusel ning arvestades Tartu Vallavolikogu 28.12.2017 määrust nr 13 „Sünni- ja matusetoetuse määramise ja maksmise tingimused ja kord Tartu vallas”.</tavatekst>
		</preambul>
		<paragrahv id="para1">
			<paragrahvNr id="3278de3a-dd16-42dc-a631-addb78b353b5">1</paragrahvNr>
			<kuvatavNr id="133c4719-e5ee-41a4-b3ab-f49bcc4af4d8"><![CDATA[§ 1. ]]></kuvatavNr>
			<paragrahvPealkiri id="2030454e-69e4-456d-b6c0-8966bb1878ef">Sissetulekust mittesõltuvad toetused</paragrahvPealkiri>
			<loige id="para1lg1">
				<loigeNr id="aaf645e7-74ca-41d0-a3e3-af69a74d0478"/>
				<kuvatavNr id="45a00ba4-d5c6-4b58-a2f5-c35863831548"/>
				<sisuTekst id="88b63ffd-3e29-4a12-8983-2924d1e51ebb">
					<tavatekst id="c17fdddf-779c-419d-8351-946bbc97647c">Sissetulekust mittesõltuvate toetuste määrad on järgmised:</tavatekst>
				</sisuTekst>
				<alampunkt id="para1lg1p1">
					<alampunktNr id="7d4a31dc-8858-4384-bbf4-a2222a0f3dcb">1</alampunktNr>
					<kuvatavNr id="bdba2dc1-7185-485e-93f9-6833c8d84f74"><![CDATA[1) ]]></kuvatavNr>
					<sisuTekst id="64cba0ee-82ac-43b5-adb3-76b1abd60c68">
						<tavatekst id="20917fc6-0947-45f2-8830-9fd110736763">hõbelusikas sündinud Tartu valla elanikule väärtuses kuni 40 eurot;</tavatekst>
					</sisuTekst>
				</alampunkt>
				<alampunkt id="para1lg1p2">
					<alampunktNr id="6df92bca-686c-43d0-b78b-8a02df403d15">2</alampunktNr>
					<kuvatavNr id="eb93ee3b-30ca-4940-b50e-ef002c34159a"><![CDATA[2) ]]></kuvatavNr>
					<sisuTekst id="e26ac987-b56b-40b7-a573-9512afb2d360">
						<tavatekst id="5e2fd8fe-ed88-4535-ab3f-3aafa671053b">ühe- kuni seitsmeaastaste koduste laste jõulupakid väärtuses kuni 25 eurot;</tavatekst>
					</sisuTekst>
				</alampunkt>
				<alampunkt id="para1lg1p3">
					<alampunktNr id="7e25e1bd-96f3-4721-8a9c-cef88b750f2c">3</alampunktNr>
					<kuvatavNr id="a230d4c4-09ff-44d2-95e8-7a47cdcb39c0"><![CDATA[3) ]]></kuvatavNr>
					<sisuTekst id="0d7df53c-2b2a-4ebd-b214-509bd564bad3">
						<tavatekst id="9d191fd2-afb7-4112-9d23-dcac4095df70">ranitsatoetus esmakordselt kooli õppima asuvale lapsele 100 eurot;</tavatekst>
					</sisuTekst>
				</alampunkt>
				<alampunkt id="para1lg1p4">
					<alampunktNr id="7e18941f-70dc-47fc-b2b4-1dcc4619906e">4</alampunktNr>
					<kuvatavNr id="35cda954-d7ee-4fca-8ea6-d77ebd555524"><![CDATA[4) ]]></kuvatavNr>
					<sisuTekst id="a2a9df58-b7a4-4fbd-9b73-90e3cf1516b0">
						<tavatekst id="535e84b0-cf65-44ab-9122-60260d8f344e">kriisiabi kuni 5000 eurot; </tavatekst>
					</sisuTekst>
				</alampunkt>
				<alampunkt id="para1lg1p5">
					<alampunktNr id="f91ed73c-7732-45e7-96e8-113d0e3bba3e">5</alampunktNr>
					<kuvatavNr id="7ef2712a-f483-4dfb-9315-65be1427aea7"><![CDATA[5) ]]></kuvatavNr>
					<sisuTekst id="1a6d9229-5644-4e85-8063-3c0b6c424192">
						<tavatekst id="eb45cd8c-bd8e-4052-a027-c98d361b9918">eakate tähtpäeva tervitus kuni 30 eurot;</tavatekst>
					</sisuTekst>
				</alampunkt>
				<alampunkt id="para1lg1p6">
					<alampunktNr id="d3f282f6-eeea-4a36-ac90-084178b7ef16">6</alampunktNr>
					<kuvatavNr id="22a13cdb-021d-4bc5-a711-4d4a9af299b6"><![CDATA[6) ]]></kuvatavNr>
					<sisuTekst id="8e00ce70-284e-4e33-a559-73132f6fcb9f">
						<tavatekst id="eef90de4-3068-4b46-a42a-a7b34115e8f4">hapniku tootmiseks vajaliku elektri kompenseerimine 100 eurot kvartalis;</tavatekst>
					</sisuTekst>
					<muutmismarge id="2148c906-f6b8-40b6-8e5b-e5725f02af4a">
						<avaldamismarge id="7a8c0e88-695a-4b68-a319-3816e5b9af30">
							<RTosa id="1055dd5f-8e6a-49c6-b679-7450f7c3b211">RT IV</RTosa>
							<avaldamineKuupaev id="dd1df1e0-b83f-4453-94e8-5a6420fe5c09">2022-01-26</avaldamineKuupaev>
							<RTartikkel id="427e9be7-a9bf-4ae4-8f8a-7b7a4afce8f6">4</RTartikkel>
							<aktViide id="6993d983-2f8a-4700-82ad-85b1ecf564a2">426012022004</aktViide>
						</avaldamismarge>
						<joustumine id="d8eb4a70-6c05-4a65-af28-08c6c8047237">2022-01-29</joustumine>
					</muutmismarge>
				</alampunkt>
				<alampunkt id="para1lg1p7">
					<alampunktNr id="cf8cb77a-7bd0-480b-81a4-47c585d7ff8f">7</alampunktNr>
					<kuvatavNr id="9f088573-7632-4da7-8fc6-fd307bcf3d8e"><![CDATA[7) ]]></kuvatavNr>
					<sisuTekst id="9433675e-f3de-4505-8c65-13f15be20423">
						<tavatekst id="7c0982f0-0c17-46ae-acc7-9ac37cd945e3"> koolisõidutoetus kuni 600 eurot õppeaastas kuludokumentide alusel. Isikliku sõiduki kasutamisel õpilaste transpordiks kooli ja tagasi hüvitatakse sõidupäeviku alusel kuni 0,30 eurot ühe sõidukilomeetri kohta;</tavatekst>
					</sisuTekst>
					<muutmismarge id="006598bf-6e15-40ea-9041-0c94db2c9534">
						<avaldamismarge id="60460729-b714-423e-8d4f-23930faf05ce">
							<RTosa id="a4da34e6-7624-498d-a077-bfe9386e08bb">RT IV</RTosa>
							<avaldamineKuupaev id="07e08b66-e6fe-4ffa-9fb7-b63acf87186c">2026-03-24</avaldamineKuupaev>
							<RTartikkel id="c4f633cd-8908-4b82-8560-e41a64b22dc1">3</RTartikkel>
							<aktViide id="17accc34-28d9-44ec-9012-86e759d43dbc">424032026003</aktViide>
						</avaldamismarge>
						<joustumine id="5243f99f-cd92-4fc3-a89e-04f6b461eef6">2026-05-01</joustumine>
					</muutmismarge>
				</alampunkt>
				<alampunkt id="para1lg1p8">
					<alampunktNr id="4bc61732-0ca7-45d5-8226-e875ed4e3b4b">8</alampunktNr>
					<kuvatavNr id="157a798e-f01a-4b4b-bfb5-541c1aeb67e8"><![CDATA[8) ]]></kuvatavNr>
					<sisuTekst id="3348ca80-a3ef-40ca-967e-3ee01e966106">
						<tavatekst id="96d821ae-30f2-45a2-80a4-99a5c371a125">muude erakorraliste kulude hüvitamine kuni 3000 eurot.</tavatekst>
					</sisuTekst>
					<muutmismarge id="bdf292d9-50b1-4bac-98c0-52068e388c83">
						<avaldamismarge id="dd598d44-6436-4c35-9148-a9adb2ad354d">
							<RTosa id="791bdb4f-1253-457b-a192-203694bc1598">RT IV</RTosa>
							<avaldamineKuupaev id="dc0505cf-4034-489e-bf7f-b8f9a1f84280">2024-03-08</avaldamineKuupaev>
							<RTartikkel id="6e90a84c-d48d-42dd-8bfa-353145f85b1d">22</RTartikkel>
							<aktViide id="8b1cd5c1-ccbd-41ab-b242-75cbab14d6df">408032024022</aktViide>
						</avaldamismarge>
						<joustumine id="0c78d599-23b9-4ade-b977-74fa5f985183">2024-03-11</joustumine>
					</muutmismarge>
				</alampunkt>
			</loige>
		</paragrahv>
		<paragrahv id="para2">
			<paragrahvNr id="119fa37e-f3b1-4d97-b158-0424d05efa98">2</paragrahvNr>
			<kuvatavNr id="91031215-46d0-4642-b32c-110fbf2f435d"><![CDATA[§ 2. ]]></kuvatavNr>
			<paragrahvPealkiri id="8e3c0189-79a8-4e27-85c4-a7e1d6f39cf5">Sissetulekust sõltuvad toetused</paragrahvPealkiri>
			<loige id="para2lg1">
				<loigeNr id="1461b924-8990-47ed-9ce5-5e402d0ee275"/>
				<kuvatavNr id="9cb991af-8d36-46df-89ad-75c9a11a6eea"/>
				<sisuTekst id="aebf2238-22fa-486c-93c3-cfb43296ff82">
					<tavatekst id="b8298c72-847f-45b5-ab28-2a3f4dd8064b">Sissetulekust sõltuvate toetuste määrad on järgmised:</tavatekst>
				</sisuTekst>
				<alampunkt id="para2lg1p1">
					<alampunktNr id="2d62e248-3a82-47d4-91a1-1f235623ffac">1</alampunktNr>
					<kuvatavNr id="3fa42ef6-0b31-40a3-b2a3-c165252ecb31"><![CDATA[1) ]]></kuvatavNr>
					<sisuTekst id="15f90b7f-6f3c-4f48-b66a-039841caeca0">
						<tavatekst id="469adbe1-16fc-43a9-a46b-c2e63dcf712f">tervisetoetused kuni 300 eurot aastas;</tavatekst>
					</sisuTekst>
				</alampunkt>
				<alampunkt id="para2lg1p2">
					<alampunktNr id="8ea0815e-3bb9-4cb3-ba26-e181b1cedf1f">2</alampunktNr>
					<kuvatavNr id="395d54ed-4cfa-43a1-a49d-76faab66dfd9"><![CDATA[2) ]]></kuvatavNr>
					<sisuTekst id="dbc53c54-b1a3-443a-a64d-2016959f5294">
						<tavatekst id="68fe5c50-b852-4cde-b598-1f2c9f429865">ravimitoetus kuni 50 eurot aastas;</tavatekst>
					</sisuTekst>
					<muutmismarge id="faf54e1c-0aaa-44b5-8b40-95ff03e957df">
						<avaldamismarge id="2212403b-a11e-4172-8b3c-b9fd7afc33c4">
							<RTosa id="56947af7-8d29-4f09-831f-ab778e87b412">RT IV</RTosa>
							<avaldamineKuupaev id="5a3b85cc-de24-4dfc-9166-61a78e9a89fc">2019-12-10</avaldamineKuupaev>
							<RTartikkel id="5a827fae-2bbc-4ab0-b4b1-2ca57c91206e">2</RTartikkel>
							<aktViide id="5620e41d-25ca-4dc1-81fa-20aebc6973a5">410122019002</aktViide>
						</avaldamismarge>
						<joustumine id="7162a9f7-5269-4f7a-b5e9-de350828d7fa">2020-01-01</joustumine>
						<aktiNr id="cf0f873f-fe28-42cb-ba0f-8b7663c89525">26</aktiNr>
					</muutmismarge>
				</alampunkt>
				<alampunkt id="para2lg1p3">
					<alampunktNr id="42f31e73-a1ce-44f8-91cd-0a10d8dd16c9">3</alampunktNr>
					<kuvatavNr id="f6aa9758-6f03-4ef5-8eb0-21df50a30714"><![CDATA[3) ]]></kuvatavNr>
					<sisuTekst id="997d1a82-9ce8-4b49-9ed4-a9f7b7f80357">
						<tavatekst id="455494bd-bfe0-474a-9647-b20b9ef1d4b7">toetused lastega peredele kuni 400 eurot aastas;</tavatekst>
					</sisuTekst>
				</alampunkt>
				<alampunkt id="para2lg1p4">
					<alampunktNr id="312eec68-831b-410b-9440-c326a6f8d61e">4</alampunktNr>
					<kuvatavNr id="18cc22c4-3713-4fb0-ae14-88fa83735c24"><![CDATA[4) ]]></kuvatavNr>
					<sisuTekst id="db5f4c52-8561-4e37-abff-10f2a3a4fe13">
						<tavatekst id="6c0cbb27-cdf7-4a81-ae36-9e535aecf399">koolitoetus kuni 100 eurot aastas; </tavatekst>
					</sisuTekst>
