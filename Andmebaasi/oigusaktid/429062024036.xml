      <sisuTekst id="ab004bb2-0ff0-475e-b106-f8ad4732b73d">
    <tavatekst id="3da69b58-2b4d-4f4f-9d2b-4e5510b53100">Määrus jõustub 1. augustil 2024.</tavatekst>
