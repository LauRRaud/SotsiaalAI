 <sisu id="e6ece73a-5531-4309-a6ce-2f8fe7e07263"><preambul id="cebfdd07-d4e6-45a6-9c2b-7e2c5e8c798f"><tavatekst id="c615bb62-b46a-4809-8b92-8d9650afc67b">Määrus kehtestatakse kohaliku omavalitsuse korralduse seaduse § 6 lõike 1, § 22 lõike 1 punkti 37 ning sotsiaalhoolekande seaduse § 14 lõike 1 ja § 156 alusel.</tavatekst></preambul><paragrahv id="para1"><paragrahvNr id="f3880de4-7a64-4940-87e7-c936823da82a">1</paragrahvNr><kuvatavNr id="50792586-ebf7-433a-9f93-51412c1e14df"><![CDATA[§ 1. ]]></kuvatavNr><paragrahvPealkiri id="4022a4a5-98f4-42d4-a0aa-75078d18454d">Üldsätted</paragrahvPealkiri><loige id="para1lg1"><loigeNr id="e3c2dcf8-0b16-4c1e-af95-8611b107442c">1</loigeNr><kuvatavNr id="ed614448-9197-488e-8dc0-c44b654bb3d1"><![CDATA[(1)]]></kuvatavNr><sisuTekst id="637e70d5-2df8-4c7b-b159-89557410ec82"><tavatekst id="72bd125d-9661-4076-bd25-d9be7f81d0fc">Määrus reguleerib Kohila vallale riigieelarvest raske ja sügava puudega lastele abi osutamiseks<reavahetus/>eraldatud rahaliste vahendite kasutamist.</tavatekst></sisuTekst></loige><loige id="para1lg2"><loigeNr id="baec3372-a8d0-454d-acfc-f4a2c87c2514">2</loigeNr><kuvatavNr id="3d30b33a-0d33-407d-b2cd-d9e5b646dfe7"><![CDATA[(2)]]></kuvatavNr><sisuTekst id="33e77d8b-0edc-4e6d-9dde-cf64b664bea4"><tavatekst id="a9bb9ac2-a7a0-41de-88b3-81b0936628cf">Raske ja sügava puudega lastele abi osutamiseks eraldatud rahalisi vahendeid võib kasutada raske ja sügava puudega lastele ja nende peredele sotsiaalteenuste osutamiseks ja arendamiseks, kelle elukohaks rahvastikuregistri andmetel on Kohila vald.</tavatekst></sisuTekst></loige></paragrahv><paragrahv id="para2"><paragrahvNr id="22c2a417-7d56-44f0-b834-241fc27e614f">2</paragrahvNr><kuvatavNr id="ddecac55-dfcf-4ee0-ab30-34fa3bf00b83"><![CDATA[§ 2. ]]></kuvatavNr><paragrahvPealkiri id="a8b98d78-a8b4-492e-8552-af1dd1507533">Rahaliste vahendite kasutamine</paragrahvPealkiri><loige id="para2lg1"><loigeNr id="4dd7f746-c8e5-49c6-8174-2c8f78f62444"/><kuvatavNr id="cb09097d-7dac-4da1-bb7c-7d45688d9977"/><sisuTekst id="f8a2c3a1-ef47-4022-94fa-170722825b70"><tavatekst id="3e621658-6791-4cc7-97a3-b754f528bf47">Riigieelarvest eraldatavaid rahalisi vahendeid võib kasutada raske ja sügava puudega laste ja nende peredega seotud sotsiaalteenuste osutamiseks ja arendamiseks, sealhulgas:</tavatekst></sisuTekst><alampunkt id="para2lg1p1"><alampunktNr id="909aa932-9b1a-403f-a155-39e63877a2d7">1</alampunktNr><kuvatavNr id="13d0da37-85e1-42ee-a35b-d32240aeb824"><![CDATA[1) ]]></kuvatavNr><sisuTekst id="e2ef909c-174c-4b15-b996-db9dc5349066"><tavatekst id="65c73758-a9a6-4f1d-ad73-25b3ad130544">lapsehoiuteenuseks;</tavatekst></sisuTekst></alampunkt><alampunkt id="para2lg1p2"><alampunktNr id="50bc3498-9f03-4b7c-b972-750e18d66cf7">2</alampunktNr><kuvatavNr id="4201c4c5-f356-42c4-855b-8d1822d72fa1"><![CDATA[2) ]]></kuvatavNr><sisuTekst id="5bc5193b-6ea6-4e99-b6ae-22c4f0474567"><tavatekst id="9c8b2f4f-883f-4b82-8ab1-35558b6b1d0c">isiku abistaja või tugiisikuteenuse osutamiseks;</tavatekst></sisuTekst></alampunkt><alampunkt id="para2lg1p3"><alampunktNr id="863982d1-fc58-47a5-b55f-dac3634dbd08">3</alampunktNr><kuvatavNr id="052f0f42-e4e0-4a4a-97e2-e12ca1ec2bf6"><![CDATA[3) ]]></kuvatavNr><sisuTekst id="9c23a52c-fd0d-4966-9030-50bce5dcb129"><tavatekst id="f923457b-b262-49c7-ad0c-b0270df22c8a">transporditeenuseks haridus-, ravi või rehabilitatsiooniasutusse;</tavatekst></sisuTekst></alampunkt><alampunkt id="para2lg1p4"><alampunktNr id="da9e2cf2-57e5-4ca2-90b5-9e3c086fcaee">4</alampunktNr><kuvatavNr id="ebc4619a-c238-43b6-ad9d-9b9e465a5f84"><![CDATA[4) ]]></kuvatavNr><sisuTekst id="2b0c6b72-63c3-4006-80d1-a403a249d39d"><tavatekst id="894b4c20-b45e-45c6-9ced-6d5a2aebecfb">eluruumide kohandamiseks;</tavatekst></sisuTekst></alampunkt><alampunkt id="para2lg1p5"><alampunktNr id="7d03a083-7210-4619-8d3a-fc14d4d9ed69">5</alampunktNr><kuvatavNr id="0f27d784-4060-4d7e-a5b3-3991a86ebdb2"><![CDATA[5) ]]></kuvatavNr><sisuTekst id="c0d5f2a7-d758-45dc-b2ae-fcf774d018e7"><tavatekst id