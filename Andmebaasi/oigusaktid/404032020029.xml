   <pealkiri id="29ea9f7d-f265-430b-8647-fd017349e334">Isikliku abistaja teenuse osutamise kord Kastre vallas</pealkiri>
  </nimi>
 </aktinimi>
 <sisu id="c6fa2942-91b0-4383-a88d-8a04a9a0dcb6"><preambul id="3ee10d52-477c-42ea-b14c-59e1e1022b8b"><tavatekst id="27eb7c37-72ce-440a-88c0-896a65ba9289">Määrus kehtestatakse kohaliku omavalitsuse korralduse seaduse § 6 lg 1, § 22 lg 1 p 5 ja sotsiaalhoolekande seaduse § 16 lg 1, § 27, § 28 ning § 29 alusel.</tavatekst></preambul><paragrahv id="para1"><paragrahvNr id="ecc0876e-519d-4fc6-9bc3-8aa4a3a8b354">1</paragrahvNr><kuvatavNr id="2e8a5c4d-6bcb-4815-96a3-80640f2ef972"><![CDATA[§ 1. ]]></kuvatavNr><paragrahvPealkiri id="cbd9b1af-bb6d-4b21-ba02-798c417f2203">Üldsätted</paragrahvPealkiri><loige id="para1lg1"><loigeNr id="283d7b56-e6cf-4638-b63b-c038db33feaa">1</loigeNr><kuvatavNr id="223c3b4c-2470-47e6-8254-146660e44380"><![CDATA[(1)]]></kuvatavNr><sisuTekst id="4e5f393f-a161-49cb-a79e-caf426908853"><tavatekst id="9f8a8fbc-e24a-4165-a3d1-f55ad76c051d">Isikliku abistaja teenuse osutamise kord (edaspidi kord) sätestab puudega inimesele isikliku abistaja teenuse (edaspidi teenus) taotlemise, taotluse menetlemise ja teenuse määramise ja osutamise tingimused ning korra.</tavatekst></sisuTekst></loige><loige id="para1lg2"><loigeNr id="03a8f92e-71d6-4b60-9b87-9a30cc132981">2</loigeNr><kuvatavNr id="29df4cc1-345f-4712-a24b-04b14643ec6d"><![CDATA[(2)]]></kuvatavNr><sisuTekst id="0334ace9-c390-447c-b26e-e6d970f786bb"><tavatekst id="17b83c3f-26a1-407d-ba77-1969f16178dc">Teenuse eesmärk on:</tavatekst></sisuTekst><alampunkt id="para1lg2p1"><alampunktNr id="4040d63b-bf78-49e7-bdbb-cec829e354c1">1</alampunktNr><kuvatavNr id="74495ede-ff8c-4137-873c-720f33e599a7"><![CDATA[1) ]]></kuvatavNr><sisuTekst id="b0b61103-6305-43a2-87cf-b6ae1ddfffea"><tavatekst id="d9ec6823-fc47-4299-9314-65dd35664359">suurendada puude tõttu füüsilist kõrvalabi vajava täisealise isiku iseseisvat toimetulekut ja osalemist kõigis eluvaldkondades;</tavatekst></sisuTekst></alampunkt><alampunkt id="para1lg2p2"><alampunktNr id="d99f0b0a-a172-4f18-b946-b7491a76afcc">2</alampunktNr><kuvatavNr id="4853d359-bfaf-4bf4-b7b8-34107701f31d"><![CDATA[2) ]]></kuvatavNr><sisuTekst id="14a0aa2c-6cd7-43c1-bd9e-b9e4677f7077"><tavatekst id="8191c639-5f78-4afa-a952-a55549690424">vähendada puude tõttu füüsilist kõrvalabi vajava täisealise inimese pereliikmete ja lähedaste hoolduskoormust ning toetada nende sõltumatust ja sotsiaalset aktiivsust, sealhulgas tööturul osalemist.</tavatekst></sisuTekst></alampunkt></loige><loige id="para1lg3"><loigeNr id="8633813e-f08b-429e-8a78-f3af651fc1ac">3</loigeNr><kuvatavNr id="f5768019-a1a3-46f6-8190-d3a371fd6e83"><![CDATA[(3)]]></kuvatavNr><sisuTekst id="0e60fbb1-8606-460a-b072-d1ffb3217ae3"><tavatekst id="74838a2a-b28b-42df-a17a-e192e1fa5da3">Teenuse osutamist korraldab Kastre Vallavalitsus (edaspidi vallavalitsus).</tavatekst></sisuTekst></loige></paragrahv><paragrahv id="para2"><paragrahvNr id="dffdabe1-d0e7-4b40-95dc-ad8284bd771a">2</paragrahvNr><kuvatavNr id="369bede2-77c3-496c-847b-3fc46328a440"><![CDATA[§ 2. ]]></kuvatavNr><paragrahvPealkiri id="74399496-5283-4908-ab0f-5c8657e01f41">Teenuse saaja õigused ja kohustused</paragrahvPealkiri><loige id="para2lg1"><loigeNr id="24241cc8-03b3-440f-8d8e-413318137b54">1</loigeNr><kuvatavNr id="60fde40a-c4c6-449e-88d8-2baf9b06dd3d"><![CDATA[(1)]]></kuvatavNr><sisuTekst id="0e87af3b-29aa-4d6a-b8df-67fcf07b04df"><tavatekst id="8faf4fe3-a147-4dba-932d-1d8419ec80a9">Teenust on õigus saada eelkõige puude tõttu füüsilist kõrvalabi vajaval täisealisel isikul (edaspidi teenuse saaja).</tavatekst></sisuTekst></loige><loige id="para2lg2"><loigeNr id="06f2e625-0ecb-4dd8-8739-cdb6660e167f">2</loigeNr><kuvatavNr id="f3861f53-a53b-49e7-bb23-4350f3f1b6e5"><![CDATA[(2)]]></kuvatavNr><sisuTekst id="5021db3d-5aed-4ffd-bd61-538d9f18243d"><tavatekst id="192ab0c9-fce1-4e0a-afe6-832493c6d532">Teenus määratakse täisealisele isikule:</tavatekst></sisuTekst><alampunkt id="para2lg2p1"><alampunktNr id="5196e9ea-7296-4447-b59f-a3fa3906e506">1</alampunktNr><kuvatavNr id="419e7d4e-322c-4a19-975a-ad0705325ce4"><![CDATA[1) ]]></kuvatavNr><sisuTekst id="dd02b772-960e-4edf-b3d4-d9dc21b996d6"><tavatekst id="5be60728-9f3f-4541-ad4f-639a5f128472">kelle elukohana on Eesti rahvastikuregistris (edaspidi rahvastikuregister) registreeritud Kastre vald ja kelle tegelik elukoht on Kastre vald või kelle elukohana on rahvastikuregistris registreeritud Kastre vald, kuid kes viibib ajutiselt teises kohalikus omavalitsuses õpingute või töötamise tõttu;</tavatekst></sisuTekst></alampunkt><alampunkt id="para2lg2p2"><alampunktNr id="069a1b5a-39ad-47f2-8f68-828e87f55b71">2</alampunktNr><kuvatavNr id="e66f5d79-9b3a-483b-b4f6-78c0b7df5df1"><![CDATA[2) ]]></kuvatavNr><sisuTekst id="5f95d163-90a4-486b-bd5b-26865284eb63"><tavatekst id="6b30c924-d12e-48c7-a7a7-d9f4f4ed9787">kes ei tule füüsilise kõrvalabi vajaduse tõttu iseseisvalt toime igapäevaste tegevustega ja vajab kõrvalabi;</tavatekst></sisuTekst></alampunkt><alampunkt id="para2lg2p3"><alampunktNr id="2d4f3fa4-746e-407e-9c41-425a280fa86b">3</alampunktNr><kuvatavNr id="858b26a2-c274-457f-8e4d-960ce47dff63"><![CDATA[3) ]]></kuvatavNr><sisuTekst id="bd3c0c28-a12e-42aa-8eba-e2eccda3c2ae"><tavatekst id="82b430db-7373-4308-aeed-7cc394c7d9ae">kes on ise võimeline vastu võtma oma elukorraldust puudutavaid otsuseid ning oma vajadustest lähtuvalt juhendama isiklikku abistajat asjaajamise korraldamisel;</tavatekst></sisuTekst></alampunkt><alampunkt id="para2lg2p4"><alampunktNr id="b27e56ee-a8f7-45a9-a1cb-6e506bc964e2">4</alampunktNr><kuvatavNr id="a4d7e94e-5703-4a9a-aaaa-3762ac569840"><![CDATA[4) ]]></kuvatavNr><sisuTekst id="8f1b94e9-eff4-4383-844c-b893f479caed"><tavatekst id="711bc074-1f59-4d13-86da-7fc33c205be8">oskab selgelt ja arusaadavalt oma vajadustest lähtuvalt teenuse vahetut osutajat juhendada.</tavatekst></sisuTekst></alampunkt></loige><loige id="para2lg3"><loigeNr id="40faf896-1b12-419c-a42f-752f46613d5d">3</loigeNr><kuvatavNr id="4290d253-0ccd-4c3a-b854-4abfdc72ee31"><![CDATA[(3)]]></kuvatavNr><sisuTekst id="10c286f3-5bda-4a1a-896b-dfca5b07e7bd"><tavatekst id="bc321799-e830-46c4-9c67-5c15e8fc8c0a">Kui teenuse saaja on piiratud teovõimega täisealine isik, lähtub isiklik abistaja eestkostja antavatest tööjuhistest.</tavatekst></sisuTekst></loige><loige id="para2lg4"><loigeNr id="c086d146-b73e-4225-b39d-0529eb82042e">4</loigeNr><kuvatavNr id="cf8c18b2-7d57-44a7-8181-b431c09733a4"><![CDATA[(4)]]></kuvatavNr><sisuTekst id="f157cb72-e594-42f7-86b3-32bdf3cf8ec3"><tavatekst id="0b73e341-5249-4a5e-85a0-17c08331c86c">Isikutele, kelle tegelik elukoht on Kastre vald, kuid rahvastikuregistri järgi ei ole Kastre valla elanik, võib Kastre vald abi andmist korraldada kooskõlastatult isiku rahvastikuregistrisse kantud elukoha järgse kohaliku omavalitsuse üksusega.</tavatekst></sisuTekst></loige><loige id="para2lg5"><loigeNr id="93aea837-07d7-4395-a4af-45083da42829">5</loigeNr><kuvatavNr id="2d87b77a-b6f6-447f-8f61-5651bec7c92f"><![CDATA[(5)]]></kuvatavNr><sisuTekst id="1d2e6d80-a58f-4e58-a2aa-0a1259217ac6"><tavatekst id="ff2e0cf9-58b7-4c47-ad45-4a19410f72c3">Kulutused, mis isiklikul abistajal tekivad teenuse saaja saatmisel (kinopilet vms), tasub üldjuhul teenuse saaja.</tavatekst></sisuTekst></loige><loige id="para2lg6"><loigeNr id="4c989088-de24-4e65-bfbf-e7d6ec7e2a67">6</loigeNr><kuvatavNr id="76af048d-f527-4dc1-be39-572a2897be6b"><![CDATA[(6)]]></kuvatavNr><sisuTekst id="2db6fb82-830d-4668-b767-d2629094bf6e"><tavatekst id="3edee9bd-0ebd-41d6-b818-67c3d9cbe1fc">Isikliku abistaja tööülesannete täitmiseks vajaliku juhendamise eest vastutab teenuse saaja.</tavatekst></sisuTekst></loige></paragrahv><paragrahv id="para3"><paragrahvNr id="37def170-f936-49df-8700-aa06e63275e5">3</paragrahvNr><kuvatavNr id="389b0872-6f34-42f4-8080-7b7b686aa88f"><![CDATA[§ 3. ]]></kuvatavNr><paragrahvPealkiri id="a64576bc-f24a-4cb0-8a8e-855a43471a84">Isiklik abistaja</paragrahvPealkiri><loige id="para3lg1"><loigeNr id="13fe55b2-5c9f-4c7f-ad43-3f49dde95595">1</loigeNr><kuvatavNr id="d6d2196c-ed78-4781-be91-c967b26ee9a4"><![CDATA[(1)]]></kuvatavNr><sisuTekst id="cb562cbc-8899-442d-a159-1a26798715dd"><tavatekst id="168ba107-117d-496e-9c2d-05fbfaa414b6">Isiklik abistaja (edaspidi abistaja) on vahetu teenuse osutaja, kes abistab teenusele määratud isikut lähtuvalt teenuse saaja füüsilisest puudest tingitud erivajadustest.</tavatekst></sisuTekst></loige><loige id="para3lg2"><loigeNr id="87475788-f9f7-421b-bc50-0aeb28bd91a0">2</loigeNr><kuvatavNr id="cfd53d37-fbb7-4b37-ab70-2b2c7213fe0a"><![CDATA[(2)]]></kuvatavNr><sisuTekst id="df623fb5-0ce7-410e-afad-e72b27b78169"><tavatekst id="02c47323-7454-4381-aadd-fffef364f2fe">Abistaja aitab teenuse saajat liikumisel, söömisel, toidu valmistamisel, riietumisel, suhtlemisel, hügieenitoimingutel, kirjutamisel, lugemisel, igapäevaste majapidamistööde teostamisel ja muudes toimingutes ning tegevustes, milles isik vajab juhendamist või kõrvalabi.</tavatekst></sisuTekst></loige><loige id="para3lg3"><loigeNr id="851a24a5-bb33-400f-b07e-b1ca0804c071">3</loigeNr><kuvatavNr id="0282e8ee-9df6-4d10-a625-3fa37192c5e9"><![CDATA[(3)]]></kuvatavNr><sisuTekst id="c56be978-feef-4e8b-b430-0e9522987dda"><tavatekst id="96beb07e-136e-43d0-b8e4-1f793612cd16">Abistaja tööülesannete hulka ei kuulu füüsilise abistamisega mitteseotud tegevused, mida tavapäraselt osutab eriväljaõppe ja -ettevalmistusega isik (nt meditsiinilised toimingud).</tavatekst></sisuTekst></loige><loige id="para3lg4"><loigeNr id="aaf8fa11-d4c3-4296-bd65-a261b1a7c7b0">4</loigeNr><kuvatavNr id="e8f1a629-a78e-4483-855a-5aa2348d8e60"><![CDATA[(4)]]></kuvatavNr><sisuTekst id="e7af4226-f50a-4dc3-b6f2-ab088b823fa5"><tavatekst id="770ff088-be6f-4322-bd33-f628bd39e420">Abistaja ei või üldjuhul olla vallavalitsuse poolt määratud hooldaja.</tavatekst></sisuTekst></loige><loige id="para3lg5"><loigeNr id="1b5fd8b3-2a62-465d-8452-72e4e00e9446">5</loigeNr><kuvatavNr id="1624f52e-b2ca-4fd8-9dda-ee0fc6bef36b"><![CDATA[(5)]]></kuvatavNr><sisuTekst id="b873626f-d9da-4acc-bd85-b574becbc8ca"><tavatekst id="6a57e7c7-752e-4116-8218-35995b297a9e">Abistaja ei või olla isik:</tavatekst></sisuTekst><alampunkt id="para3lg5p1"><alampunktNr id="10752e48-6832-4abe-99fc-3e1f96e5041e">1</alampunktNr><kuvatavNr id="74b469ef-316f-4b50-a71e-6d3512723e3f"><![CDATA[1) ]]></kuvatavNr><sisuTekst id="55bb7c7e-f447-4e99-b1b7-3b3650a4a8b6"><tavatekst id="d937653c-f21f-409f-99c6-fece649a1034">kes on teenuse saaja esimese või teise astme üleneja või alaneja sugulane;</tavatekst></sisuTekst></alampunkt><alampunkt id="para3lg5p2"><alampunktNr id="2b7d9929-b474-4bda-83a3-59ea2689a8fa">2</alampunktNr><kuvatavNr id="8e3c520c-ca38-4914-a255-3b44d32becf1"><![CDATA[2) ]]></kuvatavNr><sisuTekst id="3f1d11f9-0a29-45a8-bcde-4c71a0aed5c8"><tavatekst id="d386e321-8d21-4191-b7aa-36e73e3ca116">kes elab alaliselt või püsivalt samas eluruumis teenuse saajaga;</tavatekst></sisuTekst></alampunkt><alampunkt id="para3lg5p3"><alampunktNr id="0980ee10-aae2-486c-9481-9e596b7caa77">3</alampunktNr><kuvatavNr id="a6c415ca-8cd3-4660-9c8b-95aa325b87ca"><![CDATA[3) ]]></kuvatavNr><sisuTekst id="0dd9e2d0-3705-4ce4-9bd0-e2a1a8a40ee2"><tavatekst id="56b23c40-51d1-4f76-a07b-a4a462aa934b">kelle karistatus tahtlikult toimepandud kuriteo eest võib ohtu seada teenust saama õigustatud isiku elu, tervise ja vara.</tavatekst></sisuTekst></alampunkt></loige></paragrahv><paragrahv id="para4"><paragrahvNr id="e634229b-424c-4929-9ed9-1c7d8871572a">4</paragrahvNr><kuvatavNr id="727737e1-1084-4e75-b536-6f164ac7171a"><![CDATA[§ 4. ]]></kuvatavNr><paragrahvPealkiri id="3865d744-ffe1-45d0-a8ec-080d65e19e61">Abistaja õigused ja kohustused</paragrahvPealkiri><loige id="para4lg1"><loigeNr id="2f42508d-20b2-465f-a7ed-0f7a495c3dea">1</loigeNr><kuvatavNr id="bf4d206c-623e-4a62-b530-a58c9571679a"><![CDATA[(1)]]></kuvatavNr><sisuTekst id="bd8980f8-d06f-4ff5-951d-319db82571ca"><tavatekst id="f36d63c9-9cae-4adf-99b1-168a487fb8f4">Abistaja lähtub oma töös teenuse osutamiseks sõlmitud lepingus märgitud tööülesannetest, sotsiaalala töötaja eetikakoodeksist, teenuse saaja erivajadustest, vallavalitsuse ja teenuse saaja poolt antavatest tööjuhistest.</tavatekst></sisuTekst></loige><loige id="para4lg2"><loigeNr id="17e97105-abaf-4e5c-800f-b940b100ec6e">2</loigeNr><kuvatavNr id="c66502cf-e36e-4699-8ce2-5fce3337ceb2"><![CDATA[(2)]]></kuvatavNr><sisuTekst id="e19ae24c-76eb-4991-b7d4-fcee3168c45b"><tavatekst id="c2f4baa7-9df0-4c94-9c11-cae08b915ff9">Abistajal on õigus keelduda tegevustest, mida ei ole lepingus kokku lepitud, mis on seadusevastane või vastuolus heade kommetega. Tegevustest, mis ei ole teenuse osutamise lepingus fikseeritud, kuid on hädavajalikud käesoleva määruse §-s 1 lg 2 nimetatud eesmärgi saavutamiseks, vahetu osutaja keelduda ei tohi.</tavatekst></sisuTekst></loige><loige id="para4lg3"><loigeNr id="a84ecdfe-9a71-4aa4-b066-001e3d97052c">3</loigeNr><kuvatavNr id="981de3e3-53c7-4d18-8951-dc5f1a52d4ba"><![CDATA[(3)]]></kuvatavNr><sisuTekst id="f5b559aa-ef7e-4ab8-8afa-7b7b814cf5ec"><tavatekst id="87389b6a-49ca-4dcc-887b-429a7db407b4">Abistaja esitab vähemalt 30 päeva enne lepingu lõppemist kooskõlastatult teenuse saajaga sotsiaalosakonnale ülevaate teenuse saaja olukorrast ja teenuse mõjust.</tavatekst></sisuTekst></loige><loige id="para4lg4"><loigeNr id="ec304409-2a4f-4014-b20f-4cd8ed5db764">4</loigeNr><kuvatavNr id="87920cfb-78cc-439b-878b-2ae15df38765"><![CDATA[(4)]]></kuvatavNr><sisuTekst id="703be12b-d9a3-4379-94e5-7ec086fa70fe"><tavatekst id="6f06b0bd-af48-4e08-95e2-f39c712a6f77">Abistajal on õigus keelduda teenuse osutamisest narkootiliste, psühhotroopsete ainete või alkoholi sõltuvusprobleemidega, ohtlikke nakkushaigusi põdevale või ööpäevaringset hooldust vajavale isikule.</tavatekst></sisuTekst></loige><loige id="para4lg5"><loigeNr id="262b3391-fb53-4364-9635-e3097ff75168">5</loigeNr><kuvatavNr id="1dc692f1-3fd6-4de4-82a4-d84bc8e1a4e2"><![CDATA[(5)]]></kuvatavNr><sisuTekst id="dddab2f6-f83c-4546-bcfb-0cdfb30b5acb"><tavatekst id="973bc9aa-8375-4cee-83a3-cf16493beaeb">Abistaja tööaeg, -kohustused, -tasu ja -maht reguleeritakse abistaja tööd reguleerivas lepingus, mis sõlmitakse abistaja ja vallavalitsuse vahel.</tavatekst></sisuTekst></loige><loige id="para4lg6"><loigeNr id="c0917da4-772e-4af3-bad0-6307a3acdca3">6</loigeNr><kuvatavNr id="4507afff-76a0-4169-8a26-597fa11c79c8"><![CDATA[(6)]]></kuvatavNr><sisuTekst id="491c1647-162f-48ab-9a01-d8b85df8849f"><tavatekst id="01ce0ff6-1d99-4360-bb2c-4e979a6bee7b">Abistaja esitab sotsiaalosakonnale igakuiselt üldistatud tegevusaruande.</tavatekst></sisuTekst></loige></paragrahv><paragrahv id="para5"><paragrahvNr id="8fa6f841-1a46-403e-b420-80ad06c55495">5</paragrahvNr><kuvatavNr id="247aed23-4da4-4999-9340-624c247813ef"><![CDATA[§ 5. ]]></kuvatavNr><paragrahvPealkiri id="f2fe8c45-9ede-4f66-b1ed-6166aa28144b">Teenuse taotlemine</paragrahvPealkiri><loige id="para5lg1"><loigeNr id="0dfa95a0-e85b-48e8-89ee-4d1b069586c1">1</loigeNr><kuvatavNr id="e0feab7e-89f9-470d-900b-d11ba23797d1"><![CDATA[(1)]]></kuvatavNr><sisuTekst id="0f5ce88a-be7d-4fc1-b9a2-0fa8b70debf0"><tavatekst id="d22a8188-997f-4a05-a376-0d65ab397268">Teenuse taotlemiseks esitab teenuse taotleja (edaspidi taotleja), tema lähedane või muu asjast huvitatud isik vallavalitsusele vormikohase avalduse.</tavatekst></sisuTekst></loige><loige id="para5lg2"><loigeNr id="93611449-a67a-4829-9582-a6eec60e8cdc">2</loigeNr><kuvatavNr id="4981320c-2c37-4e97-ad34-d232410cd801"><![CDATA[(2)]]></kuvatavNr><sisuTekst id="f02457b5-30ca-47f6-8c76-8d36ec62a683"><tavatekst id="b9406aa3-4b54-4944-81ea-150817a2f4a3">Taotluses märgitakse taotleja isikuandmed, puude liik ja raskusaste ning kirjeldus teenusevajaduse kohta.</tavatekst></sisuTekst></loige><loige id="para5lg3"><loigeNr id="2fdc4904-2ffc-4012-afa5-7a8607115f8b">3</loigeNr><kuvatavNr id="daec54e6-f6d0-40fe-9ca2-630cdc3fa377"><![CDATA[(3)]]></kuvatavNr><sisuTekst id="736a1407-d7dd-4a68-bf9a-7e81e70ba0ad"><tavatekst id="a501a1af-2036-472a-a13c-eeb25881bb94">Taotlusega koos esitatakse puude määramise otsus ja/või rehabilitatsiooniplaan nende olemasolul.</tavatekst></sisuTekst></loige><loige id="para5lg4"><loigeNr id="c9613d04-25f6-4228-b4bd-cff82867dddc">4</loigeNr><kuvatavNr id="1de8489d-34a7-48d0-a5b4-9a7f6ae75f4e"><![CDATA[(4)]]></kuvatavNr><sisuTekst id="62e575c3-60b1-4841-bb92-50414e385a6c"><tavatekst id="6d4a2c4d-10dc-408a-b625-8e43c40ea86f">Taotluse vormi kinnitab vallavalitsus.</tavatekst></sisuTekst></loige></paragrahv><paragrahv id="para6"><paragrahvNr id="2af1804d-38ad-4532-927c-3b0771e6cbd0">6</paragrahvNr><kuvatavNr id="7ff5cfce-020d-4874-87dd-9804df65a263"><![CDATA[§ 6. ]]></kuvatavNr><paragrahvPealkiri id="71caa2a0-49a3-47ec-ab19-817e5ea30285">Taotluse läbivaatamine</paragrahvPealkiri><loige id="para6lg1"><loigeNr id="418fd89c-dfa7-472f-bfdf-a60eae8f6a2c">1</loigeNr><kuvatavNr id="a9a1d093-6f76-4365-8682-a3eaceae1c32"><![CDATA[(1)]]></kuvatavNr><sisuTekst id="d1310db2-1b07-4fdb-b76c-9a7637fe8b46"><tavatekst id="b0f2a379-c387-4729-afb5-cd4e58722eef">Sotsiaaltööspetsialist vaatab taotluse läbi ja hindab esitatud andmete, kodukülastuse, vestluse ja hindamismetoodika põhjal taotleja teenusevajadust.</tavatekst></sisuTekst></loige><loige id="para6lg2"><loigeNr id="26d4b701-f4c3-43bf-bc50-ed98e4ab5628">2</loigeNr><kuvatavNr id="6799d5fb-fe6a-471a-9827-905c789b4231"><![CDATA[(2)]]></kuvatavNr><sisuTekst id="607da065-571a-4db7-82c7-843e463cf4c8"><tavatekst id="74108ec5-f2e4-4693-a4d6-579fa8414d65">Hindamisel võib tugineda spetsialisti ning rehabilitatsiooniplaani järgseid teenuseid osutava meeskonna soovitustele.</tavatekst></sisuTekst></loige><loige id="para6lg3"><loigeNr id="c3b32194-930d-4c25-aa82-f10818df98c2">3</loigeNr><kuvatavNr id="ce518df3-63d6-41af-975f-38aa29198012"><![CDATA[(3)]]></kuvatavNr><sisuTekst id="cce66cc9-4325-4075-bf1f-96de2b69e261"><tavatekst id="a621b4c7-4886-4689-bebe-14d454f02989">Kui taotluses esineb puudusi, annab sotsiaaltööspetsialist taotlejale tähtaja puuduste kõrvaldamiseks. Andmete esitamisest keeldumisel, ettenähtud tähtajaks esitamata jätmisel või valeandmete esitamisel jäetakse taotlus läbi vaatamata.</tavatekst></sisuTekst></loige><loige id="para6lg4"><loigeNr id="d1803e2b-32a3-4633-b35e-b27f16886c7e">4</loigeNr><kuvatavNr id="ead64e1b-8238-4bdd-a548-10be42d205a4"><![CDATA[(4)]]></kuvatavNr><sisuTekst id="5d6ae3de-71d6-4552-9c01-1efd81ea0016"><tavatekst id="f70fbe94-df92-4a91-abec-1f9b729b0154">Sotsiaaltööspetsialistil on taotleja teenusevajaduse selgitamiseks õigus nõuda lisadokumente. Andmete esitamisest keeldumisel, ettenähtud tähtajaks esitamata jätmisel või valeandmete esitamisel jäetakse taotlus läbi vaatamata.</tavatekst></sisuTekst></loige><loige id="para6lg5"><loigeNr id="404ee4ad-ab57-44fd-85c5-613ffda0f29b">5</loigeNr><kuvatavNr id="b33d3a81-544a-4c23-a073-d3bd55a122d5"><![CDATA[(5)]]></kuvatavNr><sisuTekst id="9fc7d115-d168-43f5-b916-75a32c9f7dbf"><tavatekst id="d0f1f7ba-d781-418e-ba45-59432d57d24f">Teenusevajaduse hindamismetoodika kinnitab vallavalitsus.</tavatekst></sisuTekst></loige></paragrahv><paragrahv id="para7"><paragrahvNr id="a33f0b7b-ef3c-49e3-90cd-b8dac2695c0c">7</paragrahvNr><kuvatavNr id="8043c24b-32d9-4f68-85c7-ecfc5de1d58f"><![CDATA[§ 7. ]]></kuvatavNr><paragrahvPealkiri id="95073df5-e852-45df-a9cd-ce26934f131f">Teenuse määramine</paragrahvPealkiri><loige id="para7lg1"><loigeNr id="4857fa89-61dd-47b6-a21a-e075d404eafb">1</loigeNr><kuvatavNr id="eaf655d1-3d48-417f-8595-6eaf5ab39557"><![CDATA[(1)]]></kuvatavNr><sisuTekst id="9dc5c9fa-72ad-4c15-8554-cd31b24db074"><tavatekst id="c4d4cc62-2159-4e96-9e9f-0542160458b4">Sotsiaaltööspetsialist teeb hindamise tulemusel vallavalitsusele ettepaneku teenuse, sealhulgas teenuse mahu määramiseks või teenuse määramisest keeldumiseks.</tavatekst></sisuTekst></loige><loige id="para7lg2"><loigeNr id="d9eb9c85-a65f-470d-80f7-68cd1f1fde23">2</loigeNr><kuvatavNr id="4091fedb-5542-47fa-802f-e5786931e6f2"><![CDATA[(2)]]></kuvatavNr><sisuTekst id="5c6613e8-8252-4fa1-b1db-ebd29727fb43"><tavatekst id="937b4e02-726d-4427-aa47-26a961945be9">Teenuse määramise või sellest keeldumise otsustab vallavalitsus 10 tööpäeva jooksul nõuetekohase taotluse esitamisest. Teenuse mahu, sealhulgas isikut abistavad tegevused kinnitab vallavalitsus korraldusega.</tavatekst></sisuTekst></loige><loige id="para7lg3"><loigeNr id="251c7f6c-e1b9-42bc-a0a3-99f4b90de078">3</loigeNr><kuvatavNr id="7f8fcdca-6fef-4660-befa-ebc75e575db6"><![CDATA[(3)]]></kuvatavNr><sisuTekst id="ec13cbed-313d-4570-98a0-ae00c9ddb567"><tavatekst id="626263b2-cc55-44d5-946b-12dab5381e27">Vallavalitsus jätab teenuse määramata, kui:</tavatekst></sisuTekst><alampunkt id="para7lg3p1"><alampunktNr id="9cdab095-8393-4370-86fc-c6178f9819bb">1</alampunktNr><kuvatavNr id="a51a55a7-6466-43e7-89c1-11b61a8e28d0"><![CDATA[1) ]]></kuvatavNr><sisuTekst id="d61f908c-7e1b-453e-a754-fdd28b1424ec"><tavatekst id="858699d6-2b75-4ddd-8876-b51957ca5458">teenuse vajaduse hindamisel ei tuvastatud teenuse vajadust;</tavatekst></sisuTekst></alampunkt><alampunkt id="para7lg3p2"><alampunktNr id="630fd0ae-60d1-4be5-b421-e7424153bee1">2</alampunktNr><kuvatavNr id="8f9895ca-a2ff-4340-9e40-7c76913d3360"><![CDATA[2) ]]></kuvatavNr><sisuTekst id="8896bd7b-1240-4c24-9c0a-26aefedec2bd"><tavatekst id="96140435-4ef6-48bc-9712-a2b9273df368">isik viibib haiglas ja vajab ravi;</tavatekst></sisuTekst></alampunkt><alampunkt id="para7lg3p3"><alampunktNr id="506bbc96-8fef-45e3-bdc5-b7f30adbc5f3">3</alampunktNr><kuvatavNr id="3844e016-80b5-485e-b19b-16d2229daec5"><![CDATA[3) ]]></kuvatavNr><sisuTekst id="6a7de050-4855-4a64-8b07-ef2d437b6434"><tavatekst id="8aa0c85a-84a0-400e-a66a-6094640d396d">isik põeb nakkushaigusi nakkavas faasis;</tavatekst></sisuTekst></alampunkt><alampunkt id="para7lg3p4"><alampunktNr id="025d99ac-85bd-45f3-81d9-7416729e9dcf">4</alampunktNr><kuvatavNr id="c5610f38-d2d1-4742-a169-bc444cb5176d"><![CDATA[4) ]]></kuvatavNr><sisuTekst id="a1ec8d95-ffbe-44b6-90ee-2ef849d5e69a"><tavatekst id="0f036acf-c598-4db0-b026-cca642870e57">isikul on narkootiliste, psühhotroopsete ainete või alkoholi sõltuvusprobleemid.</tavatekst></sisuTekst></alampunkt></loige></paragrahv><paragrahv id="para8"><paragrahvNr id="c8015a26-3fe4-4867-b16c-3690fcebb8a0">8</paragrahvNr><kuvatavNr id="12ca526d-a405-4797-9cac-d276d937b145"><![CDATA[§ 8. ]]></kuvatavNr><paragrahvPealkiri id="5f8f572d-d354-4deb-87ed-6371df38df9a">Lepingu sõlmimine</paragrahvPealkiri><loige id="para8lg1"><loigeNr id="7b903096-68ed-4b81-ad51-d3eace49da49">1</loigeNr><kuvatavNr id="f6f568c4-0133-49a5-9533-aa82b03d459a"><![CDATA[(1)]]></kuvatavNr><sisuTekst id="63e8317b-cf29-4232-b670-5ca7a2f5d63f"><tavatekst id="55d852b4-e7ec-402c-8e36-5b3d5bbba644">Teenuse osutamiseks sõlmitakse vallavalitsuse, abistaja ja teenuse saaja või tema seadusejärgse ülalpidamiskohustusega isiku vahel kirjalik teenuse osutamise leping (edaspidi leping). Lepingus sätestatakse isikule osutatavate teenuste sisu, maht ning poolte õigused ja kohustused.</tavatekst></sisuTekst></loige><loige id="para8lg2"><loigeNr id="198e6c07-e085-4805-a208-8c98bb99f575">2</loigeNr><kuvatavNr id="61b67c58-3a1e-40ea-97a0-725f2aa2e928"><![CDATA[(2)]]></kuvatavNr><sisuTekst id="c444a065-542e-4cd1-a2e7-d8495326ffd6"><tavatekst id="b172f02b-1496-49dd-b4c4-7f8965500365">Leping sõlmitakse tähtajaliselt kestusega kuni 1 aasta. Lepingu juurde kuuluvad taotleja avaldus, hindamisvahend, lepingu lisad ja muud asjakohased dokumendid.</tavatekst></sisuTekst></loige></paragrahv><paragrahv id="para9"><paragrahvNr id="a9789f88-a5fe-4947-987f-3e8c9baa4082">9</paragrahvNr><kuvatavNr id="2bb355fc-ca6f-41a0-829d-7c5c1741550e"><![CDATA[§ 9. ]]></kuvatavNr><paragrahvPealkiri id="bae0b421-50cc-46d3-9473-a9928e9e3284">Teenuse eest tasumine</paragrahvPealkiri><loige id="para9lg1"><loigeNr id="90a5af16-eb35-440c-bca9-ee05a936ce97">1</loigeNr><kuvatavNr id="e04c5086-7de5-4173-ac2e-1a61c1cd54cd"><![CDATA[(1)]]></kuvatavNr><sisuTekst id="3852289d-bbdb-43cc-b75b-e943f6f12351"><tavatekst id="b9e4788b-4c49-4e30-a0b0-660f40486f93">Teenus on teenuse saajale tasuline.</tavatekst></sisuTekst></loige><loige id="para9lg2"><loigeNr id="2ee6f8f0-f1ae-4ec1-ad11-9832749568cc">2</loigeNr><kuvatavNr id="de818738-3112-4da7-b5d9-c6fb4e9cff4f"><![CDATA[(2)]]></kuvatavNr><sisuTekst id="1189195a-b442-4d20-a8c4-359e88304da7"><tavatekst id="1b2982ad-c94b-452a-9f0f-9264b0b738b3">Teenuse hinna kehtestab vallavalitsus.</tavatekst></sisuTekst></loige><loige id="para9lg3"><loigeNr id="3a46a221-05d5-4c6b-a881-85d4044f8e6e">3</loigeNr><kuvatavNr id="9637a47f-79c2-44fe-90ac-946a8ed6b084"><![CDATA[(3)]]></kuvatavNr><sisuTekst id="cfe16eaf-e3f1-4a33-b26c-07a37af273ac"><tavatekst id="d2429b44-ceb5-4bcf-b372-145e69a88ba0">Vallavalitsusel on õigus põhjendatud otsusega vabastada isik teenuse eest tasumisest osaliselt või täielikult, arvestades teenust saava isiku sissetulekuid, seadusjärgsete ülalpidajate olemasolu ja nende sissetulekuid, teenuse kasutamise põhjust ning muid juhtumiga seotud asjaolusid.</tavatekst></sisuTekst></loige><loige id="para9lg4"><loigeNr id="824f2a48-e0fb-4607-9c19-b1cb780315be">4</loigeNr><kuvatavNr id="d3e22ac1-66df-4a63-b0a5-480ce6c9e416"><![CDATA[(4)]]></kuvatavNr><sisuTekst id="a96b9aa1-cd48-45c2-852a-d671cb4c5b33"><tavatekst id="60bc5318-98c4-44d7-88a8-614b7333f560">Teenuse tasust osaliselt või täielikult vabastamiseks tuleb vallavalitsusele lisaks avaldusele täiendavalt esitada taotleja ja seadusjärgsete ülalpidajate olemasolul seadusjärgsete ülalpidajate sissetulekuid ning väljaminekuid tõendavad dokumendid.</tavatekst></sisuTekst></loige><loige id="para9lg5"><loigeNr id="4ce4510f-8787-4319-8a40-0cee81131fad">5</loigeNr><kuvatavNr id="f71690fe-0c27-49ea-865f-ed507985daaa"><![CDATA[(5)]]></kuvatavNr><sisuTekst id="9656ae18-9821-4fb1-8648-1b498c2d0506"><tavatekst id="aedab482-0907-4d19-a54b-42437dcc0192">Teenuse tasu ei rakendata isikutel:</tavatekst></sisuTekst><alampunkt id="para9lg5p1"><alampunktNr id="b7448ffe-cd5f-4d24-96b9-71959e03cb5e">1</alampunktNr><kuvatavNr id="97153789-a53a-4ae4-9c88-e002b333ed7d"><![CDATA[1) ]]></kuvatavNr><sisuTekst id="32d9e6f5-e65a-405a-907d-3b06a967e6ec"><tavatekst id="9cbce031-dcf9-4fe5-8077-dfdfb7e9bd06">kelle taotlemisele eelnenud 4 kalendrikuu keskmine netosissetulek on üksi elavatel isikutel ja perekonna esimese liikme kohta alla riiklikult kehtestatud toimetulekupiiri 3-kordset määra ning igal järgneval pereliikmel alla riiklikult kehtestatud toimetulekupiiri 2-kordset määra;</tavatekst></sisuTekst></alampunkt><alampunkt id="para9lg5p2"><alampunktNr id="dbb2e717-1644-4202-9168-e717d7c21490">2</alampunktNr><kuvatavNr id="beef4597-d2b0-47e5-93f1-ac0eaf3c5c2b"><![CDATA[2) ]]></kuvatavNr><sisuTekst id="58cb56ef-e5e3-41ca-8d55-338c2d9c13f4"><tavatekst id="9ac60da6-9b9b-4545-84b6-c273e3acd930">kellel puuduvad seadusjärgsed ülalpidamiskohustusega isikud;</tavatekst></sisuTekst></alampunkt><alampunkt id="para9lg5p3"><alampunktNr id="60703498-4a75-4fb9-88a2-34ee08696741">3</alampunktNr><kuvatavNr id="cf5b8737-8f84-4513-b425-3fa8ceb3f644"><![CDATA[3) ]]></kuvatavNr><sisuTekst id="eec5dd86-bfcc-4f28-b6a5-b13929fe9548"><tavatekst id="1036a566-8f97-4917-b773-21183d58d406">kellele osutatakse teenust struktuuritoetuse raames ning meetme tingimustest lähtuvalt tuleb teenust osutada teenuse tasu rakendamata.</tavatekst></sisuTekst></alampunkt></loige></paragrahv><paragrahv id="para10"><paragrahvNr id="ed968b4e-8ad8-499a-b7c7-d9e80b475181">10</paragrahvNr><kuvatavNr id="446dce5e-4958-4e99-b432-95d1c9ac7528"><![CDATA[§ 10. ]]></kuvatavNr><paragrahvPealkiri id="a818679b-bf3d-49b8-9ef8-15f23a95e05f">Teenuse osutamine</paragrahvPealkiri><loige id="para10lg1"><loigeNr id="d28830c4-400c-4dd0-8b69-54933b62297b">1</loigeNr><kuvatavNr id="f1cce617-2ce6-4548-9a8d-58a074d4438b"><![CDATA[(1)]]></kuvatavNr><sisuTekst id="56ed4e1a-d08a-44c2-ac3c-75f7b71dcdaf"><tavatekst id="d06cd017-9e98-494f-94c8-0b71f838c2fb">Teenuse saajal on õigus valida abistaja isik.</tavatekst></sisuTekst></loige><loige id="para10lg2"><loigeNr id="a5824564-b577-4327-9fd7-fc617dfa1679">2</loigeNr><kuvatavNr id="f8229a6f-66aa-459f-b9f2-bc02d5f1684a"><![CDATA[(2)]]></kuvatavNr><sisuTekst id="4217f8b9-d87f-46a0-bbf0-0436cea5bd53"><tavatekst id="5d49c7bf-9d91-4a63-94ed-36dfddcd049a">Soovi esitamise korral abistab sotsiaalosakonna juhataja teenuse saajat abistaja leidmisel. Teenuse saajal on õigus enne abistaja kindlaksmääramist omavahelise sobivuse hindamiseks temaga kohtuda.</tavatekst></sisuTekst></loige><loige id="para10lg3"><loigeNr id="03929e89-b1fa-4809-b5e6-f027357b1687">3</loigeNr><kuvatavNr id="ce526b31-0b05-4c62-b66b-b2d6561748b0"><![CDATA[(3)]]></kuvatavNr><sisuTekst id="12e01152-f033-45a8-8392-345f12eab63d"><tavatekst id="1df84f10-da0d-4ba9-8cea-a04289eaf158">Kui teenusele määratud isik ei leia kahe nädala jooksul teenuse määramise otsuse jõustumisest endale sobivat abistajat iseseisvalt, määrab lähtuvalt teenuse osutamise vajalikkusest sotsiaalosakonna juhataja sobiva abistaja teenuse saajale.</tavatekst></sisuTekst></loige><loige id="para10lg4"><loigeNr id="b590a4e4-716b-434b-bb52-64148ed438c7">4</loigeNr><kuvatavNr id="d9b2c5ce-34ea-48b8-bc6c-4bfcf36b9779"><![CDATA[(4)]]></kuvatavNr><sisuTekst id="f441d2ec-4af5-4f81-b622-eaac032767a7"><tavatekst id="7f8914db-2f30-46c3-a7d9-a95b1635755f">Abistaja osutab teenusele määratud isikule teenust vastavalt tuvastatud teenusevajadusele, määratud teenuse mahule ja teenuse tööjuhistele.</tavatekst></sisuTekst></loige><loige id="para10lg5"><loigeNr id="19a31172-f736-4100-b9e8-a63ec38317e8">5</loigeNr><kuvatavNr id="e0e367ff-31ef-4190-a4cf-96d7fb9e6648"><![CDATA[(5)]]></kuvatavNr><sisuTekst id="ef5314ee-ddfd-4493-8f91-593edabdc826"><tavatekst id="9f041c89-bc25-4803-b6ed-2e256faff708">Kui isik ei asu nelja nädala jooksul teenust kasutama, loetakse teenusele määratud isik teenusest loobunuks.</tavatekst></sisuTekst></loige></paragrahv><paragrahv id="para11"><paragrahvNr id="7e44ecd9-230f-4666-aee3-10257e5a8488">11</paragrahvNr><kuvatavNr id="807e23ae-232f-41ef-9426-56caac5ef152"><![CDATA[§ 11. ]]></kuvatavNr><paragrahvPealkiri id="99bf8039-9d17-487a-9544-65b5b4f2a307">Teenuse vajaduse muutumine</paragrahvPealkiri><loige id="para11lg1"><loigeNr id="8f835c01-660c-4765-8917-5e31839fdc6f"/><kuvatavNr id="b5958010-bc4e-460d-a649-efd2d413d3ee"/><sisuTekst id="ae6e9b2b-13b4-4e5b-86ae-54abd124b52b"><tavatekst id="7284a8dd-00b5-4d42-8cf5-002e44f73c5b">Teenuse saaja on kohustatud viivitamatult teavitama osakonda kõrvalabi vajaduse muutumisest tervisliku seisundi, elukeskkonna muutumise või muu põhjuse tõttu ja esitama osakonnale uue taotluse. Taotluse läbivaatamisele ja teenuse määramisele kohaldatakse käesoleva määruse paragrahvides 6 ja 7 sätestatut.</tavatekst></sisuTekst></loige></paragrahv><paragrahv id="para12"><paragrahvNr id="39b4248a-004e-43bc-ab27-904a88bb8d1c">12</paragrahvNr><kuvatavNr id="4156b804-b407-4748-b7b1-27b66ae4aa63"><![CDATA[§ 12. ]]></kuvatavNr><paragrahvPealkiri id="3758cef6-965c-40c2-b0dd-e85e1948d90a">Lepingu muutmine ja lõpetamine</paragrahvPealkiri><loige id="para12lg1"><loigeNr id="a46832e8-fad4-432b-8801-92f7dee7cfe9">1</loigeNr><kuvatavNr id="ee48cf7a-1dc9-4071-99d1-f18a058011d0"><![CDATA[(1)]]></kuvatavNr><sisuTekst id="151e3584-de89-4434-8d10-cff2319d50d3"><tavatekst id="9ae404cf-40ce-4aff-8540-55544f49bd34">Teenuse jätkamiseks esitab sotsiaaltööspetsialist vallavalitsusele ettepaneku isikliku abistaja teenuse lepingu pikendamiseks. Lepingu pikendamine vormistatakse kehtiva lepingu lisana.</tavatekst></sisuTekst></loige><loige id="para12lg2"><loigeNr id="31ce7852-cd17-48a9-a4fc-994a2bd728a9">2</loigeNr><kuvatavNr id="b2e28cb2-9b9d-4826-a65d-98ec564a8e5b"><![CDATA[(2)]]></kuvatavNr><sisuTekst id="cbf6120c-8bc9-4a06-8a1a-dcce2bd8d620"><tavatekst id="3d1d1bb9-2274-43a0-8d54-402754323b52">Lepingut võib muuta ja lõpetada lepingupoolte kokkuleppel igal ajal, kui selleks tekib põhjendatud vajadus, teavitades sellest teisi lepingu osapooli vähemalt 5 tööpäeva ette. Täiendused ja muudatused fikseeritakse kirjalikult lepingu lisana ja kinnitatakse lepingupoolte allkirjadega.</tavatekst></sisuTekst></loige><loige id="para12lg3"><loigeNr id="d84386d2-9405-463b-b070-1ccd0d2be32b">3</loigeNr><kuvatavNr id="7bcdbcd1-3b4c-4596-baae-87dc2d0fb5c3"><![CDATA[(3)]]></kuvatavNr><sisuTekst id="a034440d-b010-4105-931b-da0087749068"><tavatekst id="f28fe407-4169-4653-acc6-bc6d05877b44">Leping vaadatakse üle lähtuvalt isiku vajaduste muutumisest.</tavatekst></sisuTekst></loige><loige id="para12lg4"><loigeNr id="ac44291f-94a4-4603-8f41-f685a1938b70">4</loigeNr><kuvatavNr id="f8bb71e0-5991-4619-8601-2fecdfb4bea5"><![CDATA[(4)]]></kuvatavNr><sisuTekst id="d65d25fc-5a7c-461c-a43e-8be6f9cbfe2d"><tavatekst id="a62f8e43-5766-487a-bd45-728c2c29aae1">Leping lõpeb:</tavatekst></sisuTekst><alampunkt id="para12lg4p1"><alampunktNr id="98a0d625-e89e-4284-9a55-881668cd8e88">1</alampunktNr><kuvatavNr id="792f2995-bcb5-4635-bfa9-9ca6dba70fe6"><![CDATA[1) ]]></kuvatavNr><sisuTekst id="777bc954-9711-4c28-a9d9-3b4447b1c15a"><tavatekst id="0c1256b0-4d8a-4a59-84a3-603214e98ceb">tähtaja möödumisel;</tavatekst></sisuTekst></alampunkt><alampunkt id="para12lg4p2"><alampunktNr id="3a2ff9fa-0b3f-4f3b-983d-56edc01de3e9">2</alampunktNr><kuvatavNr id="67812259-3714-4949-9722-c562944d851e"><![CDATA[2) ]]></kuvatavNr><sisuTekst id="11e50698-171c-4ab0-b15d-72b3259671f2"><tavatekst id="f13df1af-a298-4200-b258-cf1b19aa50f8">teenust vajava isiku avalduse alusel;</tavatekst></sisuTekst></alampunkt><alampunkt id="para12lg4p3"><alampunktNr id="494ae9e7-52d7-446e-b350-37c36b576e97">3</alampunktNr><kuvatavNr id="868ef967-f755-4df3-9d73-8ee5faef5220"><![CDATA[3) ]]></kuvatavNr><sisuTekst id="8cf54ee4-8e57-4531-8409-0255ee2271bb"><tavatekst id="ebd16e10-7a05-4c63-94b1-fbc3e635586b">kui on ära langenud teenuse osutamise vajadus;</tavatekst></sisuTekst></alampunkt><alampunkt id="para12lg4p4"><alampunktNr id="31fcd6c7-7393-48c2-96c0-647d85e98ce4">4</alampunktNr><kuvatavNr id="d1df328a-6957-47d2-9f74-198b42d0a421"><![CDATA[4) ]]></kuvatavNr><sisuTekst id="963cdfca-787e-4058-9c6f-2874cf269958"><tavatekst id="f89a5276-bffb-4b8d-b08a-828dec6ad62c">kui teenuse saaja asub elama teise kohaliku omavalitsuse haldusterritooriumile;</tavatekst></sisuTekst></alampunkt><alampunkt id="para12lg4p5"><alampunktNr id="a6c0e42e-6ce2-4a87-81e8-5d479aa7264b">5</alampunktNr><kuvatavNr id="911a0934-c3c5-4cf2-8c4b-3102b9e56dbd"><![CDATA[5) ]]></kuvatavNr><sisuTekst id="0b73ffcc-54f2-4165-b294-45aa147844a9"><tavatekst id="361111e6-fa52-4a3a-8ff4-eefa7f4ef4fd">kui teenuse saaja on suunatud üldhooldus- või erihoolekandeteenusele;</tavatekst></sisuTekst></alampunkt><alampunkt id="para12lg4p6"><alampunktNr id="c2a40732-67e2-497c-b000-69a5c7d4c752">6</alampunktNr><kuvatavNr id="465bd2db-5e67-4f56-acc0-8383a610d361"><![CDATA[6) ]]></kuvatavNr><sisuTekst id="30236ad8-c572-4ff1-89d9-7a4ad8511e99"><tavatekst id="545e8660-f620-4fb3-aa96-8929aa17a5c6">kui teenuse saaja käitumine teeb võimatuks teenuse osutamise (agressiivsus, ebaviisakas käitumine, alkoholi või narkootiliste ainete kuritarvitamine, pidev koostööst keeldumine vms);</tavatekst></sisuTekst></alampunkt></loige><loige id="para12lg5"><loigeNr id="6c27a247-051f-4abd-af99-d91a218efeb3">5</loigeNr><kuvatavNr id="716f87e4-e29f-486d-bdf2-058f6756cfd4"><![CDATA[(5)]]></kuvatavNr><sisuTekst id="996462f8-5eb2-47e6-881a-b87795c4e914"><tavatekst id="9d1991e4-5847-446f-aac8-9e4873bdd681">Leping lõpetatakse vallavalitsuse korraldusega:</tavatekst></sisuTekst><alampunkt id="para12lg5p1"><alampunktNr id="5ec28c67-a587-4c61-8cda-0591243ce0a6">1</alampunktNr><kuvatavNr id="216105b0-7bcd-486d-981a-11d0cacaf7a8"><![CDATA[1) ]]></kuvatavNr><sisuTekst id="d27463f2-3fd9-4a36-9e77-82769c4ae97c"><tavatekst id="025480db-6e21-4b1f-8c4b-5a92b749ecdc">käesoleva määruse paragrahvis 11 sätestatud kohustuse täitmata jätmisel;</tavatekst></sisuTekst></alampunkt><alampunkt id="para12lg5p2"><alampunktNr id="24830be9-6d85-4ce4-b1b1-223c605b895f">2</alampunktNr><kuvatavNr id="7da2c151-5bdb-4a29-b9b7-7b806b6088a9"><![CDATA[2) ]]></kuvatavNr><sisuTekst id="3c3a4a89-5499-4d99-8f8e-dd3e1b54a3f8"><tavatekst id="79077404-0e62-4f6a-b65e-a81842c01242">kui teenuse saaja esitab valeandmeid;</tavatekst></sisuTekst></alampunkt><alampunkt id="para12lg5p3"><alampunktNr id="aa0f79bb-eb1f-45fd-ba31-964722482729">3</alampunktNr><kuvatavNr id="b1098189-2760-4d86-9c27-0932e8e93afc"><![CDATA[3) ]]></kuvatavNr><sisuTekst id="821b3f5e-1639-4f39-bdfb-ecf082becd46"><tavatekst id="0d1ce3d2-ffa3-4249-b577-13c9fd464c45">kui teenuse saaja või abistaja ei täida lepinguga võetud kohustusi.</tavatekst></sisuTekst></alampunkt></loige></paragrahv><paragrahv id="para13"><paragrahvNr id="f07de407-00ce-47bc-8bdd-71b358f23461">13</paragrahvNr><kuvatavNr id="64a94219-bb92-4ee8-8042-8be0a12fd1a5"><![CDATA[§ 13. ]]></kuvatavNr><paragrahvPealkiri id="2f2d5507-c33c-499b-9a2e-bc2185fd7c18">Järelevalve ja vastutus</paragrahvPealkiri><loige id="para13lg1"><loigeNr id="758d272a-5a5f-4739-8da4-3fb42ce56d53">1</loigeNr><kuvatavNr id="2e167615-0eb1-427f-804a-6ea66c28218c"><![CDATA[(1)]]></kuvatavNr><sisuTekst id="401de0ac-906f-444a-a5a8-d37c928f9c26"><tavatekst id="0a9fe399-3d8f-45f4-899e-c13649ae9408">Teenuse korraldamise eest vastutab sotsiaalosakonna juhataja.</tavatekst></sisuTekst></loige><loige id="para13lg2"><loigeNr id="933a5dae-d972-4e46-98b5-df066b88cfae">2</loigeNr><kuvatavNr id="b12199c9-3822-4713-beb4-a992ba3149fe"><![CDATA[(2)]]></kuvatavNr><sisuTekst id="ffefd3b7-ec9f-48ed-af55-e5259bc17494"><tavatekst id="206a109d-7d00-4952-b99e-5ab8dbfc8881">Järelevalvet teenuste nõuetekohase osutamise üle teostab sotsiaaltöö peaspetsialist.</tavatekst></sisuTekst></loige></paragrahv><paragrahv id="para14"><paragrahvNr id="2c1ca036-3dc2-4042-8a95-6dc8c581a6df">14</paragrahvNr><kuvatavNr id="8e8e8699-bffd-4643-9660-03a19ed4f02a"><![CDATA[§ 14. ]]></kuvatavNr><paragrahvPealkiri id="21742b33-ac00-4f39-aa0e-2c47b151eba5">Rakendussätted</paragrahvPealkiri><loige id="para14lg1"><loigeNr id="66accf8e-563f-489f-9c19-e11620756868">1</loigeNr><kuvatavNr id="e1292b23-e2c6-49bb-8160-867fe6928a1c"><![CDATA[(1)]]></kuvatavNr><sisuTekst id="5b2f7dd2-a0ea-4f4c-985d-161657294979"><tavatekst id="6920054a-cffc-4b9a-962f-2b56b6400d8e">Teenuse osutamisel struktuuritoetuse raames lähtutakse lisaks käesolevale määrusele ka rakendatava struktuuritoetuse meetme määrusest.</tavatekst></sisuTekst></loige><loige id="para14lg2"><loigeNr id="5adf2843-6985-42ed-baf2-e4b9b8b1d2f3">2</loigeNr><kuvatavNr id="91c2ab34-3cf5-4fdf-9f1f-d244920f29f7"><![CDATA[(2)]]></kuvatavNr><sisuTekst id="964845aa-855d-4d83-bf68-5c6e2581cfb3"><tavatekst id="dba806fc-71e5-46b5-9da5-463ea655a2d1">Tunnistada kehtetuks Mäksa Vallavolikogu 25.01.2016 määrus nr 3 „Isikliku abistaja teenuse osutamise kord“.</tavatekst></sisuTekst></loige><loige id="para14lg3"><loigeNr id="4a34d101-4b2b-4b1b-a5d1-d48f00022506">3</loigeNr><kuvatavNr id="adc0e757-9626-4b1e-b0a3-eebcd8aabc70"><![CDATA[(3)]]></kuvatavNr><sisuTekst id="aa3ece5f-1394-48e7-9f07-f35efeb20706"><tavatekst id="3b929383-26d5-4e49-811c-3ff73b82ae62">Tunnistada kehtetuks Mäksa Vallavolikogu 25.01.2016 määrus nr 4 „Sotsiaaltoetuste määrade kehtestamine“ § 1 lg 3.</tavatekst></sisuTekst></loige><loige id="para14lg4"><loigeNr id="6f028f36-8e3f-4627-bec6-fa383186305f">4</loigeNr><kuvatavNr id="d9519e13-b9e2-43d1-ae47-eaf3c01c8ade"><![CDATA[(4)]]></kuvatavNr><sisuTekst id="261c8d66-a8ae-4fe7-848f-27bc53a3c1ec"><tavatekst id="e715a740-2fbc-40f2-ab93-6103ecef01c4">Määrus jõustub kolmandal päeval pärast Riigi Teatajas avaldamist.</tavatekst></sisuTekst></loige></paragrahv></sisu>
