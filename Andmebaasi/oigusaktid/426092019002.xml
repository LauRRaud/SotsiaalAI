   <pealkiri id="d947c3b1-d2ee-4765-a99d-b80643565b0c">Sotsiaaltransporditeenuse osutamise kord</pealkiri>
  </nimi>
 </aktinimi>
 <sisu id="a64c1ce4-5a16-4253-9154-2774ecda17ca"><preambul id="4b592439-6d16-4ad7-b4a4-c8bc388409ca"><tavatekst id="b3642770-afd8-4754-8983-6b9563a24198">Määrus kehtestatakse kohaliku omavalitsuse korralduse seaduse § 22 lõike 1 punkti 5, sotsiaalhoolekande seaduse § 14 lõike 1 ja § 38 lõike 1 alusel.</tavatekst></preambul><paragrahv id="para1"><paragrahvNr id="fd61d1d0-8c72-46e2-9e3f-b618fbe327d1">1</paragrahvNr><kuvatavNr id="dadf79b4-23eb-4462-91cb-785812e70a48"><![CDATA[§ 1. ]]></kuvatavNr><paragrahvPealkiri id="4a25960d-5078-4278-8c9f-b6e4ad07e765">Üldsätted</paragrahvPealkiri><loige id="para1lg1"><loigeNr id="e4d9aa04-bfe4-4c1b-bb73-257f6d6b5f24">1</loigeNr><kuvatavNr id="5e4d2c31-586c-4eb0-8436-886f8ca1fef3"><![CDATA[(1)]]></kuvatavNr><sisuTekst id="0faa5f22-ab93-4199-8df0-9f21f2cf8fe0"><tavatekst id="d0239324-4f77-445a-83f1-769880381907"> Määrusega kehtestatakse sotsiaaltransporditeenuse (edaspidi <i>teenus</i>) osutamise tingimused ja kord Põlva vallas.</tavatekst></sisuTekst></loige><loige id="para1lg2"><loigeNr id="87c2fb91-0920-4d44-9481-36500599e684">2</loigeNr><kuvatavNr id="d9e411de-5c9e-4805-b6c6-398cb6169d4a"><![CDATA[(2)]]></kuvatavNr><sisuTekst id="e8c38108-45e2-46b8-9055-34d70621ae89"><tavatekst id="e3bf0a21-babf-4d28-a219-f4f528287171"> Määruses ettenähtud haldusmenetlusele kohaldatakse haldusmenetluse seadust, arvestades sotsiaalseadustiku üldosa seaduses sätestatud erisusi.</tavatekst></sisuTekst></loige></paragrahv><paragrahv id="para2"><paragrahvNr id="e942a89c-4b01-4198-a2d4-ba7651531c6b">2</paragrahvNr><kuvatavNr id="e2d20a69-6500-440e-b5c1-d0ced0a568fc"><![CDATA[§ 2. ]]></kuvatavNr><paragrahvPealkiri id="fb333eae-8aa8-4884-9c5e-76961ba51b05">Teenuse eesmärk</paragrahvPealkiri><loige id="para2lg1"><loigeNr id="b0371bb1-6fe7-45a9-b025-0f2f67c32061">1</loigeNr><kuvatavNr id="c9046a70-e185-402d-83ad-c67434b68682"><![CDATA[(1)]]></kuvatavNr><sisuTekst id="0887195b-a1e1-403a-b67b-8838dd2aaff9"><tavatekst id="4b418907-6a38-48fe-9338-1647e1019fe2"> Teenuse eesmärk on võimaldada erivajadusega isikul kasutada tema vajadustele vastavat transpordivahendit tööle või õppeasutusse sõitmiseks või muude avalike teenuste kasutamiseks.</tavatekst></sisuTekst></loige><loige id="para2lg2"><loigeNr id="3f85a230-5b26-4b65-ac60-e3646f915dde">2</loigeNr><kuvatavNr id="0015ef72-5719-4261-819f-2e773cc127f9"><![CDATA[(2)]]></kuvatavNr><sisuTekst id="cec1f36a-c8bd-4d2d-93aa-1209ad996101"><tavatekst id="2388746f-cbc7-4c66-8d0a-834d7fc9307d"> Erivajadusega on isik, kellel on füüsiline, psüühiline või sotsiaalne kõrvalekalle ning kelle iseseisev toimetulekuvõime ei ole piisav, sh puude riskiga isikud ja Sotsiaalkindlustusameti poolt määratud puudega isikud.</tavatekst></sisuTekst></loige></paragrahv><paragrahv id="para3"><paragrahvNr id="75ba4fd9-7228-466c-9018-d53cde1771b8">3</paragrahvNr><kuvatavNr id="82935afd-db57-48a7-a892-1451fd5aacd1"><![CDATA[§ 3. ]]></kuvatavNr><paragrahvPealkiri id="54196d8a-7605-4ab1-9f35-91103d1e539f">Teenuse osutaja</paragrahvPealkiri><loige id="para3lg1"><loigeNr id="0f74330f-30a8-48eb-b947-17ca38c204d6">1</loigeNr><kuvatavNr id="2c9820f5-d224-4013-8885-cd30eab0d4be"><![CDATA[(1)]]></kuvatavNr><sisuTekst id="25e6a1ef-4cc2-4688-a1d5-ba4cb78ad7ec"><tavatekst id="1e0a7008-6cec-4f02-8d86-59b145ac8d63"> Teenust osutab riigihanke raames valitud vedaja või Põlva Vallavalitsuse (edaspidi <i>vallavalitsus</i>) hallatav asutus.</tavatekst></sisuTekst></loige><loige id="para3lg2"><loigeNr id="a2f908c8-15fc-42ca-b203-2019c042ad74">2</loigeNr><kuvatavNr id="1b256dd3-d99e-4580-9f39-b2c7b3df551b"><![CDATA[(2)]]></kuvatavNr><sisuTekst id="c8228cbb-2f98-458a-94d1-6b561db1b42b"><tavatekst id="1a72f211-8099-4bb9-8684-6b6ae73a2e70"> Teenuse osutaja tagab teenuse osutamise erivajadustega inimestele transporditeenuse osutamiseks sobiva ja tehnilistele nõuetele vastava transpordivahendiga.</tavatekst></sisuTekst></loige><loige id="para3lg3"><loigeNr id="fb713a72-2622-4d58-99ce-1f6848259cfa">3</loigeNr><kuvatavNr id="ffb20cd4-6651-43a0-9814-ab2c201ef242"><![CDATA[(3)]]></kuvatavNr><sisuTekst id="a46db2d2-91de-4d3f-9848-6814e4b3e9c0"><tavatekst id="884a488d-eaad-40c6-9bca-71543cee762f"> Teenuse osutaja tagab vajadusel teenuse kasutaja abistamise sõidukist väljumisel ja sisenemisel ning kinnitama teenuse kasutaja turvavöö ja fikseerima liikumise abivahendi.</tavatekst></sisuTekst></loige><loige id="para3lg4"><loigeNr id="c1dee456-98fd-4497-9eca-3a828104325f">4</loigeNr><kuvatavNr id="691312fe-9158-4d86-8b3e-d3f1e123f91e"><![CDATA[(4)]]></kuvatavNr><sisuTekst id="b0609898-cfe3-41bb-840e-d0b8c2c96ee3"><tavatekst id="b7176876-650d-404d-8970-ad3d8dc1805a"> Vallavalitsus võib kehtestada täiendavaid nõudeid teenuse osutamiseks.</tavatekst></sisuTekst></loige></paragrahv><paragrahv id="para4"><paragrahvNr id="41de3ad5-ed02-433f-a0b9-ff8038888014">4</paragrahvNr><kuvatavNr id="4c161f2b-1416-4f0f-a9d9-913bb6790cab"><![CDATA[§ 4. ]]></kuvatavNr><paragrahvPealkiri id="b494b0bc-f7a4-4179-a9e0-06d9be77bef7">Teenuse saaja</paragrahvPealkiri><loige id="para4lg1"><loigeNr id="afe462bd-5d07-4ef5-bb9e-0d8d30a8a4a6">1</loigeNr><kuvatavNr id="17cd4610-2170-431d-a7ea-b91bc01cebcb"><![CDATA[(1)]]></kuvatavNr><sisuTekst id="148ea4fd-6275-4d18-84ff-4dc40628f1d8"><tavatekst id="b645a6db-e1a3-4f5e-903e-b3246ab143b6"> Teenust osutatakse erivajadusega isikule, kelle elukoht Eesti rahvastikuregistri andmetel on Põlva vald ja kes tegelikult elab Põlva vallas ning kellel on takistatud isikliku või ühissõiduki kasutamine.</tavatekst></sisuTekst></loige><loige id="para4lg2"><loigeNr id="58bc7f49-7774-4ca7-ae07-fdaa1a32a38f">2</loigeNr><kuvatavNr id="13ccb4d6-01d5-4a50-9d18-76772a301151"><![CDATA[(2)]]></kuvatavNr><sisuTekst id="34b674bd-2a5e-4620-ac51-37a0324981b9"><tavatekst id="461a9ab3-ac12-43c8-b4f4-606671717841"> Põhjendatud juhtudel võib teenust osutada käesoleva paragrahvi lõikes 1 määratlemata isikule.</tavatekst></sisuTekst></loige></paragrahv><paragrahv id="para5"><paragrahvNr id="c0ea0a42-74bf-4ad6-9f43-49c586140c50">5</paragrahvNr><kuvatavNr id="1062752f-f387-459b-962d-f1ee6978757e"><![CDATA[§ 5. ]]></kuvatavNr><paragrahvPealkiri id="d44dda65-7be5-4a94-8c26-f2c634143773">Teenuse osutamise aeg ja koht</paragrahvPealkiri><loige id="para5lg1"><loigeNr id="05fdd62a-84da-4418-a898-a3d83fde8dd7">1</loigeNr><kuvatavNr id="12f45ada-49b4-4174-9c68-4602c521e78c"><![CDATA[(1)]]></kuvatavNr><sisuTekst id="baad2f8b-1164-4c88-9a7a-47974098c0bf"><tavatekst id="1b50f5ef-6d28-41e5-a99e-eca4cdc383ee"> Teenust osutatakse Eesti Vabariigi territooriumil.</tavatekst></sisuTekst></loige><loige id="para5lg2"><loigeNr id="e8e92a93-a9e0-42d4-9e48-683b9e2b5d6d">2</loigeNr><kuvatavNr id="fba9886e-d6ed-4da9-bbd5-45ec5532f71c"><![CDATA[(2)]]></kuvatavNr><sisuTekst id="43a90996-c24b-47a2-8723-472d37b74438"><tavatekst id="cfa41e05-bf11-4fd2-bfd4-ccd0f4e36faa"> Teenust osutatakse üldjuhul tööpäevadel, põhjendatud juhtudel nädalavahetusel ja riigipühadel.</tavatekst></sisuTekst></loige></paragrahv><paragrahv id="para6"><paragrahvNr id="2d189788-38d4-49e0-97c3-68b28ac345b2">6</paragrahvNr><kuvatavNr id="b695b215-0bdb-4869-927f-322ac14a6eeb"><![CDATA[§ 6. ]]></kuvatavNr><paragrahvPealkiri id="1b78d95a-d894-4c1b-9b6f-39e75aa58ba2">Teenuse taotlemine</paragrahvPealkiri><loige id="para6lg1"><loigeNr id="01ee7371-2d6d-4fe8-ab58-b6d4d7730b6a">1</loigeNr><kuvatavNr id="fdfd8471-367f-4a14-bc34-3cd6ba710c61"><![CDATA[(1)]]></kuvatavNr><sisuTekst id="2c60e754-a554-48ea-ada2-20a6afacfe31"><tavatekst id="b44a06c2-8eb0-4268-b9bf-51eae17520c5"> Teenuse määramiseks pöördub teenuse taotleja või tema seaduslik esindaja vähemalt kuus tööpäeva enne teenuse osutamise vajadust vallavalitsuse ametniku poole, kes hindab teenuse osutamise vajadust.</tavatekst></sisuTekst></loige><loige id="para6lg2"><loigeNr id="08069923-a8c7-4329-a472-6d4998e49718">2</loigeNr><kuvatavNr id="96e01fad-5ae9-4a51-93a8-892e0a3ec023"><![CDATA[(2)]]></kuvatavNr><sisuTekst id="677b67ff-3b2a-476c-9599-f3f3e7a5dbc8"><tavatekst id="31a796a8-7f9b-497f-9d95-fe872d01a171"> Taotluses märgitakse:</tavatekst></sisuTekst><alampunkt id="para6lg2p1"><alampunktNr id="213b8738-19b4-4914-8b0e-3a07bb1af678">1</alampunktNr><kuvatavNr id="aa5461c5-37cc-47cd-a6f3-c6ef5a12b118"><![CDATA[1) ]]></kuvatavNr><sisuTekst id="ebcf0ad2-a1b8-4d38-b6c8-013dcc46dda1"><tavatekst id="f4d39987-e3cf-49a4-af26-c38c65ef974c">teenuse taotleja ees- ja perekonnanimi;</tavatekst></sisuTekst></alampunkt><alampunkt id="para6lg2p2"><alampunktNr id="c88afc23-7e8b-44c6-a17b-1e2f66a045b6">2</alampunktNr><kuvatavNr id="d9f38035-2b91-4c10-9d48-5a95a4e447f0"><![CDATA[2) ]]></kuvatavNr><sisuTekst id="534370c9-c6df-4ada-98b1-120296403777"><tavatekst id="d8a36afe-3a22-478d-8a98-eabdac75a74b">teenuse taotleja isikukood;</tavatekst></sisuTekst></alampunkt><alampunkt id="para6lg2p3"><alampunktNr id="a0660f0d-04fb-4f41-b6d3-0f0c0d49aa39">3</alampunktNr><kuvatavNr id="adc60420-9448-492d-9018-692fbfec340f"><![CDATA[3) ]]></kuvatavNr><sisuTekst id="9a11f020-2140-42aa-a450-e5900d00b1dd"><tavatekst id="0f84fe35-097c-4a30-9c64-7baa278193d7">teenuse taotleja ja tema esindaja(te) kontaktandmed (aadress, telefon, elektronposti aadress);</tavatekst></sisuTekst></alampunkt><alampunkt id="para6lg2p4"><alampunktNr id="c00920a7-8483-418a-bfee-c3732a2d5fb0">4</alampunktNr><kuvatavNr id="ae29ec4d-af18-4dc5-bcba-a6f4dcb8b2b5"><![CDATA[4) ]]></kuvatavNr><sisuTekst id="d07ab798-5a23-4d7b-bd2d-382cd8aca00b"><tavatekst id="7a081842-a052-407c-ad99-2b7b7047d87d">andmed oma terviseseisundi, puude raskusastme ja selle kehtivuse kohta ning info abivahendi või muu kõrvalise abi (saatja) kasutamise kohta;</tavatekst></sisuTekst></alampunkt><alampunkt id="para6lg2p5"><alampunktNr id="ea6e6760-8397-435e-b5e0-e93b7b2380bb">5</alampunktNr><kuvatavNr id="fcfe9353-bee4-4142-a8a2-2759e871512c"><![CDATA[5) ]]></kuvatavNr><sisuTekst id="033bbad0-8289-4841-a631-e7a3acdf3ce8"><tavatekst id="390d7da6-6327-4e4e-991f-3095230cda06">teenuse vajaduse põhjendus ning asjaolud, miks teenuse taotlejal ei ole võimalik kasutada ühissõidukit või isiklikku sõidukit;</tavatekst></sisuTekst></alampunkt><alampunkt id="para6lg2p6"><alampunktNr id="b3a0d7f0-2e1e-485d-9e33-318f40528e25">6</alampunktNr><kuvatavNr id="95d763d2-0757-41f1-b296-7421d0f48b48"><![CDATA[6) ]]></kuvatavNr><sisuTekst id="ac51117e-ff3d-4ff0-b2cd-5838825f714f"><tavatekst id="621234f9-46d4-4c7a-8592-8429c49ffa2c">teenuse osutamise eesmärk, sõidu lähte- ja sihtkoht ning aeg;</tavatekst></sisuTekst></alampunkt><alampunkt id="para6lg2p7"><alampunktNr id="76a8b2c3-7026-418e-8714-9d91df43b85b">7</alampunktNr><kuvatavNr id="09f2d52a-00b5-414f-9992-4c3c4b15b3a4"><![CDATA[7) ]]></kuvatavNr><sisuTekst id="89276066-55ca-445b-89d9-65b6b30020ff"><tavatekst id="5a1e75af-bbed-496e-980e-577e0664b064">korduvsõitude puhul sõitude sagedus.</tavatekst></sisuTekst></alampunkt></loige></paragrahv><paragrahv id="para7"><paragrahvNr id="4ffe9178-a84a-4621-8b3d-7f7392af4dd4">7</paragrahvNr><kuvatavNr id="4303c02e-45b0-4cdb-b405-0b67ff5fb9cb"><![CDATA[§ 7. ]]></kuvatavNr><paragrahvPealkiri id="7be1bf45-aba3-4c50-a83c-86bb8f4692ad">Taotluse menetlemine, teenuse määramine või sellest keeldumine</paragrahvPealkiri><loige id="para7lg1"><loigeNr id="5874d152-a8e6-41d6-be4a-60ac26e16a13">1</loigeNr><kuvatavNr id="818c9e97-8d57-4aee-863d-17aaa396782a"><![CDATA[(1)]]></kuvatavNr><sisuTekst id="092bada4-4d6c-4f7c-b771-9098ca6539fb"><tavatekst id="cd88c7c5-cc20-479c-aa09-5edb8ebdb5dd"> Otsuse teenuse määramise, teenuse osutamise perioodi ja muude oluliste asjaolude kohta teeb ametnik kolme tööpäeva jooksul ning edastab selle teenuse osutajale.</tavatekst></sisuTekst></loige><loige id="para7lg2"><loigeNr id="03fe3072-1add-4913-b56b-517657b290b2">2</loigeNr><kuvatavNr id="c56eb932-57c6-4901-8c35-25c2ec59b058"><![CDATA[(2)]]></kuvatavNr><sisuTekst id="5a30ed4f-663e-4264-9083-f473acb4fb3a"><tavatekst id="ed900e31-5b62-44b9-ab0e-976825040b5c"> Otsuse teenuse määramisest keeldumise kohta teeb sotsiaalosakonna juhataja või teda asendav ametnik viie tööpäeva jooksul.</tavatekst></sisuTekst></loige><loige id="para7lg3"><loigeNr id="9d894658-4a40-4444-b669-aa9b1c0baac9">3</loigeNr><kuvatavNr id="d0fca874-d76d-4451-83ca-f7246c87d375"><![CDATA[(3)]]></kuvatavNr><sisuTekst id="0fd673d1-d1f9-4c97-818e-0de9fc9b2787"><tavatekst id="68115dc8-2b4b-4366-9e42-8fc94cd85fbc"> Teenuse määramisest võib keelduda juhul, kui esineb vähemalt üks järgmistest asjaoludest:</tavatekst></sisuTekst><alampunkt id="para7lg3p1"><alampunktNr id="4ad88aef-2c52-4d59-9a1d-187769bd5eb4">1</alampunktNr><kuvatavNr id="3484548a-4ded-433c-8040-c6dd29168258"><![CDATA[1) ]]></kuvatavNr><sisuTekst id="0b7509a8-aec5-4936-8a8c-b9064102b7d5"><tavatekst id="3f0b61ef-27ac-4392-a595-a26480b22293">teenuse taotleja ei vasta paragrahvis 4 lõikes 1 sätestatud tingimustele;</tavatekst></sisuTekst></alampunkt><alampunkt id="para7lg3p2"><alampunktNr id="be9636f2-8c3e-4ca0-9389-118922a4a5c0">2</alampunktNr><kuvatavNr id="e96248dc-094d-47e4-8744-a9a7f3be5b36"><![CDATA[2) ]]></kuvatavNr><sisuTekst id="d84dffb8-e5fd-401f-9c9f-af3fd741ef3d"><tavatekst id="48c3ffa0-9e2e-457b-9b62-410b67838c39">taotleja ei võimalda teenuse vajadust kontrollida;</tavatekst></sisuTekst></alampunkt><alampunkt id="para7lg3p3"><alampunktNr id="2224c184-ea48-461b-91db-3cabf29ff03c">3</alampunktNr><kuvatavNr id="f95b6405-b58e-4233-ad65-847b27f6afa9"><![CDATA[3) ]]></kuvatavNr><sisuTekst id="edf38721-8afa-47a7-b42f-66a3d89797d0"><tavatekst id="74231d6b-2c92-45eb-8501-ff276c0fdd18">teenuse taotleja ei ole teavitanud vallavalitsust viivitamata teenuse saamise õigust ja teenuse määramist mõjutavatest asjaoludest ja asjaolude muutumisest;</tavatekst></sisuTekst></alampunkt><alampunkt id="para7lg3p4"><alampunktNr id="892b4f9d-7ecf-481e-bd99-e09870c4cf48">4</alampunktNr><kuvatavNr id="a0cf3f6d-1780-47c9-afd4-cdfefc6aa93f"><![CDATA[4) ]]></kuvatavNr><sisuTekst id="0852590c-1ad7-4eb6-b51e-7599b57964c5"><tavatekst id="05ca57b1-93fb-4b35-bcea-e1582ce84b3f">teenuse vajadust on võimalik või otstarbekas katta muude teenuste või muu abiga;</tavatekst></sisuTekst></alampunkt><alampunkt id="para7lg3p5"><alampunktNr id="187bb6e1-4cd9-430a-ac6e-8220114120bf">5</alampunktNr><kuvatavNr id="88ea4efa-8dce-4b52-99c8-c80a74ffdc14"><![CDATA[5) ]]></kuvatavNr><sisuTekst id="8d2ce22b-15d4-4b6f-86a3-1b364e51bc29"><tavatekst id="4989707b-e1c7-4147-bc00-fb3af34cb6d7">teenuse vajaduse katavad riiklikud või valla eelarvest makstavad toetused ja teenused.</tavatekst></sisuTekst></alampunkt></loige></paragrahv><paragrahv id="para8"><paragrahvNr id="bad68659-4cd3-4939-b19f-1cbe859a145e">8</paragrahvNr><kuvatavNr id="206a19fc-8241-4b17-8556-193b52f4a660"><![CDATA[§ 8. ]]></kuvatavNr><paragrahvPealkiri id="8ab57833-ff27-4d76-91e1-aece361ad990">Teenuse eest tasumine</paragrahvPealkiri><loige id="para8lg1"><loigeNr id="7cd18bd4-82b0-4f22-a3e2-9260ac12343a">1</loigeNr><kuvatavNr id="84d2806d-7b5d-4457-b31d-a7cb9bdc2454"><![CDATA[(1)]]></kuvatavNr><sisuTekst id="aed8610a-fc05-49f5-8259-28b7fe1b8e0c"><tavatekst id="a7434920-a953-4978-a196-5ead3c85889c"> Teenuse omaosaluse maksumuse kehtestab vallavalitsus.</tavatekst></sisuTekst></loige><loige id="para8lg2"><loigeNr id="d9e2ea28-8350-49ad-b885-9a67e68c05d8">2</loigeNr><kuvatavNr id="d255bf5e-1806-4b2f-b652-7999cf9933cd"><![CDATA[(2)]]></kuvatavNr><sisuTekst id="cf87bf54-5089-4fc3-8517-6b465ef8dc77"><tavatekst id="04671bb2-c80d-4978-a366-381fa54c5209"> Omaosaluse maksumuse tasub teenuse saaja teenuse osutajale. Saatjal on õigus sõita tasuta.</tavatekst></sisuTekst></loige><loige id="para8lg3"><loigeNr id="181a9305-fd12-41ea-ae4f-093e7139ba58">3</loigeNr><kuvatavNr id="c4155363-429c-4eb4-81d0-9611d64e979a"><![CDATA[(3)]]></kuvatavNr><sisuTekst id="fe2868ff-22e9-4cd7-8cc1-70e4b0b65dcb"><tavatekst id="d765f681-f09e-467e-9623-edd11bd927b2"> Sotsiaalosakonna juhataja või teda asendav ametnik võib teenuse omaosalust vähendada või seda mitte rakendada, kui teenuse saaja või ülalpidamiskohustusega isikud ei ole võimelised omaosalustasu maksma või muul põhjendatud juhul.</tavatekst></sisuTekst></loige></paragrahv><paragrahv id="para9"><paragrahvNr id="91540a9d-ea6b-4705-8ab3-8a5bf14d648b">9</paragrahvNr><kuvatavNr id="70ed0293-654d-47b0-88f7-dcbe352a0e4d"><![CDATA[§ 9. ]]></kuvatavNr><paragrahvPealkiri id="640bc15a-bcda-4381-908c-5f16b822bb6c">Arvestuse pidamine ja järelevalve</paragrahvPealkiri><loige id="para9lg1"><loigeNr id="10f967bd-a54e-4368-8dee-475a51519617">1</loigeNr><kuvatavNr id="67ceaabb-7afc-4908-9b2a-0ac3c6fd7731"><![CDATA[(1)]]></kuvatavNr><sisuTekst id="729905bf-0cf0-4621-bd19-62a018fce47e"><tavatekst id="e319326f-867d-477f-b9d2-a788e97892ee"> Teenuse osutamise arvestust peab vallavalitsuse sotsiaalosakonna ametnik.</tavatekst></sisuTekst></loige><loige id="para9lg2"><loigeNr id="6c7319fe-0521-4cc2-8363-cf1bfce06766">2</loigeNr><kuvatavNr id="7ee5a460-0fe7-46b4-8acd-fd03f6f8889a"><![CDATA[(2)]]></kuvatavNr><sisuTekst id="294b91e6-8dd5-43d0-a6e5-ba2f4f8f55f2"><tavatekst id="69964808-5126-488b-9c19-2e01e35473c8"> Järelevalvet teenuse osutamise üle teostab vallavalitsus.</tavatekst></sisuTekst></loige></paragrahv><paragrahv id="para10"><paragrahvNr id="a89e1b2c-f9f8-40ef-82ec-6e2f6784468c">10</paragrahvNr><kuvatavNr id="40fb734f-506f-4021-a214-d6d2cf3812d7"><![CDATA[§ 10. ]]></kuvatavNr><paragrahvPealkiri id="96ff6e67-1af5-4e03-9d82-db58a61b7ffa">Dokumendivormide kinnitamine</paragrahvPealkiri><loige id="para10lg1"><loigeNr id="507efc4d-893b-44e3-95bb-46e0329a98bc"/><kuvatavNr id="228ff805-16c8-4dc7-9625-302cca4ba74e"/><sisuTekst id="bd03242c-fc21-4214-b7f1-901e7fc61953"><tavatekst id="04b315db-88e9-494a-86cf-49c5b23fcdae">Vallavalitsus võib kinnitada määruse rakendamiseks vajalike dokumentide vormid.</tavatekst></sisuTekst></loige></paragrahv><paragrahv id="para11"><paragrahvNr id="bcc30f4d-4a3d-4dac-9f2a-e4e2815e5083">11</paragrahvNr><kuvatavNr id="5dc0ce56-203f-43f1-9c2b-7cd12a190887"><![CDATA[§ 11. ]]></kuvatavNr><paragrahvPealkiri id="0bc6820b-5f74-428f-b8bb-420bc4b8c602">Määruste kehtetuks tunnistamine</