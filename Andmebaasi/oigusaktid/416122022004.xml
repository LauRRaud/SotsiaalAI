 <sisu id="8255434f-8b8b-424c-b4e1-ac9879acc32f"><preambul id="c647d814-4b57-4754-9a1a-6cc5e609b277"><tavatekst id="2f3b4e02-3529-411d-b1c5-7a77831ffd4d">Määrus kehtestatakse kohaliku omavalitsuse korralduse seaduse § 6 lõike 1 ja Mulgi Vallavolikogu 16.06.2022 määruse nr 10 „Mulgi Hoolekandekeskuse põhimäärus“ § 7 lõike 3 alusel.</tavatekst></preambul><paragrahv id="para1"><paragrahvNr id="63ef66cd-ea1f-4613-a83f-fc37f730d285">1</paragrahvNr><kuvatavNr id="0fdfcac2-6fcb-49e5-a7b7-fc5a932e08b7"><![CDATA[§ 1. ]]></kuvatavNr><paragrahvPealkiri id="45cdca6d-8f17-4ecb-b835-a48c78c8f304">Reguleerimisala</paragrahvPealkiri><loige id="para1lg1"><loigeNr id="750915a1-2f3c-4dd6-8fca-0c069ca82f28"/><kuvatavNr id="2952bd5d-5244-4e1d-bba7-870d254604f6"/><sisuTekst id="cb3d40b6-fd4e-4dc7-9b64-ebddd65dee6e"><tavatekst id="d933e045-2087-4b1f-ab8c-2c886e5d0b8f">Käesolev kord reguleerib Mulgi Hoolekandekeskusesse (edaspidi <i>hoolekandekeskus</i>) vastuvõtmist, sealt lahkumise ja väljaarvamise korda.</tavatekst></sisuTekst></loige></paragrahv><paragrahv id="para2"><paragrahvNr id="0b20ddbf-a80d-4d6f-8ecf-18fbc15a3a0c">2</paragrahvNr><kuvatavNr id="4e30dc88-8750-451a-8be9-16c4493bf5fe"><![CDATA[§ 2. ]]></kuvatavNr><paragrahvPealkiri id="ae1d2539-0dc7-4cf9-a463-b303480faf6c">Hoolekandekeskusesse vastuvõtmine</paragrahvPealkiri><loige id="para2lg1"><loigeNr id="963bcfc1-bee6-4497-a4d9-c01cc60f4d1a">1</loigeNr><kuvatavNr id="aa73d6d7-d8c7-4896-be56-39f32ee645ee"><![CDATA[(1)]]></kuvatavNr><sisuTekst id="2947081d-1ece-4ea5-b106-8878b74c17cb"><tavatekst id="6a6aec89-788d-40a3-8a5e-89e9d8070a77">Hoolekandekeskusesse vastuvõtmiseks esitab teenust vajav isik või tema huvides tegutsev isik taotluse Mulgi valla sotsiaaltööspetsialistile (Mulgi valla elanikud) või hoolekandekeskusele (teiste omavalitsuste elanikud).</tavatekst></sisuTekst></loige><loige id="para2lg2"><loigeNr id="944c7b1e-270e-447c-8ea6-576afcc57e19">2</loigeNr><kuvatavNr id="2666800d-325e-4c8f-8eb3-78aa08480729"><![CDATA[(2)]]></kuvatavNr><sisuTekst id="1d6cc018-450c-45b7-86ca-51a72355635e"><tavatekst id="ed68b3ee-591f-4a15-a4ef-8582b7e696f9">Taotlusele lisatakse:</tavatekst></sisuTekst><alampunkt id="para2lg2p1"><alampunktNr id="8be9dceb-979e-4a22-a002-3413309f95f8">1</alampunktNr><kuvatavNr id="2a10aef3-55ec-4ba6-9336-7e5f23e66231"><![CDATA[1) ]]></kuvatavNr><sisuTekst id="e6ab5565-727c-4b8a-b4c8-d86d4a3fa1e4"><tavatekst id="df98090d-570c-4b86-8122-5c137d94b0de">teenust vajava isiku isikut tõendava dokumendi koopia;</tavatekst></sisuTekst></alampunkt><alampunkt id="para2lg2p2"><alampunktNr id="efacce7b-950f-448b-8bd8-8d90b7658733">2</alampunktNr><kuvatavNr id="14c71088-1f27-4ebf-a37f-88e6e868f753"><![CDATA[2) ]]></kuvatavNr><sisuTekst id="0738df5c-bfce-43f6-b8aa-98f6a430f15c"><tavatekst id="7f2a7b18-3b43-4145-8309-1b06bd3a02da">arsti hinnang teenust vajava isiku tervishoiuteenuse vajaduse ja mahu kohta (ravimiskeem), väljavõte olulisematest terviseprobleemidest (sh nakkushaiguste, sõltuvushäirete ja psüühikahäire kohta) ja määratud ravimitest;</tavatekst></sisuTekst></alampunkt><alampunkt id="para2lg2p3"><alampunktNr id="28ebb3be-fc99-4ba2-bf24-e33f6800239f">3</alampunktNr><kuvatavNr id="fd6b65ae-7129-4c25-a3de-ae612482e238"><![CDATA[3) ]]></kuvatavNr><sisuTekst id="e407b61b-9b90-4aa0-b909-a83e58b2369e"><tavatekst id="5f614297-e110-4778-97af-2d3867da8604">koopia Sotsiaalkindlustusameti otsusest puude raskusastme kohta (puude olemasolul);</tavatekst></sisuTekst></alampunkt><alampunkt id="para2lg2p4"><alampunktNr id="dac739f8-b47d-4493-859a-538d724a1f65">4</alampunktNr><kuvatavNr id="1813afec-6df3-4adf-94a4-7e6c8159069e"><![CDATA[4) ]]></kuvatavNr><sisuTekst id="703867e1-ad8c-4a14-9999-12530d521700"><tavatekst id="499b4634-70e9-49ba-b837-48b6c2d2e39e">kohaliku omavalitsuse haldusakt teenuse osalise või täieliku tasumise kohta (selle olemasolul).</tavatekst></sisuTekst></alampunkt></loige><loige id="para2lg3"><loigeNr id="7da697e7-6cd0-4ec0-bef4-671cbc1d7ecc">3</loigeNr><kuvatavNr id="1a8120e8-d8aa-41cb-a1e2-270a5f02b6c4"><![CDATA[(3)]]></kuvatavNr><sisuTekst id="abd0bd80-37af-46bf-83cf-b0ad29971fc2"><tavatekst id="71418e35-742a-4350-b3da-a06bb2ea6431">Teiste omavalitsuste elanike vastuvõtmise hoolekandekeskusesse otsustab Mulgi vallavalitsus 15 päeva jooksul arvates taotluse esitamisest.</tavatekst></sisuTekst></loige><loige id="para2lg4"><loigeNr id="9b60e9bd-bbd8-4464-a73e-f2ef6094a4a3">4</loigeNr><kuvatavNr id="baf9fd75-af6a-4713-a651-319e0d0c68f6"><![CDATA[(4)]]></kuvatavNr><sisuTekst id="20b08ef2-6831-417f-8697-faf5fe6516d5"><tavatekst id="88d8e00a-a127-4f56-aa1c-f77dcbf3bb9c">Hoolekandekeskusesse ei võeta üldjuhul vastu isikuid, kes põevad nakkushaiguseid, sõltuvushäiret, psüühikahäiret või vajavad tervishoiuteenust.</tavatekst></sisuTekst></loige><loige id="para2lg5"><loigeNr id="5f06da04-11c0-43e1-8358-73cb9783f03c">5</loigeNr><kuvatavNr id="a1f9df08-663c-49b7-9a32-f2d659e07b01"><![CDATA[(5)]]></kuvatavNr><sisuTekst id="a3b3f51f-943d-4431-bb7a-23e1fba95253"><tavatekst id="a1ccf8b0-e612-41d9-85e0-05720fe9e3a3">Mulgi valla sotsiaaltööspetsialisti poolt vältimatu abi korras teenusele paigutatavate isikute puhul esitatakse dokumendid esimesel võimalusel.</tavatekst></sisuTekst></loige><loige id="para2lg6"><loigeNr id="5f2a81fc-145f-42c0-a827-4cc84efd200f">6</loigeNr><kuvatavNr id="ba883452-86f4-430f-af34-615da134884f"><![CDATA[(6)]]></kuvatavNr><sisuTekst id="ed6d52de-360e-4eeb-92f1-064f177ca8f5"><tavatekst id="244feaeb-a94b-49ed-b7b3-fd7527b02a20">Hoolekandekeskus koostab sotsiaalhoolekande seaduses sätestatud tähtaja jooksul teenust vajavale isikule hooldusplaani koostöös teenuse saaja ja/või rahastajaga.</tavatekst></sisuTekst></loige><loige id="para2lg7"><loigeNr id="12f17e79-d5b6-4887-a76d-cff808970852">7</loigeNr><kuvatavNr id="75d3a74d-b411-40e7-862e-772bbab05c31"><![CDATA[(7)]]></kuvatavNr><sisuTekst id="fa9e12a5-b85c-4c80-abc8-376388855881"><tavatekst id="7364806a-5a6a-4292-ac94-d3d653ea976a">Hoolekandekeskusesse hooldamisele võtmise avalduse vormi ja hoolduslepingu vormid kinnitab Hoolekandekeskuse juhataja käskkirjaga.</tavatekst></sisuTekst></loige></paragrahv><paragrahv id="para3"><paragrahvNr id="d333154d-1742-44df-91ea-63ac09c82313">3</paragrahvNr><kuvatavNr id="6ba95b91-eb24-48c9-85a3-c5d0c37203ac"><![CDATA[§ 3. ]]></kuvatavNr><paragrahvPealkiri id="2fee5b26-fc4b-40bd-b445-3aae1fff250f">Lepingu sõlmimine</paragrahvPealkiri><loige id="para3lg1"><loigeNr id="a9c8760b-9de1-4ac7-b0c3-49f5c0b97cdf">1</loigeNr><kuvatavNr id="ce00a543-5952-4e3f-b432-b49920a3ffa5"><![CDATA[(1)]]></kuvatavNr><sisuTekst id="a4314031-515b-4564-8c03-becde835c83e"><tavatekst id="ade00735-b6b4-4929-8a54-fca8463249a0">Teenuse osutamine isikule toimub teenuse osutamise lepingu (edaspidi <i>leping</i>) alusel. Lepingu sisuks on eelkõige lepingu osaliste andmed, lepingu ese, arvelduste kord, lepingu tähtaeg, lepinguosaliste õigused ja kohustused, lepingu lõpetamise ja lepinguosaliste vaheline teadete saatmise kord.</tavatekst></sisuTekst></loige><loige id="para3lg2"><loigeNr id="972fabd0-9608-4a7b-9594-681cc0694352">2</loigeNr><kuvatavNr id="9394cf9e-2abc-481d-99e9-3aeaa38a2f6f"><![CDATA[(2)]]></kuvatavNr><sisuTekst id="6ed83711-c991-42c7-9631-e26f16f91b0c"><tavatekst id="d9b3d45a-6cd2-4d92-a3b2-ffdc32cd93f5">Lepingu sõlmib hoolekandekeskuse juhataja 7 kalendripäeva jooksul punktis hoolekandekeskusesse teenusele suunamise otsuse tegemisest.</tavatekst></sisuTekst></loige></paragrahv><paragrahv id="para4"><paragrahvNr id="54f6ce55-0ad1-448a-b819-18f1c7163a8d">4</paragrahvNr><kuvatavNr id="08969aa1-1cac-466d-8221-cb4bf9287c0f"><![CDATA[§ 4. ]]></kuvatavNr><paragrahvPealkiri id="ecb1b6f6-3988-46a6-82fd-e8e01dc974b3">Lepingu muutmine ja lõpetamine</paragrahvPealkiri><loige id="para4lg1"><loigeNr id="2a95e7e2-deeb-4f4d-8bb4-62f76a058e3a">1</loigeNr><kuvatavNr id="34b92f7b-61ef-4ecc-a38d-6140ff8d8327"><![CDATA[(1)]]></kuvatavNr><sisuTekst id="6b3d6882-e839-49ba-87fb-2b9461e30182"><tavatekst id="b6714c6b-c388-4bf8-aeb3-268cff4aae53">Lepingu muutmine ja lõpetamine toimub poolte kokkuleppel.</tavatekst></sisuTekst></loige><loige id="para4lg2"><loigeNr id="ce777d24-4cb7-44b9-98bb-4d15aa4a93b8">2</loigeNr><kuvatavNr id="6d1ff70d-7d76-4e24-b075-0e92e96ed1f7"><![CDATA[(2)]]></kuvatavNr><sisuTekst id="655f7ea2-4ba1-4458-8218-66e741d91c9f"><tavatekst id="c49a4e31-b6d2-410e-a22b-71efb8f897c4">Lepingu võib lõpetada sõltumata põhjusest teenuse saaja või tema huvides tegutsev isik, teatades sellest kirjalikult hoolekandekeskusele.</tavatekst></sisuTekst></loige><loige id="para4lg3"><loigeNr id="445432cd-31c2-40ee-8240-0725f840c0f6">3</loigeNr><kuvatavNr id="cc690940-b96f-4485-ba38-327c6b1ece3b"><![CDATA[(3)]]></kuvatavNr><sisuTekst id="9052abde-da03-456a-bb06-9ef30f1c963a"><tavatekst id="4d231207-98c0-49c8-87f1-75d8e11223f6">Hoolekandekeskusel on õigus mõjuval põhjusel ühepoolselt leping lõpetada. Mõjuv põhjus lepingu lõpetamiseks on eelkõige, kui:</tavatekst></sisuTekst><alampunkt id="para4lg3p1"><alampunktNr id="f6e6d52e-5091-4f57-83a0-7d2b42ecb6b0">1</alampunktNr><kuvatavNr id="6523ff8f-3a22-4ae8-a256-db63912495c6"><![CDATA[1) ]]></kuvatavNr><sisuTekst id="5178fd04-afd3-4b1f-a15d-22fa6621967e"><tavatekst id="23965234-d202-4bf3-b652-eb009b3805c7">teenuse osutamise käigus ilmnevad asjaolud, millest hoolekandekeskust eelnevalt ei teavitatud (sh teenust saava isiku igapäevase tegevusvõime või hooldusvajaduse kohta esitatud valeandmed), kuid mille tõttu ei ole võimalik või ei ole vajalik teenust isikule osutada;</tavatekst></sisuTekst></alampunkt><alampunkt id="para4lg3p2"><alampunktNr id="9ba5ff31-3267-4384-9e6e-e13e41140c82">2</alampunktNr><kuvatavNr id="327c5e36-e680-4d63-8761-1ba289f9225a"><![CDATA[2) ]]></kuvatavNr><sisuTekst id="ac17fbb3-d800-4474-9c88-71ecdfbd9f43"><tavatekst id="669bbc24-6a21-4db7-a054-f061735d59ba">teenust saava isiku tervislik seisund muutub teenuse osutamise ajal nii, et teenust ei ole võimalik või vajalik enam osutada;</tavatekst></sisuTekst></alampunkt><alampunkt id="para4lg3p3"><alampunktNr id="02cc5d87-1e52-4d2f-a28e-474934cfb3be">3</alampunktNr><kuvatavNr id="8a5e546a-c58a-4ce8-a905-c6d564d9b70b"><![CDATA[3) ]]></kuvatavNr><sisuTekst id="370f1892-88b5-4552-97e0-90967d225ba0"><tavatekst id="8ff9f345-0283-4fe2-8fff-471779de9615">teenust saav isik ei kohane või tema käitumine muutub agressiivseks (sh psüühikahäirest tulenevalt) ning seab sellega ohtu enda või teiste elu ja tervise ning vara;</tavatekst></sisuTekst></alampunkt><alampunkt id="para4lg3p4"><alampunktNr id="475f0122-a7e7-4d8f-9687-71466b35029f">4</alampunktNr><kuvatavNr id="721f3fbc-ccb9-4885-a620-2aa9d2f7b9c7"><![CDATA[4) ]]></kuvatavNr><sisuTekst id="21831ff6-e6f4-4b0b-9a16-8f58e7d1a41e"><tavatekst id="88202d37-b717-484a-a459-4041aaa3354d">teenust saav isik korduvalt häirib oma käitumisega teisi hoolekandekeskuse kliente või korduvalt rikub sisekorra eeskirju või lepingu tingimusi;</tavatekst></sisuTekst></alampunkt><alampunkt id="para4lg3p5"><alampunktNr id="5165417b-fc60-4877-901f-21540bcfb5ac">5</alampunktNr><kuvatavNr id="bd9ca084-a60c-4a3f-951b-37b1d82b0919"><![CDATA[5) ]]></kuvatavNr><sisuTekst id="e194b51e-8632-4d81-a49c-718d3acf47ce"><tavatekst id="4e7d0212-8b2c-4038-ad45-2ea4be47c87f">teenuse saaja on hoolekandekeskusest ette teatamata lahkunud ja tema asukoha kohta lahkumise kuupäevast alates ühe kuu jooksul andmed puuduvad.</tavatekst></sisuTekst></alampunkt></loige><loige id="para4lg4"><loigeNr id="631ade2b-1d14-4f96-81ba-b2f3bcf4350b">4</loigeNr><kuvatavNr id="bb4e7390-64c6-40e7-b811-c58eb55d3449"><![CDATA[(4)]]></kuvatavNr><sisuTekst id="ad831de7-b055-4f0f-b89f-e7029b07c47b"><tavatekst id="c584de7c-09e5-4722-a52c-36eb8353be9a">Leping loetakse lõppenuks teenuse saaja surmaga.</tavatekst></sisuTekst></loige></paragrahv><paragrahv id="para5"><paragrahvNr id="5e067b4f-3dd0-4aa4-9caf-33b75f71d5f8">5</paragrahvNr><kuvatavNr id="aef72b1a-659c-4ba7-be3a-90f4773e4d93"><![CDATA[§ 5. ]]></kuvatavNr><paragrahvPealkiri id="dc771ac6-6a32-4ccc-815a-c503ed68e15d">Rakendussätted ja määruse jõustumine</paragrahvPealkiri><loige id="para5lg1"><loigeNr id="55fe2c3f-5ce5-40ca-b961-8633e3ab7493"/><kuvatavNr id="32937954-00ea-4ba1-954c-ab7589e18e08"/><sisuTekst id="a18ca90e-a1e0-442d-b258-0dbad141701f"><tavatekst id="b177eb7f-d813-40c4-8ee3-3cb026b4c3be">Määrus jõustub 1. jaanuaril 2023. a.</tavatekst></sisuTekst></loige></paragrahv></sisu>
<allkiri id="366b715c-cfc5-4318-b2f1-0dcbd80135b2"><allkiriKoht id="cb253be3-3783-4371-8234-53df20602e06"/><allkirjastaja id="376cc817-b5a3-4579-adba-0f72486b8e86"><ametinimetus id="bb5bdc8c-6746-417c-b696-391ccc83bb83">vallavanem</ametinimetus><eesnimi id="9df4eafd-88ee-49f7-a6fc-84737340aa7f">Imre</eesnimi><perekonnanimi id="184763d6-8fb5-45b1-b45c-867edaaa6539">Jugomäe</perekonnanimi></allkirjastaja></allkiri><allkiri id="a6262da0-a7a5-48cd-a9c0-55c2ca21634a"><allkiriKoht id="6f503329-781e-4eef-8ce7-2859ff265a33"/><allkirjastaja id="f2174aec-1d31-4b3b-b786-fae2e34d0cab"><ametinimetus id="81010e73-b998-4537-8d27-9871846e2c31">vallasekretär</ametinimetus><eesnimi id="63da32c5-05bc-4c4e-848f-436652ee5b0c">Milja</eesnimi><perekonnanimi id="4d628c81-13e9-4fd3-b3e4-8a5034598c27">Janson</perekonnanimi></allkirjastaja></allkiri></oigusakt>