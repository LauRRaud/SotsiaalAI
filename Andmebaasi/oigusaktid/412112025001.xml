			<paragrahvPealkiri id="e40c4dc2-a568-4dbb-877d-4a78b3ad6af7">Määruse kehtetuks tunnistamine<reavahetus/></paragrahvPealkiri>
			<loige id="para2lg1">
				<loigeNr id="09c7289a-20b8-4d48-b148-ee27c65e5790"/>
				<kuvatavNr id="e1e08124-dabc-4976-8a8e-79bd77b42804"/>
				<sisuTekst id="1e79fd1e-6124-405a-83d6-af2672071b2e">
					<tavatekst id="b4b2d06d-f09e-4fb4-8e95-fae77753491c">Tunnistada kehtetuks Põhja-Pärnumaa Vallavalitsuse 16. mai 2023 määrus nr 4 "Hoolduskulu piirmäära kehtestamine".</tavatekst>
				</sisuTekst>
			</loige>
		</paragrahv>
