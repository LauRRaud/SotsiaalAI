	<sisu id="78386621-bef4-4fd8-983f-3291ea75a46c">
		<preambul id="6c7ef716-36f4-4cdf-b880-547b5a55e1aa">
			<tavatekst id="0a107aec-4122-4655-9951-d3a8caba40ea">Sotsiaalhoolekande seaduse § 22<sup>1</sup> lõike 3 ning Põhja-Pärnumaa Vallavolikogu 17.01.2018 määruse nr 3 "Lastekaitseseadusest, sotsiaalhoolekande seadusest ja riigilõivuseadusest tulenevate ülesannete delegeerimine" § 1 lõike 2 alusel.</tavatekst>
		</preambul>
		<paragrahv id="para1">
			<paragrahvNr id="8757acd9-ed9b-44c1-a9fb-e42f8b7c445a">1</paragrahvNr>
			<kuvatavNr id="27951d23-c1c1-4c73-ad70-a4f6046b981e"><![CDATA[§ 1. ]]></kuvatavNr>
			<paragrahvPealkiri id="9588cb9e-c2a5-4bd0-8040-750ec1d08f60">Üldhooldusteenuse hoolduskulu piirmäär</paragrahvPealkiri>
			<loige id="para1lg1">
				<loigeNr id="9152b0cd-474b-4038-a088-53561d4d08d7"/>
				<kuvatavNr id="1eafa4a5-d289-4fa4-aedb-b28372c46835"/>
				<sisuTekst id="566e74e5-8030-497d-a29e-50de06d66a39">
					<tavatekst id="f3c04ae8-e366-41f5-8d7b-0bcf403585d5">Põhja-Pärnumaa valla poolt hoolduskulu tasumise piirmäär valla elaniku kohta on 600 eurot kuus.</tavatekst>
				</sisuTekst>
			</loige>
		</paragrahv>
