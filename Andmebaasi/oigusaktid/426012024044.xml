    <tavatekst id="5e69702a-24f8-4f7a-81cb-b958cd0ffd3d">psühholoogiteenus;</tavatekst>
   </sisuTekst>
  </alampunkt><alampunkt id="para2lg2p2">
   <alampunktNr id="59cae1e4-935b-4fa7-8591-1f1b39985444">2</alampunktNr>
   <kuvatavNr id="faca15fe-135e-4700-b037-93299ea386f2"><![CDATA[2) ]]></kuvatavNr>
   <sisuTekst id="09c779bd-299e-4a59-aa36-66bafe3d6aa0">
