   <kuvatavNr id="43a426c5-68d0-4ac3-ba05-4027a834fecf"><![CDATA[6) ]]></kuvatavNr>
   <sisuTekst id="33f249a1-0faf-46c2-8dbd-80842ce2368f">
    <tavatekst id="fb29033d-040f-4fa5-90d3-8f89c57646ef">vanemlusprogrammis osalemine;</tavatekst>
   </sisuTekst>
  </alampunkt><alampunkt id="para2lg2p7">
   <alampunktNr id="580c6d38-70ec-476d-982b-517557e8739e">7</alampunktNr>
   <kuvatavNr id="56c0e98e-544e-4da7-9091-a7e15d6b01b6"><![CDATA[7) ]]></kuvatavNr>
   <sisuTekst id="b5e984b8-cffa-4a88-ad82-091f4b440fd7">
    <tavatekst id="f653ece6-c94b-4c4f-b08c-968bd8acea68">ennetustegevuste läbiviimine (infopäevade, koolituste läbiviimiseks koolides, lasteaedades ning teistes riigi ja kohaliku omavalitsuse üksuste ametiasutustes);</tavatekst>
   </sisuTekst>
  </alampunkt><alampunkt id="para2lg2p8">
