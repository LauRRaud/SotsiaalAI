   <pealkiri id="653119ce-5d03-4ed9-9971-9ad4810d3144">Lastega peredele sotsiaalhoolekandelise abi andmise kord</pealkiri>
  </nimi>
 </aktinimi>
 <muutmismarge id="8a5d38b5-803b-4275-bd3c-739a83e68400"><aktikuupaev id="b814daf8-53ff-4e39-95b5-83e742351ae6">2024-01-18</aktikuupaev><avaldamismarge id="ee6f0c8a-f610-4bde-9c55-e3079f39595a"><RTosa id="093801de-16ca-4115-b837-f44816a96fdd">RT IV</RTosa><avaldamineKuupaev id="44906cbe-b41d-4036-a18b-63fc08ec82c2">2024-01-26</avaldamineKuupaev><RTartikkel id="570c93a9-51c6-4c6f-869f-9f6137a3ec69">22</RTartikkel><aktViide id="34e3502c-9682-49a8-b4a1-0647dc0abe13">426012024022</aktViide></avaldamismarge><joustumine id="8cd6c674-a734-4514-a362-9dd3d421c1b8">2024-02-01</joustumine></muutmismarge><sisu id="aeb0b6d4-19f8-49d6-9518-5d80c471e7b8"><preambul id="c08c910c-9976-4946-a7dd-63c5988e6b9d">
   <tavatekst id="5447014d-8f4b-497d-9337-e08ecacfe1cf">Määrus kehtestatakse kohaliku omavalitsuse korralduse seaduse § 22 lõike 1 punkti 5, sotsiaalhoolekande seaduse § 14 lõike 2, lastekaitseseaduse § 17 lõike 2 alusel.</tavatekst>
  </preambul><paragrahv id="para1">
   <paragrahvNr id="7d7d2574-6acc-4f36-894c-01d771698a53">1</paragrahvNr>
   <kuvatavNr id="b18695c2-65e9-4948-bbab-4b80f9be3edd"><![CDATA[§ 1. ]]></kuvatavNr>
   <paragrahvPealkiri id="fc23bf38-9707-4871-b820-0ef25c3eab78">Reguleerimisala</paragrahvPealkiri>
  <loige id="para1lg1">
   <loigeNr id="b666cb90-d5b3-4f64-8bc6-2013065e9238">1</loigeNr>
   <kuvatavNr id="ebd4e73b-6806-4d4e-9eb9-07a287d50460"><![CDATA[(1)]]></kuvatavNr>
   <sisuTekst id="6b7144e4-1f8d-4a3e-b8f5-b3d1d2691b9b">
    <tavatekst id="438172a8-388d-4c63-b752-e32368512e40">Käesolev määrus reguleerib Paide linna eelarvest ja sotsiaalhoolekande seaduse § 156 lõigete 31-33 alusel antavate riigi eelarveliste vahendite kasutamist lastega peredele ja last kasvatavale isikule sotsiaalhoolekandelise abi andmiseks.</tavatekst>
   </sisuTekst>
  <muutmismarge id="3133d434-9934-4026-9be3-53dafcc4ac5d"><avaldamismarge id="e45ac6ff-b8fb-4605-918b-d7855c7f5aef"><RTosa id="183de121-79d4-4501-b9d6-e0ff540e4d5d">RT IV</RTosa><avaldamineKuupaev id="e5f7148b-0a43-4d22-aff5-0b98c2cf20d7">2024-01-26</avaldamineKuupaev><RTartikkel id="c7ba2a7c-85d0-47fd-a5d3-bfe58d9539cc">22</RTartikkel><aktViide id="39e20953-58c9-4ad7-bcb9-fcee424a9107">426012024022</aktViide></avaldamismarge><joustumine id="7089d694-97c5-4ae0-887d-cf2e87a460a2">2024-02-01</joustumine></muutmismarge></loige><loige id="para1lg2">
   <loigeNr id="4f6d55c5-fe5b-416c-bd4d-16532e40f266">2</loigeNr>
   <kuvatavNr id="fc9d4567-f22b-4150-9e43-ee514cb35bbe"><![CDATA[(2)]]></kuvatavNr>
   <sisuTekst id="fda425fb-98a5-41bf-a14c-4b6a93f0333b">
    <tavatekst id="6f393c03-71dd-46e7-a898-09a8e9660c5c">Määruse alusel korraldatakse sotsiaalhoolekandelise abi andmist lastega peredele või last kasvatavale isikule juhul, kui lapse elukoha aadress on Eesti rahvastikuregistri andmetel Paide linnas.</tavatekst>
   </sisuTekst>
  </loige></paragrahv><paragrahv id="para2">
   <paragrahvNr id="fb6094db-f60b-4ac0-abd4-77e4f9266eff">2</paragrahvNr>
   <kuvatavNr id="ae495d63-5e9d-4655-a1d2-805a9bb73f03"><![CDATA[§ 2. ]]></kuvatavNr>
   <paragrahvPealkiri id="5790646f-d9f9-4dec-8e76-4e17217131db">Sotsiaalhoolekandelise abi andmise eesmärk ja sisu</paragrahvPealkiri>
  <loige id="para2lg1">
   <loigeNr id="16d72f8a-778f-4f81-81be-e6f36091f9f5">1</loigeNr>
   <kuvatavNr id="989f6c6f-fcf5-4017-9d4b-d1ca206a5171"><![CDATA[(1)]]></kuvatavNr>
   <sisuTekst id="d59c4e66-2248-44c0-84ac-e2c40e269f65">
    <tavatekst id="125d278f-ec54-4661-be89-b80f00ac5e89">Sotsiaalhoolekandelise abi andmise eesmärgiks on lastega perede ja last kasvatava isiku toimetuleku ja laste heaolu tagamine, mis seisneb toetavate sotsiaalteenuste- ja toetuste osutamises, korraldamises ja arendamises.</tavatekst>
   </sisuTekst>
  </loige><loige id="para2lg2">
   <loigeNr id="b8608b04-4bed-415d-b770-4cf7edfe8add">2</loigeNr>
