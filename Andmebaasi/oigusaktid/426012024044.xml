    <tavatekst id="d135ebd5-c779-4a8e-b679-5e5d5ec6580e">Toetavad sotsiaalteenused- ja toetused (edaspidi <i>sotsiaalabi</i>) on:</tavatekst>
   </sisuTekst>
  <alampunkt id="para2lg2p1">
   <alampunktNr id="b14cb9ff-5bfc-46a2-8436-3c1b0aa50d9d">1</alampunktNr>
