	<sisu id="ee00ddf5-c387-4233-ae93-d3723a068379">
		<preambul id="6d4949ce-416c-497c-83a5-27e5c7563659">
			<tavatekst id="e73e4091-209d-4cb7-9706-f76d0cb4024d">Määrus kehtestatakse sotsiaalhoolekande seaduse § 133 lõigete 5 ja 6 ning kohaliku omavalitsuse korralduse seaduse § 22 lõike 1 punkti 37 alusel.</tavatekst>
		</preambul>
		<paragrahv id="para1">
			<paragrahvNr id="dd181b16-1e9c-4793-8ff4-e4037b059115">1</paragrahvNr>
			<kuvatavNr id="4b36c1c9-6091-44a1-8331-3977d6554fe5"><![CDATA[§ 1. ]]></kuvatavNr>
			<paragrahvPealkiri id="81930b00-7c06-45ea-a78c-285e1e831fb4">Reguleerimisala</paragrahvPealkiri>
			<loige id="para1lg1">
				<loigeNr id="e020a972-eccb-4605-9092-4abdce1a425e"/>
				<kuvatavNr id="732a11ce-d586-4898-b508-80cda42944fd"/>
				<sisuTekst id="2c07d13b-928c-45fe-85f4-18097937ecac">
					<tavatekst id="10014cc5-2269-4724-a9bc-29cdf9983f43">Määrusega kehtestatakse toimetulekutoetuse määramisel arvesse võetavate eluasemekulude piirmäärad Alutaguse vallas.</tavatekst>
				</sisuTekst>
			</loige>
		</paragrahv>
		<paragrahv id="para2">
			<paragrahvNr id="30c718fe-66a9-4450-8a24-e56c1e012d09">2</paragrahvNr>
			<kuvatavNr id="06da3076-9036-434f-acfd-f5b104beffaa"><![CDATA[§ 2. ]]></kuvatavNr>
			<paragrahvPealkiri id="9f66ae17-cca7-4717-ac07-4217855dac2c">Eluasemekulude arvestus</paragrahvPealkiri>
			<loige id="para2lg1">
				<loigeNr id="462ba2a7-c0e1-411c-8e88-89661f360470">1</loigeNr>
				<kuvatavNr id="edcc0ab9-31f0-4f31-9c16-278358c15a34"><![CDATA[(1)]]></kuvatavNr>
				<sisuTekst id="666c6605-2483-4471-950d-ebb61a10c19b">
					<tavatekst id="198b024f-75d2-41d2-8bf1-542e13104351">Alalise eluruumiga seotud eluasemekuludeks loetakse sotsiaalhoolekande seaduse paragrahvi 133 lõikes 5 loetletud kulud.</tavatekst>
				</sisuTekst>
			</loige>
			<loige id="para2lg2">
				<loigeNr id="043f38a4-57ab-4526-a8a5-c1fbdf7e8bed">2</loigeNr>
				<kuvatavNr id="700ae41c-8873-4aef-b027-b3df43de9d78"><![CDATA[(2)]]></kuvatavNr>
				<sisuTekst id="298d3a19-bb02-4ec4-a4a5-a2c14ef9bd97">
					<tavatekst id="9d03db6d-6134-4365-8cf9-c97b6fbc834d">Eluasemekulude arvestamise aluseks on perekonna kasutuses olev eluruum normpinna ulatuses, milleks on 18 m<sup>2</sup> iga perekonnaliikme kohta ja täiendavalt 15 m<sup>2</sup> perekonna kohta. Juhul kui eluruumi tubade arv võrdub seal alaliselt elavate elanike arvuga, kuid eluruumi üldpind on normpinnast suurem, võetakse aluseks eluruumi üldpind. Üksi elava pensionäri eluruumi normpinnaks loetakse 51 m<sup>2</sup>.</tavatekst>
				</sisuTekst>
			</loige>
			<loige id="para2lg3">
				<loigeNr id="e3057ab0-e03e-437c-8e72-1e4c00524f4f">3</loigeNr>
				<kuvatavNr id="301d0b5a-3c45-4e45-9076-7793eb8a77b2"><![CDATA[(3)]]></kuvatavNr>
				<sisuTekst id="067c23ea-4bc2-4645-9c6d-218df828f2af">
					<tavatekst id="1f2eb9b2-4c92-4623-b84d-02187f7c1a49">Toimetulekutoetuse määramisel võetakse normpinna ulatuses arvesse alalise eluruumiga seotud alalised dokumentaalselt tõestatud tegelikud eluasemekulud, mida tõendab toetuse taotleja esitatud maksekorraldus või arve.</tavatekst>
				</sisuTekst>
			</loige>
		</paragrahv>
		<paragrahv id="para3">
			<paragrahvNr id="7edc6c90-a437-4d15-9cd9-afcd7d6e3744">3</paragrahvNr>
			<kuvatavNr id="f442d9e7-f2b0-4589-b25d-ad8d1bccacdb"><![CDATA[§ 3. ]]></kuvatavNr>
			<paragrahvPealkiri id="ff7fce0d-b732-4983-b2fe-f1f906a0d34f">Eluasemekulude piirmäärad</paragrahvPealkiri>
			<loige id="para3lg1">
				<loigeNr id="c555ed1f-8ca4-40e1-a8ba-36f89986b119">1</loigeNr>
				<kuvatavNr id="7022510e-a692-4ef5-818f-a58f1c6ee441"><![CDATA[(1)]]></kuvatavNr>
				<sisuTekst id="3e59fd08-3443-4985-9bf6-5d8bffac3bc4">
					<tavatekst id="b75c5388-f429-43e0-9a2c-55fe088faad3">Toimetulekutoetuse määramisel võetakse arvesse jooksval kuul tasumisele kuuluvad eluasemekulud järgmiste piirmäärade ulatuses:</tavatekst>
				</sisuTekst>
				<alampunkt id="para3lg1p1">
					<alampunktNr id="7db70ca6-0947-4364-b98a-cb4b607587ac">1</alampunktNr>
					<kuvatavNr id="14ace5ec-4bca-4b86-9aef-f912313ec205"><![CDATA[1) ]]></kuvatavNr>
					<sisuTekst id="59a3251a-7db4-495d-b375-6c656816c0e1">
						<tavatekst id="4f260fb3-3439-4dd4-9bc0-31f6847fd2a2">üüritasu kuni 5,00 eurot 1 m<sup>2</sup> kohta kuus;</tavatekst>
					</sisuTekst>
				</alampunkt>
				<alampunkt id="para3lg1p1b1">
					<alampunktNr id="8b484399-ab75-4d78-84fd-2a143604d998" ylaIndeks="1">1</alampunktNr>
					<kuvatavNr id="017a248d-e852-4251-9368-5b11cc46eda5"><![CDATA[1<sup>1</sup>) ]]></kuvatavNr>
					<sisuTekst id="3809a812-b190-43bb-9748-f1c8c93e5ed2">
						<tavatekst id="9f6deb0d-eed4-49fa-8099-88208a906a9a">eluaseme soetamiseks võetud laenu tagasimakse kuni 6,00 eurot m2 kohta kuus, kuid mitte rohkem kui 6 kuud kalendriaastas;</tavatekst>
					</sisuTekst>
					<muutmismarge id="c6f51852-3a8b-4ceb-9032-5e780226c01b">
						<avaldamismarge id="14377a41-6a8e-47ca-b2bf-751017d3e7a2">
							<RTosa id="5a2d522a-f625-4072-85b3-19242520136f">RT IV</RTosa>
							<avaldamineKuupaev id="18d2cd16-e616-4966-a1ff-5f8dd729d05e">2022-07-07</avaldamineKuupaev>
							<RTartikkel id="6367c0f8-4d72-4951-9292-43c8cb2386b0">7</RTartikkel>
							<aktViide id="26d3405c-a0f9-4ca7-b91d-b31b0ebe6eb4">407072022007</aktViide>
						</avaldamismarge>
						<joustumine id="a748765c-49ae-48c2-ae97-5a26feaae504">2022-07-10</joustumine>
						<tavatekst id="d2f70898-10e8-4cc9-a7c0-8b0a66b952c7">, rakendatakse alates 01.07.2022</tavatekst>
					</muutmismarge>
				</alampunkt>
				<alampunkt id="para3lg1p2">
					<alampunktNr id="e6bdc4fd-1b6a-4498-81f1-f92fdf197d60">2</alampunktNr>
					<kuvatavNr id="8bc13b1b-8c82-40cd-89e1-af76e0e151a4"><![CDATA[2) ]]></kuvatavNr>
					<sisuTekst id="4c28f7fa-3ab3-4b09-8108-36167a06c11f">
						<tavatekst id="4328680f-07da-4646-a93a-f42d456a39b2">korterelamu haldamise kulu, sh remondiga seotud kulu kuni 6,00 eurot eluruumi 1 m<sup>2</sup> kohta kuus;</tavatekst>
					</sisuTekst>
				</alampunkt>
				<alampunkt id="para3lg1p3">
					<alampunktNr id="b4eafc5a-9669-4d3d-bbbe-23b83dff7aad">3</alampunktNr>
					<kuvatavNr id="e222ab53-6267-4fe5-ad12-5dd674ae1c25"><![CDATA[3) ]]></kuvatavNr>
					<sisuTekst id="d568ac95-79e5-4346-9909-5878232bb29f">
						<tavatekst id="a69d5e4d-5ed6-4794-9988-9cba4ce2aebe">korterelamu renoveerimiseks võetud laenu tagasimakse kuni 6,00 eurot 1 m<sup>2</sup> kohta kuus;</tavatekst>
					</sisuTekst>
				</alampunkt>
				<alampunkt id="para3lg1p4">
					<alampunktNr id="712cca9c-eabd-457d-9425-c0ba83a2621c">4</alampunktNr>
					<kuvatavNr id="9d681a53-f95f-41b8-9167-f71239a8188e"><![CDATA[4) ]]></kuvatavNr>
					<sisuTekst id="d332c5f9-de45-487a-b650-a9dd1efe0c57">
						<tavatekst id="8c61e851-4494-4a6d-919c-ea11361b1b4c">soojaveevarustuseks tarbitud soojusenergia kuni 10,00 eurot 1 m<sup>2</sup> kohta kuus;</tavatekst>
					</sisuTekst>
				</alampunkt>
				<alampunkt id="para3lg1p5">
					<alampunktNr id="3754c3a8-7e1e-47c5-91b6-6f27d3dc20bc">5</alampunktNr>
					<kuvatavNr id="a790289d-7b84-4f93-9b35-a7d3c13a1970"><![CDATA[5) ]]></kuvatavNr>
					<sisuTekst id="9eb03c9d-aa5e-416a-9915-b3b426e591ca">
						<tavatekst id="bb120093-c05b-4d34-808d-ae39b7f4d547">kütteks tarbitud soojusenergia või kütuse maksumus kuni 20,00 eurot 1 m<sup>2</sup> kohta kuus. Ahikütte puhul mitte üle 1200,00 euro aastas. Kompenseerimine toimub kulu tegemise kuul;</tavatekst>
					</sisuTekst>
					<muutmismarge id="3010df19-5a33-4e03-ba08-833dc3d01c1b">
						<avaldamismarge id="66ae1319-0aca-4636-b2cb-a0a043ad4fb0">
							<RTosa id="090e3340-3c77-4169-ab11-b7b66fb555ca">RT IV</RTosa>
							<avaldamineKuupaev id="95ef48ff-7b57-4212-9f83-13d81fe39474">2022-12-31</avaldamineKuupaev>
							<RTartikkel id="db4b64b1-5ee8-49af-9939-0398c64dbff3">35</RTartikkel>
							<aktViide id="f3e1332e-150e-4b7d-a55d-26cdd11054f3">431122022035</aktViide>
						</avaldamismarge>
						<joustumine id="19127fb7-60ff-469f-863e-28973f32c27b">2023-01-03</joustumine>
						<tavatekst id="e393d0de-9654-4369-96e6-210a5619636e">, rakendatakse alates 01.01.2023</tavatekst>
					</muutmismarge>
				</alampunkt>
				<alampunkt id="para3lg1p6">
					<alampunktNr id="07ca3e11-9027-48ad-a466-0a0f7e1331b1">6</alampunktNr>
					<kuvatavNr id="6e3f7389-af1c-4f7e-b779-948113328c19"><![CDATA[6) ]]></kuvatavNr>
					<sisuTekst id="ee2736c8-f2a4-48af-accc-b4c274d07186">
						<tavatekst id="10169bb0-06c5-4179-abb8-0b82c9736797">veevarustuse ja reovee ärajuhtimise teenuste maksumus kuni 50,00 eurot inimese kohta kuus. Kompenseerimisel võetakse arvesse ka abonenttasu ja vee jaotusteenuse maksumus. Septiku tühjendamise puhul kompenseeritakse kulu kuni kaks korda aastas. Kogumismahuti tühjendamise puhul kuni neli korda aastas. Kompenseerimine toimub kulu tegemise kuul;</tavatekst>
					</sisuTekst>
				</alampunkt>
				<alampunkt id="para3lg1p7">
					<alampunktNr id="471b6a50-aac4-42c4-b0d0-ea190b9c6126">7</alampunktNr>
					<kuvatavNr id="83b673af-f0f4-4224-9752-e89e194f12e9"><![CDATA[7) ]]></kuvatavNr>
					<sisuTekst id="cf8e64cd-4a72-4df2-baa2-93cfb08dfc6d">
						<tavatekst id="0b1f484c-7a39-4c4b-ab8c-844ab3c7e6ff">tarbitud elektrienergia maksumus kuni 100,00 eurot üheliikmelise pere kohta kuus ning iga järgneva pereliikme kohta kuni 60,00 eurot kuus;</tavatekst>
					</sisuTekst>
					<muutmismarge id="4ee9481a-935f-42e6-bece-59e93b3d98a6">
						<avaldamismarge id="64c9d334-5498-4246-91fa-21181a030e51">
							<RTosa id="ec27c9b1-527d-4c13-9229-0d29f154f05c">RT IV</RTosa>
							<avaldamineKuupaev id="007ebb1d-67c8-4cd6-a7e9-4cd1beae78e8">2022-12-31</avaldamineKuupaev>
							<RTartikkel id="60c6491f-4e65-4511-946b-ab1a4f7a1dd1">35</RTartikkel>
							<aktViide id="6ace94b4-dbc4-4496-bc59-7cd2af7c12e7">431122022035</aktViide>
						</avaldamismarge>
						<joustumine id="9eb7775b-46bd-45d1-b594-a4cb5b73d9a9">2023-01-03</joustumine>
						<tavatekst id="e6a63915-6f35-4ce9-822e-704870e2f58c">, rakendatakse alates 01.01.2023</tavatekst>
					</muutmismarge>
				</alampunkt>
				<alampunkt id="para3lg1p8">
					<alampunktNr id="4339e88e-a6d7-443b-b1ec-f1491ef3280f">8</alampunktNr>
					<kuvatavNr id="84c75caa-1ab4-4a51-a4be-50772e8f3b23"><![CDATA[8) ]]></kuvatavNr>
					<sisuTekst id="a57f1a92-29f1-4bdd-95a2-79a3c40d3325">
						<tavatekst id="3011e6a8-4f3c-4b0d-ac7d-9ba49a641f8d">tarbitud gaasiballooni maksumus kuni 60,00 eurot kvartalis. Balloonigaasi puhul kompenseeritakse üks balloon gaasi kvartalis, alates 5-liikmelisest perest kaks ballooni kvartalis. Kompenseerimine toimub kulu tegemise kuul;</tavatekst>
					</sisuTekst>
				</alampunkt>
				<alampunkt id="para3lg1p9">
					<alampunktNr id="78b8c7ad-b073-483a-8633-306823fe81a7">9</alampunktNr>
					<kuvatavNr id="9619ddbc-054f-4d78-aee7-e100a756ab89"><![CDATA[9) ]]></kuvatavNr>
					<sisuTekst id="b396b368-adaa-46a1-a2eb-7b29d642baef">
						<tavatekst id="561cc26f-4ac2-4e82-915f-84673cd9d067">maamaksukulu, mille arvestamise aluseks on kolmekordne elamualune pind kuni 0,30 eurot 1 m<sup>2</sup> kohta kuus;</tavatekst>
					</sisuTekst>
				</alampunkt>
				<alampunkt id="para3lg1p10">
					<alampunktNr id="af6659c1-f616-4ff6-927b-280a86892aff">10</alampunktNr>
					<kuvatavNr id="2e30db06-469e-40a0-960a-61baa981567d"><![CDATA[10) ]]></kuvatavNr>
					<sisuTekst id="b24dadbe-dce3-419a-a249-c9886bdc2fd1">
						<tavatekst id="20a23313-3f96-4929-a450-fbf97498a102">hoone kindlustuse kulud kuni 1,00 eurot 1 m<sup>2</sup> kohta kuus;</tavatekst>
					</sisuTekst>
				</alampunkt>
				<alampunkt id="para3lg1p11">
					<alampunktNr id="f16820a4-d08d-4a45-8314-728c6fc63a0c">11</alampunktNr>
					<kuvatavNr id="f8e5febc-c4d1-44c2-8594-6377dd14ca24"><![CDATA[11) ]]></kuvatavNr>
					<sisuTekst id="76e26981-6e36-4db2-9430-32dcb506899e">
						<tavatekst id="35a4eb40-4230-48dc-a72b-d862144a55f1">olmejäätmete veotasu kuni 10,00 eurot ühe elaniku kohta kuus.</tavatekst>
					</sisuTekst>
				</alampunkt>
			</loige>
			<loige id="para3lg2">
				<loigeNr id="ba5dbf20-8553-4d87-8fb3-eca83e40326b">2</loigeNr>
				<kuvatavNr id="f59b5708-8d40-4a91-b732-3c8482f51886"><![CDATA[(2)]]></kuvatavNr>
				<sisuTekst id="98cc562e-4efc-4008-9c99-2165c290aeee">
					<tavatekst id="ca7994a0-4df5-4024-97ab-761924b5d32f">Eluasemekulude arvestamine toimub teenuse osutaja või kauba müüja poolt väljastatud arvete ja maksekviitungite alusel.</tavatekst>
				</sisuTekst>
			</loige>
			<loige id="para3lg3">
				<loigeNr id="d61a0d98-56fc-4704-a5f5-cb6bc712e0ec">3</loigeNr>
				<kuvatavNr id="3ce798a0-7060-4712-b294-247061448df0"><![CDATA[(3)]]></kuvatavNr>
				<sisuTekst id="aca79a94-42ab-46b1-b409-db14487016e6">
					<tavatekst id="78bbbec1-2bf3-4817-bbe4-820f357e44a2">Eluasemekulude tasumisel varem tekkinud võlgnevust ei arvata toimetulekutoetuse määramisel jooksval kuul tasumisele kuuluvate eluasemekulude hulka ja see ei kuulu katmisele toimetulekutoetuse vahenditest.</tavatekst>
				</sisuTekst>
			</loige>
		</paragrahv>
		<paragrahv id="para4">
			<paragrahvNr id="58ed4525-ddd0-42db-9927-6cf67a39fcd4">4</paragrahvNr>
			<kuvatavNr id="85032434-7ed0-4b77-b0c1-46828082e28c"><![CDATA[§ 4. ]]></kuvatavNr>
			<paragrahvPealkiri id="297a89fa-ab71-4b9c-b2f8-7cb3717054db">Määruse kehtetuks tunnistamine</paragrahvPealkiri>
			<loige id="para4lg1">
				<loigeNr id="e47ed0ff-582e-475b-a000-528886166732"/>
				<kuvatavNr id="3d4211da-6eea-4ade-9c35-0646a2538a74"/>
				<sisuTekst id="bc07e41d-26bd-4957-91cd-7ee79a24a167">
					<tavatekst id="d85d1ea3-ed27-4239-843f-78d9e2644005">[Käesolevast tekstist välja jäetud.]</tavatekst>
				</sisuTekst>
			</loige>
		</paragrahv>
		<paragrahv id="para5">
			<paragrahvNr id="58091521-d326-408e-9023-30d2ae7c43fd">5</paragrahvNr>
			<kuvatavNr id="7f69b1d8-995b-43b7-83fa-86f5be8925f5"><![CDATA[§ 5. ]]></kuvatavNr>
			<paragrahvPealkiri id="032deb5d-474e-412e-ae90-a0c83d88dec8">Määruse jõustumine</paragrahvPealkiri>
			<loige id="para5lg1">
				<loigeNr id="6686f3fe-7297-44c5-a34c-89fb90f0d6bb"/>
				<kuvatavNr id="4c5a0da1-b8f9-4f6e-8091-1019b0878a97"/>
				<sisuTekst id="8f361b5c-412a-4b48-9746-4b393d8ad6a4">
					<tavatekst id="dd2151a3-a2c9-49fd-9514-fcb72f0def98">Määrus jõustub kolmandal päeval pärast Riigi Teatajas avaldamist ja seda rakendatakse alates 2022. aasta 1. aprillist.</tavatekst>
				</sisuTekst>
			</loige>
