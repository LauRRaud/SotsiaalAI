   <pealkiri id="e47035cf-473e-4a23-8951-dcac3c982c54">Sotsiaaltransporditeenuse määramise ja osutamise kord </pealkiri>
  </nimi>
 </aktinimi>
 <sisu id="3380953c-46a7-486a-b082-2607b98304d2"><preambul id="c9bebd9c-1ef4-42c4-997c-fd9bd2554367"><tavatekst id="dda29606-c8d5-4e03-8a29-45661fe71680">Määrus kehtestatakse kohaliku omavalitsuse korralduse seaduse § 22 lõike 1 punkti 5 ning sotsiaalhoolekande seaduse § 14 lõike 1 ja § 38 lõike 1 alusel.</tavatekst></preambul><paragrahv id="para1"><paragrahvNr id="a590e009-dcce-462c-ac34-710a6eea9f58">1</paragrahvNr><kuvatavNr id="6d7807bd-fcce-476c-98d2-6f8bf522a18e"><![CDATA[§ 1. ]]></kuvatavNr><paragrahvPealkiri id="8999f0ca-bd8f-4d11-b511-d6ac68fe82af">Määruse reguleerimisala</paragrahvPealkiri><loige id="para1lg1"><loigeNr id="62496d98-2856-4232-8598-b880bae84bad"/><kuvatavNr id="dce33f2a-dccf-41e7-9ec1-1d9caad21d88"/><sisuTekst id="e7bb00a2-0848-4dd6-ace2-a7088b0240a5"><tavatekst id="252e4695-6307-4e58-a50a-85765ff40f94">Määrus sätestab sotsiaaltransporditeenuse korraldamise, määramise ja osutamise ning kulude katmise korra Viljandi vallas (edaspidi kord).</tavatekst></sisuTekst></loige></paragrahv><paragrahv id="para2"><paragrahvNr id="158010b2-23b8-40f8-a796-b0cd3aba6a73">2</paragrahvNr><kuvatavNr id="9ff37481-cf58-4fb7-9a6a-bd7f4fc7f040"><![CDATA[§ 2. ]]></kuvatavNr><paragrahvPealkiri id="b640899e-7206-43d1-b5da-b26c8ec16d06">Mõisted</paragrahvPealkiri><loige id="para2lg1"><loigeNr id="22ccdea4-1999-41b4-898a-f6707899275a"/><kuvatavNr id="1bec0ecb-c1c5-4932-9681-90ef7a9ee1f1"/><sisuTekst id="89f0d61e-4270-4388-9c1c-3bfd5ba69d1f"><tavatekst id="e9ccb961-52ae-409c-b457-4244ef8359b1">Käesolevas korras kasutatakse mõisteid järgmises tähenduses:</tavatekst></sisuTekst><alampunkt id="para2lg1p1"><alampunktNr id="9972c6c6-79a6-447b-b3b4-f6b49b66640a">1</alampunktNr><kuvatavNr id="144be17e-ba2e-454b-aa1a-56596ebd6454"><![CDATA[1) ]]></kuvatavNr><sisuTekst id="49454f58-8bbe-4a2d-84db-2ac663bfe9ec"><tavatekst id="5cad8986-9930-47db-af67-74f8a1ca037a">sotsiaaltransporditeenus (edaspidi teenus) - kohaliku omavalitsuse üksuse korraldatav sotsiaalteenus, mille eesmärk on võimaldada puuetega inimeste sotsiaaltoetuste seaduse § 2 lõike 1 tähenduses puudega isikul, kellel puue takistab isikliku või ühissõiduki kasutamist, kasutada tema vajadustele vastavat transpordivahendit tööle või õppeasutusse sõitmiseks või avalike teenuste kasutamiseks;</tavatekst></sisuTekst></alampunkt><alampunkt id="para2lg1p2"><alampunktNr id="a26739a3-cbb4-4656-bb30-2a4f95a436a2">2</alampunktNr><kuvatavNr id="aefb5413-648e-4995-90d0-0254b2cbbf55"><![CDATA[2) ]]></kuvatavNr><sisuTekst id="0ab85d2b-5aaf-4b75-90ad-eefd3d5ba306"><tavatekst id="4361dadd-0881-4ad6-8a48-e814a1644586">teenuse taotleja - isik, kes soovib teenust saada;</tavatekst></sisuTekst></alampunkt><alampunkt id="para2lg1p3"><alampunktNr id="cebc8456-9c6c-4cdf-b422-a434dd1ae08e">3</alampunktNr><kuvatavNr id="99c8b846-cc5a-42d0-bf48-5974b080c923"><![CDATA[3) ]]></kuvatavNr><sisuTekst id="b71e84f5-a685-4366-afe0-fcb2f1be5f87"><tavatekst id="9166e9fb-95da-4b9a-b9e9-16abfaa9d3b3">teenuse saaja - isik, kes on õigustatud teenust saama;</tavatekst></sisuTekst></alampunkt><alampunkt id="para2lg1p4"><alampunktNr id="174ecefa-7f9f-4356-a9c0-d9416fdfc9ea">4</alampunktNr><kuvatavNr id="9673cb7b-77d3-432a-8480-66ba9cd5e38a"><![CDATA[4) ]]></kuvatavNr><sisuTekst id="6c3d10f8-7229-4dfb-929d-3dd2e767274e"><tavatekst id="61989eed-d3d0-42c7-8c61-dab97aa74b1a">saatja ja/või teenust vahetult osutav isik - isik, kes abistab ja saadab teenuse saajat ravi- või ametiasutusse ning vajadusel ka transpordib;</tavatekst></sisuTekst></alampunkt><alampunkt id="para2lg1p5"><alampunktNr id="30b85bdc-8d2b-4f49-8a7b-4581a1aee935">5</alampunktNr><kuvatavNr id="9e65c9f3-e273-4f16-9883-aa039a7b990c"><![CDATA[5) ]]></kuvatavNr><sisuTekst id="01f8bb47-4f52-4942-b2af-d9c441bcefb4"><tavatekst id="ae913e1c-c51d-4e8d-aafd-91b6dce4d635">teenuse osutaja - võib olla füüsiline isik, juriidiline isik, Viljandi Vallavalitsuse ametiasutus (edaspidi ametiasutus) või tema hallatav asutus (saatja ja teenuse osutaja võib olla vajadusel üks ja sama isik);</tavatekst></sisuTekst></alampunkt><alampunkt id="para2lg1p6"><alampunktNr id="d6e633b2-f3e0-4f55-84dc-8e8d5a8a390b">6</alampunktNr><kuvatavNr id="ccb7cd65-1eed-46d5-95ad-00c014bcd907"><![CDATA[6) ]]></kuvatavNr><sisuTekst id="8d8388f3-ba1f-43d0-9253-ea4e81ff37d1"><tavatekst id="a47a348b-8b94-49a3-b33e-571cfe601373">tellimus - andmed sõidu otstarbe, marsruudi (lähte- ja sihtkoht) ja sõidu kuupäeva kohta;</tavatekst></sisuTekst></alampunkt><alampunkt id="para2lg1p7"><alampunktNr id="4c9c89dd-8117-4056-9af2-7b9f0ca42b73">7</alampunktNr><kuvatavNr id="48904d91-b57f-4879-9f07-45f0792fbb1b"><![CDATA[7) ]]></kuvatavNr><sisuTekst id="26c71079-1acc-4fb0-9440-00cdb3ec51c2"><tavatekst id="e641c38e-acd1-4018-bd08-45beff9e2d5b">seadusjärgne ülalpidaja - perekonnaseaduse § 96 mõistes abivajava isiku täisealised esimese ja teise astme ülenejad (vanemad ja vanavanemad) ja alanejad sugulased (lapsed ja lapselapsed);</tavatekst></sisuTekst></alampunkt><alampunkt id="para2lg1p8"><alampunktNr id="643a62fd-29ae-4374-ae55-50bbc42ba403">8</alampunktNr><kuvatavNr id="27a55310-070b-4536-b408-b164abdffa1b"><![CDATA[8) ]]></kuvatavNr><sisuTekst id="01f6011f-bc87-4443-8a2d-1895d7bcfb85"><tavatekst id="9a70e3a9-9889-4802-bfa4-eec3de3047e4">spetsialist - ametiasutuse sotsiaalvaldkonna ametnik.</tavatekst></sisuTekst></alampunkt></loige></paragrahv><paragrahv id="para3"><paragrahvNr id="232f0498-da8a-49ac-ab2f-66af0b0c1a35">3</paragrahvNr><kuvatavNr id="2eb31f90-9885-4492-8bc5-5cd49b622f44"><![CDATA[§ 3. ]]></kuvatavNr><paragrahvPealkiri id="1ff4d049-bd10-4343-a1dd-b0777fdbf3c2">Teenuse eesmärk ja sihtgrupp</paragrahvPealkiri><loige id="para3lg1"><loigeNr id="2f4e4c29-65f2-4d5f-99bc-40fb7923ca2d">1</loigeNr><kuvatavNr id="60075a14-982c-49d2-a38f-88e69b2c7766"><![CDATA[(1)]]></kuvatavNr><sisuTekst id="7873fd28-f3c4-4c8f-950e-326f530836a2"><tavatekst id="5a26b3a1-a4e9-47dc-bc00-47ef1715d7f7"> Teenust osutatakse puudega inimesele (puuetega inimeste sotsiaaltoetuste seaduse § 2 lõike 1 tähenduses) või eakale isikule, kes on kantud rahvastikuregistrisse Viljandi valla elanikuna ja kes erivajaduste tõttu ei saa kasutada isiklikku või ühistransporti ning ei ole suuteline iseseisvalt sõitma või sõitu korraldama avalikke teenuseid pakkuvatesse asutustesse, kooli või tööle.</tavatekst></sisuTekst></loige><loige id="para3lg2"><loigeNr id="463639ad-d7ca-4fdf-a660-3b6bd517e089">2</loigeNr><kuvatavNr id="8e385e10-a4b2-4b11-8029-1f8c7521c324"><![CDATA[(2)]]></kuvatavNr><sisuTekst id="39571f8d-460c-4be9-bd2f-cc21952fc78b"><tavatekst id="49a2e2ee-19c3-46d7-b691-9619c201aecc"> Erandjuhul, mõjuval põhjusel, võib teenust osutada ka käesoleva paragrahvi lõikes 1 nimetamata isikule.</tavatekst></sisuTekst></loige></paragrahv><paragrahv id="para4"><paragrahvNr id="6ad07a7c-cadb-4080-aa1e-0017cddd2d15">4</paragrahvNr><kuvatavNr id="ff019d9b-b484-4f98-9e2c-cd3ed3a2810c"><![CDATA[§ 4. ]]></kuvatavNr><paragrahvPealkiri id="77cea5cc-0108-4973-81d5-dceced13980f">Teenuse osutaja</paragrahvPealkiri><loige id="para4lg1"><loigeNr id="661d7a0d-0b23-4c48-86e0-321542d30d07"/><kuvatavNr id="1c912b19-877a-4a2e-889c-d24e4eebe03d"/><sisuTekst id="1bb75317-3970-49c5-ad79-604e54253831"><tavatekst id="31915226-6a61-4a32-86e0-647c3fbb9371">Teenust võib osutada füüsiline- või juriidiline isik, ametiasutus või tema hallatav asutus.</tavatekst></sisuTekst></loige></paragrahv><paragrahv id="para5"><paragrahvNr id="5b41dc02-a4a5-4a77-845f-dfef22b4e632">5</paragrahvNr><kuvatavNr id="cd808583-1fcd-4241-b873-2accdd103980"><![CDATA[§ 5. ]]></kuvatavNr><paragrahvPealkiri id="8d4cc9f3-e6d3-4c73-8a84-8148f0380720">Teenuse taotlemine</paragrahvPealkiri><loige id="para5lg1"><loigeNr id="549a3a43-4640-4984-b4c8-7dfd761238ef">1</loigeNr><kuvatavNr id="dd29b50a-3ba0-4a3c-9cee-12734a47c6cc"><![CDATA[(1)]]></kuvatavNr><sisuTekst id="ec6e0866-845d-498b-94e2-a0289077396d"><tavatekst id="eb34344e-16c5-4835-ab93-0ddf23908c32"> Teenuse saamiseks esitab teenuse taotleja või tema seaduslik esindaja üldjuhul hiljemalt 7 tööpäeva enne soovitud sõiduaega ametiasutusele:</tavatekst></sisuTekst><alampunkt id="para5lg1p1"><alampunktNr id="8376ea3c-3e2e-4368-b073-1407bc4cac00">1</alampunktNr><kuvatavNr id="4b10570b-68a7-4b71-a704-0943ea9c6a91"><![CDATA[1) ]]></kuvatavNr><sisuTekst id="4e019c2a-b8c4-4580-af83-c00678748a96"><tavatekst id="92b4f3ff-2ad7-4252-9b25-67d67fa2225a">esmakordsel taotlemisel - kirjaliku taotluse ja tellimuse;</tavatekst></sisuTekst></alampunkt><alampunkt id="para5lg1p2"><alampunktNr id="16c11875-d52b-418b-975c-96e4d172b9f5">2</alampunktNr><kuvatavNr id="653d5047-a94e-4d8b-8377-b93115e74a79"><![CDATA[2) ]]></kuvatavNr><sisuTekst id="a2a51a9e-066d-4257-ad76-d406671c60bb"><tavatekst id="fc596639-74ce-46ff-b425-bca6d35d4724">korduval taotlemisel - spetsialisti nõutud dokumendid.</tavatekst></sisuTekst></alampunkt></loige><loige id="para5lg2"><loigeNr id="5b92cadf-7df0-451a-b7e7-32b7bc9f079f">2</loigeNr><kuvatavNr id="283ae2b8-fa44-45cc-894c-6f255c7c327b"><![CDATA[(2)]]></kuvatavNr><sisuTekst id="4945f837-b615-42f8-ad97-62fcd4fc5a79"><tavatekst id="aad96315-ce92-41a7-906c-c5200a70ee7b"> Taotluses märgitakse teenuse vajalikkuse põhjendus, sõidu otstarve, marsruut (lähte- ja sihtkoht), sõidu kuupäev(ad) ja asjaolud, mis takistavad ühis- või isikliku transpordi kasutamist.</tavatekst></sisuTekst></loige><loige id="para5lg3"><loigeNr id="71a376f2-34c3-4e51-be18-fea8b4a0d44e">3</loigeNr><kuvatavNr id="6775e3ec-b6c4-4fbe-a181-bc6e872ed99f"><![CDATA[(3)]]></kuvatavNr><sisuTekst id="d8823920-67ae-4e20-85a8-3b90fcd3af34"><tavatekst id="e23cc675-bac8-4e57-b01a-b917cdc8e923"> Ettepaneku teenuse osutamiseks võib esitada ka spetsialist.</tavatekst></sisuTekst></loige><loige id="para5lg4"><loigeNr id="380b051c-6b67-4847-a051-b0cad384cbde">4</loigeNr><kuvatavNr id="fb1606b2-fe29-4d02-a585-a99c47ff7a80"><![CDATA[(4)]]></kuvatavNr><sisuTekst id="9c7a3e3e-a92b-41dc-9351-6b128f339fb5"><tavatekst id="e6c90735-3c38-48ca-b7e8-187ab6535fb1"> Spetsialist hindab teenuse taotleja õigustatud vajadust teenusele.</tavatekst></sisuTekst></loige><loige id="para5lg5"><loigeNr id="a5ca973c-fafe-48cb-ae5d-fbb3da94eb16">5</loigeNr><kuvatavNr id="c5d34070-94fc-4780-bad5-d82c27241d11"><![CDATA[(5)]]></kuvatavNr><sisuTekst id="40b253a6-3bf4-45af-b245-68a90f5a98d7"><tavatekst id="201bd8d2-69d9-438e-847d-f850b5a599fd"> Spetsialistil on õigus nõuda täiendavaid dokumente.</tavatekst></sisuTekst></loige><loige id="para5lg6"><loigeNr id="28948237-aab0-421e-bc8e-601e8dd9c6ed">6</loigeNr><kuvatavNr id="2ad62762-68d9-4b0d-8d2d-629d5e6a2ee2"><![CDATA[(6)]]></kuvatavNr><sisuTekst id="8422f616-b1f2-46f4-a2f0-36f51bb41020"><tavatekst id="08f2b452-23c1-48fc-a2a4-c05a3844d82c"> Teenuse vajaduse kindlakstegemiseks viib spetsialist koostöös teenuse taotlejaga ja vajadusel koostöös tema ülalpidamiskohustusega isikutega läbi teenuse taotleja abivajaduse hindamise. Hindamise läbiviimiseks võib kasutada erinevaid olemasolevaid küsimustikke/instrumente ja metoodikaid.</tavatekst></sisuTekst></loige><loige id="para5lg7"><loigeNr id="7ce3a4bc-60ea-4f5c-9c7a-a244a2ea4303">7</loigeNr><kuvatavNr id="d7057c68-b166-4b03-9d97-2ece249bba9e"><![CDATA[(7)]]></kuvatavNr><sisuTekst id="9849f0ef-dbd5-4a5d-9f70-1064d00af4b1"><tavatekst id="671c22b2-a5b4-41a2-84e3-ebf5db72beeb"> Teenuse sisu, osutamise sagedus ja kestus on teenuse saaja vajadustest sõltuvalt erinev.</tavatekst></sisuTekst></loige><loige id="para5lg8"><loigeNr id="4cd33e46-2382-43ff-8997-7179f84c35d2">8</loigeNr><kuvatavNr id="a9023681-1655-4de0-862e-aeda7707c2c4"><![CDATA[(8)]]></kuvatavNr><sisuTekst id="7fa44a7b-4187-4b21-aaf4-0f449a6b17f3"><tavatekst id="a3e4606c-c660-495b-bb49-034fece7c84b"> Teenuse taotlejat ja tema pereliikmeid puudutavaid andmeid ning muud teenuse osutamisega seotud informatsiooni kasutatakse ainult teenuse eesmärkidest lähtuvalt ja osapoolte huvides.</tavatekst></sisuTekst></loige></paragrahv><paragrahv id="para6"><paragrahvNr id="d73c23ce-bd44-445e-8a15-f8c1ca1454d9">6</paragrahvNr><kuvatavNr id="251e9cd5-8ab1-461e-96a6-1db2017521fb"><![CDATA[§ 6. ]]></kuvatavNr><paragrahvPealkiri id="c182dbdb-6297-4322-b388-607f113ff1ea">Teenuse määramine ja määramisest keeldumine</paragrahvPealkiri><loige id="para6lg1"><loigeNr id="6088dd9d-a345-494b-ac31-59ff133f042e">1</loigeNr><kuvatavNr id="4963e8ec-75d5-4802-8ed8-9da6f7cbaf67"><![CDATA[(1)]]></kuvatavNr><sisuTekst id="475861c7-405b-4e88-b8a9-7563eff25b1d"><tavatekst id="e1238513-83a6-4213-a5a2-15a3ee232be8"> Teenuse määramise, rahastamise, teenuse määramisest keeldumise, muutmise ja lõpetamise otsustab Viljandi Vallavalitsuse alatine sotsiaalkomisjon (edaspidi sotsiaalkomisjon), kes hindab kaalutlusõiguse alusel taotluse põhjendatust ja taotlusele lisatud dokumente ning otsustab haldusaktiga (edaspidi otsus) teenuse määramise või määramisest keeldumise 10 tööpäeva jooksul alates viimase nõuetekohase dokumendi saamisest.</tavatekst></sisuTekst></loige><loige id="para6lg2"><loigeNr id="5151dd1f-bdcd-4f7e-96cf-9b45f5f371bc">2</loigeNr><kuvatavNr id="3a94e0c6-79d9-4335-b2f8-d89b5c12d2f9"><![CDATA[(2)]]></kuvatavNr><sisuTekst id="75916e3a-4515-41cb-a29a-081b11e7cd85"><tavatekst id="26e66ee3-797c-4181-8cf4-0b79f3a0aed8"> Juhul, kui otsuse tegemiseks on vajalik pikem tähtaeg, informeerib spetsialist sellest teenuse taotlejat kirjalikult.</tavatekst></sisuTekst></loige><loige id="para6lg3"><loigeNr id="246e9d65-083f-4ddf-a3c5-9e80356deb2d">3</loigeNr><kuvatavNr id="ba73f97a-d1bc-442b-9a1e-d8d835c08742"><![CDATA[(3)]]></kuvatavNr><sisuTekst id="2a3961ee-0fae-470d-8460-04c238410488"><tavatekst id="c2383fda-c7f5-4e0e-9303-ff2707b29c1c"> Teenus määratakse tähtajaliselt.</tavatekst></sisuTekst></loige><loige id="para6lg4"><loigeNr id="f96743d9-20af-4428-bfb7-02d26dca5abd">4</loigeNr><kuvatavNr id="3761f871-c10b-4223-a656-6c52911cec0f"><![CDATA[(4)]]></kuvatavNr><sisuTekst id="8700faa4-a4b8-4677-b60b-6878ec783b9e"><tavatekst id="354c6bc8-845b-4fbf-9ae2-d91c10a2bec5"> Vajadusel soovitab spetsialist isiku toetamiseks teisi sotsiaalteenuseid.</tavatekst></sisuTekst></loige><loige id="para6lg5"><loigeNr id="08badfc6-d1a3-404c-9c77-67d8e770037b">5</loigeNr><kuvatavNr id="2e4c2803-2e90-4946-b137-fd511dc5502a"><![CDATA[(5)]]></kuvatavNr><sisuTekst id="cead2723-98be-4cf8-990e-65da05e25bad"><tavatekst id="004fde6d-5d56-49c2-a89d-43f52f48251a"> Otsus teenuse määramisest keeldumise kohta tehakse teenuse taotlejale teatavaks kirjalikku taasesitamist võimaldavas vormis viie tööpäeva jooksul, arvates otsuse tegemise päevast.</tavatekst></sisuTekst></loige><loige id="para6lg6"><loigeNr id="b5174c5d-430e-4bc2-b14a-e1a48c9d37a1">6</loigeNr><kuvatavNr id="e8ee87da-0594-446b-a99b-3f2b57565d43"><![CDATA[(6)]]></kuvatavNr><sisuTekst id="de2aa4db-92da-478d-b99d-bfebfd788032"><tavatekst id="51321a2f-f97b-48b0-828b-a238d1166d7f"> Teenuse määramisest võib keelduda juhul, kui esineb vähemalt üks järgmistest asjaoludest:</tavatekst></sisuTekst><alampunkt id="para6lg6p1"><alampunktNr id="238d6175-28d0-435f-b5e4-483eb2e028c3">1</alampunktNr><kuvatavNr id="af36fe45-eb7d-4332-830c-e8616fa8fd66"><![CDATA[1) ]]></kuvatavNr><sisuTekst id="11bba8a3-2906-463c-9b05-3346dada41d5"><tavatekst id="88767093-2bdc-4962-a253-3a6a85bb29e2">isik ei ole õigustatud teenust saama korras sätestatud § 3 alusel;</tavatekst></sisuTekst></alampunkt><alampunkt id="para6lg6p2"><alampunktNr id="65cc7aba-b009-42e4-8f60-72f57f45ecde">2</alampunktNr><kuvatavNr id="69406b52-f7e5-4018-80d3-a15101659fe5"><![CDATA[2) ]]></kuvatavNr><sisuTekst id="5fc94b59-a064-4735-96a0-6715c62adc77"><tavatekst id="250c5f3e-3f51-4a1c-8ea5-a32084ce78e6">ametiasutusele ei ole esitatud kõiki teadaolevaid tõeseid ja täielikke andmeid, dokumente ja muid tõendeid, mis on vajalikud teenuse määramise otsustamisel;</tavatekst></sisuTekst></alampunkt><alampunkt id="para6lg6p3"><alampunktNr id="5dc6a8be-892d-4864-aee2-e6c4caf96c5a">3</alampunktNr><kuvatavNr id="58c3aa59-1791-4bd5-87a2-a9f2418a3e98"><![CDATA[3) ]]></kuvatavNr><sisuTekst id="39a73ce6-1e52-4dfa-b066-b3500a6d6d1d"><tavatekst id="c569b20d-d22b-477f-9137-c805c5a22cc8">teenuse taotleja ei osale aktiivselt talle teenuse määramisel, sealhulgas ei võimalda läbi viia teenuse vajaduse hindamist;</tavatekst></sisuTekst></alampunkt><alampunkt id="para6lg6p4"><alampunktNr id="dc7069d0-771e-4a40-a2f7-62ae054418f5">4</alampunktNr><kuvatavNr id="483edfcf-7c1f-4515-82f6-6955384b6fcc"><![CDATA[4) ]]></kuvatavNr><sisuTekst id="bb6a56f4-c826-412c-8eaa-5d9692034309"><tavatekst id="bc422a66-c360-45a5-be7f-b4ecf1b40a14">teenuse vajadust on võimalik või otstarbekas katta muude teenuste või muu abiga;</tavatekst></sisuTekst></alampunkt><alampunkt id="para6lg6p5"><alampunktNr id="99d52144-036a-4b70-a397-ddeaebd856c0">5</alampunktNr><kuvatavNr id="01e26202-e8fc-4367-bbd7-305264d6e986"><![CDATA[5) ]]></kuvatavNr><sisuTekst id="594d1549-6e2d-4114-95f3-d78c473880c9"><tavatekst id="033dd1ab-5464-4ea3-b301-44c2547207f3">teenuse vajaduse katavad riiklikud või valla eelarvest makstavad toetused ja teenused;</tavatekst></sisuTekst></alampunkt><alampunkt id="para6lg6p6"><alampunktNr id="a9489718-d090-4db6-9171-24dd6b7c91cd">6</alampunktNr><kuvatavNr id="67230dd9-d58a-4456-9469-3b4bebfc26a1"><![CDATA[6) ]]></kuvatavNr><sisuTekst id="9685d28d-388f-4919-8d04-9d5f38a22265"><tavatekst id="389be85c-1997-48bc-9fe0-f6a4031ef838">teenuse saaja on jätnud korduvalt teenuse vajaduse ära langemisel tellimuse tühistamata;</tavatekst></sisuTekst></alampunkt><alampunkt id="para6lg6p7"><alampunktNr id="d2231bf8-ecfb-42e1-b84d-5671ee595e11">7</alampunktNr><kuvatavNr id="c7ef8e88-89db-43bd-a37e-81ebcb3b8d03"><![CDATA[7) ]]></kuvatavNr><sisuTekst id="67c7e847-9ddb-4ece-8deb-8a2d4605e4f4"><tavatekst id="09e0f5a8-f62a-4d8a-98c2-d0a95b183e1d">muul põhjendatud juhul.</tavatekst></sisuTekst></alampunkt></loige></paragrahv><paragrahv id="para7"><paragrahvNr id="6663c1bd-411c-4e00-ae88-35a6f3e35ad5">7</paragrahvNr><kuvatavNr id="22958eec-6428-4c27-b4ad-f682dbfab613"><![CDATA[§ 7. ]]></kuvatavNr><paragrahvPealkiri id="0bed6e2b-99cc-4432-bc06-f1f4b2258670">Teenuse korraldamine ja osutamine</paragrahvPealkiri><loige id="para7lg1"><loigeNr id="c478e65f-557c-44fe-9d58-a848b5976ddb">1</loigeNr><kuvatavNr id="63b1f751-2501-43eb-8c3b-91750e586ab3"><![CDATA[(1)]]></kuvatavNr><sisuTekst id="2b12aac2-d45c-44cc-bd29-64c630429870"><tavatekst id="f51f4beb-8d98-4540-a165-b4031a6581a7"> Teenust korraldab ametiasutuse spetsialist sotsiaalkomisjoni otsuse alusel.</tavatekst></sisuTekst></loige><loige id="para7lg2"><loigeNr id="754b7e84-a9a0-4894-9710-083ec578fae2">2</loigeNr><kuvatavNr id="7238090f-d0a6-459a-af8b-fd5f448a15cf"><![CDATA[(2)]]></kuvatavNr><sisuTekst id="0744fbf2-cb71-4e0f-9577-69380ad2e552"><tavatekst id="564bcfa1-a666-4436-8f9a-e52ce0fe195f"> Kui teenuse saaja mingil põhjusel ei soovi kokkulepitud ajal teenust saada, peab ta sellest teatama teenuse osutajale ja spetsialistile võimalusel koheselt või vähemalt üks päev enne teenuse saamist.</tavatekst></sisuTekst></loige><loige id="para7lg3"><loigeNr id="e34bdad4-e82c-4ac0-a4ef-6ff91603e007">3</loigeNr><kuvatavNr id="0acfdb3d-575b-4491-a2e9-c155a8b6645f"><![CDATA[(3)]]></kuvatavNr><sisuTekst id="a0b5f695-6aed-465c-942e-b161abc96daf"><tavatekst id="05a65542-df51-449f-85e1-db7756eef542"> Ametiasutus korraldab teenust juhuveona.</tavatekst></sisuTekst></loige><loige id="para7lg4"><loigeNr id="e7b614a1-15a7-483b-802c-100f92245be3">4</loigeNr><kuvatavNr id="e7299e75-237a-4f1b-959b-579798d311da"><![CDATA[(4)]]></kuvatavNr><sisuTekst id="168c290e-f9c2-4471-b19d-94ba5a53aebf"><tavatekst id="3ef3d40b-3074-4dc6-8217-da7d4e981b92"> Teenust vahetult osutav isik peab vastama järgmistele nõuetele:</tavatekst></sisuTekst><alampunkt id="para7lg4p1"><alampunktNr id="ed422954-0f40-4f30-9c33-30609af2b065">1</alampunktNr><kuvatavNr id="c7a439f8-b07d-4a99-8bc8-6356ec1df60b"><![CDATA[1) ]]></kuvatavNr><sisuTekst id="9d7e6cfe-8901-4179-8d9e-32b6de72cb05"><tavatekst id="ac69ca58-f595-43cb-9d8a-892051e504e8">on täisealine täieliku teovõimega füüsiline isik;</tavatekst></sisuTekst></alampunkt><alampunkt id="para7lg4p2"><alampunktNr id="4d4142e6-2b7a-4bc2-ac98-d8a66e3730f9">2</alampunktNr><kuvatavNr id="6f389713-c3fa-42f4-b312-6afd901f891c"><![CDATA[2) ]]></kuvatavNr><sisuTekst id="c8bde3a9-d06b-4269-9360-91e556297355"><tavatekst id="4c6f6362-6c4d-454c-a226-f1b3085be67b">on isikuomaduste ja võimete poolest sobiv;</tavatekst></sisuTekst></alampunkt><alampunkt id="para7lg4p3"><alampunktNr id="745588f7-8a10-4b19-9311-9fc11823e74c">3</alampunktNr><kuvatavNr id="f5c1e977-4eac-4049-8599-c2b92dda42e8"><![CDATA[3) ]]></kuvatavNr><sisuTekst id="39f017e4-5d97-49d7-8b40-44532ef56861"><tavatekst id="48a632d1-871c-4df8-8163-c0573f074fc5">ei ole karistusregistrisse kantud ja tema suhtes ei ole alustatud kriminaalmenetlust.</tavatekst></sisuTekst></alampunkt></loige><loige id="para7lg5"><loigeNr id="b69fad7e-007d-4f8f-9c7d-07b2773bbd35">5</loigeNr><kuvatavNr id="89fde11f-5e0e-434e-8082-9ff04d16f11e"><![CDATA[(5)]]></kuvatavNr><sisuTekst id="b08d1361-1649-46b1-a3c6-927848239ac1"><tavatekst id="2ba7bb00-52de-4805-a6ac-4628f50816f8"> Teenust ei tohi vahetult osutada isik, kelle karistus tahtlikult toimepandud kuriteo eest võib ohtu seada Teenuse saaja isiku elu, tervise ja vara.</tavatekst></sisuTekst></loige><loige id="para7lg6"><loigeNr id="620cd4f6-5bbc-415e-ba3f-3e61894bbf87">6</loigeNr><kuvatavNr id="b6d9dee9-4e93-45b6-a5da-9ba2ea167afc"><![CDATA[(6)]]></kuvatavNr><sisuTekst id="06b67a63-a51d-41fb-a71f-e82bd0ba1d49"><tavatekst id="3a6f7d7d-92b4-471a-aae4-e9d10b15764b"> Teenust vahetult osutaval isikul või saatjal on kohustus abistada teenuse saajat kogu teenuse osutamise vältel ning aidata teenuse saajat liikumisel hoonesisesest asukohast (kodust, haiglast vm) teenust osutava sõidukini.</tavatekst></sisuTekst></loige><loige id="para7lg7"><loigeNr id="3acff7be-49be-4c7d-a0c6-049005133af3">7</loigeNr><kuvatavNr id="891d48da-e577-489e-bcce-4fee2b4295de"><![CDATA[(7)]]></kuvatavNr><sisuTekst id="a186e25d-8c72-411d-9a4a-9e82d7a9766b"><tavatekst id="fc3c6433-ac36-4206-87a7-8a2c1abf27ca"> Teenuse vahetul osutajal on õigus keelduda teenuse osutamisest, kui teenuse saaja on joobes.</tavatekst></sisuTekst></loige></paragrahv><paragrahv id="para8"><paragrahvNr id="51611c32-54db-45ab-9453-af9d86816fc2">8</paragrahvNr><kuvatavNr id="798f877b-7e06-44cb-b1e3-100696448d5d"><![CDATA[§ 8. ]]></kuvatavNr><paragrahvPealkiri id="f1236741-427c-44ac-89ee-bf25a6f99f2c">Teenuse rahastamine ja teenuse eest tasumine</paragrahvPealkiri><loige id="para8lg1"><loigeNr id="2c39c5fd-2343-468b-a4b4-fd7b8547a395">1</loigeNr><kuvatavNr id="417490df-0ba4-498b-8cc6-9cdbd1c29295"><![CDATA[(1)]]></kuvatavNr><sisuTekst id="d89bea68-7bc7-4970-bb4d-324dc8e01efa"><tavatekst id="e26feaa4-93c9-4372-b0e1-078509550d25"> Teenus on tasuline. Teenuse hinna kehtestab Viljandi Vallavalitsus (edaspidi vallavalitsus).</tavatekst></sisuTekst></loige><loige id="para8lg2"><loigeNr id="a66b48a4-85e5-4b93-bf76-9e4d42541415">2</loigeNr><kuvatavNr id="fab6e334-df9c-41e1-ae3f-b451274a8717"><![CDATA[(2)]]></kuvatavNr><sisuTekst id="9a852e04-1da0-45f5-bfc1-f1a05f0a5b1f"><tavatekst id="8a6acb52-53e5-43bc-89b1-cbbf5954efd3"> Kui teenuse osutajaks on ametiasutus või ametiasutuse hallatav asutus, kehtestab teenuse hinna vallavalitsus.</tavatekst></sisuTekst></loige><loige id="para8lg3"><loigeNr id="03706472-a692-4819-8359-2189b189e500">3</loigeNr><kuvatavNr id="ca6e1044-6fc1-4857-86f2-047a4f9ca6e3"><![CDATA[(3)]]></kuvatavNr><sisuTekst id="3b3720a7-9d52-4656-b69c-5da3714f960b"><tavatekst id="0e92156a-5b4c-4c61-b93e-c9cfd19031b7"> Teenuse saaja tasub teenuse eest vastavalt sõidu marsruudi pikkusele kilomeetrites ja kehtestatud hinnale.</tavatekst></sisuTekst></loige><loige id="para8lg4"><loigeNr id="7a50dd17-60c3-4053-a0fd-d031482563da">4</loigeNr><kuvatavNr id="fa905dc5-3677-4f65-966b-de8a97b937b3"><![CDATA[(4)]]></kuvatavNr><sisuTekst id="425e9a5c-df90-4fb1-a0b5-91c84af2ee1f"><tavatekst id="d7f81ec7-4752-4232-8da4-8fa238dfb134"> Teenuse eest võetava tasu suurus sõltub teenuse mahust ja maksumusest ning teenuse saaja ja tema perekonna majanduslikust olukorrast.</tavatekst></sisuTekst></loige><loige id="para8lg5"><loigeNr id="bd22dee9-b0a7-4f88-8700-4620c28b88b3">5</loigeNr><kuvatavNr id="1da85719-2a76-481d-b237-b86448a552d6"><![CDATA[(5)]]></kuvatavNr><sisuTekst id="11a398b7-4375-40a7-adcf-0b7ac637301b"><tavatekst id="fa12d80e-de25-4a1e-9e84-1c50f5af933f"> Vähekindlustatud isikule või perekonnale teenuse osutamisel võib vabastada teenuse saaja teenuse eest tasumisest ning osutada teenust tasuta.</tavatekst></sisuTekst></loige><loige id="para8lg6"><loigeNr id="96dd8e25-6b7e-4eb5-874f-f3f5b1dd968b">6</loigeNr><kuvatavNr id="9ca6ef12-c7c1-430e-8098-a87fb2993fc5"><![CDATA[(6)]]></kuvatavNr><sisuTekst id="73d37399-19ce-49ac-bd5f-3dab1a8aa5b5"><tavatekst id="acbd865c-13e1-497b-aafa-d01a07e17ab5"> Teenuse eest tasumisest vabastamiseks või osaliseks vabastamiseks peab teenuse saaja esitama ametiasutusele ühekordse sotsiaaltoetuse taotluse. Sotsiaalkomisjon otsustab toetuse määramise ja maksmise vastavalt Viljandi Vallavolikogu 27.06.2018 määrusele nr 36 „Sotsiaaltoetuste taotlemise, määramise ja maksmise kord“.</tavatekst></sisuTekst></loige><loige id="para8lg7"><loigeNr id="74585b56-3560-4e82-9159-657fa46a2825">7</loigeNr><kuvatavNr id="88da2861-3107-4b1d-bcdb-5dfa0cd67d56"><![CDATA[(7)]]></kuvatavNr><sisuTekst id="b0e81b2b-f925-4287-b535-fc95c21fa419"><tavatekst id="38bf5b98-838e-4bb9-af70-e47bdb787633"> Kui teenuse saajale on vaja teenust osutada viivitamatult, võib ametiasutus teenust osutada koheselt ja selgitada hiljem välja teenuse saaja majandusliku võimekuse teenuse eest tasuda.</tavatekst></sisuTekst></loige><loige id="para8lg8"><loigeNr id="9bf75be3-655b-4372-8b86-ff36343f3ccd">8</loigeNr><kuvatavNr id="c6b693b8-591c-4956-9e42-7d971a6db10a"><![CDATA[(8)]]></kuvatavNr><sisuTekst id="04cec138-fd58-49c6-831f-590e55423654"><tavatekst id="485eb634-db1c-4517-b8e5-2f0287ff07a9"> Teenuse saaja tasub teenuse osutajale teenuse eest arve alusel.<reavahetus/></tavatekst></sisuTekst></loige></paragrahv><paragrahv id="para9"><paragrahvNr id="64f0de26-2529-4bed-aefe-09061d574c3a">9</paragrahvNr><kuvatavNr id="349d83a9-4565-4526-8025-4260e7609031"><![CDATA[§ 9. ]]></kuvatavNr><paragrahvPealkiri id="d4ed7599-7c1f-4834-9820-a8a039dca3e3">Teenuse osutamise lõppemine ja lõpetamine</paragrahvPealkiri><loige id="para9lg1"><loigeNr id="9654921e-f44e-4c07-be93-064ce714360e">1</loigeNr><kuvatavNr id="4afcc2d5-75c8-4bb9-be3f-e4df18790751"><![CDATA[(1)]]></kuvatavNr><sisuTekst id="0a1ce705-5ff1-456e-bae0-aa6cb036f1d8"><tavatekst id="5e0b2cf2-49b8-4e46-93a6-02948e728670"> Teenuse osutamine lõpetatakse sotsiaalkomisjoni otsuse alusel:</tavatekst></sisuTekst><alampunkt id="para9lg1p1"><alampunktNr id="88a609ad-a9ac-43d0-bc36-be92e7630b10">1</alampunktNr><kuvatavNr id="d53542d9-ce51-41f2-960f-d92039f2f35b"><![CDATA[1) ]]></kuvatavNr><sisuTekst id="28d5734d-e0a0-46db-acb8-1d8dbf7783d7"><tavatekst id="528310c3-d697-4119-9d4c-e808c0d2d868">teenuse vajaduse äralangemisel;</tavatekst></sisuTekst></alampunkt><alampunkt id="para9lg1p2"><alampunktNr id="0b7f474d-91e8-43cc-b6a7-1ab155adf8f4">2</alampunktNr><kuvatavNr id="dc1f4093-984a-4553-9216-956d96d77ab5"><![CDATA[2) ]]></kuvatavNr><sisuTekst id="333b315b-f9d3-4d33-8a6c-be8a4f603aee"><tavatekst id="1bd821d2-7f54-4dee-95c0-3a40a7ccfe99">teenuse saaja (sh teenuse saaja seadusliku esindaja) või teenuse osutaja taotluse alusel;</tavatekst></sisuTekst></alampunkt><alampunkt id="para9lg1p3"><alampunktNr id="8390de70-6c73-4b26-9f31-669ada4c088b">3</alampunktNr><kuvatavNr id="23c5802a-ba51-4624-82bd-315997ca9543"><![CDATA[3) ]]></kuvatavNr><sisuTekst id="fea18158-d33c-4753-8141-50b4d70d26b2"><tavatekst id="a0b089ee-f223-4a01-b9f0-dffd05e5d058">teenuse saaja või teenuse osutaja elama asumisel teise omavalitsusüksuse haldusterritooriumile;</tavatekst></sisuTekst></alampunkt><alampunkt id="para9lg1p4"><alampunktNr id="9fd5a227-1f3d-4132-984a-0b9cb752fdb8">4</alampunktNr><kuvatavNr id="1dfdf6ad-e72f-44e7-ae9f-99b5