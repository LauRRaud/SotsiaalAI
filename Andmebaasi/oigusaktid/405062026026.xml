  <aktinimi>
    <nimi>
      <pealkiri>Koduse lapse toetamise kord</pealkiri>
    </nimi>
  </aktinimi>
  <sisu>
    <preambul>
      <tavatekst>Määrus kehtestatakse kohaliku omavalitsuse korralduse seaduse § 6 lg 3 p 2 ja § 22 lg 1 p 5 alusel.</tavatekst>
    </preambul>
    <paragrahv id="para1">
      <paragrahvNr>1</paragrahvNr>
      <kuvatavNr><![CDATA[§ 1.]]></kuvatavNr>
      <paragrahvPealkiri>Reguleerimisala</paragrahvPealkiri>
      <loige id="para1lg1">
        <sisuTekst>
          <tavatekst>Määrusega kehtestatakse Tallinna linna elanikele koduse lapse toetuse (edaspidi <i>toetus</i>) maksmise tingimused ja kord.</tavatekst>
        </sisuTekst>
      </loige>
    </paragrahv>
    <paragrahv id="para2">
      <paragrahvNr>2</paragrahvNr>
      <kuvatavNr><![CDATA[§ 2.]]></kuvatavNr>
      <paragrahvPealkiri>Toetuse eesmärk</paragrahvPealkiri>
      <loige id="para2lg1">
        <sisuTekst>
          <tavatekst>Toetuse eesmärk on suurendada pere valikuvõimalusi, toetades pooleteise- kuni kolmeaastase lapse kasvatamist ja ülalpidamist kodus alternatiivina munitsipaallasteaias ja -hoius koha kasutamisele ning lapsehoiuteenuse toetuse saamisele.</tavatekst>
        </sisuTekst>
      </loige>
    </paragrahv>
    <paragrahv id="para3">
      <paragrahvNr>3</paragrahvNr>
      <kuvatavNr><![CDATA[§ 3.]]></kuvatavNr>
      <paragrahvPealkiri>Toetuse saamise tingimused</paragrahvPealkiri>
      <loige id="para3lg1">
        <sisuTekst>
          <tavatekst>Toetust on õigus saada pooleteise- kuni kolmeaastase lapse
vanemal, eestkostjal või hoolduspere vanemal (edaspidi <i>vanem</i>)
järgmistel tingimustel:</tavatekst>
        </sisuTekst>
        <alampunkt id="para3lg1p1">
          <alampunktNr>1</alampunktNr>
          <kuvatavNr><![CDATA[1)]]></kuvatavNr>
          <sisuTekst>
            <tavatekst>lapse ja tema vanema(te) elukoht on rahvastikuregistri andmetel toetuse taotlemise kalendriaastale eelneva kalendriaasta 31.<i> </i>detsembril ning<b> </b>kogu toetuse saamise aja jooksul katkematult Tallinna linn;</tavatekst>
          </sisuTekst>
        </alampunkt>
        <alampunkt id="para3lg1p2">
          <alampunktNr>2</alampunktNr>
          <kuvatavNr><![CDATA[2)]]></kuvatavNr>
          <sisuTekst>
            <tavatekst>laps ei ole ühegi kohaliku omavalitsuse munitsipaallasteaia või -hoiu nimekirjas ja talle ei ole määratud lapsehoiuteenuse toetust.</tavatekst>
          </sisuTekst>
        </alampunkt>
      </loige>
    </paragrahv>
    <paragrahv id="para4">
      <paragrahvNr>4</paragrahvNr>
      <kuvatavNr><![CDATA[§ 4.]]></kuvatavNr>
      <paragrahvPealkiri>Toetuse määr</paragrahvPealkiri>
      <loige id="para4lg1">
        <loigeNr>1</loigeNr>
        <kuvatavNr><![CDATA[(1)]]></kuvatavNr>
        <sisuTekst>
          <tavatekst>Toetuse määr on 250 eurot kuus lapse kohta. </tavatekst>
        </sisuTekst>
      </loige>
      <loige id="para4lg2">
        <loigeNr>2</loigeNr>
        <kuvatavNr><![CDATA[(2)]]></kuvatavNr>
        <sisuTekst>
          <tavatekst>Toetust
makstakse kogu määra ulatuses, kui on täidetud käesoleva määruse §-s 3 sätestatud
tingimused ning</tavatekst>
        </sisuTekst>
        <alampunkt id="para4lg2p1">
          <alampunktNr>1</alampunktNr>
          <kuvatavNr><![CDATA[1)]]></kuvatavNr>
          <sisuTekst>
            <tavatekst>lapse ja mõlema vanema elukoht on rahvastikuregistri andmetel Tallinna linn määruse § 3 punkti 1 mõttes;</tavatekst>
          </sisuTekst>
        </alampunkt>
        <alampunkt id="para4lg2p2">
          <alampunktNr>2</alampunktNr>
          <kuvatavNr><![CDATA[2)]]></kuvatavNr>
          <sisuTekst>
            <tavatekst>lapse ja üksikvanema, eestkostja või hoolduspere
vanema elukoht on rahvastikuregistri andmetel Tallinna linn määruse § 3 punkti
1 tähenduses. Üksikvanemaga on tegu, kui lapse sünniaktis puuduvad andmed teise
vanema kohta, teine vanem on surnud või on seadusega kehtestatud korras
tunnistatud tagaotsitavaks. Üksikvanemaks loetakse ka vanem, kes tõendab, et lapse teine vanem ei täida
ülalpidamiskohustust ja ei hoolda last, ning esitab Tallinna Haridusametile
põhjendatud avalduse. Küsimuste korral on haridusametil õigus küsida
vanemalt täiendavaid selgitusi.</tavatekst>
          </sisuTekst>
        </alampunkt>
      </loige>
      <loige id="para4lg3">
        <loigeNr>3</loigeNr>
        <kuvatavNr><![CDATA[(3)]]></kuvatavNr>
        <sisuTekst>
          <tavatekst>Toetust makstakse 50% määrast, kui on täidetud käesoleva määruse §-s 3 sätestatud tingimused ning määruse § 3 punkti 1 mõttes on rahvastikuregistri andmetel Tallinna elanik ainult laps ja üks vanem.</tavatekst>
        </sisuTekst>
      </loige>
      <loige id="para4lg4">
        <loigeNr>4</loigeNr>
        <kuvatavNr><![CDATA[(4)]]></kuvatavNr>
        <sisuTekst>
          <tavatekst>Toetust makstakse Tallinna linna eelarves selleks ettenähtud vahendite olemasolul.</tavatekst>
        </sisuTekst>
      </loige>
    </paragrahv>
    <paragrahv id="para5">
      <paragrahvNr>5</paragrahvNr>
      <kuvatavNr><![CDATA[§ 5.]]></kuvatavNr>
      <paragrahvPealkiri>Toetuse taotlemine</paragrahvPealkiri>
      <loige id="para5lg1">
        <loigeNr>1</loigeNr>
        <kuvatavNr><![CDATA[(1)]]></kuvatavNr>
        <sisuTekst>
          <tavatekst>Toetuse saamiseks esitab vanem taotluse Tallinna
Haridusametile.</tavatekst>
        </sisuTekst>
      </loige>
      <loige id="para5lg2">
        <loigeNr>2</loigeNr>
        <kuvatavNr><![CDATA[(2)]]></kuvatavNr>
        <sisuTekst>
          <tavatekst>Taotluses märgitakse:</tavatekst>
        </sisuTekst>
        <alampunkt id="para5lg2p1">
          <alampunktNr>1</alampunktNr>
          <kuvatavNr><![CDATA[1)]]></kuvatavNr>
          <sisuTekst>
            <tavatekst>lapse andmed;</tavatekst>
          </sisuTekst>
        </alampunkt>
        <alampunkt id="para5lg2p2">
          <alampunktNr>2</alampunktNr>
          <kuvatavNr><![CDATA[2)]]></kuvatavNr>
          <sisuTekst>
            <tavatekst>lapse vanemate andmed ja ühe vanema pangakonto andmed;</tavatekst>
          </sisuTekst>
        </alampunkt>
        <alampunkt id="para5lg2p3">
          <alampunktNr>3</alampunktNr>
          <kuvatavNr><![CDATA[3)]]></kuvatavNr>
          <sisuTekst>
            <tavatekst>vanema kinnitus, et laps ei ole ühegi munitsipaallasteaia või -hoiu nimekirjas ja talle ei ole määratud lapsehoiuteenuse toetust.</tavatekst>
          </sisuTekst>
        </alampunkt>
      </loige>
      <loige id="para5lg3">
        <loigeNr>3</loigeNr>
        <kuvatavNr><![CDATA[(3)]]></kuvatavNr>
        <sisuTekst>
          <tavatekst>Toetuse taotluse vormi kehtestab Tallinna Haridusameti (edaspidi <i>haridusamet</i>) juhataja.</tavatekst>
        </sisuTekst>
      </loige>
    </paragrahv>
    <paragrahv id="para6">
      <paragrahvNr>6</paragrahvNr>
      <kuvatavNr><![CDATA[§ 6.]]></kuvatavNr>
      <paragrahvPealkiri>Toetuse määramine</paragrahvPealkiri>
      <loige id="para6lg1">
        <loigeNr>1</loigeNr>
        <kuvatavNr><![CDATA[(1)]]></kuvatavNr>
        <sisuTekst>
          <tavatekst>Toetuse määramise otsustab haridusameti juhataja või tema volitatud teenistuja.</tavatekst>
        </sisuTekst>
      </loige>
      <loige id="para6lg2">
        <loigeNr>2</loigeNr>
        <kuvatavNr><![CDATA[(2)]]></kuvatavNr>
        <sisuTekst>
          <tavatekst>Toetuse määramise otsust ei vormistata kirjalikult, kui toetuse saamise tingimused on täidetud.</tavatekst>
        </sisuTekst>
      </loige>
      <loige id="para6lg3">
        <loigeNr>3</loigeNr>
        <kuvatavNr><![CDATA[(3)]]></kuvatavNr>
        <sisuTekst>
          <tavatekst>Kui toetuse saamise tingimused ei ole täidetud, siis teeb haridusamet toetuse määramisest keeldumise otsuse. Otsus tehakse 30 kalendripäeva jooksul taotluse esitamisest.</tavatekst>
        </sisuTekst>
      </loige>
      <loige id="para6lg4">
        <loigeNr>4</loigeNr>
        <kuvatavNr><![CDATA[(4)]]></kuvatavNr>
        <sisuTekst>
          <tavatekst>Haridusameti juhatajal või tema volitatud teenistujal
on õigus määrata toetus ka vanemale, kes esitab avalduse ja tõendab, et lapse
teine vanem ei täida ülalpidamiskohustust ega hoolda last. Avalduses esitatud andmeid
on õigus kontrollida Tallinna Haridusametil ning küsimuste korral on
haridusametil õigus küsida vanemalt täiendavaid selgitusi. </tavatekst>
        </sisuTekst>
      </loige>
    </paragrahv>
    <paragrahv id="para7">
      <paragrahvNr>7</paragrahvNr>
      <kuvatavNr><![CDATA[§ 7.]]></kuvatavNr>
      <paragrahvPealkiri>Toetuse maksmine</paragrahvPealkiri>
      <loige id="para7lg1">
        <loigeNr>1</loigeNr>
        <kuvatavNr><![CDATA[(1)]]></kuvatavNr>
        <sisuTekst>
          <tavatekst>Toetust makstakse taotluse esitamisele järgnevast kuust alates. Kui laps on saanud kolmeaastaseks, tehakse viimane makse lapse kolmeaastaseks saamisele järgneval kuul.</tavatekst>
        </sisuTekst>
      </loige>
      <loige id="para7lg2">
        <loigeNr>2</loigeNr>
        <kuvatavNr><![CDATA[(2)]]></kuvatavNr>
        <sisuTekst>
          <tavatekst>Toetuse maksmine lõpetatakse, kui:</tavatekst>
        </sisuTekst>
        <alampunkt id="para7lg2p1">
          <alampunktNr>1</alampunktNr>
          <kuvatavNr><![CDATA[1)]]></kuvatavNr>
          <sisuTekst>
            <tavatekst>laps kantakse munitsipaallasteaia või -hoiu nimekirja;</tavatekst>
          </sisuTekst>
        </alampunkt>
        <alampunkt id="para7lg2p2">
          <alampunktNr>2</alampunktNr>
          <kuvatavNr><![CDATA[2)]]></kuvatavNr>
          <sisuTekst>
            <tavatekst>lapsele määratakse lapsehoiuteenuse toetus;</tavatekst>
          </sisuTekst>
        </alampunkt>
        <alampunkt id="para7lg2p3">
          <alampunktNr>3</alampunktNr>
          <kuvatavNr><![CDATA[3)]]></kuvatavNr>
          <sisuTekst>
            <tavatekst>lapse ja/või mõlema vanema elukohana kantakse rahvastikuregistrisse väljaspool Tallinna linna asuv aadress;</tavatekst>
          </sisuTekst>
        </alampunkt>
        <alampunkt id="para7lg2p4">
          <alampunktNr>4</alampunktNr>
          <kuvatavNr><![CDATA[4)]]></kuvatavNr>
          <sisuTekst>
            <tavatekst>laps on saanud kolmeaastaseks.</tavatekst>
          </sisuTekst>
        </alampunkt>
      </loige>
    </paragrahv>
    <paragrahv id="para8">
      <paragrahvNr>8</paragrahvNr>
      <kuvatavNr><![CDATA[§ 8.]]></kuvatavNr>
      <paragrahvPealkiri>Määruse jõustumine</paragrahvPealkiri>
      <loige id="para8lg1">
        <loigeNr>1</loigeNr>
        <kuvatavNr><![CDATA[(1)]]></kuvatavNr>
        <sisuTekst>
          <tavatekst>Määrus jõustub 1. septembril 2026.</tavatekst>
        </sisuTekst>
      </loige>
      <loige id="para8lg2">
        <loigeNr>2</loigeNr>
        <kuvatavNr><![CDATA[(2)]]></kuvatavNr>
        <sisuTekst>
          <tavatekst>2026. aastal esitatava taotluse puhul peab lapse ja tema vanema(te) elukoht rahvastikuregistri andmetel olema 1. septembril 2026 ja kogu toetuse saamise aja jooksul katkematult Tallinna linn.</tavatekst>
        </sisuTekst>
      </loige>
    </paragrahv>
  </sisu>
