					</muutmismarge>
				</alampunkt>
				<alampunkt id="para3lg1p9">
					<alampunktNr id="bd312dd0-b0a5-4e1c-a3c6-06e8bb1254fe">9</alampunktNr>
					<kuvatavNr id="558cd118-f043-4dce-9df8-1fe335129e23"><![CDATA[9) ]]></kuvatavNr>
					<sisuTekst id="61d857e3-3be7-459b-99c0-2197382f96b0">
						<tavatekst id="eec74235-1bbf-4e17-999c-d0aa5eb55dd8">maamaksukulu, mille arvestamise aluseks on kolmekordne elamualune pind kuni 0,25 eurot ruutmeetri kohta kuus;</tavatekst>
					</sisuTekst>
				</alampunkt>
