						<tavatekst id="f55c1061-1355-41c5-a61f-7bc8f3a5258a">hoonekindlustuse kulu kuni 0,30 eurot eluruumi 1 m<sup>2 </sup>ruutmeetri kohta kuus;</tavatekst>
					</sisuTekst>
				</alampunkt>
				<alampunkt id="para3lg1p11">
