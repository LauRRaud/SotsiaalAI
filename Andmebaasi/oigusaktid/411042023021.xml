						<tavatekst id="244d3e3c-b307-4a4b-b568-bb875ca8eaa7">tegelik olmejäätmete veotasu kuus;</tavatekst>
					</sisuTekst>
				</alampunkt>
				<alampunkt id="para3lg1p12">
					<alampunktNr id="4fafcd26-63c7-403d-a899-c3824d8fb5cb">12</alampunktNr>
