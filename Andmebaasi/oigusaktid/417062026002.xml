			<pealkiri id="52198524-9547-43bb-8b26-11dc3895528a">Sotsiaalteenuste hindade kehtestamine </pealkiri>
		</nimi>
	</aktinimi>
	<sisu id="418de0a4-dc28-4d51-bdf0-655fbad7b2a9">
		
		<preambul id="26111504-1854-443d-be67-a1db25665ee0">
			<tavatekst id="e36e33e8-ce89-422b-8187-1e3607b161ab">Määrus kehtestatakse sotsiaalhoolekande seaduse § 16 ja Kastre Vallavolikogu 18.03.2026 määruse nr 9 “Sotsiaalhoolekandelise abi andmise kord“ alusel.</tavatekst>
		</preambul>
		<paragrahv id="para1">
			<paragrahvNr id="e634b1c9-2697-4af2-b880-c56f2e6e00b3">1</paragrahvNr>
			<kuvatavNr id="5a4190af-1d83-42c1-b99b-0e20d6fb768d"><![CDATA[§ 1. ]]></kuvatavNr>
			<paragrahvPealkiri id="e9addbdb-26b0-4f75-8a13-cfada0820785">Reguleerimisala</paragrahvPealkiri>
			<loige id="para1lg1">
				<loigeNr id="45942723-009d-4623-ab3a-9a6d1a50504e"/>
				<kuvatavNr id="8cf2b19a-b673-4d61-990f-8534005bb78d"/>
				<sisuTekst id="65c4a48b-4d6c-45fa-8f08-66c834523706">
					<tavatekst id="0b313baa-7c53-400a-8a1c-5aa100faa497">Määrusega kehtestatakse sotsiaalteenuste omaosalustasu maksumus.</tavatekst>
				</sisuTekst>
			</loige>
		</paragrahv>
		<paragrahv id="para2">
			<paragrahvNr id="fe07c934-eb7b-4cd9-8b3a-a0f45434aec2">2</paragrahvNr>
			<kuvatavNr id="4cce6ed7-f977-4d92-a32c-ff3f34195f4b"><![CDATA[§ 2. ]]></kuvatavNr>
			<paragrahvPealkiri id="056c9173-f2bc-447a-b2a7-deeeca9b5fe2">Koduabi ja isikuabi pakettide omaosalustasu maksumus</paragrahvPealkiri>
			<loige id="para2lg1">
				<loigeNr id="84f1dc61-2221-4dcc-8242-436f67b2cf8b">1</loigeNr>
				<kuvatavNr id="5a612921-056e-4b17-aea8-be9d90908c0f"><![CDATA[(1)]]></kuvatavNr>
				<sisuTekst id="9a73761f-d86a-432d-a31e-36bd77917b91">
					<tavatekst id="0a3572d9-3d90-4244-a747-a44d545d59b2">Koduabi</tavatekst>
				</sisuTekst>
				<alampunkt id="para2lg1p1">
					<alampunktNr id="7db83605-b2b3-4974-8bee-8a2f076bbeca">1</alampunktNr>
					<kuvatavNr id="105009ab-7f49-46b5-8913-74f0bb964cf4"><![CDATA[1) ]]></kuvatavNr>
					<sisuTekst id="e3833ab4-090b-4e9b-a61a-e586dd9425e2">
						<tavatekst id="bc4acafa-806b-464b-b30d-5b65ac17d7d7">Pakett nr 1 (teenuseid osutatakse üks kord nädalas kestusega kuni 2 tundi nädalas). Paketi maksumus 30 eurot kuus.</tavatekst>
					</sisuTekst>
				</alampunkt>
				<alampunkt id="para2lg1p2">
					<alampunktNr id="682d6e02-71fb-41af-9a0d-f5bb4a7a8d62">2</alampunktNr>
					<kuvatavNr id="71e9b717-610f-46e6-8024-b7713513a78f"><![CDATA[2) ]]></kuvatavNr>
					<sisuTekst id="09a86d8d-071b-46b9-8138-8538a398286e">
						<tavatekst id="a350b549-759c-407d-a4e2-117be532a28d">Pakett nr 2 (teenuseid osutatakse kaks korda nädalas kestusega kuni 4 tundi nädalas). Paketi maksumus 60 eurot kuus.</tavatekst>
					</sisuTekst>
				</alampunkt>
				<alampunkt id="para2lg1p3">
					<alampunktNr id="43a6d428-c82f-4a82-a4dd-d7660f85da30">3</alampunktNr>
					<kuvatavNr id="12211e92-daa8-4089-a2ce-f167c4cbaa31"><![CDATA[3) ]]></kuvatavNr>
					<sisuTekst id="d1444837-95b7-4524-863a-0d5b20f4b333">
						<tavatekst id="05069590-3f72-493f-9c4e-6d51a7d92e5b">Pakett nr 3 (teenuseid osutatakse kolm korda nädalas kestusega kuni 6 tundi nädalas). Paketi maksumus 90 eurot kuus.</tavatekst>
					</sisuTekst>
				</alampunkt>
				<alampunkt id="para2lg1p4">
					<alampunktNr id="38553011-99dd-4887-8796-c88704eeb105">4</alampunktNr>
					<kuvatavNr id="a59c0a80-6b3e-4808-9b92-1d1ca81e00f4"><![CDATA[4) ]]></kuvatavNr>
					<sisuTekst id="9fd2beda-99b8-4d18-a548-574f979f17e6">
						<tavatekst id="d4a83c5d-fbc2-4f7f-8364-5741a3065d00">Pakett nr 4 (teenuseid osutatakse neli korda nädalas kestusega kuni 8 tundi nädalas). Paketi maksumus 120 eurot kuus.</tavatekst>
					</sisuTekst>
				</alampunkt>
				<alampunkt id="para2lg1p5">
					<alampunktNr id="6f8fd8f1-7e83-4725-8628-2fdf946e11e0">5</alampunktNr>
					<kuvatavNr id="fc5aa208-69a7-40c1-a265-483acbfc7158"><![CDATA[5) ]]></kuvatavNr>
					<sisuTekst id="5d0935e4-348b-4c1f-931b-19514338d37d">
						<tavatekst id="71add1a5-cd8c-4862-804f-530380f24d0b">Pakett nr 5 (teenuseid osutatakse viis korda nädalas kestusega kuni 10 tundi nädalas). Paketi maksumus 150 eurot kuus.</tavatekst>
					</sisuTekst>
				</alampunkt>
			</loige>
			<loige id="para2lg2">
				<loigeNr id="a5f309c9-e338-43a8-827e-72ad4a27d158">2</loigeNr>
				<kuvatavNr id="9281b332-04f6-4204-a3c1-cfec8983e428"><![CDATA[(2)]]></kuvatavNr>
				<sisuTekst id="d2e11ba7-3cdb-4be2-bc93-79f6cf44d73a">
					<tavatekst id="182d4a07-83cd-4af3-a4a8-4fac9041aa11">Koduabi maksumus isikule, kelle rahvastikuregistrijärgne elukoht on väljaspool Kastre valda on 15 eurot tund.</tavatekst>
				</sisuTekst>
			</loige>
			<loige id="para2lg3">
				<loigeNr id="bb893c20-d267-49b5-8914-3b8bbe71fd92">3</loigeNr>
				<kuvatavNr id="1bee4769-fe5d-490b-923c-84d7a473c3ae"><![CDATA[(3)]]></kuvatavNr>
				<sisuTekst id="2633e1ac-2b89-4701-a75d-91196b370f7f">
					<tavatekst id="05d32942-333b-496e-871e-30906aafb90e">Isikuabi</tavatekst>
				</sisuTekst>
				<alampunkt id="para2lg3p1">
					<alampunktNr id="5eb63a18-c054-431a-9f3d-b8648b20de4c">1</alampunktNr>
					<kuvatavNr id="2862e0be-197d-4b41-b151-8c0cdaa1951a"><![CDATA[1) ]]></kuvatavNr>
					<sisuTekst id="38cccfd6-dc59-4f00-9b39-661f68d68416">
						<tavatekst id="d510b523-8277-4d66-8f7b-4d2f4b9bd3d6">Pakett nr 6 (teenuseid osutatakse üks kord nädalas kestusega kuni 2 tundi nädalas). Paketi maksumus 60 eurot kuus.</tavatekst>
					</sisuTekst>
				</alampunkt>
				<alampunkt id="para2lg3p2">
					<alampunktNr id="fc2c0605-983d-48dc-9504-f2ecafdb9fe3">2</alampunktNr>
					<kuvatavNr id="5dbeb398-3731-4dc2-b1e3-b4dd9046eaf4"><![CDATA[2) ]]></kuvatavNr>
					<sisuTekst id="04410700-fbd2-4139-9f67-9c7b030cab2d">
						<tavatekst id="37d8c058-bda7-4445-ad4b-bce781a1b49d">Pakett nr 7 (teenuseid osutatakse kaks korda nädalas kestusega kuni 4 tundi nädalas). Paketi maksumus 90 eurot kuus.</tavatekst>
					</sisuTekst>
				</alampunkt>
				<alampunkt id="para2lg3p3">
					<alampunktNr id="ed1c34af-401b-4abf-961a-45b98f35def2">3</alampunktNr>
					<kuvatavNr id="9047a04c-13bf-4752-918a-694aeed73fa6"><![CDATA[3) ]]></kuvatavNr>
					<sisuTekst id="4bd691bd-e281-408e-a6c4-d733ec9364c6">
						<tavatekst id="963692d9-e60c-4520-92a3-c80f1c65c5ad">Pakett nr 8 (teenuseid osutatakse kolm korda nädalas kestusega kuni 6 tundi nädalas). Paketi maksumus 120 eurot kuus.</tavatekst>
					</sisuTekst>
				</alampunkt>
				<alampunkt id="para2lg3p4">
					<alampunktNr id="867fc5d4-9a9b-446e-8d44-6ad356df63d3">4</alampunktNr>
					<kuvatavNr id="eca73711-74fb-49a8-a2b2-d43d230ed5ef"><![CDATA[4) ]]></kuvatavNr>
					<sisuTekst id="b47b6ef2-3988-4b9b-931a-2e89c7380be2">
						<tavatekst id="c3ff7451-d606-447d-bf10-005d07bed670">Pakett nr 9 (teenuseid osutatakse neli korda nädalas kestusega kuni 8 tundi nädalas). Paketi maksumus 150 eurot kuus.</tavatekst>
					</sisuTekst>
				</alampunkt>
				<alampunkt id="para2lg3p5">
					<alampunktNr id="c48be69f-9b61-4c9a-9d37-f8bd71c26af2">5</alampunktNr>
					<kuvatavNr id="b11739c1-9864-4640-a9a4-58a1e2a0ddde"><![CDATA[5) ]]></kuvatavNr>
					<sisuTekst id="0478db0a-66b5-4455-9939-f4ecfeeef2a3">
						<tavatekst id="6178ca90-71c5-4014-ae02-06f6cb949a41">Pakett nr 10 (teenuseid osutatakse viis korda nädalas kestusega kuni 10 tundi nädalas). Paketi maksumus 180 eurot kuus.</tavatekst>
					</sisuTekst>
				</alampunkt>
			</loige>
			<loige id="para2lg4">
				<loigeNr id="5a90b65a-aaec-4c8e-9052-2d568d127bac">4</loigeNr>
				<kuvatavNr id="dc88ecab-1594-4476-a0dd-541a136fb3e8"><![CDATA[(4)]]></kuvatavNr>
				<sisuTekst id="c75df01c-7620-4e35-abe2-bc41735bbe29">
					<tavatekst id="f0af0813-cd4a-4167-b86f-fadc9b7c828c">Isikuabi maksumus isikule, kelle rahvastikuregistrijärgne elukoht on väljaspool Kastre valda on 20 eurot tund.</tavatekst>
				</sisuTekst>
			</loige>
			<loige id="para2lg5">
				<loigeNr id="efe183fc-69ee-4f2b-8b34-925f59faa1ba">5</loigeNr>
				<kuvatavNr id="a71f5aac-a48b-4e0b-9367-1ad328bb6d59"><![CDATA[(5)]]></kuvatavNr>
				<sisuTekst id="a9f830dd-1560-4d51-94d8-29dfa561c241">
					<tavatekst id="20e69fab-e387-401a-b76f-819aa991bd14">Ühekordne koduabi ja isikuabi on 15 eurot tund.</tavatekst>
				</sisuTekst>
			</loige>
		</paragrahv>
		<paragrahv id="para3">
			<paragrahvNr id="c376d629-39ab-4dad-8b04-3460de141ef5">3</paragrahvNr>
			<kuvatavNr id="aa7dc7af-408b-4e73-8aa1-89e9ce4386d5"><![CDATA[§ 3. ]]></kuvatavNr>
			<paragrahvPealkiri id="73e5afe9-7400-4e35-b980-a2077ce957c2">Isikliku abistaja teenuse omaosalustasu maksumus</paragrahvPealkiri>
			<loige id="para3lg1">
				<loigeNr id="d783a5b6-dcd3-4e2e-9b06-0b7016e78fca"/>
				<kuvatavNr id="b2b23e2d-b763-4c88-9a00-3cd35b6e0b2c"/>
				<sisuTekst id="e42de013-fd9d-473d-a5de-ea89eab996cb">
					<tavatekst id="51a3c85e-b26a-4e13-bbdc-d9de06fdaab7">Isikliku abistaja teenuse maksumus on 0.30 eurot ühe teenustunni eest.</tavatekst>
				</sisuTekst>
			</loige>
		</paragrahv>
		<paragrahv id="para4">
			<paragrahvNr id="f920e21b-71cf-48f1-86ea-dd26e8a2f5e0">4</paragrahvNr>
			<kuvatavNr id="6c6a6976-cdfa-48f2-9e86-bee482835efd"><![CDATA[§ 4. ]]></kuvatavNr>
			<paragrahvPealkiri id="a0456c53-c25e-4c6d-ae88-96bba2a522d6">Sotsiaaltransporditeenuse omaosaluse maksumus</paragrahvPealkiri>
			<loige id="para4lg1">
				<loigeNr id="7127b2c8-5a9f-4c3c-a3c8-6cbc16f10300">1</loigeNr>
				<kuvatavNr id="1822b7ef-f7d2-4a0c-80ef-834febe30317"><![CDATA[(1)]]></kuvatavNr>
				<sisuTekst id="f8d24f52-a5e1-4870-8764-616704beeeac">
					<tavatekst id="19e9015a-2d77-49cb-a597-bc685515af3b">Sotsiaaltranspordi kasutaja omaosalus kasutuskorra kohta:</tavatekst>
				</sisuTekst>
				<alampunkt id="para4lg1p1">
					<alampunktNr id="97e8afc0-0579-4fbe-bd94-acc99c1769da">1</alampunktNr>
					<kuvatavNr id="d2581e78-94a6-4950-8983-093c47828cac"><![CDATA[1) ]]></kuvatavNr>
					<sisuTekst id="c039337d-b0c8-46f3-8fd0-63b852bd4265">
						<tavatekst id="74a2a834-a2a1-4c00-ac7d-eb5a078046fc">Kastre valla piires – 1/3 sotsiaaltransporditeenuse maksumusest;</tavatekst>
					</sisuTekst>
				</alampunkt>
				<alampunkt id="para4lg1p2">
					<alampunktNr id="09bf576b-2030-4c67-b16b-f462cf6b44db">2</alampunktNr>
					<kuvatavNr id="341ad67a-cfc0-4fe3-9ce4-17fbe5f75d5d"><![CDATA[2) ]]></kuvatavNr>
					<sisuTekst id="af95b00b-d2db-4f6c-8994-8314e918f41d">
						<tavatekst id="05e853aa-a9bf-48f4-ab14-519ed82c0876">Tartu maakonna piires – 1/4 sotsiaaltransporditeenuse maksumusest;</tavatekst>
					</sisuTekst>
				</alampunkt>
				<alampunkt id="para4lg1p3">
					<alampunktNr id="508e9eaa-690e-47b1-b15b-014b1f2adea0">3</alampunktNr>
					<kuvatavNr id="336e6e71-522e-4e52-8ffb-42c826cc87a3"><![CDATA[3) ]]></kuvatavNr>
					<sisuTekst id="0f8b30aa-6d77-488c-8888-84bc5a333c2f">
						<tavatekst id="54fbc194-0f4b-43d6-9b66-ad892a909bf4">Eesti Vabariigi piires – 1/4 sotsiaaltransporditeenuse maksumusest.</tavatekst>
					</sisuTekst>
				</alampunkt>
			</loige>
			<loige id="para4lg2">
				<loigeNr id="28279d52-f1c2-4883-9d77-af4422794cc9">2</loigeNr>
				<kuvatavNr id="59659393-56f2-45d5-9dc6-209346c6e9d4"><![CDATA[(2)]]></kuvatavNr>
				<sisuTekst id="6fa669f3-772d-4c9b-92a8-73e03c68fccd">
					<tavatekst id="60822046-4eea-49db-b540-c767dad9e58a">Sotsiaaltransporditeenuse maksumus isikule, kelle rahvastikuregistrijärgne elukoht on väljaspool Kastre valda rakendub teenuse eest tasumisel sotsiaaltransporditeenuse osutaja poolt esitatud hinnakirjajärgne maksumus täies ulatuses.</tavatekst>
				</sisuTekst>
			</loige>
		</paragrahv>
		<paragrahv id="para5">
			<paragrahvNr id="7af7ec58-e6a3-4aad-a622-597b98770fee">5</paragrahvNr>
			<kuvatavNr id="abd1be7b-b099-4d79-afd7-f4a215372596"><![CDATA[§ 5. ]]></kuvatavNr>
			<paragrahvPealkiri id="dc48bf2d-c55a-4b35-bcc5-26d908f6636d">Eluruumi tagamise teenuse omaosaluse maksumus</paragrahvPealkiri>
			<loige id="para5lg1">
				<loigeNr id="0b41e9cf-803d-4b99-8219-02472047de9b">1</loigeNr>
				<kuvatavNr id="e2505334-6824-4236-9467-ffe47f969ce4"><![CDATA[(1)]]></kuvatavNr>
				<sisuTekst id="99756e4a-53b2-4701-b31a-ea39e5e1b491">
					<tavatekst id="0498db4b-37b0-4849-b887-e054ba34eb1b">Sotsiaaleluruumide üürihinnad</tavatekst>
				</sisuTekst>
				<alampunkt id="para5lg1p1">
					<alampunktNr id="c4e8ac95-f283-43e1-896a-671453b371c3">1</alampunktNr>
					<kuvatavNr id="24515f78-29b3-4c6c-8442-284629d737d5"><![CDATA[1) ]]></kuvatavNr>
					<sisuTekst id="56ebdf69-fb3d-42d8-b264-132c3ea60c3b">
						<tavatekst id="2378da6c-4828-43f5-860c-734270861306">Mugavusteta eluruumi üüri hind 1.5 eurot m² kohta kuus;</tavatekst>
					</sisuTekst>
				</alampunkt>
