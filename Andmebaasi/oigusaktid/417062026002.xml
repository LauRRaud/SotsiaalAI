					<tavatekst id="3182233b-3e1b-41ed-824c-552f2837baf9">Isikliku hügieeni tagamise teenus (dušiteenus) 3 eurot.</tavatekst>
				</sisuTekst>
			</loige>
			<loige id="para10lg4">
				<loigeNr id="3dfd28ef-1cbf-45b7-8321-0ac50761330c">4</loigeNr>
				<kuvatavNr id="f5616817-6e57-423c-b4b3-3d185180dda3"><![CDATA[(4)]]></kuvatavNr>
				<sisuTekst id="a2613506-d825-4de9-b7aa-a8f4e9abdfd0">
					<tavatekst id="a3de8b0f-7b20-440f-965c-1642bad5be2c">Poka Sotsiaalteenuste keskuse päevahoiuteenuse ja sotsiaalmajutusteenuse raames osutatav toitlustusteenus</tavatekst>
				</sisuTekst>
				<alampunkt id="para10lg4p1">
