					<tavatekst id="127a7f5a-0f92-4b10-bf51-f041a5b94655">Pesukuivati teenus (1 masinatäis) 2 eurot.</tavatekst>
				</sisuTekst>
			</loige>
			<loige id="para10lg3">
				<loigeNr id="e30cea89-997f-4d9d-9e10-86f910fa3287">3</loigeNr>
