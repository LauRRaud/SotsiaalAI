    <tavatekst id="1aafe065-40e7-4154-bdf4-737a412ec895">kui ta ei täida lepinguga endale võetud kohustusi ja ei pea kinni kehtestatud kodukorrast;</tavatekst>
   </sisuTekst>
  </alampunkt><alampunkt id="para13lg1p2">
   <alampunktNr id="7eb28da3-eaf4-4ca4-b3a3-79ea531034f9">2</alampunktNr>
