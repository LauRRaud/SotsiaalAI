   <kuvatavNr id="a7f4fcaf-539b-4335-817e-69216e2588b7"><![CDATA[(1)]]></kuvatavNr>
   <sisuTekst id="d2111d43-5d7e-4fc6-90f7-efb22d20dac7">
    <tavatekst id="566e06bb-434f-4737-b0ea-8988cf5e1f4f">Rapla Vallavalitsus võib taotleda kohta teistesse hoolekandeasutustesse § 2 lõikes 1 nimetatud isikule juhul, kui hooldekeskuses ei ole vabu kohti.</tavatekst>
   </sisuTekst>
  </loige><loige id="para14lg2">
