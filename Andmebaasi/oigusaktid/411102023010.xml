		<nimi id="9c07e1dc-8acb-4f8c-a980-847c00aa480a">
			<pealkiri id="7d922015-8d0a-4515-a732-4c2854f93d2a">Sotsiaaleluruumi kasutamise kord </pealkiri>
		</nimi>
	</aktinimi>
	<muutmismarge id="674e3406-cffc-4b8a-ad85-44bb0ef50ffe">
		<aktikuupaev id="6dbae84f-7081-45bf-b9da-f7a75abf6ba8">2023-10-06</aktikuupaev>
		<avaldamismarge id="aec3a8e7-101c-4c97-9709-f8bffe3774ea">
			<RTosa id="40958a6f-4c0f-404d-a10a-b9957151297e">RT IV</RTosa>
			<avaldamineKuupaev id="01617dc1-6826-44f7-a558-567bc713829c">2023-10-11</avaldamineKuupaev>
			<RTartikkel id="dc00404c-a55f-4435-8a4c-e4821591fcc9">8</RTartikkel>
