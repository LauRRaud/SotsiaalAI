			<ametinimetus id="1375582c-c53f-4bc5-bdad-50a7d7f83884">volikogu esimees</ametinimetus>
			<eesnimi id="45470529-0ec0-4adc-bae5-e76e0197704e">Ene</eesnimi>
			<perekonnanimi id="6eff694f-5771-4ef6-b613-1e7314809df8">Preem</perekonnanimi>
		</allkirjastaja>
