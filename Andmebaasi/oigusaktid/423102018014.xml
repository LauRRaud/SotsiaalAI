   <paragrahvPealkiri id="0207f78b-1caf-4956-91f2-907ba4ad7696">Määruse jõustumine</paragrahvPealkiri>
  <loige id="para17lg1">
   <loigeNr id="d14156fb-6096-40d3-ab16-f90c947c2109"/>
   <kuvatavNr id="199a0753-f5d9-478b-b3ca-79494ea06b6d"/>
   <sisuTekst id="e1fbfe5c-61f8-41d0-9cc1-6c3f5a72fbde">
    <tavatekst id="0ba98dbf-6ed0-4e2d-ac6f-90fc2c2b9b06">Määrus jõustub kolmandal päeval pärast Riigi Teatajas avaldamist.</tavatekst>
   </sisuTekst>
