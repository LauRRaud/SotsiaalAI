			<kuvatavNr id="702fe5ab-e9a2-4a8b-9639-fda833a81640"><![CDATA[3. peatükk]]></kuvatavNr>
			<peatykkPealkiri id="818e7ed5-c5b5-49e5-ac91-bc1f7a7a09f7">Toetuse taotlemine, määramine ja maksmine</peatykkPealkiri>
			<paragrahv id="para9">
				<paragrahvNr id="4e6fac84-0f11-44ec-8205-1ca2bde7c627">9</paragrahvNr>
				<kuvatavNr id="087e2f12-420a-42ce-8602-8543b078702a"><![CDATA[§ 9. ]]></kuvatavNr>
				<paragrahvPealkiri id="5fa291b5-df1f-4dcb-a90e-6ea61f8ba96c">Toetuse taotlemine</paragrahvPealkiri>
				<loige id="para9lg1">
					<loigeNr id="1a9a713f-589c-49ad-b341-beeb269c2133">1</loigeNr>
					<kuvatavNr id="1fc467ff-6c85-4956-97b5-127ab8c35981"><![CDATA[(1)]]></kuvatavNr>
					<sisuTekst id="117e5c74-258a-4513-8dc8-bd5d6f156470">
						<tavatekst id="a43d832b-f109-4e4f-9aa6-b443c6e8823c">Toetuse taotleja esitab vallavalitsusele kirjaliku taotluse. Taotluses märgitakse järgmised andmed:</tavatekst>
					</sisuTekst>
					<alampunkt id="para9lg1p1">
						<alampunktNr id="60d1d700-735f-4556-9621-b199fa286dd0">1</alampunktNr>
						<kuvatavNr id="237b6627-395b-4b47-a338-4cda548a32b7"><![CDATA[1) ]]></kuvatavNr>
						<sisuTekst id="7d706a14-7618-4f6d-93a0-d0adb68d2870">
							<tavatekst id="8e9216c7-ef2c-433a-ae83-51ae39354d11">taotleja ees- ja perekonnanimi ning isikukood;</tavatekst>
						</sisuTekst>
					</alampunkt>
					<alampunkt id="para9lg1p2">
						<alampunktNr id="1ac6be4e-ec45-4b6c-adaa-89609f02efa3">2</alampunktNr>
						<kuvatavNr id="386f4b47-e323-4c37-9ea7-b73cb0d2a98c"><![CDATA[2) ]]></kuvatavNr>
						<sisuTekst id="a2c1eb3e-e443-4e9b-87e0-74778590efc0">
							<tavatekst id="e52d7f0d-bcf3-4daf-b72f-b5fe9ab483ef">taotleja elukoht;</tavatekst>
						</sisuTekst>
					</alampunkt>
					<alampunkt id="para9lg1p3">
						<alampunktNr id="33782a2e-b3cf-46f6-b43d-0ca336dbab4d">3</alampunktNr>
						<kuvatavNr id="ceff49cb-724f-4d3c-bed4-f7f162b9b93a"><![CDATA[3) ]]></kuvatavNr>
						<sisuTekst id="cddb80e6-66d3-4e85-8924-e6a698044a6e">
							<tavatekst id="11992976-3544-4c37-9db6-4e508aa1a4a7">taotleja kontaktandmed (aadress, telefon, elektronposti aadress);</tavatekst>
						</sisuTekst>
					</alampunkt>
					<alampunkt id="para9lg1p4">
						<alampunktNr id="898345bb-4c42-42d2-bee8-c85d91730ae7">4</alampunktNr>
						<kuvatavNr id="4d04f88e-c329-4886-949f-446b5f867201"><![CDATA[4) ]]></kuvatavNr>
						<sisuTekst id="16282dd4-0905-404f-96b1-79b53e983988">
							<tavatekst id="268a9f35-2e3d-4cbf-893a-a1b6a76dc874">pangakonto number;</tavatekst>
						</sisuTekst>
					</alampunkt>
					<alampunkt id="para9lg1p5">
						<alampunktNr id="a3ae8b77-fb67-4e98-94d0-5176eb7b8a80">5</alampunktNr>
						<kuvatavNr id="cebd2a42-b302-42a7-a6b1-b7c615103c1e"><![CDATA[5) ]]></kuvatavNr>
						<sisuTekst id="b327b1ee-0f03-4400-bcbb-3f3eee138f22">
							<tavatekst id="f9d6e825-c80b-40c1-9287-421da1dc0d0b">taotluse esitamise kuupäev ja allkiri.</tavatekst>
						</sisuTekst>
					</alampunkt>
				</loige>
				<loige id="para9lg2">
					<loigeNr id="d92a854c-5742-4d8b-990f-b4298fde0eb7">2</loigeNr>
					<kuvatavNr id="2040431a-96f5-4453-8a92-7063f716aafa"><![CDATA[(2)]]></kuvatavNr>
					<sisuTekst id="32896adb-0e95-4177-a1c0-c73ea7f329b2">
						<tavatekst id="d4f99896-00be-4735-b727-e818f3e32d59">Määruse paragrahvi 8 lõikes 1 nimetatud toetuse saamiseks taotlust ei esitata.</tavatekst>
					</sisuTekst>
				</loige>
			</paragrahv>
			<paragrahv id="para10">
				<paragrahvNr id="620c1ab2-c668-4fb8-91c4-87c32b8d4211">10</paragrahvNr>
				<kuvatavNr id="d07965bf-2de6-4c11-aa51-6423a17a6d4a"><![CDATA[§ 10. ]]></kuvatavNr>
				<paragrahvPealkiri id="6dc3ca27-4830-41dd-af91-cc846a70cd0b">Toetuse määramine</paragrahvPealkiri>
				<loige id="para10lg1">
					<loigeNr id="d66fee57-8b06-49d6-8b3e-a1cb572af641">1</loigeNr>
					<kuvatavNr id="d76c0de6-75aa-4792-8b46-9330dca45f40"><![CDATA[(1)]]></kuvatavNr>
					<sisuTekst id="65d17cc9-b87b-425b-8f69-2dcbe93dbdef">
						<tavatekst id="9f23f439-7ce5-41ac-991f-57d0ba22a570">Otsuse toetuse määramise või määramisest keeldumise kohta teeb volitatud ametnik 30 kalendripäeva jooksul nõuetekohase taotluse esitamisest.</tavatekst>
					</sisuTekst>
				</loige>
				<loige id="para10lg2">
					<loigeNr id="3b9610b0-e242-4acd-8d73-94cb7e4e17a5">2</loigeNr>
					<kuvatavNr id="49df5114-4245-4578-b03a-c205966fc130"><![CDATA[(2)]]></kuvatavNr>
					<sisuTekst id="657583da-0334-4324-a767-b7d67c6df37a">
						<tavatekst id="f3130362-bad5-4f9e-8814-f258217c416b">Toetuse määramisest võib keelduda juhul, kui esineb vähemalt üks järgmistest asjaoludest:</tavatekst>
					</sisuTekst>
					<alampunkt id="para10lg2p1">
						<alampunktNr id="e0493f7c-b379-475b-850a-d2370926e14c">1</alampunktNr>
						<kuvatavNr id="2ed7c7af-36ba-4e81-ba1f-7247df1cbd3a"><![CDATA[1) ]]></kuvatavNr>
						<sisuTekst id="b208de20-4494-41f8-97a5-c7e4059c79dc">
							<tavatekst id="da150228-2ad4-4860-bee6-e35d8ff56860">vallavalitsusele ei ole esitatud kõiki teadaolevaid tõeseid ja täielikke andmed, dokumente ja muid tõendeid, mis on vajalikud toetuse määramise otsustamisel;</tavatekst>
						</sisuTekst>
					</alampunkt>
					<alampunkt id="para10lg2p2">
						<alampunktNr id="843ef078-5719-4f0e-9dc4-5102ff2b9c1f">2</alampunktNr>
						<kuvatavNr id="d0d41ddd-850f-474c-b450-9d6618308cce"><![CDATA[2) ]]></kuvatavNr>
						<sisuTekst id="1acb0f67-5235-4e2f-a188-483ed270e763">
							<tavatekst id="6cfb2522-cbb2-4b6e-8ebd-58f21e725c0c">taotleja ei võimalda toetuse vajadust kontrollida;</tavatekst>
						</sisuTekst>
					</alampunkt>
					<alampunkt id="para10lg2p3">
						<alampunktNr id="aa6d4e9a-abcc-44f3-ba72-a92d0f9137ae">3</alampunktNr>
						<kuvatavNr id="2e44b941-ccb3-4161-81cd-16c60994a5c8"><![CDATA[3) ]]></kuvatavNr>
						<sisuTekst id="44355deb-c0ef-4722-8f41-b5811200f2e2">
							<tavatekst id="487fe781-c571-402d-89cf-da96bc4ac5d1">taotleja ei ole teavitanud vallavalitsust viivitamata toetuse saamise õigust ja toetuse määramist mõjutavatest asjaoludest ja asjaolude muutumisest.</tavatekst>
						</sisuTekst>
					</alampunkt>
				</loige>
			</paragrahv>
			<paragrahv id="para11">
				<paragrahvNr id="af106e4b-b7b4-498e-a3de-03c1a9a8b08c">11</paragrahvNr>
				<kuvatavNr id="cf21b033-d16d-428c-b033-24a518c220ff"><![CDATA[§ 11. ]]></kuvatavNr>
				<paragrahvPealkiri id="b9967494-1778-4cc5-ae0a-6714874874a9">Toetuse maksmine</paragrahvPealkiri>
				<loige id="para11lg1">
					<loigeNr id="e1fa3e34-c332-444c-9f94-213c109d260d">1</loigeNr>
					<kuvatavNr id="2d0da6a1-3a15-4863-b08e-5f2777cdbe66"><![CDATA[(1)]]></kuvatavNr>
					<sisuTekst id="3b88d1e7-1c98-40fc-b4ca-0dffb56cdf75">
						<tavatekst id="d20e7e64-e7be-404b-983e-721d729e92a0">Toetus makstakse välja 30 kalendripäeva jooksul toetuse andmise otsuse tegemisest arvates taotluses näidatud arvelduskontole või erandjuhul sularahas.</tavatekst>
					</sisuTekst>
				</loige>
				<loige id="para11lg2">
					<loigeNr id="356216ac-edfb-44d0-8e5b-44387a3f4d8f">2</loigeNr>
					<kuvatavNr id="cffc6cdb-4f73-4d8f-aa10-236a353924bb"><![CDATA[(2)]]></kuvatavNr>
					<sisuTekst id="5f7114f9-faa5-4152-81f4-09a3e67504e6">
						<tavatekst id="69d2002e-f4ae-40bf-9123-7d22a764ff62">Toetuse võib kanda kolmanda isiku arvelduskontole toetuse saaja kirjaliku taotluse alusel.</tavatekst>
					</sisuTekst>
				</loige>
			</paragrahv>
			<paragrahv id="para12">
				<paragrahvNr id="c2dd36b8-acc4-445b-9a8b-d5980679f3ce">12</paragrahvNr>
				<kuvatavNr id="e2870616-6516-4a13-84e4-850379d4ef40"><![CDATA[§ 12. ]]></kuvatavNr>
				<paragrahvPealkiri id="91bf7865-394b-4c67-b611-c88f4494a8da">Alusetult saadud toetuse tagasinõudmine</paragrahvPealkiri>
				<loige id="para12lg1">
					<loigeNr id="1dc2203d-aa0b-4396-beae-c76fb709a170"/>
					<kuvatavNr id="f7c1c42d-0066-4f28-9e26-97cc35d72fec"/>
					<sisuTekst id="53384070-52cc-42eb-aef5-036171304035">
						<tavatekst id="e8e95d9c-9512-49b4-9200-1a676330eaf0">Alusetult saadud toetus makstakse tagasi vabatahtlikult või nõutakse toetuse saajalt tagasi.</tavatekst>
					</sisuTekst>
				</loige>
			</paragrahv>
		</peatykk>
