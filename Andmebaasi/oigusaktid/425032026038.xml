				<kuvatavNr id="1ff2facc-194d-4395-95da-adc8e8d15e45"><![CDATA[§ 13. ]]></kuvatavNr>
				<paragrahvPealkiri id="88219ffc-69de-40c1-a492-0bf201e8fdab">Dokumendivormide kinnitamine</paragrahvPealkiri>
				<loige id="para13lg1">
					<loigeNr id="a86a93b3-dcc9-410d-b297-d392d54c04a6"/>
