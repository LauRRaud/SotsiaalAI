					<sisuTekst id="c54ed160-faf8-4f9d-975f-f508db8aaefc">
						<tavatekst id="4173e4fe-f180-4d12-8f2d-feab3fcac63f">Määruse rakendamiseks vajalike dokumentide vormid kinnitab vallavalitsus.</tavatekst>
					</sisuTekst>
				</loige>
			</paragrahv>
