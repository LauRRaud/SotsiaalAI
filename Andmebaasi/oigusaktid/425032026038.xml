					<sisuTekst id="984a90a1-6f91-4c96-b73b-834ee8b458ac">
						<tavatekst id="b6c8ecf5-3ac2-49c1-8cc9-3863897b64d1">Toetust makstakse kahes võrdses osas:</tavatekst>
					</sisuTekst>
					<alampunkt id="para5lg3p1">
						<alampunktNr id="d5b72cf7-adde-409c-a9f9-b70db715c796">1</alampunktNr>
						<kuvatavNr id="f312b01d-b77b-4d4f-8209-51660f5843ad"><![CDATA[1) ]]></kuvatavNr>
						<sisuTekst id="8b4f9fe3-8b7c-41dd-b37f-e15a73c2fe67">
							<tavatekst id="43e2ebf3-033f-4259-a31d-28911f41db1e">esimene osa makstakse pärast lapse sünni registreerimist;</tavatekst>
						</sisuTekst>
					</alampunkt>
					<alampunkt id="para5lg3p2">
						<alampunktNr id="8820665f-ee7b-43a4-91ff-9277e683a371">2</alampunktNr>
						<kuvatavNr id="1a6cc721-5fd0-461b-8965-a5b46bd46811"><![CDATA[2) ]]></kuvatavNr>
						<sisuTekst id="316415e8-cee7-4693-8f58-dd384816d475">
							<tavatekst id="fc2153d6-45c9-4f97-a4c6-9b25e09f4f55">teine osa makstakse lapse 1,5-aastaseks saamisel.</tavatekst>
						</sisuTekst>
						<muutmismarge id="05415f5c-1bee-4425-8b27-902a86d05617">
							<avaldamismarge id="9bb182e3-74ac-4ee1-a740-01e226b169c8">
								<RTosa id="422e8e44-314b-47ba-b4fc-5d1ba637b2a9">RT IV</RTosa>
								<avaldamineKuupaev id="ceb7d4f0-57f0-41bb-b800-7ee1718b43d8">2026-03-25</avaldamineKuupaev>
								<RTartikkel id="44ac3815-1f32-4323-b710-f7a42e43e551">9</RTartikkel>
								<aktViide id="3c211eec-e944-4245-82c7-08c4ff96fcbb">425032026009</aktViide>
							</avaldamismarge>
							<joustumine id="64161fb7-d40f-4ab2-a502-e93f4ca5d83b">2026-03-28</joustumine>
						</muutmismarge>
					</alampunkt>
				</loige>
				<loige id="para5lg4">
					<loigeNr id="9bc58d6c-8970-489f-8870-09cf1dc7f2df">4</loigeNr>
					<kuvatavNr id="cf4d62e8-eb03-478c-bc0f-0533c5ed3125"><![CDATA[(4)]]></kuvatavNr>
					<sisuTekst id="a2d1195b-af60-47ce-abeb-9fae4f337ed8">
						<tavatekst id="29c3f990-4b02-48e1-9d4d-12a4077f0c25">Mitmikute sünni korral makstakse sünnitoetust iga lapse eest.</tavatekst>
					</sisuTekst>
				</loige>
				<loige id="para5lg5">
					<loigeNr id="b6f7a8c6-3d37-4767-b8fe-175372522f09">5</loigeNr>
					<kuvatavNr id="3c10c6b0-b097-4d5f-ac68-89b443ee4a24"><![CDATA[(5)]]></kuvatavNr>
					<sisuTekst id="67ee1723-9249-4ec1-8c39-78870860b95b">
						<tavatekst id="f5b0517c-e6dd-4b6b-a083-5c7a460a43a1">Toetust ei määrata, kui laps on riiklikul ülalpidamisel.</tavatekst>
					</sisuTekst>
				</loige>
				<loige id="para5lg6">
					<loigeNr id="d72cec30-6e48-4151-b63b-8b47716bd794">6</loigeNr>
					<kuvatavNr id="c3470b67-bc06-4e3f-babe-8b0631584952"><![CDATA[(6)]]></kuvatavNr>
					<sisuTekst id="2257c912-1044-4c03-a951-20181c4d9e5c">
						<tavatekst id="37c8bb05-c795-4fa6-9de4-607ec366ce89">Toetuse esimest osa on õigus taotleda kolme kuu jooksul peale sünni registreerimist rahvastikuregistris, toetuse teist osa kolme kuu jooksul peale lapse 1-aastaseks saamist.</tavatekst>
					</sisuTekst>
					<muutmismarge id="23bedf85-458f-47c9-920f-158edd26fde6">
						<avaldamismarge id="5faa382b-41c2-47f5-9fe1-5a9a2f48bb7e">
							<RTosa id="bad297fb-facd-4692-9302-00fa49028f1f">RT IV</RTosa>
							<avaldamineKuupaev id="925c67b0-6540-4744-9ad3-063e7666e041">2020-09-04</avaldamineKuupaev>
							<RTartikkel id="17bee857-cb1c-433c-8ad5-b2d665e141d9">3</RTartikkel>
							<aktViide id="3074275f-645b-4c06-bce7-bef9ed3a0e57">404092020003</aktViide>
						</avaldamismarge>
						<joustumine id="4ca0cb70-1f21-498b-bebf-748c30d1608d">2020-09-15</joustumine>
					</muutmismarge>
				</loige>
				<loige id="para5lg7">
					<loigeNr id="86548a98-f8bb-4276-9548-c0443abbc510">7</loigeNr>
					<kuvatavNr id="f864704d-4314-4d1c-b376-678ea9e13579"><![CDATA[(7)]]></kuvatavNr>
					<sisuTekst id="3904b471-9907-4945-b100-4deea6589f44">
						<tavatekst id="4b50763a-35a8-4850-8be7-b95dea29f7cb">Toetus makstakse välja juhul, kui lapse eest ei ole saadud sünnitoetust teisest kohalikust omavalitsusest.</tavatekst>
					</sisuTekst>
					<muutmismarge id="cfef98d9-d895-4025-a455-04ab3dfd8fa7">
						<avaldamismarge id="4f39e10b-91af-44fa-87cb-498113e34adf">
							<RTosa id="a4fed88d-298b-461d-bc00-fded4400a39a">RT IV</RTosa>
							<avaldamineKuupaev id="a92e118c-7863-4169-bb9e-a1f5783f8b8d">2020-09-04</avaldamineKuupaev>
							<RTartikkel id="2ac4e34e-32df-4827-a578-119fa3edcbf6">3</RTartikkel>
							<aktViide id="ef8766d6-15b1-4789-b4f5-a742b510f2bd">404092020003</aktViide>
						</avaldamismarge>
						<joustumine id="00563d8e-0915-4365-967f-dc7766ddf200">2020-09-15</joustumine>
					</muutmismarge>
				</loige>
			</paragrahv>
			<paragrahv id="para6">
				<paragrahvNr id="f47d5d54-2326-4b5e-8763-ff101beaf47c">6</paragrahvNr>
				<kuvatavNr id="92d59d7c-c5dd-4d82-bc6b-a32625b08784"><![CDATA[§ 6. ]]></kuvatavNr>
				<paragrahvPealkiri id="371eac9c-6264-4faf-9c78-5ce716a2eaf3">Matusetoetus</paragrahvPealkiri>
				<loige id="para6lg1">
					<loigeNr id="d27871e7-b151-409e-a903-61f6d6865270">1</loigeNr>
					<kuvatavNr id="395b42eb-d60f-4593-bea6-a0c5e8ad0de7"><![CDATA[(1)]]></kuvatavNr>
					<sisuTekst id="c0608a43-e2f1-47f7-bd65-120003850ac7">
						<tavatekst id="55f518af-75e8-468a-b5ec-6a386f460e0c">Toetust makstakse:</tavatekst>
					</sisuTekst>
					<alampunkt id="para6lg1p1">
						<alampunktNr id="eddf3b05-a255-45a8-a9c1-506e8f351e91">1</alampunktNr>
						<kuvatavNr id="0aa5334c-0bce-4c23-a032-2f32d77bb5e7"><![CDATA[1) ]]></kuvatavNr>
						<sisuTekst id="a93b8b20-d011-4af6-baef-e5635e365d50">
							<tavatekst id="e1898ae5-af4a-4e40-938e-8c32c6ffccb7">surma hetkel rahvastikuregistri andmetel Põlva vallas elanud isiku surma korral matuse korraldajale või;</tavatekst>
						</sisuTekst>
					</alampunkt>
					<alampunkt id="para6lg1p2">
						<alampunktNr id="25ab7080-4732-4fac-bc51-f81b414b4d65">2</alampunktNr>
						<kuvatavNr id="38c42e6d-4bbb-4a39-8822-286606d7aa5a"><![CDATA[2) ]]></kuvatavNr>
						<sisuTekst id="616ae023-7818-4a92-8022-ee8f68927827">
							<tavatekst id="c540456e-9092-4fb9-8d18-9cba7348aab9">erandkorras matuse korraldajale, kes on rahvastikuregistri andmetel Põlva valla elanik ning kes taotleb toetust isiku matmise kuludeks, kellel puudus rahvastikujärgne elukoht või kelle eest ei ole saadud matusetoetust teisest kohalikust omavalitsusest.</tavatekst>
						</sisuTekst>
						<muutmismarge id="696c4128-5da9-4f73-9a68-5b03f0e0f860">
							<avaldamismarge id="7e61f379-add7-4d26-aee2-02131bc6fc63">
								<RTosa id="7bb9f934-1d49-460e-9abf-6e9fa3a0adea">RT IV</RTosa>
								<avaldamineKuupaev id="58afd9a1-9468-471b-a9f5-44c0108a6df6">2019-03-27</avaldamineKuupaev>
								<RTartikkel id="dfc48554-1cc1-4b71-9d96-ba79e8928245">3</RTartikkel>
								<aktViide id="696118bc-a5a9-46f2-820d-6d0d5956c660">427032019003</aktViide>
							</avaldamismarge>
							<joustumine id="98c0dd8d-e53e-4b92-8343-e77c08a08d79">2019-04-01</joustumine>
						</muutmismarge>
					</alampunkt>
				</loige>
				<loige id="para6lg2">
					<loigeNr id="7dc09b73-6aa4-47da-9f58-eda15b5b259f">2</loigeNr>
					<kuvatavNr id="d5170be3-0bc4-4780-abf4-545b4ada76e7"><![CDATA[(2)]]></kuvatavNr>
					<sisuTekst id="a1ab29aa-1135-4b4a-9fa0-01bc28609ae5">
						<tavatekst id="7dd7313c-c0a4-4954-a7d9-820667574f78">Toetuse taotlemisel esitatakse taotlus.</tavatekst>
					</sisuTekst>
					<muutmismarge id="5560eabf-4bc1-49a3-93ea-18d5ef7af9a1">
						<avaldamismarge id="2599299c-a9f0-469c-9df6-c38db9951eda">
							<RTosa id="0d1a72a9-81ef-41cf-80cb-fcd8704d9dc4">RT IV</RTosa>
							<avaldamineKuupaev id="d75d3248-7bda-4f5b-9b04-00e9c20e4202">2019-08-29</avaldamineKuupaev>
							<RTartikkel id="b12be1f8-1b50-4c09-a1ae-1277f55c2075">2</RTartikkel>
							<aktViide id="bd6e0904-0008-4a6f-9166-8886786a5d48">429082019002</aktViide>
						</avaldamismarge>
						<joustumine id="78bd1aa9-9897-48af-a4de-e4ad54ef1868">2019-09-01</joustumine>
					</muutmismarge>
				</loige>
				<loige id="para6lg3">
					<loigeNr id="69033dbc-6456-4083-adb1-07444b33bd4e">3</loigeNr>
					<kuvatavNr id="9c54f2ce-abfa-451f-ac6c-18b1bd105e8b"><![CDATA[(3)]]></kuvatavNr>
					<sisuTekst id="341aa129-708c-4657-879e-5a816fb794f6">
						<tavatekst id="01c6c482-5588-493a-8434-d4d4bf86e758">Toetust on õigus taotleda kolme kuu jooksul peale surma registreerimist rahvastikuregistris.</tavatekst>
					</sisuTekst>
				</loige>
			</paragrahv>
			<paragrahv id="para7">
				<paragrahvNr id="e5d0a4b9-b3e3-475f-a588-58586c92e1b3">7</paragrahvNr>
				<kuvatavNr id="1be6939d-51ce-4d62-bb4e-df7d99b41013"><![CDATA[§ 7. ]]></kuvatavNr>
				<paragrahvPealkiri id="6338694d-08d7-44c2-8e3e-750b98114bf1">Esimesse klassi astuja toetus</paragrahvPealkiri>
				<loige id="para7lg1">
					<loigeNr id="4a1fcbfb-ebb1-4732-9173-86b36fda81c5">1</loigeNr>
					<kuvatavNr id="75ddc355-2876-4db7-a227-2d73ce744671"><![CDATA[(1)]]></kuvatavNr>
					<sisuTekst id="44b703a3-65a0-4bc9-b5bf-a287a89c28fd">
						<tavatekst id="9dce94fc-5482-40a9-a96f-9f5ca5fbdadc">Toetus määratakse Põlva valla haldusterritooriumil asuva kooli esimesse klassi esmakordselt õppima asuvale lapsele, kelle elukoht rahvastikuregistri andmetel on Põlva vald.</tavatekst>
					</sisuTekst>
				</loige>
				<loige id="para7lg2">
					<loigeNr id="9af17989-1724-4e87-a3a1-ccb38a49b296">2</loigeNr>
					<kuvatavNr id="dea35365-5f99-4d9e-bac6-722e2692b2c2"><![CDATA[(2)]]></kuvatavNr>
					<sisuTekst id="f3089552-2a8c-451f-a788-198efe9dc0a2">
						<tavatekst id="41795714-c0eb-44cb-94fa-6f4a63583713">Erandjuhul makstakse toetus lapsele, kelle elukoht rahvastikuregistri andmetel on Põlva vald ning kes asub esmakordselt esimesse klassi õppima teise kohaliku omavalitsuse haldusterritooriumil asuvas koolis, kui:</tavatekst>
					</sisuTekst>
					<alampunkt id="para7lg2p1">
						<alampunktNr id="4111cf4c-da25-474e-951a-137b20421c61">1</alampunktNr>
						<kuvatavNr id="ea378c29-eadc-4c2d-8f4e-c3093c12f545"><![CDATA[1) ]]></kuvatavNr>
						<sisuTekst id="8f0f9e0e-d96f-441b-a10f-d532ef7cdc0b">
							<tavatekst id="c07a8201-3afc-43f2-a428-451d19663f9b">lapse erivajadustele vastavat kooli Põlva vallas ei ole;</tavatekst>
						</sisuTekst>
					</alampunkt>
					<alampunkt id="para7lg2p2">
						<alampunktNr id="c4d8c9cc-68d0-4d74-9b61-9b71f716fb92">2</alampunktNr>
						<kuvatavNr id="14ba55eb-f585-4b23-8385-79d0ed675e1f"><![CDATA[2) ]]></kuvatavNr>
						<sisuTekst id="78bc98d5-c0b8-4d51-9c9c-1701169cabf8">
							<tavatekst id="f6b25b18-c8b1-4d93-ba56-55e8514a2e74">lapse registrijärgsele elukohale lähim kool asub teise omavalitsuse haldusterritooriumil.</tavatekst>
						</sisuTekst>
						<muutmismarge id="14d107a3-330f-4332-a43f-3bf58b32f834">
							<avaldamismarge id="54734764-9ecf-4fc0-9e2c-69d7396e7273">
								<RTosa id="34973b46-496e-4312-aafc-525828ab75cf">RT IV</RTosa>
								<avaldamineKuupaev id="f93d24ca-1ef8-4fa3-adfc-ca8456639aec">2019-03-27</avaldamineKuupaev>
								<RTartikkel id="cf75b674-c9d9-44ca-a02d-dfd89047e641">3</RTartikkel>
								<aktViide id="c4b89e8f-18f1-4028-83d2-d3954bd84592">427032019003</aktViide>
							</avaldamismarge>
							<joustumine id="30b355d3-662f-411c-8ae7-ee0bf8ba5636">2019-04-01</joustumine>
						</muutmismarge>
					</alampunkt>
				</loige>
				<loige id="para7lg3">
					<loigeNr id="5b6a6110-5bad-436e-8333-847a81186deb">3</loigeNr>
					<kuvatavNr id="3312503f-ecd3-44fc-af6b-ed516c7aff7d"><![CDATA[(3)]]></kuvatavNr>
					<sisuTekst id="06ea6dbb-997b-420d-9086-0839306183e3">
						<tavatekst id="c0a94fd9-dcfd-4206-9d98-d2e635e466d2">Taotlusi võetakse vastu 1. augustist 30. septembrini.</tavatekst>
					</sisuTekst>
				</loige>
			</paragrahv>
			<paragrahv id="para8">
				<paragrahvNr id="d46514ba-b29a-400e-8446-cde750aa3a08">8</paragrahvNr>
				<kuvatavNr id="f934a03a-57d9-4477-b0d2-b559061e1082"><![CDATA[§ 8. ]]></kuvatavNr>
				<paragrahvPealkiri id="a6432f57-561c-4b35-93a4-76da7728dd45">Jõulutoetus</paragrahvPealkiri>
				<loige id="para8lg1">
					<loigeNr id="b597a631-bb24-4175-925a-24753f5e4ef6">1</loigeNr>
					<kuvatavNr id="e4e2568a-f5d7-4813-bd2a-444a57fcaaf8"><![CDATA[(1)]]></kuvatavNr>
					<sisuTekst id="513e86dc-18a7-4ec6-8471-7e7e9ef1e8a9">
						<tavatekst id="6ddb4ebd-e5a0-49d1-a8c5-1306a70377df">Toetus antakse jõulupakina:</tavatekst>
					</sisuTekst>
					<alampunkt id="para8lg1p1">
						<alampunktNr id="8da1b8cb-6668-4403-9f9a-0e96ba085b4c">1</alampunktNr>
						<kuvatavNr id="513e4ba6-17ea-4601-8dfd-18b568095907"><![CDATA[1) ]]></kuvatavNr>
						<sisuTekst id="a37da55c-b2ea-46d0-8f36-94ee4691376f">
							<tavatekst id="001879bd-d604-485f-a1f2-6261c39f5958">Põlva valla haldusterritooriumil asuvas koolieelses lasteasutuses käivatele lastele;</tavatekst>
						</sisuTekst>
					</alampunkt>
					<alampunkt id="para8lg1p2">
						<alampunktNr id="1f3030de-a296-4819-b388-9a742f55209f">2</alampunktNr>
						<kuvatavNr id="e7be8c57-4a89-45f3-9f94-1f0ad325f01f"><![CDATA[2) ]]></kuvatavNr>
						<sisuTekst id="15036d78-c8e5-4277-a94d-18a35a5e55d1">
							<tavatekst id="fcb4d26a-91a4-4597-8b13-1aa1fec1e376">Põlva valla haldusterritooriumil asuvate koolide esimeses kooliastmes õppivatele lastele;</tavatekst>
						</sisuTekst>
					</alampunkt>
					<alampunkt id="para8lg1p3">
						<alampunktNr id="427fbaf2-f7de-48fb-8802-0f2ad3745e53">3</alampunktNr>
						<kuvatavNr id="3beb1694-1123-464e-8627-8c4a52c6a3ed"><![CDATA[3) ]]></kuvatavNr>
						<sisuTekst id="e81cd58a-2a7e-4f98-bee7-a3d1935d40f1">
							<tavatekst id="e4792e77-7461-4159-8029-13968de05145">koolieelses lasteasutuses mittekäivatele lastele alates esimesest eluaastast.</tavatekst>
						</sisuTekst>
					</alampunkt>
				</loige>
