		<nimi id="a744fb88-cf9d-4dd5-8710-d83ee9d0b667">
			<pealkiri id="69fe136a-d468-4744-b79b-80e0ce9e69fe">Puuetega inimeste eluaseme füüsilise kohandamise toetuse määramise ja maksmise kord</pealkiri>
		</nimi>
	</aktinimi>
	<muutmismarge id="763e3262-544b-4cd5-936c-b535381eb174">
		<aktikuupaev id="717e0176-cd62-4853-81ff-302f6585a47a">2020-12-21</aktikuupaev>
		<avaldamismarge id="e7af536a-ab13-401e-bf6e-88dbfea4968f">
			<RTosa id="312978ad-4035-47fc-b261-931fe2cf7a4b">RT IV</RTosa>
			<avaldamineKuupaev id="23d68508-fa3a-4d13-a189-074fef10871c">2020-12-31</avaldamineKuupaev>
			<RTartikkel id="c5d4d982-2450-47d5-8b30-b2dcc7ef40da">3</RTartikkel>
			<aktViide id="59408d0a-28c6-45ab-a501-88b71c53c0b8">431122020003</aktViide>
		</avaldamismarge>
