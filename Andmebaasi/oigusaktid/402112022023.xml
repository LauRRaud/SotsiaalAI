		<paragrahv id="para3b1">
			<paragrahvNr id="165d43fc-9f47-4765-baa1-29677535310e" ylaIndeks="1">3</paragrahvNr>
			<kuvatavNr id="0a6f83a5-7917-4d2b-8eb6-2c20a0327c2f"><![CDATA[§ 3<sup>1</sup>. ]]></kuvatavNr>
			<paragrahvPealkiri id="263a542e-1fee-4403-b4f5-b564c34272e4">Sotsiaaltransporditeenuse eest tasumine</paragrahvPealkiri>
			<muutmismarge id="b4c768e7-3742-4915-a9ff-379fa466fdf3">
				<avaldamismarge id="42781a56-11eb-4289-9f66-129cd3b4f66d">
					<RTosa id="c6336a89-742b-4c2e-a18a-dc2f38907fa7">RT IV</RTosa>
					<avaldamineKuupaev id="09909b74-ee7d-4356-b1d7-81a65c991310">2022-11-02</avaldamineKuupaev>
					<RTartikkel id="034baab8-e5b4-459a-9848-35eebc5adf72">7</RTartikkel>
					<aktViide id="73f1773b-ae11-4661-a6b9-d32dd51449ef">402112022007</aktViide>
				</avaldamismarge>
				<joustumine id="cdf15728-5216-490a-97db-06e3c1c88cb7">2023-01-01</joustumine>
			</muutmismarge>
			<loige id="para3b1lg1">
				<loigeNr id="48ffce87-ca66-460a-96f1-40e99745a0ef">1</loigeNr>
				<kuvatavNr id="c4f7fe27-f92b-4ec7-92d8-516c9682e571"><![CDATA[(1)]]></kuvatavNr>
				<sisuTekst id="277b5994-b5a7-477f-8dd9-32f3df53fa8b">
					<tavatekst id="e117f09b-307d-4a92-ad33-88fa1e62b247">Sotsiaaltransporditeenus on tasuline. Sotsiaaltransporditeenuse eest tasub teenuse saaja omaosalustasu.</tavatekst>
				</sisuTekst>
			</loige>
			<loige id="para3b1lg2">
				<loigeNr id="26185c50-e097-45d0-ae0c-f71985bacd43">2</loigeNr>
				<kuvatavNr id="d475aa89-e3e5-4e81-a5c3-edf1cc288dcc"><![CDATA[(2)]]></kuvatavNr>
				<sisuTekst id="dfcc1465-bef4-4cf7-891a-c4ecc7b6c8c2">
					<tavatekst id="57f44a47-7d6a-4113-bca5-16e08509f94c">Sotsiaaltransporditeenuse omaosalustasu kehtestab linnavalitsus.</tavatekst>
				</sisuTekst>
			</loige>
			<loige id="para3b1lg3">
				<loigeNr id="fb9c62c2-f957-4d1a-be0f-b0cefa9feffb">3</loigeNr>
				<kuvatavNr id="5bb8d4c9-8df5-4f19-8feb-b999054f599a"><![CDATA[(3)]]></kuvatavNr>
				<sisuTekst id="f1be38ca-af3f-49bc-9a38-37003530648e">
					<tavatekst id="777e994c-5e1a-4586-85de-5ab92aedadeb">Omaosalustasu maksmisest on vabastatud puudega lapsed saatjatega.</tavatekst>
				</sisuTekst>
				<muutmismarge id="b4c768e7-3742-4915-a9ff-379fa466fdf3">
				<avaldamismarge id="42781a56-11eb-4289-9f66-129cd3b4f66d">
					<RTosa id="c6336a89-742b-4c2e-a18a-dc2f38907fa7">RT IV</RTosa>
					<avaldamineKuupaev id="09909b74-ee7d-4356-b1d7-81a65c991310">2022-11-02</avaldamineKuupaev>
					<RTartikkel id="034baab8-e5b4-459a-9848-35eebc5adf72">7</RTartikkel>
					<aktViide id="73f1773b-ae11-4661-a6b9-d32dd51449ef">402112022007</aktViide>
				</avaldamismarge>
				<joustumine id="cdf15728-5216-490a-97db-06e3c1c88cb7">2023-01-01</joustumine>
			</muutmismarge>
			</loige>
		</paragrahv>
		<paragrahv id="para4">
			<paragrahvNr id="68b45c6e-39f5-4683-a842-523271e45c80">4</paragrahvNr>
			<kuvatavNr id="47b7ff25-496b-429e-ad45-12263d397677"><![CDATA[§ 4. ]]></kuvatavNr>
			<paragrahvPealkiri id="d6f0749b-5509-4988-804b-20f2f9984066">Sotsiaaltransporditeenuse määramata jätmine</paragrahvPealkiri>
			<loige id="para4lg1">
				<loigeNr id="db0ee92e-6f7c-4b21-82cc-6ec8181201f2">1</loigeNr>
				<kuvatavNr id="565856ff-3e24-44c5-801d-55a6d47e113f"><![CDATA[(1)]]></kuvatavNr>
				<sisuTekst id="bab48cfa-1ea9-4543-8bf2-daa52c8a0065">
					<tavatekst id="464c76d2-b002-46f9-a704-c182026bd86d">Taotluse sotsiaaltransporditeenuse saamiseks võib jätta rahuldamata kui:</tavatekst>
				</sisuTekst>
				<alampunkt id="para4lg1p1">
					<alampunktNr id="fdd6ec81-cb62-4e71-b506-3fc73b7b4ac3">1</alampunktNr>
					<kuvatavNr id="02bae3e4-fa0e-48a8-a2f9-2b3026802285"><![CDATA[1) ]]></kuvatavNr>
					<sisuTekst id="63bb60a7-cda5-45c5-b240-dc12b8481f6e">
						<tavatekst id="164407eb-8929-4cf8-b3f3-ed9df12dabd9">isik ei ole õigustatud teenust saama;</tavatekst>
					</sisuTekst>
				</alampunkt>
				<alampunkt id="para4lg1p2">
					<alampunktNr id="c8133859-9ac4-4ccf-80c8-a458d5a3eb27">2</alampunktNr>
					<kuvatavNr id="03cdb5bb-4e4b-4032-99b3-7c1cd9f1aedd"><![CDATA[2) ]]></kuvatavNr>
					<sisuTekst id="005c46c0-a7b6-4fd6-b119-fc9417c1b687">
						<tavatekst id="b76fbe9c-d570-4fb0-b5bd-d387ee883154">transpordivahend teenuse osutamiseks soovitud ajal on juba eelnevalt broneeritud;</tavatekst>
					</sisuTekst>
				</alampunkt>
				<alampunkt id="para4lg1p3">
					<alampunktNr id="75e33d33-0e1c-4f9e-981b-b50aee0c80a0">3</alampunktNr>
					<kuvatavNr id="d07a2842-f8fa-4951-a69a-c630b966af85"><![CDATA[3) ]]></kuvatavNr>
					<sisuTekst id="e1a6a125-f89f-4313-b972-452884d0f16a">
						<tavatekst id="73c0768d-6d82-427f-8cca-69141d431a71">sotsiaaltransporti taotleva isiku alaline elukoht on teise omavalitsuse territooriumil.</tavatekst>
					</sisuTekst>
				</alampunkt>
			</loige>
			<loige id="para4lg2">
				<loigeNr id="008515cc-4947-4b66-bd69-3c7b9be30325">2</loigeNr>
				<kuvatavNr id="8810d370-4f3b-4180-b0f8-d9e9e4456525"><![CDATA[(2)]]></kuvatavNr>
				<sisuTekst id="103e622a-77c7-41db-9fa0-1aac7a7bf590">
					<tavatekst id="925e8cfc-2cac-4562-979e-639ce10849a2">Teenuse osutamisest või mitteosutamisest teavitab sotsiaalosakond teenust taotlenud isikut esimesel võimalusel telefoni teel või kirjalikult.</tavatekst>
				</sisuTekst>
			</loige>
			<loige id="para4lg3">
				<loigeNr id="4ee6c1ad-12cd-496e-bee8-3708e8310d68">3</loigeNr>
				<kuvatavNr id="e825d4bc-8a39-4d4c-8aef-57927f3bd9c7"><![CDATA[(3)]]></kuvatavNr>
				<sisuTekst id="bea91076-333e-4325-b3aa-97d015c4af18">
					<tavatekst id="b41073b5-5de5-4dff-86f3-fc288ae87cb9">Otsusega mittenõustumise korral on taotlejal õigus esitada vaie linnavalitsusele või pöörduda halduskohtusse halduskohtumenetluse seaduses sätestatud korras.</tavatekst>
				</sisuTekst>
			</loige>
		</paragrahv>
		<paragrahv id="para5">
			<paragrahvNr id="63a8397d-d1fc-4643-bd2e-6d9af86f6911">5</paragrahvNr>
			<kuvatavNr id="95020f1c-db0f-4961-9b80-55ddedaad93f"><![CDATA[§ 5. ]]></kuvatavNr>
			<paragrahvPealkiri id="89658e36-1cfd-4132-9ee9-4697ed438a16">Järelevalve ja vaidluste lahendamine</paragrahvPealkiri>
			<loige id="para5lg1">
				<loigeNr id="fab85743-99bb-4463-90b7-1991681d8bc2">1</loigeNr>
				<kuvatavNr id="f3c6696f-0db8-4378-bd7a-72198d400d8d"><![CDATA[(1)]]></kuvatavNr>
				<sisuTekst id="eff3b809-6fd6-4f1a-bd5a-eceda57e8910">
					<tavatekst id="5b97ca67-8180-402e-b799-6ef710bffb89">Järelevalvet teenuse osutamise üle teostab linnavalitsus.</tavatekst>
				</sisuTekst>
			</loige>
			<loige id="para5lg2">
				<loigeNr id="8924b345-b77e-463c-af1b-131ae65e3840">2</loigeNr>
				<kuvatavNr id="d0b2f129-9814-49f4-aefe-aa21a5edab88"><![CDATA[(2)]]></kuvatavNr>
				<sisuTekst id="30bfdef2-af00-4afb-82b1-9228d8197d52">
					<tavatekst id="d81a1f28-c00d-473d-b600-9ae08fe19915">Teenuse üle peab arvestust sotsiaalosakond. Taotlused registreeritakse ja teenus määratakse sotsiaalteenuste-ja toetuste registris STAR.</tavatekst>
				</sisuTekst>
			</loige>
			<loige id="para5lg3">
				<loigeNr id="db166421-c729-4173-a9df-dd2557098488">3</loigeNr>
				<kuvatavNr id="02bcdecf-24d1-4e3d-80a1-32cb4a9dc787"><![CDATA[(3)]]></kuvatavNr>
				<sisuTekst id="e9d4e135-3d8d-40b5-83f2-10cabaa36c70">
					<tavatekst id="3c799c14-13b6-4844-a6a6-dcb5f8b62387">Teenuste osutamisega seotud kaebuste ilmnemisel informeerib teenust saav isik koheselt sotsiaalosakonna juhatajat. Sotsiaalosakonna juhataja kontrollib pretensioonide õigustatust, kuulab ära kõik osapooled ning teeb otsuse kaebuse lahendamise kohta.</tavatekst>
				</sisuTekst>
			</loige>
		</paragrahv>
		<paragrahv id="para6">
			<paragrahvNr id="61491d8d-8ba3-4b53-beec-e6b0a592e06a">6</paragrahvNr>
			<kuvatavNr id="0bb15d49-7b42-41e6-8742-4368850f1f8e"><![CDATA[§ 6. ]]></kuvatavNr>
			<paragrahvPealkiri id="ac144952-e14c-4943-bf75-f39a7dcbf9ed">Rakendussätted</paragrahvPealkiri>
			<loige id="para6lg1">
				<loigeNr id="1f7254d3-66fa-4a85-8c8f-76f19e13c251">1</loigeNr>
				<kuvatavNr id="4927dea5-9715-4e17-9382-e8afc88746b2"><![CDATA[(1)]]></kuvatavNr>
				<sisuTekst id="bf8b14f5-4794-477e-8bd6-7135529b06c0">
					<tavatekst id="0391b0ad-3a2c-410d-a98d-89f9698e37d1">Määrus jõustub kolmandal päeval pärast Riigi Teatajas avaldamist.</tavatekst>
				</sisuTekst>
			</loige>
			<loige id="para6lg2">
				<loigeNr id="e2882920-4eac-42e0-97c7-93ef69dc4f59">2</loigeNr>
				<kuvatavNr id="2dab94b2-3653-4fdd-9f1d-ce927dee8cef"><![CDATA[(2)]]></kuvatavNr>
				<sisuTekst id="25363277-5bd8-4bd0-b3ed-e25f4704efdf">
					<tavatekst id="ff88ce0d-68ef-4a56-8b0d-d80ee174604b">Määrus rakendatakse 1. jaanuarist 2018. a.</tavatekst>
				</sisuTekst>
			</loige>
		</paragrahv>
	</sisu>
