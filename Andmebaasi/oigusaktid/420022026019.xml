			<kuvatavNr id="f850cccd-a662-4d1b-9a4d-628bf77cbd28"><![CDATA[§ 1. ]]></kuvatavNr>
			<paragrahvPealkiri id="eb0c5302-41d6-4a3e-bfa7-da37b7a167a8">Väljaspool kodu osutatava ööpäevaringse üldhooldusteenuse hoolduskulude tasumise piirmäär</paragrahvPealkiri>
			<loige id="para1lg1">
				<loigeNr id="331266f5-11e2-418a-9cbe-50f8c128db19"/>
				<kuvatavNr id="df785f33-b218-4b72-8300-f63c8da7200f"/>
				<sisuTekst id="f889472f-1f21-4bd3-af98-41dce3c325e4">
					<tavatekst id="963259c3-df28-46dd-8ce9-aca624aa15d8">Kehtestada väljaspool kodu osutatava ööpäevaringse üldhooldusteenuse osutamisel vahetult teenust osutavate hooldustöötajate ja abihooldustöötajate kulude tasumise piirmääraks 700 eurot ühe teenusesaaja kohta kalendrikuus.</tavatekst>
				</sisuTekst>
