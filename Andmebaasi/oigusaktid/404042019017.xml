   <pealkiri id="5e5678be-cd98-41e6-8ad8-1745f5767237">Matusetoetuse maksmise tingimused ja kord </pealkiri>
  </nimi>
 </aktinimi>
 <sisu id="1e424ffe-8bdf-4dc0-aeeb-a6449d0eba87"><preambul id="dbfb67f4-9c97-4007-92f6-4f5f33b6b645"><tavatekst id="6ddf196c-da75-4602-b68e-d101250839a9">Määrus kehtestatakse kohaliku omavalitsuse korralduse seaduse § 6 lõike 1, § 22 lõike 1 punkti 5 ja sotsiaalhoolekande seaduse § 14 alusel.</tavatekst></preambul><paragrahv id="para1"><paragrahvNr id="a5de4b42-5b06-42ae-bd7c-cb7898b91d4f">1</paragrahvNr><kuvatavNr id="bfc20412-e0fd-4c3f-a735-15f77d5e3bcf"><![CDATA[§ 1. ]]></kuvatavNr><paragrahvPealkiri id="4b848e79-fe49-400a-ac7a-bfa747a69405">Reguleerimisala</paragrahvPealkiri><loige id="para1lg1"><loigeNr id="adf2412a-22ac-4694-a368-b385e35cce4f">1</loigeNr><kuvatavNr id="562b4c37-b714-4ed9-b156-18f735089380"><![CDATA[(1)]]></kuvatavNr><sisuTekst id="b14e5d3d-edfb-4f95-9bec-3e40ad16f906"><tavatekst id="09d80cee-f525-4e69-9251-a7e666f463f6"> Matusetoetuse maksmise tingimused ja kord sätestab matusetoetuse maksmise tingimused ja korra Viljandi vallas.</tavatekst></sisuTekst></loige><loige id="para1lg2"><loigeNr id="ae27568f-4aa0-4e3e-96a3-ed1a70ef19f0">2</loigeNr><kuvatavNr id="2c79faaf-702b-4131-a3bd-38817950a0d1"><![CDATA[(2)]]></kuvatavNr><sisuTekst id="d603a82f-4c83-4330-9510-18dd8736437c"><tavatekst id="47c6838a-03c8-4818-91a5-3d7b56c72bb7"> Matusetoetus on Viljandi valla eelarvest selleks riigi poolt eraldatud rahaliste vahendite arvelt matusekorraldajale matuse korraldamise kulude osaliseks hüvitamiseks makstav ühekordne toetus.</tavatekst></sisuTekst></loige></paragrahv><paragrahv id="para2"><paragrahvNr id="fbc142ad-85f8-4c46-bffe-4fd3b81d4d0b">2</paragrahvNr><kuvatavNr id="a2529523-8168-4d4c-9fbe-20034ec25cc1"><![CDATA[§ 2. ]]></kuvatavNr><paragrahvPealkiri id="02cb4d4f-14a8-4d44-8738-e2ba1ba49157">Matusetoetuse maksmise tingimused</paragrahvPealkiri><loige id="para2lg1"><loigeNr id="63a10036-6510-4f54-a76b-f4fe8544dfeb">1</loigeNr><kuvatavNr id="bdebc45e-8866-4055-a598-0bc72f0c66ed"><![CDATA[(1)]]></kuvatavNr><sisuTekst id="2505d200-deaa-45e3-8e41-c41b216819d1"><tavatekst id="63bac2dc-02de-4882-ace9-2bb06d2668b7"> Matusetoetust on õigus saada isiku matusekorraldajal, kui isiku viimaseks elukohaks oli Eesti rahvastikuregistris (edaspidi rahvastikuregister) Viljandi vald.</tavatekst></sisuTekst></loige><loige id="para2lg2"><loigeNr id="be091871-7ae6-4c3c-83c5-85d8581e8070">2</loigeNr><kuvatavNr id="bb9e0fec-f7ba-46c3-82e8-311310cb6361"><![CDATA[(2)]]></kuvatavNr><sisuTekst id="042f4035-3a3e-4e6d-a6a6-da7c97fc67a5"><tavatekst id="3c5c31eb-a11e-408c-af20-39bce34ccc9d"> Erandkorras makstakse matusetoetust ka matusekorraldajale, kes taotleb toetust sellise isiku matuse kulude katmiseks, kellel puudub rahvastikuregistrijärgne elukoht või kelle eest ei ole võimalik saada toetust ühestki teisest kohaliku omavalitsuse üksusest (sh surnult sündinud laps).</tavatekst></sisuTekst></loige><loige id="para2lg3"><loigeNr id="5a239eef-8a6a-40ac-9eb4-9f6a41d02c27">3</loigeNr><kuvatavNr id="5cd5843b-6c95-4694-ba5f-52dc44756ff4"><![CDATA[(3)]]></kuvatavNr><sisuTekst id="5a383e3c-9dc8-40b5-88ec-8252291a7e98"><tavatekst id="1d20c925-5b82-4bc7-a2a0-fa8a7dd87bdb"> Erandkorras otsustab matusetoetuse maksmise Viljandi Vallavalitsuse alatine sotsiaalkomisjon (edaspidi sotsiaalkomisjon) protokollilise otsusena 10 tööpäeva jooksul peale kõikide nõutud dokumentide esitamist matusekorraldaja poolt.</tavatekst></sisuTekst></loige></paragrahv><paragrahv id="para3"><paragrahvNr id="add796fb-ecae-4f6c-b99b-dfe0fdb31cd9">3</paragrahvNr><kuvatavNr id="d91621d6-82fb-4f52-8d73-f3e9dd197329"><![CDATA[§ 3. ]]></kuvatavNr><paragrahvPealkiri id="34314a82-3035-4787-a0b7-141177f79f4c">Matuse korraldamise kulud</paragrahvPealkiri><loige id="para3lg1"><loigeNr id="a89c2b18-9522-455a-8018-45cdbcde3319"/><kuvatavNr id="9ae3ed7d-a09c-4cd9-a0d6-aa3341cde57a"/><sisuTekst id="10738e35-f53e-4a09-89f7-ee9ed8d7c36b"><tavatekst id="1b0cb76b-c859-412c-a6c6-b75d62b8d83b">Matuse korraldamise kulud on surnu transportimise, tuhastamise või matmise ning leinatalituse kulud.</tavatekst></sisuTekst></loige></paragrahv><paragrahv id="para4"><paragrahvNr id="c6229375-8ad5-4ce0-bb0b-94bef61fc653">4</paragrahvNr><kuvatavNr id="ca822b22-c1ff-4bde-9077-9b344bbedb71"><![CDATA[§ 4. ]]></kuvatavNr><paragrahvPealkiri id="82629b81-2870-4e1d-8361-2c3d419db094">Matusekorraldaja</paragrahvPealkiri><loige id="para4lg1"><loigeNr id="9fea6805-b725-4311-abb4-f14444e30361">1</loigeNr><kuvatavNr id="1cf97328-dc0e-4757-b21c-e62dfbd244e6"><![CDATA[(1)]]></kuvatavNr><sisuTekst id="d32bdbfd-2632-43b7-9230-86cfed4cb2c3"><tavatekst id="580beb93-088d-41e9-b9cf-809dda658afb"> Matusekorraldaja käesoleva määruse mõistes on füüsiline isik, kes kannab surnu matuse korraldamise kulud.</tavatekst></sisuTekst></loige><loige id="para4lg2"><loigeNr id="8a7ac8a9-0a1f-478b-ad8e-b62924fae294">2</loigeNr><kuvatavNr id="c5a8ae40-afcd-44d0-ba87-ad535ae94c0e"><![CDATA[(2)]]></kuvatavNr><sisuTekst id="37cca1ed-4026-4a73-adaf-1c6fa2e7109b"><tavatekst id="782902c9-8849-41ec-925f-b8bdc1c6643d"> Matusekorraldaja võib olla ka Viljandi Vallavalitsus (ametiasutus).</tavatekst></sisuTekst></loige></paragrahv><paragrahv id="para5"><paragrahvNr id="6b7a3683-ed1b-4782-8760-715c20e569fb">5</paragrahvNr><kuvatavNr id="48909bd9-1e5c-4afe-8dc2-39260717cd65"><![CDATA[§ 5. ]]></kuvatavNr><paragrahvPealkiri id="916facda-1d76-44a0-94a7-98997867feb1">Matusetoetuse taotlemine</paragrahvPealkiri><loige id="para5lg1"><loigeNr id="3a90fb24-7eab-4736-969e-f53966ab87c3"/><kuvatavNr id="cd357b5b-89f6-446e-9e9c-b6fb29fbb62d"/><sisuTekst id="ad0f9f31-b03d-4697-a476-9b98d0d0314d"><tavatekst id="e03e35fd-19a0-4ae7-ba81-fa95584d04cc">Matusetoetuse saamiseks esitatakse taotlus, millele lisatakse:</tavatekst></sisuTekst><alampunkt id="para5lg1p1"><alampunktNr id="4bb02190-99ea-4984-9e06-68e05e9739e6">1</alampunktNr><kuvatavNr id="fe2ce371-ae5e-495a-a979-d35bf43f2153"><![CDATA[1) ]]></kuvatavNr><sisuTekst id="0a269f2b-ee52-4a34-b48f-4f47307798d8"><tavatekst id="3f69e93f-437e-4643-916b-e7977a41eda4">vajadusel taotleja isikut tõendava dokumendi koopia;</tavatekst></sisuTekst></alampunkt><alampunkt id="para5lg1p2"><alampunktNr id="54a6c182-6245-4b68-ade4-495258c76b31">2</alampunktNr><kuvatavNr id="51161d24-ec6e-45b6-8405-9653173e9b9f"><![CDATA[2) ]]></kuvatavNr><sisuTekst id="5ff65c01-cc7b-4ef2-86a0-2cbce8be9345"><tavatekst id="45e55f7b-001a-4396-aabb-ba859f715091">registreeritud surma tõendi või isiku surma tõendava dokumendi koopia, mille on välja andnud välisriigi asjaomane asutus, kui surm on registreeritud väljaspool Eestit või arstliku surmateatise koopia, kui isik sündis surnult;</tavatekst></sisuTekst></alampunkt><alampunkt id="para5lg1p3"><alampunktNr id="584de4ca-200d-47c9-9c9a-4bea9d077892">3</alampunktNr><kuvatavNr id="2d44f11a-ae88-457c-8ce6-c86e86b3f5bc"><![CDATA[3) ]]></kuvatavNr><sisuTekst id="ec5be91c-5c85-4bcd-a98a-e9b734e18e69"><tavatekst id="d0dc7622-70df-4433-b756-47b6846a69d7">vajadusel muud asjakohased dokumendid.</tavatekst></sisuTekst></alampunkt></loige></paragrahv><paragrahv id="para6"><paragrahvNr id="7f64473c-b21d-4420-8d4a-23f109b84066">6</paragrahvNr><kuvatavNr id="1a4d26b3-28d8-466c-9f61-8ce42777f7f9"><![CDATA[§ 6. ]]></kuvatavNr><paragrahvPealkiri id="ef6048d7-55d6-4077-b7a2-359a6c31f502">Matusetoetuse suurus</paragrahvPealkiri><loige id="para6lg1"><loigeNr id="e0f38a29-ec94-4927-a960-a6cca2c07ece">1</loigeNr><kuvatavNr id="3284a5f5-2289-4a54-bc5e-fe66aaa9e819"><![CDATA[(1)]]></kuvatavNr><sisuTekst id="806bd332-7eda-40d8-b7c2-6bce0445313b"><tavatekst id="3047cd61-dd82-4d46-bca6-564af19826b5"> Matusetoetuse suurus on 300,00 (kolmsada) eurot.</tavatekst></sisuTekst></loige><loige id="para6lg2"><loigeNr id="0ea916b0-9081-4dd4-8e59-5402b2c90c91">2</loigeNr><kuvatavNr id="08da467b-3a7b-4840-a9cd-a9d2485b8cb3"><![CDATA[(2)]]></kuvatavNr><sisuTekst id="57d33648-469c-4103-a227-3efbc4c65b31"><tavatekst id="9b4ce82c-e0de-474a-a482-f61f497c7bb9"> Matusetoetust makstakse lahkunu surmapäeval kehtinud suuruses.</tavatekst></sisuTekst></loige></paragrahv><paragrahv id="para7"><paragrahvNr id="ce666014-a290-42a6-8b7f-dd4cfb9c5d51">7</paragrahvNr><kuvatavNr id="2dad44ed-9e05-48bf-a2fc-2aff6bcb82fb"><![CDATA[§ 7. ]]></kuvatavNr><paragrahvPealkiri id="6f7568b3-aca1-4c5b-ae69-93d1a73cf853">Matusetoetuse määramine</paragrahvPealkiri><loige id="para7lg1"><loigeNr id="9d6fdced-e834-4850-8421-d1fcbbea6d5e">1</loigeNr><kuvatavNr id="51611a5b-e809-467b-9300-cfc54ccf6dd9"><![CDATA[(1)]]></kuvatavNr><sisuTekst id="b49c9c3b-d96b-4605-99e1-83d64a1a8e6b"><tavatekst id="9b1feb8a-7ba9-428e-b75f-9efd73f1bc58"> Matusetoetus määratakse, kui matusetoetuse taotlus on esitatud kolme kuu jooksul surmapäevast arvates.</tavatekst></sisuTekst></loige><loige id="para7lg2"><loigeNr id="48bebdbd-5dfa-48eb-88f5-4117084c29d0">2</loigeNr><kuvatavNr id="db99d2ce-a250-480c-9470-de5600c9a82e"><![CDATA[(2)]]></kuvatavNr><sisuTekst id="ab68f8f9-5f76-4813-9119-812dcabf7cfb"><tavatekst id="c0522e86-ec48-461a-a648-8fa3c3481b19"> Matusetoetuse määramise otsuse teeb Viljandi Vallavalitsuse sotsiaaltöö spetsialist esimesel võimalusel, aga mitte hiljem, kui viie tööpäeva jooksul pärast kõikide nõutud dokumentide esitamist matusekorraldaja poolt.</tavatekst></sisuTekst></loige><loige id="para7lg3"><loigeNr id="96d2e6b9-eef6-4f26-8ee8-fea02622fe81">3</loigeNr><kuvatavNr id="93cf3ac6-8590-4721-b61f-68514ce31991"><![CDATA[(3)]]></kuvatavNr><sisuTekst id="bd24f453-b1af-4bf4-b0b2-b89a3c3773bd"><tavatekst id="a9fbe02f-ebbe-455e-bf96-a7b2fc1bde59"> Matusetoetuse määramata jätmise otsustab sotsiaalkomisjon.</tavatekst></sisuTekst></loige></paragrahv><paragrahv id="para8"><paragrahvNr id="020a2813-e59d-4bfb-a73f-0d955f2a694d">8</paragrahvNr><kuvatavNr id="287be9ab-4374-410e-bdc0-6bb4339ba1b3"><![CDATA[§ 8. ]]></kuvatavNr><paragrahvPealkiri id="ee1978b6-f92a-440f-ad5f-6af3bc176098">Matusetoetuse määramata jätmise alused</paragrahvPealkiri><loige id="para8lg1"><loigeNr id="6fd8048c-a0ae-4c7d-84aa-cec21a858acb"/><kuvatavNr id="d3d6212f-140c-43bc-83a3-df3ddf390c66"/><sisuTekst id="10d35c0e-1880-4e3b-ad0f-c7a54b30176d"><tavatekst id="20df8b86-af97-4a5b-be70-c73c3e53bc20">Matusetoetust ei määrata, kui:</tavatekst></sisuTekst><alampunkt id="para8lg1p1"><alampunktNr id="bb1f50c9-d48f-4627-8b8c-3e2ec6dd6315">1</alampunktNr><kuvatavNr id="28b64746-12ba-4d1e-b87a-94b3ed45ab55"><![CDATA[1) ]]></kuvatavNr><sisuTekst id="8324f256-7c90-498f-8c74-d09e5f1d7b41"><tavatekst id="f21c851b-a512-42f2-a2f7-a48d022db94e">käesoleva määrusega kehtestatud nõudeid ei ole täidetud;</tavatekst></sisuTekst></alampunkt><alampunkt id="para8lg1p2"><alampunktNr id="6f4fdd52-0f2a-4932-ad44-c2d3094f7c15">2</alampunktNr><kuvatavNr id="5b55caa7-5d0d-4b32-a466-a6d2119db8c9"><![CDATA[2) ]]></kuvatavNr><sisuTekst id="b05a0c7e-0f63-47ca-9820-9d05487a50c6"><tavatekst id="c4a0bd8d-5ae4-4cb0-a64d-6a763077910a">käsitletava surmajuhtumi korral on matusetoetus juba eelnevalt määratud;</tavatekst></sisuTekst></alampunkt><alampunkt id="para8lg1p3"><alampunktNr id="f331b8a8-baa8-442d-8c37-7a44e74a6e2b">3</alampunktNr><kuvatavNr id="2cda89e6-e426-4901-8e62-c395d4b037c3"><![CDATA[3) ]]></kuvatavNr><sisuTekst id="1f69be40-c99d-46b2-afd5-4185523394c9"><tavatekst id="74147a2d-1a16-4db5-81e5-5253245a6658">kui mõnest teisest kohalikust omavalitsusest on õigus surnu või matusekorraldaja registreeritud elukoha järgi toetust taotleda;</tavatekst></sisuTekst></alampunkt><alampunkt id="para8lg1p4"><alampunktNr id="6c7c7aea-7e52-4c43-a41f-713eb8cddd36">4</alampunktNr><kuvatavNr id="aab05d05-8301-4341-983a-e671e5116b15"><![CDATA[4) ]]></kuvatavNr><sisuTekst id="b30301bf-3c68-4cac-b90b-8f6bfc32b35b"><tavatekst id="b2be5cc2-bdd3-4563-89fa-a126ce5ea8fb">isiku surnuks tunnistamise korral;</tavatekst></sisuTekst></alampunkt><alampunkt id="para8lg1p5"><alampunktNr id="c0e942cb-1a3d-42f9-8720-4a6de729874d">5</alampunktNr><kuvatavNr id="ca1ecd55-536b-45d3-8cb2-336a815ec220"><![CDATA[5) ]]></kuvatavNr><sisuTekst id="c70e69b2-8f01-4272-8e65-48b2f5f54a45"><tavatekst id="2eae8b88-8832-4bac-8e00-f5100a38c1da">kui matuse