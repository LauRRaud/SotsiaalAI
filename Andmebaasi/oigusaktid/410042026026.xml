   <paragrahvPealkiri id="c185f894-fdf6-4085-b313-0fb5777013c1">Toetuse arvestamise alused</paragrahvPealkiri>
  <loige id="para2lg1">
   <loigeNr id="0a7e6cf4-7bbd-46e1-b042-835dcf97dde2">1</loigeNr>
   <kuvatavNr id="211d01c6-e359-42e5-abca-ddfcfe8960c6"><![CDATA[(1)]]></kuvatavNr>
   <sisuTekst id="f2916bd9-a793-423d-8b72-d0683d8013ea">
    <tavatekst id="5726f5ac-d499-4fcd-abfa-dcb83d155016">Toimetulekutoetuse arvestamisel lähtutakse Vabariigi Valitsuse poolt kinnitatud eluruumi sotsiaalselt põhjendatud normist ning jooksval kuul tasumisele kuuluvad eluruumi tegelikud kulud käesoleva määruse paragrahvis 3 sätestatud piirmäärade ulatuses.</tavatekst>
   </sisuTekst>
  </loige><loige id="para2lg2">
