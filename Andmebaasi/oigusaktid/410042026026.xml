   <sisuTekst id="6f138299-7187-40a2-95ed-b3e7b52b648e">
    <tavatekst id="dd615007-ba6a-4f7a-81ff-d52ea3eb34ef">Määrusega kehtestatakse eluasemekulude piirmäärad toimetulekutoetuse arvestamisel Muhu vallas.</tavatekst>
   </sisuTekst>
  </loige></paragrahv><paragrahv id="para2">
   <paragrahvNr id="055bf688-3557-49d2-8aa5-89d78616d892">2</paragrahvNr>
