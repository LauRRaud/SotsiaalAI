				<muutmismarge id="84d3945a-18d1-4db7-9306-905451ad3798"><avaldamismarge id="5e7ce41d-2e69-4ba1-99ae-44167fa932eb"><RTosa id="e5d6f180-8306-4084-8daa-2b3175e9c4eb">RT IV</RTosa><avaldamineKuupaev id="65ba4159-475d-4f2d-af4b-5ebd01e2a772">2024-12-04</avaldamineKuupaev><RTartikkel id="ce76bbba-0af7-4abc-9178-b67e1baf7e46">17</RTartikkel><aktViide id="205d12e3-8b9a-400c-8509-71372aa9ba7c">404122024017</aktViide></avaldamismarge><joustumine id="8f87aded-6278-4f1e-8751-8cc5854839ca">2024-12-07</joustumine><tavatekst id="ed9c7571-f067-421a-afd3-ad64c4d02ece">, rakendatakse alates 01.12.2024</tavatekst></muutmismarge></alampunkt>
