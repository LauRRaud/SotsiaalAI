 <sisu id="1c448f30-a1ca-432c-9c61-c9af23741ced"><preambul id="bc86a124-2963-4f8e-aecf-f453b20aff5f"><tavatekst id="26749b64-c07d-4e37-85b6-e5c4f82e9f32">Määrus kehtestatakse kohaliku omavalitsuse korralduse seaduse § 22 lõike 1 punkti 5, sotsiaalhoolekande seaduse § 14, § 45<sup>5</sup> lõike 1 ja § 45<sup>15</sup> lõike 1 alusel.</tavatekst></preambul><peatykk id="f7f59f94-2a58-4e0f-ac05-93e0caaf668a"><peatykkNr id="bca3658f-64e5-4b9e-9a7f-76c632c88f47">1</peatykkNr><kuvatavNr id="05da072f-cc6c-49ff-8e82-3845c458afe3"><![CDATA[1. peatükk]]></kuvatavNr><peatykkPealkiri id="f1f8c785-13e1-41dc-bfc2-6e4279e81d4a">Üldsätted</peatykkPealkiri><paragrahv id="para1"><paragrahvNr id="d6d314a3-6eec-4424-8a2d-4f2302b05b35">1</paragrahvNr><kuvatavNr id="ac0aa494-0d57-49f2-a4bf-48aba32a9872"><![CDATA[§ 1. ]]></kuvatavNr><paragrahvPealkiri id="44ede9c5-ed5a-4b63-8681-63f65b8d03d3">Määruse reguleerimisala</paragrahvPealkiri><loige id="para1lg1"><loigeNr id="52a8f18c-dfb3-49b2-8e7b-001a71a7fd67"/><kuvatavNr id="385cccdd-05d4-414a-8124-bffbbd36721a"/><sisuTekst id="8ae33d3c-20c0-48ca-b3d5-108e60a9cb26"><tavatekst id="c1fa8a79-f71e-47fb-b04b-105e848bcda5">Määrusega kehtestatakse asendus- ja järelhooldusteenuse korraldamise ja rahastamise tingimused ja kord.</tavatekst></sisuTekst></loige></paragrahv><paragrahv id="para2"><paragrahvNr id="81eb4562-6385-4c0b-884c-2362fbb2e2c9">2</paragrahvNr><kuvatavNr id="204864c1-9d38-4ade-ad15-55557b1b16a7"><![CDATA[§ 2. ]]></kuvatavNr><paragrahvPealkiri id="b55c4d49-8e62-4db5-a3db-2824c3be2df3">Asendushooldusteenuse eesmärk</paragrahvPealkiri><loige id="para2lg1"><loigeNr id="009b14d3-e767-4d5e-bb6c-9613a0f22042"/><kuvatavNr id="7d43cb7e-1218-42ca-81ed-70e2546ee41d"/><sisuTekst id="8acca383-811a-4413-97ab-f86d8aea1d22"><tavatekst id="67d304ed-54a8-429a-9c03-c055d5fd4eb6">Asendushooldusteenuse eesmärk on pika- või lühiajaliselt lapse heaolu ja õiguste tagamine, lapsele tema põhivajaduste rahuldamiseks peresarnaste elutingimuste võimaldamine, lapsele turvalise ja arenguks soodsa elukeskkonna loomine ning lapse ettevalmistamine võimetekohaseks toimetulekuks täisealisena.</tavatekst></sisuTekst></loige></paragrahv><paragrahv id="para3"><paragrahvNr id="baeb290f-3b15-4411-bd54-085a118bb7b8">3</paragrahvNr><kuvatavNr id="502568bb-8f27-4611-b60b-c4ac1a2e00ac"><![CDATA[§ 3. ]]></kuvatavNr><paragrahvPealkiri id="c494dd3e-267d-47c5-aa8b-7740f083a463">Järelhooldusteenuse eesmärk</paragrahvPealkiri><loige id="para3lg1"><loigeNr id="bac67005-cdc4-48eb-b033-665480bcfc8a"/><kuvatavNr id="d14c39e1-1095-478d-8fd5-9ab2e16e1a4b"/><sisuTekst id="2ff41c61-60b6-441d-b32c-95003b74cf9d"><tavatekst id="3ce40a7b-b473-4bc5-89fd-fded5011234a">Järelhooldusteenuse eesmärk on asendushoolduselt ja eestkostelt lahkuva isiku iseseisva toimetuleku ja õpingute jätkamise toetamine.</tavatekst></sisuTekst></loige></paragrahv></peatykk><peatykk id="e189a10a-bbd2-4da3-b5da-77e8b4ec21f4"><peatykkNr id="ac9b9d31-1367-480f-9c72-2ce4cbab1151">2</peatykkNr><kuvatavNr id="c20a52db-0ed8-428a-9081-81b1cce74afe"><![CDATA[2. peatükk]]></kuvatavNr><peatykkPealkiri id="6b402f5a-76ed-43e8-87a2-76f1f2c3e0db">Teenuse kirjeldus</peatykkPealkiri><paragrahv id="para4"><paragrahvNr id="24ecd89e-f900-40e5-bad5-b1fd811c7efd">4</paragrahvNr><kuvatavNr id="fa252a40-32d6-4a48-84ce-c1a021a7eb74"><![CDATA[§ 4. ]]></kuvatavNr><paragrahvPealkiri id="ae741a1d-d87b-4721-a540-66ab325d117f">Teenuse osutaja</paragrahvPealkiri><loige id="para4lg1"><loigeNr id="ec3c8021-aeb5-4cba-a0a3-6e8ef4875b47">1</loigeNr><kuvatavNr id="dd0adc25-6f1d-456f-80e9-1bb41ff835ea"><![CDATA[(1)]]></kuvatavNr><sisuTekst id="5859c23f-8917-47da-a154-b1abd674519e"><tavatekst id="a47d580b-0c76-4a55-a00a-2f3a9b154653">Asendushooldusteenust osutavad hoolduspere, perekodu ja asenduskodu (edaspidi teenuseosutaja).</tavatekst></sisuTekst></loige><loige id="para4lg2"><loigeNr id="6700b33d-2790-4ef9-962b-b1ad53a9be7a">2</loigeNr><kuvatavNr id="adb10bb7-d964-4db6-a9b4-7878b643cd93"><![CDATA[(2)]]></kuvatavNr><sisuTekst id="68b9d75a-08cd-46ca-af62-bedc968f885c"><tavatekst id="163a60c8-0878-4385-b72d-835f0d20f71a">Järelhooldusteenust osutab Haljala vallavalitsus (edaspidi vallavalitsus) või korraldab teenuse osutamise teiste teenuseosutajate kaudu.</tavatekst></sisuTekst></loige></paragrahv><paragrahv id="para5"><paragrahvNr id="06d98f26-9525-4400-91aa-1ff23fe364fe">5</paragrahvNr><kuvatavNr id="ca06e58b-d10a-4d8c-8924-0503506b0b05"><![CDATA[§ 5. ]]></kuvatavNr><paragrahvPealkiri id="dbffc4e5-d354-4760-bbe8-453ea5c2a8c3">Teenuse saaja</paragrahvPealkiri><loige id="para5lg1"><loigeNr id="0ce6b2e6-237e-485c-a07b-4978418a0ec2">1</loigeNr><kuvatavNr id="32bbc97f-31d8-4a97-aff4-f51544b1d2d5"><![CDATA[(1)]]></kuvatavNr><sisuTekst id="43c81cad-e561-4b06-a597-e6f68e87405d"><tavatekst id="bd7a5839-2ea9-4534-babc-ddfba6ade1b4">Vallavalitsus tagab lapsele asendushooldusteenuse kuni lapse 18-aastaseks saamiseni, kui:</tavatekst></sisuTekst><alampunkt id="para5lg1p1"><alampunktNr id="d3a3a1d1-1391-4c29-9974-6b55144a1670">1</alampunktNr><kuvatavNr id="7cbc35be-bb2c-4af2-ac8d-50e0da908c45"><![CDATA[1) ]]></kuvatavNr><sisuTekst id="1f019e7d-1a8f-491f-94a1-40d959496ede"><tavatekst id="f6eb5cff-d94b-4544-a340-ed506fd2a97e">lapse vanem on surnud;</tavatekst></sisuTekst></alampunkt><alampunkt id="para5lg1p2"><alampunktNr id="6857a25f-6520-4737-8ea3-c741adf520b5">2</alampunktNr><kuvatavNr id="1159e88e-6308-44e3-8452-383958347ad1"><![CDATA[2) ]]></kuvatavNr><sisuTekst id="b4754f44-29eb-4359-8f8e-640320a42e93"><tavatekst id="f85f89f3-d5b8-4077-bb73-eab074f1f162">lapse vanemale on tema piiratud teovõime tõttu määratud eestkostja;</tavatekst></sisuTekst></alampunkt><alampunkt id="para5lg1p3"><alampunktNr id="4c9f8f42-9325-4e3c-b8fc-f52d8625a6d8">3</alampunktNr><kuvatavNr id="f69e2f4c-e4d4-45d1-a112-b2e848ed6209"><![CDATA[3) ]]></kuvatavNr><sisuTekst id="e59e6335-b8bc-4f7d-84e9-34a59ef58bc2"><tavatekst id="8ce0c7fb-f0d4-4456-a162-ecb6ce66bc84">vanema hooldusõigus lapse suhtes on peatatud, seda on piiratud või see on täielikult ära võetud;</tavatekst></sisuTekst></alampunkt><alampunkt id="para5lg1p4"><alampunktNr id="7c85e7b9-60a6-4d83-903c-c0e9a8ea61e9">4</alampunktNr><kuvatavNr id="3e895f2c-7c3c-48b1-a509-00a0731e79a9"><![CDATA[4) ]]></kuvatavNr><sisuTekst id="4a784b9a-8948-44f2-bce6-a058768b23ad"><tavatekst id="264fee4e-97b6-41b6-986f-4b7a12f4f383">laps on vanemast eraldatud.</tavatekst></sisuTekst></alampunkt></loige><loige id="para5lg2"><loigeNr id="b581dfec-233c-4fb7-ab31-84c84fc801f6">2</loigeNr><kuvatavNr id="fa072c24-146b-4e5c-918e-d590964c327c"><![CDATA[(2)]]></kuvatavNr><sisuTekst id="3acda92b-168a-4ad8-91e2-c683dc61a5f9"><tavatekst id="7ec31082-c0c0-488f-8853-a8efb681dbd4">Kui käesoleva paragrahvi lõikes 1 nimetatud laps on enne 18-aastaseks saamist asunud õppima ja jätkab õppimist statsionaarses õppes või tervislikel näidustustel muus õppevormis põhikoolis, gümnaasiumis või kutseõppe tasemeõppes, siis tagab vallavalitsus lapsele asendushooldusteenuse:</tavatekst></sisuTekst><alampunkt id="para5lg2p1"><alampunktNr id="79db5f1d-9823-4f2a-8886-7a27ee30c38f">1</alampunktNr><kuvatavNr id="bd9c364e-cae5-4283-89de-2edfc80e7a89"><![CDATA[1) ]]></kuvatavNr><sisuTekst id="d5c0af50-e0b8-43e5-a3e7-4a3101c764b5"><tavatekst id="d00c3442-27ae-4401-8c27-a6f17b35e44b">hariduse omandamise korral kuni järgmise õppeaasta alguseni, kuid mitte kauem kui järgmise õppeaasta alguseni sel aastal, kui laps sai 19-aastaseks;</tavatekst></sisuTekst></alampunkt><alampunkt id="para5lg2p2"><alampunktNr id="9f8dfb38-e2f8-4d2b-ba84-3a61071a073e">2</alampunktNr><kuvatavNr id="ad959174-ab2b-4ae4-a931-ace7e8b89ebf"><![CDATA[2) ]]></kuvatavNr><sisuTekst id="3bf0c20e-4935-49ea-8798-9bae824fe592"><tavatekst id="a2e5a876-67fb-49e0-a435-b9ebac15e635">õpingute katkestamiseni, kuid mitte kauem kui lapse 19-aastaseks saamiseni, või</tavatekst></sisuTekst></alampunkt><alampunkt id="para5lg2p3"><alampunktNr id="d5c53142-8a6f-44a4-b31b-c74d15866e35">3</alampunktNr><kuvatavNr id="f6ee53b5-bf77-4b33-ad11-8f6af9f9b244"><![CDATA[3) ]]></kuvatavNr><sisuTekst id="cfe8bf10-289c-48ce-8737-812fa57f9193"><tavatekst id="7fb9e812-aca6-431a-ad8f-6060ff61fa05">lapse 19-aastaseks saamise korral kuni järgmise õppeaasta alguseni.</tavatekst></sisuTekst></alampunkt></loige><loige id="para5lg3"><loigeNr id="3ee2a534-c9f4-429a-a2b0-0b7a529b4923">3</loigeNr><kuvatavNr id="0ec2335d-1e92-4f9c-88da-12c26a260f51"><![CDATA[(3)]]></kuvatavNr><sisuTekst id="d3b05359-8fc3-474d-b5c5-aa1462b0f482"><tavatekst id="3cc53eb1-c67b-4d87-86e6-1c70efb177e4">Vallavalitsus võib tagada asendushooldusteenuse abivajavale lapsele, kelle hooldusõiguslik vanem või füüsilisest isikust eestkostja on andnud nõusoleku, et asendushooldusteenust osutatakse kuni 90 päeva või periooditi.</tavatekst></sisuTekst></loige><loige id="para5lg4"><loigeNr id="e01acd49-77c2-4c47-8e63-d464de9e0ef5">4</loigeNr><kuvatavNr id="e2906380-5bfc-4976-a1ac-ee46b1d9d5dd"><![CDATA[(4)]]></kuvatavNr><sisuTekst id="04d11ae3-f1fd-4a1c-bc47-9ea810815536"><tavatekst id="3f1aeeab-494a-4a2b-9de7-0dabbea5fe21">Vallavalitsus tagab järelhooldusteenuse asendushooldusel viibivale täisealisele isikule, kes pärast põhi-, kesk-, kutse- või kõrghariduse omandamist jätkab järgmisel õppeaastal õppimist kutseõppe tasemeõppes, rakenduskõrgharidusõppes, ülikooli bakalaureuse- või magistriõppes või bakalaureuse- ja magistriõppe integreeritud õppes:</tavatekst></sisuTekst><alampunkt id="para5lg4p1"><alampunktNr id="89812c72-994e-4899-90f0-435d8020e5d8">1</alampunktNr><kuvatavNr id="1e5a06ce-e924-4634-8911-5df4175915c2"><![CDATA[1) ]]></kuvatavNr><sisuTekst id="a428fd9f-7040-4d32-9863-9125c5e6be8f"><tavatekst id="fb2e33ec-e363-4d38-a683-d8594319a49b">esmase õppekavajärgse nominaalse õppeaja lõpuni, kuid mitte kauem kui isiku 25-aastaseks saamiseni;</tavatekst></sisuTekst></alampunkt><alampunkt id="para5lg4p2"><alampunktNr id="decb4285-6f8c-4e49-b3b3-f025c8c5a489">2</alampunktNr><kuvatavNr id="eb380ddf-e98c-4414-bc9c-4e5af5f4a628"><![CDATA[2) ]]></kuvatavNr><sisuTekst id="3b5bcfc1-fbb2-482b-b01e-b5b77a8c70a1"><tavatekst id="60222962-b29d-49b2-aa01-b963120b4095">õpingute katkestamiseni, kuid mitte kauem kui isiku 25-aastaseks saamiseni, või</tavatekst></sisuTekst></alampunkt><alampunkt id="para5lg4p3"><alampunktNr id="0ffd2db0-b116-402d-897a-eec210bd9f7e">3</alampunktNr><kuvatavNr id="bb4ede24-4bc0-47d5-b94b-c248c2c9b326"><![CDATA[3) ]]></kuvatavNr><sisuTekst id="076a8d22-997a-449b-bbc2-8aa598fc379a"><tavatekst id="d0afd20e-389b-415e-9660-375c901871d7">isiku 25-aastaseks saamiseni.</tavatekst></sisuTekst></alampunkt></loige><loige id="para5lg5"><loigeNr id="232b90f2-c967-4cbe-be10-176d712e19ce">5</loigeNr><kuvatavNr id="d13a2984-7619-409e-b665-de2bea1b9dce"><![CDATA[(5)]]></kuvatavNr><sisuTekst id="e3b32faf-ef0d-4f93-b3cf-6751c6765829"><tavatekst id="f732077f-ffa0-4911-b100-a7422f880d6d">Vallavalitsus võib tagada järelhooldusteenuse isikule, kes:</tavatekst></sisuTekst><alampunkt id="para5lg5p1"><alampunktNr id="a38cb62b-2651-4d0c-b9bb-4b0429628c22">1</alampunktNr><kuvatavNr id="7a4cac64-8962-42ed-94e3-71afd34d0627"><![CDATA[1) ]]></kuvatavNr><sisuTekst id="94ad22e5-7afc-4100-a2b8-be82ed0c2f9c"><tavatekst id="89a50d5d-8190-4c63-81f9-44a9792aa69e">on kuni 21-aastane ega õpi ning kes kuni täisealiseks saamiseni viibis asendushooldusel või eestkostel;</tavatekst></sisuTekst></alampunkt><alampunkt id="para5lg5p2"><alampunktNr id="7eaad948-34d0-4a40-9a64-d8dae9904a74">2</alampunktNr><kuvatavNr id="037f5077-d225-480f-99e0-723f9ec8c87e"><![CDATA[2) ]]></kuvatavNr><sisuTekst id="c394e9af-7f1e-4366-99f0-6015cd2cd68c"><tavatekst id="dc626fe5-badd-43c6-a786-5a19cada9ccc">on kuni 25-aastane ja õpib ning kes kuni täisealiseks saamiseni viibis eestkostel ja pärast põhi-, kesk-, kutse- või kõrghariduse omandamist jätkas järgmisel õppeaastal õppimist kutseõppe tasemeõppes, rakenduskõrgharidusõppes, ülikooli bakalaureuse- või magistriõppes või bakalaureuse- ja magistriõppe integreeritud õppes.</tavatekst></sisuTekst></alampunkt></loige></paragrahv></peatykk><peatykk id="599b75f9-3ee9-4760-a03f-d30301f8d930"><peatykkNr id="8a9710be-5d7f-4c9d-aa81-80e655543bb9">3</peatykkNr><kuvatavNr id="0e992be3-7bcb-4c7e-8881-2871d163f7ef"><![CDATA[3. peatükk]]></kuvatavNr><peatykkPealkiri id="46beca7d-0e0b-4c9d-957e-fbf467c6ee23">Teenuse osutamine</peatykkPealkiri><paragrahv id="para6"><paragrahvNr id="81901df3-6dce-41b3-961c-0dbcd5514d3f">6</paragrahvNr><kuvatavNr id="6eb62ed3-0526-4112-b8bc-ec90e36c37d8"><![CDATA[§ 6. ]]></kuvatavNr><paragrahvPealkiri id="afb28b00-ab25-4986-a030-e2f9e3b65daf">Teenuse vajaduse hindamine ja teenusele suunamine</paragrahvPealkiri><loige id="para6lg1"><loigeNr id="3a588119-e1ff-4f4f-90b3-a1046041016c">1</loigeNr><kuvatavNr id="86f53df8-47df-4427-8856-84932eccea94"><![CDATA[(1)]]></kuvatavNr><sisuTekst id="134555e2-6c3f-4f40-bbbb-952c6b952a8c"><tavatekst id="d2fa9c52-0258-4933-a2f8-04ba1ba2e1ff">Käesoleva korra paragrahvi 5 lõigetes 1 ja 2 nimetatud lapse asendushooldusteenusele suunamisel hindab vallavalitsus lapse heaolust lähtuvalt asendushooldusteenuse osutamise vajadust ning teeb põhjendatud otsuse asendushooldusteenuse osutaja valikul (hoolduspere, perekodu või asenduskodu).</tavatekst></sisuTekst></loige><loige id="para6lg2"><loigeNr id="074b579f-77ae-4a5a-84e0-d73744f2cbaa">2</loigeNr><kuvatavNr id="40eb72ff-eddf-4189-b4b4-45521692313b"><![CDATA[(2)]]></kuvatavNr><sisuTekst id="81c0ce25-9112-4ef7-86b2-274b99de50e7"><tavatekst id="8cc9b521-b847-4931-9237-dfeaa3f0bd5c">Käesoleva korra paragrahvi 5 lõikes 3 nimetatud lapse asendushooldusteenusele suunamisel hindab vallavalitsus lapse abivajadusest ja heaolust lähtuvalt teenuse osutamise vajadust ning suunab lapse teenusele hooldusõigusliku vanema või füüsilisest isikust eestkostja nõusolekul.</tavatekst></sisuTekst></loige><loige id="para6lg3"><loigeNr id="d585833c-2c99-4493-aea2-af9a76de5e80">3</loigeNr><kuvatavNr id="356b04b8-45f0-4a94-9f98-a3696637914b"><![CDATA[(3)]]></kuvatavNr><sisuTekst id="5093a455-371a-4344-96c9-59ad61ff22c4"><tavatekst id="162fcd90-3cf2-4dd7-a81c-5c492f233f16">Käesoleva korra paragrahv 5 lõigetes 4 ja 5 nimetatud täisealise isiku järelhooldusteenusele suunamisel hindab vallavalitsus isiku abivajadust ja sellest lähtudes otsustab osutatava teenuse sisu üle.</tavatekst></sisuTekst></loige><loige id="para6lg4"><loigeNr id="d39b021b-2684-4016-b311-54ef8d05af16">4</loigeNr><kuvatavNr id="a5f27311-0009-4e34-9558-10241c46fd33"><![CDATA[(4)]]></kuvatavNr><sisuTekst id="ecb90182-3081-4940-a53f-f81db37462dd"><tavatekst id="10860b32-42aa-4a9d-8b8c-706297a1de63">Käesoleva paragrahvi lõigetes 1-3 nimetatud isikute puhul teeb vallavalitsus otsuse teenusele suunamise kohta ning kannab isikule teenuse osutamise andmed sotsiaalteenuste ja -toetuste andmeregistrisse STAR sotsiaalhoolekande seaduse § 144 lõike 1 punkt 5 alusel.</tavatekst></sisuTekst></loige><loige id="para6lg5"><loigeNr id="dda6ce8d-7544-4402-b00a-439f39b57fdc">5</loigeNr><kuvatavNr id="ebd6c43e-c8df-4e9b-90c4-3ce5118c56dd"><![CDATA[(5)]]></kuvatavNr><sisuTekst id="00fb8326-e6d7-4a84-91a1-87a65c832fce"><tavatekst id="c3c92ed6-a7de-4f7f-87f6-b192412d1f3d">Teenuse saaja ja võimalusel tema vanem või füüsilisest isikust eestkostja peab olema kaasatud teenuse vajaduse hindamise ja teenusele suunamise protsessi.</tavatekst></sisuTekst></loige></paragrahv><paragrahv id="para7"><paragrahvNr id="2cea5430-f161-4967-a147-81b938073875">7</paragrahvNr><kuvatavNr id="53800fe2-9daf-4069-8b96-6dcba6f33ccd"><![CDATA[§ 7. ]]></kuvatavNr><paragrahvPealkiri id="8f902103-2d52-4ce2-a94a-a56e6a94f640">Teenuse rahastamine</paragrahvPealkiri><loige id="para7lg1"><loigeNr id="a49ad66e-15f6-4147-8632-4d192d8f4650">1</loigeNr><kuvatavNr id="98c166b6-6445-4841-9fda-e2cb43d5751d"><![CDATA[(1)]]></kuvatavNr><sisuTekst id="be208f7f-fd13-44c3-a988-f38da547e2f9"><tavatekst id="934301f2-9fae-497f-ac8d-05eaa3dfa631">Asendushooldusteenust käesoleva korra paragrahvi 5 lõigetes 1 ja 2 nimetatud lapsele rahastatakse vallavalitsuse eelarvest ning asendushooldusteenusel oleva lapse sissetulekutest.</tavatekst></sisuTekst></loige><loige id="para7lg2"><loigeNr id="c4c539bc-13e8-4bec-b1d3-05db470d9f0d">2</loigeNr><kuvatavNr id="b37dc357-9864-4a21-9d33-a9f93dd3e243"><![CDATA[(2)]]></kuvatavNr><sisuTekst id="9c6ad716-0c0d-4848-bd21-dd2b7673adb9"><tavatekst id="9aaa69bc-8e2b-4f6a-a7a7-90b8aa4fdac8">Asendushooldusteenust käesoleva korra paragrahvi 5 lõikes 3 nimetatud lapsele võib rahastada vallavalitsuse eelarvest ja lapse ülalpidamiskohustusliku isiku vahenditest.</tavatekst></sisuTekst></loige><loige id="para7lg3"><loigeNr id="28400ff8-7204-498c-89d2-694a8160a125">3</loigeNr><kuvatavNr id="10beff4b-e55f-423e-89b0-dee0fd35e7ba"><![CDATA[(3)]]></kuvatavNr><sisuTekst id="7ab083b0-45c1-4dbc-bc5b-b3460d415969"><tavatekst id="26531011-af17-4741-b115-7325d2fa98d0">Järelhooldusteenust rahastatakse vallavalitsuse eelarvest ning teenusel oleva täisealise isiku sissetulekutest.</tavatekst></sisuTekst></loige><loige id="para7lg4"><loigeNr id="5de3adda-23c7-4bd9-9ed7-809d2cf939b6">4</loigeNr><kuvatavNr id="ff653d89-88f2-4ce9-9791-503a05b98f20"><![CDATA[(4)]]></kuvatavNr><sisuTekst id="9a9c5de6-8824-4f70-a17f-e6632f1a618e"><tavatekst id="609df422-e641-4b2c-bc91-c32fbc95b593">Teenuse saaja isiklike kulude katteks peab vallavalitsus eelarvest iga kuu tegema kulutusi vähemalt sotsiaalhoolekande seaduses sätestatud määras.</tavatekst></sisuTekst></loige><loige id="para7lg5"><loigeNr id="602f83bd-5f80-48a5-83cc-5cbd9c28298e">5</loigeNr><kuvatavNr id="dd61a25b-f05b-4dc5-9103-6bd6bc477c92"><![CDATA[(5)]]></kuvatavNr><sisuTekst id="1d7be00b-cc73-4a90-a335-c5f5daedd26b"><tavatekst id="2c075f69-7377-4407-a096-7e81530805ba">Käesoleva paragrahvi lõikes 4 nimetatud summa fikseeritakse teenuse osutamise lepingus ning kantakse teenuse osutaja arvelduskontole, erandina võib järelhooldusel viibiva isiku puhul kokku leppida summa kandmise teenuse saaja arvelduskontole.</tavatekst></sisuTekst></loige><loige id="para7lg6"><loigeNr id="c3ecda23-26be-4d0c-b8d5-9311b8743614">6</loigeNr><kuvatavNr id="db3238b7-fc63-41ee-9c94-fe66ec75c1c4"><![CDATA[(6)]]></kuvatavNr><sisuTekst id="fe0e0776-8e20-49ce-a959-78d2cd91dfc6"><tavatekst id="d9f62bed-7ab9-42be-a44d-628a1770ec1d">Vallavalitsus toetab hoolduspere vanemat, kes hooldab vähemalt nelja last, vähemalt Vabariigi Valitsuse poolt kehtestatud töötasu alammääras. Ühe lapse hooldamisel toetatakse hoolduspere vanemat vähemalt ühe neljandiku ulatuses nimetatud töötasu alammäärast.</tavatekst></sisuTekst></loige><loige id="para7lg7"><loigeNr id="8a35f287-18c1-492f-ae02-ab66856fcd22">7</loigeNr><kuvatavNr id="78403b9e-efc5-42b5-bdeb-81ab72e7e787"><![CDATA[(7)]]></kuvatavNr><sisuTekst id="54c52b1d-e180-4ff8-a8a1-8b94f067a6c3"><tavatekst id="775a6819-953b-4a5c-b55b-8e39593f26d2">Lapse ülalpidamisest ja erivajadustest tulenevaid lisavajadusi rahastab vallavalitsus lapsele riigieelarvest igakuiseks ülalpidamiseks ja puudest tingitud lisakulude osaliseks hüvitamiseks ette nähtud sissetulekutest.</tavatekst></sisuTekst></loige><loige id="para7lg8"><loigeNr id="ecb05806-eac9-4810-b168-158269588420">8</loigeNr><kuvatavNr id="15d073cd-e9b2-4cd0-bb08-4398c5af7dde"><![CDATA[(8)]]></kuvatavNr><sisuTekst id="51618241-f3c6-4f9a-95a7-654aab39306e"><tavatekst id="08fd5ead-ece6-472c-b9d8-3a194ba0a455">Teenuse osutaja muud kulutused teenuse osutamiseks lepitakse kokku vallavalitsuse ja teenuse osutaja vahel ning fikseeritakse teenuse osutamise lepingus.</tavatekst></sisuTekst></loige><loige id="para7lg9"><loigeNr id="e5ec9420-b296-4b7d-b1c4-445d3e270ffe">9</loigeNr><kuvatavNr id="90dea4e9-9629-43fb-800b-11b61138ff05"><![CDATA[(9)]]></kuvatavNr><sisuTekst id="4d5b6028-f24a-48bd-a07c-087231886e6a"><tavatekst id="3e017d9d-8115-4993-a49f-883c329dbaba">Teenuse osutaja muude kulude kokkuleppimisel arvestatakse teenuse saaja teenusel viibimise kestvust, õppimist väljaspool teenuse osutamise asukohta ja ülalpidamist riigi või kohaliku omavalitsuse eelarvest.</tavatekst></sisuTekst></loige></paragrahv><paragrahv id="para8"><paragrahvNr id="4514659c-a655-46fe-8406-850b85046c6a">8</paragrahvNr><kuvatavNr id="e52a3ce6-1afe-405e-8a79-2b505699811a"><![CDATA[§ 8. ]]></kuvatavNr><paragrahvPealkiri id="cb21c0dd-9bc2-46c8-b824-c4ad2bd147f5">Teenusele suunamise otsustamine ja lepingu sõlmimine</paragrahvPealkiri><loige id="para8lg1"><loigeNr id="20a593ee-f7bd-4728-83ec-fd07a8279ec5">1</loigeNr><kuvatavNr id="cee7e8f0-d230-4b8b-86fe-026109acb6b4"><![CDATA[(1)]]></kuvatavNr><sisuTekst id="da3ac12b-bdc9-4478-83c0-6aedb448da11"><tavatekst id="844353f3-2c84-4215-9d47-490042f34f75">Asendushooldus- ja järelhooldusteenusele suunamiseks annab Haljala Vallavalitsus haldusakti, milles sätestatakse isikule osutatav teenus, teenuse saaja ja teenuse osutaja.</tavatekst></sisuTekst></loige><loige id="para8lg2"><loigeNr id="c7bb2b09-8214-44d6-aca9-74e975b5c73a">2</loigeNr><kuvatavNr id="d9c35cd6-cf8e-4470-aab1-d78e940a4408"><![CDATA[(2)]]></kuvatavNr><sisuTekst id="944517f7-5cdf-48b9-80b6-1caa975d829d"><tavatekst id="cbde0f3d-1db9-4efc-a624-5bb750fc4fee">Vallavalitsus sõlmib teenuseosutajaga lepingu enne teenuse saajale teenuse osutamise alustamist.</tavatekst></sisuTekst></loige><loige id="para8lg3"><loigeNr id="a5c0593f-fdef-44e6-90f2-3b0c908b3b30">3</loigeNr><kuvatavNr id="e79ead0b-1144-493f-8548-ba2ce13b865b"><![CDATA[(3)]]></kuvatavNr><sisuTekst id="be03fbe9-80b0-47bb-a67d-94166dcdc163"><tavatekst id="388960c1-1242-42a0-8a50-36881a9232c2">Järelhooldusteenuse lepingu sõlmimisel on teenuse saaja üheks lepingupooleks.</tavatekst></sisuTekst></loige><loige id="para8lg4"><loigeNr id="d01b2e52-7daa-4179-a2fd-81244cd42f77">4</loigeNr><kuvatavNr id="33cea1ce-709d-494a-a66f-2d5556b592dc"><![CDATA[(4)]]></kuvatavNr><sisuTekst id="2ce79503-a0cd-4282-aa0c-8ba457fed499"><tavatekst id="1eb3104a-14bf-4618-ab93-dccf81846b97">Lepinguga sätestatakse vähemalt teenuse saajale osutatava teenuse sisu, maht, kestvus, rahastamine, osapoolte õigused ja kohustused ning vajadusel muud teenuse osutamisega seotud asjaolud.</tavatekst></sisuTekst></loige><loige id="para8lg5"><loigeNr id="3841cb15-3cab-437a-831c-adb047cc2578">5</loigeNr><kuvatavNr id="91ef0dd4-437d-4ede-bb4e-16ea11db23ba"><![CDATA[(5)]]></kuvatavNr><sisuTekst id="2dce947e-c92e-4ae1-a2bd-69ea2833aac2"><tavatekst id="293234c2-7c35-4b3e-9036-6628e5fcc8f3">Asendushooldusele suunatud lapsele koostatud juhtumiplaan on asendushooldusteenuse osutamise lepingu lisa.</tavatekst></sisuTekst></loige></paragrahv><paragrahv id="para9"><paragrahvNr id="c2886e59-fce2-415b-88ae-6873d30f5102">9</paragrahvNr><kuvatavNr id="eaddc618-2a16-4f50-a744-628e850bf844"><![CDATA[§ 9. ]]></kuvatavNr><paragrahvPealkiri id="de9fb1d9-f7ba-4cae-bb08-f8b0af4d8c10">Lepingu lõppemine ja lõpetamine</paragrahvPealkiri><loige id="para9lg1"><loigeNr id="083aa711-7c63-4ba4-bb1d-4ef962474e75">1</loigeNr><kuvatavNr id="77cbb1d7-ac4c-4542-af7e-6844ec144d8c"><![CDATA[(1)]]></kuvatavNr><sisuTekst id="a053d40d-3a59-40bb-949f-2a9e8b10d46f"><tavatekst id="af3e1706-b02f-410e-b520-0781f22632c5">Leping lõpetatakse:</tavatekst></sisuTekst><alampunkt id="para9lg1p1"><alampunktNr id="cf45392f-cc30-48a6-9bbe-c5d2635192e8">1</alampunktNr><kuvatavNr id="19fe4b03-c0aa-4058-b58a-404a551cb6fa"><![CDATA[1) ]]></kuvatavNr><sisuTekst id="030afdd6-9f6b-41d1-8171-1bfe91e9af65"><tavatekst id="346867ac-b3dc-49c4-b57e-34377498f6ad">teenuse vajaduse äralangemisel;</tavatekst></sisuTekst></alampunkt><alampunkt id="para9lg1p2"><alampunktNr id="df1b464b-cea3-4394-9110-fd5759425ebc">2</alampunktNr><kuvatavNr id="1f19f992-5d1e-4f99-9b6a-1787393bb954"><![CDATA[2) ]]></kuvatavNr><sisuTekst id="ab187fea-c5f0-4d0f-baf8-a3a5585cce5b"><tavatekst id="8cf9f011-882e-41db-9592-3c22e0ef9485">lepingus sätestatud kohustuste täitmata jätmisel;</tavatekst></sisuTekst></alampunkt><alampunkt id="para9lg1p3"><alampunktNr id="db7f526b-c5c9-4199-a2f0-6c48ef5bec5c">3</alampunktNr><kuvatavNr id="4e0d0b5a-b7ff-4c67-9b5d-0659a0d3f329"><![CDATA[3) ]]></kuvatavNr><sisuTekst id="17663945-ae50-410f-a361-7edb8fa