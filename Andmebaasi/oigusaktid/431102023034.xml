 <sisu id="4f10cf08-2d2c-4668-93f1-bd7115e78033"><preambul id="db70a2df-7af5-441f-851d-467831bcd11c"><tavatekst id="6e6b6176-89b7-4b94-a6d6-25e51c1a2885">Määrus kehtestatakse sotsiaalhoolekande seaduse § 133 lõike 6 alusel.</tavatekst></preambul><paragrahv id="para1"><paragrahvNr id="c98b9e25-eefe-437a-b1e8-b473dcb7090d">1</paragrahvNr><kuvatavNr id="25b2c553-65e2-4986-95da-bc415ca10fd2"><![CDATA[§ 1. ]]></kuvatavNr><paragrahvPealkiri id="4a1e2e06-696f-48f5-99c1-c0bb885c15dc">Määruse reguleerimisala ja eesmärk</paragrahvPealkiri><loige id="para1lg1"><loigeNr id="7640c0d2-b62b-43b0-8ef3-f0924d23a677"/><kuvatavNr id="1e786d3f-10de-43d8-872a-6e2ebfffea0c"/><sisuTekst id="df0ccf2c-cbfc-46a3-a371-dc22858f2400"><tavatekst id="e94e8c70-ce60-4af7-ba61-890cf47db434">Määrusega kehtestatakse toimetulekutoetuse arvestamisel arvesse võetavate eluasemekulude piirmäärad.</tavatekst></sisuTekst></loige></paragrahv><paragrahv id="para2"><paragrahvNr id="62c03f80-3953-4ced-b8e3-9cfa3f5c7c93">2</paragrahvNr><kuvatavNr id="50859270-6736-4523-b372-7291cd33d271"><![CDATA[§ 2. ]]></kuvatavNr><paragrahvPealkiri id="bade264d-63e5-4de7-9688-225b1a4fbc8c">Eluasemekulude piirmäärad</paragrahvPealkiri><loige id="para2lg1"><loigeNr id="6737bfc1-1fad-4bb6-9e34-c031602b5696"/><kuvatavNr id="600c792e-943b-4890-9a8a-689333a27193"/><sisuTekst id="68b6fbf0-ccce-4353-ae8e-6c25b0c8acd6"><tavatekst id="bc74f777-7c08-4acf-ba7d-3c5d1e3a1d27">Toimetulekutoetuse määramisel võetakse arvesse jooksval kuul tasumisele kuuluvad eluasemekulud järgmiselt:</tavatekst></sisuTekst><alampunkt id="para2lg1p1"><alampunktNr id="fb5a481b-7e6b-4585-ad0d-71b4eb4d4958">1</alampunktNr><kuvatavNr id="31863ee9-7871-4498-9a30-879e9a9ca8d6"><![CDATA[1) ]]></kuvatavNr><sisuTekst id="e404c7bb-6fe0-496c-b7a0-d970e6c3af78"><tavatekst id="6f82aed1-bc5d-4756-9616-94193d5e686d">eluruumi üldpinnaga kuni 33,00 m² üür kuni 6,00 eurot 1 m² kohta kuus;</tavatekst></sisuTekst></alampunkt><alampunkt id="para2lg1p2"><alampunktNr id="b6388391-f979-45d4-8582-44c722359543">2</alampunktNr><kuvatavNr id="dcd47ab2-82d8-4ed3-b25f-fa252c2e8230"><![CDATA[2) ]]></kuvatavNr><sisuTekst id="6412d71f-fa78-4527-8ab4-2989118ec1e3"><tavatekst id="780d3e19-ae14-4758-85e8-9733a152c967">eluruumi üldpinnaga alates 33,01 m² üür kuni 5,00 eurot 1 m² kohta kuus;</tavatekst></sisuTekst></alampunkt><alampunkt id="para2lg1p3"><alampunktNr id="39ed3a98-29de-4ae3-a929-41acf5d9b768">3</alampunktNr><kuvatavNr id="2f035f39-fcfe-471b-a1cd-2ff5738e275c"><![CDATA[3) ]]></kuvatavNr><sisuTekst id="7ef2433c-c1e6-40a6-978f-e8ff25a746b9"><tavatekst id="4ad27a94-4c4f-4319-9127-9b300a90beb4">eluruumi üldpinnaga kuni 33,00 m² eluaseme soetamiseks võetud laenu tagasimakse, sealhulgas intressi ja eluasemekindlustuse makse, kulu kuni 6,00 eurot 1 m² kohta kuus;</tavatekst></sisuTekst></alampunkt><alampunkt id="para2lg1p4"><alampunktNr id="21696350-c18e-43ca-8fdb-ea57427813d5">4</alampunktNr><kuvatavNr id="0e539f76-73f3-459d-b3c0-8068ffe202f4"><![CDATA[4) ]]></kuvatavNr><sisuTekst id="85bcb0a5-b61c-4288-80d3-ac1a66eb0c44"><tavatekst id="f5db8b63-5cbb-4a10-ae48-a5ac16d46453">eluruumi üldpinnaga alates 33,01 m² eluaseme soetamiseks võetud laenu tagasimakse, sealhulgas intressi ja eluasemekindlustuse makse, kulu kuni 5,00 eurot 1 m² kohta kuus;</tavatekst></sisuTekst></alampunkt><alampunkt id="para2lg1p5"><alampunktNr id="931836ba-0bfb-4229-a2af-c81debb46441">5</alampunktNr><kuvatavNr id="bbe3e941-3155-4aa0-a961-b900744d357a"><![CDATA[5) ]]></kuvatavNr><sisuTekst id="ca08cc66-8a56-495b-ab5a-d3b2d9815124"><tavatekst id="51d5e3da-0bec-454e-abfb-cef9e26eb348">korterelamu haldamise kulu, sealhulgas remondiga seotud kulu kuni 3,00 eurot 1 m² kohta kuus;</tavatekst></sisuTekst></alampunkt><alampunkt id="para2lg1p6"><alampunktNr id="a68f9bfa-88a1-47c4-b816-60b188befe1d">6</alampunktNr><kuvatavNr id="e415a632-62c3-45cc-b3fe-cd796c7bbe0c"><![CDATA[6) ]]></kuvatavNr><sisuTekst id="35154f8c-f2a7-4145-9591-200c85e833b0"><tavatekst id="70fd1902-ad72-4e40-bba9-c37961a7e3e4">korterelamu renoveerimiseks võetud laenu tagasimakse kulu kuni 3,00 eurot 1 m² kohta kuus;</tavatekst></sisuTekst></alampunkt><alampunkt id="para2lg1p7"><alampunktNr id="c5393668-1b44-4e46-b9e6-83aab7e27aa0">7</alampunktNr><kuvatavNr id="2adec7c7-6c15-4d2e-b144-c5b6d7330d2d"><![CDATA[7) ]]></kuvatavNr><sisuTekst id="f3247ae4-8839-4170-ae04-2d343ff6a935"><tavatekst id="7f3c8b00-1054-4e4a-a574-6664482f652d">veevarustuse ja reovee ärajuhtimise teenuse maksumus ja/või kuivkäimlate ja septikute tühjendamine kuni 20,00 eurot iga pereliikme kohta kuus;</tavatekst></sisuTekst></alampunkt><alampunkt id="para2lg1p8"><alampunktNr id="72f72320-09f4-478c-93e6-b9ff70cb07b8">8</alampunktNr><kuvatavNr id="d52cce72-15a7-4eb9-b38a-68869bee7476"><![CDATA[8) ]]></kuvatavNr><sisuTekst id="7dacb1ed-40c9-4187-bac4-8fcab702c373"><tavatekst id="287a0014-751b-45f2-845a-d6ad596e1fbe">soojaveevarustuseks tarbitud soojusenergia või kütuse maksumus kuni 20,00 eurot iga pereliikme kohta kuus;</tavatekst></sisuTekst></alampunkt><alampunkt id="para2lg1p9"><alampunktNr id="114479fa-c1a6-4d81-ab5e-8f2c213787bc">9</alampunktNr><kuvatavNr id="8a632120-32ba-4d9f-8cee-b615e3161761"><![CDATA[9) ]]></kuvatavNr><sisuTekst id="7474206a-f04c-4e24-99a7-7c5d9212d671"><tavatekst id="10200269-4ad0-47ae-8c8c-c4c47b5a763e">kütteks tarbitud soojusenergia või kütuse maksumus kaugkütte korral kuni 5,00 eurot 1 m² normpinna kohta kuus. Juhul kui kuludokument sisaldab ka järgneva perioodi küttekulu, hüvitatakse see järgnevatel kuudel piirmäära ulatuses kuludokumendil näidatud summa hüvitamiseni või uue kuludokumendi esitamiseni;</tavatekst></sisuTekst></alampunkt><alampunkt id="para2lg1p10"><alampunktNr id="1308f47c-a84f-44ea-a83c-c6725b431c1f">10</alampunktNr><kuvatavNr id="e745371a-6a0c-4b1a-a068-b374519689dc"><![CDATA[10) ]]></kuvatavNr><sisuTekst id="465d8547-745c-4788-ada5-9140cdbe46d8"><tavatekst id="02631624-e328-4b19-a7ff-619320826de4">kütteks tarbitud soojusenergia või kütuse maksumus mittekaugkütte korral, sh küttematerjali ülestöötamise kulu, kuni 5,00 eurot 1 m² normpinna kohta kuus, kuid mitte rohkem kui 1500 eurot aastas. Juhul kui kuludokument sisaldab ka järgneva perioodi küttekulu, hüvitatakse see järgnevatel kuudel piirmäära ulatuses kuludokumendil näidatud summa hüvitamiseni või uue kuludokumendi esitamiseni;</tavatekst></sisuTekst></alampunkt><alampunkt id="para2lg1p11"><alampunktNr id="c4bd23d6-58b0-487c-8bc5-33ecaf0bd250">11</alampunktNr><kuvatavNr id="b3264f3e-95c5-4b81-9b64-9783ab7656de"><![CDATA[11) ]]></kuvatavNr><sisuTekst id="9c2392b8-694c-4810-8d02-88b5ba34c842"><tavatekst id="1d0567e0-d272-4bd9-9f4b-5a69ef2ca643">elektrienergia tarbimisega seotud kulu kuni 50,00 eurot perekonna esimese liikme kohta ja kuni 30,00 eurot iga järgneva pereliikme kohta kuus;</tavatekst></sisuTekst></alampunkt><alampunkt id="para2lg1p12"><alampunktNr id="22c8363b-5cdc-449a-9723-0ed6deee0094">12</alampunktNr><kuvatavNr id="c561cc2b-feb9-46da-9bfc-db5acc777e80"><![CDATA[12) ]]></kuvatavNr><sisuTekst id="0909c6c3-069a-46d6-965b-d6d247fb1e62"><tavatekst id="0dcd8e33-7b11-4153-8c6b-26c8ad99212d">majapidamisgaasi maksumus kuni 15,00 eurot perekonna kohta kuus;</tavatekst></sisuTekst></alampunkt><alampunkt id="para2lg1p13"><alampunktNr id="3c5574e0-2595-4a54-ac89-1ab268203821">13</alampunktNr><kuvatavNr id="f3ad83b3-7042-4057-9b35-5d6202943c81"><![CDATA[13) ]]></kuvatavNr><sisuTekst id="6e7d53fb-1dd8-41bd-bbb5-0a9fe899dbb9"><tavatekst id="4a2c28da-b27a-419c-a091-e6951ec24402">maamaksukulu, mille arvestamise aluseks on kolmekordne elamualune pind, kuni 0,20 eurot 1 m² normpinna kohta kuus;</tavatekst></sisuTekst></alampunkt><alampunkt id="para2lg1p14"><alampunktNr id="dee6c1d5-1af8-4a27-8edc-46ca6c8de050">14</alampunktNr><kuvatavNr id="4bc14e43-f390-4838-a145-4ce36a5627d5"><![CDATA[14) ]]></kuvatavNr><sisuTekst id="5fff1006-1a0c-404c-af91-675105397d41"><tavatekst id="abdb355f-efc5-4bfe-8eec-2aa561ec6b44">hoonekindlustuse kulu kuni 0,30 eurot 1 m² normpinna kohta kuus;</tavatekst></sisuTekst></alampunkt><alampunkt id="para2lg1p15"><alampunktNr id="e7c3f6d9-5997-460f-97dd-9967d7fe7030">15</alampunktNr><kuvatavNr id="b6f8a7a2-4506-42a9-b5ff-c9cda02ff643"><![CDATA[15) ]]></kuvatavNr><sisuTekst id="c88acbc3-7e47-4cfb-9469-b4baec73156d"><tavatekst id="813d1dea-a2f5-4e54-ac56-a91787991ee2">olmejäätmete veotasu kuni 7,00 eurot iga pereliikme kohta kuus.</tavatekst></sisuTekst></alampunkt></loige></paragrahv><paragrahv id="para3"><paragrahvNr id="de3a3cc4-9f14-495f-8860-87aba2d4bec8">3</paragrahvNr><kuvatavNr id="f1aab512-6fb7-4432-8a62-e80683c39ccb"><![CDATA[§ 3. ]]></kuvatavNr><paragrahvPealkiri id="7919a1c9-50d9-46b1-a4eb-93ca402b20cd">Määruse jõustumine</paragrahvPealkiri><loige id="para3lg1"><loigeNr id="6de133e7-da77-4da2-8519-bed84024d1a6"/><kuvatavNr id="6d52da6e-d1fc-4610-887b-81777377bff9"/><sisuTekst id="dadcd246-678a-40f9-8437-e41e8e019637"><tavatekst id="53211070-2ed4-407b-9677-ba0bd4f705a2">Määrus jõustub 1. jaanuaril 2024.</tavatekst></sisuTekst></loige></paragrahv></sisu>
