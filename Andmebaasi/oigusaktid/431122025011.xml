			<loige id="para2lg1">
				<loigeNr id="879f7977-dfe8-4eed-bc0a-0083a9691a35">1</loigeNr>
				<kuvatavNr id="99c24fd6-5e96-45d7-98f7-0da807646cc4"><![CDATA[(1)]]></kuvatavNr>
				<sisuTekst id="3740109e-5fa5-40ea-ac52-993d1ce93665">
					<tavatekst id="940678d3-a863-4fa0-958a-697326af64a3">Jõhvi Vallavalitsuse 13. juuni 2023 määrus nr 8 „Üldhooldusteenust vahetult osutavate töötajate kulude tasumise piirmäära kehtestamine“ tunnistatakse kehtetuks.</tavatekst>
				</sisuTekst>
			</loige>
			<loige id="para2lg2">
				<loigeNr id="a13ba9d7-6f47-4cbd-a6e3-1992d8d597e1">2</loigeNr>
