			<pealkiri id="ae478f70-3958-420b-a557-1a268ad6511b">Ruhnu valla täiendavate sotsiaaltoetuste maksmise kord</pealkiri>
		</nimi>
	</aktinimi>
	<muutmismarge id="a66abad9-212f-4cd6-ba48-722cdbd7edbb">
		<aktikuupaev id="f8a91924-bfb3-4422-abae-0a4f12d99956">2016-03-10</aktikuupaev>
		<avaldamismarge id="d295cd75-f679-4f16-a04c-c9f07e75b538">
			<RTosa id="ac721c3d-1af1-47ba-b53d-d5c9e52c0e76">RT IV</RTosa>
			<avaldamineKuupaev id="a998ba84-7b46-48e8-bce4-ac69be21ac21">2016-03-17</avaldamineKuupaev>
			<RTartikkel id="1548b8d9-bba0-4f3a-b0e9-66d662984703">3</RTartikkel>
