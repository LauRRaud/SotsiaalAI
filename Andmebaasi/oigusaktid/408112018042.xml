   <sisuTekst id="7cbb01b0-c554-430e-ac4e-366682c2362e">
    <tavatekst id="a6bad0df-87fa-499a-b591-19e2d837278c">nõustamisteenus (psühholoogiline nõustamine jm );</tavatekst>
   </sisuTekst>
  </alampunkt><alampunkt id="para2lg1p5">
   <alampunktNr id="ab097ae8-5606-4a63-8a7c-62c18dd6a38b">5</alampunktNr>
   <kuvatavNr id="583e8e52-5354-4c24-bc6a-2d629e0345a6"><![CDATA[5) ]]></kuvatavNr>
   <sisuTekst id="70e0a61b-e76f-47ef-9fb3-17e882fb0067">
    <tavatekst id="69458c22-8660-4358-8608-b0cf44066f3a">erinevad teraapiad;</tavatekst>
   </sisuTekst>
  </alampunkt><alampunkt id="para2lg1p6">
   <alampunktNr id="59a80b44-6d5b-4b1a-9457-30eb950ea83d">6</alampunktNr>
   <kuvatavNr id="53857f59-cacf-47d8-8ce1-c1d98787fbe7"><![CDATA[6) ]]></kuvatavNr>
   <sisuTekst id="c8c2b1ee-7055-4682-be17-647a33f0a42e">
    <tavatekst id="df26cb56-a8f7-4198-a012-4979245edd47">rehabilitatsiooniplaani tegevuskavas ette nähtud teenuste, sh abi- ja tugivahendite võimaldamine;</tavatekst>
   </sisuTekst>
  </alampunkt><alampunkt id="para2lg1p7">
   <alampunktNr id="64a57454-29ae-4b6a-bf25-b0a3f54020d5">7</alampunktNr>
   <kuvatavNr id="af1de71b-6366-46ee-b404-1fad22e14405"><![CDATA[7) ]]></kuvatavNr>
   <sisuTekst id="6e715875-bfc4-4fd8-bcc2-58c1df1a71f4">
    <tavatekst id="e34407e8-1298-4d30-98a6-966995cdf5cb">eluaseme kohandamine;</tavatekst>
   </sisuTekst>
  </alampunkt><alampunkt id="para2lg1p8">
   <alampunktNr id="4a4f379e-30bf-459c-a3e2-ff763322692b">8</alampunktNr>
   <kuvatavNr id="51348b2a-9840-4a52-ae72-b7a759bd4d80"><![CDATA[8) ]]></kuvatavNr>
   <sisuTekst id="e809a6c6-08cc-4dce-8039-9db2ec25cd59">
    <tavatekst id="cc137c61-f1b9-426d-a38d-a6ae38b0462e">laagri osalemiskulude katmine koolivaheajal;</tavatekst>
   </sisuTekst>
  </alampunkt><alampunkt id="para2lg1p9">
   <alampunktNr id="246977c6-96bd-4999-9d74-25aa16ae05cf">9</alampunktNr>
   <kuvatavNr id="5c675b94-a9cc-43fd-a258-495c6ee768d0"><![CDATA[9) ]]></kuvatavNr>
   <sisuTekst id="ff6ae233-ffa5-4188-b685-505776edf494">
    <tavatekst id="7b310a3d-e0da-4cf6-af5b-2a72cc5fd2e2">tugikoduteenuse eest tasumine;</tavatekst>
   </sisuTekst>
  </alampunkt><alampunkt id="para2lg1p10">
   <alampunktNr id="932dc861-34c0-4b82-b18d-e5ec489fa2e7">10</alampunktNr>
   <kuvatavNr id="37325737-4a2b-4e63-ad63-90f101f314bc"><![CDATA[10) ]]></kuvatavNr>
   <sisuTekst id="da18320a-5ad6-485f-b7e1-72d0d0255ff5">
    <tavatekst id="88f69503-cffe-4367-823f-da570a96d97d">muud teenused, mis toetavad ja parendavad raske ja sügava puudega lapse ja tema perekonna toimetulekut ning vähendavad perekonna hoolduskoormust või puudest tulenevaid lisavajadusi.</tavatekst>
   </sisuTekst>
  </alampunkt></loige></paragrahv><paragrahv id="para3">
   <paragrahvNr id="67dfff6a-7e8e-4bc5-9cec-f55fe6592650">3</paragrahvNr>
   <kuvatavNr id="4e038749-2217-4821-9405-83af1bef14bd"><![CDATA[§ 3. ]]></kuvatavNr>
   <paragrahvPealkiri id="119d55d8-1362-4574-ae62-8d62d074d9a8">Rakendussätted</paragrahvPealkiri>
  <loige id="para3lg1">
   <loigeNr id="1ac45828-426f-4cd4-a97b-6bf6e6be7a66"/>
   <kuvatavNr id="47980af6-6110-4ae1-9ac9-8aefce289cbd"/>
   <sisuTekst id="e31ceb70-b7fd-4cfe-89bb-b3620fee648a">
    <tavatekst id="869d05d1-d14c-4a09-81cd-65079fca510c">Riigieelarvest eraldatud toetust võib kasutada tagasiulatuvalt alates 1. jaanuarist 2018 osutatavate teenuste eest tasumisel.</tavatekst>
   </sisuTekst>
  </loige></paragrahv></sisu>
