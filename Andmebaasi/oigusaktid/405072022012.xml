	<sisu id="5b01d007-25bb-4c49-a0fc-555eb89025ba">
		<preambul id="e8fbeb47-6624-4cfd-aca3-dab0ee973fd3">
			<tavatekst id="3447cf0e-1308-4ea2-9718-2bbc24b18087">Määrus kehtestatakse sotsiaalhoolekandeseaduse § 133 lõigete 5 ja 6 alusel.</tavatekst>
		</preambul>
		<paragrahv id="para1">
			<paragrahvNr id="21817993-039d-43fc-a9be-16d5fe51d3e8">1</paragrahvNr>
			<kuvatavNr id="0019d924-8dc6-4477-9f24-215961aece00"><![CDATA[§ 1. ]]></kuvatavNr>
			<paragrahvPealkiri id="27808c5c-872c-464f-9c6e-e2cde1909212">Reguleerimisala</paragrahvPealkiri>
			<loige id="para1lg1">
				<loigeNr id="24dca573-f013-4ac9-bb7b-0f34ca1faece">1</loigeNr>
				<kuvatavNr id="b4222b69-e94b-4066-a350-5f56eb98452b"><![CDATA[(1)]]></kuvatavNr>
				<sisuTekst id="b551bb54-4267-4622-bf81-56dd00076c2b">
					<tavatekst id="e6094514-cf9b-4163-a141-4d3b69a8c922"> Käesoleva määrusega kehtestatakse eluruumi alaliste kulude piirmäärad toimetulekutoetuse määramiseks Rakvere vallas.</tavatekst>
				</sisuTekst>
			</loige>
			<loige id="para1lg2">
				<loigeNr id="47068621-b7b9-46f1-a7ba-91cbfd0cda9e">2</loigeNr>
				<kuvatavNr id="4154d4d4-d78c-408c-b33d-385eee6886b1"><![CDATA[(2)]]></kuvatavNr>
				<sisuTekst id="bce84f36-dcc7-437c-8491-597db799718f">
					<tavatekst id="34e6e2aa-a06a-4651-a3b4-066adbb7b28d"> Toimetulekutoetuse määramisel võetakse arvesse:</tavatekst>
				</sisuTekst>
				<alampunkt id="para1lg2p1">
					<alampunktNr id="97b0a3dd-86e8-42cc-b295-a783424a131d">1</alampunktNr>
					<kuvatavNr id="0892b44e-8077-49f5-8922-e5035155a4b1"><![CDATA[1) ]]></kuvatavNr>
					<sisuTekst id="cc5b8732-2597-4c72-bc7d-15d2f7189a0f">
						<tavatekst id="6314e57c-f70d-4dae-871b-8a5af5a271d9">Vabariigi Valitsuse kinnitatud eluruumi sotsiaalselt põhjendatud norm, mis on 18 m<sup>2</sup>üldpinda iga pereliikme kohta ja lisaks 15 m<sup>2</sup> perekonna kohta;</tavatekst>
					</sisuTekst>
				</alampunkt>
				<alampunkt id="para1lg2p2">
					<alampunktNr id="70d74809-044c-44b5-807f-716a5793174a">2</alampunktNr>
					<kuvatavNr id="f47b8715-cd34-4a84-88a8-df75ffa2e9fb"><![CDATA[2) ]]></kuvatavNr>
					<sisuTekst id="d6c4171d-686a-4ca7-91d2-94880fdfa541">
						<tavatekst id="87f7c8d3-986c-4674-b1ac-b32eacba2064">üksinda elavate puuduva või osalise töövõimega inimeste ja pensionäride eluruumi normpinnaks on kuni 51 m<sup>2</sup>;</tavatekst>
					</sisuTekst>
				</alampunkt>
				<alampunkt id="para1lg2p3">
					<alampunktNr id="d95b371b-2732-4ec9-923f-7ff3e55f31b4">3</alampunktNr>
					<kuvatavNr id="4aa97244-86bc-467f-8c8c-31be0e800de2"><![CDATA[3) ]]></kuvatavNr>
					<sisuTekst id="02a88134-8100-439d-b5a8-9ff214343d9d">
						<tavatekst id="5a40ce57-8236-4ea1-b6fb-a40d271e6e38">eluruumi üldpind, kui tubade arv on võrdne selles eluruumis alaliselt elevate inimeste arvuga.</tavatekst>
					</sisuTekst>
				</alampunkt>
			</loige>
		</paragrahv>
		<paragrahv id="para2">
			<paragrahvNr id="2a8cb6ec-97df-4546-88fb-8ad5b5e8bf00">2</paragrahvNr>
			<kuvatavNr id="f3bd1faa-2e76-40e3-9dfd-7fa226de10f9"><![CDATA[§ 2. ]]></kuvatavNr>
			<paragrahvPealkiri id="4bce771c-78dc-4165-8fa7-42bd99c121e5">Eluruumi alaliste kulude piirmäärad</paragrahvPealkiri>
			<loige id="para2lg1">
				<loigeNr id="9927cf02-934e-4a8f-b17a-20e868e1cc13">1</loigeNr>
				<kuvatavNr id="9daa5fd9-e1ae-4a7a-86b4-a88e2c1b1cd2"><![CDATA[(1)]]></kuvatavNr>
				<sisuTekst id="e0f9b71a-1bdf-4117-9dde-4e422d36fee2">
					<tavatekst id="099d1624-bcc0-4568-88f2-253c21cdbc39"> Toimetulekutoetuse määramisel võetakse arvesse jooksval kuul tasumisele kuuluvad eluruumi alalised kulud järgmiste piirmäärade ulatuses:</tavatekst>
				</sisuTekst>
				<alampunkt id="para2lg1p1">
					<alampunktNr id="45b768fa-0365-4c11-97b2-da2cb9d064f8">1</alampunktNr>
					<kuvatavNr id="3ddfb78a-037e-4d10-a991-2b26139b3326"><![CDATA[1) ]]></kuvatavNr>
					<sisuTekst id="5f510780-5ac1-49ae-a7d3-9e53fbb18642">
						<tavatekst id="611d4122-5ff1-46a5-9602-bcf491f52c25"> üür kuni 6,00 eurot 1 m<sup>2</sup> kohta kuus;</tavatekst>
					</sisuTekst>
				</alampunkt>
				<alampunkt id="para2lg1p2">
					<alampunktNr id="4d2d1ce2-28d0-49d7-be6e-8b0b915a2065">2</alampunktNr>
					<kuvatavNr id="1281eb71-96ac-44c7-a742-005a5f51e66b"><![CDATA[2) ]]></kuvatavNr>
					<sisuTekst id="af89e884-65b6-472f-be34-d77d4e9a9625">
						<tavatekst id="8699220d-92aa-4aa1-8e79-7cb913c3fd33">korterelamu haldamise kulu, sh remondiga seotud kulu kuni 6,00 eurot eluruumi 1 m<sup>2</sup> kohta kuus;</tavatekst>
					</sisuTekst>
				</alampunkt>
				<alampunkt id="para2lg1p3">
					<alampunktNr id="68a6eb70-9539-4c81-9811-4888108f595e">3</alampunktNr>
					<kuvatavNr id="14e47137-72cd-483c-a1f2-7ead5378cd43"><![CDATA[3) ]]></kuvatavNr>
					<sisuTekst id="4e0653b2-98db-4a73-b3ca-eb588692c5de">
						<tavatekst id="4b9a6e17-b4e0-4458-9298-40263adc3d55">korterelamu renoveerimiseks võetud laenu tagasimakse kuni 6,00 eurot 1 m<sup>2</sup> kohta kuus;</tavatekst>
					</sisuTekst>
				</alampunkt>
				<alampunkt id="para2lg1p4">
					<alampunktNr id="989e4d08-d51b-4cb1-9534-301faa0ca308">4</alampunktNr>
					<kuvatavNr id="cf5e4bf2-13a2-4c68-8e18-213dfb9aedf9"><![CDATA[4) ]]></kuvatavNr>
					<sisuTekst id="1da5d5a7-67e7-4608-b9e9-64817b98f3c5">
						<tavatekst id="11403474-e39f-44bb-8a7a-5668495f121f">soojaveevarustuseks tarbitud soojusenergia või kütuse maksumus;</tavatekst>
					</sisuTekst>
				</alampunkt>
				<alampunkt id="para2lg1p5">
					<alampunktNr id="bb1dd49f-d294-480f-b067-a1e9ffd33b48">5</alampunktNr>
					<kuvatavNr id="a982598e-4f13-42bd-bde1-c60609aa2080"><![CDATA[5) ]]></kuvatavNr>
					<sisuTekst id="19cddb7b-9aa7-48dc-91b2-216c74e33a65">
						<tavatekst id="401dc7f6-efb8-4a09-b60b-9974d549ce3c">kütteks tarbitud soojusenergia või kütuse maksumus;</tavatekst>
					</sisuTekst>
				</alampunkt>
				<alampunkt id="para2lg1p6">
					<alampunktNr id="e80496b4-9f51-4a9c-8e2b-72d8fbe71628">6</alampunktNr>
					<kuvatavNr id="23869a1e-3008-419d-a754-15ad0ae7bfef"><![CDATA[6) ]]></kuvatavNr>
					<sisuTekst id="332bfb39-27a9-4495-9163-db67f5da2db7">
						<tavatekst id="a287d8fe-e5b3-45fc-a840-2df21e7f100d">veevarustuse ja reovee ärajuhtimise teenuste maksumus kuni 14,00 eurot üheliikmelise pere kohta kuus ning iga järgneva pereliikme kohta kuni 9,00 eurot kuus;</tavatekst>
					</sisuTekst>
				</alampunkt>
				<alampunkt id="para2lg1p7">
					<alampunktNr id="18b11173-0fd7-4d1d-b30e-489aac219df6">7</alampunktNr>
					<kuvatavNr id="ecee4c8d-761c-41af-b4a6-140f82621605"><![CDATA[7) ]]></kuvatavNr>
					<sisuTekst id="7be86770-c053-4099-8af3-b9f396758241">
						<tavatekst id="733daabc-6826-4e6b-b87f-c5969f604612">tarbitud elektrienergia maksumus kuni 60,00 eurot üheliikmelise pere kohta kuus ning iga järgneva pereliikme kohta kuni 30,00 eurot kuus;</tavatekst>
					</sisuTekst>
				</alampunkt>
				<alampunkt id="para2lg1p8">
					<alampunktNr id="140e5b98-0b02-4902-812e-f32ccd389309">8</alampunktNr>
					<kuvatavNr id="edc3275e-3d19-49c5-8654-aabd7e6494d2"><![CDATA[8) ]]></kuvatavNr>
					<sisuTekst id="c92f2169-1373-4627-aa51-c7be9b120a28">
						<tavatekst id="48028795-97c1-4c79-b31c-839c8839de2c">tarbitud majapidamisgaasi maksumus kuni 8,00 eurot üheliikmelise pere kohta kuus ning kuni 6,00 eurot iga järgneva pereliikme kohta kuus. Balloongaasi kasutamisel kompenseeritakse kulu vastavalt kehtestatud piirmäärale, vajadusel kuludokumendi esitamisele järgnevatel kuudel kuludokumendil näidatud summani;</tavatekst>
					</sisuTekst>
				</alampunkt>
				<alampunkt id="para2lg1p9">
					<alampunktNr id="f21ca5c3-e67b-4229-9d63-d70c129cda64">9</alampunktNr>
					<kuvatavNr id="449b3d0b-d6cf-4ca1-95b3-e4ece5f5d949"><![CDATA[9) ]]></kuvatavNr>
					<sisuTekst id="00675aa4-bde5-4291-a789-1cc3a3617707">
						<tavatekst id="24d6e563-37eb-49ad-a36b-d4f9af21fe11">maamaksukulu, mille arvestamise aluseks on kolmekordne elamualune pind, kuni 0,20 eurot 1 m<sup>2</sup> kohta kuus;</tavatekst>
					</sisuTekst>
				</alampunkt>
				<alampunkt id="para2lg1p10">
					<alampunktNr id="df48a40c-d623-42bc-b1c8-9624b71baa1c">10</alampunktNr>
					<kuvatavNr id="39a52f55-e43d-4bba-a63c-b0e1f1e9851a"><![CDATA[10) ]]></kuvatavNr>
					<sisuTekst id="e42a56cb-f674-4223-96fc-417d8a70a1e5">
						<tavatekst id="32626886-6f5f-4afb-9db1-142e7f49c107">hoone kindlustuse kulud kuni 0,40 eurot 1 m<sup>2</sup> kohta kuus;</tavatekst>
					</sisuTekst>
				</alampunkt>
				<alampunkt id="para2lg1p11">
					<alampunktNr id="0482bebb-2433-4ed2-8abe-a717061299c8">11</alampunktNr>
					<kuvatavNr id="a7a1b841-b7c6-4b96-99b4-eb03fd602eb9"><![CDATA[11) ]]></kuvatavNr>
					<sisuTekst id="13912b73-476f-4d63-92c4-e1dde553f2ec">
						<tavatekst id="adbd816e-8096-41ee-9e01-46ef103ac7f0">olmejäätmete veotasu kuni 10,00 eurot kuus üksi elava või perekonna esimese liikme kohta ning kuni 5,00 eurot kuus iga järgneva pereliikme kohta.</tavatekst>
					</sisuTekst>
					<muutmismarge id="50220367-20c0-4f2f-9a5d-4b99378b6749">
						<avaldamismarge id="9bd85e30-2f15-4a7f-8b64-88a92ea788dc">
							<RTosa id="6887b9c3-1865-4bf2-8881-3ec683025869">RT IV</RTosa>
							<avaldamineKuupaev id="6e58c59e-3188-4481-9991-4665b4450991">2021-12-29</avaldamineKuupaev>
							<RTartikkel id="f8ad2029-21ba-4fda-8d60-b6ca66c4877e">107</RTartikkel>
							<aktViide id="21c3031d-d6b0-4096-9251-9da4bce673d8">429122021107</aktViide>
						</avaldamismarge>
						<joustumine id="b173a0bd-6e0e-457c-9144-89035a92bd0c">2022-01-01</joustumine>
						<aktiNr id="ce42aca6-2c65-48ba-8e54-fd2c7389d414">2</aktiNr>
					</muutmismarge>
				</alampunkt>
				<alampunkt id="para2lg1p12">
					<alampunktNr id="3267cb1f-3b21-4935-b4c5-978db68c042c">12</alampunktNr>
					<kuvatavNr id="55a59ccd-d263-4780-a16f-2dc7cc7753ec"><![CDATA[12) ]]></kuvatavNr>
					<sisuTekst id="bbde4e71-6bec-49a4-9aa7-31a173642275">
						<tavatekst id="10a94765-1693-4ccd-8a88-c7931ed4a749">eluasemelaenu tagasimakse (koosneb laenu põhiosast, intressist ja kohustuslikust eluasemekindlustuse maksest) kokku kuni 6,00 eurot 1 m<sup>2</sup> kohta kuus. Eluasemelaenu tagasimakseid võetakse arvesse kuni kuus kuud kalendriaasta jooksul.</tavatekst>
					</sisuTekst>
