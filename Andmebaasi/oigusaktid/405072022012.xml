				<sisuTekst id="ac104a64-4291-4ebf-8d95-a63c086e821b">
					<tavatekst id="eed9031d-9892-4436-8619-6eeaf213badb">Eluruumi alaliste kulude arvestamine toimub teenuse osutaja või kauba müüja poolt väljastatud arvete ja maksekviitungite alusel.</tavatekst>
				</sisuTekst>
