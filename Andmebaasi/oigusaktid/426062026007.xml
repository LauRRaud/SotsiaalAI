						</avaldamismarge>
						<joustumine id="cf34bdab-890b-4369-b2e8-1fd912756786">2022-07-01</joustumine>
					</muutmismarge>
				</alampunkt>
				<alampunkt id="para2lg1p2">
					<alampunktNr id="f3c3fbc1-cfd5-4260-8335-690b922589f4">2</alampunktNr>
					<kuvatavNr id="3aacb8d3-adc4-4c11-9bd5-f7f8cef86646"><![CDATA[2) ]]></kuvatavNr>
					<sisuTekst id="482fc071-1f03-40d1-99fb-66878005d18e">
						<tavatekst id="0706e6aa-9eed-4b19-ad41-9ef50e4243e3">korterelamu haldamise kulu, sh remondiga seotud kulu - kuni 2 euro eluruumi normpinna ühe ruutmeetri kohta kuus;</tavatekst>
					</sisuTekst>
				<muutmismarge id="98907185-fb80-42ee-bc10-7c29dcb9f58a"><avaldamismarge id="fb861763-425f-46d4-987b-35ccb738852b"><RTosa id="32753ce6-3053-402f-a72c-e617082abd59">RT IV</RTosa><avaldamineKuupaev id="bfac6c13-8e41-4431-8b90-65557cba1a64">2026-06-26</avaldamineKuupaev><RTartikkel id="e60bf49e-5358-4540-982b-cbbba62bef45">1</RTartikkel><aktViide id="547cb281-b3b1-47db-99da-c11d2406e0f2">426062026001</aktViide></avaldamismarge><joustumine id="984b2cc5-c23d-420e-ac74-39259355546f">2026-07-01</joustumine><aktiNr id="9751fa06-c0ef-43ab-be0f-49172b90594c">14</aktiNr></muutmismarge></alampunkt>
				<alampunkt id="para2lg1p3">
					<alampunktNr id="1ddfc62a-db51-445f-bca3-2e8e5ff4eb37">3</alampunktNr>
					<kuvatavNr id="5650070b-0300-4807-9f30-74fc9d3c5ff2"><![CDATA[3) ]]></kuvatavNr>
					<sisuTekst id="f442be61-e3f4-48f0-b7f1-dc295dfd8d4b">
						<tavatekst id="39ceee52-9f88-4d31-9814-808da0c7153a">korterelamu renoveerimiseks võetud laenu tagasimakse - kuni 2 euro eluruumi normpinna ühe ruutmeetri kohta kuus;</tavatekst>
					</sisuTekst>
				<muutmismarge id="6a890962-e38f-4ef0-a619-6efb15629a2e"><avaldamismarge id="f4ade1b7-6bb1-438b-8331-2ec2a8b381f9"><RTosa id="9faf5f8e-bb0e-4f26-a84d-0d35e5ee0357">RT IV</RTosa><avaldamineKuupaev id="3a0a7db0-fe04-4e34-92e7-b40ad6c15050">2026-06-26</avaldamineKuupaev><RTartikkel id="a9c65944-4e18-4e94-83d9-4addb49a1be0">1</RTartikkel><aktViide id="709a2834-e207-4c6a-80c9-19135326a931">426062026001</aktViide></avaldamismarge><joustumine id="567feb51-bddb-4695-ab0a-48ab6f8469cb">2026-07-01</joustumine><aktiNr id="83706c5b-01b1-4955-a428-fe3df3b7a816">14</aktiNr></muutmismarge></alampunkt>
				<alampunkt id="para2lg1p4">
					<alampunktNr id="5b04d3f8-b446-4d19-acb1-419f26e7f7f6">4</alampunktNr>
					<kuvatavNr id="af1cfb18-0eee-419c-aae2-5c24673ebc20"><![CDATA[4) ]]></kuvatavNr>
					<sisuTekst id="68d3d833-28bf-43ed-8887-b5e44d98a67b">
						<tavatekst id="392b4daa-5c60-4e86-a992-2581abec61b1">veevarustuse ja reovee ärajuhtimise teenuste maksumus:<reavahetus/>- üheliikmelise pere kohta kuni 3 m<sup>3</sup> kuus,<reavahetus/>- iga järgmise pereliikme kohta kuni 2 m<sup>3</sup> kuus;</tavatekst>
					</sisuTekst>
				<muutmismarge id="0b3dd647-ea99-4c90-acda-cfde1b5d3956"><avaldamismarge id="34cf9e34-c5d5-4eca-b959-e3ee738cdabd"><RTosa id="f45a14ba-d7bf-4106-8760-44a5bf1cc876">RT IV</RTosa><avaldamineKuupaev id="7048511e-6c4b-45c9-8b33-e6069d883ca7">2026-06-26</avaldamineKuupaev><RTartikkel id="8eb68287-f3da-4406-b3a6-2324883bf370">1</RTartikkel><aktViide id="d9262db3-5804-42c3-8bf9-340de39340ce">426062026001</aktViide></avaldamismarge><joustumine id="9c7b7937-6734-430e-8905-638ca4d3f0df">2026-07-01</joustumine><aktiNr id="9ad500e6-0779-4243-ba8a-5d334978aae1">14</aktiNr></muutmismarge></alampunkt>
				<alampunkt id="para2lg1p5">
					<alampunktNr id="e4292d8b-8644-4a84-bcec-405fff5200dc">5</alampunktNr>
					<kuvatavNr id="15be51c2-2105-40f2-b44a-bc94c85e30d5"><![CDATA[5) ]]></kuvatavNr>
					<sisuTekst id="7c1374a6-707f-4291-b78e-d9bde6a688a7">
						<tavatekst id="765e3fd8-84b3-4e66-a9f4-1d312c5201b9">kütteks tarbitud soojusenergia või kütuse maksumus kaugküttega eluruumi puhul kuni 6 eurot ühe m² kohta kuus ning kaugkütteta eluruumi puhul (puit, gaas, brikett jms) kuni 6 eurot ühe m² kohta kuus, kuid mitte rohkem kui 700 eurot kalendriaastas ühe leibkonna kohta;</tavatekst>
					</sisuTekst>
					
				<muutmismarge id="09fbf73b-486b-4d80-99c8-3dcb5dd5da09"><avaldamismarge id="d103d631-f009-4d89-be86-44f4921e95f2"><RTosa id="ef36580e-db5d-4122-8cf2-8b881cfbaa82">RT IV</RTosa><avaldamineKuupaev id="26c45a9f-8490-4d9d-849d-470f33a4279c">2026-06-26</avaldamineKuupaev><RTartikkel id="ddcb3556-a62a-437a-ad7b-53cb2de82c29">1</RTartikkel><aktViide id="7ebe5a58-4149-4448-a1b8-9a5a388d1401">426062026001</aktViide></avaldamismarge><joustumine id="ce56c1cd-a35d-42ae-8eb9-81dfbf3fe54f">2026-07-01</joustumine><aktiNr id="6fcfef2c-c52e-4d42-b983-75c6b5956bd6">14</aktiNr></muutmismarge></alampunkt>
				<alampunkt id="para2lg1p6">
					<alampunktNr id="9c85fb4d-72ef-4d96-84b6-fbfcf099808d">6</alampunktNr>
					<kuvatavNr id="18c09015-7e03-43ac-804f-f8e3de518692"><![CDATA[6) ]]></kuvatavNr>
					<sisuTekst id="37be0095-c826-410e-83e7-9411501f76b6">
						<tavatekst id="2b2ffac6-89a4-41a5-bc00-8542fdb720f2">elektrienergia tarbimisega seotud kulu arve alusel pereliikmete arvu järgi:<reavahetus/>- üheliikmelise pere kohta kuni 80 eurot kuus, iga järgmise pereliikme kohta kuni 40 eurot kuus;</tavatekst>
					</sisuTekst>
					
