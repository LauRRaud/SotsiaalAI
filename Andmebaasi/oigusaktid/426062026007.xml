						</avaldamismarge>
						<joustumine id="a62da80c-881d-4305-87ed-93a6594d750c">2022-07-01</joustumine>
					</muutmismarge>
				</alampunkt>
				<alampunkt id="para2lg1p1b1">
					<alampunktNr id="f24b894b-f18e-4128-a0d5-a6aaf40753ae" ylaIndeks="1">1</alampunktNr>
					<kuvatavNr id="a200a5ca-f1db-4ee7-b86d-c5c14eeaa845"><![CDATA[1<sup>1</sup>) ]]></kuvatavNr>
					<sisuTekst id="5650140e-6eb0-4736-872d-9f3da27331ac">
						<tavatekst id="80f6476d-516d-4b56-9ec9-150e398f10ab">eluaseme soetamiseks võetud laenu tagasimakse – kuni 6 eurot eluruumi normpinna ühe ruutmeetri kohta kuus;</tavatekst>
					</sisuTekst>
					<muutmismarge id="4a69002e-6e56-47e0-b901-af9d1fd973a4">
						<avaldamismarge id="58f67655-24f6-42f0-90bb-2f48b1ebc44e">
							<RTosa id="c64b5f31-5318-4382-a63a-a7b8a3a2884c">RT IV</RTosa>
							<avaldamineKuupaev id="ab71eeae-614c-470d-b43f-215379fbca75">2022-06-28</avaldamineKuupaev>
