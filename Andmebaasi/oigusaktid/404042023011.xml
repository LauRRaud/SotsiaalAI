   <sisuTekst id="622100c1-9ce5-491d-b0f7-6f5bb304dc5a">
    <tavatekst id="c697192e-e14b-43e5-a103-0f067c8a5814">hoonekindlustuse kulu – ainult konkreetsele kasutatavale alalisele eluruumile kuni 1 eurot 1 m² kohta kuus;</tavatekst>
   </sisuTekst>
  </alampunkt><alampunkt id="para3lg1p11">
