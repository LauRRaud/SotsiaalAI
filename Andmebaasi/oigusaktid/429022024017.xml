 <sisu id="3565035e-695e-409f-a5d7-af73bb70c926"><preambul id="5d197ed7-7086-4ea4-8552-044c06a492eb"><tavatekst id="24b9c5e2-3c29-44fb-a9b6-f0acc38cf2ad">Määrus kehtestatakse sotsiaalhoolekande seaduse § 133 lõigete 6 ja 6<sup>1</sup> alusel.</tavatekst></preambul><paragrahv id="para1"><paragrahvNr id="727a0708-af5c-4541-8a80-aa159c41bfff">1</paragrahvNr><kuvatavNr id="5066a945-bbab-4993-98df-ec1399d134c3"><![CDATA[§ 1. ]]></kuvatavNr><paragrahvPealkiri id="b668b1d0-962a-426e-a03e-66048f2fd9ec">Reguleerimisala</paragrahvPealkiri><loige id="para1lg1"><loigeNr id="ee32bc54-0c06-4136-b98b-74d3c2dafe0c"/><kuvatavNr id="2a8866f6-ce37-4ac8-a152-a44ff06eeb12"/><sisuTekst id="1cf777e0-bc27-4cb3-9739-29f875d248b8"><tavatekst id="65b8173b-528a-4a82-8189-d43316fe9f13">Määrusega kehtestatakse eluruumi alaliste kulude piirmäärad toimetulekutoetuse määramisel Tõrva vallas.</tavatekst></sisuTekst></loige></paragrahv><paragrahv id="para2"><paragrahvNr id="81f5261f-2b34-4ca2-91d4-e9f9806512ab">2</paragrahvNr><kuvatavNr id="5fb10a11-77a4-436a-961b-92d87911a013"><![CDATA[§ 2. ]]></kuvatavNr><paragrahvPealkiri id="dc52afdb-05b1-4518-86e1-bebea5ed5c74">Üldalused</paragrahvPealkiri><loige id="para2lg1"><loigeNr id="16a22c63-c75b-4f99-8c52-cb85a1918bb5"/><kuvatavNr id="b02febc5-b003-49c8-89ba-2bd7f29d129d"/><sisuTekst id="d628004a-5dd9-49fd-986e-58a90995fc3f"><tavatekst id="52ee93d9-3dc6-4f57-abbd-19d89b35e815">Toimetulekutoetuse määramisel võetakse arvesse jooksval kuul tasumisele kuuluvad eluruumi tegelikud kulud, kuid mitte üle käesoleva määrusega kehtestatud piirmäärade (edaspidi <i>piirmäärad</i>).</tavatekst></sisuTekst></loige></paragrahv><paragrahv id="para3"><paragrahvNr id="9d0e09a0-738f-4a49-bddd-cf1fb581e557">3</paragrahvNr><kuvatavNr id="c201dbd9-dc80-476a-9bde-b957acb82d97"><![CDATA[§ 3. ]]></kuvatavNr><paragrahvPealkiri id="00f3dce0-d3e8-4be9-aa4d-8364ee06004a">Piirmäärad</paragrahvPealkiri><loige id="para3lg1"><loigeNr id="76857774-82df-4173-9338-377b0c39e0ea"/><kuvatavNr id="29bd7860-572a-4efe-9226-b74ef66d9234"/><sisuTekst id="a5b891ab-f421-483a-bc34-c95cab43453e"><tavatekst id="eb80156d-d07a-4d16-9fad-810deb1cd6a3">Toimetulekutoetuse määramisel võetakse arvesse jooksval kuul tasumisele kuuluvad eluasemekulud järgmiselt:</tavatekst></sisuTekst><alampunkt id="para3lg1p1"><alampunktNr id="00d47cfa-baac-4a80-88a1-11fadfb2dff0">1</alampunktNr><kuvatavNr id="3a7e425b-8e37-42ac-8612-71420e2e22fa"><![CDATA[1) ]]></kuvatavNr><sisuTekst id="2da4657b-0f63-4f16-82b0-dffc4b31a9e5"><tavatekst id="4e71423e-1f0f-49f5-9d03-f3a8c6e59cc6">üür kuni 6 eurot 1 m² kohta kuus;</tavatekst></sisuTekst></alampunkt><alampunkt id="para3lg1p2"><alampunktNr id="11dd9782-d6ef-44a9-9b91-a630b8b9cacb">2</alampunktNr><kuvatavNr id="396cab3d-43d3-4f5b-b2ac-4434b7f89491"><![CDATA[2) ]]></kuvatavNr><sisuTekst id="5a68e2e8-46ea-49b3-8d45-8d4b33925e72"><tavatekst id="c4f76138-6838-4065-92b7-2725a0d39c96">eluaseme soetamiseks võetud laenu tagasimakse, sealhulgas intressi ja eluasemekindlustuse makse kulu, kuni 6 eurot 1 m² kohta kuus;</tavatekst></sisuTekst></alampunkt><alampunkt id="para3lg1p3"><alampunktNr id="4385bcb1-739a-4d36-bfe5-944dd108c4a9">3</alampunktNr><kuvatavNr id="951e53c1-8727-4992-93ea-9d7943013e60"><![CDATA[3) ]]></kuvatavNr><sisuTekst id="8a3d13dc-e965-4576-bb3c-5c4c0589aeaf"><tavatekst id="f3d6d879-8193-450e-8521-74b4ca02e1c2">korterelamu haldamise kulu, sealhulgas remondiga seotud kulu, kuni 4 eurot 1 m² kohta kuus;</tavatekst></sisuTekst></alampunkt><alampunkt id="para3lg1p4"><alampunktNr id="6686864e-b957-4e12-ba4d-01928b3e6c24">4</alampunktNr><kuvatavNr id="ab23afe4-273e-4915-bef5-979343cfd7cd"><![CDATA[4) ]]></kuvatavNr><sisuTekst id="2110a5d3-9213-443f-a3a6-4145865fa4d8"><tavatekst id="728fbafd-47d8-4822-847f-335374a06076">korterelamu renoveerimiseks võetud laenu tagasimakse kulu kuni 4 eurot 1 m² kohta kuus;</tavatekst></sisuTekst></alampunkt><alampunkt id="para3lg1p5"><alampunktNr id="e089160b-6bf2-4f93-a953-ea9bacd6cdc9">5</alampunktNr><kuvatavNr id="de5ee969-2ba5-4149-b16b-080c8237f24e"><![CDATA[5) ]]></kuvatavNr><sisuTekst id="11d7352b-1dbd-4c12-99f9-9cd0b7381649"><tavatekst id="2a6e3f7d-355b-4738-b34e-0957028e06c0">veevarustuse ja reovee ärajuhtimise teenuse maksumus ja/või kuivkäimlate ja septikute tühjendamise maksumus kuni 25 eurot perekonna esimese liikme kohta ja kuni 20 eurot iga järgneva perekonnaliikme kohta kuus;</tavatekst></sisuTekst></alampunkt><alampunkt id="para3lg1p6"><alampunktNr id="84ee28b4-f059-40e2-b465-3d7c7a40b4d3">6</alampunktNr><kuvatavNr id="54f5c6f5-4350-410f-a207-c18080692f0b"><![CDATA[6) ]]></kuvatavNr><sisuTekst id="6b19bf97-a43d-4587-b609-222f071c6299"><tavatekst id="f52bae2a-0576-45dd-b0ab-084084a0cd93">soojaveevarustuseks tarbitud soojusenergia või kütuse maksumus kuni 20 eurot iga perekonnaliikme kohta kuus;</tavatekst></sisuTekst></alampunkt><alampunkt id="para3lg1p7"><alampunktNr id="235d4438-3ce8-44dd-9b3c-9a3c40b4b5bb">7</alampunktNr><kuvatavNr id="16ebb18f-3b4c-44b3-b6a5-7a69134687be"><![CDATA[7) ]]></kuvatavNr><sisuTekst id="74a3842c-4273-4329-a23e-c8a040b49f90"><tavatekst id="775fbf9a-1d6d-4363-968e-af2cd10343d1">kütteks tarbitud soojusenergia või kütuse maksumus kaugkütte korral kuni 7 eurot 1 m² normpinna kohta kuus. Juhul kui kuludokument sisaldab ka järgneva perioodi küttekulu, hüvitatakse see järgnevatel kuudel piirmäära ulatuses kuludokumendil näidatud summa hüvitamiseni või uue kuludokumendi esitamiseni;</tavatekst></sisuTekst></alampunkt><alampunkt id="para3lg1p8"><alampunktNr id="efda7b0f-17d2-4881-bf20-4918a0aab28b">8</alampunktNr><kuvatavNr id="70317a06-8da0-46d3-85a6-dca47dfcfd55"><![CDATA[8) ]]></kuvatavNr><sisuTekst id="838224d6-fb4c-4687-bba6-3a080fe68285"><tavatekst id="c4025a11-e30b-4ed3-89e4-ee577d9ca2a0">kütteks tarbitud soojusenergia või kütuse maksumus mittekaugkütte korral, sealhulgas küttematerjali ülestöötamise kulu, kuni 6 eurot 1 m² normpinna kohta kuus, kuid mitte rohkem kui 1500 eurot aastas. Juhul kui kuludokument sisaldab ka järgneva perioodi küttekulu, hüvitatakse see järgnevatel kuudel piirmäära ulatuses kuludokumendil näidatud summa hüvitamiseni või uue kuludokumendi esitamiseni;</tavatekst></sisuTekst></alampunkt><alampunkt id="para3lg1p9"><alampunktNr id="91ca94aa-c1fd-4056-b3e9-3c365cdfa833">9</alampunktNr><kuvatavNr id="4bfd7cfc-978f-4a4c-9714-bca0f7481948"><![CDATA[9) ]]></kuvatavNr><sisuTekst id="75d78450-e6c2-40a2-a737-31d4d0ef1c09"><tavatekst id="a4453ddf-2613-45e5-b657-f323aa079a7b">elektrienergia tarbimisega seotud kulu kuni 60 eurot perekonna esimese liikme kohta ja kuni 35 eurot iga järgneva perekonnaliikme kohta kuus;</tavatekst></sisuTekst></alampunkt><alampunkt id="para3lg1p10"><alampunktNr id="3203ebd6-61e4-4957-9b7a-ba101ee0f01b">10</alampunktNr><kuvatavNr id="488ba0c8-608a-42b4-9942-acf45dccecb6"><![CDATA[10) ]]></kuvatavNr><sisuTekst id="ef002833-452a-4716-9491-9ca6d3d66f0e"><tavatekst id="a526a3aa-e379-4437-b5ba-d22d546f9b39">majapidamisgaasi maksumus kuni 15 eurot perekonna kohta kuus;</tavatekst></sisuTekst></alampunkt><alampunkt id="para3lg1p11"><alampunktNr id="1745abdb-fced-4eec-b461-f913bd90825e">11</alampunktNr><kuvatavNr id="f3ac6de3-7202-4af2-b943-7322655962aa"><![CDATA[11) ]]></kuvatavNr><sisuTekst id="96075db0-e80a-445c-9e32-b9089f77ad2b"><tavatekst id="98fda133-d43e-46d7-b31f-c62c89eea772">maamaksukulu, mille arvestamise aluseks on kolmekordne elamualune pind, kuni 0,20 eurot 1 m² normpinna kohta kuus;</tavatekst></sisuTekst></alampunkt><alampunkt id="para3lg1p12"><alampunktNr id="6aebc02b-d3d0-4d61-8d4c-4ee34e86feb0">12</alampunktNr><kuvatavNr id="e8fd3c55-ef09-46e7-8704-97ea179b4cca"><![CDATA[12) ]]></kuvatavNr><sisuTekst id="1a2ce56c-e5cc-4771-b97b-c2aad9eca8c1"><tavatekst id="dcbdd2f4-53b4-4a17-9b24-f4320f55ecf4">hoonekindlustuse kulu kuni 0,50 eurot 1 m² normpinna kohta kuus;</tavatekst></sisuTekst></alampunkt><alampunkt id="para3lg1p13"><alampunktNr id="0429465e-9d86-412e-b0eb-b0a5fead0917">13</alampunktNr><kuvatavNr id="e90be72f-f237-4deb-a4ff-8f07a1ee0dec"><![CDATA[13) ]]></kuvatavNr><sisuTekst id="842dfccd-773c-4e1b-b408-ac1256461619"><tavatekst id="95fc69d5-4be0-46ba-9e30-a0289a2c95c7">olmejäätmete veotasu kuni 10 eurot perekonna esimese liikme kohta ja 3 eurot iga järgneva perekonnaliikme kohta kuus;</tavatekst></sisuTekst></alampunkt><alampunkt id="para3lg1p14"><alampunktNr id="e2f95f97-0307-44c0-b1e9-7c21b748aaa3">14</alampunktNr><kuvatavNr id="b58a0dd1-820a-4d19-aba1-518767f62fae"><![CDATA[14) ]]></kuvatavNr><sisuTekst id="c93886b1-f412-4ce1-aa27-7da3dc047de8"><tavatekst id="7f9f0c62-762f-406e-b9de-14d5927bbd65">muud ühekordsed eluasemekulud, mille tegemise vajadus on vältimatu ja tuleneb õigusaktist või on tingitud ohust inimeste tervisele või elule – kuni ühe toimetulekupiiri ulatuses kalendriaasta jooksul.</tavatekst></sisuTekst></alampunkt></loige></paragrahv><paragrahv id="para4"><paragrahvNr id="0c4325f5-91da-439f-a39a-c55af6f73c59">4</paragrahvNr><kuvatavNr id="a023553b-f12b-47f7-82e7-f317e2873c69"><![CDATA[§ 4. ]]></kuvatavNr><paragrahvPealkiri id="61b6dbe6-a8c0-49cc-b130-f9bef5b0eb14">Rakendussätted</paragrahvPealkiri><loige id="para4lg1"><loigeNr id="b482926b-e7a3-417c-9bf5-dce757778b06">1</loigeNr><kuvatavNr id="a57614d5-a4e9-4b87-8eae-74d68adc7887"><![CDATA[(1)]]></kuvatavNr><sisuTekst id="b156cbfe-1c54-466b-a212-ed5f53b1fda0"><tavatekst id="2789a063-4152-41c7-bcd9-36b7946abf79">Tõrva Vallavolikogu 21.03.2023 määrus nr 3 „Eluruumi alaliste kulude piirmäärade kehtestamine riikliku toimetulekutoetuse määramisel“ tunnistatakse kehtetuks.</tavatekst></sisuTekst></loige><loige id="para4lg2"><loigeNr id="f0f88d25-a464-4e2d-94e8-549d9f217929">2</loigeNr><kuvatavNr id="e74deb80-f9e9-4ae1-bb79-97b06365e9e9"><![CDATA[(2)]]></kuvatavNr><sisuTekst id="ba4b1907-81c5-45fd-9755-ef65706d1e95"><tavatekst id="f9801ab6-b53f-40a7-b27e-ee74ef04570b">Määrus jõustub 1. aprillil 2024.</tavatekst></sisuTekst></loige></paragrahv></sisu>
