	<sisu id="aa4e05ed-ddc6-4766-8c43-5164d5d6f0f8">
		<preambul id="6ec69075-b8f7-4e33-8c76-e56135eb4cf6">
			<tavatekst id="1b5e2f92-82c8-4434-9fd8-b3ad8161ac9d">Määrus kehtestatakse kohaliku omavalitsuse korralduse seaduse § 6 lõike 1, § 22 lõike 1 punkti 5 ja sotsiaalhoolekande seaduse § 14 lg 1 alusel.</tavatekst>
		</preambul>
		<paragrahv id="para1">
			<paragrahvNr id="235f3f09-c07a-4af5-a69c-4a00c896ce6c">1</paragrahvNr>
			<kuvatavNr id="df7b565a-3c22-445c-920e-4c77a84c6948"><![CDATA[§ 1. ]]></kuvatavNr>
			<paragrahvPealkiri id="3a868c42-fe4f-4a6d-ae1c-4ef731018dc9">Määruse reguleerimisala</paragrahvPealkiri>
			<loige id="para1lg1">
				<loigeNr id="71bb1ead-8309-48a1-90da-e2c7f10af4a9"/>
				<kuvatavNr id="2ddadf10-046e-463e-9ea5-d5b4a1abcd33"/>
				<sisuTekst id="bcf96b75-eebe-467d-9755-44320aa64e82">
					<tavatekst id="53fb701f-a67e-4468-b0f0-642806302b5b">Määrus reguleerib Tartu valla eelarvest rahastatava hooldusteenuse osutamise korda ja tingimusi.</tavatekst>
				</sisuTekst>
			</loige>
		</paragrahv>
		<paragrahv id="para2">
			<paragrahvNr id="671a2012-a1b4-49dc-813b-1316ce292f25">2</paragrahvNr>
			<kuvatavNr id="6e348aa0-a3d5-4357-855d-95c39b8995a8"><![CDATA[§ 2. ]]></kuvatavNr>
			<paragrahvPealkiri id="81793704-f813-4b03-a7d3-c2a29e1ef941">Üldsätted</paragrahvPealkiri>
			<loige id="para2lg1">
				<loigeNr id="0aaebb0d-7bfb-450c-b70c-46092d79c57e">1</loigeNr>
				<kuvatavNr id="852f5a16-bf8a-4bf7-aff3-cb006e73737a"><![CDATA[(1)]]></kuvatavNr>
				<sisuTekst id="0647165b-fbc5-4b94-850d-a37376417944">
					<tavatekst id="bd1235e8-2d15-4746-9f62-374bc9255bba">Üldhooldusteenus (edaspidi teenus) on kohaliku omavalitsuse poolt korraldatav väljaspool isiku kodu osutatav teenus, mille eesmärk on turvalise keskkonna ja toimetuleku tagamine täisealisele isikule, kes terviseseisundist, tegevusvõimest või elukeskkonnast tulenevatel põhjustel ei suuda kodustes tingimustes ajutiselt või püsivalt iseseisvalt toime tulla.</tavatekst>
				</sisuTekst>
			</loige>
			<loige id="para2lg2">
				<loigeNr id="fc5ca54a-0050-450a-b8e4-c1fe0b0c2503">2</loigeNr>
				<kuvatavNr id="e602d509-7e04-4be6-9ccd-6d0db056555c"><![CDATA[(2)]]></kuvatavNr>
				<sisuTekst id="5365ecd8-21e2-43ad-b9d9-4038f20b4564">
					<tavatekst id="eff915c2-35cc-45ba-8c5d-93a49ac55d72">Tartu vald osaleb teenuse eest tasumises, kui isiku rahvastikuregistrisse kantud elukoht on Tartu vald.</tavatekst>
				</sisuTekst>
				<muutmismarge id="0f159e55-5cbd-4800-a4c8-23f60a52c39c">
					<avaldamismarge id="dee1b624-0a7f-423e-ba83-eeba9dc087e2">
						<RTosa id="4eadb080-a979-4a2f-ab5c-e51040c4e74c">RT IV</RTosa>
						<avaldamineKuupaev id="ae4a25c9-8af0-4908-b327-2652f19c9fb8">2023-05-24</avaldamineKuupaev>
						<RTartikkel id="a0901676-32f4-4883-864d-dae431703815">9</RTartikkel>
						<aktViide id="faf9eb83-79c4-44ba-b3a3-2f9fd7e42b53">424052023009</aktViide>
					</avaldamismarge>
					<joustumine id="38781c77-0049-440e-8cc5-d05ed5fd9854">2023-07-01</joustumine>
				</muutmismarge>
			</loige>
			<loige id="para2lg3">
				<loigeNr id="1ea81652-264f-4bba-9590-b7c33e378bb4">3</loigeNr>
				<kuvatavNr id="b7e93a8b-0111-4fe6-aec6-9b5b217a6212"><![CDATA[(3)]]></kuvatavNr>
				<sisuTekst id="70bb5ce5-ce3b-431b-9c28-0447b32d8314">
					<tavatekst id="73519410-c55e-4a3c-b5f2-c68f925e0ff1">Käesoleva määruse mõistes ei suunata teenusele isikuid, kes ei vaja hooldusteenust. </tavatekst>
				</sisuTekst>
			</loige>
		</paragrahv>
		<paragrahv id="para3">
			<paragrahvNr id="0a983a08-9dad-46a4-b79a-b3b878346419">3</paragrahvNr>
			<kuvatavNr id="7a903172-2503-492d-a9ca-b2dff67f191a"><![CDATA[§ 3. ]]></kuvatavNr>
			<paragrahvPealkiri id="a09bab9b-19eb-407f-99ed-bdba0f8bf11e">Teenuse taotlemine ja teenusevajaduse hindamine</paragrahvPealkiri>
			<loige id="para3lg1">
				<loigeNr id="b92d939c-c50e-48ba-ad21-21b2e795fe94">1</loigeNr>
				<kuvatavNr id="69940019-4915-4a28-8032-0940820e4cb8"><![CDATA[(1)]]></kuvatavNr>
				<sisuTekst id="c173be39-9aad-4e57-9bef-f5349f98136d">
					<tavatekst id="477d55aa-db23-45cf-9126-c87de3e3c740">Teenuse taotlemiseks esitatakse Tartu Vallavalitsusele (edaspidi vallavalitsus) taotlus, milles märgitakse taotleja: </tavatekst>
				</sisuTekst>
				<alampunkt id="para3lg1p1">
					<alampunktNr id="73c87fcb-2547-47ad-beb4-1c292b6c7f89">1</alampunktNr>
					<kuvatavNr id="f9671acf-322e-4f12-bfa5-0e91408ea95f"><![CDATA[1) ]]></kuvatavNr>
					<sisuTekst id="b88d6f82-cb46-498f-b0da-5f349c668fb3">
						<tavatekst id="2943e29c-c3eb-4775-8cf9-0749b96b5b50">ees- ja perekonnanimi;</tavatekst>
					</sisuTekst>
				</alampunkt>
				<alampunkt id="para3lg1p2">
					<alampunktNr id="9d00efd0-85bb-4f65-a8b4-47d6e17e8226">2</alampunktNr>
					<kuvatavNr id="1904fc5e-3c8b-4428-8711-f62e9b29661d"><![CDATA[2) ]]></kuvatavNr>
					<sisuTekst id="7f1b794c-4f09-4cb7-9182-7917ee402d5d">
						<tavatekst id="ba7826db-5db3-4e33-ab4c-89c9d7b8ddf9">elukoha aadress ja muud kontaktandmed;</tavatekst>
					</sisuTekst>
				</alampunkt>
				<alampunkt id="para3lg1p3">
					<alampunktNr id="d02b5d3a-21d8-4c8f-bb59-4515b0bfdd34">3</alampunktNr>
					<kuvatavNr id="9a561327-ca53-4555-9ac6-9e3ff926d16f"><![CDATA[3) ]]></kuvatavNr>
					<sisuTekst id="4a030f15-3eb1-4b51-ab48-9b9ab0c6065d">
						<tavatekst id="d246c406-fd27-432f-8a7d-2ecf0261808d">abivajaduse kirjeldus;</tavatekst>
					</sisuTekst>
				</alampunkt>
				<alampunkt id="para3lg1p4">
					<alampunktNr id="ccb29e11-7bbb-4b34-9abe-a5bc5e1398be">4</alampunktNr>
					<kuvatavNr id="70ca02a1-59e3-4905-99fd-fa8f3f988d82"><![CDATA[4) ]]></kuvatavNr>
					<sisuTekst id="d9c445f0-04d2-4252-ad6d-c78eacc71e1a">
						<tavatekst id="72c50fd1-c92b-43d0-8f43-50469f493365">lähedaste olemasolul nende nimed ja kontaktandmed;</tavatekst>
					</sisuTekst>
				</alampunkt>
				<alampunkt id="para3lg1p5">
					<alampunktNr id="ed5df7a8-ce0c-4c20-be82-02cd69bb5a2c">5</alampunktNr>
					<kuvatavNr id="72a699cc-2fd4-4038-9681-1d5ca2cb2f6b"><![CDATA[5) ]]></kuvatavNr>
					<sisuTekst id="16f73941-d5a4-4255-b9ae-1d1b54928aa6">
						<tavatekst id="0f48fdf6-5ada-4740-993d-8ff25c3cb262">soovi korral eelistatud hoolekandeasutuse nimi;</tavatekst>
					</sisuTekst>
				</alampunkt>
				<alampunkt id="para3lg1p6">
					<alampunktNr id="34c6b6c7-442e-4728-9ee6-fd327d4c6825">6</alampunktNr>
					<kuvatavNr id="1fe36dfb-82e0-45db-88b9-291710f69bdd"><![CDATA[6) ]]></kuvatavNr>
					<sisuTekst id="49036e81-7bf1-4f07-8960-8485c9c8c946">
						<tavatekst id="5b383f09-a91a-4c86-a147-d83917dfd948">isikut tõendava dokumendi koopia.</tavatekst>
					</sisuTekst>
				</alampunkt>
			</loige>
			<loige id="para3lg2">
				<loigeNr id="035c1402-0f91-4035-ba12-41dbdf397ad5">2</loigeNr>
				<kuvatavNr id="89650efd-eba8-4106-9232-34ed5fccfc2d"><![CDATA[(2)]]></kuvatavNr>
				<sisuTekst id="660de134-474c-4854-9bef-ead2ba724fec">
					<tavatekst id="bc6ec878-d899-4012-9e52-4c737b3904e1">Sotsiaaltöötaja hindab isiku teenusevajadust. Haiglas viibiva isiku teenusevajadust võib hinnata haigla sotsiaaltöötaja poolt antud ülevaate alusel.</tavatekst>
				</sisuTekst>
			</loige>
			<loige id="para3lg3">
				<loigeNr id="db122e7e-0736-4f0e-b332-6d10255ca232">3</loigeNr>
				<kuvatavNr id="86426777-453e-404e-b885-5d4c1c119550"><![CDATA[(3)]]></kuvatavNr>
				<sisuTekst id="f4d5ae11-32f7-45a3-89c9-21c131f83b72">
					<tavatekst id="554332e6-f789-4eb5-934d-e37c78c7ffb2">Sotsiaaltöötaja võib hooldusvajaduse hindamiseks külastada taotleja kodu ning vajadusel nõuda täiendavaid dokumente.</tavatekst>
				</sisuTekst>
			</loige>
			<loige id="para3lg4">
				<loigeNr id="db2cf0dd-fe45-4179-a882-fc96401744ba">4</loigeNr>
				<kuvatavNr id="04807295-880a-445f-a8fd-f54226c7f5a0"><![CDATA[(4)]]></kuvatavNr>
				<sisuTekst id="f48c5e1e-4f8c-4428-81e8-595c670470e4">
					<tavatekst id="5e686c64-75bb-4c93-a09d-d764a65da5d4">Sotsiaaltöötajal on õigus teha sotsiaalteenuste ja -toetuste andmeregistri vahendusel asjakohaseid päringuid ning vajaduse korral nõuda avaldajalt ja/või tema lähedastelt täiendavaid andmeid majandusliku olukorra kohta.</tavatekst>
				</sisuTekst>
			</loige>
			<loige id="para3lg5">
				<loigeNr id="1d7ccf0a-bb81-48c9-b49a-a5f4fb71020d">5</loigeNr>
				<kuvatavNr id="08dfead1-1a91-4939-8afd-e82c3d812164"><![CDATA[(5)]]></kuvatavNr>
				<muutmismarge id="fdc2ccdc-37a8-4452-bc9f-9de32872a348">
					<tavatekst id="99f5980e-3342-4c25-83f5-aa1cea58e160">Kehtetu - </tavatekst>
					<avaldamismarge id="0d0e08c0-aa0c-4c51-9799-e90e03cad868">
						<RTosa id="8c365b74-df60-436a-87e7-475a41cc1d4c">RT IV</RTosa>
						<avaldamineKuupaev id="fe2b7987-0fc1-437f-84f8-baec402f08f4">2023-05-24</avaldamineKuupaev>
						<RTartikkel id="e0f514c4-4fd4-4962-907f-3d7c9c55f475">9</RTartikkel>
						<aktViide id="518f6122-8dd8-46bb-9486-a4d2a6e649cb">424052023009</aktViide>
					</avaldamismarge>
					<joustumine id="abfac7c0-076c-4fd9-8f1a-f9d28c7f2ce4">2023-07-01</joustumine>
				</muutmismarge>
			</loige>
		</paragrahv>
		<paragrahv id="para4">
			<paragrahvNr id="185b71c0-1f17-4710-8b59-4756edb567ec">4</paragrahvNr>
			<kuvatavNr id="a7346eaf-dbf9-4622-b0d9-5e400dfbf725"><![CDATA[§ 4. ]]></kuvatavNr>
			<paragrahvPealkiri id="ba0c054c-e3bc-40ef-a273-a6f0ca113dae">Teenusele suunamine</paragrahvPealkiri>
			<loige id="para4lg1">
				<loigeNr id="05cdc3e5-3eaf-4b1b-ad8d-85a908671a83">1</loigeNr>
				<kuvatavNr id="b2172573-0339-4413-a989-4def7b07b652"><![CDATA[(1)]]></kuvatavNr>
				<sisuTekst id="65168777-5015-4897-8559-c4fd3df226f6">
					<tavatekst id="3d4c01fd-3fd3-4d9c-a11c-47044be44b0a">Otsuse teenuse korraldamise kohta teeb vallavalitsus sotsiaaltöö spetsialisti ettepanekul 10 tööpäeva jooksul taotluse ja vajalike lisadokumentide vallavalitsuse dokumendiregistris registreerimisest või vastavate asjaolude teadasaamisest arvates.</tavatekst>
				</sisuTekst>
				<muutmismarge id="6a918b79-d6b6-406d-a704-a3424115d1ff">
					<avaldamismarge id="7184b9b7-1c06-400f-a1e1-f99e934cbd19">
						<RTosa id="179710eb-fa17-4ed1-abd7-431e19fa733c">RT IV</RTosa>
						<avaldamineKuupaev id="83b50d8b-9684-45aa-9c6a-82919f5b3d69">2023-05-24</avaldamineKuupaev>
						<RTartikkel id="25658abe-9e8d-4bc1-a1ec-c76cea4e0b99">9</RTartikkel>
						<aktViide id="168d3ec7-810c-4c35-bf00-7c2ad64dd822">424052023009</aktViide>
					</avaldamismarge>
					<joustumine id="09151d10-444f-4acd-906b-1df358bc46aa">2023-07-01</joustumine>
				</muutmismarge>
			</loige>
			<loige id="para4lg2">
				<loigeNr id="a24793db-c7c9-4812-aa30-852ce61393e7">2</loigeNr>
				<kuvatavNr id="6d179b6a-0bd4-42ab-a6ca-701ea8b70cd1"><![CDATA[(2)]]></kuvatavNr>
				<sisuTekst id="c54e81a1-0383-41df-82bf-43b104523634">
					<tavatekst id="1e7f48e0-78fe-4448-9d0b-a6f4e151db7f">Teenuseosutaja valikul lähtutakse isiku abivajadusest, vabade kohtade olemasolust teenuseosutaja juures ning hooldust vajava isiku enda soovidest.</tavatekst>
				</sisuTekst>
			</loige>
			<loige id="para4lg3">
				<loigeNr id="84ae2cac-fef8-4c41-8ca9-e4c90b2e6de0">3</loigeNr>
				<kuvatavNr id="39dbb32b-788a-47aa-adb9-5859d3d861fb"><![CDATA[(3)]]></kuvatavNr>
				<sisuTekst id="f54cee1c-8c04-4bfc-bc1e-128dc1b2f4dc">
					<tavatekst id="d99c3710-1479-4db3-80d8-3cbb8d51f9b0">Vabade kohtade puudumisel hooldust vajava isiku poolt eelistatud hoolekandeasutuses või kui isiku hooldamine tema poolt soovitud hoolekandeasutuses ei ole võimalik, võib isiku suunata mõnda teise hoolekandeasutusse. </tavatekst>
				</sisuTekst>
			</loige>
			<loige id="para4lg4">
				<loigeNr id="1710caa4-4c46-47c2-93f6-5e57129cbb92">4</loigeNr>
				<kuvatavNr id="936ba269-9e8e-4487-b2ff-f7e817d725b7"><![CDATA[(4)]]></kuvatavNr>
				<sisuTekst id="38b7abaf-8e24-4d43-a5e1-e2decbfbcc10">
					<tavatekst id="75377ecc-8864-40a0-83e1-f32c417daad8">Juhul, kui isik tuleb tema terviseseisundist, tegevusvõimest või elukeskkonnast tulenevatel põhjustel viivitamatult suunata teenusele, kogub sotsiaaltöötaja käesoleva korra paragrahvis 3 nõutud dokumendid mõistliku aja jooksul.</tavatekst>
				</sisuTekst>
			</loige>
			<loige id="para4lg5">
				<loigeNr id="8f2db606-fe5e-4ebf-9678-8dcdab29d8bf">5</loigeNr>
				<kuvatavNr id="6a3f4047-f665-4944-b2e0-f176a36c3484"><![CDATA[(5)]]></kuvatavNr>
				<sisuTekst id="00626bbf-6c33-46e3-a91f-11725a95fe0f">
					<tavatekst id="2a72c456-c1e0-438d-8ae7-eaa52cd7196a">Teenusele suunamisel sõlmitakse vallavalitsuse, teenuseosutaja ja teenuse saaja vahel teenusleping.</tavatekst>
				</sisuTekst>
			</loige>
			<loige id="para4lg6">
				<loigeNr id="a50811a8-dd5d-420e-b737-16f050560b2b">6</loigeNr>
				<kuvatavNr id="dc7461b0-a21e-4608-91a1-d2b8352b2cb7"><![CDATA[(6)]]></kuvatavNr>
				<sisuTekst id="f5c06be0-36d7-4e77-93f5-49763cb48d81">
					<tavatekst id="84158192-b013-4a83-837c-e61d525ccee9">Vallavalitsus võib keelduda isiku teenusele suunamisest, kui:</tavatekst>
				</sisuTekst>
				<alampunkt id="para4lg6p1">
					<alampunktNr id="e7c8b285-3f95-40de-a381-e32d6ab946c0">1</alampunktNr>
					<kuvatavNr id="3dd31579-eaa2-4b10-81ec-68fb09c0f7e7"><![CDATA[1) ]]></kuvatavNr>
					<sisuTekst id="c8bf0a85-c345-4a76-8e3c-7876ae152e75">
						<tavatekst id="3a18de3d-ad8e-4c7a-8bec-887808c5e213">abivajaduse hindamise tulemusel selgub, et isik ei vaja teenust;</tavatekst>
					</sisuTekst>
				</alampunkt>
				<alampunkt id="para4lg6p2">
					<alampunktNr id="9f286c6d-0807-4239-b0e7-42d74a6b284c">2</alampunktNr>
					<kuvatavNr id="d38ca779-fb54-4fc8-8228-2c1a63558742"><![CDATA[2) ]]></kuvatavNr>
					<sisuTekst id="9d334985-8f30-404b-bcfc-329c63a8d40b">
						<tavatekst id="811942a4-a45f-4452-b62d-1bb72aafc7ce">hooldust vajava isiku toimetulekut on võimalik tagada teisi teenuseid (koduteenus, hooldaja määramine, tugiisikuteenus, isikliku abistaja teenus jms) osutades;</tavatekst>
					</sisuTekst>
				</alampunkt>
				<alampunkt id="para4lg6p3">
					<alampunktNr id="ef7c7903-5251-4f8b-8df0-20315e239a1f">3</alampunktNr>
					<kuvatavNr id="d0f8d19d-4e64-4c9e-981a-4c127af28bbe"><![CDATA[3) ]]></kuvatavNr>
					<sisuTekst id="0ea84318-5d87-4404-b415-d31e5292e099">
						<tavatekst id="d35c5532-3135-44bd-8449-089f0afbc4ee">soovitud hoolekandeasutuses puudub vaba koht ja taotleja ei ole nõus ühegi teise hoolekandeasutuse teenusega;</tavatekst>
					</sisuTekst>
				</alampunkt>
				<alampunkt id="para4lg6p4">
					<alampunktNr id="c88b70dc-d462-4a87-a13f-9147d00917aa">4</alampunktNr>
					<kuvatavNr id="e919d8db-445c-47cf-ba65-70e970d3b17c"><![CDATA[4) ]]></kuvatavNr>
					<sisuTekst id="174ce4ab-bfe6-4868-bbb1-99e3df28207f">
						<tavatekst id="c843123f-c7b5-4b5f-af21-e9dc8b937968">hooldust vajav isik jätab vallavalitsuse poolt täiendavalt nõutud dokumendid mõjuva põhjuseta esitamata.</tavatekst>
					</sisuTekst>
					<muutmismarge id="343f07f3-cb7e-49bf-9115-2eb69cbcc922">
						<avaldamismarge id="2ff734fb-4ad8-40f5-8e25-6e3e32c8f427">
							<RTosa id="a4dc0c2a-55c3-439d-b14a-8a34da454df2">RT IV</RTosa>
							<avaldamineKuupaev id="21eb68fc-e25c-4461-9e5a-0ed6e89907a4">2023-05-24</avaldamineKuupaev>
							<RTartikkel id="9f4385dc-f069-470b-b475-36a21587a4e4">9</RTartikkel>
							<aktViide id="da43dc4c-d411-4b1f-8009-1ef950573766">424052023009</aktViide>
						</avaldamismarge>
						<joustumine id="6867902b-0eb7-424a-a986-1a577c5bcfa6">2023-07-01</joustumine>
					</muutmismarge>
				</alampunkt>
			</loige>
		</paragrahv>
		<paragrahv id="para5">
			<paragrahvNr id="607a7055-15a7-4017-b528-9f26102418f5">5</paragrahvNr>
			<kuvatavNr id="a9812a58-4a30-4b70-ae36-977617077aa3"><![CDATA[§ 5. ]]></kuvatavNr>
			<paragrahvPealkiri id="660316bf-5311-41fa-a65d-8a371160c110">Teenuse eest tasumine</paragrahvPealkiri>
			<loige id="para5lg1">
				<loigeNr id="435fade6-a271-40c8-a1c1-3e0cae5a34b2">1</loigeNr>
				<kuvatavNr id="91674b70-b226-4fac-84c1-aed5c9fc3c47"><![CDATA[(1)]]></kuvatavNr>
				<sisuTekst id="20a0ee18-06f6-4f4f-97d3-1f84fe71cba1">
					<tavatekst id="88d72b89-7d97-45c9-881c-b31eeb7f8721">Teenuse eest tasub teenuse saaja ja vallavalitsus.</tavatekst>
				</sisuTekst>
			</loige>
			<loige id="para5lg2">
				<loigeNr id="1421893f-25b4-427e-9e3d-d15b8bb119e4">2</loigeNr>
				<kuvatavNr id="0829195e-90b3-4871-a8a1-86a6f87419d1"><![CDATA[(2)]]></kuvatavNr>
				<sisuTekst id="becebc1e-2813-4bcb-a80c-bf66081a3355">
					<tavatekst id="d499eb61-f2e0-4704-931e-6b8a1bc99f78">Sotsiaalhoolekande seaduse §-s 22<sup>1</sup> lg 2 sätestatud, hooldustöötajate ja abihooldustöötajate kulud teenuskoha maksumusest rahastatakse valla eelarvest.</tavatekst>
				</sisuTekst>
			</loige>
			<loige id="para5lg3">
				<loigeNr id="66280d89-6884-4413-962f-310361d5e3fd">3</loigeNr>
				<kuvatavNr id="d109a087-38cb-4479-8a4f-08abf410a2c9"><![CDATA[(3)]]></kuvatavNr>
				<sisuTekst id="1d1d0f66-6e29-4cd7-a3a7-785b4a57d545">
					<tavatekst id="886c4ba1-e6f1-42b7-81ff-3d70e2abb463">Käesoleva paragrahvi 2. lõikes nimetatud kulude tasumise piirmäära kehtestab vallavalitsus määrusega.</tavatekst>
				</sisuTekst>
			</loige>
			<loige id="para5lg4">
				<loigeNr id="ff46522e-131b-4140-8dbb-2649995425cd">4</loigeNr>
				<kuvatavNr id="854e399d-0961-4229-bc2c-1484f370d8b4"><![CDATA[(4)]]></kuvatavNr>
				<sisuTekst id="d9a70c4d-22f8-476d-8704-2623c8162948">
					<tavatekst id="0f427423-3f66-44aa-8c3f-671596b62009">Teenuse saaja tasub teenuskoha maksumusest majutus- ja toitlustuskulud ning muud teenuse osutamisega seotud kulud.</tavatekst>
				</sisuTekst>
			</loige>
			<loige id="para5lg5">
				<loigeNr id="4e866efc-642f-4d74-8c0a-03420d6b6396">5</loigeNr>
				<kuvatavNr id="1e2aa277-79ed-4edc-820d-2bbb5023511a"><![CDATA[(5)]]></kuvatavNr>
				<sisuTekst id="6e64ebbb-aead-496b-9aa2-d3e47ff71c46">
					<tavatekst id="9735a5e3-bf8f-40cb-8692-7587ea212e0f">Käesoleva paragrahvi 3. lõike alusel vallavalitsuse poolt kehtestatud piirmäära ületavad kulud tasub teenuse saaja. Piirmäära ületava kuluna tasutud summat ei loeta kaetuks teenuse saaja poolt tasutavate majutus- ja toitlustuskulude ning muude teenuse osutamisega seotud kulude arvelt.</tavatekst>
				</sisuTekst>
			</loige>
			<loige id="para5lg6">
				<loigeNr id="2483209d-c8f4-432c-a99c-b0b00e28501d">6</loigeNr>
				<kuvatavNr id="085b27a6-958b-46df-a110-94917c815823"><![CDATA[(6)]]></kuvatavNr>
				<sisuTekst id="d867fdbf-f01d-4957-bf05-3d187b31d3c4">
					<tavatekst id="a545d348-56f7-47fe-a46a-1d2ac98c5f67">Teenuse saajale peab pärast käesoleva paragrahvi 4. lõikes nimetatud kulude tasumist isiklikuks kasutamiseks jääma vähemalt 5% igakuisest sissetulekust.</tavatekst>
				</sisuTekst>
			</loige>
			<loige id="para5lg7">
				<loigeNr id="2b428264-21f8-4371-9f3a-7d37ab04d24d">7</loigeNr>
				<kuvatavNr id="26a839a9-5e0d-40f2-ab91-794ac8e87ddf"><![CDATA[(7)]]></kuvatavNr>
				<sisuTekst id="6d3a1bbd-5313-4ee3-a823-71334aaa8e81">
					<tavatekst id="33b2984c-2ff5-4916-a208-e6bda22e874e">Kui teenuse saaja sissetulek on madalam kui Statistikaameti avaldatud eelarveaastale eelnenud aasta teise kvartali keskmise vanaduspensioni suurus, kaetakse valla eelarvest teenuse saaja tasutavate majutus- ja toitlustuskulude ning muude teenuse osutamisega seotud kulude ja teenuse saaja sissetuleku vahe, kuid mitte rohkem kui eelmise aasta teise kvartali keskmise vanaduspensioni suuruse ja teenuse saaja sissetuleku vahe.</tavatekst>
				</sisuTekst>
			</loige>
			<loige id="para5lg8">
				<loigeNr id="f5fdcb8c-b2e7-48a3-b566-0924e526ba6f">8</loigeNr>
				<kuvatavNr id="6d3f7676-c32b-4b7c-8945-6a9648f901a8"><![CDATA[(8)]]></kuvatavNr>
				<sisuTekst id="fbe49683-effa-4743-8155-25ca35619730">
					<tavatekst id="41747779-8b73-4572-b40a-76e18d539d71">Kui vallavalitsuse kehtestatud piirmäära ulatuses tasutud kulud, teenuse saaja igakuised sissetulekud ja väiksema sissetuleku hüvitis ei kata teenuskoha maksumust, siis tasuvad teenuse saaja või tema suhtes ülalpidamist andma kohustatud isikud puuduoleva osa.</tavatekst>
				</sisuTekst>
			</loige>
			<loige id="para5lg9">
				<loigeNr id="b29a821c-5272-46d0-960a-7a15c36d0dbf">9</loigeNr>
				<kuvatavNr id="45d20595-1844-496d-8232-43ed6c1af2de"><![CDATA[(9)]]></kuvatavNr>
				<sisuTekst id="bc000d5a-078f-41b1-ab09-d2eec2025296">
					<tavatekst id="43c903dd-4208-4362-a1b2-52aec05d0dbb">Kui teenuse saaja või tema suhtes ülalpidamist andma kohustatud isikud ei ole objektiivsetest asjaoludest lähtuvalt ning enda või oma perekonna tavalist ülalpidamist kahjustamata võimelised teenuse eest puudujäävas osas tasuma, makstakse teenuse eest puudu jääv summa valla eelarvest.</tavatekst>
				</sisuTekst>
			</loige>
			<loige id="para5lg10">
				<loigeNr id="4cf0cfb2-09d2-4459-b566-cfb17862a424">10</loigeNr>
				<kuvatavNr id="5d8465d5-fa10-4907-8754-e030baeac20f"><![CDATA[(10)]]></kuvatavNr>
				<sisuTekst id="2fc82eca-52ad-4978-849a-059c5f592843">
					<tavatekst id="ccedf165-1d54-4283-96bb-a5977205c6d3">Kui teenuse saaja ja/või ülalpidamist andma kohustatud isikute majanduslik olukord on oluliselt halvenenud, mistõttu nad ei ole võimelised kokkulepitud mahus teenuse eest tasuma, võib teenuse saaja taotleda valla eelarvest makstava osa suurendamist.</tavatekst>
				</sisuTekst>
			</loige>
			<loige id="para5lg11">
				<loigeNr id="f3490244-10b7-4563-a1e2-6d88a84882a9">11</loigeNr>
				<kuvatavNr id="7b440c95-df13-47c2-b608-038dac56d7b6"><![CDATA[(11)]]></kuvatavNr>
				<sisuTekst id="daf52b52-f2fe-4808-81ef-f53463d3e163">
					<tavatekst id="7cb5a8f6-2696-4ebf-960b-36267f008250">Sotsiaaltöö spetsialist vaatab iga aasta 1. juuniks üle teenuse eest tasumisele kuuluva summa jaotuse, kontrollides teenuse saaja ja talle ülalpidamist andma kohustatud isikute majanduslikku seisu. Kui teenust saava isiku ja/või talle ülalpidamist andma kohustatud isikute varanduslik seisukord on muutunud, ei ületata käesoleva paragrahvi 3. lõike alusel sätestatud piirmäära ja teenust saav isik või talle ülalpidamist andma kohustatud isikud on võimelised teenust varasemast suuremas summas rahastama, muudab sotsiaaltöö spetsialist pärast Tartu Vallavalitsuse hoolekandekomisjoni ettepaneku saamist valla eelarvest teenuse eest makstava osa suurust. Kui valla osa teenuse eest tasumisel suureneb aasta kohta rohkem kui 1000 eurot, otsustab tasumisele kuuluva summa suuruse vallavalitsus.</tavatekst>
				</sisuTekst>
				<muutmismarge id="81339e3d-d9d0-4d5c-807b-ffa034dee6ba">
					<avaldamismarge id="7a7995fe-138e-45af-ab7a-c7d38f1b98f1">
						<RTosa id="6290f635-1c38-4bfd-afd9-81042e6fcc42">RT IV</RTosa>
						<avaldamineKuupaev id="a1c95bc3-c55b-43cc-88ef-29d1d3e6d6f9">2025-03-26</avaldamineKuupaev>
						<RTartikkel id="a3f66ebe-5a5c-4159-b6be-97465ca7c0f6">14</RTartikkel>
						<aktViide id="1494d8d6-b000-424c-979e-f30a3e1bc724">426032025014</aktViide>
					</avaldamismarge>
					<joustumine id="2682599b-279d-4cb8-a1de-9d1d91d3a7da">2025-03-29</joustumine>
				</muutmismarge>
			</loige>
		</paragrahv>
		<paragrahv id="para6">
			<paragrahvNr id="2ca8dc75-4afe-4606-a669-9f9d4bf0a7cb">6</paragrahvNr>
			<kuvatavNr id="e436f08b-36b8-48aa-98b0-1f66bbe1013f"><![CDATA[§ 6. ]]></kuvatavNr>
			<paragrahvPealkiri id="eacca0e6-3be8-4d25-81cb-9525f2dac30b">Teenuse osutamise lõpetamine ja teenuseosutaja vahetamine</paragrahvPealkiri>
			<loige id="para6lg1">
				<loigeNr id="f92023fe-8bcc-4eb9-9327-bac8b0baf4c8">1</loigeNr>
				<kuvatavNr id="354945ac-21e7-4798-9791-f6d29fb94760"><![CDATA[(1)]]></kuvatavNr>
				<sisuTekst id="1ccaf668-873b-44d2-af92-e334afbe504a">
					<tavatekst id="0794f0bf-0c22-4fb4-b5f1-fb92561a9c94">Teenuse osutamine lõpetatakse:</tavatekst>
				</sisuTekst>
				<alampunkt id="para6lg1p1">
					<alampunktNr id="6b5a7bff-192f-42bb-a758-82db0093b3a8">1</alampunktNr>
					<kuvatavNr id="5b42401f-91ea-4aa3-ac97-2ab0a85a2b25"><![CDATA[1) ]]></kuvatavNr>
					<sisuTekst id="4fe9519c-0c3b-44b2-9108-000f0d8bf6ad">
						<tavatekst id="4e823b27-3bab-4283-8c46-723432c71ad6">teenusevajaduse lõppemisel;</tavatekst>
					</sisuTekst>
				</alampunkt>
				<alampunkt id="para6lg1p2">
					<alampunktNr id="04c63610-011c-4216-b56d-7364a54ca9cf">2</alampunktNr>
					<kuvatavNr id="2db5eae1-72d6-4862-bfa7-b8e277f6edcf"><![CDATA[2) ]]></kuvatavNr>
					<sisuTekst id="e237f6e3-7736-486a-8193-691922bf2005">
						<tavatekst id="3d5aab11-457c-42c9-94c9-3dca4f73ac79">teenuse saaja soovil.</tavatekst>
					</sisuTekst>
				</alampunkt>
			</loige>
			<loige id="para6lg2">
				<loigeNr id="f3772cf7-6e0f-4758-9d82-13f9bc9a352e">2</loigeNr>
				<kuvatavNr id="40f9a541-7781-4c87-be38-83e2bc344e1e"><![CDATA[(2)]]></kuvatavNr>
				<sisuTekst id="00ae90c1-0ad0-418a-95ea-6dee2897141d">
					<tavatekst id="8146b74e-3a3a-4f88-8c2f-ea48b8f07c90">Teenuseosutaja vahetamine toimub teenuse saaja avalduse alusel või vallavalitsuse algatusel vallavalitsuse otsuse alusel. Kui teenuse saaja poolt soovitud uue teenuseosutaja kohamaks on kõrgem, otsustab vallavalitsus ümberpaigutamise lubamise korral ka valla rahastatava osa suuruse.</tavatekst>
				</sisuTekst>
			</loige>
		</paragrahv>
		<paragrahv id="para7">
			<paragrahvNr id="e63702b1-babc-4fd2-b82a-77a0fb36742c">7</paragrahvNr>
			<kuvatavNr id="5230bd30-9d27-4461-aae8-d101278bf2e5"><![CDATA[§ 7. ]]></kuvatavNr>
			<paragrahvPealkiri id="db43dfb6-9fd4-4627-945c-16ca28eb7f94">Erandid teenuse rahastamisel valla eelarvest</paragrahvPealkiri>
			<loige id="para7lg1">
				<loigeNr id="388f2885-2713-4b68-92f9-accf2b7289e2">1</loigeNr>
				<kuvatavNr id="48f44544-d291-4725-88d0-d2a9468a674b"><![CDATA[(1)]]></kuvatavNr>
				<sisuTekst id="81797871-06a8-462b-9c80-02fbc923e3d7">
					<tavatekst id="5cc8c998-b8a4-4def-9a01-3e8f90a59e05">Juhul, kui isik vajab teenust viivitamatult, tasub vallavalitsus isiku eest puudujääva osa kuni isiku enda varalise olukorra väljaselgitamiseni.</tavatekst>
				</sisuTekst>
			</loige>
			<loige id="para7lg2">
				<loigeNr id="77b93023-94bb-4b87-a522-6de1bc3e2896">2</loigeNr>
				<kuvatavNr id="7f919a4d-5ea8-43cc-aa10-74188c9c8835"><![CDATA[(2)]]></kuvatavNr>
				<sisuTekst id="844b972e-e62c-43cc-91f6-1d6da95ded05">
					<tavatekst id="eb60910b-b491-4af8-8bb6-f74b631aa242">Kui teenust vajav isik ja/või ülalpidamiskohustuslased jätavad maksmata vallavalitsuse määratud omaosaluse, on vallavalitsusel võlaõigusseaduses sätestatud käsundita asjaajajana tegutsemise sätete alusel õigus maksmata jäänud osa sisse nõuda.</tavatekst>
				</sisuTekst>
			</loige>
		</paragrahv>
		<paragrahv id="para8">
			<paragrahvNr id="b48a4c8b-d52f-4588-9a73-894f3d8ba0be">8</paragrahvNr>
			<kuvatavNr id="c4aa0bfc-1d64-46ea-9635-ab803ded04ff"><![CDATA[§ 8. ]]></kuvatavNr>
			<paragrahvPealkiri id="fc372a66-2137-462c-bbd6-d55a283be21e">Vaide esitamine</paragrahvPealkiri>
			<loige id="para8lg1">
				<loigeNr id="39631f2d-14e4-403b-9008-c9efce6406e2"/>
				<kuvatavNr id="33acddff-9a22-4ab2-a74c-2b47be68f3c6"/>
				<sisuTekst id="fec465cb-2e41-494a-830d-b63f96379d7e">
					<tavatekst id="db7d7ddb-e83f-44fa-a091-10b09c081122">Teenuse korraldamise või sellest keeldumise otsusega seotud vaiet on õigus esitada Tartu vallavalitsusele sotsiaalseadustiku üldosa seaduses ja haldusmenetluse seaduses sätestatud korras.</tavatekst>
				</sisuTekst>
			</loige>
		</paragrahv>
