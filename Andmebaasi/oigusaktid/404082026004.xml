 <sisu id="36a684b6-087d-46c1-9b57-f6b404feb4b7"><preambul id="6400473b-bc2f-4cb4-ab95-97c310ee79e3"><tavatekst id="b145943b-b44c-49f6-8b23-bdd974d22149">Määrus kehtestatakse sotsiaalhoolekande seaduse § 133 lõigete 5 ja 6 ning Kambja Vallavolikogu 18.12.2024 määruse nr 21 „Sotsiaalhoolekandelise abi andmise kord“ § 24 lõike 1 alusel.</tavatekst></preambul><paragrahv id="para1"><paragrahvNr id="8f5fee46-0170-4d61-af68-7286c47096a0">1</paragrahvNr><kuvatavNr id="b661bfae-5aec-4006-abd2-a2e482c15130"><![CDATA[§ 1. ]]></kuvatavNr><paragrahvPealkiri id="06f9968e-334f-465c-956a-6d5d40f9c1d0">Toimetulekutoetuse arvestamisel eluasemekulude piirmäärad</paragrahvPealkiri><loige id="para1lg1"><loigeNr id="0189eda9-de20-484e-8c90-b1163e8b966e">1</loigeNr><kuvatavNr id="93cec7de-6a75-4be8-b35c-c85cd8439d49"><![CDATA[(1)]]></kuvatavNr><sisuTekst id="66cd99b8-bfda-43a2-b09b-9d859439be17"><tavatekst id="4521c9e3-b80f-40f1-9494-b338bcb01f74">Toimetuleku määramisel võetakse arvesse jooksval kuul tasumisele kuuluvad eluruumi alalised kulud järgmiselt:</tavatekst></sisuTekst><alampunkt id="para1lg1p1"><alampunktNr id="ae77a06d-9474-4fa8-8dcf-8f259c21df78">1</alampunktNr><kuvatavNr id="2365bd34-6bbe-4b09-8aa1-8a2cb4f9334f"><![CDATA[1) ]]></kuvatavNr><sisuTekst id="ddd94167-5b9a-43c9-8779-0731d847c40b"><tavatekst id="5c42c5bb-a6a2-4c50-96f0-ba505311cff8">üür kuni 35 m<sup>2</sup> üldpinnaga eluruumi korral kuni 17 eurot 1 m<sup>2</sup> kohta kuus ning üle 35 m<sup>2</sup> üldpinnaga eluruumi korral kuni 15 eurot 1 m<sup>2</sup> kohta kuus;</tavatekst></sisuTekst></alampunkt><alampunkt id="para1lg1p2"><alampunktNr id="ded1cc7d-c255-47cf-9c89-bf3208e66788">2</alampunktNr><kuvatavNr id="d0f80484-ba3a-4202-8eb7-2a0975388af8"><![CDATA[2) ]]></kuvatavNr><sisuTekst id="2d7ccc69-ea0e-45b8-b890-8f0febf720d3"><tavatekst id="f41f4fee-1161-4206-be1e-3a7e4b7c8ce3">eluaseme soetamiseks võetud laenu tagasimakse, mis sisaldab ka laenu intressi ja kohustusliku eluasemekindlustuse makset, kuni 9 eurot 1 m<sup>2</sup> kohta kuus;</tavatekst></sisuTekst></alampunkt><alampunkt id="para1lg1p3"><alampunktNr id="3c8caf1a-0352-47ee-ae69-b1284a194ff6">3</alampunktNr><kuvatavNr id="b8013e3d-1e4b-482e-a3d3-87d12328eaed"><![CDATA[3) ]]></kuvatavNr><sisuTekst id="caf7a271-5518-44b3-aeb7-bbf8d755e8ce"><tavatekst id="d3254593-9344-4418-8b81-0522011992eb">korterelamu haldamise kulu, sealhulgas remondiga seotud kulu, kuni 3,50 eurot 1 m<sup>2 </sup>kohta kuus;</tavatekst></sisuTekst></alampunkt><alampunkt id="para1lg1p4"><alampunktNr id="4a45ee64-386f-44b5-b56c-383ac2958f26">4</alampunktNr><kuvatavNr id="50c19f54-5965-403e-8e19-7768c86633a8"><![CDATA[4) ]]></kuvatavNr><sisuTekst id="87a8259d-8749-4fc8-b03c-a588ffa5bebc"><tavatekst id="412d4e68-ebc8-4869-85ce-218049bf4483">korterelamu renoveerimiseks võetud laenu tagasimakse kuni 3 eurot 1 m<sup>2</sup> kohta kuus;</tavatekst></sisuTekst></alampunkt><alampunkt id="para1lg1p5"><alampunktNr id="4852b0db-edd4-43e7-aee9-273620fb27f7">5</alampunktNr><kuvatavNr id="0840cf84-b605-4828-9c26-e0814f3a0ce0"><![CDATA[5) ]]></kuvatavNr><sisuTekst id="5c55fbbc-6832-4f9f-b062-88dd440cb1d2"><tavatekst id="42f2a580-4bc0-46ae-9c2f-e2716d219227">veevarustuse ja reovee ärajuhtimise teenuste maksumus kuni 20 eurot üheliikmelise pere kohta kuus ja 15 eurot iga järgneva pereliikme kohta kuus;</tavatekst></sisuTekst></alampunkt><alampunkt id="para1lg1p6"><alampunktNr id="cd14c2f0-2339-4754-8f15-daa28f5908ba">6</alampunktNr><kuvatavNr id="2c384c0c-ccd8-4702-98b4-3e868217e371"><![CDATA[6) ]]></kuvatavNr><sisuTekst id="579196cc-556f-4e00-9d17-3b44ae082048"><tavatekst id="f66a3a3b-0687-4116-9f40-27cdda6839f7">soojaveevarustuseks tarbitud soojusenergia või kütuse maksumus kuni 20 eurot üheliikmelise pere ja kuni 15 eurot iga järgneva pereliikme kohta kuus;</tavatekst></sisuTekst></alampunkt><alampunkt id="para1lg1p7"><alampunktNr id="e5c0043e-73a1-4a75-9097-9afaffb7ea55">7</alampunktNr><kuvatavNr id="fb9da3e3-84ac-4485-b66d-97d653792c56"><![CDATA[7) ]]></kuvatavNr><sisuTekst id="72e128de-fdb3-493c-bbaf-4a659cc5dca5"><tavatekst id="3d226f4f-a540-4729-82b2-84e8bd62ad05">kütteks tarbitud soojusenergia või kütuse maksumus kuni 7 eurot 1 m<sup>2</sup> kohta kuus;</tavatekst></sisuTekst></alampunkt><alampunkt id="para1lg1p8"><alampunktNr id="8bf61f59-acd1-4f35-a7b3-103c196c0252">8</alampunktNr><kuvatavNr id="76ed8d2d-b1b3-4c5a-9b4e-7c77a2dee00f"><![CDATA[8) ]]></kuvatavNr><sisuTekst id="ede54c14-5981-454f-837d-1f75afc0d32c"><tavatekst id="0a7f4a57-beec-4aa3-9bff-bffd3d454b4c">elektrienergia tarbimisega seotud kulu kuni 50 eurot üheliikmelise pere ja 30 eurot iga järgneva pereliikme kohta kuus;</tavatekst></sisuTekst></alampunkt><alampunkt id="para1lg1p9"><alampunktNr id="1b971bdb-2e7f-4c91-878b-f4dcad9803d3">9</alampunktNr><kuvatavNr id="f2235a3c-20d5-4826-8abc-c16724d291f9"><![CDATA[9) ]]></kuvatavNr><sisuTekst id="81040f3a-3246-4d0c-a91f-7271c029c4a4"><tavatekst id="2fbc66a4-9f4c-4068-82c1-0aa82cad602d">majapidamisgaasi maksumus kuni 10 eurot üheliikmelise pere ja 8 eurot iga järgneva pereliikme kohta kuus;</tavatekst></sisuTekst></alampunkt><alampunkt id="para1lg1p10"><alampunktNr id="99556180-fe09-4246-a042-0eb1e8a3ddb1">10</alampunktNr><kuvatavNr id="7f8eafa9-c290-4748-934b-8d5a65cc9979"><![CDATA[10) ]]></kuvatavNr><sisuTekst id="354d03d4-d1de-499e-bacf-0d927a614ff9"><tavatekst id="39641949-eede-41b4-8656-93214b3973bf">maamaksukulu, mille arvestamise aluseks on kolmekordne elamualune pind, kuni 0,15 eurot 1 m<sup>2</sup> kohta kuus;</tavatekst></sisuTekst></alampunkt><alampunkt id="para1lg1p11"><alampunktNr id="42e51ed2-b45a-43c7-8646-d69845abc5a8">11</alampunktNr><kuvatavNr id="934c4288-5795-42a4-9bf8-f38ac6de7024"><![CDATA[11) ]]></kuvatavNr><sisuTekst id="6117894f-d20e-46a5-ab9e-6ba85e1bdfcd"><tavatekst id="18b14dd8-8736-47fa-acc4-f40151e22533">hoonekindlustuse kulu kuni 0,20 eurot 1 m<sup>2</sup> kohta kuus;</tavatekst></sisuTekst></alampunkt><alampunkt id="para1lg1p12"><alampunktNr id="f19bca81-68b4-4ea6-8128-eda8757874b9">12</alampunktNr><kuvatavNr id="e281fea7-1b8a-4e04-86b3-29580ee32def"><![CDATA[12) ]]></kuvatavNr><sisuTekst id="b340e0d0-18b4-4499-b3d7-2c2efe338fba"><tavatekst id="e9751607-c4eb-4f92-b798-86d18a85f100">olmejäätmete veotasu kuni 8 eurot üheliikmelise pere ja 6 eurot iga järgneva pereliikme kohta kuus.</tavatekst></sisuTekst></alampunkt></loige><loige id="para1lg2"><loigeNr id="a3aa258a-8f6a-43ad-a6c7-f05ed697a60e">2</loigeNr><kuvatavNr id="aa7b0171-70e9-46e2-8aa9-143217c01e39"><![CDATA[(2)]]></kuvatavNr><sisuTekst id="04e1f7d7-7750-4532-8592-5e49034193d6"><tavatekst id="d9385e9b-1406-4d3f-9285-62aa88c8672d">Kui kaugkütteta eluruumi kütte ostmise kuludokumendil või majapidamisgaasi ostmise kuludokumendil kajastub ka taotlusele järgneva perioodi küttekulu või gaasikulu, kompenseeritakse see kuludokumendi esitamisele järgnevatel kuudel vastavalt kehtestatud piirmäärale kuludokumendil näidatud summa kompenseerimiseni või uue kuludokumendi esitamiseni.</tavatekst></sisuTekst></loige></paragrahv><paragrahv id="para2"><paragrahvNr id="ddfc16cc-35c4-48b3-b3a6-187fb17da4a8">2</paragrahvNr><kuvatavNr id="6ba915b4-5fa6-495e-a9bb-bc35d1805b1d"><![CDATA[§ 2. ]]></kuvatavNr><paragrahvPealkiri id="11983657-eca7-4c94-903b-87e8e7a0ed05">Rakendussätted</paragrahvPealkiri><loige id="para2lg1"><loigeNr id="ea3328ea-a313-4fd3-a3e0-e06c1f8beb7b">1</loigeNr><kuvatavNr id="1df790a7-264a-4493-b370-fd453bedfeb2"><![CDATA[(1)]]></kuvatavNr><sisuTekst id="700d35be-70a2-403c-8a15-8d4bee563444"><tavatekst id="85d0a266-f07a-4bd8-ac12-07fef6a5483e">Määrus jõustub kolmandal päeval pärast Riigi Teatajas avaldamist.</tavatekst></sisuTekst></loige><loige id="para2lg2"><loigeNr id="49416a2c-0edd-481d-9681-5534850d67d9">2</loigeNr><kuvatavNr id="011086cb-4f61-4e77-8846-4e9b42327702"><![CDATA[(2)]]></kuvatavNr><sisuTekst id="feedbf85-f835-4497-8835-0239b61ffd34"><tavatekst id="0b2a8127-f1f0-4c33-8b2d-ab220aaa730d">Määrust rakendatakse 1. augustist 2026.</tavatekst></sisuTekst></loige></paragrahv><