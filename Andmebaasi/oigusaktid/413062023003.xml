      <pealkiri id="87023cb3-ad22-4434-b4c2-ad0b0021dd43">Hoolduskulude tasumise piirmäära kehtestamine Elva vallas</pealkiri>
    </nimi>
  </aktinimi>
  <sisu id="4d156de4-0878-4cd2-b56a-7adf68451fd9">
    <preambul id="f6ad1aa2-a88a-458d-a72e-182830e1c887">
      <tavatekst id="fa3d142f-e936-464e-b494-232768c9904a">Määrus kehtestatakse kohaliku omavalitsuse korralduse seaduse § 30 lg 1 p 2 ja Elva Vallavolikogu 18.12.2017 määruse nr 6 "Sotsiaalhoolekandelise abi andmise kord Elva vallas" § 20 lg 3 alusel.</tavatekst>
    </preambul>
    <paragrahv id="para1">
      <paragrahvNr id="b453e93d-7da6-4577-8670-ef1a2e63f1c0">1</paragrahvNr>
      <kuvatavNr id="c3458967-af66-4ace-8870-5680609a3f0d"><![CDATA[§ 1. ]]></kuvatavNr>
      <paragrahvPealkiri id="0ac3f46d-4abd-42f4-86b5-f5b534650a73">Hoolduskomponendi piirmäär</paragrahvPealkiri>
      <loige id="para1lg1">
        <loigeNr id="9e29839f-5b28-4fbc-96f9-fb1b61104376"/>
        <kuvatavNr id="d5447195-8f5c-47e4-b10e-c97cc94b9b19"/>
        <sisuTekst id="82e64f97-a02b-49e5-b790-6f8c42482adc">
          <tavatekst id="bdd13ac4-c5a1-4e78-b04a-e746158cdd8e">Kehtestada väljaspool kodu osutatava üldhooldusteenuse Elva valla poolt tasutava hoolduskomponendi piirmääraks 600 eurot. </tavatekst>
        </sisuTekst>
      </loige>
    </paragrahv>
