		<allkirjastaja id="7a4c3778-ae2a-4537-9f1c-46e62c81632b">
			<ametinimetus id="b6e239fa-5b31-46ca-89ac-14910463e38c">vallavolikogu esimees</ametinimetus>
			<eesnimi id="86b9d087-fedc-4a5d-9099-d3c86bc73532">Mait</eesnimi>
			<perekonnanimi id="6a350702-a260-44b9-83a9-1ff9e8dea2c5">Allas</perekonnanimi>
		</allkirjastaja>
	</allkiri>
