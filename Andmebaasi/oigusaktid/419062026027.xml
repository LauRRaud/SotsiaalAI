    <paragrahv id="para2">
      <paragrahvNr>2</paragrahvNr>
      <kuvatavNr><![CDATA[§ 2.]]></kuvatavNr>
      <paragrahvPealkiri>Lastekaitseseadusega kohaliku omavalitsuse üksusele pandud ülesannete täitmise delegeerimine</paragrahvPealkiri>
      <loige id="para2lg1">
        <loigeNr>1</loigeNr>
        <kuvatavNr><![CDATA[(1)]]></kuvatavNr>
        <sisuTekst>
          <tavatekst>Linnavalitsusele delegeeritakse järgmised ülesanded:</tavatekst>
        </sisuTekst>
        <alampunkt id="para2lg1p1">
          <alampunktNr>1</alampunktNr>
          <kuvatavNr><![CDATA[1)]]></kuvatavNr>
          <sisuTekst>
            <tavatekst>lastekaitse korraldamine;</tavatekst>
          </sisuTekst>
        </alampunkt>
        <alampunkt id="para2lg1p2">
          <alampunktNr>2</alampunktNr>
          <kuvatavNr><![CDATA[2)]]></kuvatavNr>
          <sisuTekst>
            <tavatekst>lapse õigusi ja heaolu tagavate programmide ja projektide väljatöötamine ning nende rakendamine Tallinna haldusterritooriumil last ohustavate riskide ennetamiseks ja vähendamiseks;</tavatekst>
          </sisuTekst>
        </alampunkt>
        <alampunkt id="para2lg1p3">
          <alampunktNr>3</alampunktNr>
          <kuvatavNr><![CDATA[3)]]></kuvatavNr>
          <sisuTekst>
            <tavatekst>linna ametiasutuste hallatavate lasteasutuste sisehindamise üle teenistusliku järelevalve korraldamine;</tavatekst>
          </sisuTekst>
        </alampunkt>
        <alampunkt id="para2lg1p4">
          <alampunktNr>4</alampunktNr>
          <kuvatavNr><![CDATA[4)]]></kuvatavNr>
          <sisuTekst>
            <tavatekst>alaealise öise liikumispiirangu ajutine lühendamine;</tavatekst>
          </sisuTekst>
        </alampunkt>
        <alampunkt id="para2lg1p5">
          <alampunktNr>5</alampunktNr>
          <kuvatavNr><![CDATA[5)]]></kuvatavNr>
          <sisuTekst>
            <tavatekst>tingimuste loomine lastekaitsetöö tegemiseks eesmärgiga tagada kohaliku omavalitsuse üksuse ülesannete täitmine; laste ja perede komisjoni moodustamine.</tavatekst>
          </sisuTekst>
        </alampunkt>
      </loige>
      <loige id="para2lg2">
        <loigeNr>2</loigeNr>
        <kuvatavNr><![CDATA[(2)]]></kuvatavNr>
        <sisuTekst>
          <tavatekst>Tallinna Sotsiaal- ja Tervishoiuametile delegeeritakse järgmised ülesanded:</tavatekst>
        </sisuTekst>
        <muutmismarge>
          <aktikuupaev>2025-04-03</aktikuupaev>
          <avaldamismarge>
            <RTosa>RT IV</RTosa>
            <avaldamineKuupaev>2025-04-12</avaldamineKuupaev>
            <RTartikkel>1</RTartikkel>
            <aktViide>412042025001</aktViide>
          </avaldamismarge>
          <joustumine>2025-05-01</joustumine>
        </muutmismarge>
        <alampunkt id="para2lg2p1">
          <alampunktNr>1</alampunktNr>
          <kuvatavNr><![CDATA[1)]]></kuvatavNr>
          <sisuTekst>
            <tavatekst>lapse arengut toetava keskkonna loomiseks ning laste, lastega perede ja lapsi kasvatavate isikute toimetuleku parandamiseks vajaliku teabe kogumine laste ja perede olukorra ning vajaduste kohta;</tavatekst>
          </sisuTekst>
          <muutmismarge>
            <aktikuupaev>2025-04-03</aktikuupaev>
            <avaldamismarge>
              <RTosa>RT IV</RTosa>
              <avaldamineKuupaev>2025-04-12</avaldamineKuupaev>
              <RTartikkel>1</RTartikkel>
              <aktViide>412042025001</aktViide>
            </avaldamismarge>
            <joustumine>2025-05-01</joustumine>
          </muutmismarge>
        </alampunkt>
        <alampunkt id="para2lg2p2">
          <alampunktNr>2</alampunktNr>
          <kuvatavNr><![CDATA[2)]]></kuvatavNr>
          <sisuTekst>
            <tavatekst>abi vajavast lapsest teada saamisel viivitamata lapse abivajaduse hindamine ja lapse abistamiseks meetmete pakkumine;</tavatekst>
          </sisuTekst>
          <muutmismarge>
            <aktikuupaev>2025-04-03</aktikuupaev>
            <avaldamismarge>
              <RTosa>RT IV</RTosa>
              <avaldamineKuupaev>2025-04-12</avaldamineKuupaev>
              <RTartikkel>1</RTartikkel>
              <aktViide>412042025001</aktViide>
            </avaldamismarge>
            <joustumine>2025-05-01</joustumine>
          </muutmismarge>
        </alampunkt>
        <alampunkt id="para2lg2p3">
          <alampunktNr>3</alampunktNr>
          <kuvatavNr><![CDATA[3)]]></kuvatavNr>
          <sisuTekst>
            <tavatekst>perekonnast eraldatud lapsele ja tema perekonnale meetmete pakkumine.</tavatekst>
          </sisuTekst>
          <muutmismarge>
            <aktikuupaev>2026-06-11</aktikuupaev>
            <avaldamismarge>
              <RTosa>RT IV</RTosa>
              <avaldamineKuupaev>2026-06-19</avaldamineKuupaev>
