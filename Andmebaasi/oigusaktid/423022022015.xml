 <muutmismarge id="3de0a04b-aba9-4d82-808b-eb1661d67b49"><aktikuupaev id="11a86a70-62c1-4ee3-a1ec-1f8484f0c4aa">2022-02-17</aktikuupaev><avaldamismarge id="9c3befbd-20a3-42c8-ac68-3fd7e27e56c6"><RTosa id="1159ee63-c0e9-4494-8961-5990c21229ac">RT IV</RTosa><avaldamineKuupaev id="4f08acd2-657c-4eba-8ee8-e7313598f7ba">2022-02-23</avaldamineKuupaev><RTartikkel id="128d6fcb-1d58-46df-aa1c-9793eb97817d">9</RTartikkel><aktViide id="446a57b8-07f1-46fe-8848-9c0cc7ecaea1">423022022009</aktViide></avaldamismarge><joustumine id="ec9cf8f4-fc32-4a1a-9527-6ef3bd53bfea">2022-02-26</joustumine></muutmismarge><sisu id="ec750d13-139d-4456-958a-a43dca3e23a6"><preambul id="0eafd8df-e04b-40dc-aae4-a5079109c46c"><tavatekst id="02898550-61b9-4fab-ae96-a8c98c1f2a67">Määrus kehtestatakse kohaliku omavalitsuse korralduse seaduse § 22 lõike 1 punkti 5, sotsiaalhoolekande seaduse § 14 lõike 1 ja § 17 lõike 1 alusel.</tavatekst></preambul><paragrahv id="para1"><paragrahvNr id="74909160-fd62-475d-815b-84f735d229fb">1</paragrahvNr><kuvatavNr id="eb8530a0-2d33-4d84-a2e4-ea1dd38f2a9c"><![CDATA[§ 1. ]]></kuvatavNr><paragrahvPealkiri id="2c4b06cc-6e58-4de4-a343-214c4f912b80">Üldsätted</paragrahvPealkiri><loige id="para1lg1"><loigeNr id="2489e2bf-2770-49bb-8249-1be36b0d872e">1</loigeNr><kuvatavNr id="848ee48f-a89e-46f6-8e65-e9c6b67bbee0"><![CDATA[(1)]]></kuvatavNr><sisuTekst id="98a29171-4e1d-4150-aa80-9363f857fbf3"><tavatekst id="c5d2cf33-6c81-438f-a3ba-b7683385de59">Määrusega sätestatakse Põlva Vallavalitsuse (edaspidi <i>vallavalitsus</i>) hallatava asutuse Põlva Päevakeskuse poolt korraldatava koduteenuse raames osutatavate teenuste loetelu ning koduteenuse osutamise tingimused ja kord.</tavatekst></sisuTekst><muutmismarge id="9d788443-a9f5-423c-989a-5c41d1c134c7"><avaldamismarge id="740fd592-0fa4-49f6-a1b2-7581bea39531"><RTosa id="e68fe28c-7b92-494d-ac1b-ed811f4e5490">RT IV</RTosa><avaldamineKuupaev id="35830fb4-0219-4790-91ee-2edae1468b6c">2022-02-23</avaldamineKuupaev><RTartikkel id="c70a4577-322a-46d5-8c9c-484da3195768">9</RTartikkel><aktViide id="c166aac3-fd51-47af-bb95-a49ebcc9d10b">423022022009</aktViide></avaldamismarge><joustumine id="8c7277eb-4986-47a7-9a35-cd1cc18ba517">2022-02-26</joustumine></muutmismarge></loige><loige id="para1lg2"><loigeNr id="11f8a240-471e-40e4-bada-5c07fd590dee">2</loigeNr><kuvatavNr id="eaa3cbdf-d62b-4c67-8a3c-8872b109cf13"><![CDATA[(2)]]></kuvatavNr><sisuTekst id="293ecff6-d54e-48de-904c-d4338dec4649"><tavatekst id="8ac7de56-eab7-4019-95a5-6eabca15bd95">Koduteenus on sotsiaalteenus, mille eesmärk on täisealise isiku iseseisva ja turvalise toimetuleku tagamine kodustes tingimustes, säilitades ja parandades tema elukvaliteeti.</tavatekst></sisuTekst></loige><loige id="para1lg3"><loigeNr id="099bc6ff-dfc7-4fb0-8259-5342fa72c9e9">3</loigeNr><kuvatavNr id="bb109b17-13c2-4c19-8945-b18004894667"><![CDATA[(3)]]></kuvatavNr><sisuTekst id="272d1115-f454-4759-8cdb-9ed8e5258a8f"><tavatekst id="4108805d-fb95-4340-ac90-85eecb1ea342">Määruses ettenähtud haldusmenetlusele kohaldatakse haldusmenetluse seadust, arvestades sotsiaalseadustiku üldosa seaduses sätestatud erisusi.</tavatekst></sisuTekst></loige></paragrahv><paragrahv id="para2"><paragrahvNr id="735e582b-ba3e-4db4-9dcb-e029fdde95e0">2</paragrahvNr><kuvatavNr id="ae1036d4-5a9e-4eb1-ae82-ecf32226477e"><![CDATA[§ 2. ]]></kuvatavNr><paragrahvPealkiri id="415541fa-c4ab-413c-ab5a-077e13cf4523">Koduteenuse raames osutatavate teenuste loetelu</paragrahvPealkiri><loige id="para2lg1"><loigeNr id="d3ba9ba3-2a74-4a70-941f-1ea6a2399a0e">1</loigeNr><kuvatavNr id="9cbbcc02-49f2-4cd6-b816-d95c8ee6f413"><![CDATA[(1)]]></kuvatavNr><sisuTekst id="53b17139-3283-4cc0-a2e4-d056a15daa92"><tavatekst id="3bda3d29-8225-4e4b-8c25-b2c88d023a37">Osutatavad teenused on:</tavatekst></sisuTekst><alampunkt id="para2lg1p1"><alampunktNr id="7991d0df-3509-41fc-a38e-4db3286407ea">1</alampunktNr><kuvatavNr id="00386d69-70cf-43bf-976d-d9b01776271d"><![CDATA[1) ]]></kuvatavNr><sisuTekst id="7d5e0fe7-64e2-499b-bde0-8a3d