 </aktinimi>
 <sisu id="b7bf7a0e-4b33-49e2-921c-b81041e15ba0"><preambul id="10a84eea-a39e-4285-9667-d879ab8e5f9b"><tavatekst id="acfe8343-5553-41a3-84f4-70ece8de5c8a">Määrus kehtestatakse kohaliku omavalitsuse korralduse seaduse § 22 lõike 1 punkti 5, sotsiaalseadustiku § 15 punkti 2 ja sotsiaalhoolekande seaduse § 14 alusel.</tavatekst></preambul><paragrahv id="para1"><paragrahvNr id="d66b473f-c7d8-4ab5-b7d4-60d954996d98">1</paragrahvNr><kuvatavNr id="9ff19554-fed0-4afc-8fbb-26a092c03156"><![CDATA[§ 1. ]]></kuvatavNr><paragrahvPealkiri id="d1c4caed-99cd-4043-ad7b-2e99a3450fda">Määruse reguleerimisala</paragrahvPealkiri><loige id="para1lg1"><loigeNr id="26f01498-4e8d-4bbd-9c6c-58e4bc927c8f">1</loigeNr><kuvatavNr id="244c097b-c44a-4297-8eec-b286464d2621"><![CDATA[(1)]]></kuvatavNr><sisuTekst id="0f2a7afc-6264-46c3-8252-608d30b09da9"><tavatekst id="ad2a155b-4f8e-4344-aa2a-b180d718698f">Määrus sätestab Mulgi valla eelarvest sotsiaaltoetuste taotlemise, määramise, maksmise tingimused ja korra.</tavatekst></sisuTekst></loige><loige id="para1lg2"><loigeNr id="f3cd734d-a59b-4e69-8f95-78534c72fc19">2</loigeNr><kuvatavNr id="bb3c39a9-ee26-455e-8f6e-4ac4c8933f70"><![CDATA[(2)]]></kuvatavNr><sisuTekst id="98ae961b-30d4-46f0-90eb-3280e18eace1"><tavatekst id="7175d755-a2b8-4a8c-a07e-112634bff3fe">Mulgi valla eelarvest makstavate toetuste avalduste vormid kinnitab Mulgi Vallavalitsus (edaspidi <i>vallavalitsus</i>) korraldusega.</tavatekst></sisuTekst></loige></paragrahv><paragrahv id="para2"><paragrahvNr id="021c9b73-99a4-4b14-a3bc-5bfc9e005a81">2</paragrahvNr><kuvatavNr id="ebcf1f6a-d092-49fb-8d82-e2ebf08ab8e8"><![CDATA[§ 2. ]]></kuvatavNr><paragrahvPealkiri id="b698c0d5-26f5-42e2-b5a5-06b087adb077">Toetuse eesmärk</paragrahvPealkiri><loige id="para2lg1"><loigeNr id="81bb9526-9525-42e9-be5f-a1660b63ade9"/><kuvatavNr id="616c3c53-dfdc-4a39-9a6f-1415f0a5db6c"/><sisuTekst id="66f0e3f1-8918-4a46-8de9-9fc4e2ece282"><tavatekst id="7ae7228a-9bd4-4fd0-8fd8-9c53319bfea0">Sotsiaaltoetuse maksmise eesmärk on toetada taotleja ja tema perekonna toimetulekuvõimet ja sotsiaalset heaolu.</tavatekst></sisuTekst></loige></paragrahv><paragrahv id="para3"><paragrahvNr id="5e8b810a-1d71-4a75-ba26-dc8f1b77a45d">3</paragrahvNr><kuvatavNr id="450dd736-2597-4259-bc8a-e823c07f7c0d"><![CDATA[§ 3. ]]></kuvatavNr><paragrahvPealkiri id="25a9a4cd-d97b-43ad-a3b1-7e22bcc149b3">Mõisted</paragrahvPealkiri><loige id="para3lg1"><loigeNr id="bf7fb098-2c2f-40af-bc72-83e523ec502c">1</loigeNr><kuvatavNr id="d291849c-a8e7-495e-a43f-cca68953675e"><![CDATA[(1)]]></kuvatavNr><sisuTekst id="26e03e1b-62a9-4425-a3ae-bf331ab349e5"><tavatekst id="62e85fad-f59a-4850-93f2-d4702b39df23"><b>Mulgi valla eelarvest makstavad leibkonna sissetulekust sõltuvad täiendavad sotsiaaltoetused</b> on toetused, mida makstakse vähekindlustatud või erivajadustega inimestele ja perekondadele hädavajalike kulude osaliseks katmiseks.</tavatekst></sisuTekst></loige><loige id="para3lg2"><loigeNr id="5aa84aab-db74-4d80-9502-6f7755faba06">2</loigeNr><kuvatavNr id="161651c1-922b-4444-935f-3f0f12bc2a0b"><![CDATA[(2)]]></kuvatavNr><sisuTekst id="f4bb3355-2fc6-494c-98a0-b73b6cf5677d"><tavatekst id="238fc3d8-c008-41df-9638-c57cdf28654d"><b>Vähekindlustatud isik või perekond</b> on leibkond, kelle iga liikme netosissetulek kuus on alla riiklikult kehtestatud toimetulekupiiri 2-kordse määra.</tavatekst></sisuTekst></loige><loige id="para3lg3"><loigeNr id="d44146c9-a223-4dbd-93c9-8ada989d42fa">3</loigeNr><kuvatavNr id="82c0a217-f8fb-4baf-8180-2e093397eada"><![CDATA[(3)]]></kuvatavNr><sisuTekst id="b9f9f640-fda5-4c2e-b741-26f041e25422"><tavatekst id="2348a3c2-6400-4757-878d-578542d27f3b"><b>Leibkonnana</b> käsitletakse üksikisikut, perekonda või ühist eluruumi ja ühtset tuluallikat ühiselt kasutavaid või ühise majapidamisega isikuid. Leibkonna sissetulekute arvutamisel võetakse arvesse ka taotlejast eraldi elava perekonna liikme sissetulekuid juhul, kui viimane on perekonnaseaduse järgi kohustatud üleval pidama toetuse taotlejat või taotleja ülalpidamisel olevaid isikuid.</tavatekst></sisuTekst></loige></paragrahv><paragrahv id="para4"><paragrahvNr id="a129a35a-5915-42c5-b456-3e4333e4b908">4</paragrahvNr><kuvatavNr id="3191c2c6-9af1-4c65-8421-c83e918ab924"><![CDATA[§ 4. ]]></kuvatavNr><paragrahvPealkiri id="7176b21b-91d9-4492-a756-83d6f138416c">Õigustatud isikud</paragrahvPealkiri><loige id="para4lg1"><loigeNr id="0147175e-e375-4852-bdd1-1d754de67cc8">1</loigeNr><kuvatavNr id="17032f64-8fa0-4eef-aeb8-2a616a87bdad"><![CDATA[(1)]]></kuvatavNr><sisuTekst id="0dab2629-0516-48dc-b017-5a90761a8464"><tavatekst id="7d711951-a50f-4ff8-9a21-21239ed028a1">Toetusi on õigustatud taotlema isikud, kes on rahvastikuregistri andmetel Mulgi valla elanikud.</tavatekst></sisuTekst></loige><loige id="para4lg2"><loigeNr id="806a783b-bb59-4697-aa4b-001c32000d01">2</loigeNr><kuvatavNr id="842b3fda-1e0c-41e3-8449-4b8c27dce14d"><![CDATA[(2)]]></kuvatavNr><sisuTekst id="d6ab3d2b-dc42-4832-8102-8ccc987e8995"><tavatekst id="5f85e38d-0539-4d0a-9586-a1f23ba2db45">Vältimatut sotsiaalabi on õigustatud taotlema:</tavatekst></sisuTekst><alampunkt id="para4lg2p1"><alampunktNr id="b9a3d3aa-f424-4c06-9455-ce71dcfe70e0">1</alampunktNr><kuvatavNr id="b7bd059e-bd36-4aa2-9185-72e1650a9330"><![CDATA[1) ]]></kuvatavNr><sisuTekst id="c4a5b982-dbbf-4785-a219-98a0a6270fce"><tavatekst id="3a64f233-1602-482c-80f8-38022f42c485">rahvastikuregistri andmetel Mulgi valla elanikud;</tavatekst></sisuTekst></alampunkt><alampunkt id="para4lg2p2"><alampunktNr id="33a98d38-766a-49c8-940a-0098a9984f64">2</alampunktNr><kuvatavNr id="35c97b84-eeea-4ce5-ab5b-56aacd182fad"><![CDATA[2) ]]></kuvatavNr><sisuTekst id="338b40fd-1058-4c10-958e-100f69264a85"><tavatekst id="cd5ad254-7458-4fb6-9466-9e6477b2610f">abivajamise ajal Mulgi valla haldusterritooriumil viibiv isik;</tavatekst></sisuTekst></alampunkt><alampunkt id="para4lg2p3"><alampunktNr id="91180eb0-383e-4002-b969-cd22b67f20d9">3</alampunktNr><kuvatavNr id="2af3a35d-44c3-4a5c-96b7-e006afd765fc"><![CDATA[3) ]]></kuvatavNr><sisuTekst id="cf1566a4-89d7-45b1-bc5c-ca9ead05733d"><tavatekst id="824829e6-0f8a-4dd1-9049-0e5f119deab2">isik, kelle elukohta ei saa kindlaks määrata;</tavatekst></sisuTekst></alampunkt><alampunkt id="para4lg2p4"><alampunktNr id="9caf5a5d-7fd3-4f75-89c7-85c4a00b538c">4</alampunktNr><kuvatavNr id="227c4271-ee5a-429f-b964-fa2ee1b4f665"><![CDATA[4) ]]></kuvatavNr><sisuTekst id="00b2a175-6d92-47b7-8aa7-80d2219f508c"><tavatekst id="3ab6686b-5a1c-464c-9388-ea0914934174">kinnipidamiskohast vabanenud isik, kui ta elukoht oli viimati Mulgi vallas;</tavatekst></sisuTekst></alampunkt><alampunkt id="para4lg2p5"><alampunktNr id="37d07c51-25d6-4d60-80bf-2d97c014dd94">5</alampunktNr><kuvatavNr id="04b5d958-9896-410e-998e-a59173425070"><![CDATA[5) ]]></kuvatavNr><sisuTekst id="1155e987-efb7-4fdd-a256-424bc3e51ca4"><tavatekst id="23bf4e81-8d17-4e94-bde2-773db120c44a">välismaalane, kes viibib ajutiselt Mulgi vallas.</tavatekst></sisuTekst></alampunkt></loige></paragrahv><paragrahv id="para5"><paragrahvNr id="cb6e3913-4935-4ba0-855d-77502865878b">5</paragrahvNr><kuvatavNr id="7973d435-76fd-4205-8b06-a9196c361983"><![CDATA[§ 5. ]]></kuvatavNr><paragrahvPealkiri id="0cfcd20b-b2b4-414b-9787-aab44434e5d4">Sotsiaaltoetuste liigid</paragrahvPealkiri><loige id="para5lg1"><loigeNr id="370ee387-3001-4083-9b77-198d3c56ba14">1</loigeNr><kuvatavNr id="91f54627-7db5-4dfb-9784-f117bad00dca"><![CDATA[(1)]]></kuvatavNr><sisuTekst id="987736de-4048-487e-9671-a11de38addc7"><tavatekst id="d93c6012-7881-49d2-a192-74d43bbf98c7">Mulgi valla eelarvest makstavad sissetulekust mittesõltuvad sotsiaaltoetused on:</tavatekst></sisuTekst><alampunkt id="para5lg1p1"><alampunktNr id="bb25609b-e10c-4aae-8e51-95c267b6937a">1</alampunktNr><kuvatavNr id="d53d1291-9315-4dc3-909d-24faa313e69a"><![CDATA[1) ]]></kuvatavNr><sisuTekst id="5845f5f3-b50a-487c-99f5-06cfac7ccacf"><tavatekst id="9e08c70a-caf1-4681-a495-450ec1cfdb17">sünnitoetus;</tavatekst></sisuTekst></alampunkt><alampunkt id="para5lg1p2"><alampun