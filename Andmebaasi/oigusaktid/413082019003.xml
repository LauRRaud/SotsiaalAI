			<ametinimetus id="2f370391-cf88-4c99-b3c7-8eff25f11f1d">vallavolikogu esimees</ametinimetus>
			<eesnimi id="a0aed064-6665-4566-a51e-c38605e56825">Mati</eesnimi>
			<perekonnanimi id="bf4e6b92-a0c0-4d28-89d6-5c139d847fd8">Möller</perekonnanimi>
