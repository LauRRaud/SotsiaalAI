lampunktNr><kuvatavNr id="6fcfa517-7fc5-4c9b-892c-0cfdddad2f9f"><![CDATA[1) ]]></kuvatavNr><sisuTekst id="3ec2309a-2c1c-4628-8b67-f2738cebdfec"><tavatekst id="c23694c6-ac2d-4e84-ab8c-1cb90818204e">on teadlik käesolevas määruses sätestatud toetuse taotleja kohta kehtivatest tingimustest ja toetuse saaja kohustustest;</tavatekst></sisuTekst></alampunkt><alampunkt id="para8lg1p2"><alampunktNr id="d05fc483-6c71-4422-8824-4c374a4afba1">2</alampunktNr><kuvatavNr id="fbe9827c-ae27-46ab-8003-18e567c6e62c"><![CDATA[2) ]]></kuvatavNr><sisuTekst id="181fd3dd-a004-4793-82f1-e4375330872a"><tavatekst id="18cc1c61-fd2b-4de8-af33-249a935fecea">kohustub toetuse saamisel täitma kõiki õigusaktidega teenuse osutajale sätestatud nõudeid ja hoiab ennast vastavuses tingimustega, mis kehtivad teenuse osutaja suhtes.</tavatekst></sisuTekst></alampunkt></loige><loige id="para8lg2"><loigeNr id="a6cca3b5-b17b-42d8-958c-dcf31eab8d07">2</loigeNr><kuvatavNr id="a2f10e30-8959-4d88-972a-5df075ae50d5"><![CDATA[(2)]]></kuvatavNr><sisuTekst id="1ea479c7-da2b-446d-b322-2390d017377e"><tavatekst id="f80b6788-3ae7-4972-a7a7-6f9aadcbec44">Lisaks käesoleva paragrahvi lõikes 1 sätestatule kohustub toetuse saaja:</tavatekst></sisuTekst><alampunkt id="para8lg2p1"><alampunktNr id="ef35308c-31b4-4c6d-97c8-3a5d567accef">1</alampunktNr><kuvatavNr id="f16001ad-af16-4061-9622-1e79b61ab5f6"><![CDATA[1) ]]></kuvatavNr><sisuTekst id="a2bfa561-028c-4f6b-b9fb-0efd76ae1e62"><tavatekst id="84dd8d8b-3b3c-4982-86b8-80af96f1f6bf">osutama Tartu Linnavalitsuse poolt teenusele suunatud isikule määratud mahus teenust tasuta;</tavatekst></sisuTekst></alampunkt><alampunkt id="para8lg2p2"><alampunktNr id="ab38ed80-d25f-4cce-9d60-3a520751adc5">2</alampunktNr><kuvatavNr id="03b92326-8d0f-4ed6-89e6-21e29ed49b1a"><![CDATA[2) ]]></kuvatavNr><sisuTekst id="11ad778c-9aea-46d7-b336-2a8318c173ae"><tavatekst id="093eeb4d-6c41-4b47-becc-acdab6901f0a">kontrollima, et teenust saav isik on Tartu Linnavalitsuse poolt teenusele suunatud, ja jälgima, et isikule määratud teenuse mahtu ei ületataks;</tavatekst></sisuTekst></alampunkt><alampunkt id="para8lg2p3"><alampunktNr id="f622177c-9dfb-44aa-8952-13e05d7c5630">3</alampunktNr><kuvatavNr id="99e33c36-140d-458f-958c-9864c3677ee6"><![CDATA[3) ]]></kuvatavNr><sisuTekst id="a90c5b94-2af8-4e7c-bd0c-58e95ac12813"><tavatekst id="b725cfd7-35a2-40d0-a78b-68cbca7be5e5">pidama poole tunni täpsusega arvestust isikule osutatava teenuse mahu üle ja võtma teenuse osutamise kontrollimise tagamiseks isikult teenuse saamise kohta kinnituse;</tavatekst></sisuTekst></alampunkt><alampunkt id="para8lg2p4"><alampunktNr id="7e7a9af5-c8c8-4293-bb77-86b880ba9621">4</alampunktNr><kuvatavNr id="da3fe544-ece7-4e86-9a44-f391f9187083"><![CDATA[4) ]]></kuvatavNr><sisuTekst id="4b6d96d5-d984-4be4-9f72-a6d02e25404c"><tavatekst id="cc52ecf5-48e6-420a-a6d6-fe533d37a2eb">lubama Tartu linnal teha järelevalvet teenuse osutamise nõuete täitmise, teenuse osutaja suhtes kehtivate tingimuste ja toetuse kasutamise üle.</tavatekst></sisuTekst></alampunkt></loige></paragrahv><paragrahv id="para9"><paragrahvNr id="dd541cb7-6445-4842-bd64-6d0624e979d8">9</paragrahvNr><kuvatavNr id="ff86d3fe-b7ec-426b-9dc7-373a1f917d84"><![CDATA[§ 9. ]]></kuvatavNr><paragrahvPealkiri id="855998fd-a620-4317-8130-1ac7fae41f19">Toetuse andmine ja väljamaksmine</paragrahvPealkiri><loige id="para9lg1"><loigeNr id="8a47cfe4-2260-4f56-8b85-2c7f2a2f4ec4">1</loigeNr><kuvatavNr id="9a4d5151-2db8-4758-aa7c-d504d5986f53"><![CDATA[(1)]]></kuvatavNr><sisuTekst id="697b4c51-cfff-4b77-af7c-497c63831aa8"><tavatekst id="4e129f72-2181-453b-84c2-4f1e42f32a07">Toetuse taotluse vaatab läbi Tartu Linnavalitsuse sotsiaal- ja tervishoiuosakonna spetsialist, kellel on õigus puuduste ilmnemisel taotlus puuduste kõrvaldamiseks tagasi lükata.</tavatekst></sisuTekst></loige><loige id="para9lg2"><loigeNr id="c58e9bcd-5e9e-48b2-88df-b106271a027f">2</loigeNr><kuvatavNr id="4213964d-feca-48e1-a66d-0bab02e884ac"><![CDATA[(2)]]></kuvatavNr><sisuTekst id="05d391af-4f61-46aa-b582-116b5b04947a"><tavatekst id="8d26c4f9-b38c-4a3a-9052-fe0c573a2e84">Toetuse andmise otsus tehakse toetuse väljamaksega ja toetus makstakse välja hiljemalt teenuse osutamisele järgneva kuu 20. kuupäevaks ülekandega teenuse osutaja arvelduskontole.</tavatekst></sisuTekst></loige></paragrahv><paragrahv id="para10"><paragrahvNr id="1c04967a-f7ec-4d28-a7dc-22aa722f7a58">10</paragrahvNr><kuvatavNr id="9b3f899a-d045-4dc0-abe0-492a6b59e1e7"><![CDATA[§ 10. ]]></kuvatavNr><paragrahvPealkiri id="1775d457-6718-4727-8d1a-594920e51660">Toetuse andmata jätmine</paragrahvPealkiri><loige id="para10lg1"><loigeNr id="636f06a7-8fdc-4b43-98d4-595debc8825d">1</loigeNr><kuvatavNr id="89382c8d-5910-43ce-97b1-445073a9fef8"><![CDATA[(1)]]></kuvatavNr><sisuTekst id="18ef5cc4-5c2d-4511-9e6c-56ef2f1d3564"><tavatekst id="c620c67c-cf9a-47ea-9373-e86d374d03e1">Toetus jäetakse andmata isiku kohta, kelle rahvastikuregistrijärgne elukoht ei ole Tartu linn.</tavatekst></sisuTekst></loige><loige id="para10lg2"><loigeNr id="169db953-d7d0-47e0-81ea-aa8d1ceeae05">2</loigeNr><kuvatavNr id="48e7d02f-dc3d-4c70-b2ea-24329f7dd94b"><![CDATA[(2)]]></kuvatavNr><sisuTekst id="5b2a9937-ed96-4ce9-b8f6-db87744d75b8"><tavatekst id="b21252c0-4682-4b3a-b7e6-e253527fd783">Toetuse andmata jätmise kohta saadab Tartu Linnavalitsuse sotsiaal- ja tervishoiuosakond toetuse taotlejale kirja.</tavatekst></sisuTekst></loige></paragrahv><paragrahv id="para11"><paragrahvNr id="4f3f0115-04e9-49b1-a4ea-fc038b700c9a">11</paragrahvNr><kuvatavNr id="84dad811-b9ce-4222-8f0b-6a3008e98cef"><![CDATA[§ 11. ]]></kuvatavNr><paragrahvPealkiri id="daa70e9b-440a-4546-9b06-deb351b0be6a">Toetuse andmise peatamine või andmata jätmine probleemide korral teenuse osutamisel</paragrahvPealkiri><loige id="para11lg1"><loigeNr id="4921a2d6-0091-4f4f-b9af-15cdb6010fb1">1</loigeNr><kuvatavNr id="9b06a62a-cebd-48d8-b814-55b3e2da7a37"><![CDATA[(1)]]></kuvatavNr><sisuTekst id="1835f2e3-5999-4f9a-9a26-301c1361696f"><tavatekst id="2a22add0-20fd-465f-a389-c6bb993c3247">Kui toetust taotleva isiku üle on algatatud järelevalvemenetlus või kui osakonnale on laekunud teenuse osutaja kohta kaebusi või on ilmnenud asjaolusid, mis välistavad seaduspärase teenuse osutamise, võib toetuse andmise peatada või toetuse andmata jätta.</tavatekst></sisuTekst></loige><loige id="para11lg2"><loigeNr id="c6352b06-8df7-4c35-9d15-5547d1246db5">2</loigeNr><kuvatavNr id="d811e579-b395-45c9-93cb-731c197553f2"><![CDATA[(2)]]></kuvatavNr><sisuTekst id="2a8c6b94-f9e2-4105-95c2-c97631f96162"><tavatekst id="fe4ca434-061d-4d7e-b46a-b27afbcb4fdd">Käesoleva paragrahvi lõikes 1 nimetatud juhul toetuse andmise peatamise või toetuse andmata jätmise kohta teeb otsuse Tartu Linnavalitsuse sotsiaal- ja tervishoiuosakond.</tavatekst></sisuTekst></loige><loige id="para11lg3"><loigeNr id="410e5299-12dd-4057-8e2b-88b0bfb25403">3</loigeNr><kuvatavNr id="9b61924c-2bca-4eb9-846c-7d666975bc30"><![CDATA[(3)]]></kuvatavNr><sisuTekst id="ec65eb19-d6d5-4038-8359-4f2b4eed25a2"><tavatekst id="b96853e9-9f08-4e86-a0de-84f322c9614d">Toetuse andmise peatamise või andmata jätmise asjaolude äralangemisel on Tartu Linnavalitsuse sotsiaal- ja tervishoiuosakonnal õigus enne toetuse taas andma asumist nõuda käesoleva määruse paragrahvi 3 või 4 lõikes 2 nimetatud taotluse uuesti esitamist.</tavatekst></sisuTekst></loige></paragrahv><paragrahv id="para12"><paragrahvNr id="42518f0f-77e3-48f0-95e6-d0f33211d606">12</paragrahvNr><kuvatavNr id="fbe2715d-d95c-42c6-b467-7c8979a8223c"><![CDATA[§ 12. ]]></kuvatavNr><paragrahvPealkiri id="5b3c99f5-1e9d-4638-9350-748d15ff51c4">Rakendussätted</paragrahvPealkiri><loige id="para12lg1"><loigeNr id="ffdb0024-a514-4408-bd7b-1b4bc9c85cdf">1</loigeNr><kuvatavNr id="8cb671da-5377-45b9-befa-63299d244dc2"><![CDATA[(1)]]></kuvatavNr><sisuTekst id="a17a15e3-16dd-4154-9557-df39f822e4f8"><tavatekst id="3d9a2e9e-09a1-4273-9403-c33ea3390e92"> [Käesolevast tekstist välja jäetud].</tavatekst></sisuTekst></loige><loige id="para12lg2"><loigeNr id="54cf4d9f-4295-4dab-b704-c1a2adaf752d">2</loigeNr><kuvatavNr id="bf833adb-f298-436c-97f2-737d1e1ad111"><![CDATA[(2)]]></kuvatavNr><sisuTekst id="36a418dd-aa1b-43e8-b884-c17eeb9d09f0"><tavatekst id="61fe390d-63b1-4e4c-8837-92eec69d6080">Vaimse tervise teenuse osutaja toetuse saajaks kvalifitseerumiseks esitab toetust taotleda sooviv juriidiline isik, kelle vahetult teenust osutav isik ei oma kutset, isiku nime ja isikukoodile lisaks vastava isiku diplomi koopia.</tavatekst></sisuTekst></loige></paragrahv><paragrahv id="para13"><paragrahvNr id="9764e738-fa15-46b0-b712-94f4d0706b3b">13</paragrahvNr><kuvatavNr id="dc84226d-6a67-4ce4-881b-a7ae577408f0"><![CDATA[§ 13. ]]></kuvatavNr><paragrahvPealkiri id="5ac7527f-eb9f-4fc8-8c52-22369eeb5336">Määruse jõustumine</paragrahvPealkiri><loige id="para13lg1"><loigeNr id="5282a728-479e-4bea-ae11-005de544e08c"/><kuvatavNr id="26b28a11-ce15-4176-9659-8cd6ff83f336"/><sisuTekst id="77b4a21b-223d-4bee-b90b-78b551ec6e75"><tavatekst id="f8d4985c-3de4-4bfa-bfe5-1d522fb6627f">Määrus jõustub 1. jaanuaril 2025. a.</tavatekst></sisuTekst></loige></paragrahv></sisu>
