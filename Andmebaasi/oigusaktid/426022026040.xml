9-4f48-80f4-6cebb32a48c2"><![CDATA[(2)]]></kuvatavNr><sisuTekst id="65f2f296-0495-421c-8bc5-d96798edc6d1"><tavatekst id="a3472ce3-7b1e-437c-b78a-3df9d41930a4">Taotlus esitatakse hiljemalt teenuse osutamisele järgneva kuu viiendaks kuupäevaks eelmisel kuul osutatud teenuse kohta.</tavatekst></sisuTekst></loige><loige id="para7lg3"><loigeNr id="d6d3affc-fe4c-498c-9704-ee6b71e6ba4f">3</loigeNr><kuvatavNr id="41dc09b5-3f86-4dff-a81e-7e47041501b2"><![CDATA[(3)]]></kuvatavNr><sisuTekst id="cd274860-a13e-4b67-9331-af29a96c6113"><tavatekst id="aea0fdf2-a821-4736-a69e-6b6e12775eaa">Toetuse taotlus peab sisaldama järgmisi andmeid:</tavatekst></sisuTekst><alampunkt id="para7lg3p1"><alampunktNr id="41ffbac0-d9ff-4aa7-8526-b2165ff49cda">1</alampunktNr><kuvatavNr id="add7dd8c-bf61-46bb-b639-3093c23a052a"><![CDATA[1) ]]></kuvatavNr><sisuTekst id="3ff458b9-27aa-47aa-985b-5037a27edbb0"><tavatekst id="eecf8e2c-0780-4d1f-9d4c-fa99382f4121">osutatud teenuse nimi, sh vaimse tervise teenuse liik;</tavatekst></sisuTekst></alampunkt><alampunkt id="para7lg3p2"><alampunktNr id="90b4e3ae-87aa-4f49-a0c0-1ff500d2bef0">2</alampunktNr><kuvatavNr id="2fe8ae95-d36c-4489-a8c1-7bde2d63b84e"><![CDATA[2) ]]></kuvatavNr><sisuTekst id="71d757ad-acf0-44ab-90ad-0a8a3d1d918d"><tavatekst id="996f3b2d-82fe-4fa0-bdc3-72de87e08c3b">teenust saanud isiku nimi ja isikukood;</tavatekst></sisuTekst></alampunkt><alampunkt id="para7lg3p3"><alampunktNr id="ef0e83c6-1555-42de-bb3d-9b7e02ce922f">3</alampunktNr><kuvatavNr id="21e6f792-982f-44ce-b7f2-1ff5ab5d84e5"><![CDATA[3) ]]></kuvatavNr><sisuTekst id="4492e8c8-3ab7-4ca6-874a-5f24c477800d"><tavatekst id="ef897eb8-2aec-4534-b657-240ac4604976">teenuse osutamise kuupäevad, kellaajad ja tundide arv (poole tunni täpsusega);</tavatekst></sisuTekst></alampunkt><alampunkt id="para7lg3p4"><alampunktNr id="0d656186-5ab1-4e63-92c2-ddd11c78e58c">4</alampunktNr><kuvatavNr id="6c910081-5dac-4f11-89aa-c074aabe0019"><![CDATA[4) ]]></kuvatavNr><sisuTekst id="94914662-8a2f-4daf-8775-352c