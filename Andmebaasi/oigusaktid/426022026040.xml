1) ]]></kuvatavNr><sisuTekst id="8388d1eb-c566-4809-9d1f-f487d3516d53"><tavatekst id="27bd94a5-f41d-48d8-bfd1-f04854629898">vastab paragrahvis 2 nimetatud määruse nõuetele;</tavatekst></sisuTekst></alampunkt><alampunkt id="para4lg2p2"><alampunktNr id="3475ef56-dba5-446c-96d1-1f4469567020">2</alampunktNr><kuvatavNr id="74f95f99-d4c7-4bdf-8fb5-57ebf0553dea"><![CDATA[2) ]]></kuvatavNr><sisuTekst id="e3eaadaf-f559-45bb-8791-ed689e550f90"><tavatekst id="ea870534-7abf-437c-ada3-600be78d66c8">osutab teenust viipekeeletõlgi abil, kellel on viipekeeletõlgi kutsestandardile vastav kutse.</tavatekst></sisuTekst></alampunkt></loige><loige id="para4lg3"><loigeNr id="a53c2b05-b5a7-44a9-be66-e7aff632d04a">3</loigeNr><kuvatavNr id="7972cd94-b214-4031-8dd3-ac7b0804fd2a"><![CDATA[(3)]]></kuvatavNr><sisuTekst id="26ca3e4a-4c24-49d0-b2a8-be1abdd24bde"><tavatekst id="005f778b-4db2-41bb-b753-8121366bc7d0">Viipekeele tõlketeenuse osutaja toetuse saajaks kvalifitseerumiseks esitab toetust taotleda sooviv juriidiline isik hiljemalt toetuse taotlemisele eelneva kuu esimeseks kuupäevaks ja hiljem iga aasta 1. detsembriks Tartu linnaportaalis enda kohta järgmised andmed:</tavatekst></sisuTekst><alampunkt id="para4lg3p1"><alampunktNr id="8cdf3645-2376-4194-b339-7422dd92be43">1</alampunktNr><kuvatavNr id="8b9679d5-9344-4ee1-a47c-8f9a565b20ee"><![CDATA[1) ]]></kuvatavNr><sisuTekst id="944d7487-0b13-4985-ac99-081003da00e5"><tavatekst id="d113c77a-7fa6-4deb-a7e7-45ea00474bd8">kinnituse, et ta vastab paragrahvis 2 nimetatud määruse nõuetele;</tavatekst></sisuTekst></alampunkt><alampunkt id="para4lg3p2"><alampunktNr id="3bd5554a-e80b-433e-a081-540ce0ce37ec">2</alampunktNr><kuvatavNr id="4b3e96cb-fbfe-480f-aac6-f91e21ec5118"><![CDATA[2) ]]></kuvatavNr><sisuTekst id="66415b16-80f5-41d6-9ddc-95b80bad6b87"><tavatekst id="e081dfd3-00d5-41b5-85a2-a3a226999419">vahetult teenust osutava viipekeele tõlgi nime ja isikukoodi;</tavatekst></sisuTekst></alampunkt><alampunkt id="para4lg3p3"><alampunktNr id="8aa8b55