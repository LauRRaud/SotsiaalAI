			<pealkiri id="bfdaadd0-d63c-4834-b0ad-0f9fe40b7d84">Toimetulekutoetuse määramisel aluseks võetavate eluasemekulude piirmäärad</pealkiri>
		</nimi>
	</aktinimi>
	<muutmismarge id="077e5804-964f-42e5-9e91-979e507e92b1">
		<aktikuupaev id="5eb1b03f-4968-464b-9ea2-43006c6e6d22">2024-12-18</aktikuupaev>
		<avaldamismarge id="80d0fe2b-ab26-4fa2-8c4b-669f45100a6a">
			<RTosa id="b7a6ca4d-e9d9-47ab-bf4b-ef338fc4af77">RT IV</RTosa>
			<avaldamineKuupaev id="4273457d-ddcf-4e50-8b96-778a2d74a9e5">2024-12-28</avaldamineKuupaev>
