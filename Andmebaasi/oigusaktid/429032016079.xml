			<pealkiri id="10dc8f17-b58e-4e83-b07e-a7d06668c9a2">Sotsiaalhoolekande alastele ja tervist edendavatele tegevustele toetuse eraldamise kord </pealkiri>
		</nimi>
	</aktinimi>
	<muutmismarge id="75d48f67-83ae-4f1c-ac66-95cc3ab59392">
		<aktikuupaev id="6ecc3467-ce99-4df1-91ac-e1794e9bd918">2016-03-18</aktikuupaev>
		<avaldamismarge id="b71f1108-1e86-4f05-be1d-a0d51e5285b1">
			<RTosa id="38dd20b4-f823-4254-bd6c-437725b8e317">RT IV</RTosa>
			<avaldamineKuupaev id="7fb6273e-5375-4c78-9128-fd1381082c2e">2016-03-29</avaldamineKuupaev>
			<RTartikkel id="0631beb3-af87-4b10-9b93-bcb34cf9f11e">33</RTartikkel>
