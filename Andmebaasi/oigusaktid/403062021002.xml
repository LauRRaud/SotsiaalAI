				<loigeNr id="e45f164c-281f-42cd-9e49-ce97612908fb"/>
				<kuvatavNr id="dba2ee85-c05e-4325-b297-c93e784341c8"/>
				<sisuTekst id="96b0d9b1-6175-4b62-8be8-3bfdd896eb65">
					<tavatekst id="0e8598f7-93e1-4a7a-9719-e6c75ec08e98">Enne käesoleva määruse jõustumist sõlmitud koduteenuse osutamise lepingud kehtivad lepingus märgitud kuupäevani või lepingu lõpetamist tingiva asjaolu saabumiseni.</tavatekst>
				</sisuTekst>
			</loige>
