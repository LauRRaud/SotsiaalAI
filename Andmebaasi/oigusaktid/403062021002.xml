			</loige>
			<loige id="para10lg2">
				<loigeNr id="3780b0ac-35b4-4e0b-bd0f-74d7c618de17">2</loigeNr>
				<kuvatavNr id="8b89b18d-ee03-4562-a582-f54280c5609d"><![CDATA[(2)]]></kuvatavNr>
				<sisuTekst id="9f8bce5c-b4a3-4d10-9fbd-679f8b85cf8d">
					<tavatekst id="2689f64d-96c1-4edb-b874-76621b3b70a2">Erandjuhul võib osutada koduteenust tasuta.</tavatekst>
				</sisuTekst>
			</loige>
		</paragrahv>
