				<kuvatavNr id="0b78817c-5c4f-44e4-a280-72c804c80a9b"/>
				<sisuTekst id="fa878076-d564-476b-888b-08e30cc5f7c9">
					<tavatekst id="a2fa11f8-f9e5-4e69-a189-a2498b11539a">Tunnistada kehtetuks Peipsiääre Vallavolikogu 30.05.2018 määrus nr 24 "Koduteenuste osutamise tingimused ja kord".</tavatekst>
				</sisuTekst>
			</loige>
		</paragrahv>
