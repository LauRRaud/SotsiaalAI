		<paragrahv id="para10">
			<paragrahvNr id="5e6aa226-b68b-4014-a534-52c71479abe0">10</paragrahvNr>
			<kuvatavNr id="3a58e83c-85fd-4102-84bc-5b9bed94496c"><![CDATA[§ 10. ]]></kuvatavNr>
			<paragrahvPealkiri id="765c8846-d75d-4c63-8dcb-ab6b9a5f4a38">Koduteenuse eest tasumine</paragrahvPealkiri>
			<loige id="para10lg1">
				<loigeNr id="d5526743-7e3e-480d-b632-e33ef4097268">1</loigeNr>
				<kuvatavNr id="8318fb0a-d48c-4896-afa9-581cefc06bcd"><![CDATA[(1)]]></kuvatavNr>
				<sisuTekst id="74290413-a7f8-4fbc-9ed3-b32cef8b9294">
					<tavatekst id="8d92a955-76e3-441f-ab4c-227f91e7c355">Klient tasub teenuse eest vastavalt vallavalitsuse kehtestatud hinnakirjale.</tavatekst>
