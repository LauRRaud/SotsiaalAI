				<kuvatavNr id="915fd50a-9e5e-436e-906d-b265ea168395"/>
				<sisuTekst id="aac33fec-e969-4201-9ad2-facc181b756d">
					<tavatekst id="2306203a-f1b6-4592-865c-f7d2794336e7">Vallavalitsus kinnitab määruse rakendamiseks vajalike dokumentide vormid.</tavatekst>
				</sisuTekst>
			</loige>
		</paragrahv>
