 <muutmismarge id="96af9e83-8504-4049-8894-e0abb4d9f42a"><aktikuupaev id="22f0a687-2f1a-4230-8740-3a6b14f8063f">2023-06-29</aktikuupaev><avaldamismarge id="87ae878c-fde5-47ac-b87d-d89a323625d9"><RTosa id="07ae4583-5a0e-4b1f-96a3-c3fc1d46c0e3">RT IV</RTosa><avaldamineKuupaev id="a8413fd0-4be1-42b3-a9db-3f86a68d81cd">2023-07-07</avaldamineKuupaev><RTartikkel id="79879ebb-97e1-4a2a-b4f4-ecc105bbdc89">12</RTartikkel><aktViide id="b551df5b-9260-4003-bef8-582bce4e5f7c">407072023012</aktViide></avaldamismarge><joustumine id="7fe5a034-f5fa-40a1-9899-28b371e90694">2023-07-10</joustumine><tavatekst id="7c400b72-19c1-4fae-91bf-678e9067f9a2">, rakendatakse alates 01.07.2023</tavatekst></muutmismarge><muutmismarge id="7b14eaca-3074-4c99-bc5f-3f82a46bbb8b"><aktikuupaev id="6d342d14-98cb-4d7f-b086-ba1f87e6dd71">2026-09-17</aktikuupaev><avaldamismarge id="70a60b1b-b047-45bf-abfd-22f844413352"><RTosa id="121892a2-529c-439e-8b55-40935f64dbee">RT IV</RTosa><avaldamineKuupaev id="1d2c7457-8fc8-43bd-ad3d-32eacb65ef28">2026-09-29</avaldamineKuupaev><RTartikkel id="da408686-8d93-4c26-bf0a-74f671f7bfe7">1</RTartikkel><aktViide id="a330d1ae-33fb-40dc-8124-1c6659d39c3f">429092026001</aktViide></avaldamismarge><joustumine id="a78c2757-57f1-4dc7-b71a-aaaa4eb4d39e">2026-10-02</joustumine><tavatekst id="ad13b2a5-e1f4-4b03-86dc-2a97451b8778">, rakendatakse alates 01.08.2026</tavatekst></muutmismarge><sisu id="5665d1d7-fa2e-42de-ba99-65f7b5fabf4a"><preambul id="40398eee-e13f-492c-a2b8-2d3130fea538"><tavatekst id="08ab5cce-0de0-4961-a3f7-d527a69b467d">Määrus kehtestatakse kohaliku omavalitsuse korralduse seaduse § 22 lõike 1 punkti 5, sotsiaalhoolekande seaduse § 14 lõigete 1 ja 2 ning 2. jaotise alusel.</tavatekst></preambul><paragrahv id="para1"><paragrahvNr id="690d81dd-bd89-4666-aa6b-a6ba43174913">1</paragrahvNr><kuvatavNr id="b10b929a-678a-477b-859c-97ff8738614c"><![CDATA[§ 1. ]]></kuvatavNr><paragrahvPealkiri id="189a9c72-bc29-4a6d-aef6-5d03bda82687">Üldsätted</paragrahvPealkiri><loige id="para1lg1"><loigeNr id="bd1d6e0b-2f36-4618-880e-405938a05f36">1</loigeNr><kuvatavNr id="0e64cd6b-e329-4c51-8e08-7d4219020d1f"><![CDATA[(1)]]></kuvatavNr><sisuTekst id="54745f24-cecc-4785-b46f-25e25a7d71f4"><tavatekst id="6bf79868-a1b5-4774-81af-ad2cb145f2d0">Määrusega kehtestatakse Põlva Vallavalitsuse (edaspidi <i>vallavalitsus</i>) eelarvest väljaspool kodu osutatava üldhooldusteenuse (edaspidi <i>teenus</i>) korraldamise ja rahastamise kord.</tavatekst></sisuTekst></loige><loige id="para1lg2"><loigeNr id="eaa24b82-6619-42dd-ae29-f4b1ae256c91">2</loigeNr><kuvatavNr id="6a2ce3f4-575e-4326-9aee-4860171d67f9"><![CDATA[(2)]]></kuvatavNr><sisuTekst id="d2a354f1-eebe-4b16-a6f9-6a9898777f21"><tavatekst id="8901b8d5-4890-4d0b-8ea3-d889ba4faeac">Määruses ettenähtud haldusmenetlusele kohaldatakse haldusmenetluse seadust, arvestades sotsiaalseadustiku üldosa seaduses sätestatud erisusi.</tavatekst></sisuTekst></loige></paragrahv><paragrahv id="para2"><paragrahvNr id="baf5ea0d-382b-4f48-b39a-a64489541860">2</paragrahvNr><kuvatavNr id="ded05ecb-47ea-4328-88ad-10a3a80902ad"><![CDATA[§ 2. ]]></kuvatavNr><paragrahvPealkiri id="c2ca93a3-feb8-4206-8d1c-8b2ad7050ce5">Väljaspool kodu osutatava üldhooldusteenuse kirjeldus</paragrahvPealkiri><loige id="para2lg1"><loigeNr id="025cc261-2748-4f11-9d30-8ddf7574913e">1</loigeNr><kuvatavNr id="454814de-4bd8-406c-8c2d-5a6a451798fe"><![CDATA[(1)]]></kuvatavNr><sisuTekst id="072cbd5d-fcb4-433b-9c8b-534ba07e3c29"><tavatekst id="edf2bfe9-fc97-463b-a3b6-105effe1f4a7">Väljaspool isiku kodu osutatav üldhooldusteenus on sotsiaalteenus, mille eesmärk on turvalise keskkonna ja toimetuleku tagamine täisealisele isikule, kes terviseseisundist, tegevusvõimest või elukeskkonnast tulenevatel põhjustel ei suuda kodustes tingimustes ajutiselt või püsivalt iseseisvalt toime tulla.</tavatekst></sisuTekst></loige><loige id="para2lg2"><loigeNr id="2e1f8801-5193-4d7a-8fb9-09c7ee44d410">2</loigeNr><kuvatavNr id="9edd72a3-e3ab-4dba-afd4-d1bfd7a68ba5"><![CDATA[(2)]]></kuvatavNr><sisuTekst id="63b4143a-fd8c-4634-93d4-248cf7aaee74"><tavatekst id="d3a1d8f6-399a-4ad5-9b25-a49b6e3a0bc6">Teenust osutatakse vastavalt isiku vajadusele tähtajatult (pikaajaliselt) või tähtajaliselt (lühiajaliselt).</tavatekst></sisuTekst></loige></paragrahv><paragrahv id="para3"><paragrahvNr id="220fc3c3-da6d-4a8a-a88b-6b9cb62735d1">3</paragrahvNr><kuvatavNr id="4c8f5032-877c-471d-98b1-926952b86903"><![CDATA[§ 3. ]]></kuvatavNr><paragrahvPealkiri id="9bf8b241-ff7d-4c01-83e8-b4142e2719f7">Teenuse saajad</paragrahvPealkiri><loige id="para3lg1"><loigeNr id="0303f940-5e2e-4569-a98b-e6a5b4ad1bf6"/><kuvatavNr id="5c79a391-c720-47af-a32b-f56d96924c6d"/><sisuTekst id="91fd5951-2e3e-4b69-8028-a32d4f1102ea"><tavatekst id="c83cce07-6669-46d0-b1e5-1292b991de4c">Teenust osutatakse isikule:</tavatekst></sisuTekst><alampunkt id="para3lg1p1"><alampunktNr id="1d2d64ef-b1b8-4a42-9518-520e6fe5200d">1</alampunktNr><kuvatavNr id="2e478429-e154-4cd4-b410-aeb0cf5583a8"><![CDATA[1) ]]></kuvatavNr><sisuTekst id="181d632a-6258-430f-a4ad-459c05a6c3e1"><tavatekst id="7e31d946-8219-45d7-ac7b-c5b3015e48eb">kelle toimetulekut ei ole võimalik tagada teiste sotsiaalteenuste või muu abi osutamisega;</tavatekst></sisuTekst></alampunkt><alampunkt id="para3lg1p2"><alampunktNr id="14eb896d-1044-42df-b7c2-c7debcde0169">2</alampunktNr><kuvatavNr id="a2b74917-1619-487b-a81d-2a005479b9a1"><![CDATA[2) ]]></kuvatavNr><sisuTekst id="92462f14-d58e-408d-8f80-f962ddd667ae"><tavatekst id="6be68ff7-74e6-4eef-8cff-4ea641045868">kelle rahvastikuregistrijärgne elukoht on Põlva vallas;</tavatekst></sisuTekst></alampunkt><alampunkt id="para3lg1p3"><alampunktNr id="ee5c0821-f8ed-4ca7-a98f-80277222abae">3</alampunktNr><kuvatavNr id="c8bc5347-6ab7-4d76-84e8-946b5b24427d"><![CDATA[3) ]]></kuvatavNr><sisuTekst id="d631b420-6a86-4245-beab-9a9c7377de70"><tavatekst id="8bc58b54-9f9f-4209-9e15-424f8ac79307">kelle rahvastikuregistrijärgne elukoht on Põlva vallas, viibimiskoht (ööpäevaringse üldhooldusteenuse osutaja) on teises omavalitsusüksuses.</tavatekst></sisuTekst></alampunkt></loige></paragrahv><paragrahv id="para4"><paragrahvNr id="d063c9f6-f1f6-45bc-ab94-8061055a27f3">4</paragrahvNr><kuvatavNr id="10c5a260-0979-48a2-b52a-4063b7a9881b"><![CDATA[§ 4. ]]></kuvatavNr><paragrahvPealkiri id="d5390fd8-15e1-4fa6-855c-d45c460e55b2">Teenuse taotlemine ja taotluse menetlemine</paragrahvPealkiri><loige id="para4lg1"><loigeNr id="8b8c6ea7-ee08-4d5a-9949-d3646d46db97">1</loigeNr><kuvatavNr id="a40bed9b-f9db-4523-8be7-015084976c91"><![CDATA[(1)]]></kuvatavNr><sisuTekst id="3c762d8a-9be3-420d-b114-1dc6d86d4c8b"><tavatekst id="343b6016-33f0-4b63-93ca-33ce9a74c16d">Teenuse taotlemiseks esitatakse vallavalitsusele kirjalik taotlus.</tavatekst></sisuTekst></loige><loige id="para4lg2"><loigeNr id="2cefecdd-b817-4326-adcb-8bcf844291e8">2</loigeNr><kuvatavNr id="0df3a17a-137c-4d54-8751-3412a8d42ca3"><![CDATA[(2)]]></kuvatavNr><sisuTekst id="faf3ca3e-1793-4cd1-aabd-5b66bd6591bd"><tavatekst id="f8e5d617-0ab3-49dd-a417-d0385fca8a71">Taotluses märgitakse:</tavatekst></sisuTekst><alampunkt id="para4lg2p1"><alampunktNr id="e81d89b5-ef5b-4c4c-8988-27318eaa8206">1</alampunktNr><kuvatavNr id="ebf476f3-8559-4cf7-b0fe-88a749666b46"><![CDATA[1) ]]></kuvatavNr><sisuTekst id="e18b2309-1b36-47bb-9d68-799864886c15"><tavatekst id="0b462bbc-08f5-40a5-84ef-9f53966d9a1e">teenuse taotleja ees- ja perekonnanimi;</tavatekst></sisuTekst></alampunkt><alampunkt id="para4lg2p2"><alampunktNr id="09489779-a3b4-4428-98d6-f3811cc65a93">2</alampunktNr><kuvatavNr id="79d812e2-dd37-4b61-b77f-395ed151b341"><![CDATA[2) ]]></kuvatavNr><sisuTekst id="c5095b38-3cd4-4a12-bea9-808fb18136f6"><tavatekst id="4cf00533-8b68-445a-9ea3-4265b69346c2">teenuse taotleja isikukood;</tavatekst></sisuTekst></alampunkt><alampunkt id="para4lg2p3"><alampunktNr id="8d5f4fe6-26ff-421f-8bf4-0eed9a66cafd">3</alampunktNr><kuvatavNr id="25711374-ff52-4441-ab35-d25cff63f08d"><![CDATA[3) ]]></kuvatavNr><sisuTekst id="c0d14d01-5901-4bb4-a1e1-fd15be65cd0d"><tavatekst id="745c1252-0f4e-40ed-8e56-96e5eabe65fb">teenuse taotleja elukoht;</tavatekst></sisuTekst></alampunkt><alampunkt id="para4lg2p4"><alampunktNr id="e0bbe9d9-75ed-488c-941f-f25c130c7be6">4</alampunktNr><kuvatavNr id="2b1d6a0f-dded-4dbc-b5ab-16832d30f200"><![CDATA[4) ]]></kuvatavNr><sisuTekst id="da78aab1-021b-46cf-bc20-4bdb2736bcdb"><tavatekst id="a1b86fde-41db-4809-86f0-9d0bd9b2cdf6">teenuse taotleja kontaktandmed;</tavatekst></sisuTekst></alampunkt><alampunkt id="para4lg2p5"><alampunktNr id="65fd7899-61a8-4e1c-9acf-315eba97c18e">5</alampunktNr><kuvatavNr id="2b4ce5d8-5268-425d-b4db-ccdd89273c3a"><![CDATA[5) ]]></kuvatavNr><sisuTekst id="8700a8e4-99e5-4523-998f-5eaa37f223ea"><tavatekst id="0fbf6c98-9da5-414e-949b-dc53c1451807">teenuse vajaduse põhjendus (igapäevaeluga toimetuleku ja terviseprobleemide kirjeldus);</tavatekst></sisuTekst></alampunkt><alampunkt id="para4lg2p6"><alampunktNr id="835d0c4c-092b-4cfb-919d-a889ee4b6d08">6</alampunktNr><kuvatavNr id="7d2afd13-cb8b-45a8-bf4c-2f5c5978004a"><![CDATA[6) ]]></kuvatavNr><sisuTekst id="60c202c9-b8a2-4bd6-b0d6-e4d9bb72dc06"><tavatekst id="47e35133-7c3e-4546-81d4-f2e135c33e88">teenuse taotleja esindaja(te) ees- ja perekonnanimi ning kontaktandmed.</tavatekst></sisuTekst></alampunkt></loige></paragrahv><paragrahv id="para5"><paragrahvNr id="2024e205-8648-4b92-a9b7-23d02008d138">5</paragrahvNr><kuvatavNr id="6d66e7b8-7025-4705-b84e-c77fa30c4b36"><![CDATA[§ 5. ]]></kuvatavNr><paragrahvPealkiri id="aff80b65-b25f-47d4-9966-884dbd31df2e">Teenuse määramine</paragrahvPealkiri><loige id="para5lg1"><loigeNr id="edd840ff-183c-4122-bd83-f98314502c90">1</loigeNr><kuvatavNr id="70178d1a-0cb6-41ff-b32e-0979347d6dda"><![CDATA[(1)]]></kuvatavNr><sisuTekst id="645a8ba0-2c8b-4bef-a446-c504c51d99d5"><tavatekst id="6a6103dc-84da-40ef-931f-011e2edc16d4">Teenuse määramise otsustamise aluseks oleva teenuse vajaduse hindamise viib läbi sotsiaal- ja haridusosakonna ametnik kümne tööpäeva jooksul nõuetekohase taotluse esitamisest.</tavatekst></sisuTekst><muutmismarge id="d83f41b4-0c2a-4259-b07e-d3b84ca37a02"><avaldamismarge id="0b8fd422-6744-46df-9945-f27eea3cc700"><RTosa id="545e9f12-29a5-4748-9a65-fba779dd76d2">RT IV</RTosa><avaldamineKuupaev id="2c6a5e09-f624-4ef6-be4a-46c47a5535e0">2026-09-29</avaldamineKuupaev><RTartikkel id="74ed2354-6698-4e21-929c-7d0b1366b907">1</RTartikkel><aktViide id="61fc0f2b-14dc-4e99-8340-cb90cbf4792e">429092026001</aktViide></avaldamismarge><joustumine id="d9d2c998-da68-4231-b7f0-a6f3281726b5">2026-10-02</joustumine><tavatekst id="b54339d7-6ea3-40cb-8e47-68d4fdf3e479">, rakendatakse alates 01.08.2026</tavatekst></muutmismarge></loige><loige id="para5lg2"><loigeNr id="fe6baeaa-3304-43b8-b076-0851ac216678">2</loigeNr><kuvatavNr id="00c25afa-18c6-4782-80f1-d2ad8f7d6148"><![CDATA[(2)]]></kuvatavNr><sisuTekst id="5e28bbb8-7941-4e3c-8bf6-8e0083878070"><tavatekst id="f9938fa9-668c-406c-88dc-7b08e2a12cc0">Sotsiaal- ja haridusosakonna ametnik kontrollib taotluses märgitud asjaolusid ning vajadusel kogub menetlemiseks täiendavaid tõendeid ja dokumente, s.h selgitab taotleja terviseseisundist teenuse korraldusele tulenevaid nõudeid.</tavatekst></sisuTekst><muutmismarge id="15986dfc-a012-45fe-84db-736d6c1faade"><avaldamismarge id="8b5820b2-fc40-439c-91a9-5f0560d1a010"><RTosa id="abe709db-6c0c-45eb-9857-c82f7d7c5205">RT IV</RTosa><avaldamineKuupaev id="dfa273ea-7188-450d-af70-bde268769ccd">2026-09-29</avaldamineKuupaev><RTartikkel id="be1a3edc-50d2-47b9-87ba-be6fabc98228">1</RTartikkel><aktViide id="335c2e61-eba7-4e70-a456-9769132b584d">429092026001</aktViide></avaldamismarge><joustumine id="9e02da21-9fbd-4e87-95c3-3dc0f7bce9c6">2026-10-02</joustumine><tavatekst id="286ec7f3-5879-4e10-a5d5-2d2f0a3d7696">, rakendatakse alates 01.08.2026</tavatekst></muutmismarge></loige><loige id="para5lg3"><loigeNr id="69a1bb88-adc9-48e2-b252-ab18e35f058b">3</loigeNr><kuvatavNr id="68303826-d55f-4a3e-9820-1193f0b06333"><![CDATA[(3)]]></kuvatavNr><sisuTekst id="ea8948b7-daf5-4f3d-be5b-49d0ad64985d"><tavatekst id="b42aea16-f8bf-41f7-a074-e1e12a6fcf9d">Tervishoiuteenusel viibiva isiku üldhooldusteenuse vajaduse teeb sotsiaal- ja haridusosakonna ametnik kindlaks tervishoiuteenuse osutaja poolse isiku terviseseisundi ja toimetuleku ülevaate või prognoosi alusel.</tavatekst></sisuTekst><muutmismarge id="bb19426a-45c1-488c-aa2b-ca4dbd1a1163"><avaldamismarge id="3ce55bea-8e85-4eb2-b9ea-34ff59983a97"><RTosa id="914cc864-fe8b-48d0-8664-f323ccad54bc">RT IV</RTosa><avaldamineKuupaev id="fde4e9d1-8ea4-43ed-816f-68e49e7291a1">2026-09-29</avaldamineKuupaev><RTartikkel id="79771861-9ad9-46c8-a04e-a7201576c831">1</RTartikkel><aktViide id="a8ae198c-d2b3-4c64-b82a-7c22280ee3ea">429092026001</aktViide></avaldamismarge><joustumine id="090512bd-bc5b-491f-8893-7e27a4926da6">2026-10-02</joustumine><tavatekst id="650e72cd-3575-4218-9c06-540afac5a8fa">, rakendatakse alates 01.08.2026</tavatekst></muutmismarge></loige></paragrahv><paragrahv id="para6"><paragrahvNr id="1c103a22-4648-4bfc-9a48-2d75919478d9">6</paragrahvNr><kuvatavNr id="4e6fafa1-f6b2-4836-98f3-8b16e5441fdf"><![CDATA[§ 6. ]]></kuvatavNr><paragrahvPealkiri id="52276b1a-2145-4ac9-8dbe-eda4a8a3a894">Teenuse rahastamine</paragrahvPealkiri><loige id="para6lg1"><loigeNr id="3963cba3-6f26-4ac6-b7bd-d34da8b768da">1</loigeNr><kuvatavNr id="bdd39628-e9f6-491c-a531-ff335bbaa03c"><![CDATA[(1)]]></kuvatavNr><sisuTekst id="e3277199-dabc-4f42-878c-02ab4bade171"><tavatekst id="f090d955-2b0f-482e-9180-04cc84e88b71">Teenuskoha maksumust rahastatakse teenuse saaja sissetulekutest, riigi poolt sihtotstarbeliselt eraldatud pikaajalise hoolduse korralduse toetusest, Põlva valla eelarve vahenditest ja vajadusel ülalpidamiskohustusega perekonnaliikmelt võetavast tasust.</tavatekst></sisuTekst></loige><loige id="para6lg2"><loigeNr id="41e938e5-f2f9-40e9-a87c-e7eea935d12c">2</loigeNr><kuvatavNr id="9d8e35a2-be02-4fb5-898e-3ddcc62c9227"><![CDATA[(2)]]></kuvatavNr><sisuTekst id="dad6d465-33ea-40fb-b57c-6d525aca83fd"><tavatekst id="7b2d8b7c-1a73-4b58-acd5-5e68662ffb0f">Põlva valla eelarvest rahastatakse hooldusteenust vahetult osutavate hooldustöötajate ja abihooldustöötajate järgmisi kulusid (edaspidi <i>hoolduskomponendi kulud</i>):</tavatekst></sisuTekst><alampunkt id="para6lg2p1"><alampunktNr id="53db9580-b30e-4ad0-85ef-cf03f5289b19">1</alampunktNr><kuvatavNr id="cbe6b2dd-65eb-4deb-844c-021929bcd4e7"><![CDATA[1) ]]></kuvatavNr><sisuTekst id="38c50342-b82a-439b-91df-5f5c7fcff2e5"><tavatekst id="1fbec59a-5ec7-482d-81ae-4a9bc78f0e06">tööjõukulud;</tavatekst></sisuTekst></alampunkt><alampunkt id="para6lg2p2"><alampunktNr id="64253686-18fa-4c97-aa05-3f0f8756f062">2</alampunktNr><kuvatavNr id="918bd6a2-4d1b-4346-9771-2e1a6d9daff0"><![CDATA[2) ]]></kuvatavNr><sisuTekst id="a461715f-1741-4447-87a7-d0549c481ea2"><tavatekst id="73b08b10-17e6-415a-842b-f093a8657bcc">tööriietuse ja isikukaitsevahendite kulud;</tavatekst></sisuTekst></alampunkt><alampunkt id="para6lg2p3"><alampunktNr id="ebac1798-1a73-42db-b1c5-7f0c769d229c">3</alampunktNr><kuvatavNr id="6d7da082-e468-4ec5-963f-68d21c4968cb"><![CDATA[3) ]]></kuvatavNr><sisuTekst id="b8b24724-fdf6-4ed3-8793-165b44a83340"><tavatekst id="016e7fde-db07-448d-a56a-c473efaa6b88">tervisekaitse ja vaktsineerimise kulud;</tavatekst></sisuTekst></alampunkt><alampunkt id="para6lg2p4"><alampunktNr id="036b1c2f-4bcf-4511-90dd-31e5922e1351">4</alampunktNr><kuvatavNr id="0fc0cdd4-4473-4955-9af0-c2d47638b57d"><![CDATA[4) ]]></kuvatavNr><sisuTekst id="384223a6-6ec4-44c8-8aa0-0dd170dfdf02"><tavatekst id="afb6aa92-7008-494e-a066-44b563eb555d">koolituse ja supervisiooni kulud.</tavatekst></sisuTekst></alampunkt></loige><loige id="para6lg3"><loigeNr id="9ad16398-81cb-4fd9-b20e-f8339cc028a5">3</loigeNr><kuvatavNr id="2a9acfe3-4646-450c-901d-c6e84280b4de"><![CDATA[(3)]]></kuvatavNr><sisuTekst id="51823118-c7e4-4a67-8bcc-d400fb9bf6d3"><tavatekst id="30673dbf-09fc-4dc3-872e-13898c9667c5">Põlva Vallavalitsus kehtestab käesoleva paragrahvi lõikes 2 nimetatud kulude tasumise piirmäära suuruses, mis tagab teenuse saajale teenuse kättesaadavuse.</tavatekst></sisuTekst></loige><loige id="para6lg4"><loigeNr id="03be1077-416e-4b32-8084-20ed0e78bcd5">4</loigeNr><kuvatavNr id="4f20cdf5-b976-4a91-aec3-25cbcd8ca843"><![CDATA[(4)]]></kuvatavNr><sisuTekst id="f1e89ff3-5d49-4a21-a089-116fd53c0909"><tavatekst id="6cb2c4ff-d393-403e-9bdc-72454de6c398">Juhul kui käesoleva paragrahvi lõikes 2 nimetatud kulude suurus ületab Põlva Vallavalitsuse kehtestatud piirmäära, tasub piirmäära ületava kulu teenusesaaja või tema ülalpidamiskohustusega perekonnaliige.</tavatekst></sisuTekst></loige><loige id="para6lg5"><loigeNr id="80ea2e92-2f75-4c65-abbc-bb357de8ad60">5</loigeNr><kuvatavNr id="db8405e0-8a68-4612-81ed-82a19333de20"><![CDATA[(5)]]></kuvatavNr><sisuTekst id="78ec728a-8d54-489d-a3e8-7df8a7fc4dc4"><tavatekst id="ebf0198f-c61b-47ac-93fe-5614c48f7a6a">Teenuse saaja tasub teenuskoha maksumusest majutus- ja toitluskulud ning muud teenuse osutamisega seotud kulud (edaspidi <i>ülalpidamiskomponendi kulud</i>).</tavatekst></sisuTekst></loige><loige id="para6lg6"><loigeNr id="4140b66b-f49d-462b-b561-30825d612ff5">6</loigeNr><kuvatavNr id="e42ce1f7-f03b-493d-86b0-0f737aaf0dd3"><![CDATA[(6)]]></kuvatavNr><sisuTekst id="6fe568a4-2c35-4570-a81e-2c9e9ccfc1cc"><tavatekst id="a9db6ce2-e1e1-4414-a2f7-16253361b219">Kui teenuse saaja sissetulek on madalam kui Statistikaameti avaldatud eelarveaastale eelnenud aasta teise kvartali keskmise vanaduspensioni suurus, katab kohaliku omavalitsuse üksus teenuse saaja tasutavate kulude ja teenuse saaja sissetuleku vahe, kuid mitte rohkem kui eelmise aasta teise kvartali keskmise vanaduspensioni suuruse ja teenuse saaja sissetuleku vahe. Sissetulekuna arvestatakse teenuse saaja riiklik pension, kogumispension kogumispensionide seaduse tähenduses, töövõimetoetus töövõimetoetuse seaduse tähenduses ja sotsiaalmaksuga maksustatav tulu sotsiaalmaksuseaduse tähenduses.</tavatekst></sisuTekst></loige><loige id="para6lg7"><loigeNr id="7448dbed-03a9-4b39-8655-b68ac95577be">7</loigeNr><kuvatavNr id="34546e5d-ac9a-4c76-8b4b-6886b635d78e"><![CDATA[(7)]]></kuvatavNr><sisuTekst id="a04ba61c-ce23-4628-9579-386cb89b4928"><tavatekst id="32cfd61e-a600-4718-b0d1-40427c66cff6">Puudest tingitud lisakulusid nõudvate teenuste ja kaupade hankimise ning rehabilitatsiooniplaanis ettenähtud tegevuste elluviimise korral üldhooldusteenuse osutaja poolt kaetakse need kulud puudega inimese sotsiaaltoetuse määra ulatuses nimetatud toetuse arvelt.</tavatekst></sisuTekst></loige><loige id="para6lg8"><loigeNr id="4832b94a-8d5e-48a1-889c-4f7c654c2d9e">8</loigeNr><kuvatavNr id="6e91c4e6-9991-4904-83c5-48535cf9ec5d"><![CDATA[(8)]]></kuvatavNr><sisuTekst id="eaaac58a-f8c9-40eb-9fc5-9a946e703e58"><tavatekst id="14732061-7036-4912-a70b-3e749aed996f">Lisateenuste eest, mille osutamine ei ole tagatud kohamaksumusega (tervishoiuteenuse osutaja poolt võetav visiidi- ja voodipäeva tasu, sotsiaaltranspordi teenuse tasu, tasu telefoni, TV või interneti võrguühenduse eest, üheinimesetoa lisamaks jms) tasub teenusesaaja.</tavatekst></sisuTekst></loige><loige id="para6lg9"><loigeNr id="0c7ec4d3-bac9-4b11-8a94-6718bf21ba66">9</loigeNr><kuvatavNr id="3181a573-224b-4374-a23a-e6763e0008e8"><![CDATA[(9)]]></kuvatavNr><sisuTekst id="26324f94-d631-4168-8814-d4feb345e799"><tavatekst id="0f018470-dd0c-4861-b4ec-752ee826c635">Kui isik ei ole võimeline tasuma puudujäävat osa kohamaksumusest (ülalpidamiskomponenti või hoolduskomponendi piirmäära ületavas osas) või kohamaksumuse arvestusest välja jäävate lisateenuste eest käesoleva paragrahvi lõikes 8 toodud juhul, siis hindab KOV isiku ja tema ülalpidamiskohustusega perekonnaliikmete maksevõimet ja lepib nendega kokku puudujäävate summade tasumise.</tavatekst></sisuTekst></loige></paragrahv><paragrahv id="para7"><paragrahvNr id="a5ad637f-ae43-479c-b945-717f9852c797">7</paragrahvNr><kuvatavNr id="0d4a045c-a106-41d1-b08f-44c332796812"><![CDATA[§ 7. ]]></kuvatavNr><paragrahvPealkiri id="22a5aac9-4180-48fd-9d43-940b1aa68ab8">Teenuse rahastamise otsustamine</paragrahvPealkiri><loige id="para7lg1"><loigeNr id="1491261f-a9b5-40fa-8f76-4c757c1971a7">1</loigeNr><kuvatavNr id="07dcbdc4-6d13-40b8-9347-fee16fa74ec2"><![CDATA[(1)]]></kuvatavNr><sisuTekst id="78e2cf35-17b6-4006-8fb9-e0f62f87d178"><tavatekst id="e8e9dc63-0444-48ad-87cd-623b12e76eaf">Otsuse teenuse rahastamise kohta teeb sotsiaal- ja haridusosakonna juhataja oma haldusaktiga.</tavatekst></sisuTekst><muutmismarge id="0edd03ce-0cbe-4f96-9888-a2a38e98af63"><avaldamismarge id="b66d029e-68df-43cd-b68a-765e73fe283b"><RTosa id="463a4ee5-317f-4787-8691-8c07409361af">RT IV</RTosa><avaldamineKuupaev id="fa893dbb-666d-48a7-a431-cf08fe42765b">2026-09-29</avaldamineKuupaev><RTartikkel id="2837bc42-3c16-480e-88bc-2b85c8f1b4f3">1</RTartikkel><aktViide id="7994cc11-8393-41f3-8188-3bf9346c15d1">429092026001</aktViide></avaldamismarge><joustumine id="ca335952-62b3-4bec-8258-58b7188ee0f6">2026-10-02</joustumine><tavatekst id="16ad3579-c89b-4020-98b2-fd3d236d8b46">, rakendatakse alates 01.08.2026</tavatekst></muutmismarge></loige><loige id="para7lg2"><loigeNr id="b46fc1de-b0f1-4adf-9099-6d6741f76c3d">2</loigeNr><kuvatavNr id="4b53c972-e4b9-4e88-9179-499d314e5ba3"><![CDATA[(2)]]></kuvatavNr><sisuTekst id="b9c40b4d-c7a7-4bf2-b249-f95aec991b3d"><tavatekst id="bdb80b88-35c4-4bb8-84eb-125083cd0da8">Haldusakt edastatakse rahastuse taotluse esitanud isikule, tema seadusjärgsetele ülalpidajatele ja teenuse osutajale.</tavatekst></sisuTekst></loige><loige id="para7lg3"><loigeNr id="ca94d460-f082-441e-9475-72614f891911">3</loigeNr><kuvatavNr id="08a04475-e2ad-485e-8a27-c825a661ccd6"><![CDATA[(3)]]></kuvatavNr><sisuTekst id="3472e42d-06ca-473e-91f6-dd41a07699f2"><tavatekst id="da4b8511-39dc-480c-8c18-d18e1332b446"/></sisuTekst><muutmismarge id="c99331cb-96d2-4412-83ee-d1140c9fd991"><tavatekst id="ca0014e9-c5b0-4e8e-9bdd-f01dcb3eb6db">Kehtetu –</tavatekst><avaldamismarge id="983c5b61-e40a-4108-a14c-7e5e7c20dd32"><RTosa id="8665aef1-8eb8-4703-be4a-d684fca58090">RT IV</R