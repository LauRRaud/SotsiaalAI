   <pealkiri id="ad75955a-4194-4fa5-a266-9559935016b2">Hooldajatoetuse määra kehtestamine 2026. aastal </pealkiri>
  </nimi>
 </aktinimi>
 <sisu id="0bcfe486-f05f-4b0b-8318-074b40283ff1"><preambul id="1c4141b3-36b9-480f-8857-98bd4b6b0b6d">
   <tavatekst id="0ac359f1-838e-448f-a4a3-17e06ee5bb3e">Määrus kehtestatakse Rae Vallavolikogu 20.06.2023 määruse nr 29 „Sotsiaalteenuste osutamise kord Rae vallas“ § 17 lõike 6 ja Rae Vallavolikogu 17.04.2018 määruse nr 11 „Hooldajatoetuse määramise ja maksmise kord puudega lapse hooldajale“ § 6 alusel. </tavatekst>
  </preambul><paragrahv id="para1">
   <paragrahvNr id="27e36caf-b3e6-4fde-9fba-611269ae3bdc">1</paragrahvNr>
   <kuvatavNr id="abf34abf-2266-46e2-9510-bfdeee7ed74e"><![CDATA[§ 1. ]]></kuvatavNr>
   <paragrahvPealkiri id="236dfdac-b9a6-46da-b7a8-64d6e6eb4efa">Hooldajatoetuste määrad </paragrahvPealkiri>
  <loige id="para1lg1">
   <loigeNr id="8c044e76-a8fa-48b6-904b-6f34130fcddb">1</loigeNr>
   <kuvatavNr id="f080c28d-790a-4ed7-91c5-54d5755d62fb"><![CDATA[(1)]]></kuvatavNr>
   <sisuTekst id="49a81960-bff1-4083-aafc-64f3a853691e">
    <tavatekst id="7443ddc4-3b85-4b50-ae53-6edbada76bba">Hooldajatoetust täiskasvanud puudega ning suure hooldus- ja abivajadusega isiku hooldajale makstakse järgmiselt: </tavatekst>
   </sisuTekst>
  <alampunkt id="para1lg1p1">
   <alampunktNr id="6102c744-77b4-4aba-a665-36c6f3787095">1</alampunktNr>
   <kuvatavNr id="3a329d14-7e8f-42c3-a41d-58a51b5c3041"><![CDATA[1) ]]></kuvatavNr>
   <sisuTekst id="6bb35ea6-07d6-412a-91c2-ec94a40bdae3">
    <tavatekst id="c58075a0-f6b6-4ff7-af67-24c96729c576">raske puudega ning suure hooldus- ja abivajadusega isiku hooldajale - 40 eurot kuus; </tavatekst>
   </sisuTekst>
  </alampunkt><alampunkt id="para1lg1p2">
   <alampunktNr id="a3e91ca3-9532-4fb0-9181-ed97cbb77e1a">2</alampunktNr>
   <kuvatavNr id="dd8b2202-7fa6-4090-ac67-b3602a41037e"><![CDATA[2) ]]></kuvatavNr>
   <sisuTekst id="5fc39c18-5d6e-4a5f-868d-9c840a390935">
    <tavatekst id="e7565f7b-6f15-479a-a55b-38735486868f">sügava puudega isiku hooldajale - 60 eurot kuus. </tavatekst>
   </sisuTekst>
  </alampunkt></loige><loige id="para1lg2">
   <loigeNr id="786cfd72-6dc4-49b3-902c-5f4e14789d70">2</loigeNr>
   <kuvatavNr id="9d47d237-9855-4ff9-95ec-2ea4dbbc5b82"><![CDATA[(2)]]></kuvatavNr>
   <sisuTekst id="c546ccae-cfed-481f-a813-ce4e5bd31231">
    <tavatekst id="5cb4b871-ab5f-4783-b35e-962baf1b2c4b">Hooldajatoetus puudega lapse hooldajale - 100 eurot kuus. </tavatekst>
   </sisuTekst>
  </loige></paragrahv><paragrahv id="para2">
   <paragrahvNr id="a18a2673-c7bd-46dc-af11-eb0e1d9eac12">2</paragrahvNr>
   <kuvatavNr id="210e0ae7-6c30-4ef7-9ebb-cd7bb86935a1"><![CDATA[§ 2. ]]></kuvatavNr>
   <paragrahvPealkiri id="8a5106b5-efb4-4359-ac5c-98b182705c17">Rakendussätted </paragrahvPealkiri>
  <loige id="para2lg1">
   <loigeNr id="96c29022-d913-4c80-9d46-01afb795d778">1</loigeNr>
   <kuvatavNr id="94c3e8aa-b9c1-4ead-b295-f921c8be9eef"><![CDATA[(1)]]></kuvatavNr>
   <sisuTekst id="eb8217e4-a34b-4165-8ffb-f077b5532091">
    <tavatekst id="13cf5c50-24ef-4c7f-83a3-0b49ea595ec1">Tunnistada kehtetuks Rae Vallavalitsuse 04.02.2025 vastuvõetud määrus nr 2 „Hooldajatoetuse määra kehtestamine 2025. aastal“. </tavatekst>
   </sisuTekst>
  </loige><loige id="para2lg2">
   <loigeNr id="6fd7235c-5c85-4bcc-9231-7e0f09e739ad">2</loigeNr>
   <kuvatavNr id="e432690b-e774-4aaa-8076-519627803069"><![CDATA[(2)]]></kuvatavNr>
   <sisuTekst id="d25fbd52-d1dc-4b85-b26e-c92b87d08c36">
    <tavatekst id="120c00f5-6167-4e38-8910-5c93c762ba22">Määrus jõustub kolmandal päeval pärast avaldamist Riigi Teatajas. </tavatekst>
   </sisuTekst>
  </loige><loige id="para2lg3">
   <loigeNr id="107e3831-95ab-4b48-939c-53ba7e4af706">3</loigeNr>
   <kuvatavNr id="fd16b54f-5e1e-4c5f-b9e0-a715775cca43"><![CDATA[(3)]]></kuvatavNr>
   <sisuTekst id="368763d5-a5c2-4cc8-aff9-e791ea152c74">
    <tavatekst id="ff72f9a0-99f8-48bc-a6ae-68d29c3e01bf">Käesolevas määruses sätestatud hooldajatoetuse määrasid kohaldatakse tagasiulatuvalt alates 1. jaanuarist 2026. </tavatekst>
   </sisuTekst>
  </loige></paragrahv></sisu>
