   <pealkiri id="284104f5-017f-40a0-aa14-15f2fc8db8b6">Kulude piirmäärad toimetulekutoetuse arvestamiseks</pealkiri>
  </nimi>
 </aktinimi>
 <sisu id="5f5affb0-097e-4094-9294-2ac38cfaeefb"><preambul id="1ea4952d-1ac7-4922-ad0e-bd75d4ab852d"><tavatekst id="7d81728e-d296-460d-a573-b8391067750e">Määrus kehtestatakse sotsiaalhoolekande seaduse § 133 lõigete 5 ja 6 alusel.</tavatekst></preambul><paragrahv id="para1"><paragrahvNr id="b9351c28-1286-46b1-a2f6-734ca4ed9c91">1</paragrahvNr><kuvatavNr id="81899723-e3bb-48e2-9735-ab321f96cba2"><![CDATA[§ 1. ]]></kuvatavNr><paragrahvPealkiri id="14b08ab6-dfb7-4dc5-8c27-b5a980f3ef44">Reguleerimisala</paragrahvPealkiri><loige id="para1lg1"><loigeNr id="a66c629e-fedd-4f85-8b1a-bf4f3afd3ce9"/><kuvatavNr id="1039f15a-1784-4e55-90d6-27f4d483d2d9"/><sisuTekst id="9e9ecdcb-acce-4723-a76a-ea2977c255d8"><tavatekst id="46015687-c4ae-4905-9fc2-90bc5603c07e">Määrus sätestab sotsiaalhoolekande seaduse alusel makstava toimetulekutoetuse arvestamise aluseks olevate jooksval kuul tasumisele kuuluvate eluruumi alaliste kulude piirmäärad.</tavatekst></sisuTekst></loige></paragrahv><paragrahv id="para2"><paragrahvNr id="a09f9f84-b282-488f-8a2f-91f3b1e7700f">2</paragrahvNr><kuvatavNr id="a55c6ba9-7e57-4166-af13-c70c7ec12f3f"><![CDATA[§ 2. ]]></kuvatavNr><paragrahvPealkiri id="b6e5f464-c836-4370-9ed9-aa99ded2971c">Eluruumi alaliste kulude piirmäärade määramise alus</paragrahvPealkiri><loige id="para2lg1"><loigeNr id="8b060199-a686-46bd-b655-f249f4391577">1</loigeNr><kuvatavNr id="d0d7d31f-9b5c-4123-a570-590309545fe5"><![CDATA[(1)]]></kuvatavNr><sisuTekst id="e4a84c70-379b-4691-84d6-3f5a3ffb3115"><tavatekst id="19e1c3ca-f276-46b9-ac4b-5d839d8b232e">Eluruumi alalisteks kuludeks loetakse sotsiaalhoolekande seaduse § 133 lõikes 5 loetletud kulud.</tavatekst></sisuTekst></loige><loige id="para2lg2"><loigeNr id="1387fe5c-8a32-4a81-8382-bcbd99b07e77">2</loigeNr><kuvatavNr id="ef91d3f1-8b1b-4798-9661-b299f2419e49"><![CDATA[(2)]]></kuvatavNr><sisuTekst id="f451a279-9ba5-4577-889e-ff3a6161a5d6"><tavatekst id="1d200e50-225c-4f88-a358-82f445907cf2">Eluruumi alaliste kulude piirmäärad kehtestatakse suuruses, mis toimetulekutoetuse maksmisel tagavad isiku ja tema perekonnaliikmete inimväärse äraelamise. Kehtestatud piirmäärad vaadatakse üks kord aastas üle ning vajaduse korral kehtestatakse uued piirmäärad.</tavatekst></sisuTekst></loige><loige id="para2lg3"><loigeNr id="00884b06-0aea-4e5c-b30f-2e6ef6803e2e">3</loigeNr><kuvatavNr id="33f57e6b-4ee6-4be9-900c-e985cfc3508e"><![CDATA[(3)]]></kuvatavNr><sisuTekst id="f39c0d3e-4db0-4ebe-ac76-fa6915c294ba"><tavatekst id="9c848806-6697-462d-ba80-a0fbcf6ad9e8">Toimetulekutoetuse arvestamisel võetakse arvesse elamuseaduse § 7 lõike 1 punkti 2 alusel kehtestatud eluruumi sotsiaalselt põhjendatud normi ulatuses eluruumi tegelikud kulud, kuid mitte üle linnavolikogu poolt käesolevas määruses kehtestatud piirmäärade.</tavatekst></sisuTekst></loige></paragrahv><paragrahv id="para3"><paragrahvNr id="8e4e2cdf-c84c-47b4-aebf-1f27c0b7019b">3</paragrahvNr><kuvatavNr id="edc771eb-2e2f-40a1-958e-48d1cee1fbe7"><![CDATA[§ 3. ]]></kuvatavNr><paragrahvPealkiri id="bcef6142-c312-4c2e-9e16-725f9c482abc">Eluruumi alaliste kulude piirmäärad</paragrahvPealkiri><loige id="para3lg1"><loigeNr id="54c4cb00-96d8-4a69-90a7-9c6276c68b54"/><kuvatavNr id="41414b41-4e0b-46d7-9f32-3acc6dbc42dd"/><sisuTekst id="f31879ed-117e-461c-bd20-e61277ba070e"><tavatekst id="d70611d6-c8f4-4e78-95ef-6cec8298f1f3">Toimetulekutoetuse määramisel võetakse arvesse jooksval kuul tasumisele kuuluvad alalise eluruumi alalised kulud järgnevalt:</tavatekst></sisuTekst><alampunkt id="para3lg1p1"><alampunktNr id="22b743b0-d583-4dc6-b8d6-56824030c0c1">1</alampunktNr><kuvatavNr id="ee4a7e12-a30c-42a9-88a2-90c8c5ff50ee"><![CDATA[1) ]]></kuvatavNr><sisuTekst id="8c67b26a-a255-4fc9-9880-d316786262dd"><tavatekst id="025d1ae5-a29c-44db-8b3d-7fc621522c22">üür kuni 8 eurot eluruumi normpinna ühe m² kohta ühes kuus;</tavatekst></sisuTekst></alampunkt><alampunkt id="para3lg1p2"><alampunktNr id="59e243ff-9715-4786-b30c-d90b0f84d66c">2</alampunktNr><kuvatavNr id="da367859-6fe7-4f92-8506-29a459ec6d24"><![CDATA[2) ]]></kuvatavNr><sisuTekst id="3398f815-46f2-4b75-afdd-3309e40f8335"><tavatekst id="f3c3786e-4d2b-420b-beb6-351859130e24">korterelamu haldamise kulu, sh remondiga seotud kulu kuni 4 eurot eluruumi normpinna ühe m² kohta ühes kuus;</tavatekst></sisuTekst></alampunkt><alampunkt id="para3lg1p3"><alampunktNr id="4b88c798-5738-4961-8cd9-5be8dc815811">3</alampunktNr><kuvatavNr id="74f3cdea-30b0-40b9-9968-182031a89459"><![CDATA[3) ]]></kuvatavNr><sisuTekst id="e993f55f-b064-463d-9ff3-3942bfe7bef6"><tavatekst id="fb1b593d-0472-433c-b0ef-c42a534e6870">korterelamu renoveerimiseks võetud laenu tagasimakse kuni 3 eurot eluruumi normpinna ühe m² kohta ühes kuus;</tavatekst></sisuTekst></alampunkt><alampunkt id="para3lg1p4"><alampunktNr id="707a48fa-1d15-40dc-adce-05df9c381736">4</alampunktNr><kuvatavNr id="91b57039-998a-4c7f-aea1-92e13e3b5c51"><![CDATA[4) ]]></kuvatavNr><sisuTekst id="d54347f7-7a76-408b-bd5e-77546b3ff9ae"><tavatekst id="cb823773-2219-4396-bbd9-df27bb4e03f6">veevarustuse ja reovee ärajuhtimise teenuste maksumus kuni 18 eurot üheliikmelise pere kohta ning kuni 15 eurot iga järgneva pereliikme kohta kuus;</tavatekst></sisuTekst></alampunkt><alampunkt id="para3lg1p5"><alampunktNr id="878b8888-b8ff-4f35-a1db-395177116fdf">5</alampunktNr><kuvatavNr id="ec06b91b-2fe9-4beb-b892-9de3c0c304e7"><![CDATA[5) ]]></kuvatavNr><sisuTekst id="4d1ae484-e929-4fe7-b0bf-84ca88b46479"><tavatekst id="353c4105-360a-45ee-9d68-591a496163ec">soojaveevarustuseks tarbitud soojusenergia või kütuse maksumus kuni 25 eurot üheliikmelise pere kohta ning kuni 12 eurot iga järgneva pereliikme kohta kuus;</tavatekst></sisuTekst></alampunkt><alampunkt id="para3lg1p6"><alampunktNr id="9a75b171-80ad-4e4e-9b7a-f7cb509a6c53">6</alampunktNr><kuvatavNr id="e22d897a-4271-4c6a-9690-33ae66f0f61b"><![CDATA[6) ]]></kuvatavNr><sisuTekst id="dc80d051-0aa4-4407-b029-7b86120b4cec"><tavatekst id="da9e675b-4b09-4e68-b51c-254e6ffdb747">kütteks tarbitud soojusenergia või kütuse maksumus kaugküttega eluruumi puhul kuni 5 eurot eluruumi normpinna ühe m² kohta ühes kuus; kaugkütteta (ahi-, gaasi-, elektri-, jm küttega) eluruumi puhul kuni 5 eurot ühe m² kohta kuus. Kui kuludokumendil kajastub taotlusele järgneva perioodi küttekulu, kompenseeritakse see kuludokumendi esitamisele järgnevatel kuudel vastavalt kehtestatud piirmäärale kuludokumendil näidatud summa kompenseerimiseni või kuni uue kuludokumendi esitamiseni;</tavatekst></sisuTekst></alampunkt><alampunkt id="para3lg1p7"><alampunktNr id="68d25f46-4612-4c1c-af8a-eed9b2b0b7fa">7</alampunktNr><kuvatavNr id="46278dbb-39af-487e-8217-35fa7b772e9a"><![CDATA[7) ]]></kuvatavNr><sisuTekst id="93c6d546-8e4b-42ed-b871-f9ffb3e3fc2c"><tavatekst id="02215fc3-5fc8-412e-8d32-b6250d36b4dc">elektrienergia tarbimisega seotud kulu kuni 50 eurot üheliikmelise pere kohta kuus ning kuni 25 eurot iga järgneva pereliikme kohta kuus;</tavatekst></sisuTekst></alampunkt><alampunkt id="para3lg1p8"><alampunktNr id="e360f39f-4b3d-4e80-b298-9afb7df7fd56">8</alampunktNr><kuvatavNr id="5693cd29-eaa0-46cb-9848-d75bdbceda82"><![CDATA[8) ]]></kuvatavNr><sisuTekst id="45512639-2725-4e36-91c0-889b3c76c158"><tavatekst id="42b4a64d-a715-4f81-bc94-7643ba57fc6e">majapidamisgaasi ühe ballooni maksumus perekonna kohta nelja (4) kuu jooksul;</tavatekst></sisuTekst></alampunkt><alampunkt id="para3lg1p9"><alampunktNr id="66b39c68-882b-4607-9a2b-0cc37f6c642e">9</alampunktNr><kuvatavNr id="15960622-e8e6-4de4-a681-5bae6d599ad2"><![CDATA[9) ]]></kuvatavNr><sisuTekst id="d3246f23-b434-4d59-bf3f-f56e9bb7a7cc"><tavatekst id="b2291087-42df-40f0-89d4-e3af00ae46b2">maamaksu kulu, mille arvestamise aluseks on kolmekordne elamualune pind kuni 0,2 eurot ühe m² kohta kuus;</tavatekst></sisuTekst></alampunkt><alampunkt id="para3lg1p10"><alampunktNr id="55116df8-7846-464d-8bae-9210437b7abb">10</alampunktNr><kuvatavNr id="5391bf67-f08d-4f1a-81be-6e3fcf26848b"><![CDATA[10) ]]></kuvatavNr><sisuTekst id="0323463e-2f20-4def-a336-b03b62598781"><tavatekst id="df7d4dcf-7243-4731-923c-b0dbf222c34f">hoonekindlustuse kulud, mis on arvestatud kasutatavale eluruumile kuni 0,3 eurot ühe m²<reavahetus/>kohta kuus;</tavatekst></sisuTekst></alampunkt><alampunkt id="para3lg1p11"><alampunktNr id="cfc4d266-8b71-47df-8255-131a70f8e09d">11</alampunktNr><kuvatavNr id="be6078fa-7b43-42b3-ba2b-72f57c512e76"><![CDATA[11) ]]></kuvatavNr><sisuTekst id="c2c621eb-24db-4a3d-b551-cd5b19d192b4"><tavatekst id="8f70cc68-d36d-4ad9-a9ef-dedc6a97044f">olmejäätmete veotasu kuni 8 eurot üheliikmelise pere kohta kuus ning kuni 4 eurot iga järgneva pereliikme kohta kuus.</tavatekst></sisuTekst></alampunkt></loige></paragrahv><paragrahv id="para4"><paragrahvNr id="96d772d1-a24a-44ef-9e50-f39abf5864ce">4</paragrahvNr><kuvatavNr id="e63b9aad-fcdd-4c0a-aa26-21723b46d5e8"><![CDATA[§ 4. ]]></kuvatavNr><paragrahvPealkiri id="62d43d77-1014-4a9f-8246-bfd95d30e652">Määruse kehtetuks tunnistamine</paragrahvPealkiri><loige id="para4lg1"><loigeNr id="a6589807-c4da-44b0-a917-0f2d25627643"/><kuvatavNr id="69211758-2a73-4be5-aa63-95eab9fceda8"/><sisuTekst id="f9900fb5-d709-424c-b930-6f9f56327437"><tavatekst id="8d1bff74-b6ae-496a-84b8-5e0763441431">Paide Linnavolikogu 12. detsembri 2017. a määrus nr 44 „Kulude piirmäärad toimetulekutoetuse arvestamiseks“ tunnistatakse kehtetuks.</tavatekst></sisuTekst></loige></paragrahv><paragrahv id="para5"><paragrahvNr id="f09f59b0-578a-4c55-811e-9553436d31ea">5</paragrahvNr><kuvatavNr id="bfe730a5-5f1f-4f53-a5eb-1036ab75f5e8"><![CDATA[§ 5. ]]></kuvatavNr><paragrahvPealkiri id="b1689ca5-fbbb-47f3-9c2a-3bb9f97db931">Määruse jõustumine</paragrahvPealkiri><loige id="para5lg1"><loigeNr id="3b5338b1-aabb-46f0-9bc8-071ed249fcc9"/><kuvatavNr id="7d9ab223-f31a-4557-8c5c-78259a21a931"/><sisuTekst id="5592a933-479e-4cee-a994-f9475f1e9b87"><tavatekst id="01b5810d-08ab-48ff-99ec-814658cb450e">Määrus jõustub 1. juulil 2026<i>.</i></tavatekst></sisuTekst></loige></paragrahv></sisu>
