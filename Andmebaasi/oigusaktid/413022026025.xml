	<muutmismarge id="8dccfc49-bf14-4a80-bdab-41b1a4a87aff"><aktikuupaev id="3052d483-dfeb-4a6a-a5d6-7ddcf9877681">2026-02-09</aktikuupaev><avaldamismarge id="7bebda5b-9dd2-427b-8f14-475c7393ea0e"><RTosa id="94dc22c1-ac92-4384-b4e6-a85e2be9f4b9">RT IV</RTosa><avaldamineKuupaev id="c3b9f247-a010-4623-b9e1-7867488d0a24">2026-02-13</avaldamineKuupaev><RTartikkel id="80f2ed55-73fb-42d6-8e0a-5e3abf4e2b28">16</RTartikkel><aktViide id="84521129-593c-4380-854a-4e27b8d0ef4b">413022026016</aktViide></avaldamismarge><joustumine id="218f2cf7-46ba-4fd8-88e6-bb6adb3506e2">2026-02-16</joustumine><tavatekst id="877abe7f-5a83-4cda-aa76-6beb9a0e9e58">, rakendatakse tagasiulatuvalt alates 01.01.2026.</tavatekst></muutmismarge><sisu id="d95eee62-64e8-46b6-85ca-1ef6e0960c11">
		<preambul id="6377efea-86fa-44d4-a764-e533c9986c02">
			<tavatekst id="d259eb65-64f7-4927-a50e-700b7b31ffc8">Määrus kehtestatakse Pärnu Linnavolikogu 6. septembri 2018 määruse nr 37 „Sotsiaaltoetuste kord” § 3 alusel.</tavatekst>
		</preambul>
		<paragrahv id="para1">
			<paragrahvNr id="0d1ff8ad-bd09-40ae-8c83-d7d54fe309ca">1</paragrahvNr>
			<kuvatavNr id="56a2ead7-4217-48b4-9cf5-e94b6d6efce4"><![CDATA[§ 1. ]]></kuvatavNr>
			<paragrahvPealkiri id="d5d5788c-d01b-4cc4-8fdd-6b4a7b1224c3">Määruse reguleerimisala</paragrahvPealkiri>
			<loige id="para1lg1">
				<loigeNr id="e3f7f1db-37a1-4c72-99c7-16171e626d75"/>
				<kuvatavNr id="3a1e4608-426e-4518-851d-f6c551985dec"/>
				<sisuTekst id="987ca347-297d-46c7-a073-1fd598b5962a">
					<tavatekst id="15e809c7-2bb9-492c-b7ea-1b5c9fdc7559">Käesolev määrusega kehtestatakse Pärnu linna eelarvest makstavate sotsiaaltoetuste suurused ja toetuste arvestamisel arvesse võetavate kulutuste piirmäärad.</tavatekst>
				</sisuTekst>
			</loige>
		</paragrahv>
		<paragrahv id="para2">
			<paragrahvNr id="0abc2a58-602f-4b0b-93d5-2903dc7ed6f5">2</paragrahvNr>
			<kuvatavNr id="871369f4-216e-4e7b-a086-2ae5bec01172"><![CDATA[§ 2. ]]></kuvatavNr>
			<paragrahvPealkiri id="bff4405f-db4e-41e4-93f7-de6e970e6a8b">Koolieelse lasteasutuse ja koolitoidu eest tasumise toetus</paragrahvPealkiri>
			<muutmismarge id="2e074271-e380-4ebf-b658-ad7f42df6705">
				<tavatekst id="c33c1b28-faac-420d-a7ba-57a8e82632e1">Kehtetu -</tavatekst>
				<avaldamismarge id="54fa877b-068a-4428-96ef-2706554f0d7d">
					<RTosa id="024068a8-6f21-46f4-b59a-756d2e38b18f">RT IV</RTosa>
					<avaldamineKuupaev id="e1cd4914-f54e-4935-9cc9-062e4143c13e">2022-04-01</avaldamineKuupaev>
					<RTartikkel id="07110d79-e40d-4972-836c-18c67f457ce1">55</RTartikkel>
					<aktViide id="33052bb7-05b4-48a0-938a-88a94534337b">401042022055</aktViide>
				</avaldamismarge>
				<joustumine id="d9492ef9-eb0c-4d5e-abb6-afbcaea5fe79">2022-04-04</joustumine>
			</muutmismarge>
		</paragrahv>
		<paragrahv id="para3">
			<paragrahvNr id="0d580448-fe8e-413c-918f-f5ec3a56e5ab">3</paragrahvNr>
			<kuvatavNr id="012b4656-04f7-4f36-a0cd-3b9678066e39"><![CDATA[§ 3. ]]></kuvatavNr>
			<paragrahvPealkiri id="02748a60-46e7-462a-9324-768d0db7f9cd">Hooldustoetus</paragrahvPealkiri>
			<loige id="para3lg1">
				<loigeNr id="4c93ab79-de12-4a89-b7ab-1cdd5a33c4b9">1</loigeNr>
				<kuvatavNr id="dc30ff64-6f9a-43c8-a5dc-5f0b4d9fcee2"><![CDATA[(1)]]></kuvatavNr>
				<sisuTekst id="97ab4d41-a99a-40cb-9c86-9316e4dd3ce5">
					<tavatekst id="cccda870-3a45-4e6e-afc4-e85afde4713d">Hooldustoetuse suuruseks on hooldusteenuse kohamaksumuse ja isiku poolt teenuse eest tasutava omaosaluse vahe. Kohamaksumuse hulka arvatakse kulutused retseptiravimitele, hooldusvahenditele ja arstivisiitidega seotud transpordile.</tavatekst>
				</sisuTekst>
			</loige>
			<loige id="para3lg2">
				<loigeNr id="fe021de7-4c72-468e-ac9a-f1e3b05b6115">2</loigeNr>
				<kuvatavNr id="cd958653-159e-4219-836f-53321611fb5c"><![CDATA[(2)]]></kuvatavNr>
				<sisuTekst id="ececa65b-46c7-4ca6-aa1b-a96c1a7016a6">
					<tavatekst id="da59bae2-c8cc-4452-b40e-fc4d51dd98c4">Isiku omaosaluse suurus on 85-100% tema pensionist ja muudest talle Eesti Vabariigi ja/või mõne teise riigi poolt makstavatest sissetulekutest ning 100% temale makstavast puuetega inimeste sotsiaaltoetusest ja muudest sissetulekutest või tema omandis olevatest rahalistest vahenditest, kuid mitte rohkem kui teenuse eest tasumiseks vajalik.</tavatekst>
				</sisuTekst>
			</loige>
			<loige id="para3lg3">
				<loigeNr id="d1b4fd83-f021-4c07-b13e-33ca51ccc352">3</loigeNr>
				<kuvatavNr id="dafc6313-e081-47a0-b16f-c58b6c500544"><![CDATA[(3)]]></kuvatavNr>
				<sisuTekst id="42d5df5b-7f93-470d-be88-9a8b84a365df">
					<tavatekst id="5bbfa283-3b54-4e9f-bb9f-a34611505104">Kui isiku hooldusvajadust arvestav sobiv hoolduskoht on olemas Pärnu linna hooldekodus, kuid isik asub teenusele muu teenusepakkuja juurde, siis moodustab hooldustoetuse suuruse inimese omaosaluse ja Pärnu linna hooldekodu kohamaksumuse vahe.</tavatekst>
				</sisuTekst>
			</loige>
			<loige id="para3lg4">
				<loigeNr id="b257f3cd-ed6c-41e8-9d5f-4f71c5f46952">4</loigeNr>
				<kuvatavNr id="ac11b5e2-5125-4490-921d-1167a80541a7"><![CDATA[(4)]]></kuvatavNr>
				<sisuTekst id="fbee8ebd-ab9b-438d-a3d7-f36b4ff8f456">
					<tavatekst id="4e36629f-7df2-4a39-a78d-c301f67f6b76">Kui Pärnu linna hooldekodus isiku hooldusvajadust arvestavat sobivat hoolduskohta ei ole, siis moodustab hooldustoetuse suuruse inimese omaosaluse ja sobivat hooldusteenust pakkuva asutuse kohamaksumuse vahe.</tavatekst>
				</sisuTekst>
			</loige>
		</paragrahv>
		<paragrahv id="para4">
			<paragrahvNr id="ff2841b8-c121-4bdf-86b9-870349023a9d">4</paragrahvNr>
			<kuvatavNr id="85070173-0894-4ad9-8aa3-0ef08abdb17f"><![CDATA[§ 4. ]]></kuvatavNr>
			<paragrahvPealkiri id="a21e532a-863f-4595-8ce4-a0bc09cad765">Huvihariduse ja huvitegevuse toetus</paragrahvPealkiri>
			<loige id="para4lg1">
				<loigeNr id="10c2beef-ad50-4466-bc57-24663bf039c4">1</loigeNr>
				<kuvatavNr id="629b1a85-cd05-4663-a2e3-1851d6022cd6"><![CDATA[(1)]]></kuvatavNr>
				<sisuTekst id="2c495a69-01ea-431d-8d12-f4bb02685558">
					<tavatekst id="4e0bc661-2e99-4217-bc3f-e5a77686fde3">Huvihariduse ja huvitegevuse toetuse arvestusliku netosissetuleku piiri arvestamisel ei loeta eluasemekulude hulka eluasemelaenude, liisingute jms tagasimakseid.</tavatekst>
				</sisuTekst>
			</loige>
			<loige id="para4lg2">
				<loigeNr id="c9c7e5bf-21da-4de5-a673-3e4d830816f6">2</loigeNr>
				<kuvatavNr id="50e9cff5-a25f-4e43-a221-97887a8cec3b"><![CDATA[(2)]]></kuvatavNr>
				<sisuTekst id="1e1bb903-e030-494e-8756-8c48b5210a55">
