			<paragrahvPealkiri id="4f4292da-1381-4c40-9d29-306807eecb94">Teenistuja pädevus lisatoetuse määramiseks</paragrahvPealkiri>
			<loige id="para17lg1">
				<loigeNr id="c495a94c-6ff8-406d-b059-8de8f7ab726d">1</loigeNr>
