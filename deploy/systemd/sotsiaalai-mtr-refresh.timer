[Unit]
# A4 E6 — tegevusloa kontrolli korje ajastus.
Description=SotsiaalAI tegevusloa kontrolli korje ajastus (A4, MTR)

[Timer]
# KORD ÖÖPÄEVAS (omanik 10.10.2026: tunnine rütm ei õigusta end). Korje ei kontrolli iga
# päev kõiki: ta vaatab, kelle `nextCheckAt` on käes. Iga teenuseosutajat kontrollitakse
# kord kuus; tõrke järel ja luba esimest korda leidmata proovitakse uuesti järgmisel ööl.
# Esimene kontroll ei oota korjet: ta käivitub kohe, kui inimene teenuse liigi kinnitab.
OnCalendar=*-*-* 03:20:00

# Vahelejäänud jooks tehakse järele (taaskäivitus, hoolduspaus).
Persistent=true

RandomizedDelaySec=300
AccuracySec=1min

Unit=sotsiaalai-mtr-refresh.service

[Install]
WantedBy=timers.target
