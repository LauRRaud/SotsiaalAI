{
  "name": "sotsiaalai",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "prisma": {
    "seed": "node --import tsx prisma/seed.js"
  },
  "description": "SotsiaalAI - kaasaegne AI-platvorm sotsiaalvaldkonna spetsialistidele ja abivajajatele.",
  "author": "SotsiaalAI OU",
  "scripts": {
    "d": "cross-env NODE_ENV=development NODE_OPTIONS=--max-old-space-size=8192 next dev --turbopack -p 3000",
    "dev": "npm run d",
    "dev:3001": "cross-env NODE_ENV=development NODE_OPTIONS=--max-old-space-size=8192 next dev --turbopack -p 3001",
    "dev:auto": "cross-env NODE_ENV=development NODE_OPTIONS=--max-old-space-size=8192 next dev --turbopack",
    "dev:webpack": "cross-env NODE_ENV=development NODE_OPTIONS=--max-old-space-size=8192 next dev --webpack -p 3000",
    "dev:no-turbo": "cross-env NODE_ENV=development NODE_OPTIONS=--max-old-space-size=8192 next dev --webpack -p 3000",
    "portaal": "npm run dev",
    "css:budget": "node scripts/css-cleanup/important-budget.mjs",
    "db:push:local": "dotenv -e .env.local -- prisma db push",
