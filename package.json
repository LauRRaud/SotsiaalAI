    "clean:next": "node scripts/clean-next.mjs",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "check": "prisma generate && npm run i18n:check && npm run lint && npm run dup:check:ci",
