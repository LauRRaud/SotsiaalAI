{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sotsiaal.ai/schemas/rag-qm-p0-baseline-report.schema.json",
  "title": "RAG-QM-P0 privacy-safe baseline report",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "generated_at",
    "interval",
    "source",
    "privacy_notice",
    "used_fields",
    "privacy",
    "metrics",
    "classification",
    "coverage_gaps",
    "integrity"
  ],
  "properties": {
    "schema_version": { "const": "rag-qm-p0-baseline-v1" },
    "generated_at": { "type": "string", "format": "date-time" },
    "interval": {
      "type": "object",
      "additionalProperties": false,
      "required": ["from", "to", "semantics"],
      "properties": {
        "from": { "type": "string", "format": "date-time" },
        "to": { "type": "string", "format": "date-time" },
        "semantics": { "const": "from_inclusive_to_exclusive" }
      }
    },
    "source": { "enum": ["sanitized_fixture", "chatlog_read_only"] },
    "privacy_notice": {
      "const": "Ämbrijaotus põhineb sünteetilisel valimil; produktsiooni-jaotus kinnitamata (Lisa A.3)."
    },
    "used_fields": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string" }
    },
    "privacy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "minimum_group_size",
        "output_validated",
        "temp_files_created",
        "raw_conversations_read",
        "database_writes",
        "external_services_used"
      ],
      "properties": {
        "minimum_group_size": { "const": 20 },
        "output_validated": { "const": true },
        "temp_files_created": { "const": 0 },
        "raw_conversations_read": { "const": 0 },
        "database_writes": { "const": 0 },
        "external_services_used": { "const": 0 }
      }
    },
    "metrics": {
      "type": "object",
      "additionalProperties": false,
      "required": ["counts", "rates", "numeric_summaries", "distributions"],
      "properties": {
        "counts": {
          "type": "array",
          "items": { "$ref": "#/$defs/countMetric" }
        },
        "rates": {
          "type": "array",
          "items": { "$ref": "#/$defs/rateMetric" }
        },
        "numeric_summaries": {
          "type": "array",
          "items": { "$ref": "#/$defs/numericSummary" }
        },
        "distributions": {
          "type": "array",
          "items": { "$ref": "#/$defs/distribution" }
        }
      }
    },
    "classification": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "golden_37", "catalog_35", "allowed_reference_count", "bucket_distribution"],
      "properties": {
        "status": { "enum": ["not_run", "complete"] },
        "golden_37": { "enum": ["not_run", "complete"] },
        "catalog_35": { "enum": ["not_run", "complete"] },
        "allowed_reference_count": { "const": 72 },
        "bucket_distribution": {
          "oneOf": [
            { "type": "null" },
            {
              "type": "array",
              "items": { "$ref": "#/$defs/group" }
            }
          ]
        }
      }
    },
    "coverage_gaps": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["metric", "status"],
        "properties": {
          "metric": { "type": "string", "pattern": "^[A-Za-z0-9_.:-]{1,80}$" },
          "status": { "enum": ["unmeasurable", "unconfirmed", "not_run"] }
        }
      }
    },
    "integrity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["data_sha256"],
      "properties": {
        "data_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
      }
    }
  },
  "$defs": {
    "measurement": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "count", "minimum_group_size"],
      "properties": {
        "status": { "enum": ["reported", "suppressed", "unavailable"] },
        "count": { "type": ["integer", "null"], "minimum": 20 },
        "minimum_group_size": { "const": 20 }
      },
      "allOf": [
        {
          "if": { "properties": { "status": { "const": "reported" } } },
          "then": { "properties": { "count": { "type": "integer", "minimum": 20 } } },
          "else": { "properties": { "count": { "const": null } } }
        }
      ]
    },
    "countMetric": {
      "type": "object",
      "additionalProperties": false,
      "required": ["metric", "measurement"],
      "properties": {
        "metric": { "type": "string", "pattern": "^[A-Za-z0-9_.:-]{1,80}$" },
        "measurement": { "$ref": "#/$defs/measurement" }
      }
    },
    "rateMetric": {
      "type": "object",
      "additionalProperties": false,
      "required": ["metric", "status", "numerator", "denominator", "rate"],
      "properties": {
        "metric": { "type": "string", "pattern": "^[A-Za-z0-9_.:-]{1,80}$" },
        "status": { "enum": ["reported", "suppressed", "unavailable"] },
        "numerator": { "$ref": "#/$defs/measurement" },
        "denominator": { "$ref": "#/$defs/measurement" },
        "rate": { "type": ["number", "null"], "minimum": 0, "maximum": 1 }
      }
    },
    "numericSummary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["metric", "status", "records", "total", "average"],
      "properties": {
        "metric": { "type": "string", "pattern": "^[A-Za-z0-9_.:-]{1,80}$" },
        "status": { "enum": ["reported", "suppressed", "unavailable"] },
        "records": { "$ref": "#/$defs/measurement" },
        "total": { "type": ["integer", "null"], "minimum": 0 },
        "average": { "type": ["number", "null"], "minimum": 0 }
      }
    },
    "group": {
      "type": "object",
      "additionalProperties": false,
      "required": ["value", "measurement"],
      "properties": {
        "value": { "type": "string", "pattern": "^[A-Za-z0-9_.:-]{1,80}$" },
        "measurement": { "$ref": "#/$defs/measurement" }
      }
    },
    "distribution": {
      "type": "object",
      "additionalProperties": false,
      "required": ["dimension", "groups"],
      "properties": {
        "dimension": { "type": "string", "pattern": "^[A-Za-z0-9_.:-]{1,80}$" },
        "groups": {
          "type": "array",
          "items": { "$ref": "#/$defs/group" }
        }
      }
    }
  }
}
