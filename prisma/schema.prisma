/**
 * ---------- Models ----------
 */

model User {
  id                      String    @id @default(cuid())
  email                   String?   @unique
  emailVerified           DateTime?
  emailVerificationSentAt DateTime?
  passwordHash            String?
  role                    Role      @default(CLIENT)
  isAdmin                 Boolean   @default(false)
  sessionVersion          Int       @default(0)
  accessSuspendedAt       DateTime?
  accessSuspendedReason   String?
  accessSuspendedByUserId String?
  acceptsPreInquiries     Boolean   @default(false)
  notificationEmailEnabled Boolean?
  notificationPreferenceVersion Int @default(0)

  // NextAuth
  accounts Account[]
  sessions Session[]

  // Äri
  profile                Profile?
  subscriptions          Subscription[]
  payments               Payment[]
  billingMethods         BillingMethod[]
  sponsoredSubscriptions Subscription[]        @relation("SubscriptionSponsorUser")
  ragDocuments           RagDocument[]
  documents              UserDocument[]
  transcriptionJobs      TranscriptionJob[]
  agentArtifacts         AgentArtifact[]
  documentAudits         DocumentAudit[]
  frameworkAcceptances   FrameworkAcceptance[]
  materialSubmissions    MaterialSubmission[]
  savedAnalyses          SavedAnalysis[]

  // Chat / runs
  conversationRuns        ConversationRun[]
  conversationMessages    ConversationMessage[]
  conversations           Conversation[]
  usageBuckets            UsageBucket[]
  usageReservations       UsageReservation[]
  usageEvents             UsageEvent[]
  usageOverrides          UserEntitlementOverride[] @relation("UsageOverrideUser")
  grantedUsageOverrides   UserEntitlementOverride[] @relation("UsageOverrideAdmin")
  emailOtpCodes           EmailOtpCode[]
  trustedDevices          TrustedDevice[]
  loginTempTokens         LoginTempToken[]
  roomsOwned              Room[]
  roomMemberships         RoomMember[]
  sentInvites             Invite[]                 @relation("InviterUser")
  sponsoredInvites        Invite[]                 @relation("InviteSponsorUser")
  sponsoredMembers        RoomMember[]             @relation("RoomMemberSponsorUser")
  acceptedInvites         Invite[]                 @relation("InviteAcceptedBy")
  roomMessages            RoomMessage[]            @relation("RoomMessageAuthor")
  roomSharedSummaries     RoomSharedSummary[]      @relation("RoomSharedSummarySharedBy")
  roomSummaryCopies       RoomSummaryCopy[]
  roomSummaryApprovals    RoomSummaryApproval[]
  callSessionsStarted     CallSession[]            @relation("CallSessionStartedBy")
  callParticipants        CallParticipant[]
  callSpeakRequests       CallSpeakRequest[]
  callSpeakRequestsClosed CallSpeakRequest[]        @relation("CallSpeakRequestResolvedBy")
  callRecordingRequests   CallRecordingRequest[]    @relation("CallRecordingRequestRequestedBy")
  callRecordingConsents   CallRecordingConsent[]
  helpRequests            HelpRequest[]
  helpOffers              HelpOffer[]
  requestedHelpMatches    HelpMatch[]              @relation("HelpMatchRequester")
  offeredHelpMatches      HelpMatch[]              @relation("HelpMatchOfferer")
  researchJobs            ResearchJob[]
  serviceProviderProfiles ServiceProviderProfile[]
  authoredPreInquiries    PreInquiry[]             @relation("PreInquiryAuthor")
  receivedPreInquiries    PreInquiry[]             @relation("PreInquiryRecipientOwner")
  journeys                Journey[]
  wellbeingRecords        WellbeingRecord[]
  practiceReflections     PracticeReflection[]
  wellbeingOutputDrafts   WellbeingOutputDraft[]
  wellbeingPilotViewers   WellbeingPilotViewer[]
  covisionCasesOwned      CovisionCase[]           @relation("CovisionCaseOwner")
  covisionParticipants    CovisionParticipant[]    @relation("CovisionParticipantUser")
  covisionMessages        CovisionMessage[]        @relation("CovisionMessageAuthor")
  effectivePractices      EffectivePractice[]      @relation("EffectivePracticeAuthor")
  topicSeeds              TopicSeed[]              @relation("TopicSeedOwner")
  covisionPrivateStates   CovisionPrivateState[]   @relation("CovisionPrivateStateUser")
  covisionStageSnapshots  CovisionStageSnapshot[]  @relation("CovisionStageSnapshotCompleter")
  covisionClosuresOwned   CovisionClosure[]        @relation("CovisionClosureOwner")
  covisionClosuresClosed  CovisionClosure[]        @relation("CovisionClosureClosedBy")
  covisionClosuresAssigned CovisionClosure[]       @relation("CovisionClosureAssignee")
  covisionFollowUps       CovisionFollowUp[]       @relation("CovisionFollowUpAssignee")
  covisionFollowUpsDone   CovisionFollowUp[]       @relation("CovisionFollowUpCompleter")
  covisionOwnerPackages   CovisionOwnerPackage[]   @relation("CovisionOwnerPackageOwner")
  practiceCapabilities       PracticeCapability[]           @relation("PracticeCapabilityUser")
  practiceCapabilitiesGranted PracticeCapability[]          @relation("PracticeCapabilityGranter")
  effectivePracticeReviews   EffectivePracticeReview[]      @relation("EffectivePracticeReviewer")
  effectivePracticeReviewAssignments EffectivePracticeReviewAssignment[] @relation("EffectivePracticeReviewAssignee")
  effectivePracticeVersions  EffectivePracticeVersion[]     @relation("EffectivePracticeVersionPublisher")
  effectivePracticeApplications EffectivePracticeApplication[] @relation("EffectivePracticeApplicationAuthor")
  effectivePracticeApplicationsReviewed EffectivePracticeApplication[] @relation("EffectivePracticeApplicationReviewer")
  effectivePracticeApplicationsAssigned EffectivePracticeApplication[] @relation("EffectivePracticeApplicationAssignee")
  practiceCapabilityAuditsTarget PracticeCapabilityAudit[]      @relation("PracticeCapabilityAuditTarget")
  practiceCapabilityAuditsActor PracticeCapabilityAudit[]       @relation("PracticeCapabilityAuditActor")
  effectivePracticeAuditEvents EffectivePracticeAuditEvent[]    @relation("EffectivePracticeAuditActor")
  sourceFeedbackReported       SourceFeedback[]                  @relation("SourceFeedbackReporter")
  sourceFeedbackResolved       SourceFeedback[]                  @relation("SourceFeedbackResolver")
  notificationEvents           NotificationEvent[]
  domainEventsActed            DomainEvent[]              @relation("DomainEventActor")
  pendingEmailChange           PendingEmailChange?
  dataExportJobs               DataExportJob[]
  supervisorGrants                      SupervisorGrant[]                   @relation("SupervisorGrantUser")
  supervisorGrantsGranted               SupervisorGrant[]                   @relation("SupervisorGrantGrantedBy")
  supervisorGrantsRevoked               SupervisorGrant[]                   @relation("SupervisorGrantRevokedBy")
  supervisionProcessesSupervised        SupervisionProcess[]                @relation("SupervisionProcessSupervisor")
  supervisionContractVersionsCreated    SupervisionContractVersion[]        @relation("SupervisionContractCreatedBy")
  supervisionParticipations             SupervisionParticipation[]          @relation("SupervisionParticipationUser")
  supervisionInvitationsSent            SupervisionParticipation[]          @relation("SupervisionParticipationInvitedBy")
  supervisionPrivateItems               SupervisionPrivateItem[]            @relation("SupervisionPrivateItemOwner")
  supervisionMeetingsMarkedHeld         SupervisionMeeting[]                @relation("SupervisionMeetingMarkedHeldBy")
  supervisionSummariesCreated           SupervisionSummary[]                @relation("SupervisionSummaryCreatedBy")
  supervisionClosuresClosed             SupervisionClosure[]                @relation("SupervisionClosureClosedBy")
  supervisionPersonalOutcomes           SupervisionPersonalOutcome[]        @relation("SupervisionPersonalOutcomeOwner")
  supervisionAuditEvents                SupervisionAuditEvent[]             @relation("SupervisionAuditActor")
  mentorProfile                MentorProfile?             @relation("MentorProfileUser")
  mentorProfilesReviewed       MentorProfile[]            @relation("MentorProfileReviewer")
  mentoringRequestsSent        MentoringRequest[]         @relation("MentoringRequestMentee")
  mentoringRequestsReceived    MentoringRequest[]         @relation("MentoringRequestMentorUser")
  mentoringRelationsAsMentor   MentoringRelation[]        @relation("MentoringRelationMentor")
  mentoringRelationsAsMentee   MentoringRelation[]        @relation("MentoringRelationMentee")
  mentoringRelationsClosed     MentoringRelation[]        @relation("MentoringRelationClosedBy")
  mentoringAgreementAcceptances MentoringAgreementAcceptance[] @relation("MentoringAgreementAcceptanceUser")
  mentoringMeetingsCreated     MentoringMeeting[]         @relation("MentoringMeetingCreator")
  mentoringSummariesCreated    MentoringSummary[]         @relation("MentoringSummaryCreator")
  mentoringSummaryConfirmations MentoringSummaryConfirmation[] @relation("MentoringSummaryConfirmationUser")
  mentoringPrivateNotes        MentoringPrivateNote[]     @relation("MentoringPrivateNoteOwner")
  mentoringAuditEventsActed    MentoringAuditEvent[]      @relation("MentoringAuditActor")
  fieldVisits                  FieldVisit[]               @relation("FieldVisitOwner")
  // TEENUSPÄEVIK-V1: kaks eri rolli, seega kaks eri seost. Sisestaja on
  // spetsialist, klient on teenuse saaja — sama inimene EI ole kunagi mõlemad
  // ühel kirjel, aga skeem ei tohi neid ühte lahtrisse suruda.
  serviceEntriesEntered        ServiceEntry[]             @relation("ServiceEntryOwner")
  serviceLogTimeSamples        ServiceLogTimeSample[]     @relation("ServiceLogTimeSampleOwner")
  serviceEntriesAsClient       ServiceEntry[]             @relation("ServiceEntryClient")
  serviceReferralsAsClient     ServiceReferral[]          @relation("ServiceReferralClient")
  serviceNarrativesAsClient    ServiceMonthlyNarrative[]  @relation("ServiceNarrativeClient")
  serviceEntryCorrections      ServiceEntryCorrection[]   @relation("ServiceEntryCorrectionActor")
  // T25 ORG-FOUNDATION-V1: liikmesus on eraldi objekt, MITTE kasutaja väli.
  // `User.role` jääb hinnastatavaks tootepersonaks; organisatsioonisisene
  // õigus elab `OrganizationCapabilityGrant`-is (arenduskava §D3).
  organizationMemberships          OrganizationMembership[]      @relation("OrganizationMembershipUser")
  organizationMembershipsInvited   OrganizationMembership[]      @relation("OrganizationMembershipInvitedBy")
  organizationsCreated             Organization[]                @relation("OrganizationCreatedBy")
  organizationsVerified            Organization[]                @relation("OrganizationVerifiedBy")
  organizationModulesActivated     OrganizationModule[]          @relation("OrganizationModuleActivatedBy")
  organizationCapabilitiesGranted  OrganizationCapabilityGrant[] @relation("OrganizationCapabilityGrantedBy")
  organizationCapabilitiesRevoked  OrganizationCapabilityGrant[] @relation("OrganizationCapabilityRevokedBy")
  organizationInvitesSent          OrganizationInvite[]          @relation("OrganizationInviteInvitedBy")
  organizationInvitesAccepted      OrganizationInvite[]          @relation("OrganizationInviteAcceptedBy")
  // T25 viil B
  organizationSeatPlansCreated     OrganizationSeatPlan[]        @relation("OrganizationSeatPlanCreatedBy")
  organizationSeatsAssigned        OrganizationSeatAssignment[]  @relation("OrganizationSeatAssignedBy")
  organizationWorkAssigned         OrganizationWorkAssignment[]  @relation("OrganizationWorkAssignedBy")
  orgClientSponsorshipsSent        OrganizationClientSponsorship[] @relation("OrgClientSponsorshipInvitedBy")
  orgClientSponsorshipsAccepted    OrganizationClientSponsorship[] @relation("OrgClientSponsorshipAcceptedBy")
  // T25 viil C
  organizationReportingLinesCreated OrganizationReportingLine[]     @relation("OrganizationReportingCreatedBy")
  organizationSupportContactsCreated OrganizationSupportContact[]   @relation("OrganizationSupportContactCreatedBy")
  wellbeingSupportShares           WellbeingSupportShare[]          @relation("WellbeingSupportShareOwner")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([acceptsPreInquiries])
  @@index([accessSuspendedAt])
  serviceReportShares  ServiceReportShare[]  @relation("ServiceReportShareOwner")

  // COLLAB-P4: kolm eri rolli samas jagamises — töötaja koostab, klient
  // kinnitab, saaja loeb. Eraldi relatsioonid, sest need kolm ei ole
  // vahetatavad ja iga rada peab olema eraldi päritav.
  networkSharesAsWorker    NetworkShare[] @relation("NetworkShareWorker")
  networkSharesAsClient    NetworkShare[] @relation("NetworkShareClient")
  networkSharesAsRecipient NetworkShare[] @relation("NetworkShareRecipient")
  networkSharesAttested    NetworkShare[] @relation("NetworkShareAttestedBy")

  // SK-V1: laud on FUNKTSIONAALNE, mitte nimeline töötaja — aga laual on omanik
  // ja mehitajad, sest ilma nendeta ei ole kellelegi vastutust omistada.
  // `urgentRequestEvents` kannab isikulist vastutusjälge (KOV-lepingu p 8):
  // iga vaatamine, toiming ja edasisuunamine seotakse konkreetse inimesega.
  urgentDesksOwned         UrgentDesk[]         @relation("UrgentDeskOwner")
  urgentDeskMemberships    UrgentDeskMember[]   @relation("UrgentDeskMemberUser")
  urgentRequestsAuthored   UrgentRequest[]      @relation("UrgentRequestAuthor")
  urgentRequestEvents      UrgentRequestEvent[] @relation("UrgentRequestEventActor")

  // JUHTUM-V1: KAKS ERI ROLLI ja neid ei tohi segada.
  // `caseWorkAssistsOwned` = töötaja enda juhtumid (Cascade — kustuvad koos kontoga).
  // `caseWorkAssistsAsClient` = juhtumid, kus SEE inimene on märgitud kliendiks
  // (SetNull). Kliendi konto kustutamine ei tohi töötaja juhtumit hävitada, aga
  // FK `SetNull` üksi ei määra `clientErasedAt`-i — seda teeb
  // `eraseCaseClientReference()` konto kustutamise rajalt (leping L17).
  caseWorkAssistsOwned     CaseWorkAssist[]     @relation("CaseWorkAssistOwner")
  caseWorkAssistsAsClient  CaseWorkAssist[]     @relation("CaseWorkAssistClient")
}

