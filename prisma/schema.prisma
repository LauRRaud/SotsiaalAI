  callSession CallSession @relation(fields: [callSessionId], references: [id], onDelete: Cascade)
  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  resolvedBy  User?       @relation("CallSpeakRequestResolvedBy", fields: [resolvedByUserId], references: [id], onDelete: SetNull)

  @@index([callSessionId, status, requestedAt])
  @@index([userId, status])
}

model CallRecordingRequest {
  id                  String                     @id @default(cuid())
  callSessionId       String
  requestedByUserId   String
  purpose             CallRecordingPurpose       @default(GENERAL_SUMMARY)
  purposeText         String?                    @db.Text
  status              CallRecordingRequestStatus @default(REQUESTED)
  consentTextVersion  String
  consentTextSnapshot String                     @db.Text
  // Nõusolekuteksti sisse küpsetatud küsija nimi eraldi väljana, et sama teksti
  // saaks hiljem teises keeles uuesti renderdada ilma nime tekstist välja
  // parsimata. NULL = enne 04.08.2026 loodud taotlus.
  requesterNameSnapshot String?
  requestedAt         DateTime                   @default(now())
  // SOL-CALL-02/03 — ÜHE start-katse töö-ID + lease + fencing-loend.
  //   · `startClaimId`         — ainult SEDA id-d kandev rida tohib katse tulemuse
  //     kirjutada; hiline zombi ei kirjuta üle plaani, mille vahepeal võttis teine
  //   · `startClaimedAt`       — lease'i algus; aegunud claim on varastatav, seega
  //     surnud protsess ei jäta luku igaveseks kinni
  //   · `rosterVersionAtStart` — `CallSession.rosterVersion` claim'i hetkel. Kui ta
  //     enne ACTIVE-ks minekut muutub, tuleb start katkestada ja egress peatada
  startClaimId         String?
  startClaimedAt       DateTime?
  rosterVersionAtStart Int?
  startedAt           DateTime?
  stoppedAt           DateTime?
  completedAt         DateTime?
  createdAt           DateTime                   @default(now())
  updatedAt           DateTime                   @updatedAt

  callSession CallSession            @relation(fields: [callSessionId], references: [id], onDelete: Cascade)
  requestedBy User                   @relation("CallRecordingRequestRequestedBy", fields: [requestedByUserId], references: [id], onDelete: Cascade)
  consents    CallRecordingConsent[]
  files       CallRecordingFile[]

  @@index([callSessionId, status])
  @@index([requestedByUserId, requestedAt])
}

model CallRecordingConsent {
  id                  String                     @id @default(cuid())
  recordingRequestId  String
  callSessionId       String
  userId              String
  status              CallRecordingConsentStatus @default(REQUESTED)
  consentTextVersion  String
  consentTextSnapshot String                     @db.Text
  // Keel, milles SEE inimene nõusoleku andis — snapshot renderdatakse vastamise
  // hetkel tema liidese keeles. NULL = vastamata rida või enne 04.08.2026 antud
  // nõusolek (need on eestikeelsed). Sama muster mis FrameworkAcceptance.locale.
  locale              String?
  respondedAt         DateTime?
  withdrawnAt         DateTime?
  ipAddressHash       String?
  userAgentHash       String?
  createdAt           DateTime                   @default(now())
  updatedAt           DateTime                   @updatedAt

  recordingRequest CallRecordingRequest @relation(fields: [recordingRequestId], references: [id], onDelete: Cascade)
  user             User                 @relation(fields: [userId], references: [id], onDelete: Cascade)

  // SOL-CALL-05 — üks inimene, üks otsus. Ilma selle piirita tegi paralleelne
  // join/consent samale inimesele mitu rida (`findFirst → create` ilma tehinguta) ja
  // readiness luges neid kõiki: üks REQUESTED-duplikaat blokeeris, `allRequiredConsents`
  // Map'is otsustas juhuslik viimane rida. Nõusolek ei ole loend, ta on ÜKS tahteavaldus.
  @@unique([recordingRequestId, userId])
  @@index([recordingRequestId, status])
  @@index([callSessionId, userId])
}

model CallRecordingFile {
  id                 String                  @id @default(cuid())
  recordingRequestId String
  callSessionId      String
  egressId           String?
  storageProvider    String?
  filePath           String?
  mimeType           String?
  fileSizeBytes      Int?
  durationSeconds    Int?
  checksum           String?
  status             CallRecordingFileStatus @default(NOT_CREATED)
  createdDocumentId  String?
  retentionUntil     DateTime?
  // SOL-CALL-01 — hetk, mil PROVIDER ISE ütles egress'i kohta terminaalse seisu.
  // NULL tähendab „ei ole tõendatud", mitte „ei ole lõppenud". Ainult mitte-NULL
  // väärtus annab õiguse kirjutada taotlusele lõppseisu.
  providerStopConfirmedAt DateTime?
  createdAt          DateTime                @default(now())
  updatedAt          DateTime                @updatedAt

  recordingRequest CallRecordingRequest @relation(fields: [recordingRequestId], references: [id], onDelete: Cascade)
  callSession      CallSession          @relation(fields: [callSessionId], references: [id], onDelete: Cascade)
  createdDocument  UserDocument?        @relation(fields: [createdDocumentId], references: [id], onDelete: SetNull)

  @@index([recordingRequestId, status])
  @@index([callSessionId, status])
  @@index([createdDocumentId])
}

model UserDocument {
  id                    String       @id @default(cuid())
  ownerId               String
  title                 String
  originalName          String
  kind                  DocumentKind @default(MATERIAL)
  templateFor           TemplateFor?
  agentAllowed          Boolean      @default(false)
  mime                  String
  size                  Int
  sha256                String
  storagePath           String
  sourceDocumentId      String?
  content               String?      @db.Text
  metadata              Json?
  frameworkAcceptanceId String?      @unique
  createdAt             DateTime     @default(now())
  updatedAt             DateTime     @updatedAt

  owner               User                          @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  frameworkAcceptance FrameworkAcceptance?          @relation(fields: [frameworkAcceptanceId], references: [id], onDelete: SetNull)
  sourceDocument      UserDocument?                  @relation("UserDocumentSource", fields: [sourceDocumentId], references: [id], onDelete: SetNull)
  derivedDocuments    UserDocument[]                 @relation("UserDocumentSource")
  templateArtifacts   AgentArtifact[]               @relation("AgentArtifactTemplate")
  sourceArtifactLinks AgentArtifactSourceDocument[]
  sourceTranscriptionJobs TranscriptionJob[]             @relation("TranscriptionJobSource")
  transcriptTranscriptionJobs TranscriptionJob[]         @relation("TranscriptionJobTranscript")
  audits              DocumentAudit[]
  callRecordingFiles  CallRecordingFile[]
  fieldVisitAttachments FieldVisitAttachment[]         @relation("FieldVisitAttachmentDocument")
  /// JUHTUM-V1 seos (L15). Cascade: dokumendi kustutus eemaldab seose ANDMEBAASIST,
  /// mitte rakenduse kustutusteelt — seega rippuvat viidet ei jää ka otse-SQL kustutusel.
  caseWorkItems       CaseWorkItem[]

  @@index([ownerId, updatedAt])
  @@index([ownerId, kind, updatedAt])
  @@index([ownerId, agentAllowed, updatedAt])
  @@index([sourceDocumentId])
  @@index([sha256])
}

model FrameworkAcceptance {
  id                         String    @id @default(cuid())
  userId                     String
  frameworkKey               String
  frameworkVersion           String
  acceptanceType             String
  acceptanceSource           String
  roleAtAcceptance           Role
  locale                     String?
  ipAddress                  String?
  userAgent                  String?
  acceptedAt                 DateTime  @default(now())
  reviewDocumentOpenedAt     DateTime?
  signedDocumentDownloadedAt DateTime?
  createdAt                  DateTime  @default(now())
  updatedAt                  DateTime  @updatedAt

  user     User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  document UserDocument?

  @@index([userId, acceptedAt])
  @@index([frameworkKey, frameworkVersion, acceptedAt])
  @@index([acceptanceType, acceptedAt])
}

model AgentArtifact {
  id         String              @id @default(cuid())
  ownerId    String
  type       AgentArtifactType
  title      String?
  status     AgentArtifactStatus @default(DRAFT)
  content    String              @db.Text
  metadata   Json?
  approvedAt DateTime?
  templateId String?
  idempotencyKey String?
  createdAt  DateTime            @default(now())
  updatedAt  DateTime            @updatedAt

  owner           User                          @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  template        UserDocument?                 @relation("AgentArtifactTemplate", fields: [templateId], references: [id], onDelete: SetNull)
  sourceDocuments AgentArtifactSourceDocument[]
  audits          DocumentAudit[]
  /// JUHTUM-V1 seos (L15), Cascade — vt `UserDocument.caseWorkItems`.
  caseWorkItems   CaseWorkItem[]

  @@unique([ownerId, idempotencyKey])
  @@index([ownerId, updatedAt])
  @@index([ownerId, type, updatedAt])
  @@index([ownerId, status, updatedAt])
  @@index([templateId])
}

model TranscriptionJob {
  id                   String                 @id @default(cuid())
  sourceDocumentId     String
  requestedByUserId    String
  transcriptDocumentId String?
  provider             String
  model                String?
  language             String?
  status               TranscriptionJobStatus @default(QUEUED)
  error                String?
  startedAt            DateTime?
  completedAt          DateTime?
  cancelledAt          DateTime?
  createdAt            DateTime               @default(now())
  updatedAt            DateTime               @updatedAt

  sourceDocument     UserDocument  @relation("TranscriptionJobSource", fields: [sourceDocumentId], references: [id], onDelete: Cascade)
  requestedBy        User          @relation(fields: [requestedByUserId], references: [id], onDelete: Cascade)
  transcriptDocument UserDocument? @relation("TranscriptionJobTranscript", fields: [transcriptDocumentId], references: [id], onDelete: SetNull)

  @@index([sourceDocumentId, status])
  @@index([requestedByUserId, status])
  @@index([transcriptDocumentId])
  @@index([createdAt])
}

model AgentArtifactSourceDocument {
  artifactId String
  documentId String
  createdAt  DateTime @default(now())

  artifact AgentArtifact @relation(fields: [artifactId], references: [id], onDelete: Cascade)
  document UserDocument  @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@id([artifactId, documentId])
  @@index([documentId])
}

model DocumentAudit {
  id         String              @id @default(cuid())
  ownerId    String
  documentId String?
  artifactId String?
  action     DocumentAuditAction
  meta       Json?
  createdAt  DateTime            @default(now())

  owner    User           @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  document UserDocument?  @relation(fields: [documentId], references: [id], onDelete: SetNull)
  artifact AgentArtifact? @relation(fields: [artifactId], references: [id], onDelete: SetNull)

  @@index([ownerId, createdAt])
  @@index([documentId, createdAt])
  @@index([artifactId, createdAt])
  @@index([action, createdAt])
}

model SavedAnalysis {
  id                String   @id @default(cuid())
  ownerId           String
  title             String?
  content           String   @db.Text
  sourceDocumentIds Json?
  metadata          Json?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  owner            User              @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  roomSummaryCopies RoomSummaryCopy[]

  @@index([ownerId, updatedAt])
}

model MaterialSubmission {
  id                String    @id @default(cuid())
  submittedByUserId String
  comment           String    @db.Text
  originalName      String
  mime              String
  size              Int
  sha256            String
  storagePath       String
  status            String    @default("pending")
  reviewedAt        DateTime?
  reviewedBy        String?
  reviewNote        String?   @db.Text
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  submittedByUser User @relation(fields: [submittedByUserId], references: [id], onDelete: Cascade)

  @@index([submittedByUserId, createdAt])
  @@index([createdAt])
  @@index([sha256])
  @@index([status, createdAt])
  @@index([reviewedAt])
}

// ---------------------------------------------------------------------------
// RAG graph-lite (phase 1): deterministic knowledge-graph layer.
// Tables are created by a future migration; phase 1 ships schema + offline
// builders only. Every relation must carry evidence (source document and/or
// chunk reference). See docs/internal/rag-roadmap.md track C.
// ---------------------------------------------------------------------------

enum RagEntityType {
  SERVICE
  BENEFIT
  LAW
  LEGAL_SECTION
  MUNICIPALITY
  ORGANIZATION
  FORM
  CONTACT_POINT
  TARGET_GROUP
  NEED
  RISK_SIGNAL
  DOCUMENT_TYPE
  WORKFLOW
}

enum RagRelationType {
  REGULATES
  BELONGS_TO
  PROVIDED_BY
  ORGANIZED_BY
  SUITABLE_FOR
  REQUIRES
  RELATED_TO
  HAS_LEGAL_BASIS
  HAS_DOCUMENT
  HAS_FORM
  HAS_NEXT_STEP
  HAS_CONTACT_POINT
  ASSESSES
  MITIGATES_RISK
  ESCALATES_TO
  APPLIES_TO
  AVAILABLE_IN
}

enum RagGraphReviewStatus {
  AUTO_APPROVED
  NEEDS_REVIEW
  APPROVED
  REJECTED
}

model RagEntity {
  id             String               @id @default(cuid())
  type           RagEntityType
  name           String
  normalizedName String
  externalKey    String               @unique
  aliases        String[]             @default([])
  roles          String[]             @default([])
  description    String?              @db.Text
  confidence     Float                @default(1)
  reviewStatus   RagGraphReviewStatus @default(AUTO_APPROVED)
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt

  relationsFrom RagRelation[]    @relation("RagRelationFrom")
  relationsTo   RagRelation[]    @relation("RagRelationTo")
  chunkLinks    RagChunkEntity[]

  @@index([type, normalizedName])
  @@index([normalizedName])
}

model RagRelation {
  id               String               @id @default(cuid())
  fromEntityId     String
  toEntityId       String
  relationType     RagRelationType
  confidence       Float                @default(1)
  evidenceChunkId  String?
  sourceDocumentId String?
  evidenceRef      String?
  extractor        String               @default("deterministic_kov_v1")
  reviewStatus     RagGraphReviewStatus @default(AUTO_APPROVED)
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt

  fromEntity RagEntity @relation("RagRelationFrom", fields: [fromEntityId], references: [id], onDelete: Cascade)
  toEntity   RagEntity @relation("RagRelationTo", fields: [toEntityId], references: [id], onDelete: Cascade)

  @@unique([fromEntityId, toEntityId, relationType, sourceDocumentId])
  @@index([relationType])
  @@index([toEntityId])
}

model RagChunkEntity {
  id           String   @id @default(cuid())
  chunkId      String
  entityId     String
  relevance    Float    @default(1)
  evidenceText String?  @db.Text
  createdAt    DateTime @default(now())

  entity RagEntity @relation(fields: [entityId], references: [id], onDelete: Cascade)

  @@unique([chunkId, entityId])
  @@index([entityId])
}

// ---------------------------------------------------------------------------
// Supervisioon V0 (SUP-P0): additive schema foundation.
// Private M6/M12 reverse relations are ignored by Prisma Client so shared
// serializers cannot traverse an include path into owner-private content.
// The M6 WellbeingOutputDraft foreign key is defined in the migration without
// changing the existing WellbeingOutputDraft model.
// ---------------------------------------------------------------------------

enum SupervisionProcessType {
  INDIVIDUAL
  GROUP
}

enum SupervisionProcessStatus {
  DRAFT
  ACTIVE
  CLOSED
}

enum SupervisionContractStatus {
  DRAFT
  ACTIVE
  SUPERSEDED
}

enum SupervisionParticipationStatus {
  INVITED
  ACCEPTED
  DECLINED
  LEFT
  WITHDRAWN
}

enum SupervisionPrivateItemKind {
  PREP_TOPIC
  PRIVATE_NOTE
  CLOSING_REFLECTION
}

enum SupervisionTopicAudience {
  SUPERVISOR_ONLY
  PROCESS
}

enum SupervisionTopicSourceKind {
  MANUAL
  WELLBEING_HANDOFF
}

enum SupervisionTopicStatus {
  SHARED
  WITHDRAWN
}

enum SupervisionMeetingStatus {
  PLANNED
  HELD
  CANCELLED
}

enum SupervisionSummaryKind {
  MEETING
  FINAL
}

enum SupervisionSummaryStatus {
  DRAFT
  PENDING_APPROVAL
  APPROVED
  DISCARDED
}

model SupervisorGrant {
  id              String    @id @default(cuid())
  userId          String
  grantedByUserId String?
  grantBasis      String    @db.Text
  validFrom       DateTime  @default(now())
  validUntil      DateTime?
  revokedAt       DateTime?
  revokedByUserId String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  user          User  @relation("SupervisorGrantUser", fields: [userId], references: [id], onDelete: Cascade)
  grantedByUser User? @relation("SupervisorGrantGrantedBy", fields: [grantedByUserId], references: [id], onDelete: SetNull)
  revokedByUser User? @relation("SupervisorGrantRevokedBy", fields: [revokedByUserId], references: [id], onDelete: SetNull)

  @@index([userId, revokedAt, validUntil])
}

model SupervisionProcess {
  id                      String                   @id @default(cuid())
  supervisorId            String
  type                    SupervisionProcessType
  title                   String
  goal                    String?                  @db.Text
  plannedMeetingCount     Int                      @default(5)
  status                  SupervisionProcessStatus @default(DRAFT)
  activeContractVersionId String?                  @unique
  version                 Int                      @default(0)
  lastActivityAt          DateTime                 @default(now())
  createdAt               DateTime                 @default(now())
  updatedAt               DateTime                 @updatedAt
  closedAt                DateTime?

  supervisor            User                         @relation("SupervisionProcessSupervisor", fields: [supervisorId], references: [id], onDelete: Cascade)
  activeContractVersion SupervisionContractVersion?  @relation("SupervisionActiveContractVersion", fields: [activeContractVersionId], references: [id], onDelete: SetNull)
  contractVersions      SupervisionContractVersion[] @relation("SupervisionContractVersions")
  participations       SupervisionParticipation[]
  sharedTopics         SupervisionSharedTopic[]
  meetings             SupervisionMeeting[]
  summaries            SupervisionSummary[]
  closure              SupervisionClosure?
  auditEvents          SupervisionAuditEvent[]
  privateItems         SupervisionPrivateItem[]     @relation("SupervisionPrivateItemProcess") @ignore
  personalOutcomes     SupervisionPersonalOutcome[] @relation("SupervisionPersonalOutcomeProcess") @ignore

  @@index([supervisorId, status, updatedAt])
  @@index([status, lastActivityAt])
}

model SupervisionContractVersion {
  id              String                    @id @default(cuid())
  processId       String
  versionNumber   Int
  body            String                    @db.Text
  createdByUserId String?
  status          SupervisionContractStatus @default(DRAFT)
  activatedAt     DateTime?
  createdAt       DateTime                  @default(now())

  process          SupervisionProcess              @relation("SupervisionContractVersions", fields: [processId], references: [id], onDelete: Cascade)
  activeForProcess SupervisionProcess?             @relation("SupervisionActiveContractVersion")
  createdByUser    User?                           @relation("SupervisionContractCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)
  acceptances      SupervisionContractAcceptance[]

  @@unique([processId, versionNumber])
  @@index([processId, status])
}

model SupervisionParticipation {
  id              String                         @id @default(cuid())
  processId       String
  userId          String
  invitedByUserId String?
  status          SupervisionParticipationStatus @default(INVITED)
  invitedAt       DateTime                       @default(now())
  respondedAt     DateTime?
  leftAt          DateTime?
  createdAt       DateTime                       @default(now())
  updatedAt       DateTime                       @updatedAt

  process          SupervisionProcess             @relation(fields: [processId], references: [id], onDelete: Cascade)
  user             User                           @relation("SupervisionParticipationUser", fields: [userId], references: [id], onDelete: Cascade)
  invitedByUser    User?                          @relation("SupervisionParticipationInvitedBy", fields: [invitedByUserId], references: [id], onDelete: SetNull)
  acceptances      SupervisionContractAcceptance[]
  authoredTopics   SupervisionSharedTopic[]
  summaryApprovals SupervisionSummaryApproval[]

  @@unique([processId, userId])
  @@index([userId, status, updatedAt])
}

model SupervisionContractAcceptance {
  id                String   @id @default(cuid())
  participationId   String
  contractVersionId String
  acceptedAt        DateTime @default(now())

  participation   SupervisionParticipation   @relation(fields: [participationId], references: [id], onDelete: Cascade)
  contractVersion SupervisionContractVersion @relation(fields: [contractVersionId], references: [id], onDelete: Cascade)

  @@unique([participationId, contractVersionId])
  @@index([contractVersionId])
}

model SupervisionPrivateItem {
  id                     String                     @id @default(cuid())
  processId              String
  ownerUserId            String
  kind                   SupervisionPrivateItemKind
  title                  String?
  body                   String                     @db.Text
  sharedTopicId          String?
  sourceKind             SupervisionTopicSourceKind @default(MANUAL)
  sourceWellbeingDraftId String?                    @unique
  version                Int                        @default(0)
  createdAt              DateTime                   @default(now())
  updatedAt              DateTime                   @updatedAt

  owner       User                    @relation("SupervisionPrivateItemOwner", fields: [ownerUserId], references: [id], onDelete: Cascade)
  process     SupervisionProcess      @relation("SupervisionPrivateItemProcess", fields: [processId], references: [id], onDelete: Cascade)
  sharedTopic SupervisionSharedTopic? @relation("SupervisionPrivateItemSharedTopic", fields: [sharedTopicId], references: [id], onDelete: SetNull)

  @@index([processId, ownerUserId, updatedAt])
}

model SupervisionSharedTopic {
  id                    String                     @id @default(cuid())
  processId             String
  authorParticipationId String
  title                 String
  body                  String                     @db.Text
  audience              SupervisionTopicAudience
  sourceKind            SupervisionTopicSourceKind
  status                SupervisionTopicStatus     @default(SHARED)
  sharedAt              DateTime                   @default(now())
  withdrawnAt           DateTime?
  version               Int                        @default(0)
  createdAt             DateTime                   @default(now())
  updatedAt             DateTime                   @updatedAt

  process             SupervisionProcess       @relation(fields: [processId], references: [id], onDelete: Cascade)
  authorParticipation SupervisionParticipation @relation(fields: [authorParticipationId], references: [id], onDelete: Cascade)
  sourcePrivateItems  SupervisionPrivateItem[] @relation("SupervisionPrivateItemSharedTopic") @ignore

  @@index([processId, status, sharedAt])
  @@index([authorParticipationId])
}

model SupervisionMeeting {
  id                 String                   @id @default(cuid())
  processId          String
  seq                Int
  plannedAt          DateTime?
  heldAt             DateTime?
  markedHeldByUserId String?
  status             SupervisionMeetingStatus @default(PLANNED)
  agendaTopicIds     String[]                 @default([])
  note               String?                  @db.Text
  topicCountAtClose  Int?
  version            Int                      @default(0)
  createdAt          DateTime                 @default(now())
  updatedAt          DateTime                 @updatedAt

  process          SupervisionProcess @relation(fields: [processId], references: [id], onDelete: Cascade)
  markedHeldByUser User?              @relation("SupervisionMeetingMarkedHeldBy", fields: [markedHeldByUserId], references: [id], onDelete: SetNull)
  summary          SupervisionSummary?

  @@unique([processId, seq])
}

model SupervisionSummary {
  id              String                   @id @default(cuid())
  processId       String
  meetingId       String?                  @unique
  kind            SupervisionSummaryKind
  body            String                   @db.Text
  status          SupervisionSummaryStatus @default(DRAFT)
  createdByUserId String?
  submittedAt     DateTime?
  approvedAt      DateTime?
  version         Int                      @default(0)
  createdAt       DateTime                 @default(now())
  updatedAt       DateTime                 @updatedAt

  process       SupervisionProcess  @relation(fields: [processId], references: [id], onDelete: Cascade)
  meeting       SupervisionMeeting? @relation(fields: [meetingId], references: [id], onDelete: SetNull)
  createdByUser User?               @relation("SupervisionSummaryCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)
  approvals     SupervisionSummaryApproval[]

  @@index([processId, kind, status])
}

model SupervisionSummaryApproval {
  id              String   @id @default(cuid())
  summaryId       String
  participationId String
  approvedAt      DateTime @default(now())

  summary       SupervisionSummary       @relation(fields: [summaryId], references: [id], onDelete: Cascade)
  participation SupervisionParticipation @relation(fields: [participationId], references: [id], onDelete: Cascade)

  @@unique([summaryId, participationId])
  @@index([summaryId])
}

model SupervisionClosure {
  id              String   @id @default(cuid())
  processId       String   @unique
  closedByUserId  String?
  closedAt        DateTime @default(now())
  factsJson       Json
  purgeReport     Json
  retentionStatus String   @default("AWAITING_POLICY")

  process      SupervisionProcess @relation(fields: [processId], references: [id], onDelete: Cascade)
  closedByUser User?              @relation("SupervisionClosureClosedBy", fields: [closedByUserId], references: [id], onDelete: SetNull)
}

model SupervisionPersonalOutcome {
  id                      String   @id @default(cuid())
  ownerUserId             String
  processId               String?
  processTitleGeneralized String
  contentJson             Json
  createdAt               DateTime @default(now())

  owner   User                @relation("SupervisionPersonalOutcomeOwner", fields: [ownerUserId], references: [id], onDelete: Cascade)
  process SupervisionProcess? @relation("SupervisionPersonalOutcomeProcess", fields: [processId], references: [id], onDelete: SetNull)

  @@unique([processId, ownerUserId])
  @@index([ownerUserId, createdAt])
}

model SupervisionAuditEvent {
  id          String   @id @default(cuid())
  processId   String?
  actorUserId String?
  action      String
  targetKind  String?
  targetId    String?
  metadata    Json?
  createdAt   DateTime @default(now())

  process SupervisionProcess? @relation(fields: [processId], references: [id], onDelete: Cascade)
  actor   User?               @relation("SupervisionAuditActor", fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([processId, createdAt])
  @@index([actorUserId, createdAt])
}

// ===========================================================================
// Mentorlus (ESTA-MENTOR-V1, EM1–EM8). Kõik olekud on rakenduskihi konstandid
// (lib/mentoring/constants.js), MITTE PostgreSQL enum'id. Osalised
// unikaalindeksid (1 PENDING taotlus paari kohta; 1 mitte-CLOSED suhe suuna
// kohta) elavad raw-SQL migratsioonis, mitte siin.
// ===========================================================================

// EM1 — mentoriprofiil. SELF-profiil kuulub kasutajale (userId täidetud);
// EXTERNAL_REFERENCE (origin=ESTA_IMPORT, userId=null) on admin-hallatav viide
// välisele avalikule profiilile. publicContact on ADMIN-ONLY väli — see ei tohi
// sisalduda üheski mitte-admin serializeris.
model MentorProfile {
  id                    String    @id @default(cuid())
  userId                String?   @unique
  origin                String    @default("SELF")
  status                String    @default("DRAFT")
  consentStatus         String?
  displayName           String
  title                 String?
  organization          String?
  fields                String[]  @default([])
  topics                String[]  @default([])
  languages             String[]  @default([])
  formats               String[]  @default([])
  bioShort              String?   @db.Text
  bioFull               String?   @db.Text
  experienceSummary     String?   @db.Text
  capacity              String    @default("OPEN")
  externalProfileUrl    String?
  externalSlug          String?   @unique
  publicContact         Json?
  contactDisplayAllowed Boolean   @default(false)
  checkedAt             DateTime?
  consentNote           String?   @db.Text
  reviewedByUserId      String?
  reviewedAt            DateTime?
  reviewReasonKey       String?
  version               Int       @default(0)
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  user       User? @relation("MentorProfileUser", fields: [userId], references: [id], onDelete: Cascade)
  reviewedBy User? @relation("MentorProfileReviewer", fields: [reviewedByUserId], references: [id], onDelete: SetNull)
  requests   MentoringRequest[]

  @@index([status, updatedAt])
  @@index([origin, consentStatus])
}

// EM2 — mentorlustaotlus. message anonümiseeritakse 90p pärast terminaalset
// olekut (sweep); faktirida jääb.
model MentoringRequest {
  id              String    @id @default(cuid())
  menteeId        String
  mentorProfileId String
  mentorUserId    String
  message         String?   @db.Text
  status          String    @default("PENDING")
  expiresAt       DateTime
  respondedAt     DateTime?
  cancelledAt     DateTime?
  anonymizedAt    DateTime?
  version         Int       @default(0)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  mentee        User          @relation("MentoringRequestMentee", fields: [menteeId], references: [id], onDelete: Cascade)
  mentorUser    User          @relation("MentoringRequestMentorUser", fields: [mentorUserId], references: [id], onDelete: Cascade)
  mentorProfile MentorProfile @relation(fields: [mentorProfileId], references: [id], onDelete: Cascade)
  relation      MentoringRelation?

  @@index([mentorUserId, status, updatedAt])
  @@index([menteeId, status, updatedAt])
  @@index([status, expiresAt])
}

// EM3 — mentorlussuhe. Poolte FK-d on SetNull: konto kustutamisel jääb teisele
// poolele faktikiri + kinnitatud kandjad märkega "autor kustutatud" (K1 4.5).
model MentoringRelation {
  id                String    @id @default(cuid())
  mentorUserId      String?
  menteeUserId      String?
  requestId         String?   @unique
  status            String    @default("DRAFT")
  goalSummary       String?   @db.Text
  agreementText     String?   @db.Text
  agreementVersion  Int       @default(0)
  pausedAt          DateTime?
  closedAt          DateTime?
  closedByUserId    String?
  closeReasonKey    String?
  purgedAt          DateTime?
  inactivityCheckAt DateTime?
  lastActivityAt    DateTime  @default(now())
  version           Int       @default(0)
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  mentorUser User? @relation("MentoringRelationMentor", fields: [mentorUserId], references: [id], onDelete: SetNull)
  menteeUser User? @relation("MentoringRelationMentee", fields: [menteeUserId], references: [id], onDelete: SetNull)
  closedBy   User? @relation("MentoringRelationClosedBy", fields: [closedByUserId], references: [id], onDelete: SetNull)
  request    MentoringRequest? @relation(fields: [requestId], references: [id], onDelete: SetNull)

  agreementAcceptances MentoringAgreementAcceptance[]
  meetings             MentoringMeeting[]
  summaries            MentoringSummary[]

  @@index([mentorUserId, status, updatedAt])
  @@index([menteeUserId, status, updatedAt])
  @@index([status, lastActivityAt])
}

// EM4 — kokkuleppekinnitus (versioonipõhine; FrameworkAcceptance muster).
// textSnapshot on kinnitushetke tekst (RUUM-A0 5 K4: snapshot kasutaja keeles).
model MentoringAgreementAcceptance {
  id               String   @id @default(cuid())
  relationId       String
  userId           String?
  agreementVersion Int
  textSnapshot     String   @db.Text
  locale           String   @default("et")
  acceptedAt       DateTime @default(now())

  relation MentoringRelation @relation(fields: [relationId], references: [id], onDelete: Cascade)
  user     User?             @relation("MentoringAgreementAcceptanceUser", fields: [userId], references: [id], onDelete: SetNull)

  @@unique([relationId, userId, agreementVersion])
  @@index([relationId, agreementVersion])
}

// EM5 — kohtumine (faktikirje; roomId on viide, MITTE omandus — SetNull).
// Kustutamist ei ole; vale kirje parandatakse muutmisega.
model MentoringMeeting {
  id              String    @id @default(cuid())
  relationId      String
  occurredAt      DateTime
  mode            String    @default("EXTERNAL")
  roomId          String?
  topicSummary    String?   @db.Text
  status          String    @default("PLANNED")
  createdByUserId String?
  version         Int       @default(0)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  relation  MentoringRelation @relation(fields: [relationId], references: [id], onDelete: Cascade)
  room      Room?             @relation("MentoringMeetingRoom", fields: [roomId], references: [id], onDelete: SetNull)
  createdBy User?             @relation("MentoringMeetingCreator", fields: [createdByUserId], references: [id], onDelete: SetNull)
  summaries MentoringSummary[]

  @@index([relationId, occurredAt])
  @@index([status, occurredAt])
}

// EM6 — kokkuvõte. CONFIRMED on külmutatud klass-2 kandja; parandus = uus
// versioon supersedes-viitega. DRAFT/PENDING_CONFIRM purge'itakse sulgemisel.
model MentoringSummary {
  id              String    @id @default(cuid())
  relationId      String
  meetingId       String?
  kind            String    @default("MEETING")
  content         String    @db.Text
  status          String    @default("DRAFT")
  supersededById  String?
  createdByUserId String?
  confirmedAt     DateTime?
  version         Int       @default(0)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  relation     MentoringRelation  @relation(fields: [relationId], references: [id], onDelete: Cascade)
  meeting      MentoringMeeting?  @relation(fields: [meetingId], references: [id], onDelete: SetNull)
  supersededBy MentoringSummary?  @relation("MentoringSummarySupersedes", fields: [supersededById], references: [id], onDelete: SetNull)
  supersedes   MentoringSummary[] @relation("MentoringSummarySupersedes")
  createdBy    User?              @relation("MentoringSummaryCreator", fields: [createdByUserId], references: [id], onDelete: SetNull)
  confirmations MentoringSummaryConfirmation[]

  @@index([relationId, status, updatedAt])
}

// EM6b — kokkuvõtte kahepoolne kinnitus (append-only tõendikirjed).
model MentoringSummaryConfirmation {
  id          String   @id @default(cuid())
  summaryId   String
  userId      String?
  confirmedAt DateTime @default(now())

  summary MentoringSummary @relation(fields: [summaryId], references: [id], onDelete: Cascade)
  user    User?            @relation("MentoringSummaryConfirmationUser", fields: [userId], references: [id], onDelete: SetNull)

  @@unique([summaryId, userId])
}

// EM7 — privaatmärge / mentee ettevalmistus. AINULT omanik näeb sisu (content).
// kind=PREPARATION kirjel: sourceDraftId seob Tööheaolu mustandiga (unique =
// topelt-handoff'i tõke); jagamine külmutab sharedContent'i; recall on lubatud
// ainult enne openedByOtherAt'i. Suhte sulgemine EI puuduta sisu; märge jääb
// omanikule ka pärast suhte lõppu.
model MentoringPrivateNote {
  id              String    @id @default(cuid())
  ownerId         String
  relationId      String?
  kind            String    @default("NOTE")
  content         String    @db.Text
  sourceDraftId   String?   @unique
  sharedContent   String?   @db.Text
  sharedAt        DateTime?
  openedByOtherAt DateTime?
  recalledAt      DateTime?
  version         Int       @default(0)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  owner User @relation("MentoringPrivateNoteOwner", fields: [ownerId], references: [id], onDelete: Cascade)

  @@index([ownerId, relationId, updatedAt])
  @@index([relationId, sharedAt])
}

// EM8 — auditisündmus (append-only; actor SetNull; meta AINULT koodid/ID-d,
// vabatekst keelatud). Mentorlusobjektidele FK-sid EI ole — audit elab
// purge/kustutuse üle.
model MentoringAuditEvent {
  id          String   @id @default(cuid())
  action      String
  actorUserId String?
  profileId   String?
  relationId  String?
  requestId   String?
  summaryId   String?
  meta        Json?
  createdAt   DateTime @default(now())

  actor User? @relation("MentoringAuditActor", fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([profileId, createdAt])
  @@index([relationId, createdAt])
  @@index([action, createdAt])
}

// ---------------------------------------------------------------------------
// T25 ORG-FOUNDATION-V1 (viil A) — KOV-i ja teenuseosutaja organisatsioonikiht.
//
// PIIR, mida ei tohi hägustada: need mudelid EI OLE seotud `OrganizationAdmin`
// ega `MunicipalityKovAdmin` mudelitega. Need kaks on RAG-allikate
// haldusregistrid; `OrganizationAdminFile.organizationId` viitab
// `OrganizationAdmin`-ile, MITTE siinsele `Organization`-ile. Iga uus
// `organizationId` selles plokis tähendab ainult `Organization.id`.
//
// Organisatsiooniõigus EI asenda ühegi olemasoleva objekti owner-/participant-
// kontrolli. Siin ei ole ühtegi viidet `WellbeingRecord`-ile, `Conversation`-ile,
// `Journey`-le, `UserDocument`-ile, supervisioonile ega mentorlusele — see on
// invariant, mitte tegemata töö (arenduskava §4, §D8).
//
// Enumitesse on teadlikult lisatud AINULT CORE-V1 viilu A väärtused. Postgres
// ei võimalda enum-väärtust hiljem lihtsalt eemaldada, seega „reserveeritud"
// capability'd (AGGREGATE_VIEWER, REPORT_APPROVER, SCHEDULER,
// ON_CALL_COORDINATOR) ja moodulid (WELLBEING_AGGREGATE, ON_CALL) lisab see
// viil, mis nad päriselt kasutusele võtab (`ALTER TYPE ... ADD VALUE`).
// ---------------------------------------------------------------------------

enum OrganizationLegalKind {
  MUNICIPALITY
  PUBLIC_AGENCY
  COMPANY
  NGO
  FOUNDATION
  SOLE_PROPRIETOR
  OTHER
}

enum OrganizationStatus {
  DRAFT
  PENDING_VERIFICATION
  ACTIVE
  SUSPENDED
  ARCHIVED
}

enum OrganizationModuleKey {
  KOV_INTAKE
  SERVICE_DELIVERY
  PROFESSIONAL_SUPPORT
  ORG_KNOWLEDGE
}

enum OrganizationModuleStatus {
  DRAFT
  ACTIVE
  SUSPENDED
}

enum OrganizationUnitType {
  DEPARTMENT
  TEAM
  SERVICE_LOCATION
  OTHER
}

enum OrganizationUnitStatus {
  ACTIVE
  ARCHIVED
}

enum OrganizationMembershipStatus {
  ACTIVE
  SUSPENDED
  ENDED
}

// TEADLIKULT ilma `CLIENT`-ita (arenduskava §D6, otsus O-E0-1): pöörduja
// sponsoreeritud ligipääs ei ole töötajakoht ega organisatsiooniliikmesus.
enum OrganizationSeatRole {
  SOCIAL_WORKER
  SERVICE_PROVIDER
}

enum OrganizationCapability {
  ORG_OWNER
  MEMBER_ADMIN
  UNIT_LEAD
  INBOX_COORDINATOR
  WORK_ASSIGNER
  SERVICE_PROFILE_EDITOR
  SUPPORT_CONTACT_ADMIN
  BILLING_MANAGER
  AUDIT_VIEWER
}

enum OrganizationCapabilityScopeType {
  ORGANIZATION
  UNIT
}

enum OrganizationInviteStatus {
  PENDING
  ACCEPTED
  DECLINED
  REVOKED
  EXPIRED
}

model Organization {
  id               String                @id @default(cuid())
  displayName      String
  legalName        String?
  registryCode     String?
  legalKind        OrganizationLegalKind
  municipalityId   String?
  status           OrganizationStatus    @default(DRAFT)
  defaultLocale    String                @default("et")
  timezone         String                @default("Europe/Tallinn")
  createdByUserId  String?
  verifiedAt       DateTime?
  verifiedByUserId String?
  verificationNote String?
  activatedAt      DateTime?
  suspendedAt      DateTime?
  suspendedReason  String?
  archivedAt       DateTime?
  archivedReason   String?
  createdAt        DateTime              @default(now())
  updatedAt        DateTime              @updatedAt

  // SetNull kõikjal: konto kustutamine ei tohi organisatsiooni kaotada ega
  // blokeeruda (arenduskava §E10 „konto jääb alles", GDPR-kustutusrada).
  municipality Municipality? @relation(fields: [municipalityId], references: [id], onDelete: SetNull)
  createdBy    User?         @relation("OrganizationCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)
  verifiedBy   User?         @relation("OrganizationVerifiedBy", fields: [verifiedByUserId], references: [id], onDelete: SetNull)

  modules     OrganizationModule[]
  units       OrganizationUnit[]
  memberships OrganizationMembership[]
  invites     OrganizationInvite[]
  // T25 viil B
  seatPlans              OrganizationSeatPlan[]
  inboxItems             OrganizationInboxItem[]
  clientSponsorships     OrganizationClientSponsorship[]
  // T25 viil C
  supportContacts        OrganizationSupportContact[]
  supportShares          WellbeingSupportShare[]
  serviceProviderProfile ServiceProviderProfile?
  preInquiries           PreInquiry[]                   @relation("PreInquiryRecipientOrganization")
  sponsoredSubscriptions Subscription[]                 @relation("SubscriptionSponsorOrganization")

  @@index([status])
  @@index([legalKind])
  @@index([municipalityId])
  @@index([createdByUserId])
  @@index([registryCode])
  serviceReportShares ServiceReportShare[]
}

model OrganizationModule {
  id                String                   @id @default(cuid())
  organizationId    String
  moduleKey         OrganizationModuleKey
  status            OrganizationModuleStatus @default(DRAFT)
  validFrom         DateTime                 @default(now())
  validUntil        DateTime?
  activatedByUserId String?
  reason            String?
  createdAt         DateTime                 @default(now())
  updatedAt         DateTime                 @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  activatedBy  User?        @relation("OrganizationModuleActivatedBy", fields: [activatedByUserId], references: [id], onDelete: SetNull)

  // Üks AKTIIVNE moodul organisatsiooni + moodulivõtme kohta on osaline
  // unikaalsus → raw-SQL indeks migratsioonis, mitte @@unique siin.
  @@index([organizationId, status])
  @@index([moduleKey, status])
}

model OrganizationUnit {
  id             String                 @id @default(cuid())
  organizationId String
  parentUnitId   String?
  type           OrganizationUnitType   @default(TEAM)
  name           String
  status         OrganizationUnitStatus @default(ACTIVE)
  sortOrder      Int                    @default(0)
  // Juuretasand = 1, maksimaalne toetatud sügavus V1-s = 3 (arenduskava §5.2).
  // Salvestatud, et sügavuskontroll ei nõuaks rekursiivset päringut igal kirjutusel.
  depth          Int                    @default(1)
  archivedAt     DateTime?
  createdAt      DateTime               @default(now())
  updatedAt      DateTime               @updatedAt

  organization Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  // Restrict: alamüksusega üksust ei saa vaikselt ära kustutada.
  parentUnit   OrganizationUnit? @relation("OrganizationUnitTree", fields: [parentUnitId], references: [id], onDelete: Restrict)

  childUnits       OrganizationUnit[]            @relation("OrganizationUnitTree")
  membershipUnits  OrganizationMembershipUnit[]
  capabilityGrants OrganizationCapabilityGrant[]
  invites          OrganizationInvite[]
  inboxItems       OrganizationInboxItem[]
  supportContacts  OrganizationSupportContact[]

  @@index([organizationId, status, sortOrder])
  @@index([organizationId, parentUnitId])
  @@index([parentUnitId])
}

model OrganizationMembership {
  id              String                       @id @default(cuid())
  organizationId  String
  userId          String
  status          OrganizationMembershipStatus @default(ACTIVE)
  seatRole        OrganizationSeatRole
  jobTitle        String?
  startedAt       DateTime                     @default(now())
  endedAt         DateTime?
  endedReason     String?
  invitedByUserId String?
  createdAt       DateTime                     @default(now())
  updatedAt       DateTime                     @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User         @relation("OrganizationMembershipUser", fields: [userId], references: [id], onDelete: Cascade)
  invitedBy    User?        @relation("OrganizationMembershipInvitedBy", fields: [invitedByUserId], references: [id], onDelete: SetNull)

  units            OrganizationMembershipUnit[]
  capabilityGrants OrganizationCapabilityGrant[]
  // T25 viil B
  seatAssignments  OrganizationSeatAssignment[]
  workAssignments  OrganizationWorkAssignment[] @relation("OrganizationWorkAssignmentAssignee")
  serviceReportShares ServiceReportShare[]         @relation("ServiceReportShareRecipient")
  // T25 viil C
  reportingAsMember   OrganizationReportingLine[]  @relation("OrganizationReportingMember")
  reportingAsManager  OrganizationReportingLine[]  @relation("OrganizationReportingManager")
  supportContacts     OrganizationSupportContact[]
  receivedSupportShares WellbeingSupportShare[]    @relation("WellbeingSupportShareRecipient")

  // Üks AKTIIVNE liikmesus org + kasutaja kohta → osaline unikaalindeks migratsioonis.
  @@index([organizationId, status])
  @@index([userId, status])
  @@index([organizationId, seatRole, status])
}

model OrganizationMembershipUnit {
  id           String    @id @default(cuid())
  membershipId String
  unitId       String
  isPrimary    Boolean   @default(false)
  startedAt    DateTime  @default(now())
  endedAt      DateTime?
  createdAt    DateTime  @default(now())

  membership OrganizationMembership @relation(fields: [membershipId], references: [id], onDelete: Cascade)
  unit       OrganizationUnit       @relation(fields: [unitId], references: [id], onDelete: Cascade)

  // Üks aktiivne põhiüksus liikmesuse kohta ja üks aktiivne rida
  // (membership, unit) kohta → osalised unikaalindeksid migratsioonis.
  // Üksuse vahetus lõpetab vana rea (`endedAt`), ei kustuta ajalugu.
  @@index([membershipId, endedAt])
  @@index([unitId, endedAt])
}

model OrganizationCapabilityGrant {
  id              String                          @id @default(cuid())
  membershipId    String
  capability      OrganizationCapability
  scopeType       OrganizationCapabilityScopeType @default(ORGANIZATION)
  scopeUnitId     String?
  validFrom       DateTime                        @default(now())
  validUntil      DateTime?
  revokedAt       DateTime?
  revokedByUserId String?
  grantedByUserId String?
  reason          String?
  createdAt       DateTime                        @default(now())
  updatedAt       DateTime                        @updatedAt

  membership OrganizationMembership @relation(fields: [membershipId], references: [id], onDelete: Cascade)
  /* Cascade, MITTE Restrict: tavakäigus üksust ei kustutata (ta arhiveeritakse
     ja arhiveerimine on `archiveUnit` väravate taga). Restrict blokeeriks aga
     organisatsiooni PÄRIS kustutamise — org → üksus kaskaad jääks grandi taha
     kinni ja ükski andmekustutuse rada ei töötaks. Üksuseta üksuse-skoop on
     niikuinii mõttetu. */
  scopeUnit  OrganizationUnit?      @relation(fields: [scopeUnitId], references: [id], onDelete: Cascade)
  grantedBy  User?                  @relation("OrganizationCapabilityGrantedBy", fields: [grantedByUserId], references: [id], onDelete: SetNull)
  revokedBy  User?                  @relation("OrganizationCapabilityRevokedBy", fields: [revokedByUserId], references: [id], onDelete: SetNull)

  // XOR scopeType/scopeUnitId on DB CHECK migratsioonis: UNIT nõuab üksust,
  // ORGANIZATION keelab selle. Prisma skeemikeel seda ei väljenda.
  @@index([membershipId, revokedAt])
  @@index([capability, revokedAt])
  @@index([scopeUnitId, revokedAt])
}

model OrganizationInvite {
  id                 String                   @id @default(cuid())
  organizationId     String
  email              String
  tokenHash          String                   @unique
  status             OrganizationInviteStatus @default(PENDING)
  seatRole           OrganizationSeatRole
  primaryUnitId      String?
  capabilityTemplate String?
  jobTitle           String?
  invitedByUserId    String?
  expiresAt          DateTime
  acceptedAt         DateTime?
  acceptedByUserId   String?
  declinedAt         DateTime?
  revokedAt          DateTime?
  revokedByUserId    String?
  createdAt          DateTime                 @default(now())
  updatedAt          DateTime                 @updatedAt

  organization Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  primaryUnit  OrganizationUnit? @relation(fields: [primaryUnitId], references: [id], onDelete: SetNull)
  invitedBy    User?             @relation("OrganizationInviteInvitedBy", fields: [invitedByUserId], references: [id], onDelete: SetNull)
  acceptedBy   User?             @relation("OrganizationInviteAcceptedBy", fields: [acceptedByUserId], references: [id], onDelete: SetNull)

  // Üks PENDING kutse org + e-posti (lower) kohta → osaline unikaalindeks migratsioonis.
  @@index([organizationId, status])
  @@index([email, status])
  @@index([expiresAt])
}

// ---------------------------------------------------------------------------
// T25 ORG-FUNDING-INBOX-V1 (viil B) — rahastus ja vastuvõtulaud.
//
// KOLM PIIRI, mis tulevad otse omaniku otsusest O-E0-1 ja arenduskava §D6-st:
//
//   1. `OrganizationSeatPlan.seatRole` on `OrganizationSeatRole` ehk AINULT
//      SOCIAL_WORKER | SERVICE_PROVIDER. Pöörduja koht siin PUUDUB ja ei tule.
//   2. Pöörduja sponsorlus elab eraldi mudelis `OrganizationClientSponsorship`
//      ja EI OLE ruumiga seotud. Olemasolev `Invite` (roomId NOT NULL) jääb
//      puutumata — teda ei muudeta ebamääraseks üldkutseks.
//   3. Sponsoreeritud pöörduja ei saa `OrganizationMembership`-i ega kohta.
//      Ta saab tellimuse, mille maksja on organisatsioon.
//
// HIND on lepinguline SNAPSHOT (`unitPriceCents`), mitte viide jooksvale
// hinnakirjale: hilisem avaliku hinna muutus EI tohi muuta juba sõlmitud
// lepingut (arenduskava §D6, §5.6).
// ---------------------------------------------------------------------------

enum OrganizationSeatPlanSource {
  PILOT
  MANUAL_CONTRACT
  INVOICE
  FUTURE_CHECKOUT
}

enum OrganizationSeatPlanStatus {
  DRAFT
  ACTIVE
  ENDED
}

enum OrganizationSeatAssignmentStatus {
  ACTIVE
  SUSPENDED
  ENDED
}

// V1-s on ainus vastuvõtu allikas eelpöördumine. Enum, mitte vaba string:
// uus allikaliik peab olema teadlik migratsioon, mitte kirjaviga.
enum OrganizationInboxSourceType {
  PRE_INQUIRY
}

enum OrganizationInboxStatus {
  RECEIVED
  REVIEWING
  ASSIGNMENT_PENDING
  ASSIGNED
  ACCEPTED
  CLOSED
  REJECTED
  RECALLED
}

enum OrganizationWorkAssignmentStatus {
  PENDING
  ACCEPTED
  REJECTED
  HANDED_OVER
  ENDED
}

enum OrganizationClientSponsorshipStatus {
  PENDING
  ACCEPTED
  DECLINED
  REVOKED
  EXPIRED
}

model OrganizationSeatPlan {
  id              String                     @id @default(cuid())
  organizationId  String
  seatRole        OrganizationSeatRole
  seatLimit       Int
  unitPriceCents  Int
  currency        String                     @default("EUR")
  billingInterval BillingInterval            @default(MONTHLY)
  source          OrganizationSeatPlanSource @default(MANUAL_CONTRACT)
  // Avalikust hinnast erinev ühikuhind NÕUAB põhjust. Kontroll on ka
  // teenusekihis, aga siin on ta DB CHECK — soodustus ilma jäljeta on
  // auditi auk, mitte mugavus.
  priceReason     String?
  validFrom       DateTime                   @default(now())
  validUntil      DateTime?
  status          OrganizationSeatPlanStatus @default(DRAFT)
  createdByUserId String?
  createdAt       DateTime                   @default(now())
  updatedAt       DateTime                   @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdBy    User?        @relation("OrganizationSeatPlanCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)

  assignments OrganizationSeatAssignment[]

  // Üks AKTIIVNE plaan org + koharolli kohta → osaline unikaalindeks migratsioonis.
  @@index([organizationId, status])
  @@index([seatRole, status])
}

model OrganizationSeatAssignment {
  id               String                           @id @default(cuid())
  seatPlanId       String
  membershipId     String
  status           OrganizationSeatAssignmentStatus @default(ACTIVE)
  startedAt        DateTime                         @default(now())
  endedAt          DateTime?
  endedReason      String?
  assignedByUserId String?
  createdAt        DateTime                         @default(now())
  updatedAt        DateTime                         @updatedAt

  seatPlan   OrganizationSeatPlan   @relation(fields: [seatPlanId], references: [id], onDelete: Cascade)
  membership OrganizationMembership @relation(fields: [membershipId], references: [id], onDelete: Cascade)
  assignedBy User?                  @relation("OrganizationSeatAssignedBy", fields: [assignedByUserId], references: [id], onDelete: SetNull)

  // Üks AKTIIVNE koht liikmesuse kohta → osaline unikaalindeks migratsioonis.
  // Kohti EI "stack'ita" kvoodi korrutamiseks (arenduskava §5.6).
  @@index([seatPlanId, status])
  @@index([membershipId, status])
}

model OrganizationInboxItem {
  id                      String                      @id @default(cuid())
  organizationId          String
  unitId                  String?
  sourceType              OrganizationInboxSourceType
  sourceId                String
  status                  OrganizationInboxStatus     @default(RECEIVED)
  receivedAt              DateTime                    @default(now())
  lastTransitionAt        DateTime                    @default(now())
  dueAt                   DateTime?
  // Saatja OMA märge, MITTE AI triaaž (arenduskava §5.7; §13 jätab
  // "AI automaatne triaaž, sobivus-, riski- või kvaliteediotsus" ulatusest välja).
  urgencyDeclaredBySender String?
  closedAt                DateTime?
  closedReason            String?
  createdAt               DateTime                    @default(now())
  updatedAt               DateTime                    @updatedAt

  organization Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  unit         OrganizationUnit? @relation(fields: [unitId], references: [id], onDelete: SetNull)

  assignments OrganizationWorkAssignment[]

  // Postkastikirje EI DUBLEERI lähteobjekti sisu — ta kannab ainult viidet ja
  // seisu. Sisu loetakse alati lähteobjektist, saatja kinnitatud ulatuses.
  @@unique([organizationId, sourceType, sourceId])
  @@index([organizationId, status, receivedAt])
  @@index([unitId, status])
  @@index([sourceType, sourceId])
}

model OrganizationWorkAssignment {
  id                     String                           @id @default(cuid())
  inboxItemId            String
  assigneeMembershipId   String
  status                 OrganizationWorkAssignmentStatus @default(PENDING)
  assignedByUserId       String?
  assignedAt             DateTime                         @default(now())
  acceptedAt             DateTime?
  rejectedAt             DateTime?
  rejectedReason         String?
  endedAt                DateTime?
  // Üleandmine on UUS määramine, mis viitab eelmisele — mitte vaikne
  // ownerId ülekirjutus (arenduskava §5.7). Ajalugu säilib.
  supersedesAssignmentId String?                          @unique
  createdAt              DateTime                         @default(now())
  updatedAt              DateTime                         @updatedAt

  inboxItem  OrganizationInboxItem  @relation(fields: [inboxItemId], references: [id], onDelete: Cascade)
  // Restrict: määratud töötaja liikmesust ei saa vaikselt ära kustutada nii,
  // et töö jääks omanikuta. Offboarding peab töö enne üle andma.
  assignee   OrganizationMembership @relation("OrganizationWorkAssignmentAssignee", fields: [assigneeMembershipId], references: [id], onDelete: Restrict)
  assignedBy User?                  @relation("OrganizationWorkAssignedBy", fields: [assignedByUserId], references: [id], onDelete: SetNull)

  supersedes   OrganizationWorkAssignment? @relation("OrganizationWorkAssignmentHandover", fields: [supersedesAssignmentId], references: [id], onDelete: SetNull)
  supersededBy OrganizationWorkAssignment? @relation("OrganizationWorkAssignmentHandover")

  // Üks ELAV määramine töö kohta → osaline unikaalindeks migratsioonis.
  @@index([inboxItemId, status])
  @@index([assigneeMembershipId, status])
}

/// Pöörduja organisatsioonipoolne sponsorlus — RUUMIST SÕLTUMATU (otsus O-E0-1).
///
/// MIKS EI SAA KASUTADA `Invite`-i: `Invite.roomId` on NOT NULL ja Cascade, mis
/// tähendaks, et 200 elanikku sponsoreeriv KOV peaks looma 200 ruumi. Ja
/// `Invite.sponsoredByOrgId` oli surnud veerg — `resolveSponsor()` tagastas alati
/// `null` (E0 leiud L2/L3).
///
/// MIDA SEE EI TEE: ei loo `OrganizationMembership`-i, ei anna ühtegi
/// organisatsioonivaate õigust, ei kasuta `OrganizationSeatPlan`-i. Pöörduja
/// saab tellimuse, mille maksja on organisatsioon — ja mitte midagi muud.
model OrganizationClientSponsorship {
  id               String                              @id @default(cuid())
  organizationId   String
  email            String
  tokenHash        String                              @unique
  status           OrganizationClientSponsorshipStatus @default(PENDING)
  // Hinnasnapshot: vaikimisi CLIENT 7,99 EUR, lepinguline hind eraldi põhjusega.
  unitPriceCents   Int
  currency         String                              @default("EUR")
  priceReason      String?
  invitedByUserId  String?
  expiresAt        DateTime
  acceptedAt       DateTime?
  acceptedByUserId String?
  declinedAt       DateTime?
  revokedAt        DateTime?
  revokedByUserId  String?
  createdAt        DateTime                            @default(now())
  updatedAt        DateTime                            @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  invitedBy    User?        @relation("OrgClientSponsorshipInvitedBy", fields: [invitedByUserId], references: [id], onDelete: SetNull)
  acceptedBy   User?        @relation("OrgClientSponsorshipAcceptedBy", fields: [acceptedByUserId], references: [id], onDelete: SetNull)

  subscriptions Subscription[] @relation("SubscriptionOrgSponsorship")

  // Üks PENDING sponsorlus org + e-posti (lower) kohta → osaline unikaalindeks.
  @@index([organizationId, status])
  @@index([email, status])
  @@index([expiresAt])
}

// ---------------------------------------------------------------------------
// T25 ORG-PROFILE-SUPPORT-V1 (viil C) — teenuseprofiil ja tööheaolu toe tarne.
//
// SELLE VIILU KANDEV PIIR (arenduskava §D8): tööheaolu LÄHTEKIRJE ei muutu
// kunagi organisatsiooni varaks. `WellbeingRecord` ei saa siin ega kunagi
// `organizationId` võtit ega juhi nähtavust — seda kontrollib test.
//
// Jagatav on AINULT kasutaja enda kinnitatud SNAPSHOT (`sharedSnapshotJson`),
// mitte viide lähtekirjele. Saaja päring ei tohi kunagi jõuda `WellbeingRecord`
// või `WellbeingOutputDraft` tabelini — seepärast ei ole `sourceDraftId` FK,
// vaid VIIDE ILMA referentsiaalse seoseta (sama muster mis
// `PracticeReflection.sourceKind/sourceId`).
// ---------------------------------------------------------------------------

enum OrganizationSupportContactType {
  DIRECT_MANAGER
  ALTERNATE_SUPPORT
  SAFETY_CONTACT
}

enum WellbeingSupportShareStatus {
  SENT
  OPENED
  RECALLED
  CORRECTED
  CLOSED
}

enum ServiceProviderOwnershipMode {
  SOLO
  ORGANIZATION
}

/// Otsese juhi seos. EI ANNA SISUÕIGUSI (arenduskava §5.4) — ta on ainult
/// vaikeadressaat toeavalduse saatmisel ja töötaja võib valida ka alternatiivse
/// tugikontakti. Seost ei tohi kasutada üheski capability-kontrollis.
model OrganizationReportingLine {
  id                  String    @id @default(cuid())
  memberMembershipId  String
  managerMembershipId String
  validFrom           DateTime  @default(now())
  validUntil          DateTime?
  createdByUserId     String?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  member    OrganizationMembership @relation("OrganizationReportingMember", fields: [memberMembershipId], references: [id], onDelete: Cascade)
  manager   OrganizationMembership @relation("OrganizationReportingManager", fields: [managerMembershipId], references: [id], onDelete: Cascade)
  createdBy User?                  @relation("OrganizationReportingCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)

  // Üks kehtiv juhiseos liikme kohta + „mõlemad sama organisatsiooni aktiivsed
  // liikmesused" on osaline unikaalindeks ja teenusekihi invariant.
  @@index([memberMembershipId, validUntil])
  @@index([managerMembershipId, validUntil])
}

/// Organisatsiooni tugikontaktid. Arenduskava §5.8 nõuab, et professionaalse
/// toe mooduli aktiveerimisel oleks VÄHEMALT ÜKS alternatiivne tugitee —
/// töötaja ei tohi olla sunnitud pöörduma just oma otsese juhi poole.
model OrganizationSupportContact {
  id              String                          @id @default(cuid())
  organizationId  String
  unitId          String?
  membershipId    String
  contactType     OrganizationSupportContactType
  validFrom       DateTime                        @default(now())
  validUntil      DateTime?
  createdByUserId String?
  createdAt       DateTime                        @default(now())
  updatedAt       DateTime                        @updatedAt

  organization Organization           @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  unit         OrganizationUnit?      @relation(fields: [unitId], references: [id], onDelete: SetNull)
  membership   OrganizationMembership @relation(fields: [membershipId], references: [id], onDelete: Cascade)
  createdBy    User?                  @relation("OrganizationSupportContactCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)

  supportShares WellbeingSupportShare[]

  @@index([organizationId, contactType, validUntil])
  @@index([unitId, validUntil])
  @@index([membershipId, validUntil])
}

/// Tööheaolu toeavaldus — kasutaja ALGATATUD, kasutaja KINNITATUD, ühele
/// valitud saajale.
///
/// MIDA SEE MUDEL EI TEE:
///   - ei viita `WellbeingRecord`-ile ega `WellbeingOutputDraft`-ile FK-ga;
///   - ei anna organisatsioonile vormi KASUTAMISE fakti (org näeb ainult talle
///     saadetud avaldusi, mitte seda, et keegi vormi täitis);
///   - ei tekita automaatset teavitust kriisisignaali korral (§D8).
///
/// `sharedSnapshotJson` on külmutatud koopia: hilisem lähtekirje muutmine või
/// kustutamine EI muuda seda, mida saaja juba nägi.
model WellbeingSupportShare {
  id                     String                      @id @default(cuid())
  ownerUserId            String
  organizationId         String
  recipientMembershipId  String
  supportContactId       String?
  /// VIIDE ILMA FK-ta ja TEADLIKULT: see on omaniku ja auditi sisekasutuseks.
  /// Saaja päring ei tohi kunagi selle kaudu lähtekirjeni jõuda.
  sourceDraftId          String?
  sourceRecordId         String?
  /// Kasutaja kinnitatud minimaalne jagatav koopia. Külmutatud.
  sharedSnapshotJson     Json
  snapshotSchemaVersion  String                      @default("1.0")
  status                 WellbeingSupportShareStatus @default(SENT)
  sentAt                 DateTime                    @default(now())
  openedAt               DateTime?
  recalledAt             DateTime?
  correctedAt            DateTime?
  closedAt               DateTime?
  /// Parandus on UUS avaldus, mis viitab parandatavale — ajalugu ei kirjutata
  /// vaikselt ümber (sama muster mis `WellbeingRecord.supersedesRecordId`).
  supersedesShareId      String?                     @unique
  createdAt              DateTime                    @default(now())
  updatedAt              DateTime                    @updatedAt

  owner          User                        @relation("WellbeingSupportShareOwner", fields: [ownerUserId], references: [id], onDelete: Cascade)
  organization   Organization                @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  recipient      OrganizationMembership      @relation("WellbeingSupportShareRecipient", fields: [recipientMembershipId], references: [id], onDelete: Cascade)
  supportContact OrganizationSupportContact? @relation(fields: [supportContactId], references: [id], onDelete: SetNull)

  supersedes   WellbeingSupportShare? @relation("WellbeingSupportShareCorrection", fields: [supersedesShareId], references: [id], onDelete: SetNull)
  supersededBy WellbeingSupportShare? @relation("WellbeingSupportShareCorrection")

  @@index([ownerUserId, sentAt])
  @@index([recipientMembershipId, status, sentAt])
  @@index([organizationId, status])
}

/* ============================================================================
   TEENUSPÄEVIK-V1 — E1 andmemudel.
   Leping: `docs/platvormi arendus/aruandlus-teenuskirje-disain.md` ptk 8.1.

   ÜKS AATOM, NELI VÄLJUNDIT (leping ptk 1a). Aruandlus ei ole igale teenusele
   eri funktsioon: muutumatu tuum on alati sama (klient + teenus + millal +
   ühik×kogus + kelle poolt) ja varieeruvad ainult parameetrid. Seepärast on
   siin kolm mudelit, mitte KOV-i või teenuse kaupa eraldi tabelid — mallid A–D
   loevad kõik SAMA kirjet.

   K1 REEGEL: elutsükkel, päritolu ja ühikud elavad rakenduskihis, MITTE
   PostgreSQL-i enum'ina. Seepärast on `unit`, `status`, `allocationPeriod` ja
   `noteProvenance` String. Päritoluväärtuste AINUS sõnastik on
   `lib/workspaces/provenance.js` — siia teist koopiat ei teki.

   SÄILITUS ON SIIN TEISTSUGUNE KUI MUJAL PLATVORMIL (leping ptk 5.1 ja 8.9).
   Teenuskirje on arve alusdokument → raamatupidamise seaduse 7-aastane
   säilitus. Kolm tagajärge, mis on skeemis nähtavad:

   (a) `retentionClass` vaikeväärtus on "accounting7y", mitte platvormi tavaline
       "standard90" (vrd `FieldVisit`). Hard-delete keeld <7a elab teenuskihis,
       aga klass on kirje küljes juba sünnihetkest — nii ei sõltu säilitus
       sellest, kas mõni hilisem koristaja mäletab erandit.

   (b) INIMESE VIITED ON `SetNull` + `...ErasedAt`, MITTE `Cascade`. Konto
       kustutamine kustutab inimese, mitte raamatupidamisdokumendi. Sama muster,
       mis on juba toodangus `PreInquiry.authorErasedAt` juures
       (`lib/privacy/effectivePracticeAccountCleanup.js:154`).

   (c) OSUTAJA PROFIILI SEOS ON `Restrict`. Profiili kustutamine EI TOHI vaikselt
       hävitada 7-aastase säilitusega kirjeid. Leping 8.9 jätab teadlikult
       lahtiseks, kumb lahendus tuleb — anonüümitud säilitus või
       eksport-ja-kustutus. Kuni see otsus on langetamata, ütleb andmebaas „ei"
       valjult, selle asemel et andmed vaikselt kaotada. NB see on TEADLIK
       valik, mitte T25 E0 leiu L-tüüpi õnnetus: seal oli `Restrict`
       dokumenteerimata ja blokeeris ootamatult kaskaadi, siin on ta kirjas ja
       tema avamine on omaniku otsus.

   MINIMEERIMINE (leping ptk 5.3): vähetundlik maht (tunnid) ja tundlik sisu
   (märkmed) on eri väljades, et eksport saaks valida, mis kaasa läheb.
   ========================================================================== */

/// Suunamine — KOV-i suunamisotsus, mis kannab MAHTU. Osutaja peab jälgima
/// jääki, sest üle suunatud mahu ei maksta (leping ptk 1).
model ServiceReferral {
  id                String    @id @default(cuid())
  providerProfileId String
  serviceId         String?
  /// Rahastaja/saaja nimi tekstina. Teadlikult normaliseerimata: rahastaja võib
  /// olla KOV, SKA või Töötukassa — sama aatom, teine saaja (leping ptk 1a).
  kovName           String
  referralNumber    String?
  /// Klient kahel rajal: platvormi kasutaja (avab hiljem E7 digikinnituse) VÕI
  /// väline klient minimeeritud kujul. Väline rada EI dubleeri isikuandmeid
  /// rohkem kui osutaja tänane Excel.
  clientUserId      String?
  clientErasedAt    DateTime?
  clientDisplayName String?
  clientExternalRef String?
  periodStart       DateTime? @db.Date
  periodEnd         DateTime? @db.Date
  /// HOUR | SESSION | DAY | MONTH — ühik erineb teenuseti (leping ptk 1).
  unit              String    @default("HOUR")
  allocatedQuantity Decimal?  @db.Decimal(10, 2)
  /// MONTH | TOTAL — kas maht on kuupõhine või kogu perioodi peale. Ilma selle
  /// väljata ei saa saldot üldse õigesti arvutada (leping ptk 3).
  allocationPeriod  String    @default("MONTH")
  /// Suunamisotsuse eesmärgid. Mall C (sisuaruanne) mõõdab edenemist NENDE
  /// vastu — ilma eesmärkideta ei ole narratiivil tuge.
  goalsText         String?   @db.Text
  status            String    @default("ACTIVE")
  retentionClass    String    @default("accounting7y")
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  providerProfile ServiceProviderProfile  @relation(fields: [providerProfileId], references: [id], onDelete: Restrict)
  service         ServiceProviderService? @relation(fields: [serviceId], references: [id], onDelete: SetNull)
  client          User?                   @relation("ServiceReferralClient", fields: [clientUserId], references: [id], onDelete: SetNull)

  entries    ServiceEntry[]
  narratives ServiceMonthlyNarrative[]

  @@index([providerProfileId, status])
  @@index([providerProfileId, periodStart])
  @@index([clientUserId])
  @@index([serviceId])
  visits ServiceVisit[]
}

/// TEENUSPÄEVIK E8 — aruandlusaja proov (DoD 1 ja 5).
///
/// MIDA SEE MOODAB: kui kaua kulub DOKUMENTEERIMISELE, mitte kui kaua kulub
/// teenusele. „Kirje sisestus alla 30 sekundi" on lubadus, mis peab olema
/// mõõdetud, mitte arvatud — ja ilma baasjooneta ei saa öelda, kas platvorm
/// midagi muutis.
///
/// PROOVIS EI OLE KLIENTI. Ei `clientUserId`-d, ei nime, ei kirje viidet:
/// mõõdetav sündmus on dokumenteerimise akt, mitte inimene, keda teenindati.
/// Sama minimeerimisloogika, mis asukohatemplitel — kogu ainult see, mille
/// otstarve on selge.
///
/// TÖÖTAJA ENDA VAADE. `ownerUserId` on olemas, sest töötaja peab nägema OMA
/// baasjoont; see EI OLE juhi stopper. Ülemuse vaade on org-kihi (E10) küsimus
/// ja nõuab oma otsust — mõõdik ei tohi seda vaikselt ette ära otsustada.
model ServiceLogTimeSample {
  id                String   @id @default(cuid())
  providerProfileId String
  /// Nullable: konto võib kaduda, baasjoon jääb (proov on isikustamata).
  ownerUserId       String?
  /// ENTRY_INPUT | MONTH_REVIEW | EXPORT (rakendustaseme sõnastik, K1 reegel).
  kind              String
  /// Sekundid. `Int`, sest millisekundi täpsus oleks siin võlts täpsus.
  seconds           Int
  recordedAt        DateTime @default(now())

  providerProfile ServiceProviderProfile @relation(fields: [providerProfileId], references: [id], onDelete: Cascade)
  owner           User?                  @relation("ServiceLogTimeSampleOwner", fields: [ownerUserId], references: [id], onDelete: SetNull)

  @@index([providerProfileId, kind, recordedAt])
  @@index([ownerUserId, recordedAt])
}

/// Teenuskirje — aatom, millest kasvavad kõik neli malli. Sünnib seal, kus töö
/// lõpeb (leping ptk 0 kaitsereegel a), mitte õhtul mälu järgi.
model ServiceEntry {
  id                 String    @id @default(cuid())
  providerProfileId  String
  /// Sisestaja. Nullable, sest konto võib kustuda ENNE 7 aasta täitumist —
  /// kirje jääb, inimene kaob (`ownerErasedAt`).
  ownerUserId        String?
  ownerErasedAt      DateTime?
  referralId         String?
  serviceId          String?
  clientUserId       String?
  clientErasedAt     DateTime?
  clientDisplayName  String?
  clientExternalRef  String?
  /// Teenuse KALENDRIPÄEV, mitte ajahetk — seepärast `@db.Date`. Kuuaruande
  /// piir on täpselt see koht, kus ajavööndiga DateTime hakkaks kirjeid vale
  /// kuu alla nihutama.
  date               DateTime  @db.Date
  /// Nelja märke voog (leping E2b): LÄKSIN → KOHAL → LAHKUSIN → TAGASI.
  /// KOHAL–LAHKUSIN annab teenuse kestuse (kogus tuletatakse ise), LÄKSIN–KOHAL
  /// ja LAHKUSIN–TAGASI annavad sõiduaja. LÄKSIN ilma TAGASI-ta tähtajaks on
  /// välitöö turvasignaali käivitus.
  departedForVisitAt DateTime?
  arrivedAt          DateTime?
  leftAt             DateTime?
  returnedAt         DateTime?
  /// ÜHEKORDSED asukohatemplid kinnituse hetkel, mitte jada. Täidetakse AINULT
  /// siis, kui `SERVICE_LOG_LOCATION_STAMP` on sees, ja töötajale on alati
  /// nähtav, mis salvestati.
  ///
  /// PIIR ON PUNKT vs JADA, MITTE „GPS jah/ei". Me KOGUME asukohaandmeid;
  /// proportsionaalsus tuleb sellest, et iga punkt on seotud dokumenteeritud
  /// teenusesündmusega, mitte ajaga. Pidevat asukohajada EI koguta kunagi.
  ///
  /// PARANDATUD: siin seisis varem „distantsi nendest EI arvutata (ptk 6b)".
  /// Leping on selle piiri vahepeal OSALISELT TÜHISTANUD — E12 toob kerge
  /// sõidupäeviku (odomeeter või templipõhine hinnang), mille TÖÖTAJA kinnitab;
  /// töötaja enda kasuks tuletatud km ei ole jälgimine. Pideva jälje keeld JÄÄB.
  locationStamps     Json?
  unit               String    @default("HOUR")
  quantity           Decimal   @db.Decimal(10, 2)
  /// Tegevused teenuse `activityCatalog`-ist (mall B linnukesed).
  activities         String[]  @default([])
  /// Kliendi raha kasutamine (nt poeskäik) — Riigi Teataja koduteenuse kordade
  /// päris nõue. Lülitatakse sisse teenusetüübi kaupa, mitte kõigil.
  moneyAmount        Decimal?  @db.Decimal(10, 2)
  moneyNote          String?
  workerName         String?
  /// LÜHIKE faktimärge = sisuaruande tooraine. Tundlik sisu EI kuulu siia
  /// (leping 8.9 minimeerimine); UI ja ⓘ ütlevad seda kasutajale välja.
  note               String?   @db.Text
  /// Päritolu `lib/workspaces/provenance.js` sõnastikust. Fakti ja tõlgenduse
  /// lahusus on see, mis teeb aruande paremaks kui Wordi-praktika.
  noteProvenance     String?
  /// Kliendi paberil-kinnituse märge (väline klient); E7 digikinnitus on eraldi.
  confirmedManually  Boolean   @default(false)
  confirmedByClientAt DateTime?
  /// DRAFT | FINAL | VOID (rakendustaseme sõnastik, K1 reegel).
  ///
  /// MUSTAND on veel dokument-eelne: teda tohib kustutada, sest ta ei ole
  /// millegi alus. KINNITATUD kirjet ei kustutata ega kirjutata vaikselt üle —
  /// teda parandatakse jälgitavalt (`ServiceEntryCorrection`) või tühistatakse.
  /// See on RPS § 10 nõue: paranduse sisu, põhjus ja aeg peavad olema
  /// jälgitavad.
  status             String    @default("DRAFT")
  finalizedAt        DateTime?
  /// MAJANDUSAASTA, MILLE JOOKSUL KIRJE KIRJENDATI.
  ///
  /// RPS § 12 järgi algab säilitustähtaeg selle majandusaasta LÕPUST, mil
  /// tehing kirjendati — MITTE teenuse osutamise kuupäevast. Vahe ei ole
  /// teoreetiline: teenuse kuupäeva ankruga lubaks kustutamise kuni ligi aasta
  /// liiga vara ja tagantjärele sisestamisel veelgi varem. Salvestame aasta
  /// KIRJENDAMISE hetkel, et hilisem majandusaasta muutus ei liigutaks juba
  /// tekkinud tähtaega.
  recordedFiscalYear Int?
  voidedAt           DateTime?
  voidReason         String?   @db.Text
  retentionClass     String    @default("accounting7y")
  /// KLIENDIPOOLNE IDEMPOTENTSUSVÕTI võrguta sisestuse jaoks.
  ///
  /// Koduhooldaja töötab keldrites ja levita piirkondades — kirje sünnib
  /// seadmes ja saadetakse hiljem. Kordussaatmine on siis NORMAALNE, mitte
  /// erand: kui päring jõudis serverini, aga vastus kadus, proovib seade uuesti.
  /// Ilma selle võtmeta tekiks KAKS arve alusdokumenti ühest tehtud tööst.
  ///
  /// Nullable, sest võrgus sisestus seda ei vaja; unikaalsus on profiili SEES,
  /// et kahe osutaja seadmed ei saaks teineteise võtmeid blokeerida.
  clientRequestId    String?
  /// LÄHTEKÜLASTUS Välitööst (leping 8.4).
  ///
  /// Eeltäide tekitas selle viite juba varem, aga teda ei saadetud ega
  /// salvestatud — seega ühest külastusest sai teha piiramatu arvu
  /// teenuskirjeid ja miski ei näidanud, kust kirje tuli. Arve alusdokumendi
  /// juures on päritolu osa dokumendist endast.
  ///
  /// UNIKAALNE profiili SEES: sama külastus annab ühe kirje. Nullable, sest
  /// enamik kirjeid ei sünni külastusest; PostgreSQL loeb NULL-e üksteisest
  /// erinevaks, seega piiramatu arv „ilma külastuseta" kirjeid on lubatud.
  ///
  /// SEOST ENNAST (`@relation`) EI OLE: külastus on eri säilitusega ja tema
  /// kustumine ei tohi teenuskirjet kaasa viia ega takistada. Viide on
  /// päritolumärge, mitte võtmeseos.
  sourceFieldVisitId String?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  providerProfile ServiceProviderProfile  @relation(fields: [providerProfileId], references: [id], onDelete: Restrict)
  owner           User?                   @relation("ServiceEntryOwner", fields: [ownerUserId], references: [id], onDelete: SetNull)
  client          User?                   @relation("ServiceEntryClient", fields: [clientUserId], references: [id], onDelete: SetNull)
  /// Suunamise kustutamine EI vii kirjet kaasa: maht võib ära kukkuda, tehtud
  /// töö mitte.
  referral        ServiceReferral?        @relation(fields: [referralId], references: [id], onDelete: SetNull)
  service         ServiceProviderService? @relation(fields: [serviceId], references: [id], onDelete: SetNull)

  corrections ServiceEntryCorrection[]

  @@unique([providerProfileId, clientRequestId])
  @@unique([providerProfileId, sourceFieldVisitId])
  @@index([providerProfileId, date])
  @@index([referralId])
  @@index([providerProfileId, clientUserId, date])
  @@index([ownerUserId, date])
  @@index([serviceId])
  @@index([providerProfileId, status, date])
  sourceVisit ServiceVisit? @relation("ServiceVisitEntry")
}

/// PARANDUSJÄLG (RPS § 10).
///
/// Kinnitatud teenuskirjet tohib parandada, aga parandus peab olema
/// JÄLGITAV: mis muutus, mis oli enne, miks ja millal. Ilma selleta on „kirjet
/// parandatakse, mitte ei kustutata" tühi lubadus — üle kirjutatud väärtus on
/// sama kadunud kui kustutatud rida, ainult vaiksemalt.
///
/// Rida on KIRJUTUS-ÜHEKORDNE: teda ei uuendata ega kustutata eraldi. Ta elab
/// koos oma kirjega ja kaob alles siis, kui kirje ise tohib säilitustähtaja
/// möödudes kaduda.
model ServiceEntryCorrection {
  id             String    @id @default(cuid())
  entryId        String
  /// Parandaja. Nullable + `actorErasedAt`, sest konto võib kustuda enne
  /// säilitustähtaja lõppu — jälg jääb, inimene kaob.
  actorUserId    String?
  actorErasedAt  DateTime?
  /// Põhjus on KOHUSTUSLIK. Ilma põhjuseta parandus ei ole jälgitav parandus,
  /// vaid lihtsalt teine väärtus.
  reason         String    @db.Text
  /// Muudetud väljade EELMISED väärtused. Ainult muutunud väljad — mitte terve
  /// rea koopia, mis dubleeriks tundlikku sisu igal parandusel.
  previousValues Json
  changedFields  String[]  @default([])
  createdAt      DateTime  @default(now())

  entry ServiceEntry @relation(fields: [entryId], references: [id], onDelete: Cascade)
  actor User?        @relation("ServiceEntryCorrectionActor", fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([entryId, createdAt])
  @@index([actorUserId])
}

/// Kuunarratiiv — kliendi LUGU, mille põhjal KOV otsustab teenuse jätkamise.
/// Eraldi objekt, sest tundlikkus ja säilitus erinevad kirjemärkmetest
/// (leping ptk 3 „Sisuline aruanne").
model ServiceMonthlyNarrative {
  id                String    @id @default(cuid())
  providerProfileId String
  referralId        String?
  clientUserId      String?
  clientErasedAt    DateTime?
  clientDisplayName String?
  periodYear        Int
  periodMonth       Int
  /// Inimese KINNITATUD lõpptekst. AI mustand ei jõua siia ilma kinnituseta —
  /// `draftSource` ütleb ausalt, kas tekst sündis mustandist.
  bodyText          String    @db.Text
  draftSource       String?
  /// ETTEPANEK: CONTINUE | CHANGE_VOLUME | END (mall C lõpp).
  ///
  /// Eraldi väli, mitte lõigu lõpulause: see on ainus koht narratiivis, mida
  /// KOV loeb OTSUSENA — tema järgi sünnib järgmine suunamisotsus. Tekstis
  /// peidetuna oleks ta masinale nähtamatu ja lugejale kergesti kadunud.
  proposal          String?
  proposalNote      String?   @db.Text
  retentionClass    String    @default("accounting7y")
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  providerProfile ServiceProviderProfile @relation(fields: [providerProfileId], references: [id], onDelete: Restrict)
  referral        ServiceReferral?       @relation(fields: [referralId], references: [id], onDelete: SetNull)
  client          User?                  @relation("ServiceNarrativeClient", fields: [clientUserId], references: [id], onDelete: SetNull)

  /// NB Postgresis ei ole kaks NULL-i võrdsed, seega SEE unikaalsus kehtib
  /// AINULT suunamisega seotud narratiividel. Suunamiseta narratiivi ainusus
  /// tuleb migratsiooni KAHEST osalisest indeksist
  /// (`ServiceMonthlyNarrative_noreferral_clientuser_key` platvormi kliendile ja
  /// `..._noreferral_clientname_key` välisele kliendile) — Prisma ei oska
  /// `WHERE`-iga indeksit väljendada. Sama lahendus, mida T25 kasutab profiili
  /// omandirežiimidel.
  @@unique([providerProfileId, referralId, periodYear, periodMonth])
  @@index([providerProfileId, periodYear, periodMonth])
  @@index([referralId])
  @@index([clientUserId])
}

/// TEENUSPÄEVIK — kuuaruande jagamine osakonna juhatajale.
///
/// KOLM ERINEVUST tööheaolu jagamisest (`WellbeingSupportShare`), mis on
/// TEADLIKUD, mitte lohakusest:
///
/// 1. SAAJA SAAB OMA KÜLMUTATUD KOOPIA, MITTE VIITE OMANIKU DOKUMENDILE.
///    Esimene versioon oli võõrvõti `UserDocument`-ile ja see oli kahtpidi vale.
///    Arhitektuurne pool: org-kiht EI TOHI omada võõrvõtit privaatobjekti
///    (§D8, `tests/org/contracts.test.js`) — see on lai piir just selleks, et
///    keegi ei peaks juhtumipõhiselt kaaluma, kas see konkreetne viide on
///    ohutu. Praktiline pool: võõrvõti tähendas, et omaniku dokumendi
///    kustutamine kustutaks vaikselt ka juhile saadetu.
///
///    Koopia EI OLE „teine tõde": bait'id on samad ja `sha256` tõendab seda.
///    Erinev on ainult VALDUS. `documentId` jääb alles VIITENA ILMA FK-ta —
///    omaniku enda loendi jaoks („millist aruannet ma jagasin").
///
/// 2. SISU EI OLE PRIVAATNE TÖÖTAJA KOHTA. Tööheaolu avaldus räägib inimesest
///    endast ja tema nägemise õigus on erandlik. Kuuaruanne on TÖÖTULEMUS ja
///    juhi õigus teda näha on tavaline — seepärast ei ole siin projektsiooni,
///    mis sisu kärbiks.
///
/// 3. ALGATAJA ON IKKA TÖÖTAJA. Juht ei saa aruannet ise võtta. See on ainus
///    reegel, mis tuleb tööheaolu rajalt muutmata üle: jagamine on saatmine,
///    mitte ligipääs.
model ServiceReportShare {
  id                    String                   @id @default(cuid())
  documentId            String
  ownerUserId           String
  organizationId        String
  recipientMembershipId String
  /// „AAAA-KK". Dubleerib dokumendi metaandmeid TEADLIKULT: juhi loend
  /// järjestatakse perioodi järgi ja JSON-välja järgi sortimine oleks aeglane
  /// ning indekseerimatu.
  month                 String
  /// KÜLMUTATUD KOOPIA. Oma fail, oma nimi, oma räsi — juhi eksemplar ei sõltu
  /// sellest, mida omanik oma dokumendiga hiljem teeb.
  storagePath           String
  fileName              String
  mime                  String
  sizeBytes             Int
  /// Sama sisu tõend: kui vaja näidata, et juht sai TÄPSELT selle faili, mis
  /// KOV-ile läks, võrreldakse räsi, mitte mälestusi.
  sha256                String
  kovName               String?
  entryCount            Int?
  note                  String?
  status                ServiceReportShareStatus @default(SENT)
  sentAt                DateTime                 @default(now())
  openedAt              DateTime?
  recalledAt            DateTime?
  createdAt             DateTime                 @default(now())
  updatedAt             DateTime                 @updatedAt

  owner        User                   @relation("ServiceReportShareOwner", fields: [ownerUserId], references: [id], onDelete: Cascade)
  organization Organization           @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  recipient    OrganizationMembership @relation("ServiceReportShareRecipient", fields: [recipientMembershipId], references: [id], onDelete: Cascade)

  @@index([ownerUserId, sentAt])
  @@index([recipientMembershipId, status, sentAt])
  @@index([organizationId, month])
  @@index([documentId])
}

enum ServiceReportShareStatus {
  SENT
  OPENED
  /// Tagasi võetud. Rida JÄÄB ALLES: „ma ei saatnud seda kunagi" ja „ma võtsin
  /// selle tagasi" on kaks eri asja ja auditijälg peab neid eristama.
  RECALLED
}

/* ============================================================================
   TEENUSPÄEVIK — E2c PÄEVATEEKOND.

   MIS OLI KATKI. OSA I andis ühe külastuse neli fikseeritud märget
   [LÄKSIN]→[KOHAL]→[LAHKUSIN]→[TAGASI]. Koduhooldaja, kes teeb kuus külastust
   järjest, EI LÄHE kuhugi tagasi — ta läheb järgmise kliendi juurde. Tema
   valik oli seni: jätta [TAGASI] vajutamata (siis kaob üks sõidulõik) või
   märkida midagi, mida ei juhtunud.

   Päevateekonnal ON JÄRGMISE TÖÖ `EN_ROUTE→ARRIVED` EELMISE LAHKUMISE
   SÕIDULÕIK. Fiktiivset tagasitulekut ei ole vaja, sest ta ei ole enam ainus
   viis sõiduaega kirja saada.

   KAKS MUDELIT, KAKS ERI ELU:

   `ServiceVisit` on TÖÖOBJEKT. Ta võib jääda ära (`CANCELLED`), mitte teoks
   saada (`NOT_DONE`) või vajada parandust — need EI OLE arve alusdokumendid ja
   nad ei tohi elada `ServiceEntry` tabelis. Leping: „töötaja kinnitatud
   külastus muutub teenuskirjeks, mitte vastupidi."

   `ServiceWorkRoute` on TÖÖPÄEV. Ilma temata ei ole „päeva algus/lõpp" ega
   „paus" kellegi oma ja lahtiseks jäänud külastust ei saa turvasignaal sulgeda.

   MIDA SIIN EI OLE: koordinaatide jada. Külastus kannab ÜHT punkti (saabumine),
   täpselt nagu `ServiceEntry`. Tööteekond ei kanna ühtegi — päeva algus ja lõpp
   on tihti kodu ja seda me ei kogu (leping E12).
   ============================================================================ */

model ServiceWorkRoute {
  id                String                 @id @default(cuid())
  providerProfileId String
  /// Kelle tööpäev. Nullable samal põhjusel mis `ServiceEntry.ownerUserId`:
  /// konto võib kustuda enne, kui päeva andmed vananevad.
  workerUserId      String?
  /// Kalendripäev (`@db.Date`), et päeva piir ei nihkuks ajavööndiga.
  date              DateTime               @db.Date
  status            ServiceWorkRouteStatus @default(OPEN)
  startedAt         DateTime?
  endedAt           DateTime?
  /// Pausi algus. Pausi ajal ei teki sõidulõiku ega tööaega (leping E12:
  /// „tööväline paus ei lähe arvestusse").
  breakStartedAt    DateTime?
  breakMinutes      Int                    @default(0)
  createdAt         DateTime               @default(now())
  updatedAt         DateTime               @updatedAt

  profile ServiceProviderProfile @relation(fields: [providerProfileId], references: [id], onDelete: Cascade)
  visits  ServiceVisit[]

  /// ÜKS AVATUD TÖÖPÄEV KORRAGA sama töötaja kohta — osaline unikaalindeks
  /// migratsioonis (`WHERE status = 'OPEN'`). Kaks paralleelset päeva
  /// tähendaks, et „jooksev külastus" ei ole üheselt määratud.
  @@index([providerProfileId, date])
  @@index([workerUserId, status])
}

enum ServiceWorkRouteStatus {
  OPEN
  CLOSED
}

model ServiceVisit {
  id                String             @id @default(cuid())
  providerProfileId String
  routeId           String?
  ownerUserId       String?
  referralId        String?
  serviceId         String?
  clientUserId      String?
  clientDisplayName String?
  clientExternalRef String?
  /// Aadress on PLAANI oma, mitte mõõtmise oma: ta tuleb suunamisest või juhi
  /// plaanist ja tema järgi saab töötaja navigeerida (E11). Asukohapunkt on
  /// eraldi väli ja tema allikas on seade.
  address           String?
  /// AADRESSI KOORDINAAT MAA-AMETI REGISTRIST (in-ADS), mitte seadmest.
  ///
  /// Teenusekaart geokodeerib osutajate asukohti juba ammu
  /// (`lib/serviceMap/geocoding.js`, serveris `GEOCODER_PROVIDER=maaruum`) ja
  /// see kiht on siin lihtsalt kasutusele võetud. Ta annab kolm asja, mida
  /// seadme GPS üksi ei anna:
  ///   1. sõidulõigu kauguse ka siis, kui GPS-i luba puudub,
  ///   2. RISTKONTROLLI mõõdetud punktile — kui seade ütleb Kopli ja aadress
  ///      on Tabasalus, on üks neist vale ja seda saab NÄHA,
  ///   3. navigatsiooni päris aadressile, mitte töötaja kirjaveale.
  ///
  /// EI ASENDA asukohatemplit: aadress ütleb, kuhu MINDI, tempel ütleb, kus
  /// KEEGI OLI. Tõend on ainult teine.
  addressLat        Float?
  addressLng        Float?
  addressAdsId      String?
  /// ETTE ARVUTATUD SÕIT: mitu kilomeetrit ja minutit on siia jõudmiseks.
  ///
  /// Arvutatakse SÕIDU ALGUSE hetkel, mitte pärast: töötaja peab teadma ENNE
  /// sõitu, kui kaugele ta läheb. Allikas on ise majutatud OSRM ja lähtepunkt
  /// on sõidu alguse märk — mitte eelmise kliendi aadress, sest vahepeal võidi
  /// käia poes.
  ///
  /// EI OLE ARVE ALUS. Arvele läheb tegelik sõit (`enRouteAt`→`arrivedAt`
  /// punktide vahelt); see arv on plaan ja tema säilitamine lubab hiljem näha,
  /// kas päev läks nii, nagu arvati.
  plannedTravelKm      Float?
  plannedTravelMinutes Int?
  status            ServiceVisitStatus @default(PLANNED)
  /// Plaanitud algus. NULL = planeerimata töö, mille töötaja ise lisas —
  /// päevateekond peab toimima ka ilma päevaplaanita (leping E2a).
  plannedStartAt    DateTime?
  sortOrder         Int                @default(0)
  enRouteAt         DateTime?
  arrivedAt         DateTime?
  completedAt       DateTime?
  cancelledAt       DateTime?
  /// Miks ära jäi või tegemata jäi. Ilma põhjuseta `NOT_DONE` on number, mille
  /// tähendust keegi hiljem ei tea.
  outcomeReason     String?
  note              String?
  noteProvenance    String?
  /// ÜKS punkt: saabumine. Sama kuju mis `ServiceEntry.locationStamps`.
  locationStamps    Json?
  /// Tekkinud teenuskirje. Viide ILMA võõrvõtita EI OLE siin õige — mõlemad on
  /// osutaja enda objektid ja kirje kadumine peab külastuse küljest ka näha
  /// olema.
  serviceEntryId    String?            @unique
  /// Idempotentsus: sama nupuvajutus võrgu taastumisel ei loo teist külastust.
  clientRequestId   String?
  /// TÖÖ ORGANISATSIOONILINE PÄRITOLU, KÜLMUTATUD LOOMISE HETKEL
  /// (SOL-SLOG-17 ja -18, mõlemad P0).
  ///
  /// MIS OLI KATKI. Teenuspäevik on SOLO-profiili põhine ja juhi tahvel tuletas
  /// skoobi INIMESTE kaudu: juhi üksused → nende liikmed → `workerUserId`. Kahes
  /// organisatsioonis töötaval inimesel on aga ÜKS tööpäev ja üks profiil, seega
  /// org A juht nägi org B klientide nimesid ja käiguolekut — ja sai teadaoleva
  /// `visitId` abil org B planeeritud töö oma töötajale ümber määrata.
  ///
  /// Inimese kaudu tuletatud skoop EI TÕENDA töö päritolu. Seda saab tõendada
  /// ainult see, mis kirjutati siis, kui töö sündis.
  ///
  /// VÕÕRVÕTIT EI OLE — TEADLIKULT. See on SNAPSHOT („kelle tööna see sündis"),
  /// mitte elav seos. `Cascade` kustutaks tõendi koos organisatsiooniga,
  /// `SetNull` teeks kustutatud organisatsiooni tööst ootamatult ORVU, mille
  /// päritolu ei ole enam kellelgi. Kustutatud organisatsiooni ID ei anna kellelegi
  /// ligipääsu: skoop nõuab kehtivat liikmesust ja luba, mida kustutatud
  /// organisatsioonis ei ole.
  ///
  /// `NULL` = päritolu EI OLE TÕENDATUD (töötaja lisas töö ise ja ta kuulub
  /// mitmesse või mitte ühessegi organisatsiooni). Sellist tööd ei näita ega
  /// liiguta ükski juhi tahvel — vaikimisi kinni, mitte vaikimisi lahti.
  ///
  /// MUUTUMATUS ON ANDMEBAASI OMA (SOL-ORG-01, migratsioon 20260810200000).
  /// `BEFORE UPDATE` trigger keelab väärtuse muutmise igas suunas — NULL → org,
  /// org → teine org, org → NULL. Rea kustutamine EI OLE keelatud: konto
  /// kustutus ja säilituse purge käivad kaskaadina läbi. Prisma ei näe
  /// triggereid, seega seda rida ei tohi lugeda skeemist tuletatuks.
  assignedOrganizationId String?
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt

  profile  ServiceProviderProfile @relation(fields: [providerProfileId], references: [id], onDelete: Cascade)
  route    ServiceWorkRoute?      @relation(fields: [routeId], references: [id], onDelete: SetNull)
  entry    ServiceEntry?          @relation("ServiceVisitEntry", fields: [serviceEntryId], references: [id], onDelete: SetNull)
  referral ServiceReferral?       @relation(fields: [referralId], references: [id], onDelete: SetNull)

  @@unique([providerProfileId, clientRequestId])
  @@index([providerProfileId, status])
  @@index([routeId, sortOrder])
  @@index([referralId])
  /// Juhi tahvel küsib „selle organisatsiooni tööd sellel teekonnal" — see on
  /// tema kuum päring ja ta peab käima indeksist, mitte skaneerimisest.
  @@index([assignedOrganizationId, routeId])
}

/// Olekud lepingust (E2c). `NEEDS_CORRECTION` on turvasignaali ja juhi
/// kontrolli oma: pooleli jäänud külastus ei kao, vaid jääb nähtavale.
enum ServiceVisitStatus {
  PLANNED
  EN_ROUTE
  ARRIVED
  COMPLETED
  CANCELLED
  NOT_DONE
  NEEDS_CORRECTION
}

// ---------------------------------------------------------------------------
// COLLAB-P4 — võrgustikujagamine, kitsas esimene vertikaal.
//
// Töötaja jagab ÜHE eelpöördumise põhjal koostatud külmutatud kokkuvõtte ÜHELE
// teenuseosutajale, ja klient kinnitab ENNE saatmist, mida jagatakse.
//
// Kaks piiri on tahtlikud:
//   1. `recipientUserId` on KOHUSTUSLIK viide olemasolevale kasutajale. Saajale
//      e-posti kutset ega konto-loomist siin ei ole — jagamine läheb ainult
//      inimesele, kes on juba platvormil ja seega raamlepingu all.
//   2. Vaba võrgustikukaarti kolmandate isikute kirjetega siin ei ole. Kirje
//      käib alati ühe kliendi ja ühe saaja vahel.
//
// Klient seevastu EI PEA olema kasutaja (omanik 04.08): võrgustikutöö on
// sotsiaaltöötaja tööülesanne ja klient saab info nagunii hiljem. Väline klient
// hoitakse miinimumkujul ja tema kinnituse kannab töötaja üle — kumbki rada ei
// teeskle teist. Väline rada nõuab kehtivat raamlepingut, vt `lib/network/share.js`.
//
// `summaryText` on KÜLMUTATUD väljavõte (jagamisklass 9 CONFIRMED_SUMMARY),
// mitte viide originaalile. Klassid 1–2 ei lahku kunagi originaalina.
model NetworkShare {
  id                  String             @id @default(cuid())
  sourcePreInquiryId  String
  workerId            String

  /// Klient KAHEL RAJAL, sama muster mis `ServiceReferral`-il (omanik 04.08):
  /// võrgustikutöö on sotsiaaltöötaja tööülesanne ja me EI SAA nõuda, et klient
  /// oleks platvormi kasutaja. Kui ta on — kinnitab ta ise. Kui ei ole —
  /// kannab töötaja tema kinnituse üle ja see märgitakse eraldi meetodina.
  /// Väline rada hoiab MIINIMUMI: kuvanimi võib olla initsiaal või roll.
  clientUserId        String?
  clientDisplayName   String?
  clientExternalRef   String?

  /// Saaja PEAB olema platvormi kasutaja. Vt mudeli päise punkt 1.
  recipientUserId     String

  /// Külmutatud kokkuvõte — see, mida klient nägi ja kinnitas.
  summaryText         String             @db.Text
  /// Miks see osapool kaasatakse.
  purpose             String             @db.Text
  /// Mida saaja tohib näha ja mida mitte — töötaja sõnastuses.
  sharingBoundary     String             @db.Text
  /// Kaardistamise lõpp on KOHUSTUSLIK väli. „Igavesti vaikimisi" on keelatud.
  participationEndsOn DateTime           @db.Date

  /// SOL-NET-01/-02: KINNITUS VIITAB TEKSTILE, MITTE REALE.
  ///
  /// `contentHash` on sha256 jagatavast sisust (kokkuvõte, eesmärk, jagamispiir,
  /// lõppkuupäev) ja ta arvutatakse igal kirjutusel. `confirmedContentHash` on
  /// see, MIDA KLIENT NÄGI kinnitamise hetkel.
  ///
  /// Ilma nendeta oli „klient kinnitab täpselt seda, mida jagatakse" ainult
  /// koodi järjekord: kaks paralleelset päringut lugesid sama rea, üks kirjutas
  /// uue teksti ja teine kirjutas peale vana vaate kinnituse. Saatmine nõuab
  /// nüüd, et need kaks räsi oleksid VÕRDSED — `SENT` rida ei saa eksisteerida
  /// ilma sama versiooni kinnitustõendita.
  contentHash          String
  confirmedContentHash String?

  status              NetworkShareStatus @default(DRAFT)
  clientConfirmedAt   DateTime?
  clientDeclinedAt    DateTime?
  clientDecisionNote  String?            @db.Text

  /// Kuidas kinnitus saadi. `IN_APP` = klient ise oma kontolt. Ülejäänud on
  /// TÖÖTAJA ÜLEKANTUD kinnitus ja see on nõrgem tõend — neid ei tohi kunagi
  /// esitada nii, nagu oleks klient ise vajutanud. Sama piir mis „AI mustandit
  /// ei esitata inimese ütlusena".
  clientConfirmationMethod       ClientConfirmationMethod?
  clientConfirmationAttestedById String?
  sentAt              DateTime?
  openedAt            DateTime?
  recalledAt          DateTime?
  respondedAt         DateTime?

  /// Kirjalik ruum avaneb alles saatmisel, mitte mustandi loomisel.
  roomId              String?            @unique

  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt

  sourcePreInquiry PreInquiry @relation("NetworkShareSource", fields: [sourcePreInquiryId], references: [id], onDelete: Cascade)
  worker           User       @relation("NetworkShareWorker", fields: [workerId], references: [id], onDelete: Cascade)
  client           User?      @relation("NetworkShareClient", fields: [clientUserId], references: [id], onDelete: SetNull)
  recipient        User       @relation("NetworkShareRecipient", fields: [recipientUserId], references: [id], onDelete: Cascade)
  attestedBy       User?      @relation("NetworkShareAttestedBy", fields: [clientConfirmationAttestedById], references: [id], onDelete: SetNull)
  room             Room?      @relation("NetworkShareRoom", fields: [roomId], references: [id], onDelete: SetNull)

  @@index([workerId, status])
  @@index([clientUserId, status])
  @@index([recipientUserId, status])
  @@index([sourcePreInquiryId])
}

/// AWAITING_CLIENT on eraldi olek, mitte lipp: jagamine, mille klient ei ole
/// veel näinud, ei tohi olla saadetavas seisus üheski koodirajas.
/// IN_APP on ainus, kus klient ise vajutas. Ülejäänud kolm on töötaja ülekantud
/// kinnitus — nõrgem tõend, mis peab jääma eristatavaks.
enum ClientConfirmationMethod {
  IN_APP
  IN_PERSON
  PHONE
  WRITTEN
}

enum NetworkShareStatus {
  DRAFT
  AWAITING_CLIENT
  CONFIRMED
  DECLINED
  SENT
  OPENED
  RESPONDED
  RECALLED
  ENDED
}

// ─────────────────────────────────────────────────────────────────────────────
// SOTSIAALKIIRABI-V1 (SK-V1) — avalik nimi „Kiireloomuline abipalve" (O-SK-7).
//
// Pöörduja ütleb ISE, et olukord ei kannata hommikuni, ja tema enda sõnadega
// kirjeldus liigub tema valitud KOV-i lauale. Neli asja on siin arhitektuur,
// mitte poliitika:
//
//   1. **Lüliti on saaja seadistus ise** (leping 3.6). Eraldi funktsioonilippu
//      EI OLE. `UrgentRequest.deskId` on NOT NULL viide `UrgentDesk`-ile, mille
//      valmidustingimused on serveris kontrollitud — lekkinud lipp, vana
//      vahemälu ega otse-URL ei suuda toota pöördumist, mis ei vii kuhugi.
//   2. **Platvorm lubab LUGEMISAEGA, mitte reageerimisaega.** `readingTimePromise`
//      külmutatakse pöördumise KÜLGE tekstina saatmise hetkel: kui KOV muudab
//      hiljem oma lubadust, ei tohi see tagantjärele muuta seda, mida inimesele
//      öeldi.
//   3. **`situationVerbatim` on ainus koht, kust vastuvõtja sisu loeb.**
//      `assistantStructured` kuvatakse alati eraldi ja märgistatult, mitte selle
//      asemel. „Ma ei tea, mis ma teen" ja „isik väljendas ebakindlust" ei ole
//      sama teade.
//   4. **AI ei triaaži.** Kiireloomulisuse allikas on ainult inimese enda tegu.
//      Skeemis ei ole ühtegi masinhinnangu, skoori ega järjekorranumbri välja —
//      ja seda tühjust ei tohi täita.
//
// Kõrvalekalle lepingu ptk 4 mustandist, teadlik: seal oli `regionCode String`,
// siin on `municipalityId` viide `Municipality`-le. Põhjus on referentsiaalne
// terviklikkus — vaba tekstiga piirkonnakood laseks luua laua piirkonnale, mida
// ei ole, ja pöördumise piirkonda, mille nimi on kirjaviga.
// ─────────────────────────────────────────────────────────────────────────────

enum UrgentRequestRecipientType {
  KOV_CONTACT
  SERVICE_PROVIDER
}

/// SK olekud EI OLE PreInquiry omad (leping 3.1: oma objekt, oma elutsükkel).
/// `EXPIRED` on siin olemas sellepärast, et SK-teade AEGUB hommikuks —
/// eelpöördumine ei aegu kunagi.
enum UrgentRequestStatus {
  SENT
  READ
  TAKEN
  DECLINED
  RESOLVED
  EXPIRED
  RECALLED
}

/// Isikuline vastutusjälg (KOV-lepingu p 8 + Soome kogemuse nõue 2).
/// Iga rida seob toimingu KONKREETSE inimese ja kellaajaga.
enum UrgentRequestEventKind {
  CREATED
  VIEWED
  READ_MARKED
  TAKEN
  DECLINED
  RESOLVED
  RECALLED
  EXPIRED
  HANDED_OVER
  HANDOVER_ACCEPTED
  CONVERTED
}

/// Vastuvõtulaud = SK-V1 ainus lüliti.
///
/// Piirkond avaneb inimesele ALLES siis, kui siin on aktiivne, otsepöördumist
/// lubav, lugemisaja ja 112-piiriga laud, mille tingimused ei ole aegunud.
/// Valmiduse reegel elab `lib/urgent/desk.js`-is (`deskReadiness`) — siin on
/// ainult andmed.
model UrgentDesk {
  id             String                     @id @default(cuid())
  municipalityId String
  recipientType  UrgentRequestRecipientType @default(KOV_CONTACT)

  /// Avalik nimi, mida inimene näeb. NB O-SK-7: partneri teenusenime tohib
  /// näidata ainult siis, kui rada viib päriselt selle teenuse mehitatud
  /// vastuvõttu — mujal on nimi „Kiireloomuline abipalve".
  publicName String

  /// Laud on funktsionaalne, aga omanik on nimeline (KOV-lepingu p 1).
  ownerUserId String?
  /// Teenuseosutaja laud on seotud teenusekaardi kirjega.
  serviceEntryId String?

  openingHours          String
  /// Kes tohib pöörduda — inimesele nähtav tingimus, mitte sisemine reegel.
  whoMayContact         String
  /// Kas KOV nõuab eelhindamist. INFORMATIIVNE väli: ta ei sulge otseteed,
  /// vaid öeldakse inimesele ette. Otsetee sulgeb `directContactAllowed`.
  preAssessmentRequired Boolean @default(false)
  /// Inimese kulu. Estkeeri õppetund: sama nime all oli ühes vallas tasuline ja
  /// teises tasuta teenus — hind peab olema kirjas laua juures.
  costToPerson          String

  /// LUGEMISAEG, mitte reageerimisaeg. Ilma selleta laud ei avane.
  readingTimePromise String
  /// Otsene kontakt või vastuvõtulaud — kumb see on.
  contactChannel     String
  /// 112 piir: mis olukorras see rada EI ole õige uks.
  emergencyBoundary  String

  /// Kui kaua pöördumine lauda OOTAB, enne kui ta aegub ja inimesele öeldakse,
  /// et vastust ei tulnud. Laua oma väli, mitte globaalne konstant: laud, mis
  /// lubab lugeda 30 minutiga, ei tohi lasta inimesel ööpäeva rippuda, ja laud,
  /// mis loeb hommikul, ei tohi aeguda enne hommikut.
  requestLifetimeHours Int @default(24)

  /// Estkeeri õppetund nr 1: öisel teenusel oli päevane värav. Kui KOV nõuab,
  /// et pöördumine käiks päevase sotsiaaltöötaja kaudu, EI OLE see SK-rada ja
  /// piirkond jääb inimese jaoks suletuks.
  directContactAllowed Boolean @default(false)

  /// Mehitatud ja avatud. Vaikimisi VÄLJAS — laud ei teki kogemata.
  isActive       Boolean   @default(false)
  /// Millal partner tingimusi viimati kinnitas. Aegunud kinnitus sulgeb laua
  /// (`DESK_VERIFICATION_MAX_AGE_DAYS`) — vana lubadus ei ole lubadus.
  lastVerifiedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  municipality Municipality       @relation(fields: [municipalityId], references: [id], onDelete: Cascade)
  owner        User?              @relation("UrgentDeskOwner", fields: [ownerUserId], references: [id], onDelete: SetNull)
  serviceEntry ServiceMapEntry?   @relation(fields: [serviceEntryId], references: [id], onDelete: SetNull)
  members      UrgentDeskMember[]
  requests     UrgentRequest[]    @relation("UrgentRequestDesk")
  handovers    UrgentRequest[]    @relation("UrgentRequestHandoverDesk")

  /// Üks laud piirkonna ja saajatüübi kohta. Kaks aktiivset KOV-lauda samas
  /// vallas tähendaks, et pöördumine läheb sinna, kus keegi teda ei oota.
  @@unique([municipalityId, recipientType])
  @@index([isActive])
  @@index([ownerUserId])
  @@index([serviceEntryId])
}

/// Laua mehitajad. Vahetuse üleandmine (E5) ja isikuline vastutusjälg (E4)
/// eeldavad, et laua taga on nimetatud inimesed — muidu ei ole kellelegi
/// vaatamist omistada.
model UrgentDeskMember {
  id       String   @id @default(cuid())
  deskId   String
  userId   String
  isActive Boolean  @default(true)
  addedAt  DateTime @default(now())

  desk UrgentDesk @relation(fields: [deskId], references: [id], onDelete: Cascade)
  user User       @relation("UrgentDeskMemberUser", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([deskId, userId])
  @@index([userId, isActive])
}

model UrgentRequest {
  id             String    @id @default(cuid())
  authorId       String?
  authorErasedAt DateTime?

  /// NOT NULL — see ongi fail-closed lukk. Pöördumist ilma lauata ei saa
  /// eksisteerida ka siis, kui mõni koodirada seda kunagi proovib.
  deskId         String
  municipalityId String
  recipientType  UrgentRequestRecipientType

  /// Inimese enda sõnad, MUUTMATA. Ainus koht, kust vastuvõtja sisu loeb.
  situationVerbatim   String  @db.Text
  /// AI mustand — alati eraldi ja märgistatult, mitte verbatim-teksti asemel.
  assistantStructured String? @db.Text

  contactName  String
  contactPhone String
  /// „Kas keegi on ohus" — ainus jah/ei. `true` ei jõua siia kunagi: see vastus
  /// viib 112-ekraanile ja kirjet ei teki (leping ptk 5 haru C).
  safetyAnswer Boolean @default(false)

  status UrgentRequestStatus @default(SENT)

  /// KÜLMUTATUD saatmise hetkel, tekstina mitte viitena. Kui KOV muudab hiljem
  /// oma lugemisaega, ei muutu see, mida inimesele lubati.
  readingTimePromise String

  sentAt        DateTime  @default(now())
  readAt        DateTime?
  takenAt       DateTime?
  declinedAt    DateTime?
  /// E5: eitav vastus on KOHUSTUSLIK rada. Vaikus on halvim tulemus, seega
  /// keeldumine ilma põhjuseta ei ole võimalik.
  declineReason String?   @db.Text
  resolvedAt    DateTime?
  expiresAt     DateTime
  recalledAt    DateTime?

  /// Vahetuse ja üksuse üleandmine (E5 + Soome nõue 3): öine juhtum peab jõudma
  /// hommikul õige üksuseni JA üleandmine vajab vastuvõtukinnitust.
  handoverDeskId     String?
  handedOverAt       DateTime?
  handoverAcceptedAt DateTime?
  handoverNote       String?   @db.Text

  /// Esiuks → tuba. Konversioon ei kaota verbatim-teksti.
  convertedPreInquiryId String? @unique

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  author              User?                @relation("UrgentRequestAuthor", fields: [authorId], references: [id], onDelete: SetNull)
  /// JUHTUM-V1 päritolu (L12). SetNull: abipalve kustutus ei hävita juhtumit.
  caseWorkAssists     CaseWorkAssist[]     @relation("CaseWorkAssistUrgentRequest")
  desk                UrgentDesk           @relation("UrgentRequestDesk", fields: [deskId], references: [id], onDelete: Restrict)
  handoverDesk        UrgentDesk?          @relation("UrgentRequestHandoverDesk", fields: [handoverDeskId], references: [id], onDelete: SetNull)
  municipality        Municipality         @relation(fields: [municipalityId], references: [id], onDelete: Restrict)
  convertedPreInquiry PreInquiry?          @relation("UrgentRequestConversion", fields: [convertedPreInquiryId], references: [id], onDelete: SetNull)
  events              UrgentRequestEvent[]

  @@index([deskId, status, sentAt])
  @@index([authorId, sentAt])
  @@index([status, expiresAt])
  @@index([municipalityId, sentAt])
  @@index([handoverDeskId, handoverAcceptedAt])
}

/// Vastutusjälg. Sisu siia EI kirjutata — rida ütleb, KES mida millal tegi,
/// mitte mida ta luges. `note` on toimingu põhjendus (nt keeldumise põhjus),
/// mitte pöörduja teksti koopia.
model UrgentRequestEvent {
  id        String                 @id @default(cuid())
  requestId String
  kind      UrgentRequestEventKind
  actorId   String?
  note      String?                @db.Text
  createdAt DateTime               @default(now())

  request UrgentRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  actor   User?         @relation("UrgentRequestEventActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([requestId, createdAt])
  @@index([actorId, createdAt])
}

/* ─────────────────────────────────────────────────────────────────────────────
   A4 E3 — MTR tegevusloa kontrolli andmemudel.

   KAHEKSA LUKUSTATUD PÕHIMÕTET (omanik 05.08), mis seletavad, miks skeem on
   just selline:

   1. `serviceKey` on LAIENDATAV STRING, mitte DB-enum. Uue kataloogirea
      lisamine peab olema andmeline muudatus, mitte migratsioon.
   2. `catalogueVersion` salvestatakse iga hinnangu juurde.
   3. Loakohustuse otsus salvestatakse KONTROLLI HETKE KOOPIANA — vana kirje
      tähendus ei tohi tagantjärele muutuda, kui vastavustabel muutub.
   4. `EXACT_MATCH` ja `ACTIVITY_MATCH_ONLY` on eraldi seisud.
   5. `missingOrderedColumns` säilib kontrolli tehnilise metaandmena.
   6. Rikastusvälja puudumine ei kustuta identiteedi ja tegevusala põhjal
      saadud usaldusväärset tulemust.
   7. SIDUMATA teenus ei tekita MTR-i päringut ega avalikku loaväidet.
   8. Uus `serviceKey` = andmed või konfiguratsioon, mitte skeemimuudatus.
   ───────────────────────────────────────────────────────────────────────────── */

/// Kontrolli tulemus tervikuna. Tahtlikult kaheväärtuseline: kõik täpsem
/// (miks ei õnnestunud) elab `reason`-is STRINGINA, sest põhjuste loend kasvab
/// koos MTR-i ootamatustega ja iga uus põhjus ei tohi nõuda migratsiooni.
enum LicenceCheckResult {
  OK
  UNCONFIRMED
}

/// Mida loakirje teenuse kohta TÕENDAB (vt `lib/mtr/licensedServices.js`).
/// `ACTIVITY_MATCH_ONLY` = tegevusala sobib, aga täpne alateenus ei ole teada.
enum LicenceCoverage {
  EXACT_MATCH
  ACTIVITY_MATCH_ONLY
  NO_MATCH
  UNCONFIRMED
}

/// Avalik seis. `SERVICE_MAPPING_REQUIRED` EI OLE `UNCONFIRMED` alaliik:
/// esimene tähendab „me ei tea, MIDA kontrollida", teine „teadsime, mida
/// küsida, aga kontroll ei õnnestunud". Ainult teine on registri või võrgu
/// probleem, ja ainult esimesel ei ole avalikku silti üldse.
/// `VERIFIED` ja `ACTIVITY_VERIFIED` on ERI SEISUD, mitte sama seis eri
/// kaetusega. Nii ei saa liides renderdada täpset märgist ainult
/// `publicStatus` põhjal — jämeda vaste jaoks ON OMA seis ja oma tekst.
enum LicencePublicStatus {
  VERIFIED
  ACTIVITY_VERIFIED
  NO_SHS_LICENCE_REQUIRED
  NOT_FOUND
  UNCONFIRMED
  NOT_CHECKED
  SERVICE_MAPPING_REQUIRED
}

/// Üks MTR-i päring ühe registrikoodi kohta.
///
/// Kirje jääb alles ka siis, kui päring ebaõnnestus — „me proovisime ja ei
/// saanud" on omaette fakt, mida osutaja ja admin peavad nägema.
model LicenceCheck {
  id                String             @id @default(cuid())
  providerProfileId String
  /// Kood, MILLEGA päriti. Ta ei pruugi enam võrduda profiili praeguse
  /// koodiga — ajalooline kirje peab ütlema, mida tol hetkel küsiti.
  registryCode      String

  /// ÜLDINE tulemus: `OK` ainult siis, kui MÕLEMAD päringud õnnestusid ja
  /// identiteet lahendus. Kaks allikat on eraldi väljadel, sest muidu võib
  /// audit või hilisem kood lugeda `result: OK` ja saada vale ettekujutuse
  /// kirjest, mille identiteet jäi lahendamata.
  result              LicenceCheckResult
  licenceSourceResult LicenceCheckResult
  entitySourceResult  LicenceCheckResult
  licenceReason       String?
  entityReason        String?

  /// Identiteedivärav: kas kood vastas MTR-is päris juriidilisele isikule.
  /// Ilma selleta ei tohi tekkida väidet „luba puudub".
  entityResolved Boolean @default(false)
  /// Registrist tulnud nimi — anomaaliakontrolliks profiili nime vastu.
  entityName     String?
  /// KOLM väärtust: true = kontrollnumber klapib · false = ei klapi ·
  /// NULL = ei saanud hinnata. `false` vaikeväärtusena valetaks.
  checksumValid  Boolean?

  /// Kolm ERI aega. `attemptedAt` = päring algas. `licenceSourceCheckedAt` =
  /// lubade vastus loeti. `verifiedAt` = KOGU kontroll õnnestus (sh
  /// identiteet) — ainult see kõlbab avaliku märgise kuupäevaks.
  attemptedAt            DateTime  @default(now())
  licenceSourceCheckedAt DateTime?
  verifiedAt             DateTime?
  nextCheckAt            DateTime?
  /// Mitmes järjestikune ebaõnnestumine see on. Ilma selleta ei saa
  /// korduskatsete astmestik (1 h → 6 h → 24 h) tegelikult rakenduda.
  consecutiveFailureCount Int @default(0)

  /// Tehnilised metaandmed E6 alarmi jaoks (põhimõtted 5 ja 6).
  unknownColumns        String[] @default([])
  missingOrderedColumns String[] @default([])

  createdAt DateTime @default(now())

  providerProfile   ServiceProviderProfile     @relation(fields: [providerProfileId], references: [id], onDelete: Cascade)
  licences          LicenceRecord[]
  lastAttemptFor    ServiceLicenceAssessment[] @relation("AssessmentLastAttempt")
  statusSourceFor   ServiceLicenceAssessment[] @relation("AssessmentStatusSource")

  @@index([providerProfileId, attemptedAt])
  @@index([registryCode, attemptedAt])
  @@index([nextCheckAt])
}

/// Üks MTR-i loakirje ühe kontrolli sees.
model LicenceRecord {
  id      String @id @default(cuid())
  checkId String

  licenceNumber String
  registryCode  String
  activity      String
  /// Erihoolekandeloa TÄPNE alateenus („Tegevusala liik"). NULL on lubatud ja
  /// tähendab ainult, et täpsust ei tellitud või registris ei olnud — mitte
  /// vastuolu.
  activityType  String?

  /// KALENDRIPÄEV, mitte ajahetk. `DateTime` UTC-kesköödega nihutaks Eesti
  /// suveajal loa kehtivuse kolm tundi: luba „hakkaks kehtima" kohaliku päeva
  /// algusest hiljem ja jääks kehtima järgmise päeva esimesteks tundideks.
  validFrom  DateTime  @db.Date
  validUntil DateTime? @db.Date
  indefinite Boolean   @default(false)
  valid      Boolean   @default(false)

  organizationName    String
  /// TEGEVUSLOAL LUBATUD MAKSIMAALNE MAHT, mitte vabad kohad. Nime pikkus on
  /// tahtlik: „maxPersons" oleks varem või hiljem loetud kättesaadavuseks.
  licensedMaxPersons  Int?
  note                String? @db.Text

  createdAt DateTime @default(now())

  check     LicenceCheck            @relation(fields: [checkId], references: [id], onDelete: Cascade)
  locations LicenceRecordLocation[]

  @@index([checkId])
  @@index([registryCode, activity])
}

/// Loa tegevuskoht. Eraldi tabel, sest luba käib teenuse JA KOHA külge —
/// ühe maja luba ei rohelista teist maja.
model LicenceRecordLocation {
  id       String  @id @default(cuid())
  recordId String
  address  String
  licensedMaxPersons Int?

  record LicenceRecord @relation(fields: [recordId], references: [id], onDelete: Cascade)

  @@index([recordId])
}

/// Ühe osutaja teenuse loahinnang — see, mille pealt märgis kuvatakse.
///
/// KOOPIA, MITTE VAADE (põhimõte 3): `requirementAtAssessment`,
/// `activityExpected` ja `activityTypeExpected` on salvestatud sellisena, nagu
/// vastavustabel neid HINDAMISE HETKEL nägi. Kui tabel hiljem muutub, ei tohi
/// vana kirje vaikselt uut tähendust omandada.
model ServiceLicenceAssessment {
  id                String @id @default(cuid())
  providerServiceId String

  /// KAKS ERI SEOST, mida ei tohi ühte valada:
  ///   `lastAttemptCheckId`  — viimane kontroll, ka siis, kui ta midagi ei kinnitanud;
  ///   `statusSourceCheckId` — kontroll, mille TÕENDIL praegune avalik seis põhineb.
  /// Ilma selle vaheta kuvaks liides „kontrollitud 5. augustil" ka siis, kui
  /// just 5. augusti kontroll enam luba ei leidnud ja märgis püsib vanema
  /// tõendi najal. `statusSourceCheckId` on NULL, kui seis ei tulene MTR-ist.
  lastAttemptCheckId  String?
  statusSourceCheckId String?

  /// Laiendatav string, MITTE enum (põhimõte 1).
  serviceKey       String
  catalogueVersion String

  requirementAtAssessment String
  activityExpected        String?
  activityTypeExpected    String?

  coverage     LicenceCoverage
  publicStatus LicencePublicStatus
  /// Miks seis selline on (`CHECK_STALE`, `IDENTITY_UNRESOLVED`,
  /// `PENDING_SECOND_CHECK`, allikakliendi põhjus). Ilma selleta ei oska
  /// osutaja vaade öelda, mida parandada.
  assessmentReason String?

  /// MILLAL POSITIIVNE SEIS AEGUB — lühim ankur kontrolli värskusest ja loa
  /// lõppkuupäevast. Lugemisrada peab seda jõustama: möödunud aeg tähendab, et
  /// märgist EI TOHI enam kuvada, ka siis, kui korje pole veel jõudnud.
  publicStatusValidUntil DateTime?
  /// Loakirje, millel seis põhineb — jälgitavuse jaoks.
  coveringLicenceNumber  String?
  /// V1 märgis on ORGANISATSIOONI tasandi kontroll: ta ütleb, et osutajal on
  /// sellele teenusele luba, MITTE et just see teeninduskoht on kaetud.
  coverageScope          String @default("ORGANISATION")

  /// Mitu järjestikust EDUKAT registrivastust on luba puudunud. Tehniline
  /// tõrge NULLIB selle — muidu loeks kaks tõrkega eraldatud puudumist
  /// „järjestikuseks" ja avalik negatiivne väide tekiks liiga vara.
  confirmedMissCount Int @default(0)

  assessedAt DateTime @default(now())
  updatedAt  DateTime @updatedAt

  providerService ServiceProviderService @relation(fields: [providerServiceId], references: [id], onDelete: Cascade)
  lastAttempt     LicenceCheck?          @relation("AssessmentLastAttempt", fields: [lastAttemptCheckId], references: [id], onDelete: SetNull)
  statusSource    LicenceCheck?          @relation("AssessmentStatusSource", fields: [statusSourceCheckId], references: [id], onDelete: SetNull)

  @@unique([providerServiceId])
  @@index([serviceKey])
  @@index([publicStatus])
  @@index([publicStatusValidUntil])
}


/* ─────────────────────────────────────────────────────────────────────────────
   JUHTUM-V1 (CASEWORK-P7) — juhtumi objekt.

   Leping: docs/platvormi arendus/juhtum-v1-arendusleping.md (v6).

   MIS SEE ON: töötaja enda töökorralduse KONTEINER. Ta seob olemasolevat ja
   EI KOPEERI ühtegi rida. Mustandeid hoiab endiselt `AgentArtifact`.

   MIS SEE EI OLE: kliendiregister. Isikuvälju siin ei ole — klient on kahe raja
   mustris (L11), sama muster mis `ServiceReferral`-il ja `NetworkShare`-il.

   PIIR CASEWORK-P2 VASTU (leping ptk „Piir"): mustandi ülekandeahel (8 elementi
   × 7 seisu) EI KUULU siia ja on kolme otsuse taga (O-CW-2/4/10). Sellepärast ei
   ole üheski siinses mudelis ülekande- ega ülevaatuse seisu välja.
   ───────────────────────────────────────────────────────────────────────────── */

enum CaseWorkRetentionState {
  ACTIVE
  READ_ONLY
  ARCHIVED
}

enum CaseWorkMissingInfoStatus {
  OPEN
  RESOLVED
  NOT_APPLICABLE
}

/// Kes kliendiviite kustutuse käivitas. `SYSTEM` on vajalik, sest
/// `lib/privacy/userDeletionOrchestrator.js` teeb seda ilma kasutaja seansita.
enum CaseWorkErasureActorKind {
  USER
  SYSTEM
}

/// V1-s on lubatud ainult STAR2. Erinevalt `serviceKey`-st (A4) EI OLE see
/// kasvav kataloog: uus väline süsteem tähendab uut liidestust, seega
/// koodimuudatust — enum on siin õige tugevus.
enum CaseWorkExternalSystem {
  STAR2
}

/// JTA-V1 (E5) — STAR2-sse kandmise järjekorra kaheksa elementi (`ideed.md` ptk 4.5).
///
/// ENUM, MITTE TEKST — ja see on teadlik erinevus `transferState`-ist samas
/// tabelis. Kaheksa elementi on SELLE ahela struktuur: üheksas element tähendaks
/// uut vormirida, uut silti kolmes keeles ja uut lepingurida, ehk niikuinii
/// koodimuudatust. `transferState` seevastu elab jagatud sõnastikus
/// (`lib/workspaces/provenance.js`) ja teda kasutab ka K1 kiht — DB-enum
/// tekitaks temast teise tõe.
///
/// NB VÄÄRTUSI EI TOHI ÜMBER JÄRJESTADA — Postgres sordib enum'i deklaratsiooni,
/// mitte tähestiku järgi. Uued väärtused LÕPPU.
enum CaseWorkDraftType {
  POORDUMISE_KOKKUVOTE
  ABIVAJADUSE_HINDAMINE
  ELUVALDKONNA_KIRJELDUS
  EESMARGI_SONASTUS
  TEGEVUS
  VASTUTAJA_JA_TAHTAEG
  KOHTUMISE_MARGE
  TEENUSE_SUUNAMISE_ALUS
}

/// JTA-V1 (E3) — kohtumise ettevalmistuse väljad.
///
/// ENUM, MITTE TEKST, ja see on TEADLIK ERINEVUS `provenance`-ist. Päritolu on
/// JAGATUD sõnastik (`lib/workspaces/provenance.js`, kaheksa väärtust, kasutusel
/// ka FIELD-is) ja DB-enum tekitaks temast teise tõe. `fieldKey` on selle mudeli
/// OMA suletud hulk: uus väli tähendab uut vormirida, uut teksti kolmes keeles
/// ja uut lepingurida — ehk niikuinii koodimuudatust. Siis on migratsioon aus
/// hind ja andmebaas jõustab seda, mida `@@unique([meetingPrepId, fieldKey])`
/// niikuinii eeldab.
///
/// NB VÄÄRTUSI EI TOHI ÜMBER JÄRJESTADA — vt `CaseWorkMissingInfoStatus`
/// kommentaari `caseWorkMissingInfo.js`-is: Postgres sordib enum'i
/// DEKLARATSIOONI, mitte tähestiku järgi. Uued väärtused LÕPPU.
enum CaseWorkPrepFieldKey {
  GOAL
  REQUIRED_DOCUMENTS
  LIFE_DOMAINS
  AGENDA
  PLAIN_LANGUAGE_NOTES
}

/// JTA-V1 (E3) — küsimuse liik (`ideed.md` ptk 12 nimi, uut ei leiutata).
///
/// Kaks liiki, mida ei tohi kokku valada: `CLARIFYING_QUESTION` on see, mida
/// töötaja kliendilt KÜSIB, `CLAIM_TO_VERIFY` on väide, mille ta kliendiga üle
/// KONTROLLIB. Esimene otsib infot, teine kinnitab olemasolevat — ja just see
/// vahe kannab ptk 4.6 nõuet, et nähtud fakt ja kontrollimata info seisavad
/// eraldi.
enum CaseWorkQuestionKind {
  CLARIFYING_QUESTION
  CLAIM_TO_VERIFY
}

/// JTA-V1 (E6) — ülekandeauditi kaks tegu (L9).
///
/// KOPEERIMINE EI OLE ÜLEKANNE. `COPIED_FOR_STAR2` tähendab, et tekst läks
/// lõikelauale; `MARKED_AS_TRANSFERRED` tähendab, et inimene AVALDAS, et info on
/// STAR-is. Üks nimi mõlema jaoks tähendaks, et audit väidab ülekannet ka siis,
/// kui keegi ainult vaatas — ja L7 säilituskell hakkaks käima sellest hetkest.
///
/// ENUM, MITTE TEKST: kaks tegu on SELLE tabeli oma kuju, sama liiki asi mis
/// `CaseWorkQuestionKind`. `transferState` samas tabelis jääb tekstiks, sest tema
/// sõnastik elab `lib/workspaces/provenance.js`-is.
enum CaseWorkTransferEventKind {
  COPIED_FOR_STAR2
  MARKED_AS_TRANSFERRED
}

/// JTA-V1 (E7) — MIKS mustandi sisu kustus.
///
/// KAKS RADA, KAKS TÄHENDUST, ja neid ei tohi kokku valada:
///
///   `RETENTION_AFTER_TRANSFER`         L7 automaatne kell — 12 kuud pärast
///                                      ülekannet. Eeldab `transferredAt`-i ja
///                                      seda jõustab `CHECK`.
///   `WORKER_ARCHIVED_WORKING_MATERIAL` O-JTA-5 rada C — töötaja tegu „arhiveeri
///                                      töömaterjal". Mustandit EI OLE kuhugi
///                                      kantud ja just see ongi mõte: kandmata
///                                      töömaterjal ei saanud L7-s kunagi oma
///                                      kella ja võis juhtumis aastaid istuda.
///
/// Ilma selle veeruta oleks purge'itud kandmata mustand eristamatu andmeveast:
/// `contentPurgedAt` üksi ei ütle, kas sisu kustutati teadlikult või kadus ta
/// millegi katki mineku tõttu.
enum CaseWorkPurgeReason {
  RETENTION_AFTER_TRANSFER
  WORKER_ARCHIVED_WORKING_MATERIAL
}

model CaseWorkAssist {
  id          String @id @default(cuid())
  ownerUserId String

  /* PÄRITOLU (L12). Kaks otsevälja, MAKSIMAALSELT ÜKS määratud — CHECK
     migratsioonis. Nad EI ole `CaseWorkItem` sihttüübid: sama seos kahel viisil
     laseks kahel tõel lahku minna.
     Päritolu määratakse loomisel ja V1-s ei muudeta. Päritoluobjekti kustutus
     annab `SetNull` — juhtum ise säilib. */
  preInquiryId    String?
  urgentRequestId String?

  /* KLIENT KAHEL RAJAL (L11), sama muster mis `ServiceReferral`-il ja
     `NetworkShare`-il (omaniku otsus 04.08).
       Rada A — `clientUserId`: platvormi kasutaja. V1-s tohib ta olla AINULT
       päritoluobjekti autor; kliendiotsingut ega kasutajakataloogi ei ole.
       Rada B — `clientDisplayName` / `clientExternalRef`: miinimumkuju, kuvanimi
       võib olla initsiaal või roll.
     Päritolu olemasolu EI KEELA rada B: pöördumise võib esitada lähedane või
     esindaja, ja siis ei ole autor klient. Automaatset tuletust ei tehta —
     `PreInquiry`-l ega `UrgentRequest`-il EI OLE kliendivälja, on ainult autor.
     `clientExternalRef` on ISIKU tunnus. Menetluse viide elab `externalReference`-is. */
  clientUserId      String?
  clientDisplayName String?
  clientExternalRef String?
  /// Kustutus nullib kõik kolm välja ja jätab ainult selle märke (L17).
  /// FK `SetNull` üksi EI PIISA — ta ei määra seda välja.
  clientErasedAt DateTime?

  /* STAR-i viide (L6). Mõlemad või kumbki — CHECK migratsioonis. */
  externalSystem    CaseWorkExternalSystem?
  externalReference String?

  nextContactAt DateTime?

  /* IDEMPOTENTSUSVÕTI (SOL-CW-12). Kliendi loodud võti; topeltklõps, võrgu
     timeout või kliendi korduskatse peavad andma SAMA juhtumi, mitte teist.
     Jõustaja on unikaalne indeks `(ownerUserId, clientActionId)`, mitte
     teenuskihi eelkontroll — kaks paralleelset päringut jõuaksid eelkontrollist
     mõlemad läbi. NULL on lubatud ja NULL-id ei põrka: vana klient ja
     serveripoolne loomine töötavad edasi. */
  clientActionId String?

  /// L14: ainult ACTIVE → READ_ONLY → ARCHIVED, tagasisiirdeid ei ole.
  /// READ_ONLY ja ARCHIVED keelavad ka LASTE muutmise; ainus erand on
  /// kliendiviite kustutus, mis on lubatud kõigis olekutes.
  retentionState CaseWorkRetentionState @default(ACTIVE)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  owner         User           @relation("CaseWorkAssistOwner", fields: [ownerUserId], references: [id], onDelete: Cascade)
  client        User?          @relation("CaseWorkAssistClient", fields: [clientUserId], references: [id], onDelete: SetNull)
  preInquiry    PreInquiry?    @relation("CaseWorkAssistPreInquiry", fields: [preInquiryId], references: [id], onDelete: SetNull)
  urgentRequest UrgentRequest? @relation("CaseWorkAssistUrgentRequest", fields: [urgentRequestId], references: [id], onDelete: SetNull)

  items          CaseWorkItem[]
  missingInfo    CaseWorkMissingInfo[]
  meetingPreps   CaseWorkMeetingPrep[]
  meetingNotes   CaseWorkMeetingNote[]
  drafts         CaseWorkDraft[]
  transferEvents CaseWorkTransferEvent[]
  retentionAudit CaseWorkRetentionAudit[]
  erasureAudit   CaseWorkClientErasureAudit[]

  /* ÜKS JUHTUM LÄHTEOBJEKTI KOHTA OMANIKU KOHTA (SOL-CW-12, omanik 09.08.2026).
     Postgres loeb NULL-id eristuvaks, seega päritoluta juhtumeid see ei puuduta
     ja sama pöördumisest võib juhtumi teha KAKS ERI töötajat. Jõustus on siin,
     mitte teenuskihis: kaks paralleelset päringut jõuaksid eelkontrollist
     mõlemad läbi ja tekitaksid kaks juhtumit ühest pöördumisest. */
  @@unique([ownerUserId, preInquiryId])
  @@unique([ownerUserId, urgentRequestId])
  @@unique([ownerUserId, clientActionId])
  @@index([ownerUserId, updatedAt])
  @@index([ownerUserId, retentionState, updatedAt])
  @@index([ownerUserId, nextContactAt])
  @@index([preInquiryId])
  @@index([urgentRequestId])
  @@index([clientUserId])
}

/* SEOS (L15) — TYPED-FK, MITTE POLÜMORFNE.

   `PreInquiry` skeemikommentaar ütleb platvormi reegli välja: „iga adressaadi-
   liik kannab oma võtit ja oma FK-d, muidu kaob referentsiaalne terviklikkus."
   Polümorfne `targetType + targetId` tähendaks, et lubadus „ei jää rippuvat
   viidet" on ainult nii tugev kui rakenduse kustutusteede kaetus. Typed-FK +
   `onDelete: Cascade` annab garantii ANDMEBAASIST — ta kehtib ka otse-SQL
   kustutuse korral.

   Hind on teadlik: uus sihttüüp on migratsioon, mitte rea lisamine loendisse.

   `updatedAt` PUUDUB TEADLIKULT — seos on kas olemas või mitte, teda ei muudeta. */
model CaseWorkItem {
  id               String @id @default(cuid())
  caseWorkAssistId String

  userDocumentId  String?
  agentArtifactId String?
  fieldVisitId    String?

  createdAt DateTime @default(now())

  caseWorkAssist CaseWorkAssist @relation(fields: [caseWorkAssistId], references: [id], onDelete: Cascade)
  userDocument   UserDocument?  @relation(fields: [userDocumentId], references: [id], onDelete: Cascade)
  agentArtifact  AgentArtifact? @relation(fields: [agentArtifactId], references: [id], onDelete: Cascade)
  fieldVisit     FieldVisit?    @relation(fields: [fieldVisitId], references: [id], onDelete: Cascade)

  /* NULL-e ei loeta Postgresis võrdseks, seega mitu `NULL`-iga rida elab kõrvuti
     ja unikaalsus kehtib ainult päris seostele — täpselt see, mida vaja. */
  @@unique([caseWorkAssistId, userDocumentId])
  @@unique([caseWorkAssistId, agentArtifactId])
  @@unique([caseWorkAssistId, fieldVisitId])
  @@index([caseWorkAssistId, createdAt])
}

model CaseWorkMissingInfo {
  id               String @id @default(cuid())
  caseWorkAssistId String

  text String @db.Text

  /* L5: päritolusõnastik on `lib/workspaces/provenance.js` (8 väärtust,
     CASEWORK-P0). TEKST, mitte DB-enum — muidu tekiks teine tõde ja sõnastiku
     muutus nõuaks migratsiooni. Sama põhjendus mis A4 `serviceKey`-l.
     Validaator elab teenuskihis ja tundmatu väärtus lükatakse tagasi. */
  provenance String

  status CaseWorkMissingInfoStatus @default(OPEN)
  /// Invariant: OPEN → NULL; RESOLVED/NOT_APPLICABLE → serveris määratud.
  resolvedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  caseWorkAssist CaseWorkAssist @relation(fields: [caseWorkAssistId], references: [id], onDelete: Cascade)

  @@index([caseWorkAssistId, status])
  @@index([caseWorkAssistId, createdAt])
}

/// JTA-V1 (E3) — ühe kohtumise ettevalmistus.
///
/// TEKSTITA MUDEL. Ainus sisuline väli on `meetingAt` ja tal EI OLE päritolu:
/// ajahetk ei ole autoritekst, vaid plaan. Kogu sisu elab `fields`-is ja
/// `questions`-is, sest just seal on igal real oma päritolu (L4).
///
/// MITU ETTEVALMISTUST ÜHE JUHTUMI KOHTA on lubatud (O-JTA-3): iga kohtumine on
/// oma. Seepärast ei ole siin `@@unique([caseWorkAssistId])`.
///
/// PUUDUVAT INFOT SIIA EI KOPEERITA. Vaade loeb juhtumi enda
/// `CaseWorkMissingInfo` lahtised punktid. Koopia oleks teine tõde ja läheks
/// esimese lahendamise järel originaalist lahku (ptk 4.7).
model CaseWorkMeetingPrep {
  id               String @id @default(cuid())
  caseWorkAssistId String

  /// Plaanitud kohtumise aeg. Võib puududa — ettevalmistust tohib alustada
  /// enne, kui aeg on kokku lepitud.
  meetingAt DateTime?

  /// Sisu purge'imise hetk (O-JTA-6, omaniku otsus 08.08). KONTEINER JÄÄB:
  /// kustuvad `fields` ja `questions` read, mitte see rida ega tema seosed —
  /// märge, mis sellele ettevalmistusele viitab, ei tohi jääda rippuma ega
  /// kaotada infot, et ettevalmistus üldse toimus.
  contentPurgedAt DateTime?

  /// MIKS sisu kustus. Ettevalmistusel EI OLE kella (ta ei lähe kuhugi üle),
  /// seega on ainus lubatud väärtus `WORKER_ARCHIVED_WORKING_MATERIAL` ja seda
  /// jõustab `CHECK`. Automaatne säilitustöö ei tohi siia kunagi kirjutada.
  contentPurgeReason CaseWorkPurgeReason?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  caseWorkAssist CaseWorkAssist             @relation(fields: [caseWorkAssistId], references: [id], onDelete: Cascade)
  fields         CaseWorkMeetingPrepField[]
  questions      CaseWorkQuestion[]
  meetingNotes   CaseWorkMeetingNote[]

  @@index([caseWorkAssistId, meetingAt])
  @@index([caseWorkAssistId, createdAt])
}

/// JTA-V1 (E3) — ettevalmistuse üks väli koos OMA päritoluga.
///
/// MIKS OMA TABEL (lepingu v4 parandus). Üks jäme `provenance` terve
/// ettevalmistuse peal ei suuda väljendada päris juhtu:
///
///     goal               → töötaja kirjutas   TOOTAJA_TAHELEPANEK
///     agenda             → töötaja kirjutas   TOOTAJA_TAHELEPANEK
///     plainLanguageNotes → AI koostas         AI_MUSTAND
///
/// Leping ütleb „AI koostatud OSA", mitte „AI koostatud ettevalmistus" — üks
/// märgis oleks pidanud kogu prep-i `AI_MUSTAND`-iks või kaotanud märgise
/// sealt, kus ta loeb.
model CaseWorkMeetingPrepField {
  id            String @id @default(cuid())
  meetingPrepId String

  fieldKey CaseWorkPrepFieldKey
  text     String               @db.Text

  /// L4: `NOT NULL`. Päritoluta sisu ei tohi tekkida — vt `CaseWorkMissingInfo`
  /// kommentaari selle kohta, miks see on tekst ja mitte enum.
  /// Märgist muudab AINULT `confirmProvenance()`; `PATCH` teda ei puutu.
  provenance String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  meetingPrep CaseWorkMeetingPrep @relation(fields: [meetingPrepId], references: [id], onDelete: Cascade)

  /// Üks rida välja kohta — vorm on väljade kogum, mitte ajalugu.
  @@unique([meetingPrepId, fieldKey])
  @@index([meetingPrepId])
}

/// JTA-V1 (E3) — täpsustav küsimus või kliendiga kontrollitav väide.
///
/// `ideed.md` ptk 12 nimi (`CaseWorkQuestion`), uut ei leiutata.
model CaseWorkQuestion {
  id            String @id @default(cuid())
  meetingPrepId String

  kind CaseWorkQuestionKind
  text String               @db.Text

  /// L4: `NOT NULL`, sama reegel mis väljal.
  provenance String

  /// Järjekord on töötaja oma — küsimused ei ole tähestikus ega ajas.
  ordinal Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  meetingPrep CaseWorkMeetingPrep @relation(fields: [meetingPrepId], references: [id], onDelete: Cascade)

  @@index([meetingPrepId, kind, ordinal])
  @@index([meetingPrepId, ordinal])
}

/// JTA-V1 (E4) — ühe kohtumise märge.
///
/// TEKSTITA KONTEINER, sama muster mis ettevalmistusel: kogu sisu elab
/// kirjetes, sest just seal on igal real oma KIHT ja oma PÄRITOLU (L4, L5).
///
/// SEOS ETTEVALMISTUSEGA ON VALIKULINE ja `SetNull`, mitte `Cascade`:
/// ettevalmistus on tulevikuplaan ja teda TOHIB kustutada (E3), aga märge on
/// kohtumise JÄLG — ta ei tohi kaduda koos plaaniga, mille põhjal kohtumine
/// toimus. Kustunud plaan jätab märkme alles ilma viiteta.
///
/// `DELETE` MÄRKMELE PUUDUB TEADLIKULT (E3-l on). Ettevalmistus kirjeldab
/// kohtumist, mida veel ei olnud; märge kirjeldab seda, mis juba juhtus. Üksik
/// kirje on eemaldatav, märge tervikuna mitte — juhtumi kustutus viib ta
/// kaskaadis.
model CaseWorkMeetingNote {
  id               String @id @default(cuid())
  caseWorkAssistId String
  meetingPrepId    String?

  /// Millal kohtumine toimus. Määratakse loomisel; märkme konteineril ei ole
  /// uuendusoperatsiooni, sest muutuv sisu elab kirjetes.
  meetingAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  caseWorkAssist CaseWorkAssist       @relation(fields: [caseWorkAssistId], references: [id], onDelete: Cascade)
  meetingPrep    CaseWorkMeetingPrep? @relation(fields: [meetingPrepId], references: [id], onDelete: SetNull)
  entries        CaseWorkMeetingNoteEntry[]

  @@index([caseWorkAssistId, meetingAt])
  @@index([caseWorkAssistId, createdAt])
  @@index([meetingPrepId])
}

/// JTA-V1 (E4) — märkme üks rida ühes kihist.
///
/// KAHEKSA KIHTI EI VALATA KOKKU (L5, ptk 4.4): kliendi enda vaade · faktilised
/// asjaolud · töötaja tähelepanek · kontrollimata info · kokkulepped · järgmised
/// sammud · STAR2-sse kantav info · privaatne professionaalne refleksioon.
///
/// `layer` on TEKST + validaator, MITTE DB-enum, ja see on lepingus nimeliselt
/// lukus (L5) — sama põhjendus mis `provenance`-il: kaheksa kihti on ptk 4.4
/// valdkonnasõnastik, mitte selle tabeli vorminupud. Erinevus `fieldKey`-st ja
/// `kind`-ist (E3), mis ON enum'id: nemad kirjeldavad ÜHE vormi kuju.
///
/// `PRIVAATNE_REFLEKSIOON` EI LÄHE STAR2-sse KUNAGI. E6 eksport ei tunne seda
/// väärtust; lisaks keelab teenuskiht kihi muutmise sellesse ja sellest välja,
/// et lubadust ei saaks ümber nimetamisega tühistada.
model CaseWorkMeetingNoteEntry {
  id            String @id @default(cuid())
  meetingNoteId String

  layer String
  text  String @db.Text

  /// L4: `NOT NULL`, sama reegel mis ettevalmistuse väljal ja küsimusel.
  provenance String

  ordinal Int @default(0)

  /* MITMES VERSIOON SEE RIDA ON (SOL-CW-15). 1 = esmane salvestus. Iga parandus
     kasvatab teda ühe võrra ja paneb ASENDATAVA versiooni
     `CaseWorkMeetingNoteEntryRevision`-isse. Ilma loendurita ei saaks ajalugu
     järjestada ega öelda, mitu korda rida on muutunud. */
  revision Int @default(1)

  /* TÜHISTUS, MITTE KUSTUTUS (SOL-CW-15). Varem oli kirje kõvasti kustutatav
     ilma versiooni, paranduse ega auditireata: kõik read sai ükshaaval ära
     võtta ja alles jäi tühi konteiner, mis näis endiselt kohtumise tõendina.
     Nüüd jääb rida alles, tema sisu läheb tühistuse hetkel ajalukku ja
     aktiivselt pinnalt kaob ainult tekst. */
  retractedAt DateTime?

  /* NEED KAKS OLID ANDMEBAASIS, AGA MITTE MUDELIS (SOL-SCHEMA-01).
     `20260808160000_jta_v1_meeting_note` lõi `"updatedAt" TIMESTAMP(3) NOT NULL`
     ILMA vaikeväärtuseta; mudel neid ei kandnud, seega Prisma ei saatnud neid
     kaasa ja iga kirje loomine kukkus päris PostgreSQL-is `23502`-ga. Sviit oli
     roheline, sest fake-Prisma ei jõusta `NOT NULL`-i, ja `db:migrate:check`
     rakendab migratsioone, aga ei kirjuta ühtegi rida. */
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  meetingNote CaseWorkMeetingNote                @relation(fields: [meetingNoteId], references: [id], onDelete: Cascade)
  revisions   CaseWorkMeetingNoteEntryRevision[]

  @@index([meetingNoteId, layer, ordinal])
  @@index([meetingNoteId, ordinal])
  @@index([meetingNoteId, retractedAt, ordinal])
}

/// Miks see versioon tekkis (SOL-CW-15).
enum CaseWorkNoteRevisionKind {
  /// Sisu asendati uuega. Rida kannab ASENDATUD versiooni.
  CORRECTION

  /// Rida võeti tagasi. Rida kannab tühistamise hetke sisu.
  RETRACTION
}

/* KOHTUMISE MÄRKME PARANDUSTE JA TÜHISTUSTE AJALUGU (SOL-CW-15).

   MIKS ERALDI TABEL, MITTE VÄLI KIRJE PEAL. Üks „eelmine tekst" väli kannaks
   ainult viimast muutust; teine parandus kirjutaks esimese üle ja lubadus
   „eelmine versioon säilib" katkeks vaikselt just siis, kui teda kõige rohkem
   vaja on — korduvalt muudetud rea juures.

   RIDA ON MUUTUMATU ja seda jõustab migratsioonis `BEFORE UPDATE` trigger, sama
   muster mis `UsageEvent`-il. `DELETE`-i trigger EI blokeeri: konto kustutus ja
   säilituse purge peavad kaskaadi kaudu läbi minema, ja nemad viivad kaasa kogu
   juhtumi, mitte üksiku tõendi. Piir on aus: sisu ei saa MUUTA, ta saab kaduda
   ainult koos juhtumiga. */
model CaseWorkMeetingNoteEntryRevision {
  id      String @id @default(cuid())
  entryId String

  /// Denormaliseeritud, sama muster mis `CaseWorkTransferEvent`-il: märkme
  /// ajaloo lugeja ei pea kirjetabelisse liituma.
  meetingNoteId String

  kind CaseWorkNoteRevisionKind

  /* SISU, MIS SEISAB SELLE VERSIOONI TAGA. Parandusel on see ASENDATUD tekst,
     tühistusel tühistamise hetke tekst. Kiht ja päritolu käivad kaasa, sest
     ka nemad on muudetavad ja ilma nendeta ei saaks vana rida taastada. */
  layer      String
  text       String @db.Text
  provenance String
  ordinal    Int

  /// Mitmes versioon see oli. 1 = esmane salvestus.
  revision Int

  /// PÕHJUS ON KOHUSTUSLIK. Parandus ilma põhjuseta on sama, mis parandus ilma
  /// jäljeta: hilisemas vaidluses ei erista miski eksituse parandamist sisu
  /// ümberkirjutamisest. Tühjust keelab `CHECK` migratsioonis.
  reason String @db.Text

  /// Kes tegi. Denormaliseeritud `String`, FK-ta — sama muster mis
  /// `CaseWorkTransferEvent.actorUserId`-l: audit peab üle elama ka konto
  /// kustutuse, mis FK `SetNull`-iga jätaks rea tegijata.
  actorUserId String

  createdAt DateTime @default(now())

  entry CaseWorkMeetingNoteEntry @relation(fields: [entryId], references: [id], onDelete: Cascade)

  @@index([entryId, revision])
  @@index([meetingNoteId, createdAt])
}

/// JTA-V1 (E5) — STAR2-sse kandmist ootav mustand. CASEWORK-P2 tuum.
///
/// TEKSTITA KONTEINER, sama muster mis ettevalmistusel ja märkmel: sisu elab
/// väljades, sest just seal on igal real oma päritolu (L4).
///
/// OLEKUMASIN EI SÜNNI SIIN — ta on `lib/workspaces/provenance.js`-is olemas ja
/// oli seni kasutamata: kuus seisu, lubatud üleminekud ja `canTransitionStar2()`.
/// E5 annab talle SALVESTUSE. `transferState` ja `reviewKind` on seetõttu TEKST
/// + `CHECK`, mitte enum: sõnastik peab jääma üheks tõeks.
///
/// KOLM `CHECK`-i migratsioonis jõustavad VÄÄRTUSI, mitte üleminekuid (L6):
/// üleminekut andmebaas ei oska kontrollida ja tema jõustaja on tingimuslik
/// `updateMany` teenuskihis. Aga „`transferredAt` on täidetud ⟺ seis on
/// `ULE_KANTUD`" on väärtuste vaheline invariant ja tema koht ON andmebaasis —
/// muidu saaks rakenduse viga jätta ülekantud mustandi ajatembita ja
/// säilituskell (L7) ei hakkaks kunagi käima.
model CaseWorkDraft {
  id               String @id @default(cuid())
  caseWorkAssistId String

  draftType CaseWorkDraftType

  /// `STAR2_TRANSFER_STATE` väärtus. Vaikimisi `MUSTAND` — ptk 4.5 järgi algab
  /// iga element sealt.
  transferState String @default("MUSTAND")

  /// `VAJAB_KONTROLLI` alamliik (`KLIENDIGA` / `DOKUMENDIGA`). Muudes seisudes
  /// `null` — ptk 2.2 järgi on ta selle ühe seisu täpsustus, mitte oma veerg
  /// kogu tee peale.
  reviewKind String?

  /// Ülekande hetk. Teda paneb AINULT E6 `markTransferred()` samas tehingus
  /// auditireaga (L18/L19) — siit käib säilituskell (L7).
  transferredAt DateTime?

  /// Sisu purge'imise hetk (E7). Rida jääb alles, `CaseWorkDraftField` read
  /// kustuvad — sisu sureb, tõend elab.
  contentPurgedAt DateTime?

  /// MIKS sisu kustus. `contentPurgedAt`-iga kahesuunaline: kumbki ei tohi
  /// eksisteerida ilma teiseta (`CHECK`), sest kuupäev ilma põhjuseta on
  /// eristamatu andmeveast.
  contentPurgeReason CaseWorkPurgeReason?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  caseWorkAssist CaseWorkAssist          @relation(fields: [caseWorkAssistId], references: [id], onDelete: Cascade)
  fields         CaseWorkDraftField[]
  transferEvents CaseWorkTransferEvent[]

  @@index([caseWorkAssistId, transferState])
  @@index([caseWorkAssistId, createdAt])
  @@index([transferState, transferredAt])
}

/// JTA-V1 (E5) — mustandi üks väli koos OMA päritoluga.
///
/// `fieldKey` on VABA MASINVÕTI, mitte sõnastik, ja see on teadlik V1 valik:
/// kaheksa mustanditüüpi kannavad eri struktuuri ning kanoonilist väljaloendit
/// ei ole veel kokku lepitud. Vorm on `CHECK`-iga piiratud (`^[A-Z][A-Z0-9_]*$`,
/// ≤ 64) — nii ei saa võtmest kogemata sisuvälja, kuhu keegi teksti kirjutab.
model CaseWorkDraftField {
  id      String @id @default(cuid())
  draftId String

  fieldKey String
  text     String @db.Text

  /// L4: `NOT NULL`. Päritoluta sisu ei tohi tekkida.
  provenance String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  draft CaseWorkDraft @relation(fields: [draftId], references: [id], onDelete: Cascade)

  /// Üks rida välja kohta — mustand on väljade kogum, mitte ajalugu.
  @@unique([draftId, fieldKey])
  @@index([draftId])
}

/* AUDITID (L8, L18, L21) — OMA MUDELID, MITTE `DataAuditLog`.

   `DataAuditLog` on ADMINI LOETAV (kasutusel `app/api/admin/usage/*`
   marsruutidel), ja retention-põhjus ON juhtumi sisu. L2 ütleb, et admin ei näe
   juhtumi sisu — seega olemasolev audititaristu ei sobi mõõdetud faktil, mitte
   eelistusel. `lib/privacy/audit.js` on sama tabeli ümbris.

   Kõik kolm on APPEND-ONLY: update- ja delete-API-t ei eksisteeri.
   `actorUserId` on FK-ta String (sama muster mis `DataAuditLog`-il) — auditirida
   ei tohi kaduda ega muutuda kasutaja kustutamisest. */

/// JTA-V1 (E6) — STAR2 ülekandeaudit. FAKT + VÄLJADE LOEND, MITTE SNAPSHOT (L8).
///
/// MIKS MITTE TÄISSNAPSHOT. Auditikirjed on append-only ja neil ei ole oma
/// säilituskella. Täissnapshot tähendaks, et L7 kustutab mustandi sisu 12 kuu
/// pärast, aga sama sisu elab siin edasi kuni juhtumi lõpuni — varju-register,
/// ehitatud täpselt selle mehhanismi sisse, mis pidi teda ära hoidma.
///
/// SEETÕTTU: `fieldKeys` kannab VÕTMEID, mitte väärtusi, ja kopeeritud teksti
/// siin ühelgi kujul ei ole. Seda kontrollib test andmete, mitte kutsete tasemel.
///
/// `draftType` ja `transferStateAtEvent` on TEO HETKE seis (L8) — mustandi enda
/// read liiguvad edasi ja auditirida peab ütlema, mis seisus ta TOL HETKEL oli.
///
/// KAKS FK-d ON `Cascade` ja see on säilitusmudeli osa (L8), mitte Prisma
/// vaikeväärtus: juhtumi kustutus peab olema TÄIELIK, ja `draftId` ei jää kunagi
/// rippuma, sest sisu purge (E7) kustutab `CaseWorkDraftField` read, MITTE
/// mustandi rida.
model CaseWorkTransferEvent {
  id               String @id @default(cuid())
  caseWorkAssistId String
  draftId          String

  /// Denormaliseeritud omanik — sama muster mis `CaseWorkRetentionAudit`-il.
  /// Laua sektsioon #10 loeb omaniku ridu ilma juhtumitabelisse liitumata.
  ownerUserId String
  actorUserId String

  kind CaseWorkTransferEventKind

  /// Mustandi tüüp ja seis TEO HETKEL (L8).
  draftType            CaseWorkDraftType
  transferStateAtEvent String

  /// Milliste väljade `fieldKey`-d kopeeriti. VÄÄRTUSI SIIN EI OLE.
  fieldKeys String[] @default([])

  /* KOPEERITUD SISU KANOONILINE SÕRMEJÄLG (SOL-CW-16, sha256 hex).
     Rida tõendas seni teo aega ja väljanimesid, aga MITTE seda, milline tekst
     lõikelauale läks: sisu sai auditi ja kopeerimise vahel asendada ja audit
     võeti vastu. Räsi seob rea tekstiversiooniga ILMA väärtusi hoidmata — L8
     keelab snapshot'i, sest see elaks üle E7 sisu-purge'i ja oleks
     varju-register. `String?`, sest `MARKED_AS_TRANSFERRED` real plokki ei ole;
     kohustuslikkust `kind` järgi jõustab `CHECK` migratsioonis. */
  contentHash String?

  /// L22 idempotentsusvõti. `String?` on TAHTLIK: Postgres loeb `NULL`-e
  /// unikaalses indeksis eristuvateks, seega `MARKED_AS_TRANSFERRED` read
  /// (võti `null`) ei põrka omavahel ja indeks piirab täpselt seda, mida ta
  /// piirama peab. Kohustuslikkust `kind` järgi jõustab `CHECK` migratsioonis.
  clientActionId String?

  createdAt DateTime @default(now())

  caseWorkAssist CaseWorkAssist @relation(fields: [caseWorkAssistId], references: [id], onDelete: Cascade)
  draft          CaseWorkDraft  @relation(fields: [draftId], references: [id], onDelete: Cascade)

  /// L22 JÕUSTAJA. Mitte teenuskihi „kas on juba olemas" kontroll — see on sama
  /// loe-kontrolli-kirjuta muster, mille L21 just maha võttis.
  @@unique([draftId, clientActionId])
  @@index([caseWorkAssistId, createdAt])
  @@index([ownerUserId, createdAt])
  @@index([draftId, createdAt])
}
/* SÄILITUSTÖÖ JOOKSU LOGI (SOL-CW-14).

   MIKS ANDMEBAASIS, MITTE LOGIFAILIS. Leid oli, et koodis olev säilitusreegel
   ei muutu iseenesest päris tööks: `runRetention()` oli olemas ja testitud, aga
   teda kutsus ainult käsitsi käivitatav skript ning cron oli näide skripti
   päises, mitte repositooriumi hallatav ajastus. Ilma püsiva jooksuseisuta ei
   saa keegi vastata kolmele küsimusele, mida järelevalve küsib: **millal töö
   viimati õnnestus**, **millal ta järgmine kord käib** ja **kas keegi märkab,
   kui ta lakkab käimast**. Logifail vastab neist mitte ühelegi masinloetavalt
   ja kaob koos hostiga.

   RIDA ON JOOKSU KOHTA, MITTE JUHTUMI KOHTA — siin ei ole ühtegi isikuandmete
   välja ja `CaseWorkRetentionAudit` (mis on juhtumi oma) jääb puutumata.

   VEATEADET SIIN EI SALVESTATA, ainult erindi klass ja kood. Prisma paneb
   ebaõnnestunud päringu argumendid teatesse ja mõni teenuskiht kirje teksti —
   sama põhjendus, mis laual (workbench L13). */
model CaseWorkRetentionRun {
  id String @id @default(cuid())

  startedAt  DateTime  @default(now())
  finishedAt DateTime?

  /// Kas jooks lõppes ilma tõrgeteta. `false` on ALARMI alus.
  ok Boolean @default(false)

  /// Kuiv käivitus ei kirjuta midagi ja EI KÕLBA tõendiks, et töö toimib.
  dryRun Boolean @default(false)

  /// Värav oli väljas — töö käis, aga tegi teadlikult 0 tööd.
  disabled Boolean @default(false)

  draftsPurged       Int @default(0)
  draftFieldsDeleted Int @default(0)
  warningsSent       Int @default(0)
  casesDeleted       Int @default(0)
  failed             Int @default(0)

  /// Erindi KLASS ja kood, mitte teade. Vt mudeli päist.
  errorName String?
  errorCode String?

  @@index([startedAt])
  @@index([ok, startedAt])
}

model CaseWorkRetentionAudit {
  id               String @id @default(cuid())
  caseWorkAssistId String
  ownerUserId      String
  actorUserId      String

  fromState CaseWorkRetentionState
  toState   CaseWorkRetentionState
  reason    String                 @db.Text

  createdAt DateTime @default(now())

  caseWorkAssist CaseWorkAssist @relation(fields: [caseWorkAssistId], references: [id], onDelete: Cascade)

  @@index([caseWorkAssistId, createdAt])
  @@index([ownerUserId, createdAt])
}

model CaseWorkClientErasureAudit {
  id               String @id @default(cuid())
  caseWorkAssistId String
  ownerUserId      String

  /// NULLABLE: konto kustutamise orkestreerija ei ole kasutaja (`SYSTEM`).
  actorUserId String?
  actorKind   CaseWorkErasureActorKind

  /// EI SISALDA kustutatud väärtusi — ei nime, ei välisviidet, ei kuvanime.
  reason String @db.Text

  createdAt DateTime @default(now())

  caseWorkAssist CaseWorkAssist @relation(fields: [caseWorkAssistId], references: [id], onDelete: Cascade)

  @@index([caseWorkAssistId, createdAt])
  @@index([ownerUserId, createdAt])
}
