  recipientOwner User?            @relation("PreInquiryRecipientOwner", fields: [recipientOwnerId], references: [id], onDelete: SetNull)
  recipientEntry ServiceMapEntry? @relation(fields: [recipientEntryId], references: [id], onDelete: SetNull)
  sourceJourney  Journey?         @relation(fields: [sourceJourneyId], references: [id], onDelete: SetNull)
  supersededBy   PreInquiry?      @relation("PreInquirySupersession", fields: [supersededById], references: [id], onDelete: SetNull)
  supersedes     PreInquiry?      @relation("PreInquirySupersession")
  covisionCases  CovisionCase[]

  @@index([authorId, updatedAt])
  @@index([authorId, sentAt])
  @@index([recipientOwnerId, updatedAt])
  @@index([recipientOwnerId, recalledAt, updatedAt])
  @@index([recipientOwnerId, nextContactOn, status])
  @@index([recipientEntryId])
  @@index([sourceJourneyId])
  @@index([recipientType])
  @@index([deliveryChannel])
  @@index([status])
  @@index([createdAt])
}

model NotificationEvent {
