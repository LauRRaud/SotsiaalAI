model HelpRequestCategory {
  requestId  String
  categoryId String

  request  HelpRequest  @relation(fields: [requestId], references: [id], onDelete: Cascade)
  category HelpCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@id([requestId, categoryId])
  @@index([categoryId])
}

model HelpOfferCategory {
  offerId    String
  categoryId String

  offer    HelpOffer    @relation(fields: [offerId], references: [id], onDelete: Cascade)
  category HelpCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@id([offerId, categoryId])
  @@index([categoryId])
}

model HelpRequestTargetGroup {
  requestId     String
  targetGroupId String

  request     HelpRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  targetGroup TargetGroup @relation(fields: [targetGroupId], references: [id], onDelete: Cascade)

  @@id([requestId, targetGroupId])
  @@index([targetGroupId])
}

model HelpOfferTargetGroup {
  offerId       String
  targetGroupId String

  offer       HelpOffer   @relation(fields: [offerId], references: [id], onDelete: Cascade)
  targetGroup TargetGroup @relation(fields: [targetGroupId], references: [id], onDelete: Cascade)

  @@id([offerId, targetGroupId])
  @@index([targetGroupId])
}

model HelpMatch {
  id            String          @id @default(cuid())
  requestId     String
  offerId       String
  requesterId   String
  offererId     String
  initiatedByUserId String
  roomId        String?         @unique
  status        HelpMatchStatus @default(PENDING)
  scoreSnapshot Float?
  reasonsJson   Json?
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  request   HelpRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  offer     HelpOffer   @relation(fields: [offerId], references: [id], onDelete: Cascade)
  requester User        @relation("HelpMatchRequester", fields: [requesterId], references: [id], onDelete: Cascade)
  offerer   User        @relation("HelpMatchOfferer", fields: [offererId], references: [id], onDelete: Cascade)
  room      Room?       @relation(fields: [roomId], references: [id], onDelete: SetNull)

  @@unique([requestId, offerId])
  @@index([requesterId])
  @@index([offererId])
  @@index([initiatedByUserId])
  @@index([roomId])
  @@index([status])
}

model Room {
  id            String   @id @default(cuid())
  ownerId       String
  title         String?
  description   String?
  originType    String?
  originId      String?
  originLabel   String?
  originMeta    Json?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  owner     User          @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  members   RoomMember[]
  invites   Invite[]
  messages  RoomMessage[]
  helpMatch HelpMatch?
  calls     CallSession[]

  @@index([ownerId])
  @@index([originType])
  @@index([originId])
  @@index([originType, originId])
}

model RoomMember {
  id            String        @id @default(cuid())
  roomId        String
  userId        String
  role          RoomRole      @default(MEMBER)
  displayName   String?
  billingSource BillingSource @default(SELF)
  sponsorUserId String?
  sponsorOrgId  String?
  joinedAt      DateTime      @default(now())
  leftAt        DateTime?
  lastReadAt    DateTime?

  room        Room  @relation(fields: [roomId], references: [id], onDelete: Cascade)
  user        User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  sponsorUser User? @relation("RoomMemberSponsorUser", fields: [sponsorUserId], references: [id], onDelete: SetNull)

  @@unique([roomId, userId])
  @@index([userId])
}

model Invite {
  id                    String            @id @default(cuid())
  roomId                String
  inviterId             String
  inviteeEmail          String
  tokenHash             String            @unique
  status                InviteStatus      @default(SENT)
  relationshipType      RelationshipType  @default(COLLEAGUE)
  paymentMode           InvitePaymentMode @default(SELF_PAID)
  sponsoredByUserId     String?
  sponsoredByOrgId      String?
  sponsoredRole         Role?
  sponsoredPlan         String?
  sponsoredPaidAt       DateTime?
  expiresAt             DateTime
  maxUses               Int               @default(1)
  useCount              Int               @default(0)
  createdAt             DateTime          @default(now())
  acceptedBillingSource BillingSource?
  acceptedByUserId      String?

  room                 Room           @relation(fields: [roomId], references: [id], onDelete: Cascade)
  inviter              User           @relation("InviterUser", fields: [inviterId], references: [id], onDelete: Cascade)
  sponsoredByUser      User?          @relation("InviteSponsorUser", fields: [sponsoredByUserId], references: [id], onDelete: SetNull)
  acceptedByUser       User?          @relation("InviteAcceptedBy", fields: [acceptedByUserId], references: [id], onDelete: SetNull)
  payments             Payment[]
  grantedSubscriptions Subscription[] @relation("InviteGrantedSubscription")

  @@index([roomId, status])
  @@index([tokenHash])
  @@index([expiresAt])
  @@index([sponsoredRole])
}

model RoomMessage {
  id         String                @id @default(cuid())
  roomId     String
  authorId   String
  senderType RoomMessageSenderType @default(USER)
  content    String                @db.Text
  createdAt  DateTime              @default(now())
  deletedAt  DateTime?

  room   Room @relation(fields: [roomId], references: [id], onDelete: Cascade)
  author User @relation("RoomMessageAuthor", fields: [authorId], references: [id], onDelete: Cascade)

  @@index([roomId, createdAt])
  @@index([roomId, id])
}

model CallSession {
  id               String            @id @default(cuid())
  contextType      CallContextType   @default(ROOM)
  contextId        String
  roomId           String?
  provider         CallProvider      @default(MOCK)
  providerRoomName String
  mode             CallMode          @default(AUDIO)
  status           CallSessionStatus @default(ACTIVE)
  startedByUserId  String
  startedAt        DateTime          @default(now())
  endedAt          DateTime?
  maxParticipants  Int               @default(8)
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  room              Room?                  @relation(fields: [roomId], references: [id], onDelete: SetNull)
  startedBy         User                   @relation("CallSessionStartedBy", fields: [startedByUserId], references: [id], onDelete: Cascade)
  participants      CallParticipant[]
  speakRequests     CallSpeakRequest[]
  recordingRequests CallRecordingRequest[]
  recordingFiles    CallRecordingFile[]

  @@index([contextType, contextId, status])
  @@index([roomId, status])
  @@index([startedByUserId, startedAt])
}

model CallParticipant {
  id            String              @id @default(cuid())
  callSessionId String
  userId        String
  role          CallParticipantRole @default(PARTICIPANT)
  joinedAt      DateTime            @default(now())
  leftAt        DateTime?
  micMuted      Boolean             @default(false)
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt

  callSession CallSession @relation(fields: [callSessionId], references: [id], onDelete: Cascade)
  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([callSessionId, leftAt])
  @@index([callSessionId, userId])
  @@index([userId, joinedAt])
}

model CallSpeakRequest {
  id               String                 @id @default(cuid())
  callSessionId    String
  userId           String
  status           CallSpeakRequestStatus @default(ACTIVE)
  requestedAt      DateTime               @default(now())
  resolvedAt       DateTime?
  resolvedByUserId String?
  createdAt        DateTime               @default(now())
  updatedAt        DateTime               @updatedAt

  callSession CallSession @relation(fields: [callSessionId], references: [id], onDelete: Cascade)
  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  resolvedBy  User?       @relation("CallSpeakRequestResolvedBy", fields: [resolvedByUserId], references: [id], onDelete: SetNull)

  @@index([callSessionId, status, requestedAt])
  @@index([userId, status])
}

model CallRecordingRequest {
  id                  String                     @id @default(cuid())
  callSessionId       String
  requestedByUserId   String
  purpose             CallRecordingPurpose       @default(GENERAL_SUMMARY)
  purposeText         String?                    @db.Text
  status              CallRecordingRequestStatus @default(REQUESTED)
  consentTextVersion  String
  consentTextSnapshot String                     @db.Text
  requestedAt         DateTime                   @default(now())
  startedAt           DateTime?
  stoppedAt           DateTime?
  completedAt         DateTime?
  createdAt           DateTime                   @default(now())
  updatedAt           DateTime                   @updatedAt

  callSession CallSession            @relation(fields: [callSessionId], references: [id], onDelete: Cascade)
  requestedBy User                   @relation("CallRecordingRequestRequestedBy", fields: [requestedByUserId], references: [id], onDelete: Cascade)
  consents    CallRecordingConsent[]
  files       CallRecordingFile[]

  @@index([callSessionId, status])
  @@index([requestedByUserId, requestedAt])
}

model CallRecordingConsent {
  id                  String                     @id @default(cuid())
  recordingRequestId  String
  callSessionId       String
  userId              String
  status              CallRecordingConsentStatus @default(REQUESTED)
  consentTextVersion  String
  consentTextSnapshot String                     @db.Text
  respondedAt         DateTime?
  withdrawnAt         DateTime?
  ipAddressHash       String?
  userAgentHash       String?
  createdAt           DateTime                   @default(now())
  updatedAt           DateTime                   @updatedAt

  recordingRequest CallRecordingRequest @relation(fields: [recordingRequestId], references: [id], onDelete: Cascade)
  user             User                 @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([recordingRequestId, status])
  @@index([callSessionId, userId])
}

model CallRecordingFile {
  id                 String                  @id @default(cuid())
  recordingRequestId String
  callSessionId      String
  egressId           String?
  storageProvider    String?
  filePath           String?
  mimeType           String?
  fileSizeBytes      Int?
  durationSeconds    Int?
  checksum           String?
  status             CallRecordingFileStatus @default(NOT_CREATED)
  createdDocumentId  String?
  retentionUntil     DateTime?
  createdAt          DateTime                @default(now())
  updatedAt          DateTime                @updatedAt

  recordingRequest CallRecordingRequest @relation(fields: [recordingRequestId], references: [id], onDelete: Cascade)
  callSession      CallSession          @relation(fields: [callSessionId], references: [id], onDelete: Cascade)
  createdDocument  UserDocument?        @relation(fields: [createdDocumentId], references: [id], onDelete: SetNull)

  @@index([recordingRequestId, status])
  @@index([callSessionId, status])
  @@index([createdDocumentId])
}

model UserDocument {
  id                    String       @id @default(cuid())
  ownerId               String
  title                 String
  originalName          String
  kind                  DocumentKind @default(MATERIAL)
  templateFor           TemplateFor?
  agentAllowed          Boolean      @default(false)
  mime                  String
  size                  Int
  sha256                String
  storagePath           String
  sourceDocumentId      String?
  content               String?      @db.Text
  metadata              Json?
  frameworkAcceptanceId String?      @unique
  createdAt             DateTime     @default(now())
  updatedAt             DateTime     @updatedAt

  owner               User                          @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  frameworkAcceptance FrameworkAcceptance?          @relation(fields: [frameworkAcceptanceId], references: [id], onDelete: SetNull)
  sourceDocument      UserDocument?                  @relation("UserDocumentSource", fields: [sourceDocumentId], references: [id], onDelete: SetNull)
  derivedDocuments    UserDocument[]                 @relation("UserDocumentSource")
  templateArtifacts   AgentArtifact[]               @relation("AgentArtifactTemplate")
  sourceArtifactLinks AgentArtifactSourceDocument[]
  sourceTranscriptionJobs TranscriptionJob[]             @relation("TranscriptionJobSource")
  transcriptTranscriptionJobs TranscriptionJob[]         @relation("TranscriptionJobTranscript")
  audits              DocumentAudit[]
  callRecordingFiles  CallRecordingFile[]

  @@index([ownerId, updatedAt])
  @@index([ownerId, kind, updatedAt])
  @@index([ownerId, agentAllowed, updatedAt])
  @@index([sourceDocumentId])
  @@index([sha256])
}

model FrameworkAcceptance {
  id                         String    @id @default(cuid())
  userId                     String
  frameworkKey               String
  frameworkVersion           String
  acceptanceType             String
  acceptanceSource           String
  roleAtAcceptance           Role
  locale                     String?
  ipAddress                  String?
  userAgent                  String?
  acceptedAt                 DateTime  @default(now())
  reviewDocumentOpenedAt     DateTime?
  signedDocumentDownloadedAt DateTime?
  createdAt                  DateTime  @default(now())
  updatedAt                  DateTime  @updatedAt

  user     User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  document UserDocument?

  @@index([userId, acceptedAt])
  @@index([frameworkKey, frameworkVersion, acceptedAt])
  @@index([acceptanceType, acceptedAt])
}

model AgentArtifact {
  id         String              @id @default(cuid())
  ownerId    String
  type       AgentArtifactType
  title      String?
  status     AgentArtifactStatus @default(DRAFT)
  content    String              @db.Text
  metadata   Json?
  approvedAt DateTime?
  templateId String?
  createdAt  DateTime            @default(now())
  updatedAt  DateTime            @updatedAt

  owner           User                          @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  template        UserDocument?                 @relation("AgentArtifactTemplate", fields: [templateId], references: [id], onDelete: SetNull)
  sourceDocuments AgentArtifactSourceDocument[]
  audits          DocumentAudit[]

  @@index([ownerId, updatedAt])
  @@index([ownerId, type, updatedAt])
  @@index([ownerId, status, updatedAt])
  @@index([templateId])
}

model TranscriptionJob {
  id                   String                 @id @default(cuid())
  sourceDocumentId     String
  requestedByUserId    String
  transcriptDocumentId String?
  provider             String
  model                String?
  language             String?
  status               TranscriptionJobStatus @default(QUEUED)
  error                String?
  startedAt            DateTime?
  completedAt          DateTime?
  cancelledAt          DateTime?
  createdAt            DateTime               @default(now())
  updatedAt            DateTime               @updatedAt

  sourceDocument     UserDocument  @relation("TranscriptionJobSource", fields: [sourceDocumentId], references: [id], onDelete: Cascade)
  requestedBy        User          @relation(fields: [requestedByUserId], references: [id], onDelete: Cascade)
  transcriptDocument UserDocument? @relation("TranscriptionJobTranscript", fields: [transcriptDocumentId], references: [id], onDelete: SetNull)

  @@index([sourceDocumentId, status])
  @@index([requestedByUserId, status])
  @@index([transcriptDocumentId])
  @@index([createdAt])
}

model AgentArtifactSourceDocument {
  artifactId String
  documentId String
  createdAt  DateTime @default(now())

  artifact AgentArtifact @relation(fields: [artifactId], references: [id], onDelete: Cascade)
  document UserDocument  @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@id([artifactId, documentId])
  @@index([documentId])
}

model DocumentAudit {
  id         String              @id @default(cuid())
  ownerId    String
  documentId String?
  artifactId String?
  action     DocumentAuditAction
  meta       Json?
  createdAt  DateTime            @default(now())

  owner    User           @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  document UserDocument?  @relation(fields: [documentId], references: [id], onDelete: SetNull)
  artifact AgentArtifact? @relation(fields: [artifactId], references: [id], onDelete: SetNull)

  @@index([ownerId, createdAt])
  @@index([documentId, createdAt])
  @@index([artifactId, createdAt])
  @@index([action, createdAt])
}

model MaterialSubmission {
  id                String    @id @default(cuid())
  submittedByUserId String
  comment           String    @db.Text
  originalName      String
  mime              String
  size              Int
  sha256            String
  storagePath       String
  status            String    @default("pending")
  reviewedAt        DateTime?
  reviewedBy        String?
  reviewNote        String?   @db.Text
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  submittedByUser User @relation(fields: [submittedByUserId], references: [id], onDelete: Cascade)

  @@index([submittedByUserId, createdAt])
  @@index([createdAt])
  @@index([sha256])
  @@index([status, createdAt])
  @@index([reviewedAt])
}

// ---------------------------------------------------------------------------
// RAG graph-lite (phase 1): deterministic knowledge-graph layer.
// Tables are created by a future migration; phase 1 ships schema + offline
// builders only. Every relation must carry evidence (source document and/or
// chunk reference). See docs/internal/rag-roadmap.md track C.
// ---------------------------------------------------------------------------

enum RagEntityType {
  SERVICE
  BENEFIT
  LAW
  LEGAL_SECTION
  MUNICIPALITY
  ORGANIZATION
  FORM
  CONTACT_POINT
  TARGET_GROUP
  NEED
  RISK_SIGNAL
  DOCUMENT_TYPE
  WORKFLOW
}

enum RagRelationType {
  REGULATES
  BELONGS_TO
  PROVIDED_BY
  ORGANIZED_BY
  SUITABLE_FOR
  REQUIRES
  RELATED_TO
  HAS_LEGAL_BASIS
  HAS_DOCUMENT
  HAS_FORM
  HAS_NEXT_STEP
  HAS_CONTACT_POINT
  ASSESSES
  MITIGATES_RISK
  ESCALATES_TO
  APPLIES_TO
  AVAILABLE_IN
}

enum RagGraphReviewStatus {
  AUTO_APPROVED
  NEEDS_REVIEW
  APPROVED
  REJECTED
}

model RagEntity {
  id             String               @id @default(cuid())
  type           RagEntityType
  name           String
  normalizedName String
  externalKey    String               @unique
  aliases        String[]             @default([])
  roles          String[]             @default([])
  description    String?              @db.Text
  confidence     Float                @default(1)
  reviewStatus   RagGraphReviewStatus @default(AUTO_APPROVED)
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt

  relationsFrom RagRelation[]    @relation("RagRelationFrom")
  relationsTo   RagRelation[]    @relation("RagRelationTo")
  chunkLinks    RagChunkEntity[]

  @@index([type, normalizedName])
  @@index([normalizedName])
}

model RagRelation {
  id               String               @id @default(cuid())
  fromEntityId     String
  toEntityId       String
  relationType     RagRelationType
  confidence       Float                @default(1)
  evidenceChunkId  String?
  sourceDocumentId String?
  evidenceRef      String?
  extractor        String               @default("deterministic_kov_v1")
  reviewStatus     RagGraphReviewStatus @default(AUTO_APPROVED)
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt

  fromEntity RagEntity @relation("RagRelationFrom", fields: [fromEntityId], references: [id], onDelete: Cascade)
  toEntity   RagEntity @relation("RagRelationTo", fields: [toEntityId], references: [id], onDelete: Cascade)

  @@unique([fromEntityId, toEntityId, relationType, sourceDocumentId])
  @@index([relationType])
  @@index([toEntityId])
}

model RagChunkEntity {
  id           String   @id @default(cuid())
  chunkId      String
  entityId     String
  relevance    Float    @default(1)
  evidenceText String?  @db.Text
  createdAt    DateTime @default(now())

  entity RagEntity @relation(fields: [entityId], references: [id], onDelete: Cascade)

  @@unique([chunkId, entityId])
  @@index([entityId])
}
