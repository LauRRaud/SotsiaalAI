/**
 * ---------- Models ----------
 */

model User {
  id                      String    @id @default(cuid())
  email                   String?   @unique
  emailVerified           DateTime?
  emailVerificationSentAt DateTime?
  passwordHash            String?
  role                    Role      @default(CLIENT)
  isAdmin                 Boolean   @default(false)
  sessionVersion          Int       @default(0)
  accessSuspendedAt       DateTime?
  accessSuspendedReason   String?
  accessSuspendedByUserId String?
  acceptsPreInquiries     Boolean   @default(false)
  notificationEmailEnabled Boolean?
  notificationPreferenceVersion Int @default(0)

  // NextAuth
  accounts Account[]
  sessions Session[]

  // Äri
  profile                Profile?
  subscriptions          Subscription[]
  payments               Payment[]
  billingMethods         BillingMethod[]
  sponsoredSubscriptions Subscription[]        @relation("SubscriptionSponsorUser")
  ragDocuments           RagDocument[]
  documents              UserDocument[]
  transcriptionJobs      TranscriptionJob[]
  agentArtifacts         AgentArtifact[]
  documentAudits         DocumentAudit[]
  frameworkAcceptances   FrameworkAcceptance[]
  materialSubmissions    MaterialSubmission[]

  // Chat / runs
  conversationRuns        ConversationRun[]
  conversationMessages    ConversationMessage[]
  conversations           Conversation[]
  usageBuckets            UsageBucket[]
  usageReservations       UsageReservation[]
  usageEvents             UsageEvent[]
  usageOverrides          UserEntitlementOverride[] @relation("UsageOverrideUser")
  grantedUsageOverrides   UserEntitlementOverride[] @relation("UsageOverrideAdmin")
  emailOtpCodes           EmailOtpCode[]
  trustedDevices          TrustedDevice[]
  loginTempTokens         LoginTempToken[]
  roomsOwned              Room[]
  roomMemberships         RoomMember[]
  sentInvites             Invite[]                 @relation("InviterUser")
  sponsoredInvites        Invite[]                 @relation("InviteSponsorUser")
  sponsoredMembers        RoomMember[]             @relation("RoomMemberSponsorUser")
  acceptedInvites         Invite[]                 @relation("InviteAcceptedBy")
  roomMessages            RoomMessage[]            @relation("RoomMessageAuthor")
  callSessionsStarted     CallSession[]            @relation("CallSessionStartedBy")
  callParticipants        CallParticipant[]
  callSpeakRequests       CallSpeakRequest[]
  callSpeakRequestsClosed CallSpeakRequest[]        @relation("CallSpeakRequestResolvedBy")
  callRecordingRequests   CallRecordingRequest[]    @relation("CallRecordingRequestRequestedBy")
  callRecordingConsents   CallRecordingConsent[]
  helpRequests            HelpRequest[]
  helpOffers              HelpOffer[]
  requestedHelpMatches    HelpMatch[]              @relation("HelpMatchRequester")
  offeredHelpMatches      HelpMatch[]              @relation("HelpMatchOfferer")
  researchJobs            ResearchJob[]
  serviceProviderProfiles ServiceProviderProfile[]
  authoredPreInquiries    PreInquiry[]             @relation("PreInquiryAuthor")
  receivedPreInquiries    PreInquiry[]             @relation("PreInquiryRecipientOwner")
  journeys                Journey[]
  wellbeingRecords        WellbeingRecord[]
  wellbeingOutputDrafts   WellbeingOutputDraft[]
  wellbeingPilotViewers   WellbeingPilotViewer[]
  covisionCasesOwned      CovisionCase[]           @relation("CovisionCaseOwner")
  covisionParticipants    CovisionParticipant[]    @relation("CovisionParticipantUser")
  covisionMessages        CovisionMessage[]        @relation("CovisionMessageAuthor")
  effectivePractices      EffectivePractice[]      @relation("EffectivePracticeAuthor")
  topicSeeds              TopicSeed[]              @relation("TopicSeedOwner")
  covisionPrivateStates   CovisionPrivateState[]   @relation("CovisionPrivateStateUser")
  covisionStageSnapshots  CovisionStageSnapshot[]  @relation("CovisionStageSnapshotCompleter")
  covisionClosuresOwned   CovisionClosure[]        @relation("CovisionClosureOwner")
  covisionClosuresClosed  CovisionClosure[]        @relation("CovisionClosureClosedBy")
  covisionClosuresAssigned CovisionClosure[]       @relation("CovisionClosureAssignee")
  covisionFollowUps       CovisionFollowUp[]       @relation("CovisionFollowUpAssignee")
  covisionFollowUpsDone   CovisionFollowUp[]       @relation("CovisionFollowUpCompleter")
  covisionOwnerPackages   CovisionOwnerPackage[]   @relation("CovisionOwnerPackageOwner")
  practiceCapabilities       PracticeCapability[]           @relation("PracticeCapabilityUser")
  practiceCapabilitiesGranted PracticeCapability[]          @relation("PracticeCapabilityGranter")
  effectivePracticeReviews   EffectivePracticeReview[]      @relation("EffectivePracticeReviewer")
  effectivePracticeReviewAssignments EffectivePracticeReviewAssignment[] @relation("EffectivePracticeReviewAssignee")
  effectivePracticeVersions  EffectivePracticeVersion[]     @relation("EffectivePracticeVersionPublisher")
  effectivePracticeApplications EffectivePracticeApplication[] @relation("EffectivePracticeApplicationAuthor")
  effectivePracticeApplicationsReviewed EffectivePracticeApplication[] @relation("EffectivePracticeApplicationReviewer")
  effectivePracticeApplicationsAssigned EffectivePracticeApplication[] @relation("EffectivePracticeApplicationAssignee")
  practiceCapabilityAuditsTarget PracticeCapabilityAudit[]      @relation("PracticeCapabilityAuditTarget")
  practiceCapabilityAuditsActor PracticeCapabilityAudit[]       @relation("PracticeCapabilityAuditActor")
  effectivePracticeAuditEvents EffectivePracticeAuditEvent[]    @relation("EffectivePracticeAuditActor")
  sourceFeedbackReported       SourceFeedback[]                  @relation("SourceFeedbackReporter")
  sourceFeedbackResolved       SourceFeedback[]                  @relation("SourceFeedbackResolver")
  notificationEvents           NotificationEvent[]
  domainEventsActed            DomainEvent[]              @relation("DomainEventActor")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([acceptsPreInquiries])
  @@index([accessSuspendedAt])
}

model Profile {
  id        String  @id @default(cuid())
  userId    String  @unique
  firstName String?
  lastName  String?
  phone     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Account {
  id                String @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String

  refresh_token String?
  access_token  String?
  expires_at    Int?
  token_type    String?
  scope         String?
  id_token      String?
  session_state String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Subscription {
  id                String             @id @default(cuid())
  userId            String
  status            SubscriptionStatus @default(NONE)
  plan              String             @default("free")
  billingMode       BillingMode        @default(ONE_OFF)
  billingInterval   BillingInterval?
  billingMethodId   String?
  billingSource     BillingSource      @default(SELF)
  sponsorUserId     String?
  inviteId          String?
  validUntil        DateTime?
  nextBilling       DateTime?
  lastBilledAt      DateTime?
  pastDueSince      DateTime?
  billingRetryCount Int                @default(0)
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  canceledAt        DateTime?
  planDefinitionId  String?

  user           User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  planDefinition PlanDefinition? @relation(fields: [planDefinitionId], references: [id], onDelete: SetNull)
  billingMethod  BillingMethod?  @relation(fields: [billingMethodId], references: [id], onDelete: SetNull)
  sponsorUser    User?           @relation("SubscriptionSponsorUser", fields: [sponsorUserId], references: [id], onDelete: SetNull)
  invite         Invite?         @relation("InviteGrantedSubscription", fields: [inviteId], references: [id], onDelete: SetNull)
  payments       Payment[]

  @@index([userId])
  @@index([status])
  @@index([validUntil])
  @@index([billingMode])
  @@index([billingMethodId])
  @@index([billingSource])
  @@index([sponsorUserId])
  @@index([inviteId])
  @@index([planDefinitionId])
}

model PlanDefinition {
  id            String    @id @default(cuid())
  key           String
  name          String
  role          Role
  price         Decimal   @db.Decimal(10, 2)
  currency      String    @default("EUR")
  version       Int       @default(1)
  active        Boolean   @default(true)
  effectiveFrom DateTime  @default(now())
  effectiveTo   DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  entitlements  PlanEntitlement[]
  subscriptions Subscription[]

  @@unique([key, version], name: "key_version")
  @@index([role, active])
  @@index([key, active])
}

model PlanEntitlement {
  id               String      @id @default(cuid())
  planDefinitionId String
  metric           UsageMetric
  enabled          Boolean     @default(true)
  softLimit        BigInt?
  hardLimit        BigInt?
  period           UsagePeriod
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt

  planDefinition PlanDefinition @relation(fields: [planDefinitionId], references: [id], onDelete: Cascade)

  @@unique([planDefinitionId, metric], name: "planDefinitionId_metric")
  @@index([metric, enabled])
}

model UserEntitlementOverride {
  id               String       @id @default(cuid())
  userId           String
  metric           UsageMetric
  enabled          Boolean?
  softLimit        BigInt?
  hardLimit        BigInt?
  period           UsagePeriod?
  reason           String
  validFrom        DateTime     @default(now())
  validUntil       DateTime?
  createdByAdminId String
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  user           User @relation("UsageOverrideUser", fields: [userId], references: [id], onDelete: Cascade)
  createdByAdmin User @relation("UsageOverrideAdmin", fields: [createdByAdminId], references: [id], onDelete: Restrict)

  @@index([userId, metric, validFrom])
  @@index([createdByAdminId, createdAt])
  @@index([validUntil])
}

model UsageBucket {
  id          String      @id @default(cuid())
  userId      String
  metric      UsageMetric
  period      UsagePeriod
  periodStart DateTime
  periodEnd   DateTime
  softLimit   BigInt?
  hardLimit   BigInt
  used        BigInt      @default(0)
  reserved    BigInt      @default(0)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  user         User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  reservations UsageReservation[]
  events       UsageEvent[]

  @@unique([userId, metric, periodStart, periodEnd], name: "userId_metric_periodStart_periodEnd")
  @@index([userId, periodEnd])
  @@index([metric, periodStart])
}

model UsageReservation {
  id              String                 @id @default(cuid())
  userId          String
  bucketId        String
  metric          UsageMetric
  idempotencyKey  String
  reservedAmount  BigInt
  committedAmount BigInt?
  status          UsageReservationStatus @default(RESERVED)
  expiresAt       DateTime?
  committedAt     DateTime?
  releasedAt      DateTime?
  releaseReason   String?
  metadata        Json?
  createdAt       DateTime               @default(now())
  updatedAt       DateTime               @updatedAt

  user   User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  bucket UsageBucket  @relation(fields: [bucketId], references: [id], onDelete: Cascade)
  events UsageEvent[]

  @@unique([userId, idempotencyKey], name: "userId_idempotencyKey")
  @@index([bucketId, status])
  @@index([status, expiresAt])
}

model UsageEvent {
  id             String         @id @default(cuid())
  userId         String
  bucketId       String
  reservationId  String?
  metric         UsageMetric
  type           UsageEventType
  amount         BigInt
  idempotencyKey String         @unique
  modelPriceId   String?
  metadata       Json?
  createdAt      DateTime       @default(now())

  user        User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  bucket      UsageBucket       @relation(fields: [bucketId], references: [id], onDelete: Cascade)
  reservation UsageReservation? @relation(fields: [reservationId], references: [id], onDelete: SetNull)
  modelPrice  ModelPrice?       @relation(fields: [modelPriceId], references: [id], onDelete: SetNull)

  @@index([userId, metric, createdAt])
  @@index([bucketId, createdAt])
  @@index([reservationId])
  @@index([modelPriceId])
}

model ModelPrice {
  id                    String    @id @default(cuid())
  model                 String
  currency              String    @default("EUR")
  inputPerMillion       Decimal   @db.Decimal(18, 6)
  cachedInputPerMillion Decimal   @db.Decimal(18, 6)
  outputPerMillion      Decimal   @db.Decimal(18, 6)
  reasoningPerMillion   Decimal   @db.Decimal(18, 6)
  effectiveFrom         DateTime
  effectiveTo           DateTime?
  createdAt             DateTime  @default(now())

  usageEvents UsageEvent[]

  @@unique([model, effectiveFrom], name: "model_effectiveFrom")
  @@index([model, effectiveTo])
}

model Payment {
  id                String          @id @default(cuid())
  subscriptionId    String?
  inviteId          String?
  userId            String
  provider          PaymentProvider @default(MAKSEKESKUS)
  kind              PaymentKind     @default(OTHER)
  billingMethodId   String?
  providerPaymentId String
  amount            Decimal         @db.Decimal(10, 2)
  currency          String          @default("EUR")
  status            PaymentStatus
  paidAt            DateTime?
  failedAt          DateTime?
  refundedAt        DateTime?
  attemptNumber     Int             @default(1)
  raw               Json?
  createdAt         DateTime        @default(now())

  subscription  Subscription?  @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  billingMethod BillingMethod? @relation(fields: [billingMethodId], references: [id], onDelete: SetNull)
  invite        Invite?        @relation(fields: [inviteId], references: [id], onDelete: SetNull)
  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerPaymentId])
  @@index([subscriptionId])
  @@index([billingMethodId])
  @@index([inviteId])
  @@index([userId])
  @@index([kind])
}

model BillingMethod {
  id                 String              @id @default(cuid())
  userId             String
  provider           PaymentProvider     @default(MAKSEKESKUS)
  status             BillingMethodStatus @default(PENDING)
  providerCustomerId String?
  providerToken      String?
  providerMandateId  String?
  label              String?
  expiresAt          DateTime?
  activatedAt        DateTime?
  revokedAt          DateTime?
  lastUsedAt         DateTime?
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt

  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  subscriptions Subscription[]
  payments      Payment[]

  @@index([userId])
  @@index([status])
  @@index([provider])
  @@index([providerCustomerId])
  @@index([providerMandateId])
}

model RagDocument {
  id      String  @id @default(cuid())
  adminId String?
  admin   User?   @relation(fields: [adminId], references: [id], onDelete: SetNull)

  title       String?
  description String?
  type        RagSourceType
  status      RagStatus     @default(PENDING)
  audience    Audience      @default(BOTH)

  // Päritolu
