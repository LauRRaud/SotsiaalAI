// T12 E7: kohtumise kokkuvõtte kandja. `RoomSharedSummary` on jagamise FAKT —
// spetsialisti kinnitatud (FINAL) MEETING_SUMMARY, mille ta U10 vooga ruumi
// postitas. Sisu hoitakse snapshot'ina (nagu consentTextSnapshot E5-s): osalejad
// nägid täpselt seda teksti ja hilisem artefakti muutmine/kustutamine ei tohi
// juba jagatut ümber kirjutada. Rida kaob koos ruumiga — seetõttu tehakse
// koopiad ENNE kustutust (copy-first).
model RoomSharedSummary {
  id             String   @id @default(cuid())
  roomId         String
  artifactId     String
  messageId      String?
  sharedByUserId String
  title          String?
  content        String   @db.Text
  sharedAt       DateTime @default(now())
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  // T20 COLLAB-P2 (O-CO-2 = a): kinnitusring on VALIKULINE — jagaja otsustab.
  // Null = ringi ei küsitud; ajatempel = ring on avatud alates sellest hetkest.
  approvalRequestedAt DateTime?

  room     Room                  @relation(fields: [roomId], references: [id], onDelete: Cascade)
  sharedBy User                  @relation("RoomSharedSummarySharedBy", fields: [sharedByUserId], references: [id], onDelete: Cascade)
  copies   RoomSummaryCopy[]
  approvals RoomSummaryApproval[]

  @@unique([roomId, artifactId])
  @@index([roomId, sharedAt])
}

// T20 COLLAB-P2 — kinnitusringi vastus: osaleja "kinnitan" või "mul on
// parandus" jagatud FINAL-kokkuvõtte kohta. Kuju-doonor on
// SupervisionSummaryApproval; erinevused on teadlikud: status (eriarvamus
// säilib, mitte ainult kinnitus) ja note (paranduse sisu autorile).
// O-CO-5 = c: klient on adressaat, MITTE ringi osaleja — jõustatakse API-s
// (professionaalirollid), mitte skeemis, sest ruumiroll ei kanna kontorolli.
model RoomSummaryApproval {
  id                  String                    @id @default(cuid())
  roomSharedSummaryId String
  userId              String
  status              RoomSummaryApprovalStatus
  note                String?                   @db.Text
  createdAt           DateTime                  @default(now())
  updatedAt           DateTime                  @updatedAt

  sharedSummary RoomSharedSummary @relation(fields: [roomSharedSummaryId], references: [id], onDelete: Cascade)
  user          User              @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([roomSharedSummaryId, userId])
  @@index([userId, createdAt])
}

// Kes millise kokkuvõtte privaatkoopia sai. Unikaalindeks teeb üleandmise
// idempotentseks: arhiveerimine ja hilisem kustutus ei tekita teist koopiat.
// `savedAnalysisId` on SetNull — kasutaja võib oma koopia kustutada, ilma et
// üleandmise jälg kaoks.
model RoomSummaryCopy {
  id                  String   @id @default(cuid())
  roomSharedSummaryId String
  userId              String
  savedAnalysisId     String?
  copiedAt            DateTime @default(now())

  sharedSummary RoomSharedSummary @relation(fields: [roomSharedSummaryId], references: [id], onDelete: Cascade)
  user          User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  savedAnalysis SavedAnalysis?    @relation(fields: [savedAnalysisId], references: [id], onDelete: SetNull)

  @@unique([roomSharedSummaryId, userId])
  @@index([userId, copiedAt])
}

model CallSession {
  id               String            @id @default(cuid())
  contextType      CallContextType   @default(ROOM)
  contextId        String
  roomId           String?
  provider         CallProvider      @default(MOCK)
  providerRoomName String
  mode             CallMode          @default(AUDIO)
  status           CallSessionStatus @default(ACTIVE)
  startedByUserId  String
  startedAt        DateTime          @default(now())
  endedAt          DateTime?
  maxParticipants  Int               @default(8)
  // SOL-CALL-02 — FENCING-LOEND. Kasvab iga kord, kui koosseis või nõusolekupilt
  // muutub (liitumine, lahkumine, iga nõusolekuotsus). Salvestuse start jäädvustab
  // tema väärtuse claim'i hetkel ja kontrollib enne ACTIVE-ks minekut uuesti: kui
  // number on vahepeal muutunud, oli plaan, mille alusel nõusolekut kontrolliti,
  // aegunud. Nii ei pea liituja starti „püüdma" — tal piisab numbri kasvatamisest.
  rosterVersion    Int               @default(0)
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  room              Room?                  @relation(fields: [roomId], references: [id], onDelete: SetNull)
  startedBy         User                   @relation("CallSessionStartedBy", fields: [startedByUserId], references: [id], onDelete: Cascade)
  participants      CallParticipant[]
  speakRequests     CallSpeakRequest[]
  recordingRequests CallRecordingRequest[]
  recordingFiles    CallRecordingFile[]

  @@index([contextType, contextId, status])
  @@index([roomId, status])
  @@index([startedByUserId, startedAt])
}

