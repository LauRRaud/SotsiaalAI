// Private drafts, resonance and individual learning are stored separately so a
// shared session serializer cannot accidentally return them to another user.
model CovisionPrivateState {
  id        String   @id @default(cuid())
  sessionId String
  userId    String
  stage     Int
  kind      String
  content   Json
  version   Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  session CovisionSessionState @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  user    User                 @relation("CovisionPrivateStateUser", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([sessionId, userId, stage, kind])
  @@index([userId, updatedAt])
  @@index([sessionId, stage])
}

model CovisionStageSnapshot {
  id             String   @id @default(cuid())
  sessionId      String
  stage          Int
  phase          String
  sessionVersion Int
  payload        Json
  completedById  String?
  completedAt    DateTime @default(now())

  session     CovisionSessionState @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  completedBy User?                @relation("CovisionStageSnapshotCompleter", fields: [completedById], references: [id], onDelete: SetNull)

  @@unique([sessionId, stage])
  @@index([completedById])
  @@index([completedAt])
}

// A server-confirmed, generalized and immutable-by-default summary created
// only from the frozen stage 7/8 output. It deliberately has no message,
// transcript or raw-case-content relation.
model CovisionClosure {
  id                       String                           @id @default(cuid())
  covisionCaseId           String                           @unique
  sourceTopicSeedId        String?
  continuationTopicSeedId  String?                          @unique
  ownerId                  String
  assignedFollowUpUserId   String?
  closedById               String?
  generalizedTitle         String
  workFocus                String                           @db.Text
  selectedDirection        String                           @db.Text
  nextStep                 String                           @db.Text
  timeframe                String
  progressMarker           String                           @db.Text
  decisionNote             String?                          @db.Text
  sessionStartedAt         DateTime?
  closedAt                 DateTime                         @default(now())
  ownerConfirmedAt         DateTime
  lifecycleStatus          CovisionClosureLifecycleStatus  @default(FOLLOW_UP_PENDING)
  practiceStatus           CovisionPracticeCandidateStatus @default(NONE)
  packageStatus            CovisionPackageStatus            @default(NOT_CREATED)
  retentionStatus          CovisionRetentionStatus
  version                  Int                              @default(0)
  createdAt                DateTime                         @default(now())
  updatedAt                DateTime                         @updatedAt

  covisionCase          CovisionCase       @relation(fields: [covisionCaseId], references: [id], onDelete: Cascade)
  sourceTopicSeed       TopicSeed?          @relation("CovisionClosureSourceTopicSeed", fields: [sourceTopicSeedId], references: [id], onDelete: SetNull)
  continuationTopicSeed TopicSeed?          @relation("CovisionClosureContinuationTopicSeed", fields: [continuationTopicSeedId], references: [id], onDelete: SetNull)
  owner                 User                @relation("CovisionClosureOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  assignedFollowUpUser  User?               @relation("CovisionClosureAssignee", fields: [assignedFollowUpUserId], references: [id], onDelete: SetNull)
  closedBy              User?               @relation("CovisionClosureClosedBy", fields: [closedById], references: [id], onDelete: SetNull)
  followUps             CovisionFollowUp[]
  ownerPackage          CovisionOwnerPackage?
  effectivePractice     EffectivePractice?

  @@index([ownerId, updatedAt])
  @@index([assignedFollowUpUserId, updatedAt])
  @@index([sourceTopicSeedId])
  @@index([lifecycleStatus, closedAt])
  @@index([practiceStatus])
}

model CovisionFollowUp {
