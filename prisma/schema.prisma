model PreInquiry {
  id                      String                    @id @default(cuid())
  authorId                String?
  authorErasedAt          DateTime?
  recipientOwnerId        String?
  recipientEntryId        String?
  /* T25 viil B: organisatsiooni vastuvõtulaud adressaadina. Nullable ja
     vaikimisi NULL — olemasolevad eelpöördumised ei muutu. Adressaadiväljad
     on TEADLIKULT eraldi, mitte üks polümorfne `recipientId`: iga adressaadi-
     liik kannab oma võtit ja oma FK-d, muidu kaob referentsiaalne terviklikkus. */
  recipientOrganizationId String?
  sourceJourneyId         String?
  recipientType           PreInquiryRecipientType
  deliveryChannel         PreInquiryDeliveryChannel @default(INTERNAL)
  selectedRecipientEmail  String?
  selectedRecipientName   String?
  topic                   String?
  situation               String                    @db.Text
  assessmentState         Json?
  generatedDraft          String?                   @db.Text
  userEditedDraft         String?                   @db.Text
  receiverNote            String?                   @db.Text
  receiverChecklist       Json?
  nextContactOn           String?
  status                  PreInquiryStatus          @default(DRAFT)
  sentAt                  DateTime?
  openedAt                DateTime?
  recalledAt              DateTime?
  supersededById          String?                   @unique
  externalSendConfirmedAt DateTime?
  createdAt               DateTime                  @default(now())
  updatedAt               DateTime                  @updatedAt

  author         User?            @relation("PreInquiryAuthor", fields: [authorId], references: [id], onDelete: SetNull)
  /// JUHTUM-V1 päritolu (L12). SetNull: pöördumise kustutus ei hävita juhtumit.
  caseWorkAssists CaseWorkAssist[] @relation("CaseWorkAssistPreInquiry")
  recipientOwner User?            @relation("PreInquiryRecipientOwner", fields: [recipientOwnerId], references: [id], onDelete: SetNull)
  recipientEntry ServiceMapEntry? @relation(fields: [recipientEntryId], references: [id], onDelete: SetNull)
  recipientOrganization Organization? @relation("PreInquiryRecipientOrganization", fields: [recipientOrganizationId], references: [id], onDelete: SetNull)
  sourceJourney  Journey?         @relation(fields: [sourceJourneyId], references: [id], onDelete: SetNull)
  supersededBy   PreInquiry?      @relation("PreInquirySupersession", fields: [supersededById], references: [id], onDelete: SetNull)
  supersedes     PreInquiry?      @relation("PreInquirySupersession")
  covisionCases  CovisionCase[]
  fieldVisits    FieldVisit[]

  @@index([authorId, updatedAt])
  @@index([authorId, sentAt])
  @@index([recipientOwnerId, updatedAt])
  @@index([recipientOwnerId, recalledAt, updatedAt])
  @@index([recipientOwnerId, nextContactOn, status])
  @@index([recipientEntryId])
  /* E0 leid L5: viiest olemasolevast adressaadiindeksist ei kata ükski
     org-postkasti päringut. Need kaks on selle jaoks. */
  @@index([recipientOrganizationId, status, updatedAt])
  @@index([recipientOrganizationId, sentAt])
  networkShares NetworkShare[] @relation("NetworkShareSource")
  /// SK-V1 E5: esiuks → tuba. Kiireloomulisest abipalvest saab teha
  /// eelpöördumise, ilma et inimene peaks midagi uuesti trükkima.
  convertedFromUrgentRequest UrgentRequest? @relation("UrgentRequestConversion")

  @@index([sourceJourneyId])
  @@index([recipientType])
  @@index([deliveryChannel])
  @@index([status])
  @@index([createdAt])
}

model NotificationEvent {
  id                 String    @id @default(cuid())
  userId             String
  type               String
  sourceType         String
  sourceId           String
  dedupeKey          String    @unique
  targetKind         String
  targetId           String
  readAt             DateTime?
  expiresAt          DateTime?
  emailPolicy        String    @default("NONE")
  emailStatus        String    @default("NOT_REQUESTED")
  emailAttempts      Int       @default(0)
  emailNextAttemptAt DateTime?
  emailClaimedAt     DateTime?
  emailedAt          DateTime?
  emailLastErrorCode String?
  emailMessageId     String?
  eventId            String?
  dismissedAt        DateTime?
  workspaceKind      String?
  workspaceId        String?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, readAt, createdAt, id])
  @@index([userId, dismissedAt, readAt, createdAt])
  @@index([emailStatus, emailNextAttemptAt, id])
  @@index([userId, sourceType, sourceId, readAt])
  @@index([eventId])
}

model DomainEvent {
  id               String    @id @default(cuid())
  type             String
  version          Int       @default(1)
  occurredAt       DateTime
  actorKind        String
  actorUserId      String?
  sourceFeature    String
  sourceType       String
  sourceId         String
  workspaceKind    String?
  workspaceId      String?
  audienceRule     String
  audienceHint     Json?
  visibilityClass  String    @default("personal")
  actionKind       String
  actionTarget     String
  idempotencyKey   String    @unique
  retentionClass   String    @default("standard90")
  meta             Json?
  projectedAt      DateTime?
  createdAt        DateTime  @default(now())

  actor User? @relation("DomainEventActor", fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([projectedAt, id])
  @@index([workspaceKind, workspaceId, occurredAt])
  @@index([sourceType, sourceId, occurredAt])
  @@index([retentionClass, occurredAt])
  @@index([actorUserId, occurredAt])
}

// FIELD-V1 (T24): a field visit is the worker's PRIVATE mobile workspace shell
// over existing carriers (pre-inquiry workflow, UserDocument, AgentArtifact).
// Visit statuses, item states and provenance values are application-level
// constants (lib/field/constants.js) — deliberately NOT PostgreSQL enums.
// Retention defaults follow O-FD-1: server rows sweep 90 days after
// CLOSED/CANCELLED; raw audio purges 7 days after upload or immediately after
// a confirmed transcript.
model FieldVisit {
  id                            String    @id @default(cuid())
  ownerUserId                   String
  status                        String    @default("DRAFT")
  version                       Int       @default(1)
  goal                          String?   @db.Text
  locationText                  String?
  plannedStartAt                DateTime?
  plannedEndAt                  DateTime?
  preInquiryId                  String?
  packKeyQuestions              Json?
  packSummaryText               String?   @db.Text
  packTakenAt                   DateTime?
  packSourceUpdatedAt           DateTime?
  arrivedConfirmedAt            DateTime?
  departedConfirmedAt           DateTime?
  safetyArmedAt                 DateTime?
  safetyDeadlineAt              DateTime?
  safetyContactName             String?
  safetyContactEmail            String?
  safetyInstructions            String?   @db.Text
  safetyRemindedAt              DateTime?
  safetyEscalatedAt             DateTime?
  safetyEscalationAttempts      Int       @default(0)
  safetyEscalationNextAttemptAt DateTime?
  safetyEscalationStatus        String?
  safetyResolvedNotifiedAt      DateTime?
  safetyCancelledAt             DateTime?
  handoverArtifactAt            DateTime?
  handoverPreInquiryAt          DateTime?
  closedAt                      DateTime?
  cancelledAt                   DateTime?
  retentionClass                String    @default("standard90")
  createdAt                     DateTime  @default(now())
  updatedAt                     DateTime  @updatedAt

  owner       User                   @relation("FieldVisitOwner", fields: [ownerUserId], references: [id], onDelete: Cascade)
  preInquiry  PreInquiry?            @relation(fields: [preInquiryId], references: [id], onDelete: SetNull)
  notes       FieldVisitNote[]
  attachments FieldVisitAttachment[]
  /// JUHTUM-V1 seos (L15), Cascade — vt `UserDocument.caseWorkItems`.
  caseWorkItems CaseWorkItem[]

  @@index([ownerUserId, updatedAt])
  @@index([ownerUserId, status, updatedAt])
  @@index([status, closedAt])
  @@index([status, cancelledAt])
  @@index([safetyArmedAt, safetyDeadlineAt])
  @@index([preInquiryId])
}

// One row per synced item: (visitId, clientItemId) is the idempotency key the
// device generated. A concurrent second-device edit is preserved in the
// conflict* sibling fields until the owner resolves — nothing is overwritten
// silently. Body text is class-1 working draft content; it never goes to logs.
model FieldVisitNote {
  id                 String    @id @default(cuid())
  visitId            String
  clientItemId       String
  revision           Int       @default(1)
  kind               String    @default("note")
  provenance         String
  body               String    @db.Text
  contentSha256      String?
  consentKind        String?
  consentSubject     String?
  consentForm        String?
  consentWithdrawnAt DateTime?
  aiConfirmedAt      DateTime?
  conflictState      String?
  conflictRevision   Int?
  conflictBody       String?   @db.Text
  conflictProvenance String?
  deviceCreatedAt    DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  visit FieldVisit @relation(fields: [visitId], references: [id], onDelete: Cascade)

  @@unique([visitId, clientItemId])
  @@index([visitId, createdAt])
  @@index([visitId, kind])
}

// Thin join between a visit and an existing UserDocument carrier — FIELD does
// not build a parallel file system. Deleting the document leaves an honest
// dangling marker (documentId null) instead of hiding the removal.
model FieldVisitAttachment {
  id                    String    @id @default(cuid())
  visitId               String
  clientItemId          String
  role                  String
  documentId            String?
  consentClientItemId   String?
  transcriptConfirmedAt DateTime?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  visit    FieldVisit    @relation(fields: [visitId], references: [id], onDelete: Cascade)
  document UserDocument? @relation("FieldVisitAttachmentDocument", fields: [documentId], references: [id], onDelete: SetNull)

  @@unique([visitId, clientItemId])
  @@index([visitId, createdAt])
  @@index([documentId])
  @@index([role, createdAt])
}

// Teemaseeme remains an owner-private preparation object. WAITING freezes the
// generalized card; IN_COVISION links that immutable card to exactly one case.
model TopicSeed {
  id                 String          @id @default(cuid())
  ownerId            String
  title              String?
  contextType        String?
  caseType           String?
  whyNow             String?         @db.Text
  requestedSupport   String[]        @default([])
  importance         Int?
  safetyGate         String?
  status             TopicSeedStatus @default(DRAFT)
  sharedCardSnapshot Json?
  ownerConfirmedAt   DateTime?
  sharedAt           DateTime?
  covisionCaseId     String?         @unique
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt

  owner        User          @relation("TopicSeedOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  covisionCase CovisionCase? @relation("TopicSeedCovisionCase", fields: [covisionCaseId], references: [id], onDelete: SetNull)
  sourceForClosures CovisionClosure[] @relation("CovisionClosureSourceTopicSeed")
  continuationForClosure CovisionClosure? @relation("CovisionClosureContinuationTopicSeed")

  @@index([ownerId, updatedAt])
  @@index([status])
  @@index([createdAt])
}

model CovisionCase {
  id                    String             @id @default(cuid())
