  needTags                    String[]                     @default([])
  lifeDomains                 String[]                     @default([])
  deliveryModes               String[]                     @default([])
  serviceArea                 String?                      @db.Text
  serviceAreaType             String?
  county                      String?
  municipalityIds             String[]                     @default([])
  areaDescription             String?                      @db.Text
  serviceLanguages            String[]                     @default([])
  inquiryLanguages            String[]                     @default([])
  communicationSupport        String[]                     @default([])
  feeType                     ServiceProviderFeeType       @default(UNKNOWN)
  priceDescription            String?                      @db.Text
  availabilityStatus          String?
  availabilityDescription     String?                      @db.Text
  availabilityCheckedAt       DateTime?
  availabilityReminderSentAt  DateTime?
  directContactAllowed        String?
  requiresKovAssessment       String?
  requiresKovDecision         String?
  requiresSkaReferral         String?
  requiresSpecialistReferral  String?
  requiredDocumentsNote       String?                      @db.Text
  referralNotes               String?                      @db.Text
  contactMode                 String?
  contactName                 String?
  phone                       String?
  email                       String?
  website                     String?
  acceptsPlatformPreInquiries Boolean?
  acceptsEmailPreInquiries    Boolean?
  mapVisible                  Boolean                      @default(true)
  status                      ServiceProviderProfileStatus @default(PUBLISHED)
  sortOrder                   Int                          @default(0)
  createdAt                   DateTime                     @default(now())
  updatedAt                   DateTime                     @updatedAt

  // TEENUSPÄEVIK-V1 mall B (hoolduspäevik) nõuab, et tegevused valitaks
  // LOETELUST, mitte ei kirjutataks vabatekstina — see on Riigi Teataja
  // koduteenuse kordade päris nõue. Kataloog elab teenuse küljes, sest
  // „toimingud" on teenusepõhised: koduteenusel poeskäik, tugiisikul saatmine.
  activityCatalog             String[]                     @default([])
  /// Teenuse ARVELDUSÜHIK (HOUR | SESSION | DAY | MONTH).
  /// Ilma selleta pidi sisestus ühikut oletama ja oletus oli `HOUR` —
  /// kord-põhine teenus muutus vaikselt tunnipõhiseks ning kogus arvutati
  /// kestusest. Ühik on TEENUSE omadus, mitte kirje oma.
  defaultUnit                 String?

  /// A4: seos loakohustuse kataloogiga (`lib/mtr/licensedServices.js`).
  ///
  /// NULL = SIDUMATA ja see on tähendusrikas seis, mitte puuduv andmed:
  /// sidumata teenus EI tekita MTR-i päringut ega ühtki avalikku loaväidet —
  /// ei märgist, ei „ei vaja luba", ei „ei leitud". String, MITTE enum:
  /// kataloogi kasvamine peab olema andmeline muudatus.
  serviceKey                  String?

  locationLinks ServiceProviderServiceLocation[]

  serviceReferrals   ServiceReferral[]
  serviceEntries     ServiceEntry[]
  licenceAssessment  ServiceLicenceAssessment?

  @@index([providerProfileId])
  @@index([serviceKey])
  @@index([status])
  @@index([mapVisible])
  @@index([feeType])
  @@index([status, availabilityCheckedAt])
  @@index([availabilityReminderSentAt])
  @@index([sortOrder])
}

