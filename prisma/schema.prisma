  @@index([expiresAt])
}

model Subscription {
  id                String             @id @default(cuid())
  userId            String
  status            SubscriptionStatus @default(NONE)
  plan              String             @default("free")
  billingMode       BillingMode        @default(ONE_OFF)
  billingInterval   BillingInterval?
  billingMethodId   String?
  billingSource     BillingSource      @default(SELF)
  sponsorUserId     String?
  inviteId          String?
  /* T25 viil B: organisatsioon maksjana. TEADLIKULT eraldi väljad
     `sponsorUserId`/`inviteId` kõrval — inimsponsor ja organisatsioon on eri
     maksjad ning nende segamine teeks `payerSource` arvutuse mitmeseks.
     Mõlemad on nullable ja vaikimisi NULL: olemasolevad tellimused ei muutu. */
  sponsorOrganizationId    String?
  orgClientSponsorshipId   String?
  validUntil        DateTime?
  nextBilling       DateTime?
  lastBilledAt      DateTime?
  pastDueSince      DateTime?
  billingRetryCount Int                @default(0)
  cancelAtPeriodEnd Boolean            @default(false)
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  canceledAt        DateTime?
  planDefinitionId  String?

  user           User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  planDefinition PlanDefinition? @relation(fields: [planDefinitionId], references: [id], onDelete: SetNull)
  billingMethod  BillingMethod?  @relation(fields: [billingMethodId], references: [id], onDelete: SetNull)
  sponsorUser    User?           @relation("SubscriptionSponsorUser", fields: [sponsorUserId], references: [id], onDelete: SetNull)
  invite         Invite?         @relation("InviteGrantedSubscription", fields: [inviteId], references: [id], onDelete: SetNull)
  payments       Payment[]
  /* SetNull mõlemal: organisatsiooni või sponsorluse kadumine EI tohi kustutada
     inimese tellimust ega tema ligipääsu ajalugu (arenduskava §5.6 „ligipääsu
     lõpp ei tohi sulgeda pöörduja oma andmete lugemist"). */
  sponsorOrganization  Organization?                  @relation("SubscriptionSponsorOrganization", fields: [sponsorOrganizationId], references: [id], onDelete: SetNull)
  orgClientSponsorship OrganizationClientSponsorship? @relation("SubscriptionOrgSponsorship", fields: [orgClientSponsorshipId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([status])
  @@index([validUntil])
  @@index([billingMode])
  @@index([billingMethodId])
  @@index([billingSource])
  @@index([sponsorUserId])
  @@index([inviteId])
  @@index([planDefinitionId])
  @@index([sponsorOrganizationId])
  @@index([orgClientSponsorshipId])
}

