model ServiceProviderProfile {
  id                          String                       @id @default(cuid())
  /* T25 viil C (E8) — KAKS OMANDIREŽIIMI (arenduskava §5.9).
     `ownerId` on nüüd NULLABLE: org-profiilil ei ole ühte inimomanikku ja
     tema püsimine EI TOHI sõltuda ühe töötaja konto kustutamisest. Enne seda
     viilu oli seos `onDelete: Cascade` — konto kustutus HÄVITAS profiili
     (E0 leid L4). Nüüd `SetNull`.
     Osalised unikaalindeksid migratsioonis: üks SOLO profiil `ownerId` kohta,
     üks ORGANIZATION profiil `organizationId` kohta. Prisma `@@unique` seda ei
     väljenda, sest ta ei tunne `WHERE`-i. */
  ownerId                     String?
  /* `@unique` on siin OHUTU ja sisuliselt õige: Postgresis EI OLE kaks NULL-i
     võrdsed, seega piiramatu arv SOLO-profiile (organizationId = NULL) elab
     kõrvuti, aga ühel organisatsioonil saab olla ainult üks põhiprofiil
     (arenduskava §5.9).
     `ownerId` jääb Prisma tasemel unikaalsuseta — tema piirang on OSALINE
     (ainult SOLO-režiimis) ja elab migratsioonis. Nii saab solo-profiili
     org-profiiliks teisendanud inimene hiljem endale uue solo-profiili teha,
     ilma et vana omanikuviide teda blokiks. */
  organizationId              String?                      @unique
  ownershipMode               ServiceProviderOwnershipMode @default(SOLO)
  organizationName            String
  organizationType            String?
  /// A4 identiteedivõti: MTR-i päring käib SELLE koodi järgi, mitte nime
  /// järgi. Sarnase nimega MTÜ ja OÜ on eri juriidilised isikud ja load
  /// võivad olla ainult ühel neist.
  registryCode                String?
  shortDescription            String?                      @db.Text
  longDescription             String?                      @db.Text
  services                    String[]                     @default([])
  serviceCategories           String[]                     @default([])
  targetGroups                String[]                     @default([])
  serviceArea                 String?                      @db.Text
  serviceAreaMunicipalityIds  String[]                     @default([])
  county                      String?
  address                     String?
  normalizedAddress           String?
  phone                       String?
  email                       String?
  website                     String?
  primaryContactName          String?
  languages                   String[]                     @default([])
  accessibilityInfo           String?                      @db.Text
  generalAccessibilityNote    String?                      @db.Text
  feeType                     ServiceProviderFeeType       @default(UNKNOWN)
  mapVisible                  Boolean                      @default(false)
  acceptsPlatformPreInquiries Boolean                      @default(true)
  acceptsEmailPreInquiries    Boolean                      @default(true)
  assistantRecommendationAllowed Boolean                   @default(false)
  status                      ServiceProviderProfileStatus @default(DRAFT)
  publicSlug                  String?                      @unique
  publishedAt                 DateTime?
  hiddenAt                    DateTime?
  checkedAt                   DateTime?
  ragSourceId                 String?
  ragMetadata                 Json?
  createdAt                   DateTime                     @default(now())
  updatedAt                   DateTime                     @updatedAt

  /* SetNull, MITTE Cascade: organisatsiooni profiil peab konto kustutamise üle
     elama. Solo-profiili puhul jääb rida samuti alles — omanikuta solo-profiil
     on nähtav ainult admin-rajal ja teda saab uuele omanikule määrata või
     arhiveerida, mis on parem kui vaikne kadu. */
  owner            User?                     @relation(fields: [ownerId], references: [id], onDelete: SetNull)
  organization     Organization?             @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  serviceMapEntry  ServiceMapEntry?
  serviceItems     ServiceProviderService[]
  serviceLocations ServiceProviderLocation[]
  licenceChecks    LicenceCheck[]

  // TEENUSPÄEVIK-V1. NB seosed on `Restrict`, mitte `Cascade` — vt mudelite
  // juures olevat säilituse-selgitust.
  serviceReferrals  ServiceReferral[]
  serviceEntries    ServiceEntry[]
  serviceLogTimeSamples ServiceLogTimeSample[]
  serviceNarratives ServiceMonthlyNarrative[]

  // `@@unique([ownerId])` on ASENDATUD osaliste unikaalindeksitega migratsioonis.
  @@index([ownershipMode, status])
  @@index([organizationId])
  @@index([ownerId, updatedAt])
  @@index([status])
  @@index([mapVisible])
  @@index([acceptsPlatformPreInquiries])
  @@index([acceptsEmailPreInquiries])
  @@index([publicSlug])
  serviceWorkRoutes ServiceWorkRoute[]
  serviceVisits     ServiceVisit[]
}

model ServiceProviderService {
  id                          String                       @id @default(cuid())
  providerProfileId           String
