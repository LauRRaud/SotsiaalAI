enum CallRecordingRequestStatus {
  REQUESTED
  CONSENTED
  DECLINED
  READY_TO_RECORD
  ACTIVE
  STOPPED
  COMPLETED
  FAILED
  DELETED
  // SOL-CALL-01. `STOPPING` = stop on providerile saadetud, kinnitust EI OLE veel.
  // `STOP_FAILED` = stop tõrkus või aegus ja püsiv taasproov on järjekorras. Kumbki
  // EI OLE terminaalne: mõlemad tähendavad „egress võib veel kirjutada", mida senine
  // `STOPPED` varjas.
  STOPPING
  STOP_FAILED
  // SOL-CALL-02/03. Start on CLAIM'itud ja väline providerikutse on käimas või äsja
  // lõppenud. Taotlus ei ole veel ACTIVE ja EI OLE ka enam vabalt võetav. Ilma selle
  // seisuta jäi rida kogu providerikutse ajaks `READY_TO_RECORD`-iks: hiline liituja
  // ei näinud midagi peatatavat ja nõusoleku tagasivõtt kirjutati hiljem üle.
  STARTING
}

enum CallRecordingConsentStatus {
