  updatedAt         DateTime @updatedAt

  covisionCase CovisionCase @relation(fields: [covisionCaseId], references: [id], onDelete: Cascade)

  @@index([covisionCaseId])
  @@index([category])
  @@index([type])
}

model CovisionRiskFactor {
  id             String             @id @default(cuid())
