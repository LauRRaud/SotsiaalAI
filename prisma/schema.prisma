model WellbeingRecord {
  id                  String   @id @default(cuid())
  ownerUserId         String
  schemaVersion       String   @default("1.0")
  scoringVersion      String
  workflowType        String
  period              String?
  roleGroup           String?
  standardizedFields  Json
  computedSignal      Json
  loadFactors         Json
  resourceFactors     Json
  riskMarkers         Json
  recommendedActions  Json
  visibility          String   @default("private")
  aggregationEligible Boolean  @default(true)
  supersedesRecordId  String?  @unique
  /* WB-V2-P2 kontrollpunkt. TEADLIKULT eraldi väljadel, mitte
     `standardizedFields`-i sees: „kas pidas?" on hilisem muudatus ja kui ta
     elaks vastuste sees, muutuks vastuste plokp pärast salvestamist. Vastused
     jäävad puutumatuks (TO-1 piir), plaan ja järelmärge elavad kõrval.
     `checkpointDueOn` on skalaar ja indekseeritud, sest U1 taimer peab leidma
     saabunud kontrollpunktid ilma JSON-skaneeringuta. */
  checkpointDueOn     DateTime?
  checkpoint          Json?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  owner User @relation(fields: [ownerUserId], references: [id], onDelete: Cascade)

  /* TO-1 „paranda uue kirjena" (WB-V2-P2): parandus on UUS kirje, mis viitab
     parandatavale. `@unique` teeb sellest 1:1 sideme — sama kirjet ei saa kaks
     korda parandada, sest siis jääks koondisse kaks „kehtivat" versiooni ja
     mustri-statistika topeltloendaks. Ahel A ← B ← C on lubatud.
     `SetNull`: parandatava päris kustutamisel (§19.8) jääb parandus alles ja
     loetavaks, viide lihtsalt tühjeneb. */
  supersedes   WellbeingRecord? @relation("WellbeingRecordSupersede", fields: [supersedesRecordId], references: [id], onDelete: SetNull)
  supersededBy WellbeingRecord? @relation("WellbeingRecordSupersede")

  @@index([ownerUserId, workflowType, createdAt])
  @@index([workflowType, createdAt])
  @@index([aggregationEligible, workflowType, createdAt])
  @@index([checkpointDueOn])
}

/* T21 P3 Meetodipeegel V1 (O-CW-3, analüüsidoc ptk 3).
   PRIVATE on INVARIANT, mitte veerg: mudelil ei ole visibility-/jagamisvälju,
   sest jagatav ei ole kunagi kirje ise, vaid ainult deidentifitseeritud +
   kasutaja kinnitatud TULETIS (ptk 3.5) — tuletise rada on eraldi töö.
   Päritolumärgistus on välja-tasemel strukturaalne: clientGoal/clientReaction
   kannavad KLIENDI_OELDUD, workerObservation TOOTAJA_TAHELEPANEK ja
   interpretation TOOTAJA_TOLGENDUS semantikat (tähelepanek ≠ tõlgendus = ERI
   veerud, ideed 8.3) — markerit ei saa väljalt lahutada.
   sourceKind/sourceId on VIIDE ILMA FK-ta: allika kustumisel kirje JÄÄB
   (ptk 3.3 „Seos"); olemasolu lahendatakse lugemisel omanik-skoobis.
   Meetod on vabatekst + valikuline kataloogiviide KUNI O-CW-5 kinnitab
   kataloogi. AI-hüpoteesi veergu EI OLE: V1-s ei ole AI-rada (meetodi-
   soovitused BLOKEERITUD kuni O-CW-5, ptk 3.4) ja veerg tuleb koos rajaga. */
model PracticeReflection {
  id             String  @id @default(cuid())
  ownerUserId    String
  schemaVersion  String  @default("1.0")
  sourceKind     String?
  sourceId       String?
  // Valik — nelja tasandi mudel (ptk 3.2) + valiku põhjus
  approach       String?
  method         String?
  action         String?
  supportTechnique String?
  choiceReason   String?
  methodCatalogRef String?
  // Vaatlus — päritolu on välja semantikas (vt mudelikommentaar)
  clientGoal     String?
  clientReaction String?
  workerObservation String?
  // Tõlgendus — eraldi väljad, ei liitu vaatlusega
  interpretation String?
  whatWorked     String?
  whatDidNot     String?
  // Järeldus
  nextStep       String?
  supportNeed    String?
  interimOutcome String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  owner User @relation(fields: [ownerUserId], references: [id], onDelete: Cascade)

  @@index([ownerUserId, createdAt])
  @@index([ownerUserId, sourceKind, sourceId])
}

