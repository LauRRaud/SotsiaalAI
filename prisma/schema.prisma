// Verify-then-swap email change (T02 ACCOUNT-V1 E2). The login identity
// (User.email) stays unchanged until the owner of the new address confirms via
// the emailed link. One pending change per user; tokenHash is sha256 of the
// opaque token (the raw token only ever lives in the emailed link).
model PendingEmailChange {
  id          String   @id @default(cuid())
  userId      String   @unique
  newEmail    String
  tokenHash   String   @unique
  expiresAt   DateTime
  createdAt   DateTime @default(now())
