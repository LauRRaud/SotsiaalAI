  outcome                       String?                         @db.Text
  learningPoints                String?                         @db.Text
  limitations                   String?                         @db.Text
  sources                       String?                         @db.Text
  suitableContext               String?                         @db.Text
  conditions                    String[]                        @default([])
  steps                         String[]                        @default([])
  practiceType                  String?
