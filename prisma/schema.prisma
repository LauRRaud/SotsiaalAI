model CovisionParticipant {
  id             String                  @id @default(cuid())
  covisionCaseId String
  userId         String?
  email          String?
  role           CovisionParticipantRole @default(PARTICIPANT)
  inviteStatus   CovisionInviteStatus    @default(INVITED)
