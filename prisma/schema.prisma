// Teemaseeme remains an owner-private preparation object. WAITING freezes the
// generalized card; IN_COVISION links that immutable card to exactly one case.
model TopicSeed {
  id                 String          @id @default(cuid())
  ownerId            String
  title              String?
  contextType        String?
  caseType           String?
  whyNow             String?         @db.Text
  requestedSupport   String[]        @default([])
  importance         Int?
  safetyGate         String?
  status             TopicSeedStatus @default(DRAFT)
  sharedCardSnapshot Json?
  ownerConfirmedAt   DateTime?
  sharedAt           DateTime?
  covisionCaseId     String?         @unique
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt

  owner        User          @relation("TopicSeedOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  covisionCase CovisionCase? @relation("TopicSeedCovisionCase", fields: [covisionCaseId], references: [id], onDelete: SetNull)
  sourceForClosures CovisionClosure[] @relation("CovisionClosureSourceTopicSeed")
  continuationForClosure CovisionClosure? @relation("CovisionClosureContinuationTopicSeed")

  @@index([ownerId, updatedAt])
  @@index([status])
  @@index([createdAt])
}

model CovisionCase {
  id                    String             @id @default(cuid())
  ownerId               String
  title                 String
  summary               String?            @db.Text
  anonymizedDescription String?            @db.Text
  centralQuestion       String?            @db.Text
  expectedHelpTypes     String[]           @default([])
  topics                String[]           @default([])
  tags                  String[]           @default([])
  status                CovisionCaseStatus @default(DRAFT)
  visibility            CovisionVisibility @default(PRIVATE)
  sourcePreInquiryId    String?
  anonymityConfirmedAt  DateTime?
  lastActivityAt        DateTime           @default(now())
  createdAt             DateTime           @default(now())
  updatedAt             DateTime           @updatedAt

  owner            User                  @relation("CovisionCaseOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  sourcePreInquiry PreInquiry?           @relation(fields: [sourcePreInquiryId], references: [id], onDelete: SetNull)
  journeySteps     CovisionJourneyStep[]
  parties          CovisionParty[]
  riskFactors      CovisionRiskFactor[]
  participants     CovisionParticipant[]
  messages         CovisionMessage[]
  summaryRecord    CovisionSummary?
  practices        EffectivePractice[]
  sourceTopicSeed  TopicSeed?             @relation("TopicSeedCovisionCase")
  sourceWellbeingOutputDraft WellbeingOutputDraft? @relation("WellbeingOutputDraftCovisionCase")
  sessionState     CovisionSessionState?
  closure          CovisionClosure?

  @@index([ownerId, updatedAt])
  @@index([sourcePreInquiryId])
  @@index([status])
  @@index([visibility])
  @@index([lastActivityAt])
}

model CovisionJourneyStep {
