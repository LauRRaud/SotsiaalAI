  scope        String                        @default("")
  validUntil   DateTime?
  grantBasis   String?                       @db.Text
  createdAt    DateTime                      @default(now())

  targetUser User? @relation("PracticeCapabilityAuditTarget", fields: [targetUserId], references: [id], onDelete: SetNull)
  actorUser  User? @relation("PracticeCapabilityAuditActor", fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([targetUserId, createdAt])
  @@index([actorUserId, createdAt])
}

model EffectivePracticeAuditEvent {
  id           String   @id @default(cuid())
  practiceId   String
  actorId      String?
  action       String
  fromStatus   String?
  toStatus     String?
  contentVersion Int
  metadata     Json?
  // P1-D: immutable review-justification ledger. Append-only (never updated), the
  // actor is nullable (SetNull on account deletion, keeping the decision audit).
  // justificationVisibility gates who may read the text: "private" (reviewer-only),
  // "author" (author-visible feedback) or "public". Reviewer-private reasoning must
  // never reach the author or a public serializer.
  decisionType            String?
  justification           String? @db.Text
  justificationVisibility String?
  createdAt    DateTime @default(now())

  practice EffectivePractice @relation(fields: [practiceId], references: [id], onDelete: Cascade)
  actor    User?             @relation("EffectivePracticeAuditActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([practiceId, createdAt])
  @@index([actorId, createdAt])
}

model HelpCategory {
  id            String   @id @default(cuid())
  code          String   @unique
  labelEt       String
  labelEn       String
  labelRu       String
  descriptionEt String?
  descriptionEn String?
  descriptionRu String?
  sortOrder     Int      @default(0)
  isActive      Boolean  @default(true)
  parentId      String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  parent         HelpCategory?         @relation("HelpCategoryTree", fields: [parentId], references: [id])
  children       HelpCategory[]        @relation("HelpCategoryTree")
  requestPrimary HelpRequest[]         @relation("HelpRequestPrimaryCategory")
  offerPrimary   HelpOffer[]           @relation("HelpOfferPrimaryCategory")
  requestLinks   HelpRequestCategory[]
  offerLinks     HelpOfferCategory[]

  @@index([isActive])
  @@index([sortOrder])
  @@index([parentId])
}

model TargetGroup {
  id        String   @id @default(cuid())
  code      String   @unique
  labelEt   String
  labelEn   String
  labelRu   String
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  requestLinks HelpRequestTargetGroup[]
  offerLinks   HelpOfferTargetGroup[]
}

model HelpRequest {
  id                       String               @id @default(cuid())
  userId                   String
  municipalityId           String?
  primaryCategoryId        String
  title                    String?
  description              String               @db.Text
  structuredSummary        String?
  roleLabel                String?
  beneficiaryLabel         String?
  urgency                  String?
  availabilityOrStart      String?
  compensationDetails      String?
  conditions               String?
  skillsOrBackground       String?
  rawPlace                 String?
  helpType                 HelpType?
  timeType                 TimeType?
  status                   HelpRecordStatus     @default(OPEN)
  classificationSource     ClassificationSource @default(AI)
  classificationConfidence Float?
  userConfirmedAt          DateTime?
  expiresAt                DateTime?
  createdAt                DateTime             @default(now())
  updatedAt                DateTime             @updatedAt

  user             User                     @relation(fields: [userId], references: [id], onDelete: Cascade)
  municipality     Municipality?            @relation(fields: [municipalityId], references: [id], onDelete: SetNull)
  primaryCategory  HelpCategory             @relation("HelpRequestPrimaryCategory", fields: [primaryCategoryId], references: [id])
  categoryLinks    HelpRequestCategory[]
  targetGroupLinks HelpRequestTargetGroup[]
  matches          HelpMatch[]
  mapEntry         HelpMapEntry?

  @@index([userId])
  @@index([municipalityId])
  @@index([primaryCategoryId])
  @@index([status])
  @@index([expiresAt])
  @@index([createdAt])
}

model HelpOffer {
  id                        String               @id @default(cuid())
  userId                    String
  municipalityId            String?
  primaryCategoryId         String
  title                     String?
  description               String               @db.Text
  structuredSummary         String?
  roleLabel                 String?
  providerScopeOrConditions String?
  availabilityOrStart       String?
  compensationDetails       String?
  conditions                String?
  skillsOrBackground        String?
  rawPlace                  String?
  helpType                  HelpType?
  timeType                  TimeType?
  status                    HelpRecordStatus     @default(OPEN)
  classificationSource      ClassificationSource @default(AI)
  classificationConfidence  Float?
  userConfirmedAt           DateTime?
  expiresAt                 DateTime?
  createdAt                 DateTime             @default(now())
  updatedAt                 DateTime             @updatedAt

  user             User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  municipality     Municipality?          @relation(fields: [municipalityId], references: [id], onDelete: SetNull)
  primaryCategory  HelpCategory           @relation("HelpOfferPrimaryCategory", fields: [primaryCategoryId], references: [id])
  categoryLinks    HelpOfferCategory[]
  targetGroupLinks HelpOfferTargetGroup[]
  matches          HelpMatch[]
  mapEntry         HelpMapEntry?

  @@index([userId])
  @@index([municipalityId])
  @@index([primaryCategoryId])
  @@index([status])
  @@index([expiresAt])
  @@index([createdAt])
}

model HelpMapEntry {
