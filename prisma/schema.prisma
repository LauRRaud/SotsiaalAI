  updatedAt             DateTime           @updatedAt

  owner            User                  @relation("CovisionCaseOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  sourcePreInquiry PreInquiry?           @relation(fields: [sourcePreInquiryId], references: [id], onDelete: SetNull)
  journeySteps     CovisionJourneyStep[]
  parties          CovisionParty[]
  riskFactors      CovisionRiskFactor[]
  participants     CovisionParticipant[]
  messages         CovisionMessage[]
  summaryRecord    CovisionSummary?
  practices        EffectivePractice[]
