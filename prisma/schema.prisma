  latitude          Float?
  longitude         Float?
  geocodingStatus   ServiceMapGeocodingStatus @default(PENDING)
  geocodingRaw      Json?
  county            String?
  municipalityIds   String[]                  @default([])
  serviceArea       String?
  categoryCode      String?
  helpType          HelpType?
  targetGroupCodes  String[]                  @default([])
  needTags          String[]                  @default([])
  deliveryModes     String[]                  @default([])
  contactMode       HelpMapContactMode        @default(PLATFORM)
  status            HelpMapEntryStatus        @default(REVIEW)
  expiresAt         DateTime?
  privacyNote       String?
  createdAt         DateTime                  @default(now())
  updatedAt         DateTime                  @updatedAt

