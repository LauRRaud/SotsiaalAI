  updatedAt      DateTime                @updatedAt

  covisionCase CovisionCase @relation(fields: [covisionCaseId], references: [id], onDelete: Cascade)
  user         User?        @relation("CovisionParticipantUser", fields: [userId], references: [id], onDelete: SetNull)
  sessionState CovisionParticipantState?
  workItems    CovisionWorkItem[]

  @@unique([covisionCaseId, userId])
  @@unique([covisionCaseId, email])
  @@index([userId])
  @@index([email])
  @@index([inviteStatus])
}

// Persistent server-owned Kovisioon state. The browser submits commands with an
// expected integer version; it never replaces this object wholesale.
model CovisionSessionState {
  id                  String   @id @default(cuid())
  covisionCaseId      String   @unique
  stage               Int      @default(1)
  phase               String   @default("waiting_room")
  version             Int      @default(0)
  startedAt           DateTime?
  stageStartedAt      DateTime @default(now())
  pausedAt            DateTime?
  totalPausedMs       Int      @default(0)
  settings            Json?
  caseConfirmedAt     DateTime?
  settingsConfirmedAt DateTime?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  covisionCase      CovisionCase               @relation(fields: [covisionCaseId], references: [id], onDelete: Cascade)
  participantStates CovisionParticipantState[]
  workItems         CovisionWorkItem[]
  privateStates     CovisionPrivateState[]
  stageSnapshots    CovisionStageSnapshot[]

  @@index([stage, phase])
  @@index([updatedAt])
}

model CovisionParticipantState {
  id                   String    @id @default(cuid())
  sessionId            String
  participantId        String    @unique
  presentAt            DateTime?
  roleConfirmedAt      DateTime?
  agreementConfirmedAt DateTime?
  readyAt              DateTime?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  session     CovisionSessionState @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  participant CovisionParticipant  @relation(fields: [participantId], references: [id], onDelete: Cascade)

  @@index([sessionId])
